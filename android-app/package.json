{
  "name": "evoagent-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EvoAgent Android 客户端（React Native；UI 全部为 JS/TS，支持后续 OTA 推送更新）",
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "test:offline": "node --test \"test/offline/*.test.ts\" \"test/device/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ota:publish": "appcenter codepush release-react -a <owner>/EvoAgent-Android -d Production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "react": "18.3.1",
    "react-native": "0.75.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@types/react": "^18.3.12",
    "typescript": "^5.5.0"
  }
}
