          1
        ],
        [
          "proactive.yielded_under_pressure",
          "eq",
          true
        ],
        [
          "proactive.core_state_mutations",
          "eq",
          0
        ]
      ]
    },
    {
      "id": "UX-F04-04",
      "scenario": "关闭主动帮助",
      "source_condition": "不再启动新的非必要主动任务",
      "initial_status": "not_run",
      "steps": [
