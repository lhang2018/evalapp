    {
      "id": "UX-GLOBAL-01",
      "scenario": "后台版本更新",
      "source_condition": "当前运行绑定的配置不被无约束热切换",
      "initial_status": "not_run",
      "steps": [
        "运行任务绑定版本A，期间尝试后台激活版本B",
        "核对该运行前后Manifest绑定保持A，未发生无约束热切换"
      ],
      "assertions": [
        [
          "run.manifest_after",
          "eq_path",
          "run.manifest_before"
        ],
        [
          "update.current_run_hot_swap",
          "eq",
          false
        ]
      ]
    },
    {
      "id": "UX-GLOBAL-02",
      "scenario": "用户纠正摘要",
      "source_condition": "后续处理使用纠正后的事实",
      "initial_status": "not_run",
      "steps": [
