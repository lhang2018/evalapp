      "assertions": [
        [
          "sources.only_authorized",
          "eq",
          true
        ],
        [
          "facts.traceable",
          "eq",
          true
        ],
        [
          "facts.unknowns_distinguished",
          "eq",
          true
        ]
      ]
    },
    {
      "id": "UX-F04-02",
      "scenario": "没有高价值机会",
      "source_condition": "不强行生成无关建议",
      "initial_status": "not_run",
      "steps": [
