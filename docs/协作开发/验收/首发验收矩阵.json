          0
        ],
        [
          "suggestions.count",
          "eq",
          0
        ]
      ]
    },
    {
      "id": "UX-F04-03",
      "scenario": "主任务与主动分析并行",
      "source_condition": "主动分析不能使主任务越过资源门槛",
      "initial_status": "not_run",
      "steps": [
        "并行运行核心任务与主动分析，施加可测量资源压力",
