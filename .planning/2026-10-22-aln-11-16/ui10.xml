rder="4" hint="" /></node><node index="16" text="" resource-id="" class="android.view.ViewGroup" package="com.evoagent" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[40,2559][1992,2968]" drawing-order="15" hint=""><node index="0" text="DONE" resource-id="" class="android.widget.TextView" package="com.evoagent" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[73,2592][175,2639]" drawing-order="1" hint="" /><node index="1" text="Explain idempotency in three sentences" resource-id="" class="android.widget.TextView" package="com.evoagent" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[73,2649][1960,2700]" drawing-order="2" hint="" /><node index="2" text="结果: **Idempotency** — three sentences:&#10;&#10;1. **Definition:** Idempotency is the property of an operation whereby executing it once and executing it multiple times leaves the system's state (and final result) identical.&#10;&#10;2. **Example:** An HTTP `PUT` request that sets a resource to a given value is idempotent, because sending it repeatedly still leaves the resource in exactly that same state — whereas a `POST` that creates a new record is generally not, since each call adds another record.&#10;&#10;3. **Why it matters:** Idempotency is essential for retries and distributed systems, where a request may be duplicated by network timeouts, message redelivery, or concurrent clients, and it guarantees that such retries cannot corrupt state or trigger unintended side effects.&#10;&#10;Together these three sentences define idempotency, illustrate it with a concrete HTTP example, and explain why it is critical for safe retries in distributed systems." resource-id="" class="android.widget.TextView" package="com.evoagent" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[73,2710][1690,2968]" drawing-order="3" hint="" /></node></node></node></node></node></node></node></node></node></node><node index="1" text="" resource-id="android:id/statusBarBackground" class="android.view.View" package="com.evoagent" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][2032,86]" drawing-order="3" hint="" /><node index="2" text="" resource-id="android:id/navigationBarBackground" class="android.view.View" package="com.evoagent" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,3008][2032,3048]" drawing-order="2" hint="" /></node></hierarchy>