\"number\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"214\"]))),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"215\"]))),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"216\"])))),__dil.jsx(\"text\",null,__dilConstants[\"217\"]),__dil.jsx(\"text\",null,__dilConstants[\"218\"]),__dil.jsx(\"title\",{\"size\":\"lg\"},__dilConstants[\"219\"]),__dil.jsx(\"text\",null,__dilConstants[\"220\"]),__dil.jsx(\"text\",null,__dilConstants[\"221\"]),__dil.jsx(\"text\",null,__dilConstants[\"222\"]),__dil.jsx(\"text\",null,__dilConstants[\"223\"]),__dil.jsx(\"text\",null,__dilConstants[\"224\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"225\"])),__dil.jsx(\"text\",null,__dilConstants[\"226\"]));},{\"key\":\"body:2\"}));","constants":{"0":"你这个想法非常重要。我认为它会直接决定 EvoAgent 最终是一个“任务执行工具”，还是一个真正有价值的“个人智能体”。","1":"前面我们一直在解决：用户提出任务后，怎样让系统高质量地完成。","2":"你现在提出了更进一步的问题：","3":"如果用户没有明确提出任务，智能体能不能根据已经授权的上下文，主动发现用户可能需要什么，并在合适的时候提供帮助？即使用户提出了任务，智能体能不能在完成任务之外，进一步发现用户没想到、但确实有价值的事情？","4":"我的答案是：应该，而且应该把它设计成 EvoAgent 的核心能力之一，而不是以后随手增加的一个功能。","5":"但这里有一个重要区别：我们不是要让智能体不停地打扰用户，而是让它在合适的时间，以合适的自主程度，做真正有价值的事情。","6":"一、EvoAgent 应该具备三种智能，而不只是执行智能","7":"a588d0a9-b3f2-5d84-b96a-e7dbc7573701","8":"第一种：任务执行智能","9":"最高优先级","10":"用户提出明确目标，智能体负责理解、规划、执行、验证和交付。","11":"例如：整理资料、制作报告、操作手机、修改代码、生成视频。","12":"衡量标准：任务是否高质量完成。","13":"339f3929-b005-5464-9db1-8a1b00da4b7e","14":"第二种：主动理解与机会发现智能","15":"产品差异化核心","16":"智能体不只理解当前一句话，还能在授权范围内理解近期对话、正在推进的项目、尚未解决的问题和可能的下一步需求。","17":"例如：自动整理近期讨论，发现一个项目还有关键设计没有确定，主动提出下一步建议。","18":"衡量标准：是否在用户需要之前，发现了有价值的帮助机会。","19":"caeda85d-331b-5956-b5d3-e030ea256046","20":"第三种：超预期价值智能","21":"体验提升","22":"在完成用户明确要求后，进一步发现遗漏、优化方案、补充有用资料，或者提前准备用户很可能需要的后续产物。","23":"例如：用户要求生成报告，智能体发现报告还缺少决策对比，于是在不改变原任务的前提下，主动提供一份对比表和可选的行动建议。","24":"衡量标准：是否创造了额外的、实际可用的价值。","25":"这三种智能有不同的职责，但必须协同。","26":"第一种保证 EvoAgent 可靠；第二种让它主动；第三种让它真正有用、逐渐形成区别于普通聊天工具的体验。","27":"其中，第二种和第三种都不能以牺牲第一种为代价。","28":"二、主动性应该怎么实现？","29":"我建议建立一个新的核心能力：","30":"主动智能与机会发现系统（Proactive Intelligence & Opportunity Discovery，PIOD）","31":"。","32":"它不是一个新的领域专家，也不是另一个独立的聊天机器人，而是横跨通用内核和所有领域专家的共享能力。","33":"它的任务不是无休止地思考，而是持续判断：","34":"用户目前正在推进什么？","35":"用户已经完成了什么？","36":"还有什么事情没有解决？","37":"当前有没有值得提供的帮助？","38":"现在提供帮助是否合适？","39":"这件事值得提醒、建议、准备，还是可以直接执行？","40":"建议形成以下闭环：","41":"① 获取授权范围内的上下文","42":"近期对话、任务记录、项目文档、用户明确设置的资料源","43":"② 理解当前任务与项目状态","44":"目标、已完成事项、待解决问题、约束和潜在需求","45":"③ 发现潜在帮助机会","46":"遗漏、风险、相关资料、下一步行动、可自动化的重复工作","47":"④ 评估价值、可信度、时机与风险","48":"是否有用、是否重复、是否过早、是否涉及授权","49":"⑤ 选择合适的主动行为","50":"暂不打扰、提出建议、准备成果，或在已授权范围内执行","51":"⑥ 根据用户反馈与实际效果调整","52":"记录是否有帮助，优化后续主动行为","53":"这里最关键的一点是：","54":"智能体不应该因为发现了一个可能性，就立即采取行动。","55":"它还需要判断这件事是否值得做，以及是否应该现在做。","56":"三、你提到的第一个具体需求：自动整理近期对话，理解用户当前在做什么","57":"我认为这是最值得优先实现的主动智能功能之一。","58":"普通的对话历史，只是把消息按照时间顺序保存下来。","59":"真正的个人智能体应该能够从这些历史中提取持续有用的信息，形成一个可以不断修正的“当前工作状态”。","60":"例如，一个用户最近围绕某个项目讨论了很多次，智能体应该能够整理出：","61":"当前工作状态摘要","62":"示例：根据近期对话整理","63":"当前主要目标","64":"正在推进的项目是什么，最终想达到什么效果。","65":"已经确定的事项","66":"已作出的重要决定、选择过的方案，以及不能随意改变的约束。","67":"正在进行的工作","68":"当前阶段、已经完成的任务、最近的进展。","69":"待解决的问题","70":"讨论过但没有得出结论的问题、尚未验证的假设、依赖的前置条件。","71":"可能的下一步","72":"根据当前目标与已有进展，推荐最值得推进的工作。","73":"判断依据与可信度","74":"哪些是用户明确说过的事实，哪些是系统推断，哪些信息已经过时或仍需确认。","75":"这与普通的聊天摘要有本质区别。","76":"普通摘要回答的是：“之前说了什么？”","77":"工作状态模型回答的是：“现在正在做什么、进展到哪里、还差什么、下一步做什么最有价值？”","78":"这里还需要进一步设计","79":"我建议不要只维护一份越来越长的全局记忆，而是维护分层的状态：","80":"会话状态：","81":" 当前这段对话正在解决什么问题。","82":"项目状态：","83":" 某个长期项目的目标、决定、进展和待办。","84":"近期活动摘要：","85":" 最近一段时间正在处理哪些事情。","86":"个人偏好：","87":" 用户明确表达并允许长期保存的工作习惯。","88":"待确认推断：","89":" 系统认为可能成立、但尚未得到确认的判断。","90":"这些状态之间需要建立关联，但不能混为一谈。","91":"例如，用户上周研究某项技术，并不代表今天仍然正在研究它。系统应当结合最近活动和明确的任务状态判断，而不是把旧信息当作当前事实。","92":"另外，理解用户当前状况应该主要聚焦于","93":"工作、任务、项目、明确表达的需求和用户授权的上下文","94":"，而不是未经允许地推断用户的私人生活、心理状态或敏感属性。","95":"四、第二个具体需求：主动发现用户没有想到的帮助","96":"我建议把主动帮助分成五类。","97":"6a501449-4b60-543b-91b6-71a191bd9f68","98":"1. 遗漏发现","99":"用户正在完成一项工作，智能体发现关键步骤、约束或验收条件可能遗漏。","100":"例如：完成项目架构设计后，发现还没有定义故障恢复和上线验收标准，于是主动提醒。","101":"eac36d13-dd19-5522-8e8e-ff2ed1602705","102":"2. 相关资料发现","103":"根据当前任务，寻找真正相关的文档、工具、信息或已有成果。","104":"例如：用户开始做新方案时，发现此前已经讨论过类似问题，直接复用已有结论，而不是重新从头研究。","105":"a4e63692-5937-5d73-bfab-3b417068dc56","106":"3. 更优方案发现","107":"不仅完成指定方案，还判断是否存在更简单、更稳定或成本更低的替代方案。","108":"例如：用户希望每次通过复杂提示词执行重复任务，智能体发现可以将其固化为带参数和验收规则的工作流。","109":"5119788c-1d78-53c4-8c97-c032929b9315","110":"4. 下一步准备","111":"在完成当前任务后，预先准备后续工作中能够直接复用的成果。","112":"例如：生成报告后，同时整理一份简短摘要、行动清单或待确认事项，供用户选择使用。","113":"c189f3c2-2d9a-5755-b42c-a953495500b9","114":"5. 重复劳动发现","115":"发现用户经常重复执行同一类任务，主动建议自动化。","116":"例如：用户多次让智能体按相同规则整理资料，系统可以建议创建一个可重复运行的工作流。","117":"这五类能力的共同点是：不改变用户原来的目标，而是在完成目标的基础上，发现额外的真实价值。","118":"五、怎样让它更自主，但不变得烦人？","119":"这是主动智能系统最需要设计好的地方。","120":"我建议建立五级自主性模型。","121":"自主性等级体验","122":"选择等级，查看对应行为。不同任务可以采用不同等级，不必全局统一。","123":"示例","124":"我的建议是：","125":"默认具备 L1 的上下文理解能力。","126":"允许用户开启 L2 的主动建议。","127":"对明确授权的任务逐步开放 L3。","128":"只有在范围、预算、风险和停止条件明确的情况下，才允许 L4。","129":"涉及高影响外部操作时，始终执行适用的授权和确认规则。","130":"用户还应该可以单独设置不同类型任务的自主等级。例如，允许自动整理资料，却要求所有对外发送的消息都先确认。","131":"自主性不是“什么都不问就执行”，而是在正确的边界内，尽可能减少用户不必要的介入。","132":"六、什么时候主动提供帮助？","133":"主动性还需要一个“时机判断”机制。","134":"建议分成四种触发方式：","135":"触发方式","136":"示例","137":"建议行为","138":"任务完成时","139":"用户要求生成一份方案","140":"完成主任务后，补充一项高价值遗漏或可选改进","141":"对话出现阶段性进展时","142":"一个长期项目已经明确了目标和关键约束","143":"提炼阶段成果，建议最值得推进的下一步","144":"定期整理时","145":"用户开启每日或每周总结","146":"整理近期对话、进展、待办和需要关注的问题","147":"明确事件触发时","148":"某个获准跟踪的任务、交付或外部状态发生变化","149":"在有意义的变化出现时提醒用户","150":"不是每次对话都应该触发主动帮助。","151":"例如，用户只是问“这个词是什么意思”，通常直接回答就足够了。","152":"如果用户正在推进一个复杂项目，已经反复讨论多个阶段，系统就更有理由帮助整理进展、识别遗漏和推荐下一步。","153":"建议建立一个主动帮助价值评估机制：","154":"V = P \\times I - C - R - N","155":"其中：","156":"P","157":"：这项帮助真正有用的可能性；","158":"I","159":"：潜在价值；","160":"C","161":"：用户需要承担的注意力和时间成本；","162":"R","163":"：执行风险；","164":"N","165":"：重复提醒或不合时宜造成的干扰。","166":"这只是一个概念模型，实际系统还需要考虑任务类型、用户偏好、紧迫程度和授权状态。","167":"它的核心意义是：","168":"发现帮助机会不等于应该打扰用户；只有经过价值与风险判断，才决定是否行动。","169":"七、把主动智能和自进化结合起来，但不要混为一谈","170":"这里有一个非常重要的架构问题。","171":"主动智能与自进化是两个不同的闭环。","172":"用户价值闭环","173":"理解当前任务与状态","174":"发现有价值的帮助机会","175":"建议、准备或受控执行","176":"用户获得价值，系统验证实际效果","177":"系统进化闭环","178":"收集运行证据与用户反馈","179":"诊断问题、生成改进候选","180":"独立评测、门禁与发布","181":"改善下一次任务的质量与主动帮助效果","182":"用户价值闭环解决“现在怎样帮助用户”。","183":"系统进化闭环解决“怎样让以后帮助得更好”。","184":"两者可以交换经过授权、治理和验证的经验，但不能让主动智能系统随意修改自身策略，也不能让后台进化直接控制用户端的权限边界。","185":"例如，系统发现用户经常接受某类建议，可以把它作为优化线索；但不能直接得出“用户以后都喜欢这类建议”的结论，更不能据此自动扩大操作权限。","186":"八、我建议增加一组新的产品级能力","187":"在之前的产品蓝图中，应该正式增加一个一级能力域：","188":"主动智能与个人工作状态管理","189":"它至少包含以下功能：","190":"功能模块","191":"用户可以得到什么","192":"近期对话自动整理","193":"不必自己回顾大量聊天记录","194":"项目状态汇总","195":"知道每个重要项目进展到哪里","196":"待解决问题识别","197":"不容易遗漏尚未完成的关键事项","198":"下一步行动建议","199":"更容易判断当前最值得推进什么","200":"相关资料发现","201":"更快找到已有信息和有价值的外部资料","202":"任务遗漏检查","203":"提前发现方案、报告或流程中的缺口","204":"超预期结果增强","205":"在完成主要任务后获得可选的额外价值","206":"重复任务发现","207":"将反复出现的劳动转化为工作流","208":"主动提醒与摘要","209":"在合适的时间接收有价值的信息","210":"主动行为控制台","211":"管理主动程度、频率、数据范围和授权","212":"这里不意味着要一次性全部开发。","213":"第一阶段应该优先实现三个功能：","214":"近期对话与项目状态整理。","215":"任务完成后的遗漏检查和高价值建议。","216":"用户可控的主动帮助机制。","217":"这三项能够直接改善用户体验，而且不需要一开始就构建复杂的后台自主代理网络。","218":"之后再逐步开放定期整理、外部事件监测、主动准备成果和受控自主执行。","219":"九、这项设计最终要解决什么问题？","220":"我希望 EvoAgent 最终形成这样的使用体验：","221":"用户说：“帮我完成这项工作。”","222":"EvoAgent 不仅能够高质量完成，而且知道用户为什么要做这件事，能够利用已授权的相关上下文，主动发现重要遗漏，并提供经过判断的额外帮助。","223":"用户没有发出新指令时，它也不只是静静等待。它可以在适当的时候整理近期进展，发现值得关注的问题，或者提前准备下一步工作。","224":"但如果没有真正有价值的事情，它就安静地等待，而不是为了证明自己有自主性而制造活动。","225":"所以，我们真正要追求的不是一个永远在后台运行、不断做事的智能体，而是一个懂得什么时候应该主动、什么时候应该执行、什么时候应该询问、什么时候应该保持安静的个人智能体。","226":"这将成为 EvoAgent 区别于单纯聊天工具、传统自动化工具和单纯自进化实验系统的重要产品方向。"},"fallbackMarkdown":"你这个想法非常重要。我认为它会直接决定 EvoAgent 最终是一个“任务执行工具”，还是一个真正有价值的“个人智能体”。\n\n前面我们一直在解决：用户提出任务后，怎样让系统高质量地完成。\n\n你现在提出了更进一步的问题：\n\n**如果用户没有明确提出任务，智能体能不能根据已经授权的上下文，主动发现用户可能需要什么，并在合适的时候提供帮助？即使用户提出了任务，智能体能不能在完成任务之外，进一步发现用户没想到、但确实有价值的事情？**\n\n我的答案是：应该，而且应该把它设计成 EvoAgent 的核心能力之一，而不是以后随手增加的一个功能。\n\n但这里有一个重要区别：我们不是要让智能体不停地打扰用户，而是让它在合适的时间，以合适的自主程度，做真正有价值的事情。\n\n# 一、EvoAgent 应该具备三种智能，而不只是执行智能\n\nimage_group{\"query\":[\"minimal elegant illustration AI assistant completing a checklist and delivering finished document on desk\"],\"aspect_ratio\":\"3:4\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n## 第一种：任务执行智能\n\n(最高优先级)\n\n用户提出明确目标，智能体负责理解、规划、执行、验证和交付。\n\n例如：整理资料、制作报告、操作手机、修改代码、生成视频。\n\n**衡量标准：任务是否高质量完成。**\n\n---\n\nimage_group{\"query\":[\"minimal illustration personal AI assistant organizing connected notes documents and project timeline on digital workspace\"],\"aspect_ratio\":\"3:4\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n## 第二种：主动理解与机会发现智能\n\n(产品差异化核心)\n\n智能体不只理解当前一句话，还能在授权范围内理解近期对话、正在推进的项目、尚未解决的问题和可能的下一步需求。\n\n例如：自动整理近期讨论，发现一个项目还有关键设计没有确定，主动提出下一步建议。\n\n**衡量标准：是否在用户需要之前，发现了有价值的帮助机会。**\n\n---\n\nimage_group{\"query\":[\"minimal illustration intelligent assistant preparing helpful next steps a polished report checklist and useful resources on a clean workspace\"],\"aspect_ratio\":\"3:4\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n## 第三种：超预期价值智能\n\n(体验提升)\n\n在完成用户明确要求后，进一步发现遗漏、优化方案、补充有用资料，或者提前准备用户很可能需要的后续产物。\n\n例如：用户要求生成报告，智能体发现报告还缺少决策对比，于是在不改变原任务的前提下，主动提供一份对比表和可选的行动建议。\n\n**衡量标准：是否创造了额外的、实际可用的价值。**\n\n这三种智能有不同的职责，但必须协同。\n\n第一种保证 EvoAgent 可靠；第二种让它主动；第三种让它真正有用、逐渐形成区别于普通聊天工具的体验。\n\n其中，第二种和第三种都不能以牺牲第一种为代价。\n\n# 二、主动性应该怎么实现？\n\n我建议建立一个新的核心能力：**主动智能与机会发现系统（Proactive Intelligence &amp; Opportunity Discovery，PIOD）**。\n\n它不是一个新的领域专家，也不是另一个独立的聊天机器人，而是横跨通用内核和所有领域专家的共享能力。\n\n它的任务不是无休止地思考，而是持续判断：\n\n- 用户目前正在推进什么？\n- 用户已经完成了什么？\n- 还有什么事情没有解决？\n- 当前有没有值得提供的帮助？\n- 现在提供帮助是否合适？\n- 这件事值得提醒、建议、准备，还是可以直接执行？\n\n建议形成以下闭环：\n\n**① 获取授权范围内的上下文**\n\n近期对话、任务记录、项目文档、用户明确设置的资料源\n\n**② 理解当前任务与项目状态**\n\n目标、已完成事项、待解决问题、约束和潜在需求\n\n**③ 发现潜在帮助机会**\n\n遗漏、风险、相关资料、下一步行动、可自动化的重复工作\n\n**④ 评估价值、可信度、时机与风险**\n\n是否有用、是否重复、是否过早、是否涉及授权\n\n**⑤ 选择合适的主动行为**\n\n暂不打扰、提出建议、准备成果，或在已授权范围内执行\n\n**⑥ 根据用户反馈与实际效果调整**\n\n记录是否有帮助，优化后续主动行为\n\n这里最关键的一点是：**智能体不应该因为发现了一个可能性，就立即采取行动。**\n\n它还需要判断这件事是否值得做，以及是否应该现在做。\n\n---\n\n# 三、你提到的第一个具体需求：自动整理近期对话，理解用户当前在做什么\n\n我认为这是最值得优先实现的主动智能功能之一。\n\n普通的对话历史，只是把消息按照时间顺序保存下来。\n\n真正的个人智能体应该能够从这些历史中提取持续有用的信息，形成一个可以不断修正的“当前工作状态”。\n\n例如，一个用户最近围绕某个项目讨论了很多次，智能体应该能够整理出：\n\n## 当前工作状态摘要\n\n示例：根据近期对话整理\n\n---\n\n当前主要目标\n\n**正在推进的项目是什么，最终想达到什么效果。**\n\n已经确定的事项\n\n已作出的重要决定、选择过的方案，以及不能随意改变的约束。\n\n正在进行的工作\n\n当前阶段、已经完成的任务、最近的进展。\n\n待解决的问题\n\n讨论过但没有得出结论的问题、尚未验证的假设、依赖的前置条件。\n\n可能的下一步\n\n根据当前目标与已有进展，推荐最值得推进的工作。\n\n判断依据与可信度\n\n哪些是用户明确说过的事实，哪些是系统推断，哪些信息已经过时或仍需确认。\n\n这与普通的聊天摘要有本质区别。\n\n普通摘要回答的是：“之前说了什么？”\n\n工作状态模型回答的是：“现在正在做什么、进展到哪里、还差什么、下一步做什么最有价值？”\n\n## 这里还需要进一步设计\n\n我建议不要只维护一份越来越长的全局记忆，而是维护分层的状态：\n\n- **会话状态：** 当前这段对话正在解决什么问题。\n- **项目状态：** 某个长期项目的目标、决定、进展和待办。\n- **近期活动摘要：** 最近一段时间正在处理哪些事情。\n- **个人偏好：** 用户明确表达并允许长期保存的工作习惯。\n- **待确认推断：** 系统认为可能成立、但尚未得到确认的判断。\n\n这些状态之间需要建立关联，但不能混为一谈。\n\n例如，用户上周研究某项技术，并不代表今天仍然正在研究它。系统应当结合最近活动和明确的任务状态判断，而不是把旧信息当作当前事实。\n\n另外，理解用户当前状况应该主要聚焦于**工作、任务、项目、明确表达的需求和用户授权的上下文**，而不是未经允许地推断用户的私人生活、心理状态或敏感属性。\n\n# 四、第二个具体需求：主动发现用户没有想到的帮助\n\n我建议把主动帮助分成五类。\n\nimage_group{\"query\":[\"minimal illustration highlighted missing steps on a project checklist\"],\"aspect_ratio\":\"1:1\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**1\\. 遗漏发现**\n\n用户正在完成一项工作，智能体发现关键步骤、约束或验收条件可能遗漏。\n\n例如：完成项目架构设计后，发现还没有定义故障恢复和上线验收标准，于是主动提醒。\n\n---\n\nimage_group{\"query\":[\"minimal illustration research assistant organizing relevant source documents and notes\"],\"aspect_ratio\":\"1:1\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**2\\. 相关资料发现**\n\n根据当前任务，寻找真正相关的文档、工具、信息或已有成果。\n\n例如：用户开始做新方案时，发现此前已经讨论过类似问题，直接复用已有结论，而不是重新从头研究。\n\n---\n\nimage_group{\"query\":[\"minimal illustration intelligent assistant suggesting a simpler optimized workflow with connected task nodes\"],\"aspect_ratio\":\"1:1\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**3\\. 更优方案发现**\n\n不仅完成指定方案，还判断是否存在更简单、更稳定或成本更低的替代方案。\n\n例如：用户希望每次通过复杂提示词执行重复任务，智能体发现可以将其固化为带参数和验收规则的工作流。\n\n---\n\nimage_group{\"query\":[\"minimal illustration assistant preparing a useful report summary checklist before a meeting\"],\"aspect_ratio\":\"1:1\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**4\\. 下一步准备**\n\n在完成当前任务后，预先准备后续工作中能够直接复用的成果。\n\n例如：生成报告后，同时整理一份简短摘要、行动清单或待确认事项，供用户选择使用。\n\n---\n\nimage_group{\"query\":[\"minimal illustration automated workflow discovering repeated tasks and creating reusable template\"],\"aspect_ratio\":\"1:1\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**5\\. 重复劳动发现**\n\n发现用户经常重复执行同一类任务，主动建议自动化。\n\n例如：用户多次让智能体按相同规则整理资料，系统可以建议创建一个可重复运行的工作流。\n\n这五类能力的共同点是：不改变用户原来的目标，而是在完成目标的基础上，发现额外的真实价值。\n\n---\n\n# 五、怎样让它更自主，但不变得烦人？\n\n这是主动智能系统最需要设计好的地方。\n\n我建议建立五级自主性模型。\n\n## 自主性等级体验\n\n选择等级，查看对应行为。不同任务可以采用不同等级，不必全局统一。\n\n---\n\n示例\n\n我的建议是：\n\n- 默认具备 L1 的上下文理解能力。\n- 允许用户开启 L2 的主动建议。\n- 对明确授权的任务逐步开放 L3。\n- 只有在范围、预算、风险和停止条件明确的情况下，才允许 L4。\n- 涉及高影响外部操作时，始终执行适用的授权和确认规则。\n\n用户还应该可以单独设置不同类型任务的自主等级。例如，允许自动整理资料，却要求所有对外发送的消息都先确认。\n\n**自主性不是“什么都不问就执行”，而是在正确的边界内，尽可能减少用户不必要的介入。**\n\n# 六、什么时候主动提供帮助？\n\n主动性还需要一个“时机判断”机制。\n\n建议分成四种触发方式：\n\n| 触发方式 | 示例 | 建议行为 |\n|--------|--------|--------|\n| 任务完成时 | 用户要求生成一份方案 | 完成主任务后，补充一项高价值遗漏或可选改进 |\n| 对话出现阶段性进展时 | 一个长期项目已经明确了目标和关键约束 | 提炼阶段成果，建议最值得推进的下一步 |\n| 定期整理时 | 用户开启每日或每周总结 | 整理近期对话、进展、待办和需要关注的问题 |\n| 明确事件触发时 | 某个获准跟踪的任务、交付或外部状态发生变化 | 在有意义的变化出现时提醒用户 |\n\n不是每次对话都应该触发主动帮助。\n\n例如，用户只是问“这个词是什么意思”，通常直接回答就足够了。\n\n如果用户正在推进一个复杂项目，已经反复讨论多个阶段，系统就更有理由帮助整理进展、识别遗漏和推荐下一步。\n\n建议建立一个主动帮助价值评估机制：\n\n\\[\nV = P \\times I - C - R - N\n\\]\n\n其中：\n\n- \\(P\\)：这项帮助真正有用的可能性；\n- \\(I\\)：潜在价值；\n- \\(C\\)：用户需要承担的注意力和时间成本；\n- \\(R\\)：执行风险；\n- \\(N\\)：重复提醒或不合时宜造成的干扰。\n\n这只是一个概念模型，实际系统还需要考虑任务类型、用户偏好、紧迫程度和授权状态。\n\n它的核心意义是：**发现帮助机会不等于应该打扰用户；只有经过价值与风险判断，才决定是否行动。**\n\n---\n\n# 七、把主动智能和自进化结合起来，但不要混为一谈\n\n这里有一个非常重要的架构问题。\n\n主动智能与自进化是两个不同的闭环。\n\n## 用户价值闭环\n\n理解当前任务与状态\n\n发现有价值的帮助机会\n\n建议、准备或受控执行\n\n用户获得价值，系统验证实际效果\n\n---\n\n## 系统进化闭环\n\n收集运行证据与用户反馈\n\n诊断问题、生成改进候选\n\n独立评测、门禁与发布\n\n改善下一次任务的质量与主动帮助效果\n\n用户价值闭环解决“现在怎样帮助用户”。\n\n系统进化闭环解决“怎样让以后帮助得更好”。\n\n两者可以交换经过授权、治理和验证的经验，但不能让主动智能系统随意修改自身策略，也不能让后台进化直接控制用户端的权限边界。\n\n例如，系统发现用户经常接受某类建议，可以把它作为优化线索；但不能直接得出“用户以后都喜欢这类建议”的结论，更不能据此自动扩大操作权限。\n\n---\n\n# 八、我建议增加一组新的产品级能力\n\n在之前的产品蓝图中，应该正式增加一个一级能力域：\n\n## 主动智能与个人工作状态管理\n\n它至少包含以下功能：\n\n| 功能模块 | 用户可以得到什么 |\n|--------|--------|\n| 近期对话自动整理 | 不必自己回顾大量聊天记录 |\n| 项目状态汇总 | 知道每个重要项目进展到哪里 |\n| 待解决问题识别 | 不容易遗漏尚未完成的关键事项 |\n| 下一步行动建议 | 更容易判断当前最值得推进什么 |\n| 相关资料发现 | 更快找到已有信息和有价值的外部资料 |\n| 任务遗漏检查 | 提前发现方案、报告或流程中的缺口 |\n| 超预期结果增强 | 在完成主要任务后获得可选的额外价值 |\n| 重复任务发现 | 将反复出现的劳动转化为工作流 |\n| 主动提醒与摘要 | 在合适的时间接收有价值的信息 |\n| 主动行为控制台 | 管理主动程度、频率、数据范围和授权 |\n\n这里不意味着要一次性全部开发。\n\n第一阶段应该优先实现三个功能：\n\n1. **近期对话与项目状态整理。**\n2. **任务完成后的遗漏检查和高价值建议。**\n3. **用户可控的主动帮助机制。**\n\n这三项能够直接改善用户体验，而且不需要一开始就构建复杂的后台自主代理网络。\n\n之后再逐步开放定期整理、外部事件监测、主动准备成果和受控自主执行。\n\n## 九、这项设计最终要解决什么问题？\n\n我希望 EvoAgent 最终形成这样的使用体验：\n\n用户说：“帮我完成这项工作。”\n\nEvoAgent 不仅能够高质量完成，而且知道用户为什么要做这件事，能够利用已授权的相关上下文，主动发现重要遗漏，并提供经过判断的额外帮助。\n\n用户没有发出新指令时，它也不只是静静等待。它可以在适当的时候整理近期进展，发现值得关注的问题，或者提前准备下一步工作。\n\n但如果没有真正有价值的事情，它就安静地等待，而不是为了证明自己有自主性而制造活动。\n\n**所以，我们真正要追求的不是一个永远在后台运行、不断做事的智能体，而是一个懂得什么时候应该主动、什么时候应该执行、什么时候应该询问、什么时候应该保持安静的个人智能体。**\n\n这将成为 EvoAgent 区别于单纯聊天工具、传统自动化工具和单纯自进化实验系统的重要产品方向。","fallbackMarkdownVersion":1,"requiredComponents":["AsyncImage"],"appData":{"opGenui":{"componentResults":{"a588d0a9-b3f2-5d84-b96a-e7dbc7573701":{"status":"resolved","state":{"frame_aspect_ratio":"3:4","frame_width":"100%","frame_max_width":"112px","frame_height":"auto","max_height":null,"presentation":{"min_width":"0px","min_height":null,"radius":"xl","frame":true},"has_fallback":false,"image_fit":"cover","is_loading":false,"images":[{"url":"https://www.catchagent.ai/blog/productivity/how-to-use-ai-for-business","content_url":"https://images.openai.com/static-rsc-4/xYUTWKrb7mZqWhZak6pIQduS601avRgYejZlYe00U0ClTm7VtKkf1oq5Rvmbqsk6rFzfsf-RDNAaPaeg9Ymxy4rtW_DbnylZSmsY3DmzgJVBg6UlPGfqGBRZeisHV2uaQk6cwvguJAbt03bHIAx1GZhW_EImFxwszArMrb0a314s6kh4gIN6VGA3pjRe_TxT?purpose=fullsize","thumbnail_url":"https://images.openai.com/static-rsc-4/rzolti2xcDD6z-TBm-4EBSQuwr0CX8_SQEK18lrxsC9xhtEwhYWPJe_eZSTXrUYXUlbVAid2Q9KTnNSSeEQg9qNGNmI-Fsawd3ZahL6G_s3-INYdh2sCg31oGJdOxHzcxZKD5EtzLAvpDmqE_0Yb8jM3PP4TlHTSr_lUaft3pFQ?purpose=i