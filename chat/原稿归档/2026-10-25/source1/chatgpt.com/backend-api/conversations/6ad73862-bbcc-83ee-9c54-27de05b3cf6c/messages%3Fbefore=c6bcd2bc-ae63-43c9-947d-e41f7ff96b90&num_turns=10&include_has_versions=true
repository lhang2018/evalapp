回滚目标。缺失兼容声明的\\n制品不得进入稳定通道。\\n\\n\\n\\n\\n                                                       EvoAgent｜全量详细设计正式版 1.0\"}],\"ref_id\":\"turn37file1\"},{\"version_id\":\"1\",\"name\":\"EvoAgent_核心接口与数据契约正式规范.docx\",\"mime_type\":\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\"size_bytes\":null,\"created_at\":\"2026-10-20T23:35:44Z\",\"modified_at\":\"2026-10-20T23:35:44Z\",\"file_provider\":\"native\",\"library_file_id\":\"libfile_3c0f90e4b244819194e43579f657bdaf\",\"result_index\":2,\"file_id\":\"file_0000000030e88209bc3bbe86e7cb5060\",\"surface\":\"conversation\",\"score\":0.03200204813108039,\"snippets\":[{\"text\":\"3. Runtime Event 契约\\n    {\\n        \\\"event_id\\\": \\\"uuid-or-ulid\\\",\\n        \\\"task_id\\\": \\\"uuid\\\",\\n        \\\"run_id\\\": \\\"uuid\\\",\\n        \\\"sequence_no\\\": 1,\\n        \\\"event_type\\\": \\\"task.started|tool.completed|task.failed\\\",\\n        \\\"schema_version\\\": \\\"1.0\\\",\\n        \\\"runtime_manifest_id\\\": \\\"immutable-id\\\",\\n        \\\"created_at\\\": \\\"RFC3339\\\",\\n\\n                                                      EvoAgent｜全量详细设计正式版 1.0\\n      \\\"privacy_level\\\": \\\"public|internal|sensitive|restricted\\\",\\n      \\\"payload_ref\\\": \\\"local-uri-or-inline-small-payload\\\",\\n      \\\"sync_status\\\": \\\"pending|in_flight|acknowledged|quarantined\\\"\\n  }\\n\\n\\n\\n\\n4. Tool Contract\\n  {\\n      \\\"tool_id\\\": \\\"stable-name\\\",\\n      \\\"version\\\": \\\"immutable-version\\\",\\n      \\\"input_schema\\\": {},\\n      \\\"output_schema\\\": {},\\n      \\\"risk_class\\\": \\\"low|medium|high|critical\\\",\\n      \\\"required_permissions\\\": [],\\n      \\\"timeout_seconds\\\": 30,\\n      \\\"idempotency\\\": \\\"idempotent|keyed|non_idempotent\\\",\\n      \\\"offline_capable\\\": false,\\n      \\\"requires_network\\\": true,\\n      \\\"cost_model\\\": {},\\n      \\\"health_check_ref\\\": \\\"optional\\\",\\n      \\\"contract