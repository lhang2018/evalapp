\"577\"]),__dil.jsx(\"text\",null,__dilConstants[\"578\"]),__dil.jsx(\"list\",{\"marker\":\"number\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"579\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"580\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"581\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"582\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"583\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"584\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"585\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"586\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"587\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"588\"]))),__dil.jsx(\"text\",null,__dilConstants[\"589\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第六专项：工具、专业能力与工作流治理系统全量设计","1":"这一轮，我们解决 EvoAgent 自进化架构中另一个容易被低估的问题：","2":"智能体能否正确判断自己需要什么能力、正确调用它、确认它是否可靠，并在能力本身出现问题时找到真正的根因。","3":"前面已经设计了提示词治理、上下文工程、记忆、任务状态、ReAct 和多专家架构。现在需要把这些模块与真正执行工作的工具连接起来。","4":"例如，编程专家修改代码失败，可能有很多原因：","5":"模型没有正确理解需求；","6":"Planner 把任务拆错了；","7":"上下文漏掉了兼容性约束；","8":"模型调用工具时参数错误；","9":"工具接口定义与真实实现不一致；","10":"AST 分析器有缺陷；","11":"编译环境缺少依赖；","12":"测试本身不可靠；","13":"验收器错误地判定成功。","14":"如果 EvoAgent 只记录“任务失败”，然后让服务端修改提示词，它就可能不断优化错误的对象。","15":"因此，这一专项的核心目标是建立一套","16":"能力可描述、调用可约束、结果可验证、故障可归因、版本可追溯、升级可回滚","17":"的工具与能力基础设施。","18":"一、首先统一六个概念","19":"这些概念必须分清，否则后续数据库、接口和进化系统都会混乱。","20":"1. 工具 Tool","21":"一个可以被调用的具体执行接口。","22":"例如：读取文件、启动 Android 应用、运行测试、生成图像、查询云端任务状态。","23":"2. 专业技术能力 Skill","24":"完成某类问题所需的算法、知识、工具组合和验证方法。","25":"例如：Python AST 重构、角色一致性检查、Android 界面状态识别。","26":"3. 领域专家 Expert","27":"理解某个领域目标，选择策略、专业能力和工具，并对领域结果负责。","28":"例如：编程专家、AI 漫剧专家、手机操作专家。","29":"4. 工作流 Workflow","30":"把经过验证的多个步骤编排成可重复、可恢复的执行过程。","31":"例如：剧本 → 角色 → 分镜 → 视频 → 配音 → 合成 → 验收。","32":"5. 模型适配器 Model Adapter","33":"把统一的模型调用协议转换成具体供应商或模型支持的请求格式。","34":"例如：工具调用格式、结构化输出、模型能力差异和错误码映射。","35":"6. 运行环境 Runtime","36":"实际执行工具和工作流的设备、进程、依赖、权限与资源环境。","37":"例如：Android 本地执行环境、云端容器、Python 沙箱、FFmpeg 运行环境。","38":"它们之间的关系可以概括为：","39":"专家决定当前任务需要什么专业能力。","40":"专业能力决定应该采用哪些算法、工具和验证步骤。","41":"工作流将多个能力按依赖关系组织起来。","42":"工具执行具体操作。","43":"运行环境提供真实的执行条件。","44":"模型适配器负责模型交互，不负责替工具证明其结果正确。","45":"工具是能力的执行入口，但工具本身不等于完整能力。","46":"例如，能够调用 Python 解释器，不代表具备可靠的代码修改能力。真正的代码修改能力还需要理解项目结构、分析语法树、规划修改、运行测试、检查差异并验证结果。","47":"二、建立统一能力注册中心","48":"EvoAgent 需要一个统一的 Capability Registry（能力注册中心），让路由器、Planner、专家和工作流引擎知道当前有哪些能力可以使用，以及它们适用于什么条件。","49":"但它不能只是一个工具名称列表。","50":"一个能力注册项至少应该回答十个问题：","51":"它能解决什么问题？","52":"哪些任务适合使用它？","53":"哪些情况不适合使用它？","54":"需要什么输入和前置条件？","55":"输出什么结果？","56":"会产生什么副作用？","57":"需要哪些权限？","58":"运行成本和资源需求是什么？","59":"如何验证结果正确？","60":"当前哪个版本经过了哪些测试？","61":"2.1 能力注册项的数据结构","62":"55cbf61c-766f-58d7-b269-1aee00347e28","63":null,"64":"这是注册协议的示例。正式实现还应记录能力来源、依赖版本、运行环境约束、许可证、超时策略、兼容性范围、故障历史和发布清单。","65":"这里的 ","66":"cost_class","67":" 只能用于初步筛选，不能替代实际成本核算。真正调度时，还应考虑当前资源占用、预计执行时间、外部 API 费用和剩余预算。","68":"2.2 能力发现与执行权限分开","69":"注册中心回答的是“有哪些能力、哪些可能适用”。","70":"它不应该直接决定“当前任务可以执行哪些动作”。","71":"例如，系统注册了文件删除工具，不意味着编程专家可以随意删除用户文件。实际执行仍需要检查：","72":"当前任务是否确实需要删除；","73":"目标文件是否属于授权范围；","74":"当前用户是否授予相应权限；","75":"删除是否可恢复；","76":"是否需要用户确认；","77":"当前运行环境是否允许该操作。","78":"能力发现与权限判定必须是两个独立步骤。","79":"2.3 能力可以有多个实现","80":"这对手机优先和云端优先架构都很重要。","81":"同一种逻辑能力可能有多个实现：","82":"能力","83":"实现 A","84":"实现 B","85":"图像识别","86":"Android 本地视觉模型","87":"云端视觉 API","88":"语音转写","89":"本地语音识别","90":"云端语音识别","91":"代码分析","92":"本地 AST 工具","93":"云端代码分析服务","94":"视频合成","95":"手机端 FFmpeg","96":"云端视频处理服务","97":"界面识别","98":"Android 无障碍节点","99":"屏幕视觉识别","100":"因此，专家应该依赖稳定的能力契约，而不是把具体供应商、设备或工具实现写死在自己的提示词中。","101":"调度器可以根据准确率、延迟、成本、隐私、网络状态和可用资源选择实现，但不能为了节省成本而违反任务质量或权限要求。","102":"三、统一工具契约：调用之前，先明确什么叫正确调用","103":"工具最常见的问题之一，是接口看起来能调用，但输入输出的含义不清楚。","104":"例如，一个名为 ","105":"open_app","106":" 的工具，究竟表示：","107":"已经发出了启动请求；","108":"Android 已经接受启动请求；","109":"目标应用已经进入前台；","110":"目标页面已经成功打开；","111":"用户可以开始下一步操作。","112":"这五个结果完全不同。","113":"如果工具只返回 ","114":"{\"success\": true}","115":"，ReAct 可能把“启动请求已提交”误判为“任务已经完成”。","116":"所以，我建议每个工具都必须声明输入契约、输出契约、前置条件、后置条件、失败语义和副作用。","117":"3.1 工具契约至少包括哪些部分？","118":"契约部分","119":"需要明确的内容","120":"输入契约","121":"必填字段、类型、范围、格式和业务约束","122":"前置条件","123":"权限、登录状态、文件存在、网络可用等","124":"执行语义","125":"工具实际承诺执行到哪一步","126":"输出契约","127":"返回值结构、状态含义、证据和错误类型","128":"后置条件","129":"调用结束后必须成立的可验证条件","130":"副作用","131":"文件修改、应用启动、费用产生、消息发送等","132":"幂等语义","133":"相同请求重复执行会怎样","134":"超时语义","135":"超时代表失败、未知，还是仍在后台执行","136":"恢复语义","137":"能否查询状态、重试、取消或补偿","138":"版本兼容","139":"输入输出是否兼容旧调用方","140":"特别是“超时语义”和“幂等语义”，它们直接决定任务能否安全恢复。","141":"3.2 用 Android 应用启动举例","142":"假设工具的输入是：","143":"177e941f-ddda-5634-b353-07fa1183b0b8","144":null,"145":"不能简单地把返回结果定义成：","146":"63d9afc2-3f06-56ea-b642-3423e6d02509","147":null,"148":"更合理的是区分：","149":"1faf0fb8-c4bf-53d6-ac7c-6969db8b0477","150":null,"151":"随后由界面状态观察器确认应用是否真正进入前台。","152":"如果应用启动失败，则返回明确的错误类别，例如：","153":"APP_NOT_INSTALLED","154":"LAUNCH_NOT_ALLOWED","155":"ACTIVITY_NOT_FOUND","156":"APP_START_TIMEOUT","157":"FOREGROUND_NOT_CONFIRMED","158":"这里的重点不是错误码一定采用这些名字，而是必须让不同故障拥有不同的语义，避免 ReAct 只能根据自然语言错误信息猜测发生了什么。","159":"3.3 工具输出不能自动等于事实","160":"工具返回值也可能错误。","161":"因此，建议区分三个层次：","162":"工具自报结果","163":"：工具声称自己执行了什么。","164":"运行证据","165":"：日志、文件、系统状态或远端任务状态。","166":"独立验证结论","167":"：根据证据和验收规则判断结果是否符合预期。","168":"并非每个工具都需要独立调用第二个工具来验证，但对高风险操作和关键任务结果，应当尽可能获得与执行声明相独立的证据。","169":"例如，文件写入工具返回成功后，可以通过读取文件、校验哈希或检查目标内容验证；云端视频生成返回成功后，可以查询远端任务状态并检查实际产物。","170":"四、工具调用控制器：所有执行统一经过一个受控入口","171":"我不建议让每个专家直接调用底层工具。否则，不同专家可能各自实现权限检查、重试、日志和错误处理，最终很难保证行为一致。","172":"建议引入统一的 ","173":"Tool Execution Gateway","174":"。","175":"专家 / ReAct / 工作流节点","176":"提出工具调用请求","177":"工具执行网关","178":"参数校验、权限检查、预算预留、幂等控制","179":"本地执行器","180":"Android / 桌面 / 沙箱","181":"远端执行器","182":"API / 云端任务 / 服务","183":"结果核验与执行账本","184":"记录结果、证据、副作用、费用与错误","185":"统一执行结果","186":"返回 ReAct、工作流引擎和任务控制器","187":"这个网关负责确保工具调用遵守统一的执行规则，但不需要把所有工具实现都放在一个进程或一台服务器中。","188":"4.1 调用协议需要具备哪些机制？","189":"建议每次调用至少关联：","190":"invocation_id","191":"：唯一调用标识；","192":"task_id","193":"、","194":"node_id","195":"：任务与节点关联；","196":"capability_id","197":" 和 ","198":"tool_version","199":"：实际使用的能力与工具版本；","200":"idempotency_key","201":"：识别同一逻辑操作的重复请求；","202":"authorization_context","203":"：授权检查的受控引用；","204":"budget_reservation_id","205":"：预算预留记录；","206":"trace_id","207":"：贯穿模型、工具和任务日志的关联 ID；","208":"input_ref","209":"、","210":"output_ref","211":"：必要的输入输出引用；","212":"side_effect_state","213":"：副作用状态；","214":"evidence_refs","215":"：支持执行结论的证据。","216":"这样，工具故障可以关联到具体任务、模型调用、专家版本和上下文快照，而不是只留下一个孤立的错误日志。","217":"4.2 重试机制不能一刀切","218":"我建议至少将重试分为四类：","219":"类别","220":"示例","221":"默认处理","222":"安全重试","223":"读取文件时发生暂时性网络错误","224":"在预算和次数限制内重试","225":"核查后重试","226":"云端任务请求超时","227":"先查询原请求状态","228":"修正后重试","229":"参数格式错误","230":"修正参数并重新校验","231":"禁止自动重试","232":"已发送消息、已支付、权限被拒绝","233":"停止或进入受控恢复流程","234":"实际规则必须由工具契约和风险策略共同决定。","235":"即使一个工具声明为幂等，也需要确认幂等键的作用范围、保存期限以及供应商是否真正支持该语义，不能仅凭配置中的一个布尔值就认为重复执行绝对安全。","236":"五、专业技术能力：为什么不能只依赖通用大模型？","237":"你之前特别提到，编程可能需要 AST 语法树和专门的优化技术，其他场景也会有类似需求。","238":"这正是能力系统需要解决的问题。","239":"通用大模型负责理解、推理和策略选择，但在很多场景中，可靠性来自专业算法、确定性工具和领域验证，而不只是更好的提示词。","240":"我建议把专业能力拆成三类。","241":"5.1 第一类：确定性技术能力","242":"适合有明确输入、明确规则、可验证输出的问题。","243":"a588d0a9-b3f2-5d84-b96a-e7dbc7573701","244":"编程：AST 与静态分析","245":"解析语法树、符号引用、类型检查、代码差异分析、编译和测试。模型负责提出修改方案，确定性工具负责检查结构与行为。","246":"339f3929-b005-5464-9db1-8a1b00da4b7e","247":"AI 漫剧：媒体处理","248":"FFmpeg 合成、时长检查、分辨率检查、音画同步、帧率与音频格式校验。","249":"caeda85d-331b-5956-b5d3-e030ea256046","250":"手机操作：界面状态验证","251":"无障碍节点读取、应用包名核验、页面状态检测、操作前后状态比对。","252":"这类能力的优势是结果通常更容易验证。但确定性工具也可能存在实现缺陷、环境依赖问题和版本兼容问题，因此仍然需要测试与运行时校验。","253":"5.2 第二类：模型辅助的专业能力","254":"例如：","255":"复杂代码架构理解；","256":"视频分镜设计；","257":"角色外观一致性判断；","258":"复杂网页结构理解；","259":"语音对话意图识别。","260":"这类能力需要模型进行语义判断，但应当尽可能用确定性工具、领域规则或独立评测约束结果。","261":"例如，角色一致性不能只靠模型说“角色看起来一致”。可以结合角色参考图、视觉相似度、关键特征检查和人工抽样验收。","262":"5.3 第三类：复合型能力","263":"很多真正有价值的能力都属于这一类。","264":"例如，可靠的代码重构能力可能由以下部分组成：","265":"模型理解修改目标；","266":"AST 工具分析代码结构；","267":"Planner 生成修改计划；","268":"受控补丁工具实施修改；","269":"编译器检查语法和类型；","270":"测试运行器验证行为；","271":"验收器检查目标和回归结果。","272":"这才是一项完整的专业能力，而不是一个单独的工具或提示词。","273":"5.4 AST 代码重构的完整执行示例","274":"这里不应该强制每一次代码修改都使用 AST。例如，修改一个简单的文档字符串，可能不需要复杂的语法树重构流程。","275":"专业能力应该根据任务风险、代码结构、修改范围和验收要求决定使用哪些技术，而不是为了体现专业性而增加不必要的步骤。","276":"六、工具故障归因：智能体怎样知道究竟是谁出了问题？","277":"这是本专项最核心的设计。","278":"我们不能只使用一个 ","279":"failure_reason","280":" 字段，让模型自行填写“工具失败”或“提示词不够好”。","281":"建议建立独立的故障诊断器（Failure Diagnosis Engine），并明确区分","282":"观察事实、根因假设、验证实验和最终结论","283":"。","284":"6.1 故障分类树","285":"任务或节点未达到预期结果","286":"理解与决策","287":"意图识别、规划、推理、上下文、提示词","288":"执行与环境","289":"工具、参数、依赖、网络、权限、资源","290":"结果与验收","291":"目标不清、验收标准错误、证据不足、验证器缺陷","292":"系统与协同","293":"状态不一致、重复执行、版本不兼容、同步失败、预算耗尽","294":"一个故障可能有多个原因。例如，模型生成了错误参数，而工具又没有正确校验参数，这可能同时包含调用策略缺陷和工具契约缺陷。","295":"因此，诊断器不应强行选择唯一根因，而应支持：","296":"主要根因；","297":"次要促成因素；","298":"尚未排除的假设；","299":"已经排除的假设；","300":"支持与反对每个假设的证据；","301":"根因结论的验证状态。","302":"6.2 一个具体案例","303":"假设编程专家尝试修改代码，但最终测试失败。","304":"诊断器不应该直接增加一句“修改代码后一定要仔细检查”。","305":"而应该按证据逐步判断：","306":"检查点","307":"观察结果","308":"可能结论","309":"用户目标解析","310":"兼容性约束已正确提取","311":"初步排除目标遗漏","312":"上下文快照","313":"兼容性约束实际进入模型请求","314":"初步排除上下文遗漏","315":"工具参数校验","316":"参数符合工具 Schema","317":"排除明显的参数格式错误","318":"AST 分析结果","319":"目标符号引用关系解析错误","320":"怀疑专业能力缺陷","321":"测试环境","322":"依赖版本与基线一致","323":"降低环境不一致的可能性","324":"修复工具问题后重测","325":"相同案例恢复通过","326":"支持工具缺陷假设","327":"这里的关键是“初步排除”和“支持假设”，而不是仅凭一条日志就断言根因已经确定。","328":"6.3 根因诊断必须有自己的评测集","329":"诊断器本身也可能判断错误。","330":"因此，应该建立包含已知故障的诊断测试集，例如：","331":"工具返回错误但实际操作成功；","332":"工具没有执行成功却返回成功；","333":"模型参数错误；","334":"上下文遗漏约束；","335":"测试环境异常；","336":"工作流依赖关系错误；","337":"日志缺失或时间顺序不完整。","338":"对于这些测试案例，系统应检查诊断准确率、误归因率、证据覆盖率和错误修复成本。","339":"特别要关注","340":"错误归因导致的二次损害","341":"：如果工具存在缺陷，系统却不断修改提示词，最终可能让提示词越来越复杂、成本越来越高，工具缺陷仍然存在。","342":"七、工具可靠性工程：如何证明一个工具可以被使用？","343":"工具注册完成，不等于工具已经可靠。","344":"我建议每个工具根据风险等级建立独立的质量契约，至少包含五类测试。","345":"7.1 五层测试体系","346":"测试层","347":"验证内容","348":"示例","349":"契约测试","350":"输入输出与 Schema 是否一致","351":"缺少必填参数时是否明确拒绝","352":"单元测试","353":"工具内部逻辑是否正确","354":"AST 节点转换是否保持语义","355":"集成测试","356":"工具与环境、依赖和服务是否兼容","357":"FFmpeg 是否能读取目标编码格式","358":"故障注入","359":"异常条件下能否安全处理","360":"网络超时、磁盘满、进程中断","361":"端到端测试","362":"工具在真实任务链路中是否达成目标","363":"修改代码后测试通过且无意外差异","364":"高风险工具还需要额外的权限测试、并发测试、重复调用测试和安全边界测试。","365":"7.2 工具必须有独立的验收契约","366":"例如，文件修改工具的契约不能只是“成功写入文件”。","367":"它可以规定：","368":"目标路径必须位于授权工作区；","369":"修改前必须保存原始版本或具备恢复方式；","370":"返回值必须包含实际修改文件清单；","371":"必须能核对修改前后的差异；","372":"未经授权不得修改其他文件；","373":"发生部分写入时必须返回明确状态；","374":"发生不确定结果时必须支持核查。","375":"这样，工具质量不再依赖模型是否在提示词里记住了所有注意事项。","376":"7.3 工具故障要区分两个指标","377":"这是一个重要的评测设计。","378":"工具自身可靠性","379":"衡量：在合法输入、满足前置条件的情况下，工具是否按契约工作。","380":"工具使用可靠性","381":"衡量：整个智能体是否能够选择合适的工具、生成正确参数、理解返回结果，并在必要时完成恢复。","382":"两者不能混为一个成功率。","383":"例如，某个工具在合法输入下成功率达到 99.9%，但模型经常给它传入错误参数，那么整体任务成功率仍然可能很低。此时主要问题可能在调用策略或参数生成，而不是工具内部实现。","384":"反过来，模型参数完全正确，但工具经常超时或返回错误，问题就应该优先交给工具可靠性工程处理。","385":"八、工作流治理：从一次跑通到可重复执行的能力","386":"你之前特别关心：一个复杂任务跑通之后，怎样把它固化成稳定的工作流，以后还可以持续迭代。","387":"这次我们把它与能力系统正式连接起来。","388":"建议工作流不是一段由模型生成后直接执行的任意代码，而是一个具有版本、节点契约、依赖、恢复策略和验收条件的正式资产。","389":"8.1 工作流节点必须定义什么？","390":"每个节点至少需要：","391":"输入输出契约；","392":"前置条件；","393":"使用的能力与工具版本；","394":"成功与失败判定；","395":"超时与重试策略；","396":"副作用与幂等语义；","397":"验收要求；","398":"检查点与恢复策略；","399":"预算限制；","400":"允许的重规划范围。","401":"例如，AI 漫剧工作流中的“生成视频”节点，不应只规定“调用视频生成 API”。","402":"它还应规定：","403":"输入分镜和角色素材必须已通过验证；","404":"生成请求必须关联稳定的幂等键或远端任务 ID；","405":"超时后优先查询原任务；","406":"生成结果必须检查实际文件和媒体元数据；","407":"失败时只允许在预算和次数限制内重试；","408":"生成成功后将产物写入不可变的资产版本；","409":"下游合成节点只能使用通过验收的产物。","410":"8.2 工作流如何从成功任务中产生？","411":"我建议采用以下晋升流程：","412":"必须注意：一次成功运行只能产生候选工作流，不能自动证明它已经适合复用。可能只是某次输入恰好简单、环境恰好正常，或者用户在执行过程中手动修正了多个关键步骤。","413":"工作流需要通过回放、边界和恢复测试，才能成为稳定资产。","414":"8.3 固化不等于永久固定","415":"即使工作流已经稳定，也不意味着永远不能改变。","416":"建议区分：","417":"稳定工作流","418":"：具有明确契约、通过测试并可重复执行；","419":"实验分支","420":"：尝试替换节点、优化依赖或调整执行策略；","421":"运行时动态决策","422":"：在预先允许的范围内选择分支或能力实现；","423":"正式升级","424":"：通过评测后发布新版本。","425":"例如，漫剧工作流可以保持整体 DAG 稳定，同时允许“视频生成”节点在两个兼容服务之间选择。但切换服务不能破坏输入输出契约，也不能绕过质量、成本和权限检查。","426":"九、工具、能力与工作流怎样独立进化？","427":"这是 EvoAgent 与普通自动化平台的根本区别之一。","428":"普通工作流平台通常依赖开发者人工修复故障；EvoAgent 则希望能够从运行证据中发现问题，提出改进方案，验证改进效果，并在通过门禁后自动发布低风险变更。","429":"但必须强调：","430":"进化系统应当根据根因选择改进对象，而不是遇到失败就自动修改工具或工作流。","431":"9.1 建立统一的候选改进协议","432":"一项改进可以针对不同组件：","433":"工具实现；","434":"工具参数契约；","435":"专业技术能力；","436":"工作流节点或依赖；","437":"专家策略；","438":"提示词；","439":"模型适配器；","440":"诊断器自身。","441":"每个候选都需要记录：","442":"9078d7be-9796-5457-9fac-5048642d4356","443":null,"444":"这是概念协议示例，生产环境还需要记录依赖、构建产物、许可证、安全扫描结果、兼容性要求和回滚方案。","445":"9.2 不同组件需要不同的进化方式","446":"改进对象","447":"典型方式","448":"主要门禁","449":"提示词","450":"候选生成、对照评测","451":"任务质量、成本、跨专家回归","452":"工具参数契约","453":"Schema 修改、契约测试","454":"调用方兼容性、错误处理","455":"工具实现","456":"代码修改、构建、测试","457":"单元测试、安全测试、集成测试","458":"专业能力","459":"替换算法或组合方式","460":"领域专项评测、边界条件","461":"工作流","462":"调整 DAG、节点策略","463":"回放、恢复、幂等和端到端验收","464":"模型适配器","465":"调整请求和响应映射","466":"协议兼容、工具调用和错误映射","467":"诊断器","468":"改进根因分类或证据规则","469":"已知故障集、误归因率","470":"工具实现和原生执行器的代码变更风险通常高于提示词模板调整。因此，不能给它们使用完全相同的自动发布权限。","471":"9.3 共享能力改进如何避免污染所有专家？","472":"假设编程专家发现一个通用工具参数验证器的缺陷。","473":"修复候选可以被提交到共享能力仓库，但需要：","474":"在原始失败案例上验证修复；","475":"在该工具的完整契约测试集上验证；","476":"检查其他调用方是否兼容；","477":"在关键专家的回归集上运行测试；","478":"评估成本、延迟和资源变化；","479":"发布独立的能力版本；","480":"由各专家的兼容性策略决定何时升级。","481":"这比直接修改所有专家提示词安全得多。","482":"同样，某个专家的失败经验不能自动变成全局规则。共享的是经过验证、明确适用范围的能力和改进，不是未经筛选的结论。","483":"十、Android 本地执行与云端工具如何统一？","484":"EvoAgent 采用手机优先战略，因此工具系统必须从一开始就支持本地和云端两种执行环境，而不是先假设所有工具都运行在服务器上。","485":"建议定义统一的能力契约，再通过不同执行器实现。","486":"统一能力注册中心","487":"能力 ID、输入输出契约、权限、版本与验收规则","488":"能力调度器","489":"依据任务需求、网络、隐私、成本和设备资源选择实现","490":"Android 执行器","491":"应用启动、无障碍操作、本地文件、离线能力、媒体合成。","492":"权限由 Android 系统和本地策略共同约束。","493":"云端执行器","494":"大模型 API、云端生成、复杂计算、远端任务与共享评测。","495":"通过服务端身份、授权、预算和审计机制约束。","496":"统一结果协议","497":"执行状态、证据、成本、副作用、错误与恢复建议","498":"10.1 调度不能只考虑谁更快或更便宜","499":"例如，处理私人文件时，即使云端 OCR 更快，也不一定应该把文件上传到云端。","500":"调度器至少应考虑：","501":"当前任务是否允许联网；","502":"数据是否允许离开设备；","503":"本地能力是否足够；","504":"云端能力是否可用；","505":"质量差异是否影响验收；","506":"延迟和费用是否符合预算；","507":"本地设备资源是否充足；","508":"当前任务能否在断网时继续；","509":"选择的实现是否兼容当前工作流版本。","510":"当网络中断时，如果某项任务只能由云端执行，系统应等待、暂停或采用经过批准的替代能力，而不是静默降低质量并宣称任务完成。","511":"10.2 工具升级不能要求所有手机同时升级","512":"能力契约应当尽可能向后兼容。","513":"例如，某个工具从 V2 升级到 V3：","514":"如果输入输出兼容，旧工作流可以继续使用 V2，也可以在验证后升级到 V3；","515":"如果返回状态的语义发生变化，必须增加版本兼容处理；","516":"如果旧任务正在运行，应继续使用其锁定的兼容版本，或者经过明确的迁移流程；","517":"如果新版本修复了安全漏洞，系统应根据风险策略决定是否禁止旧版本继续运行。","518":"Android 设备可能长时间离线，因此需要支持版本清单缓存、兼容性检查、增量下载、签名校验和安全回滚。对于无法安全回滚的数据库迁移或权限变更，则需要采用专门的迁移与恢复方案。","519":"十一、工具与能力系统的质量指标","520":"为了让它真正进入自进化闭环，必须建立独立的质量评价体系。","521":"指标","522":"含义","523":"契约符合率","524":"工具是否遵守输入输出和状态语义","525":"工具执行成功率","526":"满足前置条件的调用中，有多少按契约完成","527":"调用选择准确率","528":"智能体是否选用了适当的能力","529":"参数有效率","530":"调用请求是否满足参数契约","531":"结果核验通过率","532":"返回结果是否获得必要证据支持","533":"故障归因准确率","534":"诊断器是否找到真正的问题来源","535":"重复副作用率","536":"恢复和重试是否造成重复操作","537":"恢复成功率","538":"发生故障后是否能够安全继续","539":"端到端任务成功率","540":"能力在真实任务中是否达成用户目标","541":"单次成功任务成本","542":"完成一个验收通过的任务实际消耗多少资源","543":"其中，工具成功率不能代替端到端任务成功率。","544":"例如，工具调用成功率很高，但如果专家经常选错工具，整个智能体仍然表现不佳。反过来，某个专业能力即使需要更多步骤，只要能够显著提高关键任务的正确率并满足成本约束，也可能更值得采用。","545":"11.1 建立能力等级，但不要只用一个总分","546":"建议将能力的质量状态分成：","547":"EXPERIMENTAL","548":"：实验性，尚未证明稳定；","549":"VALIDATED","550":"：通过契约和专项测试；","551":"STABLE","552":"：通过目标场景的质量、稳定性与恢复门禁；","553":"DEPRECATED","554":"：不再建议新任务使用；","555":"QUARANTINED","556":"：出现重大异常，暂时禁止正常调度；","557":"RETIRED","558":"：停止使用，但保留必要的历史引用。","559":"一个能力可以在 Python 代码分析方面是 ","560":"STABLE","561":"，但在某种特殊语法或旧运行环境中仍不适用。因此，状态还应关联适用范围、版本和环境条件，不能把单一的全局质量标签理解为无条件可靠。","562":"十二、这一轮建议冻结的架构决策","563":"经过这轮设计，EvoAgent 的工具与能力系统可以形成以下架构基线。","564":"这些是建议纳入全量架构的设计决策，还需要在详细接口设计和实现阶段完成评审与验证。","565":"十三、接下来还需要设计哪些关键系统？","566":"到这里，我们已经把以下内容连接起来：","567":"用户习惯与个性化；","568":"长期记忆和工作记忆；","569":"上下文组装、压缩与恢复；","570":"提示词和指令治理；","571":"工具、专业技术能力与工作流；","572":"运行日志、故障诊断、自动评测和进化。","573":"但还有一个不能遗漏的关键问题：","574":"如何保证路由器、Planner、ReAct、工具、验收器和诊断器协同工作，而不是各自优化却让整体系统退化？","575":"我建议下一轮深入设计 EvoAgent 的","576":"路由、规划、执行与验收协同控制系统","577":"。","578":"重点包括：","579":"用户意图如何映射到通用能力和领域专家；","580":"如何判断应该使用单个专家、多个专家还是固定工作流；","581":"路由错误与专家执行错误如何区分；","582":"Planner 如何决定采用固定 DAG、动态 DAG 或短程 ReAct；","583":"执行过程中何时继续、重试、暂停或重规划；","584":"验收器如何独立判断结果是否真正完成；","585":"多专家协作时如何传递任务状态、记忆和证据；","586":"当多个组件都提出改进时，如何判断先优化哪个问题；","587":"如何防止局部优化损害整体成功率、稳定性和成本；","588":"如何通过统一的运行轨迹、对照评测和发布门禁实现系统级进化。","589":"这将把前面各个子系统进一步连接成一个真正完整的运行架构。"},"fallbackMarkdown":"# EvoAgent 第六专项：工具、专业能力与工作流治理系统全量设计\n\n这一轮，我们解决 EvoAgent 自进化架构中另一个容易被低估的问题：**智能体能否正确判断自己需要什么能力、正确调用它、确认它是否可靠，并在能力本身出现问题时找到真正的根因。**\n\n前面已经设计了提示词治理、上下文工程、记忆、任务状态、ReAct 和多专家架构。现在需要把这些模块与真正执行工作的工具连接起来。\n\n例如，编程专家修改代码失败，可能有很多原因：\n\n- 模型没有正确理解需求；\n- Planner 把任务拆错了；\n- 上下文漏掉了兼容性约束；\n- 模型调用工具时参数错误；\n- 工具接口定义与真实实现不一致；\n- AST 分析器有缺陷；\n- 编译环境缺少依赖；\n- 测试本身不可靠；\n- 验收器错误地判定成功。\n\n如果 EvoAgent 只记录“任务失败”，然后让服务端修改提示词，它就可能不断优化错误的对象。\n\n因此，这一专项的核心目标是建立一套**能力可描述、调用可约束、结果可验证、故障可归因、版本可追溯、升级可回滚**的工具与能力基础设施。\n\n# 一、首先统一六个概念\n\n这些概念必须分清，否则后续数据库、接口和进化系统都会混乱。\n\n## 1\\. 工具 Tool\n\n一个可以被调用的具体执行接口。\n\n例如：读取文件、启动 Android 应用、运行测试、生成图像、查询云端任务状态。\n\n## 2\\. 专业技术能力 Skill\n\n完成某类问题所需的算法、知识、工具组合和验证方法。\n\n例如：Python AST 重构、角色一致性检查、Android 界面状态识别。\n\n## 3\\. 领域专家 Expert\n\n理解某个领域目标，选择策略、专业能力和工具，并对领域结果负责。\n\n例如：编程专家、AI 漫剧专家、手机操作专家。\n\n## 4\\. 工作流 Workflow\n\n把经过验证的多个步骤编排成可重复、可恢复的执行过程。\n\n例如：剧本 → 角色 → 分镜 → 视频 → 配音 → 合成 → 验收。\n\n## 5\\. 模型适配器 Model Adapter\n\n把统一的模型调用协议转换成具体供应商或模型支持的请求格式。\n\n例如：工具调用格式、结构化输出、模型能力差异和错误码映射。\n\n## 6\\. 运行环境 Runtime\n\n实际执行工具和工作流的设备、进程、依赖、权限与资源环境。\n\n例如：Android 本地执行环境、云端容器、Python 沙箱、FFmpeg 运行环境。\n\n它们之间的关系可以概括为：\n\n- 专家决定当前任务需要什么专业能力。\n- 专业能力决定应该采用哪些算法、工具和验证步骤。\n- 工作流将多个能力按依赖关系组织起来。\n- 工具执行具体操作。\n- 运行环境提供真实的执行条件。\n- 模型适配器负责模型交互，不负责替工具证明其结果正确。\n\n**工具是能力的执行入口，但工具本身不等于完整能力。**\n\n例如，能够调用 Python 解释器，不代表具备可靠的代码修改能力。真正的代码修改能力还需要理解项目结构、分析语法树、规划修改、运行测试、检查差异并验证结果。\n\n# 二、建立统一能力注册中心\n\nEvoAgent 需要一个统一的 Capability Registry（能力注册中心），让路由器、Planner、专家和工作流引擎知道当前有哪些能力可以使用，以及它们适用于什么条件。\n\n但它不能只是一个工具名称列表。\n\n一个能力注册项至少应该回答十个问题：\n\n1. 它能解决什么问题？\n2. 哪些任务适合使用它？\n3. 哪些情况不适合使用它？\n4. 需要什么输入和前置条件？\n5. 输出什么结果？\n6. 会产生什么副作用？\n7. 需要哪些权限？\n8. 运行成本和资源需求是什么？\n9. 如何验证结果正确？\n10. 当前哪个版本经过了哪些测试？\n\n## 2.1 能力注册项的数据结构\n\n```json\n\n{\n  \"capability_id\": \"python.ast_refactor\",\n  \"capability_type\": \"technical_skill\",\n  \"name\": \"Python AST Refactoring\",\n  \"version\": \"2.1.0\",\n  \"description\": \"通过语法树分析和受控修改完成 Python 代码重构\",\n  \"applicable_domains\": [\n    \"coding\"\n  ],\n  \"preconditions\": [\n    \"source_files_available\",\n    \"python_parser_compatible\"\n  ],\n  \"input_schema_ref\": \"schema:ast-refactor-input-v1\",\n  \"output_schema_ref\": \"schema:ast-refactor-output-v1\",\n  \"tool_dependencies\": [\n    \"python.ast_parse\",\n    \"filesystem.read\",\n    \"filesystem.apply_patch\",\n    \"python.test_runner\"\n  ],\n  \"permission_requirements\": [\n    \"workspace_read\",\n    \"workspace_write\"\n  ],\n  \"side_effect_class\": \"workspace_mutation\",\n  \"verification_profile\": \"python-refactor-verification-v2\",\n  \"resource_profile\": {\n    \"gpu_required\": false,\n    \"network_required\": false,\n    \"cost_class\": \"low\"\n  },\n  \"lifecycle_status\": \"ACTIVE\"\n}\n```\n\n这是注册协议的示例。正式实现还应记录能力来源、依赖版本、运行环境约束、许可证、超时策略、兼容性范围、故障历史和发布清单。\n\n这里的 `cost_class` 只能用于初步筛选，不能替代实际成本核算。真正调度时，还应考虑当前资源占用、预计执行时间、外部 API 费用和剩余预算。\n\n## 2.2 能力发现与执行权限分开\n\n注册中心回答的是“有哪些能力、哪些可能适用”。\n\n它不应该直接决定“当前任务可以执行哪些动作”。\n\n例如，系统注册了文件删除工具，不意味着编程专家可以随意删除用户文件。实际执行仍需要检查：\n\n- 当前任务是否确实需要删除；\n- 目标文件是否属于授权范围；\n- 当前用户是否授予相应权限；\n- 删除是否可恢复；\n- 是否需要用户确认；\n- 当前运行环境是否允许该操作。\n\n能力发现与权限判定必须是两个独立步骤。\n\n## 2.3 能力可以有多个实现\n\n这对手机优先和云端优先架构都很重要。\n\n同一种逻辑能力可能有多个实现：\n\n| 能力 | 实现 A | 实现 B |\n|--------|--------|--------|\n| 图像识别 | Android 本地视觉模型 | 云端视觉 API |\n| 语音转写 | 本地语音识别 | 云端语音识别 |\n| 代码分析 | 本地 AST 工具 | 云端代码分析服务 |\n| 视频合成 | 手机端 FFmpeg | 云端视频处理服务 |\n| 界面识别 | Android 无障碍节点 | 屏幕视觉识别 |\n\n因此，专家应该依赖稳定的能力契约，而不是把具体供应商、设备或工具实现写死在自己的提示词中。\n\n调度器可以根据准确率、延迟、成本、隐私、网络状态和可用资源选择实现，但不能为了节省成本而违反任务质量或权限要求。\n\n---\n\n# 三、统一工具契约：调用之前，先明确什么叫正确调用\n\n工具最常见的问题之一，是接口看起来能调用，但输入输出的含义不清楚。\n\n例如，一个名为 `open_app` 的工具，究竟表示：\n\n- 已经发出了启动请求；\n- Android 已经接受启动请求；\n- 目标应用已经进入前台；\n- 目标页面已经成功打开；\n- 用户可以开始下一步操作。\n\n这五个结果完全不同。\n\n如果工具只返回 `{\"success\": true}`，ReAct 可能把“启动请求已提交”误判为“任务已经完成”。\n\n所以，我建议每个工具都必须声明输入契约、输出契约、前置条件、后置条件、失败语义和副作用。\n\n## 3.1 工具契约至少包括哪些部分？\n\n| 契约部分 | 需要明确的内容 |\n|--------|--------|\n| 输入契约 | 必填字段、类型、范围、格式和业务约束 |\n| 前置条件 | 权限、登录状态、文件存在、网络可用等 |\n| 执行语义 | 工具实际承诺执行到哪一步 |\n| 输出契约 | 返回值结构、状态含义、证据和错误类型 |\n| 后置条件 | 调用结束后必须成立的可验证条件 |\n| 副作用 | 文件修改、应用启动、费用产生、消息发送等 |\n| 幂等语义 | 相同请求重复执行会怎样 |\n| 超时语义 | 超时代表失败、未知，还是仍在后台执行 |\n| 恢复语义 | 能否查询状态、重试、取消或补偿 |\n| 版本兼容 | 输入输出是否兼容旧调用方 |\n\n特别是“超时语义”和“幂等语义”，它们直接决定任务能否安全恢复。\n\n## 3.2 用 Android 应用启动举例\n\n假设工具的输入是：\n\n```json\n{\n  \"package_name\": \"com.example.app\",\n  \"launch_mode\": \"foreground\"\n}\n```\n\n不能简单地把返回结果定义成：\n\n```json\n{\n  \"success\": true\n}\n```\n\n更合理的是区分：\n\n```json\n{\n  \"request_status\": \"ACCEPTED\",\n  \"observed_state\": \"UNKNOWN\",\n  \"package_name\": \"com.example.app\",\n  \"evidence_refs\": [],\n  \"error\": null\n}\n```\n\n随后由界面状态观察器确认应用是否真正进入前台。\n\n如果应用启动失败，则返回明确的错误类别，例如：\n\n- `APP_NOT_INSTALLED`\n- `LAUNCH_NOT_ALLOWED`\n- `ACTIVITY_NOT_FOUND`\n- `APP_START_TIMEOUT`\n- `FOREGROUND_NOT_CONFIRMED`\n\n这里的重点不是错误码一定采用这些名字，而是必须让不同故障拥有不同的语义，避免 ReAct 只能根据自然语言错误信息猜测发生了什么。\n\n## 3.3 工具输出不能自动等于事实\n\n工具返回值也可能错误。\n\n因此，建议区分三个层次：\n\n1. **工具自报结果**：工具声称自己执行了什么。\n2. **运行证据**：日志、文件、系统状态或远端任务状态。\n3. **独立验证结论**：根据证据和验收规则判断结果是否符合预期。\n\n并非每个工具都需要独立调用第二个工具来验证，但对高风险操作和关键任务结果，应当尽可能获得与执行声明相独立的证据。\n\n例如，文件写入工具返回成功后，可以通过读取文件、校验哈希或检查目标内容验证；云端视频生成返回成功后，可以查询远端任务状态并检查实际产物。\n\n---\n\n# 四、工具调用控制器：所有执行统一经过一个受控入口\n\n我不建议让每个专家直接调用底层工具。否则，不同专家可能各自实现权限检查、重试、日志和错误处理，最终很难保证行为一致。\n\n建议引入统一的 `Tool Execution Gateway`。\n\n**专家 / ReAct / 工作流节点**\n\n提出工具调用请求\n\n**工具执行网关**\n\n参数校验、权限检查、预算预留、幂等控制\n\n**本地执行器**\n\nAndroid / 桌面 / 沙箱\n\n**远端执行器**\n\nAPI / 云端任务 / 服务\n\n**结果核验与执行账本**\n\n记录结果、证据、副作用、费用与错误\n\n**统一执行结果**\n\n返回 ReAct、工作流引擎和任务控制器\n\n这个网关负责确保工具调用遵守统一的执行规则，但不需要把所有工具实现都放在一个进程或一台服务器中。\n\n## 4.1 调用协议需要具备哪些机制？\n\n建议每次调用至少关联：\n\n- `invocation_id`：唯一调用标识；\n- `task_id`、`node_id`：任务与节点关联；\n- `capability_id` 和 `tool_version`：实际使用的能力与工具版本；\n- `idempotency_key`：识别同一逻辑操作的重复请求；\n- `authorization_context`：授权检查的受控引用；\n- `budget_reservation_id`：预算预留记录；\n- `trace_id`：贯穿模型、工具和任务日志的关联 ID；\n- `input_ref`、`output_ref`：必要的输入输出引用；\n- `side_effect_state`：副作用状态；\n- `evidence_refs`：支持执行结论的证据。\n\n这样，工具故障可以关联到具体任务、模型调用、专家版本和上下文快照，而不是只留下一个孤立的错误日志。\n\n## 4.2 重试机制不能一刀切\n\n我建议至少将重试分为四类：\n\n| 类别 | 示例 | 默认处理 |\n|--------|--------|--------|\n| 安全重试 | 读取文件时发生暂时性网络错误 | 在预算和次数限制内重试 |\n| 核查后重试 | 云端任务请求超时 | 先查询原请求状态 |\n| 修正后重试 | 参数格式错误 | 修正参数并重新校验 |\n| 禁止自动重试 | 已发送消息、已支付、权限被拒绝 | 停止或进入受控恢复流程 |\n\n实际规则必须由工具契约和风险策略共同决定。\n\n即使一个工具声明为幂等，也需要确认幂等键的作用范围、保存期限以及供应商是否真正支持该语义，不能仅凭配置中的一个布尔值就认为重复执行绝对安全。\n\n# 五、专业技术能力：为什么不能只依赖通用大模型？\n\n你之前特别提到，编程可能需要 AST 语法树和专门的优化技术，其他场景也会有类似需求。\n\n这正是能力系统需要解决的问题。\n\n通用大模型负责理解、推理和策略选择，但在很多场景中，可靠性来自专业算法、确定性工具和领域验证，而不只是更好的提示词。\n\n我建议把专业能力拆成三类。\n\n## 5.1 第一类：确定性技术能力\n\n适合有明确输入、明确规则、可验证输出的问题。\n\nimage_group{\"query\":[\"abstract syntax tree programming language code visualization\"],\"aspect_ratio\":\"4:3\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**编程：AST 与静态分析**\n\n解析语法树、符号引用、类型检查、代码差异分析、编译和测试。模型负责提出修改方案，确定性工具负责检查结构与行为。\n\n---\n\nimage_group{\"query\":[\"FFmpeg video editing timeline waveform audio tracks\"],\"aspect_ratio\":\"4:3\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**AI 漫剧：媒体处理**\n\nFFmpeg 合成、时长检查、分辨率检查、音画同步、帧率与音频格式校验。\n\n---\n\nimage_group{\"query\":[\"Android accessibility UI hierarchy tree mobile app interface inspection\"],\"aspect_ratio\":\"4:3\",\"layout\":\"carousel\",\"num_per_query\":1}\n\n**手机操作：界面状态验证**\n\n无障碍节点读取、应用包名核验、页面状态检测、操作前后状态比对。\n\n这类能力的优势是结果通常更容易验证。但确定性工具也可能存在实现缺陷、环境依赖问题和版本兼容问题，因此仍然需要测试与运行时校验。\n\n## 5.2 第二类：模型辅助的专业能力\n\n例如：\n\n- 复杂代码架构理解；\n- 视频分镜设计；\n- 角色外观一致性判断；\n- 复杂网页结构理解；\n- 语音对话意图识别。\n\n这类能力需要模型进行语义判断，但应当尽可能用确定性工具、领域规则或独立评测约束结果。\n\n例如，角色一致性不能只靠模型说“角色看起来一致”。可以结合角色参考图、视觉相似度、关键特征检查和人工抽样验收。\n\n## 5.3 第三类：复合型能力\n\n很多真正有价值的能力都属于这一类。\n\n例如，可靠的代码重构能力可能由以下部分组成：\n\n1. 模型理解修改目标；\n2. AST 工具分析代码结构；\n3. Planner 生成修改计划；\n4. 受控补丁工具实施修改；\n5. 编译器检查语法和类型；\n6. 测试运行器验证行为；\n7. 验收器检查目标和回归结果。\n\n这才是一项完整的专业能力，而不是一个单独的工具或提示词。\n\n## 5.4 AST 代码重构的完整执行示例\n\n这里不应该强制每一次代码修改都使用 AST。例如，修改一个简单的文档字符串，可能不需要复杂的语法树重构流程。\n\n专业能力应该根据任务风险、代码结构、修改范围和验收要求决定使用哪些技术，而不是为了体现专业性而增加不必要的步骤。\n\n---\n\n# 六、工具故障归因：智能体怎样知道究竟是谁出了问题？\n\n这是本专项最核心的设计。\n\n我们不能只使用一个 `failure_reason` 字段，让模型自行填写“工具失败”或“提示词不够好”。\n\n建议建立独立的故障诊断器（Failure Diagnosis Engine），并明确区分**观察事实、根因假设、验证实验和最终结论**。\n\n## 6.1 故障分类树\n\n**任务或节点未达到预期结果**\n\n**理解与决策**\n\n意图识别、规划、推理、上下文、提示词\n\n**执行与环境**\n\n工具、参数、依赖、网络、权限、资源\n\n**结果与验收**\n\n目标不清、验收标准错误、证据不足、验证器缺陷\n\n**系统与协同**\n\n状态不一致、重复执行、版本不兼容、同步失败、预算耗尽\n\n一个故障可能有多个原因。例如，模型生成了错误参数，而工具又没有正确校验参数，这可能同时包含调用策略缺陷和工具契约缺陷。\n\n因此，诊断器不应强行选择唯一根因，而应支持：\n\n- 主要根因；\n- 次要促成因素；\n- 尚未排除的假设；\n- 已经排除的假设；\n- 支持与反对每个假设的证据；\n- 根因结论的验证状态。\n\n## 6.2 一个具体案例\n\n假设编程专家尝试修改代码，但最终测试失败。\n\n诊断器不应该直接增加一句“修改代码后一定要仔细检查”。\n\n而应该按证据逐步判断：\n\n| 检查点 | 观察结果 | 可能结论 |\n|--------|--------|--------|\n| 用户目标解析 | 兼容性约束已正确提取 | 初步排除目标遗漏 |\n| 上下文快照 | 兼容性约束实际进入模型请求 | 初步排除上下文遗漏 |\n| 工具参数校验 | 参数符合工具 Schema | 排除明显的参数格式错误 |\n| AST 分析结果 | 目标符号引用关系解析错误 | 怀疑专业能力缺陷 |\n| 测试环境 | 依赖版本与基线一致 | 降低环境不一致的可能性 |\n| 修复工具问题后重测 | 相同案例恢复通过 | 支持工具缺陷假设 |\n\n这里的关键是“初步排除”和“支持假设”，而不是仅凭一条日志就断言根因已经确定。\n\n## 6.3 根因诊断必须有自己的评测集\n\n诊断器本身也可能判断错误。\n\n因此，应该建立包含已知故障的诊断测试集，例如：\n\n- 工具返回错误但实际操作成功；\n- 工具没有执行成功却返回成功；\n- 模型参数错误；\n- 上下文遗漏约束；\n- 测试环境异常；\n- 工作流依赖关系错误；\n- 日志缺失或时间顺序不完整。\n\n对于这些测试案例，系统应检查诊断准确率、误归因率、证据覆盖率和错误修复成本。\n\n特别要关注**错误归因导致的二次损害**：如果工具存在缺陷，系统却不断修改提示词，最终可能让提示词越来越复杂、成本越来越高，工具缺陷仍然存在。\n\n---\n\n# 七、工具可靠性工程：如何证明一个工具可以被使用？\n\n工具注册完成，不等于工具已经可靠。\n\n我建议每个工具根据风险等级建立独立的质量契约，至少包含五类测试。\n\n## 7.1 五层测试体系\n\n| 测试层 | 验证内容 | 示例 |\n|--------|--------|--------|\n| 契约测试 | 输入输出与 Schema 是否一致 | 缺少必填参数时是否明确拒绝 |\n| 单元测试 | 工具内部逻辑是否正确 | AST 节点转换是否保持语义 |\n| 集成测试 | 工具与环境、依赖和服务是否兼容 | FFmpeg 是否能读取目标编码格式 |\n| 故障注入 | 异常条件下能否安全处理 | 网络超时、磁盘满、进程中断 |\n| 端到端测试 | 工具在真实任务链路中是否达成目标 | 修改代码后测试通过且无意外差异 |\n\n高风险工具还需要额外的权限测试、并发测试、重复调用测试和安全边界测试。\n\n## 7.2 工具必须有独立的验收契约\n\n例如，文件修改工具的契约不能只是“成功写入文件”。\n\n它可以规定：\n\n- 目标路径必须位于授权工作区；\n- 修改前必须保存原始版本或具备恢复方式；\n- 返回值必须包含实际修改文件清单；\n- 必须能核对修改前后的差异；\n- 未经授权不得修改其他文件；\n- 发生部分写入时必须返回明确状态；\n- 发生不确定结果时必须支持核查。\n\n这样，工具质量不再依赖模型是否在提示词里记住了所有注意事项。\n\n## 7.3 工具故障要区分两个指标\n\n这是一个重要的评测设计。\n\n**工具自身可靠性**衡量：在合法输入、满足前置条件的情况下，工具是否按契约工作。\n\n**工具使用可靠性**衡量：整个智能体是否能够选择合适的工具、生成正确参数、理解返回结果，并在必要时完成恢复。\n\n两者不能混为一个成功率。\n\n例如，某个工具在合法输入下成功率达到 99.9%，但模型经常给它传入错误参数，那么整体任务成功率仍然可能很低。此时主要问题可能在调用策略或参数生成，而不是工具内部实现。\n\n反过来，模型参数完全正确，但工具经常超时或返回错误，问题就应该优先交给工具可靠性工程处理。\n\n---\n\n# 八、工作流治理：从一次跑通到可重复执行的能力\n\n你之前特别关心：一个复杂任务跑通之后，怎样把它固化成稳定的工作流，以后还可以持续迭代。\n\n这次我们把它与能力系统正式连接起来。\n\n建议工作流不是一段由模型生成后直接执行的任意代码，而是一个具有版本、节点契约、依赖、恢复策略和验收条件的正式资产。\n\n## 8.1 工作流节点必须定义什么？\n\n每个节点至少需要：\n\n- 输入输出契约；\n- 前置条件；\n- 使用的能力与工具版本；\n- 成功与失败判定；\n- 超时与重试策略；\n- 副作用与幂等语义；\n- 验收要求；\n- 检查点与恢复策略；\n- 预算限制；\n- 允许的重规划范围。\n\n例如，AI 漫剧工作流中的“生成视频”节点，不应只规定“调用视频生成 API”。\n\n它还应规定：\n\n1. 输入分镜和角色素材必须已通过验证；\n2. 生成请求必须关联稳定的幂等键或远端任务 ID；\n3. 超时后优先查询原任务；\n4. 生成结果必须检查实际文件和媒体元数据；\n5. 失败时只允许在预算和次数限制内重试；\n6. 生成成功后将产物写入不可变的资产版本；\n7. 下游合成节点只能使用通过验收的产物。\n\n## 8.2 工作流如何从成功任务中产生？\n\n我建议采用以下晋升流程：\n\n必须注意：一次成功运行只能产生候选工作流，不能自动证明它已经适合复用。可能只是某次输入恰好简单、环境恰好正常，或者用户在执行过程中手动修正了多个关键步骤。\n\n工作流需要通过回放、边界和恢复测试，才能成为稳定资产。\n\n## 8.3 固化不等于永久固定\n\n即使工作流已经稳定，也不意味着永远不能改变。\n\n建议区分：\n\n- **稳定工作流**：具有明确契约、通过测试并可重复执行；\n- **实验分支**：尝试替换节点、优化依赖或调整执行策略；\n- **运行时动态决策**：在预先允许的范围内选择分支或能力实现；\n- **正式升级**：通过评测后发布新版本。\n\n例如，漫剧工作流可以保持整体 DAG 稳定，同时允许“视频生成”节点在两个兼容服务之间选择。但切换服务不能破坏输入输出契约，也不能绕过质量、成本和权限检查。\n\n---\n\n# 九、工具、能力与工作流怎样独立进化？\n\n这是 EvoAgent 与普通自动化平台的根本区别之一。\n\n普通工作流平台通常依赖开发者人工修复故障；EvoAgent 则希望能够从运行证据中发现问题，提出改进方案，验证改进效果，并在通过门禁后自动发布低风险变更。\n\n但必须强调：**进化系统应当根据根因选择改进对象，而不是遇到失败就自动修改工具或工作流。**\n\n## 9.1 建立统一的候选改进协议\n\n一项改进可以针对不同组件：\n\n- 工具实现；\n- 工具参数契约；\n- 专业技术能力；\n- 工作流节点或依赖；\n- 专家策略；\n- 提示词；\n- 模型适配器；\n- 诊断器自身。\n\n每个候选都需要记录：\n\n```json\n\n{\n  \"candidate_id\": \"candidate-042\",\n  \"target_type\": \"tool\",\n  \"target_id\": \"python.ast_refactor\",\n  \"base_version\": \"2.1.0\",\n  \"problem_refs\": [\n    \"incident-104\",\n    \"incident-119\"\n  ],\n  \"root_cause_status\": \"SUPPORTED\",\n  \"hypothesis\": \"特定语法结构的符号引用解析不完整\",\n  \"proposed_change_ref\": \"change-set-042\",\n  \"evaluation_plan_ref\": \"eval-plan-042\",\n  \"regression_suite_ref\": \"coding-regression-v7\",\n  \"budget_limit_ref\": \"experiment-budget-042\",\n  \"risk_class\": \"CONTROLLED\",\n  \"status\": \"PROPOSED\"\n}\n```\n\n这是概念协议示例，生产环境还需要记录依赖、构建产物、许可证、安全扫描结果、兼容性要求和回滚方案。\n\n## 9.2 不同组件需要不同的进化方式\n\n| 改进对象 | 典型方式 | 主要门禁 |\n|--------|--------|--------|\n| 提示词 | 候选生成、对照评测 | 任务质量、成本、跨专家回归 |\n| 工具参数契约 | Schema 修改、契约测试 | 调用方兼容性、错误处理 |\n| 工具实现 | 代码修改、构建、测试 | 单元测试、安全测试、集成测试 |\n| 专业能力 | 替换算法或组合方式 | 领域专项评测、边界条件 |\n| 工作流 | 调整 DAG、节点策略 | 回放、恢复、幂等和端到端验收 |\n| 模型适配器 | 调整请求和响应映射 | 协议兼容、工具调用和错误映射 |\n| 诊断器 | 改进根因分类或证据规则 | 已知故障集、误归因率 |\n\n工具实现和原生执行器的代码变更风险通常高于提示词模板调整。因此，不能给它们使用完全相同的自动发布权限。\n\n## 9.3 共享能力改进如何避免污染所有专家？\n\n假设编程专家发现一个通用工具参数验证器的缺陷。\n\n修复候选可以被提交到共享能力仓库，但需要：\n\n1. 在原始失败案例上验证修复；\n2. 在该工具的完整契约测试集上验证；\n3. 检查其他调用方是否兼容；\n4. 在关键专家的回归集上运行测试；\n5. 评估成本、延迟和资源变化；\n6. 发布独立的能力版本；\n7. 由各专家的兼容性策略决定何时升级。\n\n这比直接修改所有专家提示词安全得多。\n\n同样，某个专家的失败经验不能自动变成全局规则。共享的是经过验证、明确适用范围的能力和改进，不是未经筛选的结论。\n\n---\n\n# 十、Android 本地执行与云端工具如何统一？\n\nEvoAgent 采用手机优先战略，因此工具系统必须从一开始就支持本地和云端两种执行环境，而不是先假设所有工具都运行在服务器上。\n\n建议定义统一的能力契约，再通过不同执行器实现。\n\n**统一能力注册中心**\n\n能力 ID、输入输出契约、权限、版本与验收规则\n\n**能力调度器**\n\n依据任务需求、网络、隐私、成本和设备资源选择实现\n\n**Android 执行器**\n\n应用启动、无障碍操作、本地文件、离线能力、媒体合成。\n\n---\n\n权限由 Android 系统和本地策略共同约束。\n\n**云端执行器**\n\n大模型 API、云端生成、复杂计算、远端任务与共享评测。\n\n---\n\n通过服务端身份、授权、预算和审计机制约束。\n\n**统一结果协议**\n\n执行状态、证据、成本、副作用、错误与恢复建议\n\n## 10.1 调度不能只考虑谁更快或更便宜\n\n例如，处理私人文件时，即使云端 OCR 更快，也不一定应该把文件上传到云端。\n\n调度器至少应考虑：\n\n- 当前任务是否允许联网；\n- 数据是否允许离开设备；\n- 本地能力是否足够；\n- 云端能力是否可用；\n- 质量差异是否影响验收；\n- 延迟和费用是否符合预算；\n- 本地设备资源是否充足；\n- 当前任务能否在断网时继续；\n- 选择的实现是否兼容当前工作流版本。\n\n当网络中断时，如果某项任务只能由云端执行，系统应等待、暂停或采用经过批准的替代能力，而不是静默降低质量并宣称任务完成。\n\n## 10.2 工具升级不能要求所有手机同时升级\n\n能力契约应当尽可能向后兼容。\n\n例如，某个工具从 V2 升级到 V3：\n\n- 如果输入输出兼容，旧工作流可以继续使用 V2，也可以在验证后升级到 V3；\n- 如果返回状态的语义发生变化，必须增加版本兼容处理；\n- 如果旧任务正在运行，应继续使用其锁定的兼容版本，或者经过明确的迁移流程；\n- 如果新版本修复了安全漏洞，系统应根据风险策略决定是否禁止旧版本继续运行。\n\nAndroid 设备可能长时间离线，因此需要支持版本清单缓存、兼容性检查、增量下载、签名校验和安全回滚。对于无法安全回滚的数据库迁移或权限变更，则需要采用专门的迁移与恢复方案。\n\n---\n\n# 十一、工具与能力系统的质量指标\n\n为了让它真正进入自进化闭环，必须建立独立的质量评价体系。\n\n| 指标 | 含义 |\n|--------|--------|\n| 契约符合率 | 工具是否遵守输入输出和状态语义 |\n| 工具执行成功率 | 满足前置条件的调用中，有多少按契约完成 |\n| 调用选择准确率 | 智能体是否选用了适当的能力 |\n| 参数有效率 | 调用请求是否满足参数契约 |\n| 结果核验通过率 | 返回结果是否获得必要证据支持 |\n| 故障归因准确率 | 诊断器是否找到真正的问题来源 |\n| 重复副作用率 | 恢复和重试是否造成重复操作 |\n| 恢复成功率 | 发生故障后是否能够安全继续 |\n| 端到端任务成功率 | 能力在真实任务中是否达成用户目标 |\n| 单次成功任务成本 | 完成一个验收通过的任务实际消耗多少资源 |\n\n其中，工具成功率不能代替端到端任务成功率。\n\n例如，工具调用成功率很高，但如果专家经常选错工具，整个智能体仍然表现不佳。反过来，某个专业能力即使需要更多步骤，只要能够显著提高关键任务的正确率并满足成本约束，也可能更值得采用。\n\n## 11.1 建立能力等级，但不要只用一个总分\n\n建议将能力的质量状态分成：\n\n- `EXPERIMENTAL`：实验性，尚未证明稳定；\n- `VALIDATED`：通过契约和专项测试；\n- `STABLE`：通过目标场景的质量、稳定性与恢复门禁；\n- `DEPRECATED`：不再建议新任务使用；\n- `QUARANTINED`：出现重大异常，暂时禁止正常调度；\n- `RETIRED`：停止使用，但保留必要的历史引用。\n\n一个能力可以在 Python 代码分析方面是 `STABLE`，但在某种特殊语法或旧运行环境中仍不适用。因此，状态还应关联适用范围、版本和环境条件，不能把单一的全局质量标签理解为无条件可靠。\n\n---\n\n# 十二、这一轮建议冻结的架构决策\n\n经过这轮设计，EvoAgent 的工具与能力系统可以形成以下架构基线。\n\n这些是建议纳入全量架构的设计决策，还需要在详细接口设计和实现阶段完成评审与验证。\n\n# 十三、接下来还需要设计哪些关键系统？\n\n到这里，我们已经把以下内容连接起来：\n\n- 用户习惯与个性化；\n- 长期记忆和工作记忆；\n- 上下文组装、压缩与恢复；\n- 提示词和指令治理；\n- 工具、专业技术能力与工作流；\n- 运行日志、故障诊断、自动评测和进化。\n\n但还有一个不能遗漏的关键问题：**如何保证路由器、Planner、ReAct、工具、验收器和诊断器协同工作，而不是各自优化却让整体系统退化？**\n\n我建议下一轮深入设计 EvoAgent 的**路由、规划、执行与验收协同控制系统**。\n\n重点包括：\n\n1. 用户意图如何映射到通用能力和领域专家；\n2. 如何判断应该使用单个专家、多个专家还是固定工作流；\n3. 路由错误与专家执行错误如何区分；\n4. Planner 如何决定采用固定 DAG、动态 DAG 或短程 ReAct；\n5. 执行过程中何时继续、重试、暂停或重规划；\n6. 验收器如何独立判断结果是否真正完成；\n7. 多专家协作时如何传递任务状态、记忆和证据；\n8. 当多个组件都提出改进时，如何判断先优化哪个问题；\n9. 如何防止局部优化损害整体成功率、稳定性和成本；\n10. 如何通过统一的运行轨迹、对照评测和发布门禁实现系统级进化。\n\n这将把前面各个子系统进一步连接成一个真正完整的运行架构。","fallbackMarkdownVersion":1,"requiredComponents":["AsyncImage"],"clientDefinedWidgets":{"55cbf61c-766f-58d7-b269-1aee00347e28":{"status":"resolved","refIndex":0,"isStreaming":false},"177e941f-ddda-5634-b353-07fa1183b0b8":{"status":"resolved","refIndex":1,"isStreaming":false},"