,__dilConstants[\"431\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"432\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"433\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"434\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"435\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"436\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"437\"]))),__dil.jsx(\"text\",null,__dilConstants[\"438\"]),__dil.jsx(\"text\",null,__dilConstants[\"439\"],__dil.jsx(\"bold\",null,__dilConstants[\"440\"]),__dilConstants[\"441\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第二十专项：模型适配、多模型协同与智能成本治理","1":"前面我们已经设计了专家系统、路由、Planner、ReAct、动态 DAG、记忆、上下文、工具契约、验收、恢复与进化治理。","2":"现在要回答一个更深层的问题：","3":"EvoAgent 的智能究竟来自模型本身，还是来自模型与提示词、上下文、工具、工作流、记忆和反馈机制的组合？如果某个模型变强了，系统应该如何利用它；如果模型变弱、不可用或成本过高，又该如何保持稳定？","4":"我的核心判断是：","5":"EvoAgent 不应该围绕某一个模型构建，而应该围绕可验证的任务能力构建。模型只是能力实现的一种可替换资源。","6":"这意味着，不能把“使用了更强的模型”直接等同于“智能体能力提升”，也不能把某个模型的特定提示词技巧当作所有专家都适用的通用能力。","7":"本专项建议定义为：","8":"Model Adaptation & Multi-Model Orchestration Engine，简称 MAMO。","9":"它负责模型能力评估、模型选择、调用升级、模型切换、适配策略管理和成本质量优化。","10":"一、第一性原理：真正需要路由的是任务所需能力，而不只是模型","11":"假设 EvoAgent 接到一个编程任务。","12":"其中可能包含：","13":"判断用户意图；","14":"理解项目结构；","15":"分析 AST；","16":"制定修改计划；","17":"生成补丁；","18":"调用工具；","19":"分析测试失败；","20":"验证修改是否正确。","21":"这些子任务对模型的要求完全不同。","22":"意图分类可能只需要一个快速、低成本的模型；复杂故障分析可能需要更强的推理能力；AST 解析应该由确定性工具完成，而不是让大模型凭文本猜测语法结构；测试是否通过则应该以实际执行结果为依据。","23":"因此，MAMO 不应该只回答：","24":"“当前应该用哪个模型？”","25":"它应该回答：","26":"“当前任务的哪一部分需要什么能力？有哪些实现方式？哪种组合在质量、成本、延迟和风险之间最合适？”","27":"二、模型不是唯一的能力来源","28":"这些因素存在交互关系，但不能混为一谈。","29":"例如，一次代码任务成功，可能是模型推理更强，也可能是工具补全了模型的不足，或者是上下文准确地提供了关键文件。","30":"如果系统不区分这些因素，就无法知道下一步究竟应该优化模型、提示词、上下文、工具还是工作流。","31":"因此，","32":"MAMO 必须与 OCAE 诊断系统协作，区分任务失败的原因，而不是把所有失败都归咎于模型。","33":"三、建立模型能力画像，而不是给每个模型一个总排名","34":"我建议建立 ","35":"Model Capability Profile","36":"（模型能力画像）。","37":"每个模型都应该按照具体任务类型、工具环境、上下文规模和适配版本进行评估，而不是只记录一个笼统的“智能分数”。","38":"3.1 模型能力画像包含什么？","39":"维度","40":"评估内容","41":"任务理解","42":"是否正确识别目标、约束和隐含条件","43":"推理与规划","44":"是否能形成有效计划，识别依赖和失败风险","45":"代码能力","46":"代码生成、调试、重构、结构化修改的实际表现","47":"工具调用","48":"参数正确率、协议遵循率、工具使用策略","49":"长上下文","50":"关键信息保留、跨段关联和约束遵循","51":"结构化输出","52":"Schema 遵循率、格式错误率","53":"多模态能力","54":"对图像、视频、音频等输入的实际处理效果","55":"纠错能力","56":"能否根据真实反馈定位问题并修正","57":"成本与延迟","58":"实际调用费用、响应时间和重试开销","59":"稳定性","60":"多次执行的结果波动、超时率和失败率","61":"但这张表仍然不够，因为同一个模型在不同场景中的表现可能有明显差异。","62":"例如，模型 A 可能在短代码补全中表现很好，却在大型代码库重构时经常遗漏跨文件依赖。","63":"所以，画像还必须绑定具体的评测条件。","64":"3.2 画像必须带有适用范围","65":"建议至少绑定：","66":"model_id","67":"：模型标识；","68":"model_version","69":"：实际模型版本或可识别的部署快照；","70":"provider","71":"：模型提供方；","72":"task_type","73":"：任务类别；","74":"expert_id","75":"：所属专家；","76":"tool_environment","77":"：工具与运行环境；","78":"context_profile","79":"：上下文长度和组装策略；","80":"prompt_version","81":"：使用的提示词版本；","82":"adapter_version","83":"：模型适配配置版本；","84":"evaluation_dataset_version","85":"：评测集版本；","86":"evaluation_timestamp","87":"：评测时间；","88":"capability_metrics","89":"：各项能力指标；","90":"known_limitations","91":"：已知局限。","92":"这样，模型画像就不是一个永久有效的标签，而是有条件、有证据、有版本的评测结论。","93":"例如，“模型 A 在编程任务中表现良好”不是一个足够精确的结论。","94":"更有价值的结论是：","95":"“模型 A 在指定版本的 Python 多文件修改评测集上，使用某版上下文策略和测试工具时，达到既定质量门槛，平均成本低于候选模型 B，但在大型重构任务中需要更强的回归验证。”","96":"这才足以支持实际路由。","97":"3.3 模型评测不能只用模型自己打分","98":"建议以真实任务结果为主，结合自动化指标和必要的人工评测。","99":"例如：","100":"代码任务以补丁正确性、测试结果和变更范围为证据；","101":"结构化输出以 Schema 校验结果为证据；","102":"规划任务以依赖完整性、执行成功率和实际成本为证据；","103":"工具调用以实际状态变化和后置条件为证据；","104":"长上下文任务以关键约束保留和最终任务完成情况为证据。","105":"模型可以解释自己为什么认为某个答案正确，但这种解释不能替代外部验证。","106":"四、模型路由必须发生在多个层级","107":"EvoAgent 不能只在用户发来消息时选择一次模型。","108":"因为一个复杂任务可能包含多个不同性质的子任务，执行过程中也可能出现需要升级模型的情况。","109":"我建议设计四级模型路由。","110":"R1 · 任务级模型路由","111":"根据整体任务类型、复杂度、风险、预算和专家能力，选择默认执行策略。","112":"例如：复杂编程任务选择编程专家，并为复杂诊断预留高能力模型预算。","113":"R2 · 阶段级模型路由","114":"针对规划、执行、诊断、验收等阶段选择合适模型或确定性工具。","115":"例如：规划阶段使用较强推理能力，代码解析阶段优先使用 AST 工具。","116":"R3 · 节点级模型路由","117":"为 DAG 中的具体节点选择模型、提示词版本和工具组合。","118":"例如：简单文件摘要使用低成本模型，复杂跨文件依赖分析使用更强模型。","119":"R4 · 运行时升级路由","120":"在观察到明确的困难、失败或质量风险时，决定是否重试、切换模型或升级推理能力。","121":"例如：低成本模型连续无法定位测试失败时，转入更强的诊断路径。","122":"这四级路由不必每次都调用一个专门的路由模型。","123":"大多数简单判断可以由规则和统计模型完成；只有任务复杂度难以判断、候选方案差异较大或需要语义理解时，才有必要调用更强模型辅助决策。","124":"4.1 不要让路由本身成为成本黑洞","125":"如果每次模型调用前，都先调用一个昂贵模型来决定应该调用哪个模型，那么路由系统本身就可能吞噬节省下来的成本。","126":"因此建议采用分层决策：","127":"先通过任务类型、工具能力、权限和预算进行规则过滤；","128":"使用已有的能力画像和历史评测结果排序；","129":"只有在决策不确定、成本差异显著或风险较高时，才调用更强模型进行辅助判断；","130":"将路由决策和实际结果记录下来，用于后续校准。","131":"这也符合你的成本原则：真正值得增加的成本应该用于提高任务质量，而不是用于无休止地分析如何选择模型。","132":"五、动态升级模型：什么时候应该从便宜模型切换到更强模型？","133":"这是 MAMO 最关键的运行时机制之一。","134":"如果所有任务从一开始就使用最强模型，成本很容易膨胀；但如果始终坚持使用最低成本模型，又可能在复杂任务中反复失败。","135":"我建议采用 ","136":"Progressive Escalation（渐进式能力升级）","137":"，而不是简单的“失败就换模型”。","138":"5.1 先区分四种不同的问题","139":"观察到的问题","140":"更合理的处理方式","141":"输入格式错误","142":"修正输入或适配层，不一定换模型","143":"工具返回明确失败","144":"检查工具状态、参数和前置条件","145":"上下文缺失或冲突","146":"重新检索、组装上下文或恢复任务状态","147":"复杂推理持续失败","148":"考虑升级模型、增加分析预算或拆分任务","149":"这一步非常重要。","150":"假设低成本模型连续三次无法修改代码，系统不能立即认定“模型不够强”。也可能是测试环境错误、关键文件未加载、工具契约不清楚，或者原计划本身不合理。","151":"升级模型之前，应该先检查失败类型。","152":"5.2 建立模型升级状态机","153":"这个状态机不是要求每次失败都走完整流程，而是保证升级有依据、有预算、有验证结果。","154":"5.3 升级必须考虑预期收益","155":"假设当前模型完成某类任务的成功概率约为 70%，升级模型后预计可以达到 85%，但调用成本增加了 4 倍。","156":"这并不意味着应该自动升级。","157":"系统还需要考虑：","158":"任务是否重要；","159":"失败代价有多大；","160":"当前预算还剩多少；","161":"升级模型是否真的解决已识别的问题；","162":"任务是否可以拆分；","163":"是否存在低成本工具或局部修复方案。","164":"可以用一个概念性的决策式表达：","165":"\\text{升级净价值}\n=\n\\text{预期质量收益}\n-\n\\text{新增调用成本}\n-\n\\text{新增延迟与风险}","166":"这不是一个可以直接通用计算的精确公式，而是要求系统在升级前明确比较预期收益与代价。","167":"对于关键任务，提升成功率可能非常值得；对于低价值、可随时重试的小任务，升级可能不划算。","168":"5.4 防止模型升级循环","169":"建议为每个任务设置：","170":"最大升级次数；","171":"最大模型调用预算；","172":"单节点重试上限；","173":"升级后的最低质量验收条件；","174":"允许使用的模型列表；","175":"不可突破的任务总预算。","176":"如果更强模型也无法解决问题，系统不能无限升级到更贵的模型，而应重新检查问题、采用不同工具、调整任务拆分方式，或停止并说明原因。","177":"六、模型适配策略：提示词、上下文和工具使用技巧应该存在哪里？","178":"这与你之前强调的专家隔离问题直接相关。","179":"假设编程专家发现，模型 A 在处理多文件修改时，只要先获取符号引用关系，再生成补丁，成功率就会提高。","180":"这个经验不能直接推广到旅游专家，也不能因为模型 A 使用这套策略有效，就认定模型 B 也会同样受益。","181":"因此，我建议将模型适配策略设计成独立资产，而不是直接修改通用提示词。","182":"6.1 适配策略的五个层级","183":"这里需要特别强调：","184":"模型适配策略是带有作用范围和版本的可治理资产，不是可以随意追加到系统提示词中的经验文本。","185":"6.2 适配策略必须绑定模型、任务和环境","186":"建议每个策略记录：","187":"adapter_id","188":"；","189":"adapter_version","190":"；","191":"model_id","192":"；","193":"model_version_range","194":"；","195":"expert_id","196":"；","197":"task_type","198":"；","199":"tool_environment","200":"；","201":"prompt_template_ref","202":"；","203":"context_policy_ref","204":"；","205":"evaluation_dataset_ref","206":"；","207":"known_limitations","208":"；","209":"rollback_version","210":"。","211":"例如，某个提示词补偿策略可能只适用于模型 A 的某个版本，在长上下文编程任务中有效。","212":"如果模型升级后原有问题已经修复，该策略可能反而降低表现。因此，模型升级必须触发相关补偿策略的重新评估。","213":"6.3 不要把所有成功经验都写进提示词","214":"如果每次成功都向提示词中添加一句规则，最终可能出现：","215":"提示词越来越长；","216":"不同规则互相冲突；","217":"模型执行成本上升；","218":"不知道究竟是哪条规则有效；","219":"旧规则无法安全撤回；","220":"通用专家被某个特定任务的经验污染。","221":"更合理的做法是先判断应该优化什么：","222":"如果是稳定的操作顺序，优先考虑工作流；","223":"如果是可重复使用的知识，考虑记忆；","224":"如果是特定模型的行为补偿，考虑适配策略；","225":"如果是确定性检查，优先考虑程序或工具；","226":"如果是任务目标与依赖变化，考虑规划策略；","227":"如果是执行失败原因不明，先进行诊断。","228":"这样，模型适配系统就不会变成一个不断堆积提示词的系统。","229":"七、多模型协同：多个模型不一定比一个模型更可靠","230":"当我们引入多个模型时，很容易认为让它们相互讨论、互相检查，就能提高质量。","231":"但这并不总是成立。","232":"如果多个模型使用相似的训练数据、相同的上下文和相同的错误假设，它们可能产生高度一致但错误的结论。","233":"例如，三个模型都认为某个工具返回成功就代表文件内容正确。即使它们互相确认，也不能替代实际读取文件和比较内容。","234":"因此，MAMO 必须区分真正的独立验证与表面上的多模型一致。","235":"7.1 四种多模型协作模式","236":"模式 A：流水线协作","237":"不同模型负责不同阶段。","238":"例如，低成本模型分类任务，强模型规划，确定性工具执行，验证器检查结果。","239":"优点：职责清晰，容易控制成本。","240":"模式 B：升级协作","241":"低成本模型先尝试，遇到明确困难后升级到更强模型。","242":"优点：适合任务难度不确定的情况，避免所有任务都支付最高成本。","243":"模式 C：候选方案比较","244":"在少数高价值决策中，生成多个候选方案，再通过统一标准比较。","245":"优点：可以探索不同解法；缺点是调用成本和决策延迟更高。","246":"模式 D：独立验证","247":"一个模型负责提出方案，另一个模型或确定性工具负责检查关键错误。","248":"优点：有机会降低共同错误，但前提是验证方法真正独立并且有效。","249":"7.2 高风险任务不应只依赖模型投票","250":"对于涉及重要文件修改、不可逆操作或关键交付物的任务，应当优先使用能够独立核验的证据。","251":"例如：","252":"代码任务使用实际测试和差异检查；","253":"文件操作使用内容哈希和状态读取；","254":"数据处理使用独立的数据完整性校验；","255":"媒体制作使用元数据检查、音画同步检测和必要的视觉审查。","256":"多模型可以辅助发现潜在问题，但不能通过简单多数票覆盖客观证据。","257":"7.3 多模型协作必须设置退出条件","258":"建议明确：","259":"最大参与模型数量；","260":"最大讨论轮数；","261":"最大总调用成本；","262":"必须产生的输出；","263":"争议如何解决；","264":"何时转入独立验证；","265":"何时停止并请求用户决策。","266":"如果多个模型连续几轮只是重复表达观点，却没有产生新证据或更好的候选方案，就应该停止协作，而不是继续消耗预算。","267":"八、成本治理：如何真正控制智能体的长期成本？","268":"你之前提出的原则是：真正有效的能力提升可以增加一些模型调用成本，但成本不能无限膨胀。","269":"我建议把这条原则落实为一个独立的 ","270":"Quality–Cost Controller（质量与成本控制器）","271":"。","272":"它不是简单地选择最便宜的模型，而是管理整个任务的资源分配。","273":"8.1 建立四级预算","274":"预算层级","275":"控制对象","276":"任务总预算","277":"整个任务允许消耗的费用、时间和模型调用量","278":"阶段预算","279":"规划、执行、诊断、验收等阶段的资源分配","280":"节点预算","281":"每个 DAG 节点的模型、工具、重试和恢复成本","282":"单次调用预算","283":"单次模型调用的输入输出限制、超时和费用上限","284":"这四级预算必须共享同一套账本。","285":"否则，Planner、ReAct、诊断器和验证器可能分别控制自己的成本，却让整个任务超支。","286":"8.2 预算分配应该考虑不确定性","287":"不建议一开始就把所有预算平均分配给每个节点。","288":"例如，一个复杂编程任务可能有 10 个节点，其中大部分是简单的文件读取和测试执行，只有一个节点需要解决棘手的并发问题。","289":"合理的策略是：","290":"为常规节点分配基础预算；","291":"为高不确定性节点预留额外预算；","292":"为最终验收与必要恢复保留预算；","293":"根据实际执行结果动态调整剩余资源；","294":"禁止普通节点擅自挪用全局保留额度。","295":"这样，系统既不会为每个简单步骤使用昂贵模型，也不会因为前期过度消耗而在关键诊断阶段没有资源。","296":"8.3 评估的不是单次调用成本，而是成功交付成本","297":"假设：","298":"模型 A 每次调用成本较低，但经常需要重试；","299":"模型 B 每次调用成本较高，但更容易一次完成。","300":"仅比较单次调用价格，会得出错误结论。","301":"更合理的指标是：","302":"\\text{成功交付成本}\n=\n\\frac{\\text{任务总实际成本}}{\\text{通过验收的任务数}}","303":"这个指标仍然需要结合任务质量、失败代价和延迟一起分析，但它比单纯比较每次模型调用价格更接近 EvoAgent 真正关心的目标。","304":"例如，一个模型虽然便宜，但如果频繁产生昂贵的错误视频、重复修改文件或需要多次人工介入，其整体成本可能更高。","305":"8.4 质量和成本不能互相掩盖","306":"建议采用约束式优化，而不是单纯追求成本最低。","307":"可以表达为：","308":"\\min \\text{Expected Total Cost}","309":"同时满足：","310":"\\text{Quality} \\geq Q_{\\min}","311":"\\text{Risk} \\leq R_{\\max}","312":"\\text{Cost} \\leq B_{\\max}","313":"这里的 ","314":"Q_{\\min}","315":"、","316":"R_{\\max}","317":" 和 ","318":"B_{\\max}","319":" 应当根据任务类型、用户授权和风险级别确定，而不是所有任务都使用同一个固定值。","320":"对于高价值任务，系统可以在预算允许的情况下选择更强模型和更多验证；对于低风险任务，则可以使用较低成本的模型与较轻量的验收方式。","321":"九、模型适配如何进化，而不是越改越乱？","322":"这是 EvoAgent 自进化系统的关键部分。","323":"我建议模型适配系统采用与记忆治理类似的受控生命周期，但必须区分模型选择、提示词适配、上下文策略和执行工作流。","324":"9.1 进化闭环","325":"9.2 改进对象必须分开","326":"同一个失败案例可能产生多个候选改进：","327":"提示词需要明确输出结构；","328":"上下文需要保留某个关键约束；","329":"工具需要增加前置条件检查；","330":"规划器需要补充一个依赖节点；","331":"模型路由需要为特定任务选择更强模型。","332":"这些候选不应该被打包成一次无法归因的大改动。","333":"更合理的做法是逐步验证改进对象，必要时使用组合实验检查交互效果。","334":"例如，单独更换模型可能没有改善，但模型与新的上下文策略组合后效果明显提升。系统应该能够识别这种交互，而不是简单地将功劳全部归给模型。","335":"9.3 只允许证据支持的改进晋升","336":"一次成功只能说明该方案在当前条件下有效，不能证明它适用于所有任务。","337":"因此，模型适配候选必须记录：","338":"适用专家；","339":"任务类型；","340":"模型版本；","341":"提示词与上下文版本；","342":"测试环境；","343":"支持证据；","344":"已知反例；","345":"成本变化；","346":"回滚方案。","347":"只有通过对应范围的评测，才能将候选策略提升为稳定版本。","348":"十、模型升级与模型更换：如何避免系统整体退化？","349":"即使新模型在基准测试中更强，也不意味着它在 EvoAgent 的实际工作流中一定更好。","350":"模型变化可能影响：","351":"提示词遵循；","352":"工具参数格式；","353":"JSON 或 Schema 输出；","354":"上下文压缩效果；","355":"Planner 的任务拆分方式；","356":"ReAct 的循环次数；","357":"错误诊断质量；","358":"生成结果的风格和稳定性；","359":"单任务成本与延迟。","360":"因此，模型切换不能只修改一个 ","361":"model_id","362":" 就直接全量发布。","363":"10.1 建立模型迁移评测矩阵","364":"建议对每次关键模型升级，检查以下组合：","365":"评测范围","366":"核心问题","367":"各领域专家","368":"新模型是否影响专家的实际任务质量？","369":"工具调用","370":"是否出现新的参数错误、协议错误或无效调用？","371":"上下文压缩","372":"是否更容易遗漏关键约束？","373":"规划与 DAG","374":"是否产生更多无效节点或不合理依赖？","375":"ReAct","376":"是否出现无进展循环或过度探索？","377":"失败恢复","378":"是否正确识别错误并采取合适恢复策略？","379":"成本与延迟","380":"实际成功交付成本是否改善？","381":"安全与权限","382":"是否更容易提出或尝试越权操作？","383":"不必每次更换模型都重新测试整个系统的所有可能组合。","384":"可以根据模型变更影响、历史缺陷和关键依赖建立风险导向的回归测试集。但关键约束、权限和恢复保护集必须保留。","385":"10.2 使用分阶段发布","386":"建议按以下顺序推进：","387":"离线回放：在固定任务集上运行新模型；","388":"对照评测：比较旧模型与新模型的质量和成本；","389":"影子评估：在允许的情况下，对新模型的决策进行独立评估，但不执行可能产生副作用的动作；","390":"小范围启用：仅在指定专家或低风险任务中使用；","391":"持续监测：观察实际任务表现；","392":"扩大范围或回滚：根据预先定义的门槛决定。","393":"如果新模型改变了工具调用行为，影子评估不能直接执行真实外部操作。应当通过模拟执行、只读环境或受控测试环境验证。","394":"10.3 模型回滚不应该回滚任务事实","395":"这是一个重要的工程边界。","396":"假设新模型导致任务规划质量下降，系统决定切回旧模型。","397":"这不意味着应该恢复到模型切换前的旧任务状态，也不意味着要丢弃新模型期间已经生成并验证有效的产物。","398":"应该回滚的是模型路由与适配配置，而不是把已经确认的执行事实一并回滚。","399":"任务状态仍然以权威状态库和执行证据为准。只有经过检查发现某些产物受到错误模型行为影响时，才需要让相关节点失效并重新执行。","400":"十一、建议冻结的架构决策","401":"这些是建议纳入 EvoAgent 全量架构的模型适配基线。具体模型名单、成本门槛、升级阈值和评测标准，应当根据实际部署环境、任务数据与可用模型逐步确定，而不是提前假定某个模型始终最优。","402":"十二、下一专项：自我诊断、因果归因与改进实验治理","403":"到这里，我们已经覆盖了 EvoAgent 的几个关键执行层面：","404":"专家系统与能力路由；","405":"记忆和上下文工程；","406":"长任务连续性；","407":"动态 DAG 与 ReAct 协同；","408":"工具执行契约与结果验证；","409":"模型适配与成本治理。","410":"但这些模块仍然需要一个更深层的系统来协调：","411":"当任务失败或质量下降时，EvoAgent 如何知道真正的问题出在哪里？","412":"这是整个自进化系统能否持续改善的关键。","413":"例如，一个代码任务失败了，可能是：","414":"意图识别错了；","415":"编程专家路由错了；","416":"关键文件没有进入上下文；","417":"上下文压缩丢失了接口约束；","418":"Planner 漏掉了依赖；","419":"ReAct 选择了错误工具；","420":"工具执行失败；","421":"模型能力不足；","422":"验收器遗漏了缺陷；","423":"记忆检索到了不适用的经验。","424":"如果系统只是看到“任务失败”，然后把提示词改得更长、换一个更贵的模型，或者增加一次重试，它可能会增加成本，却没有真正解决问题。","425":"下一专项建议定义为：","426":"Root Cause Analysis & Improvement Experiment Engine（根因分析与改进实验引擎，简称 RCAE）。","427":"重点研究：","428":"如何建立跨路由、专家、上下文、模型、工具和验收的统一故障证据链；","429":"如何区分症状、直接原因、根因和相关因素；","430":"如何避免把相关性误认为因果关系；","431":"如何判断问题属于局部案例、领域通用能力还是全局基础设施；","432":"如何识别多个故障同时发生时的主因与次因；","433":"如何设计能够区分不同根因假设的诊断实验；","434":"如何通过对照实验确定提示词、记忆、上下文、工具或模型改动是否真正有效；","435":"如何避免优化一个指标，却让其他能力退化；","436":"如何将诊断结论传递给正确的专家、模块和适配版本；","437":"如何建立可复现、可审计、可回滚的持续进化闭环。","438":"这一步尤其重要，因为它决定 EvoAgent 是一个“失败后不断尝试修改自己的系统”，还是一个“能够用证据识别问题、定位责任边界、验证改进效果，并逐步提高可靠性和效率的系统”。","439":"我建议下一轮从第一性原理开始，先把","440":"故障证据、诊断假设、根因判定和改进实验","441":"之间的边界彻底理清，再设计具体的诊断算法和治理机制。"},"fallbackMarkdown":"# EvoAgent 第二十专项：模型适配、多模型协同与智能成本治理\n\n前面我们已经设计了专家系统、路由、Planner、ReAct、动态 DAG、记忆、上下文、工具契约、验收、恢复与进化治理。\n\n现在要回答一个更深层的问题：\n\n**EvoAgent 的智能究竟来自模型本身，还是来自模型与提示词、上下文、工具、工作流、记忆和反馈机制的组合？如果某个模型变强了，系统应该如何利用它；如果模型变弱、不可用或成本过高，又该如何保持稳定？**\n\n我的核心判断是：\n\n**EvoAgent 不应该围绕某一个模型构建，而应该围绕可验证的任务能力构建。模型只是能力实现的一种可替换资源。**\n\n这意味着，不能把“使用了更强的模型”直接等同于“智能体能力提升”，也不能把某个模型的特定提示词技巧当作所有专家都适用的通用能力。\n\n本专项建议定义为：\n\n**Model Adaptation &amp; Multi-Model Orchestration Engine，简称 MAMO。**\n\n它负责模型能力评估、模型选择、调用升级、模型切换、适配策略管理和成本质量优化。\n\n## 一、第一性原理：真正需要路由的是任务所需能力，而不只是模型\n\n假设 EvoAgent 接到一个编程任务。\n\n其中可能包含：\n\n- 判断用户意图；\n- 理解项目结构；\n- 分析 AST；\n- 制定修改计划；\n- 生成补丁；\n- 调用工具；\n- 分析测试失败；\n- 验证修改是否正确。\n\n这些子任务对模型的要求完全不同。\n\n意图分类可能只需要一个快速、低成本的模型；复杂故障分析可能需要更强的推理能力；AST 解析应该由确定性工具完成，而不是让大模型凭文本猜测语法结构；测试是否通过则应该以实际执行结果为依据。\n\n因此，MAMO 不应该只回答：\n\n“当前应该用哪个模型？”\n\n它应该回答：\n\n“当前任务的哪一部分需要什么能力？有哪些实现方式？哪种组合在质量、成本、延迟和风险之间最合适？”\n\n## 二、模型不是唯一的能力来源\n\n这些因素存在交互关系，但不能混为一谈。\n\n例如，一次代码任务成功，可能是模型推理更强，也可能是工具补全了模型的不足，或者是上下文准确地提供了关键文件。\n\n如果系统不区分这些因素，就无法知道下一步究竟应该优化模型、提示词、上下文、工具还是工作流。\n\n因此，**MAMO 必须与 OCAE 诊断系统协作，区分任务失败的原因，而不是把所有失败都归咎于模型。**\n\n---\n\n# 三、建立模型能力画像，而不是给每个模型一个总排名\n\n我建议建立 `Model Capability Profile`（模型能力画像）。\n\n每个模型都应该按照具体任务类型、工具环境、上下文规模和适配版本进行评估，而不是只记录一个笼统的“智能分数”。\n\n## 3.1 模型能力画像包含什么？\n\n| 维度 | 评估内容 |\n|--------|--------|\n| 任务理解 | 是否正确识别目标、约束和隐含条件 |\n| 推理与规划 | 是否能形成有效计划，识别依赖和失败风险 |\n| 代码能力 | 代码生成、调试、重构、结构化修改的实际表现 |\n| 工具调用 | 参数正确率、协议遵循率、工具使用策略 |\n| 长上下文 | 关键信息保留、跨段关联和约束遵循 |\n| 结构化输出 | Schema 遵循率、格式错误率 |\n| 多模态能力 | 对图像、视频、音频等输入的实际处理效果 |\n| 纠错能力 | 能否根据真实反馈定位问题并修正 |\n| 成本与延迟 | 实际调用费用、响应时间和重试开销 |\n| 稳定性 | 多次执行的结果波动、超时率和失败率 |\n\n但这张表仍然不够，因为同一个模型在不同场景中的表现可能有明显差异。\n\n例如，模型 A 可能在短代码补全中表现很好，却在大型代码库重构时经常遗漏跨文件依赖。\n\n所以，画像还必须绑定具体的评测条件。\n\n## 3.2 画像必须带有适用范围\n\n建议至少绑定：\n\n- `model_id`：模型标识；\n- `model_version`：实际模型版本或可识别的部署快照；\n- `provider`：模型提供方；\n- `task_type`：任务类别；\n- `expert_id`：所属专家；\n- `tool_environment`：工具与运行环境；\n- `context_profile`：上下文长度和组装策略；\n- `prompt_version`：使用的提示词版本；\n- `adapter_version`：模型适配配置版本；\n- `evaluation_dataset_version`：评测集版本；\n- `evaluation_timestamp`：评测时间；\n- `capability_metrics`：各项能力指标；\n- `known_limitations`：已知局限。\n\n这样，模型画像就不是一个永久有效的标签，而是有条件、有证据、有版本的评测结论。\n\n例如，“模型 A 在编程任务中表现良好”不是一个足够精确的结论。\n\n更有价值的结论是：\n\n“模型 A 在指定版本的 Python 多文件修改评测集上，使用某版上下文策略和测试工具时，达到既定质量门槛，平均成本低于候选模型 B，但在大型重构任务中需要更强的回归验证。”\n\n这才足以支持实际路由。\n\n## 3.3 模型评测不能只用模型自己打分\n\n建议以真实任务结果为主，结合自动化指标和必要的人工评测。\n\n例如：\n\n- 代码任务以补丁正确性、测试结果和变更范围为证据；\n- 结构化输出以 Schema 校验结果为证据；\n- 规划任务以依赖完整性、执行成功率和实际成本为证据；\n- 工具调用以实际状态变化和后置条件为证据；\n- 长上下文任务以关键约束保留和最终任务完成情况为证据。\n\n模型可以解释自己为什么认为某个答案正确，但这种解释不能替代外部验证。\n\n---\n\n# 四、模型路由必须发生在多个层级\n\nEvoAgent 不能只在用户发来消息时选择一次模型。\n\n因为一个复杂任务可能包含多个不同性质的子任务，执行过程中也可能出现需要升级模型的情况。\n\n我建议设计四级模型路由。\n\n## R1 · 任务级模型路由\n\n根据整体任务类型、复杂度、风险、预算和专家能力，选择默认执行策略。\n\n例如：复杂编程任务选择编程专家，并为复杂诊断预留高能力模型预算。\n\n## R2 · 阶段级模型路由\n\n针对规划、执行、诊断、验收等阶段选择合适模型或确定性工具。\n\n例如：规划阶段使用较强推理能力，代码解析阶段优先使用 AST 工具。\n\n## R3 · 节点级模型路由\n\n为 DAG 中的具体节点选择模型、提示词版本和工具组合。\n\n例如：简单文件摘要使用低成本模型，复杂跨文件依赖分析使用更强模型。\n\n## R4 · 运行时升级路由\n\n在观察到明确的困难、失败或质量风险时，决定是否重试、切换模型或升级推理能力。\n\n例如：低成本模型连续无法定位测试失败时，转入更强的诊断路径。\n\n这四级路由不必每次都调用一个专门的路由模型。\n\n大多数简单判断可以由规则和统计模型完成；只有任务复杂度难以判断、候选方案差异较大或需要语义理解时，才有必要调用更强模型辅助决策。\n\n## 4.1 不要让路由本身成为成本黑洞\n\n如果每次模型调用前，都先调用一个昂贵模型来决定应该调用哪个模型，那么路由系统本身就可能吞噬节省下来的成本。\n\n因此建议采用分层决策：\n\n1. 先通过任务类型、工具能力、权限和预算进行规则过滤；\n2. 使用已有的能力画像和历史评测结果排序；\n3. 只有在决策不确定、成本差异显著或风险较高时，才调用更强模型进行辅助判断；\n4. 将路由决策和实际结果记录下来，用于后续校准。\n\n这也符合你的成本原则：真正值得增加的成本应该用于提高任务质量，而不是用于无休止地分析如何选择模型。\n\n---\n\n# 五、动态升级模型：什么时候应该从便宜模型切换到更强模型？\n\n这是 MAMO 最关键的运行时机制之一。\n\n如果所有任务从一开始就使用最强模型，成本很容易膨胀；但如果始终坚持使用最低成本模型，又可能在复杂任务中反复失败。\n\n我建议采用 **Progressive Escalation（渐进式能力升级）**，而不是简单的“失败就换模型”。\n\n## 5.1 先区分四种不同的问题\n\n| 观察到的问题 | 更合理的处理方式 |\n|--------|--------|\n| 输入格式错误 | 修正输入或适配层，不一定换模型 |\n| 工具返回明确失败 | 检查工具状态、参数和前置条件 |\n| 上下文缺失或冲突 | 重新检索、组装上下文或恢复任务状态 |\n| 复杂推理持续失败 | 考虑升级模型、增加分析预算或拆分任务 |\n\n这一步非常重要。\n\n假设低成本模型连续三次无法修改代码，系统不能立即认定“模型不够强”。也可能是测试环境错误、关键文件未加载、工具契约不清楚，或者原计划本身不合理。\n\n升级模型之前，应该先检查失败类型。\n\n## 5.2 建立模型升级状态机\n\n这个状态机不是要求每次失败都走完整流程，而是保证升级有依据、有预算、有验证结果。\n\n## 5.3 升级必须考虑预期收益\n\n假设当前模型完成某类任务的成功概率约为 70%，升级模型后预计可以达到 85%，但调用成本增加了 4 倍。\n\n这并不意味着应该自动升级。\n\n系统还需要考虑：\n\n- 任务是否重要；\n- 失败代价有多大；\n- 当前预算还剩多少；\n- 升级模型是否真的解决已识别的问题；\n- 任务是否可以拆分；\n- 是否存在低成本工具或局部修复方案。\n\n可以用一个概念性的决策式表达：\n\n\\[\n\\text{升级净价值}\n=\n\\text{预期质量收益}\n-\n\\text{新增调用成本}\n-\n\\text{新增延迟与风险}\n\\]\n\n这不是一个可以直接通用计算的精确公式，而是要求系统在升级前明确比较预期收益与代价。\n\n对于关键任务，提升成功率可能非常值得；对于低价值、可随时重试的小任务，升级可能不划算。\n\n## 5.4 防止模型升级循环\n\n建议为每个任务设置：\n\n- 最大升级次数；\n- 最大模型调用预算；\n- 单节点重试上限；\n- 升级后的最低质量验收条件；\n- 允许使用的模型列表；\n- 不可突破的任务总预算。\n\n如果更强模型也无法解决问题，系统不能无限升级到更贵的模型，而应重新检查问题、采用不同工具、调整任务拆分方式，或停止并说明原因。\n\n---\n\n# 六、模型适配策略：提示词、上下文和工具使用技巧应该存在哪里？\n\n这与你之前强调的专家隔离问题直接相关。\n\n假设编程专家发现，模型 A 在处理多文件修改时，只要先获取符号引用关系，再生成补丁，成功率就会提高。\n\n这个经验不能直接推广到旅游专家，也不能因为模型 A 使用这套策略有效，就认定模型 B 也会同样受益。\n\n因此，我建议将模型适配策略设计成独立资产，而不是直接修改通用提示词。\n\n## 6.1 适配策略的五个层级\n\n这里需要特别强调：\n\n**模型适配策略是带有作用范围和版本的可治理资产，不是可以随意追加到系统提示词中的经验文本。**\n\n## 6.2 适配策略必须绑定模型、任务和环境\n\n建议每个策略记录：\n\n- `adapter_id`；\n- `adapter_version`；\n- `model_id`；\n- `model_version_range`；\n- `expert_id`；\n- `task_type`；\n- `tool_environment`；\n- `prompt_template_ref`；\n- `context_policy_ref`；\n- `evaluation_dataset_ref`；\n- `known_limitations`；\n- `rollback_version`。\n\n例如，某个提示词补偿策略可能只适用于模型 A 的某个版本，在长上下文编程任务中有效。\n\n如果模型升级后原有问题已经修复，该策略可能反而降低表现。因此，模型升级必须触发相关补偿策略的重新评估。\n\n## 6.3 不要把所有成功经验都写进提示词\n\n如果每次成功都向提示词中添加一句规则，最终可能出现：\n\n- 提示词越来越长；\n- 不同规则互相冲突；\n- 模型执行成本上升；\n- 不知道究竟是哪条规则有效；\n- 旧规则无法安全撤回；\n- 通用专家被某个特定任务的经验污染。\n\n更合理的做法是先判断应该优化什么：\n\n- 如果是稳定的操作顺序，优先考虑工作流；\n- 如果是可重复使用的知识，考虑记忆；\n- 如果是特定模型的行为补偿，考虑适配策略；\n- 如果是确定性检查，优先考虑程序或工具；\n- 如果是任务目标与依赖变化，考虑规划策略；\n- 如果是执行失败原因不明，先进行诊断。\n\n这样，模型适配系统就不会变成一个不断堆积提示词的系统。\n\n---\n\n# 七、多模型协同：多个模型不一定比一个模型更可靠\n\n当我们引入多个模型时，很容易认为让它们相互讨论、互相检查，就能提高质量。\n\n但这并不总是成立。\n\n如果多个模型使用相似的训练数据、相同的上下文和相同的错误假设，它们可能产生高度一致但错误的结论。\n\n例如，三个模型都认为某个工具返回成功就代表文件内容正确。即使它们互相确认，也不能替代实际读取文件和比较内容。\n\n因此，MAMO 必须区分真正的独立验证与表面上的多模型一致。\n\n## 7.1 四种多模型协作模式\n\n**模式 A：流水线协作**\n\n不同模型负责不同阶段。\n\n例如，低成本模型分类任务，强模型规划，确定性工具执行，验证器检查结果。\n\n优点：职责清晰，容易控制成本。\n\n---\n\n**模式 B：升级协作**\n\n低成本模型先尝试，遇到明确困难后升级到更强模型。\n\n优点：适合任务难度不确定的情况，避免所有任务都支付最高成本。\n\n---\n\n**模式 C：候选方案比较**\n\n在少数高价值决策中，生成多个候选方案，再通过统一标准比较。\n\n优点：可以探索不同解法；缺点是调用成本和决策延迟更高。\n\n---\n\n**模式 D：独立验证**\n\n一个模型负责提出方案，另一个模型或确定性工具负责检查关键错误。\n\n优点：有机会降低共同错误，但前提是验证方法真正独立并且有效。\n\n## 7.2 高风险任务不应只依赖模型投票\n\n对于涉及重要文件修改、不可逆操作或关键交付物的任务，应当优先使用能够独立核验的证据。\n\n例如：\n\n- 代码任务使用实际测试和差异检查；\n- 文件操作使用内容哈希和状态读取；\n- 数据处理使用独立的数据完整性校验；\n- 媒体制作使用元数据检查、音画同步检测和必要的视觉审查。\n\n多模型可以辅助发现潜在问题，但不能通过简单多数票覆盖客观证据。\n\n## 7.3 多模型协作必须设置退出条件\n\n建议明确：\n\n- 最大参与模型数量；\n- 最大讨论轮数；\n- 最大总调用成本；\n- 必须产生的输出；\n- 争议如何解决；\n- 何时转入独立验证；\n- 何时停止并请求用户决策。\n\n如果多个模型连续几轮只是重复表达观点，却没有产生新证据或更好的候选方案，就应该停止协作，而不是继续消耗预算。\n\n---\n\n# 八、成本治理：如何真正控制智能体的长期成本？\n\n你之前提出的原则是：真正有效的能力提升可以增加一些模型调用成本，但成本不能无限膨胀。\n\n我建议把这条原则落实为一个独立的 **Quality–Cost Controller（质量与成本控制器）**。\n\n它不是简单地选择最便宜的模型，而是管理整个任务的资源分配。\n\n## 8.1 建立四级预算\n\n| 预算层级 | 控制对象 |\n|--------|--------|\n| 任务总预算 | 整个任务允许消耗的费用、时间和模型调用量 |\n| 阶段预算 | 规划、执行、诊断、验收等阶段的资源分配 |\n| 节点预算 | 每个 DAG 节点的模型、工具、重试和恢复成本 |\n| 单次调用预算 | 单次模型调用的输入输出限制、超时和费用上限 |\n\n这四级预算必须共享同一套账本。\n\n否则，Planner、ReAct、诊断器和验证器可能分别控制自己的成本，却让整个任务超支。\n\n## 8.2 预算分配应该考虑不确定性\n\n不建议一开始就把所有预算平均分配给每个节点。\n\n例如，一个复杂编程任务可能有 10 个节点，其中大部分是简单的文件读取和测试执行，只有一个节点需要解决棘手的并发问题。\n\n合理的策略是：\n\n- 为常规节点分配基础预算；\n- 为高不确定性节点预留额外预算；\n- 为最终验收与必要恢复保留预算；\n- 根据实际执行结果动态调整剩余资源；\n- 禁止普通节点擅自挪用全局保留额度。\n\n这样，系统既不会为每个简单步骤使用昂贵模型，也不会因为前期过度消耗而在关键诊断阶段没有资源。\n\n## 8.3 评估的不是单次调用成本，而是成功交付成本\n\n假设：\n\n- 模型 A 每次调用成本较低，但经常需要重试；\n- 模型 B 每次调用成本较高，但更容易一次完成。\n\n仅比较单次调用价格，会得出错误结论。\n\n更合理的指标是：\n\n\\[\n\\text{成功交付成本}\n=\n\\frac{\\text{任务总实际成本}}{\\text{通过验收的任务数}}\n\\]\n\n这个指标仍然需要结合任务质量、失败代价和延迟一起分析，但它比单纯比较每次模型调用价格更接近 EvoAgent 真正关心的目标。\n\n例如，一个模型虽然便宜，但如果频繁产生昂贵的错误视频、重复修改文件或需要多次人工介入，其整体成本可能更高。\n\n## 8.4 质量和成本不能互相掩盖\n\n建议采用约束式优化，而不是单纯追求成本最低。\n\n可以表达为：\n\n\\[\n\\min \\text{Expected Total Cost}\n\\]\n\n同时满足：\n\n\\[\n\\text{Quality} \\geq Q_{\\min}\n\\]\n\n\\[\n\\text{Risk} \\leq R_{\\max}\n\\]\n\n\\[\n\\text{Cost} \\leq B_{\\max}\n\\]\n\n这里的 \\(Q_{\\min}\\)、\\(R_{\\max}\\) 和 \\(B_{\\max}\\) 应当根据任务类型、用户授权和风险级别确定，而不是所有任务都使用同一个固定值。\n\n对于高价值任务，系统可以在预算允许的情况下选择更强模型和更多验证；对于低风险任务，则可以使用较低成本的模型与较轻量的验收方式。\n\n---\n\n# 九、模型适配如何进化，而不是越改越乱？\n\n这是 EvoAgent 自进化系统的关键部分。\n\n我建议模型适配系统采用与记忆治理类似的受控生命周期，但必须区分模型选择、提示词适配、上下文策略和执行工作流。\n\n## 9.1 进化闭环\n\n## 9.2 改进对象必须分开\n\n同一个失败案例可能产生多个候选改进：\n\n- 提示词需要明确输出结构；\n- 上下文需要保留某个关键约束；\n- 工具需要增加前置条件检查；\n- 规划器需要补充一个依赖节点；\n- 模型路由需要为特定任务选择更强模型。\n\n这些候选不应该被打包成一次无法归因的大改动。\n\n更合理的做法是逐步验证改进对象，必要时使用组合实验检查交互效果。\n\n例如，单独更换模型可能没有改善，但模型与新的上下文策略组合后效果明显提升。系统应该能够识别这种交互，而不是简单地将功劳全部归给模型。\n\n## 9.3 只允许证据支持的改进晋升\n\n一次成功只能说明该方案在当前条件下有效，不能证明它适用于所有任务。\n\n因此，模型适配候选必须记录：\n\n- 适用专家；\n- 任务类型；\n- 模型版本；\n- 提示词与上下文版本；\n- 测试环境；\n- 支持证据；\n- 已知反例；\n- 成本变化；\n- 回滚方案。\n\n只有通过对应范围的评测，才能将候选策略提升为稳定版本。\n\n---\n\n# 十、模型升级与模型更换：如何避免系统整体退化？\n\n即使新模型在基准测试中更强，也不意味着它在 EvoAgent 的实际工作流中一定更好。\n\n模型变化可能影响：\n\n- 提示词遵循；\n- 工具参数格式；\n- JSON 或 Schema 输出；\n- 上下文压缩效果；\n- Planner 的任务拆分方式；\n- ReAct 的循环次数；\n- 错误诊断质量；\n- 生成结果的风格和稳定性；\n- 单任务成本与延迟。\n\n因此，模型切换不能只修改一个 `model_id` 就直接全量发布。\n\n## 10.1 建立模型迁移评测矩阵\n\n建议对每次关键模型升级，检查以下组合：\n\n| 评测范围 | 核心问题 |\n|--------|--------|\n| 各领域专家 | 新模型是否影响专家的实际任务质量？ |\n| 工具调用 | 是否出现新的参数错误、协议错误或无效调用？ |\n| 上下文压缩 | 是否更容易遗漏关键约束？ |\n| 规划与 DAG | 是否产生更多无效节点或不合理依赖？ |\n| ReAct | 是否出现无进展循环或过度探索？ |\n| 失败恢复 | 是否正确识别错误并采取合适恢复策略？ |\n| 成本与延迟 | 实际成功交付成本是否改善？ |\n| 安全与权限 | 是否更容易提出或尝试越权操作？ |\n\n不必每次更换模型都重新测试整个系统的所有可能组合。\n\n可以根据模型变更影响、历史缺陷和关键依赖建立风险导向的回归测试集。但关键约束、权限和恢复保护集必须保留。\n\n## 10.2 使用分阶段发布\n\n建议按以下顺序推进：\n\n1. 离线回放：在固定任务集上运行新模型；\n2. 对照评测：比较旧模型与新模型的质量和成本；\n3. 影子评估：在允许的情况下，对新模型的决策进行独立评估，但不执行可能产生副作用的动作；\n4. 小范围启用：仅在指定专家或低风险任务中使用；\n5. 持续监测：观察实际任务表现；\n6. 扩大范围或回滚：根据预先定义的门槛决定。\n\n如果新模型改变了工具调用行为，影子评估不能直接执行真实外部操作。应当通过模拟执行、只读环境或受控测试环境验证。\n\n## 10.3 模型回滚不应该回滚任务事实\n\n这是一个重要的工程边界。\n\n假设新模型导致任务规划质量下降，系统决定切回旧模型。\n\n这不意味着应该恢复到模型切换前的旧任务状态，也不意味着要丢弃新模型期间已经生成并验证有效的产物。\n\n应该回滚的是模型路由与适配配置，而不是把已经确认的执行事实一并回滚。\n\n任务状态仍然以权威状态库和执行证据为准。只有经过检查发现某些产物受到错误模型行为影响时，才需要让相关节点失效并重新执行。\n\n---\n\n# 十一、建议冻结的架构决策\n\n这些是建议纳入 EvoAgent 全量架构的模型适配基线。具体模型名单、成本门槛、升级阈值和评测标准，应当根据实际部署环境、任务数据与可用模型逐步确定，而不是提前假定某个模型始终最优。\n\n# 十二、下一专项：自我诊断、因果归因与改进实验治理\n\n到这里，我们已经覆盖了 EvoAgent 的几个关键执行层面：\n\n- 专家系统与能力路由；\n- 记忆和上下文工程；\n- 长任务连续性；\n- 动态 DAG 与 ReAct 协同；\n- 工具执行契约与结果验证；\n- 模型适配与成本治理。\n\n但这些模块仍然需要一个更深层的系统来协调：**当任务失败或质量下降时，EvoAgent 如何知道真正的问题出在哪里？**\n\n这是整个自进化系统能否持续改善的关键。\n\n例如，一个代码任务失败了，可能是：\n\n- 意图识别错了；\n- 编程专家路由错了；\n- 关键文件没有进入上下文；\n- 上下文压缩丢失了接口约束；\n- Planner 漏掉了依赖；\n- ReAct 选择了错误工具；\n- 工具执行失败；\n- 模型能力不足；\n- 验收器遗漏了缺陷；\n- 记忆检索到了不适用的经验。\n\n如果系统只是看到“任务失败”，然后把提示词改得更长、换一个更贵的模型，或者增加一次重试，它可能会增加成本，却没有真正解决问题。\n\n下一专项建议定义为：\n\n**Root Cause Analysis &amp; Improvement Experiment Engine（根因分析与改进实验引擎，简称 RCAE）。**\n\n重点研究：\n\n1. 如何建立跨路由、专家、上下文、模型、工具和验收的统一故障证据链；\n2. 如何区分症状、直接原因、根因和相关因素；\n3. 如何避免把相关性误认为因果关系；\n4. 如何判断问题属于局部案例、领域通用能力还是全局基础设施；\n5. 如何识别多个故障同时发生时的主因与次因；\n6. 如何设计能够区分不同根因假设的诊断实验；\n7. 如何通过对照实验确定提示词、记忆、上下文、工具或模型改动是否真正有效；\n8. 如何避免优化一个指标，却让其他能力退化；\n9. 如何将诊断结论传递给正确的专家、模块和适配版本；\n10. 如何建立可复现、可审计、可回滚的持续进化闭环。\n\n这一步尤其重要，因为它决定 EvoAgent 是一个“失败后不断尝试修改自己的系统”，还是一个“能够用证据识别问题、定位责任边界、验证改进效果，并逐步提高可靠性和效率的系统”。\n\n我建议下一轮从第一性原理开始，先把**故障证据、诊断假设、根因判定和改进实验**之间的边界彻底理清，再设计具体的诊断算法和治理机制。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6","turn_exchange_id":"b07945c4-0f4b-45da-94f8-9b1394e047b8","request_id":"4a55e8df-f08e-4e40-b389-5c3677d373d2","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"working_turn_id":"b07945c4-0f4b-45da-94f8-9b1394e047b8","default_model_slug":"gpt-6","can_save":true,"parent_id":"98f4027e-3cfe-4d58-b84e-fde725cb431b","logical_answer_prefix_activity":{"visibility":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"},{"id":"bbb215f2-da55-4758-8416-b7467787b7ed","author":{"role":"user","name":null,"metadata":{}},"create_time":1792494895.327814,"update_time":1792495094.054715,"content":{"content_type":"text","parts":["可以"]},"status":"finished_successfully","end_turn":null,"weight":1.0,"metadata":{"model_slug":"gpt-6","default_model_slug":"gpt-6","is_visually_hidden_from_conversation":false,"search_result_groups":[],"search_queries":[],"image_results":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","real_time_audio_has_video":false,"system_hints":[],"dictation":false,"voice_mode_message":false,"trigger_async_ux":false,"writing_blocks":{},"request_id":"92ad60c9-6cab-4396-8d30-90030320e0ed","message_source":null,"turn_exchange_id":"906768c9-750e-4db3-acb2-8d378ffa9972","working_turn_id":"906768c9-750e-4db3-acb2-8d378ffa9972","can_save":false},"recipient":"all","channel":null},{"id":"6578057a-e882-47fe-b2f0-c69e5aab2e55","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792495064.01702,"update_time":1792495064.031112,"content":{"content_type":"reasoning_recap","content":"思考了 2m 48s"},"status":"finished_successfully","end_turn":false,"weight":1.0,"metadata":{"reasoning_status":"reasoning_ended","finished_duration_sec":168,"reasoning_start_time":1792494895.8921306,"reasoning_end_time":1792495063.9790125,"reasoning_recap_type":"hide_all","cot_version":"v5","reasoning_group_id":"71148ec5-1d03-4316-978d-fc449168d168","conversation_followup_suggestions_eligible":false,"request_id":"92ad60c9-6cab-4396-8d30-90030320e0ed","message_type":"next","turn_exchange_id":"906768c9-750e-4db3-acb2-8d378ffa9972","working_turn_id":"906768c9-750e-4db3-acb2-8d378ffa9972","model_slug":"gpt-6","default_model_slug":"gpt-6","can_save":false,"parent_id":"e1116321-b64a-41df-a66d-2f04d4c936a5","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"9a24ef60-349f-441c-9be8-070fcbd7586f","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792494897.205298,"update_time":1792495079.130516,"content":{"content_type":"text","parts":["# EvoAgent 第二十一专项：自我诊断、根因归因与改进实验治理\n\n这一轮我们进入整个 EvoAgent 自进化体系中最关键的部分之一：**系统如何发现自己哪里出了问题，判断为什么出问题，并证明改进确实有效。**\n\n前面已经设计了专家系统、意图路由、记忆、上下文压缩、Planner、ReAct、动态 DAG、工具执行、模型适配和成本治理。\n\n这些模块能够让 EvoAgent 完成任务，但它们也可能相互影响。\n\n例如，一次代码任务失败了，表面上看是代码生成错误，实际原因却可能是：\n\n- 用户意图识别不完整；\n- 路由到了不合适的专家；\n- 记忆检索到了不适用的经验；\n- 上下文压缩丢失了关键约束；\n- Planner 漏掉了一个依赖；\n- ReAct 选择了错误的工具；\n- 工具执行结果不完整；\n- 模型本身无法解决当前难度的问题；\n- 测试环境存在异常；\n- 验收器错误地判断了结果。\n\n如果系统只记录“任务失败”，然后自动增加提示词、换一个模型或多试几次，它就不是在真正进化，而是在盲目调整。\n\n我建议将本专项定义为：\n\n**Root Cause Analysis & Improvement Experiment Engine，简称 RCAE。**\n\n它不是一个负责修改所有模块的超级智能体，而是一个独立的诊断与实验治理系统，负责建立证据、提出假设、验证根因，并将经过验证的改进交给正确的模块。\n\n## 一、第一性原理：失败是观察结果，不是根因\n\n首先要严格区分五个概念。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"现象 Symptom\",\"用户看到的结果，例如任务失败、速度变慢、输出质量下降。\"],\n    [\"证据 Evidence\",\"实际观察到的事实，例如测试报告、工具错误码、上下文版本和执行轨迹。\"],\n    [\"假设 Hypothesis\",\"对问题原因的可检验解释，例如关键接口约束没有进入上下文。\"],\n    [\"根因 Root Cause\",\"经过足够证据和验证支持，能够解释问题并指导修复的原因。\"],\n    [\"改进 Improvement\",\"针对原因实施的修改，并通过对照评测证明其产生预期效果。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"改进 Improvement\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n例如，编程专家修改代码后测试失败。\n\n- 现象：测试没有通过。\n- 证据：测试报告显示某个函数返回值不符合预期。\n- 假设 A：模型误解了函数的业务规则。\n- 假设 B：上下文中缺少调用方的接口约束。\n- 假设 C：测试环境使用了过期依赖。\n- 根因判断：需要进一步检查证据，不能仅凭错误表象确定。\n- 改进：修复被证实的问题，并通过对照测试验证。\n\n特别要注意：一个问题可能有多个原因。例如，上下文缺失是直接原因，而上下文组装策略未能保留关键接口约束，才是更上游的系统性原因。\n\n**RCAE 的任务不是尽快找一个听起来合理的解释，而是找到证据足够、可被反驳、能够指导有效改进的解释。**\n\n---\n\n# 二、RCAE 在整个 EvoAgent 中处于什么位置？\n\n我建议将 RCAE 设计成独立于具体专家、模型和执行器的横向系统。\n\n它能够观察所有专家的运行情况，但不直接接管所有执行权；它可以诊断和提出改进建议，但不能因为发现一次失败就自动修改生产配置。\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    **运行中的 EvoAgent**\n    <text color=\"secondary\" size=\"sm\">路由、专家、记忆、上下文、Planner、ReAct、工具、模型与验收器</text>\n  </box>\n  <icon name=\"arrow-down\" size=\"lg\" color=\"secondary\"/>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    **统一证据采集层**\n    <text color=\"secondary\" size=\"sm\">任务事件、状态变更、工具结果、模型调用、成本、产物与验收记录</text>\n  </box>\n  <icon name=\"arrow-down\" size=\"lg\" color=\"secondary\"/>\n  <box border radius=\"lg\" padding={3} gap={2}>\n    <title size=\"lg\" textAlign=\"center\">RCAE 诊断与实验治理</title>\n    <grid columns={2} gap={2}>\n      <grid-item>\n        <box background=\"surface-secondary\" radius=\"md\" padding={2} gap={1}>\n          **故障检测**\n          <text color=\"secondary\" size=\"xs\">发现异常与退化</text>\n        </box>\n      </grid-item>\n      <grid-item>\n        <box background=\"surface-secondary\" radius=\"md\" padding={2} gap={1}>\n          **根因分析**\n          <text color=\"secondary\" size=\"xs\">提出并检验假设</text>\n        </box>\n      </grid-item>\n      <grid-item>\n        <box background=\"surface-secondary\" radius=\"md\" padding={2} gap={1}>\n          **实验设计**\n          <text color=\"secondary\" size=\"xs\">建立对照与评测</text>\n        </box>\n      </grid-item>\n      <grid-item>\n        <box background=\"surface-secondary\" radius=\"md\" padding={2} gap={1}>\n          **效果与风险评估**\n          <text color=\"secondary\" size=\"xs\">决定是否晋升</text>\n        </box>\n      </grid-item>\n    </grid>\n  </box>\n  <icon name=\"arrow-down\" size=\"lg\" color=\"secondary\"/>\n  <box border radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    **受控进化治理层**\n    <text color=\"secondary\" size=\"sm\">候选改进、权限审批、版本管理、灰度发布与回滚</text>\n  </box>\n  <icon name=\"arrow-down\" size=\"lg\" color=\"secondary\"/>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    **对应模块的改进版本**\n    <text color=\"secondary\" size=\"sm\">只修改经过诊断确认的目标模块，并重新验证相关能力</text>\n  </box>\n</box>\n\n这里有一个重要的架构边界：\n\n- OCAE 负责运行时可观测性和证据采集。\n- RCAE 负责故障分析、根因假设和改进实验。\n- 进化治理系统负责候选版本的批准、发布、回滚与范围控制。\n- 各专家、模型适配器、上下文引擎和工具仍然拥有自己的实现与配置。\n\n如果前面设计的 OCAE 已经承担部分异常检测功能，不需要再重复建设一套监控系统。RCAE 应该消费 OCAE 提供的事件和指标，并补足因果分析与实验治理能力。\n\n## 2.1 诊断器不能成为新的执行风险源\n\nRCAE 可能发现某个工具存在缺陷，但它不应该在正在运行的任务中直接替换工具实现。\n\n正确流程应该是：\n\n1. 保存原始证据；\n2. 生成诊断假设；\n3. 评估影响范围；\n4. 构建候选修复；\n5. 在隔离环境中验证；\n6. 通过治理门禁发布；\n7. 观察实际效果；\n8. 必要时回滚。\n\n如果问题正在影响用户当前任务，任务控制器可以采取已经授权的临时保护措施，例如停止重试、切换到已验证的备用工具或暂停任务。这属于运行时故障处置，不等于允许 RCAE 自行修改生产系统。\n\n---\n\n# 三、统一故障证据链：没有证据，就不能可靠诊断\n\nRCAE 能否成功，很大程度上取决于证据质量。\n\n如果系统只保存最终回答和一条“任务失败”的日志，就无法知道问题到底发生在哪一步。\n\n因此，建议为每个任务建立可关联的证据链。\n\n## 3.1 一次任务需要关联哪些信息？\n\n| 证据类别 | 必须能够回答的问题 |\n|---|---|\n| 目标与约束 | 用户最初要求什么？哪些约束不可违反？ |\n| 路由记录 | 为什么选择这个专家？路由依据和版本是什么？ |\n| 记忆记录 | 检索了哪些记忆？来源、适用范围和版本是什么？ |\n| 上下文记录 | 实际传给模型的上下文包是什么？哪些信息被压缩或省略？ |\n| 规划记录 | 使用了哪个计划版本？节点依赖为什么这样设置？ |\n| 模型记录 | 调用了哪个模型、提示词和适配版本？ |\n| 工具记录 | 调用了什么工具、参数是什么、实际结果如何？ |\n| 状态记录 | 节点和任务状态在什么时间发生了什么变化？ |\n| 验收记录 | 哪些标准通过、哪些失败、使用了什么证据？ |\n| 资源记录 | 花费了多少 Token、费用、时间和重试预算？ |\n| 进化记录 | 当时使用了哪个稳定配置和哪些候选策略？ |\n\n这些记录必须通过统一的 `task_id`、`node_id`、`trace_id`、`tool_call_id`、版本号等标识关联。\n\n同时，需要区分原始证据和后续生成的诊断结论。模型生成的“根因解释”不能覆盖实际工具结果或原始任务事件。\n\n## 3.2 证据需要保留到什么程度？\n\n不是所有内容都需要永久保存完整原文。\n\n建议采用分级保存：\n\n- **关键状态与审计事件：** 保留必要的结构化事实、版本、时间和结果。\n- **关键决策证据：** 保留实际使用的提示词版本、上下文包引用、计划版本和工具参数。\n- **大型产物：** 保存文件、报告和数据的引用、哈希、版本与存储位置。\n- **模型中间内容：** 按诊断需要和隐私策略保存，必要时保存摘要或引用。\n- **敏感内容：** 根据最小化原则进行脱敏、访问控制和生命周期管理。\n\n需要注意，哈希只能帮助检测内容是否变化，不能单独证明内容真实或正确；摘要也不能代替原始证据。\n\n对于个人电脑或 Mini PC 部署，证据链可以优先采用本地追加式事件日志、SQLite 元数据和文件产物引用实现，不需要为 RCAE 单独搭建大型服务器。\n\n---\n\n# 四、根因分析：如何区分局部错误与通用能力缺陷？\n\n这是你之前反复强调的一个核心原则：\n\n**某个场景出错，不代表整个通用能力有问题；某种代码写法失败，也不代表这种写法本身完全错误。**\n\nRCAE 必须将这一原则落实到诊断算法中。\n\n我建议为每个问题建立四个层级的归因范围。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"L1 · 单次执行异常\",\"只在某一次任务、特定输入或特定环境中出现。首先检查该次执行的证据。\"],\n    [\"L2 · 局部策略缺陷\",\"同一任务类型或某个明确条件下重复出现，例如某个提示词分支遗漏特殊输入。\"],\n    [\"L3 · 领域通用能力缺陷\",\"多个不同案例反复暴露同一领域能力的系统性问题，例如编程专家的跨文件依赖分析不足。\"],\n    [\"L4 · 共享基础设施缺陷\",\"不同专家都受到同一基础设施问题影响，例如上下文装配错误、工具网关状态不一致或预算计算错误。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"L4 · 共享基础设施缺陷\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这四个层级不是简单的严重程度排序，而是不同的故障作用范围。一个单次故障也可能非常严重；一个通用能力问题也可能只影响低风险任务。\n\n## 4.1 不能仅凭发生次数判断通用性\n\n假设编程专家连续三次在同一个项目中写错了某种结构。\n\n这并不能证明它在所有编程任务中都存在同样缺陷，因为三次错误可能都来自同一个过时接口、同一个缺失文件或同一个错误假设。\n\n反过来，如果错误分别出现在不同项目、不同输入和不同工具环境中，却都指向相同的约束遗漏，就更有理由怀疑存在领域通用问题。\n\n因此，诊断系统应该考虑：\n\n- 案例之间是否真正独立；\n- 是否共享同一个根因；\n- 是否存在共同环境因素；\n- 是否覆盖了不同输入和边界条件；\n- 是否有反例；\n- 现有证据能否区分多个竞争性解释。\n\n## 4.2 建立影响范围，而不是一次性扩大修复\n\n建议每个诊断结果都带有明确的作用范围：\n\n- 仅当前任务；\n- 指定工作流；\n- 指定专家；\n- 指定任务类型；\n- 指定模型与适配版本；\n- 指定共享基础设施；\n- 多个专家共享的通用能力。\n\n如果问题只发生在某个编程工作流，就先修复该工作流，不要直接修改所有专家的系统提示词。\n\n如果确认问题来自共享上下文引擎，则应修复共享组件，并评估所有依赖它的专家。\n\n这能避免局部问题污染全局能力，也能避免真正的基础设施缺陷被错误地分散修补。\n\n---\n\n# 五、因果归因：如何知道究竟是谁导致了失败？\n\n证据关联并不等于因果关系。\n\n例如，失败任务通常使用较强模型，这可能只是因为系统会把困难任务路由给强模型，并不代表强模型导致了失败。\n\n同样，使用较长上下文的任务成功率更低，也可能是因为复杂任务本身更难，而不是上下文越长越差。\n\n如果 RCAE 直接根据统计相关性修改策略，就可能得出错误结论。\n\n## 5.1 建立可检验的因果假设\n\n以代码修改失败为例，可以提出以下假设：\n\n- H1：上下文缺失导致模型误解接口；\n- H2：Planner 漏掉了必要的依赖节点；\n- H3：工具修改方式破坏了文件结构；\n- H4：测试环境与目标环境不一致；\n- H5：当前模型无法可靠处理该类跨文件修改。\n\n每个假设都应该说明：\n\n1. 支持它的证据是什么；\n2. 哪些观察与它冲突；\n3. 如果假设成立，应该出现什么现象；\n4. 哪个测试能够区分它与其他假设；\n5. 修复它后，预期哪些指标会改善；\n6. 哪些指标不应该受到明显影响。\n\n例如，如果 H1 成立，那么在不改变模型、工具和计划的情况下，补充缺失的接口约束应该能改善相应案例的结果。\n\n如果补充约束后问题依旧存在，就需要降低对 H1 的信心，继续检查其他原因。\n\n## 5.2 诊断不应只有一个“根因答案”\n\n复杂失败可能存在多个原因，而且原因之间可能存在依赖关系。\n\n例如：\n\n- 上下文引擎没有保留接口定义；\n- Planner 没有安排接口核查节点；\n- 模型生成补丁时没有识别不兼容调用；\n- 验收器只运行了局部测试。\n\n这四项问题可能共同导致最终失败。\n\n建议区分：\n\n- **直接原因：** 直接导致当前失败的因素；\n- **促成因素：** 提高失败概率或扩大影响的因素；\n- **上游机制缺陷：** 让问题反复发生的系统性原因；\n- **检测缺陷：** 未能及时发现或阻止错误的因素。\n\n并不是每次失败都必须找到唯一的根因。证据不足时，系统应该保留多个候选假设，或者明确标记“根因尚未确定”。\n\n## 5.3 使用干预实验，而不是只做事后解释\n\n当问题具有足够复现性时，最有价值的方法是控制变量。\n\n例如，比较两种策略：\n\n- A：现有上下文组装方式；\n- B：保留接口定义和调用关系的新策略。\n\n在相同评测样本、相同模型版本、相同工具和相同验收标准下运行，比较结果。\n\n如果 B 的成功率显著提高，而且没有增加不可接受的成本和副作用，就能为该改进提供更强的因果证据。\n\n但如果同时更换模型、修改提示词、调整工具和增加测试，结果即使改善，也很难判断究竟是哪项修改起作用。\n\n因此，RCAE 应优先采用可解释、可对照的实验；必要时再通过多因素实验分析多个改进之间的交互作用。\n\n---\n\n# 六、诊断算法：从异常信号到可验证结论\n\n我建议将 RCAE 的诊断过程设计为一个受控的证据分析流程，而不是让一个大模型读取全部日志后自由发挥。\n\n## 6.1 第一步：检测异常并建立故障案例\n\n故障可以来自不同渠道：\n\n- 最终验收失败；\n- 节点异常终止；\n- 超时或预算超限；\n- 重复重试却没有进展；\n- 工具结果与预期状态不一致；\n- 用户明确指出结果错误；\n- 质量指标持续下降；\n- 新版本表现明显差于稳定版本；\n- 不同设备或模型之间出现状态不一致。\n\n系统首先生成唯一的 `incident_id`，并关联相关任务、节点、工具调用、模型版本和证据引用。\n\n一次任务可能产生多个故障案例；多个任务也可能最终关联到同一个系统性问题。不能把故障案例和根因一一对应。\n\n## 6.2 第二步：重建实际执行事实\n\n诊断前先回答“实际发生了什么”。\n\n例如：\n\n- 任务原始目标是什么？\n- 实际使用了哪个计划版本？\n- 哪些节点已完成？\n- 失败前最后一个可信状态是什么？\n- 模型实际收到哪些上下文？\n- 工具实际执行了什么操作？\n- 外部副作用是否已经发生？\n- 验收器依据什么证据作出判断？\n\n这一步优先使用持久化事件、工具记录、状态快照和真实产物，而不是让模型凭对话历史重新推断。\n\n如果关键证据缺失，应当把缺失本身记录为诊断限制，而不是自动补造一个看似合理的执行过程。\n\n## 6.3 第三步：生成候选假设\n\n诊断器根据故障类型、历史案例和当前证据，生成有限数量的候选假设。\n\n每个假设都应具有：\n\n- `hypothesis_id`；\n- `incident_id`；\n- 可能的责任模块；\n- 支持证据；\n- 反对证据；\n- 预期观察；\n- 区分性测试；\n- 预期修复方向；\n- 潜在副作用。\n\n模型可以参与假设生成，但假设的优先级应该由证据、可检验性和预期诊断价值决定，而不是只依据语言表达的自信程度。\n\n## 6.4 第四步：选择最有价值的诊断实验\n\n不是所有假设都值得测试。\n\n建议优先选择满足以下条件的实验：\n\n- 能够明显区分竞争性假设；\n- 成本可接受；\n- 不会破坏现有数据；\n- 能在隔离环境中执行；\n- 结果容易解释；\n- 即使失败，也能提供新的有效证据。\n\n例如，怀疑代码补丁错误时，先运行相关测试，通常比立即更换模型更有诊断价值。\n\n怀疑上下文遗漏时，可以比较实际上下文包与原始证据，先确认约束是否真的缺失，而不是直接修改压缩算法。\n\n## 6.5 第五步：更新诊断结论\n\n实验结束后，RCAE 更新每个假设的证据状态：\n\n- 已获得较强支持；\n- 部分支持；\n- 证据不足；\n- 与观察冲突；\n- 已被反例推翻；\n- 仍需进一步测试。\n\n这里不必强行生成一个精确的根因概率。只有在有足够数据、校准方法和明确统计假设时，才应输出有意义的概率估计。\n\n对于证据不足的案例，正确的结果可以是“当前无法区分 H1 与 H2”，而不是强行选择一个原因。\n\n---\n\n# 七、改进实验治理：如何证明修改真的让系统变好了？\n\nRCAE 不应该止步于诊断结论。\n\n只有改进经过验证，才真正完成了进化闭环。\n\n我建议将每次改进设计为一个独立的 `Improvement Experiment`。\n\n## 7.1 实验记录必须包含什么？\n\n| 字段 | 含义 |\n|---|---|\n| `experiment_id` | 实验唯一标识 |\n| `root_cause_ref` | 对应的诊断结论或候选假设 |\n| `target_component` | 计划修改的模块 |\n| `baseline_version` | 当前稳定版本 |\n| `candidate_version` | 候选改进版本 |\n| `evaluation_dataset` | 使用的任务集和样本版本 |\n| `primary_metric` | 最主要的改善指标 |\n| `guardrail_metrics` | 必须保持的质量、安全和成本指标 |\n| `test_environment` | 模型、工具、上下文与执行环境 |\n| `experiment_result` | 对照结果、失败案例和统计限制 |\n| `promotion_decision` | 晋升、继续实验或拒绝 |\n| `rollback_plan` | 如何恢复到稳定版本 |\n\n这使得每次进化都能够追溯：为什么要改、改了什么、如何验证，以及为什么最终允许或拒绝发布。\n\n## 7.2 实验必须有主指标和护栏指标\n\n例如，优化编程专家的上下文策略。\n\n主指标可以是特定任务集上的验收通过率；护栏指标则包括：\n\n- 关键约束遗漏率；\n- 代码回归失败率；\n- 平均调用成本；\n- 平均任务耗时；\n- 无进展重试率；\n- 其他编程任务的退化情况。\n\n如果新策略让目标案例成功率提高，却使其他常见任务的失败率明显上升，就不能只根据主指标宣布优化成功。\n\n对于影响共享基础设施的改进，必须扩大回归测试范围，覆盖依赖该组件的多个专家。\n\n## 7.3 小样本不能被误判为全面提升\n\n假设一个候选提示词在五个案例中全部成功，而旧版本在其中四个案例成功。\n\n这可能是改善，也可能是样本过少、任务难度差异或偶然波动。\n\n因此，系统应根据指标类型、样本规模和错误代价选择评测方法，并记录结论的适用范围。\n\n对于罕见但严重的安全问题，即使没有足够样本进行统计推断，也可以通过确定性测试和安全门禁阻止明显不安全的改动。\n\n**没有足够证据证明改进有效时，应该保持现有稳定版本，而不是为了追求持续进化而强行发布。**\n\n---\n\n# 八、如何防止诊断系统误判？\n\n自我诊断系统本身也会出错。\n\n它可能把偶然错误判断为通用缺陷，把相关性当成因果关系，或者因为缺少日志而把责任归给错误模块。\n\n因此，RCAE 需要自己的质量控制机制。\n\n## 8.1 四类典型诊断风险\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"过度归因\",\"一次局部失败被解释为整个专家能力不足，导致无必要的全局修改。\"],\n    [\"归因不足\",\"只修复直接错误，却没有发现导致错误反复发生的上游机制缺陷。\"],\n    [\"错误归因\",\"把模型输出错误归咎于模型，实际上是上下文、工具或验收环节的问题。\"],\n    [\"虚假确定性\",\"日志不完整，但诊断器仍然输出单一、肯定的根因结论。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"虚假确定性\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n## 8.2 建立诊断器自己的评测集\n\nRCAE 应当拥有独立于业务任务的诊断评测集，包含：\n\n- 已知根因的历史故障；\n- 多个原因都合理的模糊案例；\n- 日志不完整的案例；\n- 具有误导性相关性的案例；\n- 多个模块共同导致失败的案例；\n- 同一表面错误对应不同根因的案例；\n- 已有假设被反例推翻的案例。\n\n评估指标应包括：\n\n- 根因定位准确性；\n- 不确定时拒绝过度判断的能力；\n- 假设覆盖率；\n- 错误修复建议率；\n- 诊断成本；\n- 诊断所需时间；\n- 改进实验的实际有效率。\n\n其中，最值得重视的是**错误诊断导致的负面影响**。\n\n如果诊断器偶尔无法找到根因，但能够明确表示证据不足，影响可能有限；如果它经常自信地把问题归错模块，并触发自动发布，那么风险就很大。\n\n## 8.3 诊断与发布必须分权\n\n我建议明确分离：\n\n- RCAE：负责证据分析与改进建议；\n- 实验执行器：负责在受控环境运行实验；\n- 进化治理器：负责检查发布条件与批准权限；\n- 发布控制器：负责部署、灰度、监测与回滚。\n\n这几个模块可以部署在同一台个人电脑上，但逻辑权限应该分离。\n\n这样，即使 RCAE 的诊断模型出现错误，也不能仅凭自己的结论直接修改生产提示词、全局记忆、模型路由和共享基础设施。\n\n---\n\n# 九、一个完整案例：编程专家为什么连续写错代码？\n\n现在用一个具体案例检验整套机制。\n\n假设 EvoAgent 接到一个跨文件 Python 修改任务，连续两次生成的补丁都没有通过测试。\n\n## 9.1 故障证据\n\n系统收集到：\n\n- 原始需求与约束；\n- 两次执行的计划版本；\n- 实际模型和提示词版本；\n- 两次使用的上下文包；\n- AST 分析结果；\n- 补丁差异；\n- 测试失败报告；\n- 工具调用与重试记录；\n- 实际资源消耗。\n\n诊断系统发现，两次失败都发生在修改某个接口调用时。\n\n这只是一个线索，还不能确定根因。\n\n## 9.2 提出三个候选假设\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box gap={1}>\n    <row align=\"center\" gap={2}>\n      <badge>H1</badge>\n      **上下文遗漏**\n    </row>\n    <text color=\"secondary\" size=\"sm\">模型没有收到被修改函数的完整调用方约束。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <row align=\"center\" gap={2}>\n      <badge>H2</badge>\n      **规划缺陷**\n    </row>\n    <text color=\"secondary\" size=\"sm\">任务计划没有安排跨文件引用检查，导致修改范围不完整。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <row align=\"center\" gap={2}>\n      <badge>H3</badge>\n      **模型能力限制**\n    </row>\n    <text color=\"secondary\" size=\"sm\">即使提供完整上下文，当前模型仍无法稳定完成该类修改。</text>\n  </box>\n</box>\n\n## 9.3 通过低成本实验区分假设\n\n首先检查实际上下文包。\n\n如果调用方约束确实缺失，就能为 H1 提供直接证据。\n\n然后在隔离评测环境中，保持模型、工具和任务不变，只补充缺失的接口定义，再重新执行。\n\n假设补充接口定义后，相关测试通过。\n\n这会增强 H1 的可信度，但还不能立即证明所有问题都由上下文引起。还需要在其他具有相同特征的案例中验证，确认这不是一次偶然成功。\n\n接下来，系统可能发现跨文件引用检查也有助于减少此类错误。于是针对 H2 设计第二组实验，判断是否需要修改 Planner 的工作流。\n\nH3 则暂时保留，只有当上下文与规划问题得到控制后仍存在失败，才进一步评估模型能力限制。\n\n## 9.4 只修改证据支持的模块\n\n最终，系统可能做出如下决定：\n\n- 在编程专家的特定跨文件修改策略中补充接口约束；\n- 对符合条件的任务增加符号引用检查；\n- 暂时不修改全局通用提示词；\n- 暂时不升级所有编程任务使用的模型；\n- 为跨文件修改增加对应评测集；\n- 观察新策略是否同时改善成功率与成本。\n\n如果后续发现该问题只发生在一种旧项目结构中，就可以把改进限制在该场景，而不必扩大到所有编程任务。\n\n这个例子体现了我们一直坚持的原则：\n\n**局部问题优先局部诊断，局部修复优先局部验证，只有证据表明问题具有更广泛影响时，才扩大改进范围。**\n\n---\n\n# 十、离线与在线进化：个人电脑断网时怎么办？\n\n结合 EvoAgent 的部署方向，主要运行环境可能是 Android 手机、个人电脑或 Mini PC，服务端并不一定持续在线。\n\n因此，RCAE 不能依赖远程服务器才能诊断和处理故障。\n\n我建议采用本地优先、联网增强的双层设计。\n\n## 10.1 本地即时诊断\n\n设备离线时，仍然可以完成：\n\n- 记录故障事件和执行证据；\n- 识别已知错误类型；\n- 检查状态不一致；\n- 执行确定性诊断规则；\n- 使用本地模型生成有限的候选假设；\n- 运行本地可执行的测试；\n- 应用已经批准的恢复策略；\n- 将问题保存为待处理诊断案例。\n\n如果本地没有足够的模型能力或评测资源，系统应当明确标记诊断结果的局限，而不是假装已经完成根因确认。\n\n## 10.2 联网后的增强诊断\n\n联网后，可以进一步：\n\n- 使用更强的模型分析复杂故障；\n- 运行耗时较长的对照实验；\n- 检索外部技术资料；\n- 获取最新模型与工具兼容性信息；\n- 生成更完整的候选修复；\n- 评估跨任务、跨版本的系统性退化。\n\n这些增强能力可以提高诊断深度，但不应改变离线期间已经确认的任务事实。\n\n## 10.3 离线期间的诊断结果如何同步？\n\n建议每个故障案例包含：\n\n- 本地唯一 `incident_id`；\n- 原始事件的时间与序号；\n- 相关任务和配置版本；\n- 证据引用与完整性校验信息；\n- 当前诊断状态；\n- 已执行的恢复动作；\n- 是否需要联网进一步验证。\n\n重新连接后，系统按事件 ID 和版本进行同步，避免重复提交同一个故障案例。\n\n如果本地诊断期间已经修复了问题，联网后的增强诊断应当基于当时的历史证据分析，而不是直接把当前配置覆盖回旧版本。\n\n对于离线产生的候选改进，建议默认保存在本地候选区；只有通过相应评测和发布门禁后，才能晋升为稳定配置。\n\n---\n\n# 十一、建议冻结的架构决策\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"ADR-164\",\"现象与根因分离\",\"任务失败、错误输出和质量下降是观察结果，不直接等同于根因。\"],\n    [\"ADR-165\",\"建立统一故障证据链\",\"通过任务、节点、模型、工具、上下文、版本和验收记录关联真实执行过程。\"],\n    [\"ADR-166\",\"根因诊断独立于专家\",\"RCAE 跨模块分析问题，但不接管专家的正常执行职责。\"],\n    [\"ADR-167\",\"根因归因分层\",\"区分单次异常、局部策略缺陷、领域能力缺陷和共享基础设施缺陷。\"],\n    [\"ADR-168\",\"支持多根因与不确定结论\",\"允许多个原因共同作用；证据不足时保留假设，不强行给出唯一答案。\"],\n    [\"ADR-169\",\"相关性不等于因果性\",\"使用可区分假设的诊断实验和适当对照，避免仅凭统计相关性修改系统。\"],\n    [\"ADR-170\",\"改进候选独立评测\",\"每项改进绑定基线、候选版本、评测集、主指标、护栏指标和回滚方案。\"],\n    [\"ADR-171\",\"局部问题优先局部修复\",\"依据证据确定改进作用范围，不将场景特定问题直接推广为通用规则。\"],\n    [\"ADR-172\",\"诊断与发布分权\",\"诊断器可以提出修复建议，但不能仅凭自己的结论直接发布生产改动。\"],\n    [\"ADR-173\",\"诊断器自身接受评测\",\"测试根因准确性、过度判断、错误修复建议、诊断成本与实际改进效果。\"],\n    [\"ADR-174\",\"本地诊断可独立运行\",\"离线时保存证据、运行确定性检查和已批准的恢复策略，联网后再增强诊断。\"],\n    [\"ADR-175\",\"实验与任务事实分离\",\"进化实验失败或模型回滚，不得自动覆盖已经确认的任务状态和真实产物。\"],\n    [\"ADR-176\",\"建立可追溯的改进闭环\",\"每次稳定改进都能追溯其问题证据、诊断假设、实验结果、发布版本与回滚记录。\"]\n  ] as item}\n    <box gap={1}>\n      <row align=\"center\" gap={2}>\n        <badge>{item[0]}</badge>\n        <title size=\"md\">{item[1]}</title>\n      </row>\n      <text color=\"secondary\" size=\"sm\">{item[2]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些决策构成了 EvoAgent 自我诊断与改进实验的建议架构基线。正式实施时，还需要为证据数据结构、诊断假设格式、实验执行协议和发布门禁定义精确的接口。\n\n# 十二、下一专项：记忆进化与经验治理\n\nRCAE 解决了“系统如何知道自己哪里出了问题”，但还有一个直接相关的问题尚未完整解决：\n\n**诊断得到的经验，究竟应该进入哪里，才能让系统真正变得更好，同时不把一次偶然经验误认为通用规律？**\n\n例如，编程专家在一次任务中发现，先分析 AST 再修改代码能够避免错误。\n\n这条经验可能有几种不同的去向：\n\n- 作为当前项目的临时经验；\n- 作为某类代码修改任务的工作流规则；\n- 作为编程专家的长期记忆；\n- 作为特定模型的适配策略；\n- 作为工具契约的改进建议；\n- 作为经过评测的领域通用能力；\n- 或者仅仅保留为一个尚未证实的诊断假设。\n\n如果没有严格的经验分类与晋升机制，RCAE 即使能够找到问题，也可能把错误结论写入长期记忆，最终让系统越进化越混乱。\n\n下一专项建议定义为：\n\n**Memory Evolution & Experience Governance Engine（记忆进化与经验治理引擎，简称 MEEG）。**\n\n重点研究：\n\n1. 如何区分事实、用户偏好、任务状态、执行经验、诊断假设和稳定规则；\n2. 如何决定一条经验应该进入哪个专家、哪个记忆空间或哪个工作流；\n3. 如何从单次成功和失败中提取候选经验，而不是直接生成通用规则；\n4. 如何通过重复案例、反例和评测决定经验是否值得晋升；\n5. 如何判断一条旧经验已经过时、不再适用或与新规则冲突；\n6. 如何处理通用记忆、领域记忆、用户记忆和任务记忆之间的优先级；\n7. 如何避免模型生成的错误结论污染长期记忆；\n8. 如何让经验被检索时同时考虑适用范围、可信程度、版本和时效性；\n9. 如何将有效经验转化为提示词、上下文策略、工作流或工具改进，而不是全部堆进记忆；\n10. 如何撤回错误经验，并确保撤回后不会继续通过缓存、摘要或其他引用影响执行。\n\n这一步与前面的 RCAE 形成闭环：\n\n**执行产生证据 → RCAE 分析问题 → 实验验证改进 → MEEG 管理经验 → 进化治理发布规则 → 新版本在后续任务中接受验证。**\n\n我建议下一轮重点讨论一个核心问题：**什么样的经验才有资格成为 EvoAgent 的长期能力，以及如何防止经验从一次局部有效，错误地升级成所有场景都必须遵守的规则。**"]},"status":"finished_successfully","end_turn":true,"weight":1.0,"metadata":{"is_merged_message":true,"source_message_ids":["0657ab4f-2da6-4a2a-bd56-5d3