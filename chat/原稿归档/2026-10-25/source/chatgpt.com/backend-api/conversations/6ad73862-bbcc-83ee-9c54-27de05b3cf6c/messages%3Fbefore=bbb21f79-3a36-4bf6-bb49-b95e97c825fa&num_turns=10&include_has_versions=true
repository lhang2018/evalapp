(\"text\",null,__dilConstants[\"445\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"446\"])),__dil.jsx(\"text\",null,__dilConstants[\"447\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第三十六专项：自进化闭环与改进因果归因","1":"这一轮进入 EvoAgent 的核心中的核心：","2":"系统如何发现自己的问题，选择正确的改进对象，证明改进有效，并在改进失败时安全回退。","3":"你最初提出的目标，不只是让智能体能够做更多事情，而是让它能够分析自己在执行过程中暴露的问题，持续提升执行质量、效率和稳定性。","4":"前面已经设计了：","5":"多专家与动态任务 DAG；","6":"ReAct、Planner 和工具运行时；","7":"记忆、上下文与模型路由；","8":"RCAE 根因分析；","9":"EQEAG 独立评测；","10":"ODERI 运行证据；","11":"L3RG 故障恢复；","12":"SBAAG 安全授权；","13":"MACTDG 多专家协作治理。","14":"现在要把这些能力组合成真正可靠的自进化闭环。","15":"本专项建议定义为：","16":"Self-Evolution Loop & Causal Improvement Attribution，简称 SELCIA。","17":"它负责问题发现、改进假设、候选生成、实验设计、因果归因、发布决策、效果监测和回滚。","18":"一、第一性原理：系统不能因为自己认为变好了，就认定自己真的变好了","19":"假设 EvoAgent 发现，编程专家最近的任务成功率从 80% 降到了 65%。","20":"它可能提出以下解释：","21":"路由选错了专家；","22":"上下文压缩丢失了关键约束；","23":"模型版本变化导致代码生成质量下降；","24":"工具接口发生了变化；","25":"Planner 的任务分解方式不适合近期任务；","26":"最近的任务本身更复杂；","27":"测试环境出现了故障。","28":"如果系统直接修改 Planner，随后恰好有一批简单任务执行成功，它可能误以为改进有效。","29":"这会形成一个危险的循环：","30":"发现异常 → 猜测原因 → 修改系统 → 偶然成功 → 宣布进化成功。","31":"真正的自进化必须建立在更严格的流程上：","32":"这八个阶段构成自进化的主闭环，但不要求每个问题都启动完整流程。低风险、确定性很强的问题可以使用轻量验证；涉及共享内核、安全边界或广泛影响的改动则必须接受更严格的评测。","33":"二、首先要解决一个根本问题：究竟什么叫“变好”？","34":"如果 EvoAgent 只追求任务成功率，就可能通过无限重试、调用更贵的模型、增加专家数量或放宽验收标准来提高成功率。","35":"如果只追求速度，又可能跳过必要验证。","36":"如果只追求成本，则可能使用能力不足的模型，导致后续返工更多。","37":"因此，进化系统不能依赖一个孤立的指标。","38":"2.1 建立多维质量模型","39":"建议至少同时评估以下维度。","40":"维度","41":"核心问题","42":"任务质量","43":"最终产物是否满足用户目标与验收标准？","44":"成功率","45":"同类任务中有多少真正完成？","46":"效率","47":"完成任务需要多少时间和交互步骤？","48":"成本","49":"每个合格交付物消耗多少模型、工具和外部服务资源？","50":"稳定性","51":"不同任务、输入变化和故障条件下表现是否稳定？","52":"恢复能力","53":"失败后能否正确恢复，是否丢失成果或重复副作用？","54":"安全性","55":"是否遵守权限、隐私和副作用边界？","56":"可维护性","57":"生成的代码、工作流和配置是否容易理解、测试与继续修改？","58":"不同任务需要不同的权重。","59":"例如，编程任务可能重视正确性、测试通过率和可维护性；视频生成任务可能重视画面质量、角色一致性、时长与成本；普通聊天任务则可能更重视相关性、准确性和用户体验。","60":"全局系统可以共享评测框架，但不能强迫所有专家使用完全相同的质量目标。","61":"2.2 区分硬约束和优化目标","62":"建议将指标分成两类。","63":"硬约束：","64":" 不允许为了其他指标的提升而突破，例如安全授权、关键正确性门槛、预算上限和必须满足的交付要求。","65":"优化目标：","66":" 在硬约束满足的前提下继续改善，例如成本、耗时、返工率和额外质量收益。","67":"因此，某候选版本即使速度提高 30%，如果未授权操作风险增加，也不能被视为有效进化。","68":"对于无法简单转换成同一单位的指标，不要直接把它们粗暴相加。应当使用明确的优先级、约束门槛和多目标比较机制。","69":"三、问题发现：不要把所有失败都当成进化机会","70":"EvoAgent 每天可能产生大量失败、重试、超时和用户修改请求。如果每出现一次失败就启动自进化，系统会消耗大量资源，还可能不断修改原本正常的模块。","71":"因此，需要建立问题分级与进化触发机制。","72":"3.1 将问题分为五类","73":"这五类问题需要不同的处理路径。","74":"偶发故障优先由 L3RG 和任务恢复机制处理；重复性缺陷交给 RCAE 分析；持续质量退化由 SHCRG 发现并结合 ODERI 证据定位；能力缺口则进入候选能力设计流程。","75":"不能让自进化控制器成为所有异常的默认处理器。","76":"3.2 建立问题价值评分","77":"可以为候选问题计算一个优先级：","78":"P_{\\text{issue}}\n=\nf(F,I,C,R,E)","79":"其中：","80":"F","81":"：发生频率；","82":"I","83":"：对任务结果的影响；","84":"C","85":"：累计成本；","86":"R","87":"：风险严重性；","88":"E","89":"：现有证据的充分程度。","90":"这里的 ","91":"f","92":" 是待设计的评分策略，不应该直接假设所有因素都能用一个简单公式准确衡量。","93":"例如，一个发生次数不多、但可能导致未授权外部操作的问题，优先级仍然应当很高；一个频繁出现、但只影响非必要日志格式的小问题，则可以降低优先级。","94":"3.3 发现问题后先查已有解决方案","95":"系统应当先检查：","96":"是否已有经过验证的恢复策略；","97":"是否已有相同问题的诊断记录；","98":"是否有可以复用的工作流；","99":"是否是已知工具故障；","100":"是否已有针对该问题的候选修复；","101":"是否只是环境或输入发生变化。","102":"如果已有可靠方案，就不应该为了体现自进化而重新发明一次。","103":"四、根因分析：建立可证伪的假设，而不是寻找一个看起来合理的解释","104":"这是整个进化闭环最关键的环节之一。","105":"假设近期代码任务的失败率增加。RCAE 应当建立一组候选假设，而不是立即指定一个模块负责修复。","106":"例如：","107":"假设","108":"支持证据","109":"需要的验证","110":"H1：路由错误","111":"失败任务集中在不熟悉的项目类型","112":"比较不同专家在同一批任务上的结果","113":"H2：上下文丢失","114":"失败任务中出现遗漏的项目约束","115":"检查构建后的上下文与原始约束","116":"H3：工具版本退化","117":"错误开始时间与工具升级接近","118":"对照旧版和新版工具","119":"H4：任务难度上升","120":"最近任务包含更多文件与依赖","121":"按难度和任务类型分层比较","122":"H5：验收环境异常","123":"多种专家都在同一测试环境失败","124":"使用独立环境重跑测试","125":"这些假设可能同时成立，也可能全部不成立。","126":"4.1 必须区分相关性与因果关系","127":"例如，失败率上升的同时，模型版本也发生了变化。","128":"这只能说明两者在时间上相关，不能直接证明模型升级导致了失败。","129":"还可能存在其他变化：","130":"任务难度同时增加；","131":"工具版本也发生了变化；","132":"验收标准更加严格；","133":"样本构成发生了变化。","134":"如果这些因素没有得到控制，系统就可能把错误归因于模型，并修改路由策略，结果反而让系统变差。","135":"4.2 为每个假设定义反证条件","136":"一个好的诊断假设不仅要解释当前现象，还应该说明什么证据会让它被否定。","137":"例如：","138":"假设：上下文压缩策略导致代码约束丢失。","139":"支持证据可能是失败任务的关键约束在压缩后消失。","140":"反证条件可以是：在同样的任务输入下，完整上下文与压缩上下文均保留了相关约束，并且错误在两种条件下都同样发生。","141":"这会迫使系统通过证据更新判断，而不是不断寻找支持自己最初结论的信息。","142":"4.3 诊断置信度必须与证据强度相匹配","143":"建议为诊断记录：","144":"当前最可能的解释；","145":"备选解释；","146":"每个解释的支持证据；","147":"反证与缺失证据；","148":"已执行的验证；","149":"尚未验证的部分；","150":"下一步最有价值的实验。","151":"系统可以给出概率或置信等级，但不应仅凭语言模型自我评估的信心，就认为根因已经得到证明。","152":"五、改进对象选择：到底应该修改哪个模块？","153":"EvoAgent 是一个分层系统。同一个表面问题，可能由不同层级的缺陷引起。","154":"建议建立统一的改进对象分类。","155":"改进对象","156":"典型问题","157":"可能的候选改进","158":"Router","159":"专家选择错误","160":"路由特征、分类规则、置信度门槛","161":"Planner","162":"计划不完整或分解不合理","163":"规划策略、依赖分析、停止条件","164":"ReAct 策略","165":"反复尝试、缺乏进展","166":"行动选择、观察策略、退出条件","167":"专家能力包","168":"特定领域表现差","169":"领域规则、专用算法、专业工具","170":"上下文系统","171":"关键约束遗漏","172":"检索、压缩、排序、信息保留策略","173":"模型路由","174":"模型不适合任务","175":"能力匹配、成本策略、回退机制","176":"工具运行时","177":"调用失败或结果不可靠","178":"接口适配、超时、幂等、结果核验","179":"工作流","180":"重复步骤、依赖错误","181":"DAG 模板、并行策略、局部重规划","182":"记忆与经验","183":"错误经验重复影响决策","184":"记忆验证、过期策略、冲突处理","185":"共享内核","186":"多领域都出现相同问题","187":"公共契约、状态管理、通用执行策略","188":"改进对象选择的基本原则是：","189":"修复能够解释问题的最小充分范围，不要因为一个局部缺陷就修改整个通用内核。","190":"例如，如果错误只发生在代码专家的 AST 重构能力上，优先调整代码能力包，而不是修改所有专家共用的上下文压缩策略。","191":"但如果相同的上下文遗漏在多个领域专家中反复出现，就值得进一步检查共享上下文系统。","192":"5.1 建立改进影响图","193":"建议将模块依赖关系扩展为一张“改进影响图”。","194":"例如：","195":"修改 Router，可能影响所有依赖该路由的专家；","196":"修改共享上下文压缩策略，可能影响所有专家的输入质量；","197":"修改代码专家，只影响相关代码任务；","198":"修改工具运行时，可能影响所有调用该工具的工作流；","199":"修改授权门禁，可能影响所有具有副作用的操作。","200":"候选改进的评测范围应由影响图决定，而不是只测试触发问题的那一个案例。","201":"5.2 区分局部改进与共享内核改进","202":"建议为改进范围设置四个层级：","203":"L1：任务级修复","204":"——只修复当前任务或当前产物；","205":"L2：专家级改进","206":"——只改变某个领域专家的策略或能力；","207":"L3：共享能力改进","208":"——改变模型路由、上下文、工具或公共执行机制；","209":"L4：系统根规则改进","210":"——涉及权限根规则、核心状态语义或整体安全边界。","211":"L1 和 L2 可以拥有相对快速的验证流程；L3 需要更广泛的回归测试；L4 不能被普通的自动进化流程直接修改，必须进入独立的架构与安全治理流程。","212":"这样可以避免一个专家的问题污染整个系统，也可以降低共享内核变更的风险。","213":"六、实验设计：如何证明改进真的有效？","214":"这是本专项最重要的技术问题。","215":"系统需要区分：","216":"改进前后的表现是否不同；","217":"这种差异是否由候选改动造成；","218":"这种提升能否推广到目标任务范围；","219":"提升是否伴随着其他维度的退化。","220":"仅仅运行一次改进前的任务和一次改进后的任务，通常不足以得出可靠结论。","221":"6.1 建立不可变的基线","222":"每次改进实验开始前，应记录：","223":"稳定版本；","224":"候选版本；","225":"测试数据集版本；","226":"任务类型与难度；","227":"模型与工具版本；","228":"运行配置；","229":"验收标准；","230":"成本和时间限制；","231":"安全与权限约束；","232":"评测结果的计算方式。","233":"测试集和验收规则不能因为候选版本表现不佳，就临时修改成更容易通过的形式。","234":"否则，系统可能通过降低标准制造出虚假的提升。","235":"6.2 优先使用配对对照","236":"假设要测试新的代码规划策略。","237":"可以选择一组代表性的代码任务，让稳定版本和候选版本在尽可能一致的条件下运行，再比较结果。","238":"A · 稳定版本","239":"相同任务、相同验收规则、受控运行条件。","240":"B · 候选版本","241":"相同任务、相同验收规则、只改变目标改进因素。","242":"对比结果","243":"质量、成功率、耗时、成本、重试次数、稳定性与安全约束。","244":"配对测试的优势在于，可以减少任务难度不同造成的偏差。","245":"但也要注意随机性：如果模型生成存在明显波动，可以在适当情况下重复运行，或使用固定种子、确定性工具和可重放输入来减少噪声。并非所有外部模型或生成服务都支持完全可重复的运行，因此仍需记录无法控制的随机因素。","246":"6.3 采用分层测试，防止总体指标掩盖局部退化","247":"假设新路由策略让所有代码任务的平均成功率提高了 5%，但复杂仓库任务的成功率下降了 20%。","248":"如果只看整体平均值，就可能错误发布。","249":"因此，应按以下维度分层：","250":"任务类别；","251":"难度；","252":"专家；","253":"模型与工具版本；","254":"是否需要多专家协作；","255":"资源条件；","256":"是否涉及外部副作用。","257":"候选改进应当在它声称适用的任务范围内进行评估，而不是只报告一个全局平均数。","258":"七、因果归因：不只知道哪个版本更好，还要知道为什么","259":"实验发现候选版本表现更好，并不意味着我们已经完全理解收益来源。","260":"例如，一个新版本同时修改了：","261":"Router 的专家选择策略；","262":"上下文压缩算法；","263":"Planner 的任务分解方式。","264":"如果最终成功率提高，我们仍然不知道是哪一项修改起作用，也不知道是否有某一项其实降低了质量，只是被其他改动掩盖。","265":"这会给下一轮进化带来问题：系统可能保留无效改动，甚至在其他任务中触发退化。","266":"7.1 默认一次只改变一个主要因素","267":"对于能够独立测试的改进，建议优先使用单因素实验。","268":"例如，先单独测试新的上下文压缩策略；确认收益后，再测试新的 Planner 策略。","269":"这样更容易识别收益来源，也便于失败时回滚。","270":"7.2 多个因素必须一起修改时，使用分阶段实验","271":"有些改进存在强依赖，无法完全拆开。","272":"例如，新版 Planner 只有配合新版工具契约才能正常工作。","273":"这时可以将其作为一个有明确边界的候选组合进行评测，再在后续实验中逐步分离因素。","274":"如果样本量和成本允许，也可以使用析因实验或分阶段消融实验，研究不同因素之间的交互作用。","275":"关键是记录哪些因素同时发生了变化，不能把整个组合的效果武断地归因于其中一个模块。","276":"7.3 关注效果差异，而不只是单个成功率","277":"例如，稳定版本在 100 个测试任务中成功 80 个，候选版本成功 85 个。","278":"观察到的提升是 5 个百分点，但是否足以证明候选版本具有稳定优势，还取决于：","279":"样本代表性；","280":"任务之间的相关性；","281":"运行随机性；","282":"失败类型；","283":"评测指标是否可靠；","284":"额外成本与风险；","285":"统计不确定性。","286":"因此，系统应该保存样本数量、原始结果、差异分布和不确定性，而不是只保留“提升 5%”这样的结论。","287":"7.4 建立证据等级","288":"建议将改进结论分为以下几级：","289":"等级","290":"含义","291":"E0 · 未验证","292":"只有问题观察或改进想法","293":"E1 · 初步证据","294":"有诊断依据或少量测试支持","295":"E2 · 受控验证","296":"在明确的测试条件下完成对照评测","297":"E3 · 稳健验证","298":"在多个代表性场景中重复验证，且关键回归门槛通过","299":"E4 · 运行验证","300":"发布后在实际任务中持续观察到收益，未发现不可接受的退化","301":"这是建议的治理等级，不是概率或统计显著性的直接替代。","302":"对于高风险的共享内核改动，仅达到 E2 可能还不够；对于低风险的局部优化，经过适当的受控验证后，可能就已经具备有限发布资格。","303":"八、候选改进对象：让每次进化都有完整档案","304":"建议建立统一的 ","305":"EvolutionCandidate","306":" 数据对象。","307":"每个候选改进都应当记录：","308":"候选 ID；","309":"问题 ID；","310":"目标模块；","311":"根因假设；","312":"改动范围；","313":"稳定基线版本；","314":"候选版本；","315":"预期收益；","316":"可能的负面影响；","317":"测试范围；","318":"评测结果；","319":"证据等级；","320":"安全与兼容性检查；","321":"发布状态；","322":"回滚条件；","323":"后续监测结果。","324":"例如：","325":"14da09ef-dc33-52d6-8393-bed69ef99356","326":null,"327":"这只是示意结构。正式 Schema 还需要包括实验数据引用、版本哈希、指标计算版本、适用范围和审计信息。","328":"8.1 候选改进不等于正式版本","329":"候选版本必须与稳定版本分离。","330":"它可以运行在独立测试环境、候选配置空间或受控实验任务中，但不能在尚未获得发布资格时，直接覆盖正式专家策略。","331":"尤其是涉及共享内核、任务状态、授权、安全根规则和恢复机制的改动，需要更加严格的隔离与验证。","332":"九、发布治理：改进有效，不代表可以立即全量上线","333":"候选版本通过实验后，还需要判断它是否适合真实任务。","334":"建议建立五级发布流程。","335":"这些是逻辑发布阶段，不要求每种改进都采用完全相同的发布流程。","336":"例如，某个低风险提示词调整可能在通过回归测试后直接发布；而共享上下文策略的变化，需要覆盖多个专家；涉及安全授权或核心状态语义的改动，则不能仅凭普通任务成功率提升就发布。","337":"9.1 采用风险驱动的发布门槛","338":"建议至少检查：","339":"主要质量指标是否达到预设目标；","340":"关键任务类别是否发生明显退化；","341":"成本与耗时是否在可接受范围内；","342":"是否通过安全与权限测试；","343":"是否通过兼容性测试；","344":"是否保留稳定版本和恢复路径；","345":"是否存在尚未解决的关键副作用；","346":"实验数据是否足够支持此次发布。","347":"任何候选版本都不能通过修改验收规则来绕过发布门槛。","348":"9.2 回滚条件必须在发布前定义","349":"例如：","350":"关键验收通过率低于最低门槛；","351":"未授权操作或数据完整性风险出现；","352":"单位合格任务成本持续超过预算；","353":"某类任务出现显著退化；","354":"错误率或无进展循环超过限制；","355":"运行环境无法兼容当前版本。","356":"具体阈值应根据任务类别和风险等级确定，而不是对所有模块采用同一个固定数字。","357":"回滚后还应记录：","358":"哪个候选版本被撤回；","359":"触发了什么条件；","360":"受影响的任务有哪些；","361":"哪些产物需要重新验收；","362":"是否需要进一步根因分析；","363":"原候选是否允许在修复后重新进入评测。","364":"十、避免自进化中的几个危险陷阱","365":"真正的自进化系统不仅要能优化，还必须避免优化机制本身产生系统性偏差。","366":"10.1 指标投机","367":"如果只奖励任务成功率，系统可能无限重试；如果只奖励速度，可能跳过验证；如果只奖励低成本，可能选择不合适的模型。","368":"应当通过硬约束、多个质量指标和独立验收，防止系统利用指标漏洞。","369":"10.2 评测集过拟合","370":"如果候选策略反复针对同一组测试案例优化，最终可能只会解决这些案例，而无法泛化到真实任务。","371":"建议区分：","372":"开发测试集；","373":"验证测试集；","374":"保留的最终评测集；","375":"实际运行监测数据。","376":"对重要改进，最终评测集不应被无限次用于调参，否则其独立验证价值会下降。","377":"10.3 多个改动同时发布","378":"如果同时更新模型、上下文、路由和 Planner，就很难判断出现退化时应回滚哪一项。","379":"应尽量保持候选改动范围明确，必要时将强依赖改动组合成一个可整体回滚的发布单元。","380":"10.4 诊断与执行互相证明","381":"如果 RCAE 提出某项修复，候选生成器实施修复，评测系统又直接采纳 RCAE 自己的解释作为成功证据，就容易形成自我强化。","382":"因此，根因假设与改进方案可以来自同一条诊断链，但评测结果必须基于独立的验收标准和真实运行证据。","383":"10.5 过度进化","384":"系统不应该因为可以优化，就不断修改已经稳定的模块。","385":"每项改进都应考虑预期收益、实施成本、回归风险与维护成本。","386":"有时最好的决定是保留稳定版本，继续积累证据，而不是立刻生成新候选。","387":"十一、让诊断能力与执行能力保持分离","388":"这是你之前特别关注的问题：如果诊断和执行耦合在一起，当系统判断错误时，怎么知道究竟是诊断出了问题，还是执行能力出了问题？","389":"SELCIA 建议从架构上明确分离三个角色。","390":"RCAE · 诊断与根因分析","391":"分析运行证据，提出根因假设、反证条件与验证建议。它不直接修改正式系统。","392":"Evolution Controller · 进化控制器","393":"选择改进目标，管理候选版本、实验预算、发布资格与回滚。它不自行宣布候选有效。","394":"EQEAG · 独立评测","395":"依据预先定义的测试集、验收规则和安全门槛，判断候选改进是否达到发布要求。","396":"这三者共同使用 ODERI 的运行证据，但具有不同的职责。","397":"11.1 分别评测诊断能力与执行能力","398":"建议至少建立两组独立评测。","399":"诊断能力评测：","400":"能否识别真正的失败现象；","401":"能否提出合理的候选原因；","402":"能否区分事实与推测；","403":"能否找到反证；","404":"能否提出有效的验证实验；","405":"能否在证据不足时承认不确定性。","406":"执行能力评测：","407":"能否正确实施候选修复；","408":"能否通过功能和回归测试；","409":"能否遵守权限与预算；","410":"能否在失败时正确恢复；","411":"能否保持其他任务类别的表现。","412":"如果诊断正确，但修复实施错误，应该改进执行能力；如果修复实施完全符合方案，却没有解决问题，则需要重新审视根因假设；如果修复有效，但破坏了其他专家，则说明影响范围或回归评测不足。","413":"这样，系统才不会把所有失败都归咎于同一个模块。","414":"十二、建议冻结的架构决策","415":"以下是建议纳入 EvoAgent 全量架构的自进化治理基线。","416":"这些是建议纳入 EvoAgent 全量架构的自进化基线。正式实施时，还需要定义问题对象 Schema、根因假设格式、候选改进格式、实验记录、因果评测协议、发布门槛和回滚接口。","417":"十三、下一专项：能力学习、经验沉淀与长期知识演化","418":"SELCIA 解决了“如何发现问题并证明改进有效”。","419":"但还有一个问题没有完全解决：","420":"当 EvoAgent 在一次任务中学到了有价值的东西，如何判断它应该被保存在哪里、适用于哪些场景，以及何时可以成为系统长期能力的一部分？","421":"例如，EvoAgent 完成了一次复杂代码重构，发现 AST 分析结合测试验证比直接文本替换更可靠。","422":"这条经验可能有四种不同的去向：","423":"保存为当前项目的经验；","424":"沉淀为代码专家的领域知识；","425":"形成可复用的代码重构工作流；","426":"最终转化为通用工具或正式能力。","427":"它们的作用范围、验证要求和失效条件都不同。","428":"如果系统把每次成功经验都直接写入通用记忆，就会导致知识污染；如果什么都不沉淀，则每次任务都可能重复探索；如果只记录成功而不记录失败条件，还可能把偶然成功的策略推广到不适合的场景。","429":"因此，下一专项建议定义为：","430":"Capability Learning, Experience Consolidation & Long-Term Knowledge Evolution，简称 CLEK。","431":"重点研究：","432":"如何区分事实、用户偏好、任务经验、工作流与正式能力；","433":"如何判断一条经验是否具有长期价值；","434":"如何确定经验应该属于当前任务、当前项目、某个专家还是共享内核；","435":"如何记录经验的适用条件、证据来源和失效条件；","436":"如何防止错误经验、偶然成功和过时知识进入长期记忆；","437":"如何将重复经验逐渐转化为结构化规则、工作流或工具；","438":"如何处理不同专家之间的经验冲突；","439":"如何检测旧经验是否仍然有效；","440":"如何让新经验影响后续任务，同时避免改变正在执行的任务；","441":"如何通过评测决定经验升级、降级、废弃或回滚；","442":"如何区分用户个人偏好与对所有用户或所有任务都成立的通用规律；","443":"如何让记忆、上下文、工作流和正式能力之间形成清晰的晋升与退役机制。","444":"这一专项将进一步连接 MEEG、CERG、MACTDG、SELCIA 和独立进化控制器。","445":"它的核心目标是：","446":"让 EvoAgent 不只是积累越来越多的信息，而是逐渐形成越来越可靠、适用范围越来越清晰、能够被验证和更新的长期能力。","447":"下一轮将从第一性原理开始，研究“经验如何从一次任务中的观察，逐步变成经过验证、可复用、可退役的系统能力”，并明确哪些内容可以自动沉淀，哪些必须经过独立评测。"},"fallbackMarkdown":"# EvoAgent 第三十六专项：自进化闭环与改进因果归因\n\n这一轮进入 EvoAgent 的核心中的核心：**系统如何发现自己的问题，选择正确的改进对象，证明改进有效，并在改进失败时安全回退。**\n\n你最初提出的目标，不只是让智能体能够做更多事情，而是让它能够分析自己在执行过程中暴露的问题，持续提升执行质量、效率和稳定性。\n\n前面已经设计了：\n\n- 多专家与动态任务 DAG；\n- ReAct、Planner 和工具运行时；\n- 记忆、上下文与模型路由；\n- RCAE 根因分析；\n- EQEAG 独立评测；\n- ODERI 运行证据；\n- L3RG 故障恢复；\n- SBAAG 安全授权；\n- MACTDG 多专家协作治理。\n\n现在要把这些能力组合成真正可靠的自进化闭环。\n\n本专项建议定义为：\n\n**Self-Evolution Loop &amp; Causal Improvement Attribution，简称 SELCIA。**\n\n它负责问题发现、改进假设、候选生成、实验设计、因果归因、发布决策、效果监测和回滚。\n\n## 一、第一性原理：系统不能因为自己认为变好了，就认定自己真的变好了\n\n假设 EvoAgent 发现，编程专家最近的任务成功率从 80% 降到了 65%。\n\n它可能提出以下解释：\n\n- 路由选错了专家；\n- 上下文压缩丢失了关键约束；\n- 模型版本变化导致代码生成质量下降；\n- 工具接口发生了变化；\n- Planner 的任务分解方式不适合近期任务；\n- 最近的任务本身更复杂；\n- 测试环境出现了故障。\n\n如果系统直接修改 Planner，随后恰好有一批简单任务执行成功，它可能误以为改进有效。\n\n这会形成一个危险的循环：\n\n发现异常 → 猜测原因 → 修改系统 → 偶然成功 → 宣布进化成功。\n\n真正的自进化必须建立在更严格的流程上：\n\n这八个阶段构成自进化的主闭环，但不要求每个问题都启动完整流程。低风险、确定性很强的问题可以使用轻量验证；涉及共享内核、安全边界或广泛影响的改动则必须接受更严格的评测。\n\n---\n\n# 二、首先要解决一个根本问题：究竟什么叫“变好”？\n\n如果 EvoAgent 只追求任务成功率，就可能通过无限重试、调用更贵的模型、增加专家数量或放宽验收标准来提高成功率。\n\n如果只追求速度，又可能跳过必要验证。\n\n如果只追求成本，则可能使用能力不足的模型，导致后续返工更多。\n\n因此，进化系统不能依赖一个孤立的指标。\n\n## 2.1 建立多维质量模型\n\n建议至少同时评估以下维度。\n\n| 维度 | 核心问题 |\n|--------|--------|\n| 任务质量 | 最终产物是否满足用户目标与验收标准？ |\n| 成功率 | 同类任务中有多少真正完成？ |\n| 效率 | 完成任务需要多少时间和交互步骤？ |\n| 成本 | 每个合格交付物消耗多少模型、工具和外部服务资源？ |\n| 稳定性 | 不同任务、输入变化和故障条件下表现是否稳定？ |\n| 恢复能力 | 失败后能否正确恢复，是否丢失成果或重复副作用？ |\n| 安全性 | 是否遵守权限、隐私和副作用边界？ |\n| 可维护性 | 生成的代码、工作流和配置是否容易理解、测试与继续修改？ |\n\n不同任务需要不同的权重。\n\n例如，编程任务可能重视正确性、测试通过率和可维护性；视频生成任务可能重视画面质量、角色一致性、时长与成本；普通聊天任务则可能更重视相关性、准确性和用户体验。\n\n**全局系统可以共享评测框架，但不能强迫所有专家使用完全相同的质量目标。**\n\n## 2.2 区分硬约束和优化目标\n\n建议将指标分成两类。\n\n**硬约束：** 不允许为了其他指标的提升而突破，例如安全授权、关键正确性门槛、预算上限和必须满足的交付要求。\n\n**优化目标：** 在硬约束满足的前提下继续改善，例如成本、耗时、返工率和额外质量收益。\n\n因此，某候选版本即使速度提高 30%，如果未授权操作风险增加，也不能被视为有效进化。\n\n对于无法简单转换成同一单位的指标，不要直接把它们粗暴相加。应当使用明确的优先级、约束门槛和多目标比较机制。\n\n---\n\n# 三、问题发现：不要把所有失败都当成进化机会\n\nEvoAgent 每天可能产生大量失败、重试、超时和用户修改请求。如果每出现一次失败就启动自进化，系统会消耗大量资源，还可能不断修改原本正常的模块。\n\n因此，需要建立问题分级与进化触发机制。\n\n## 3.1 将问题分为五类\n\n这五类问题需要不同的处理路径。\n\n偶发故障优先由 L3RG 和任务恢复机制处理；重复性缺陷交给 RCAE 分析；持续质量退化由 SHCRG 发现并结合 ODERI 证据定位；能力缺口则进入候选能力设计流程。\n\n不能让自进化控制器成为所有异常的默认处理器。\n\n## 3.2 建立问题价值评分\n\n可以为候选问题计算一个优先级：\n\n\\[\nP_{\\text{issue}}\n=\nf(F,I,C,R,E)\n\\]\n\n其中：\n\n- \\(F\\)：发生频率；\n- \\(I\\)：对任务结果的影响；\n- \\(C\\)：累计成本；\n- \\(R\\)：风险严重性；\n- \\(E\\)：现有证据的充分程度。\n\n这里的 \\(f\\) 是待设计的评分策略，不应该直接假设所有因素都能用一个简单公式准确衡量。\n\n例如，一个发生次数不多、但可能导致未授权外部操作的问题，优先级仍然应当很高；一个频繁出现、但只影响非必要日志格式的小问题，则可以降低优先级。\n\n## 3.3 发现问题后先查已有解决方案\n\n系统应当先检查：\n\n- 是否已有经过验证的恢复策略；\n- 是否已有相同问题的诊断记录；\n- 是否有可以复用的工作流；\n- 是否是已知工具故障；\n- 是否已有针对该问题的候选修复；\n- 是否只是环境或输入发生变化。\n\n如果已有可靠方案，就不应该为了体现自进化而重新发明一次。\n\n---\n\n# 四、根因分析：建立可证伪的假设，而不是寻找一个看起来合理的解释\n\n这是整个进化闭环最关键的环节之一。\n\n假设近期代码任务的失败率增加。RCAE 应当建立一组候选假设，而不是立即指定一个模块负责修复。\n\n例如：\n\n| 假设 | 支持证据 | 需要的验证 |\n|--------|--------|--------|\n| H1：路由错误 | 失败任务集中在不熟悉的项目类型 | 比较不同专家在同一批任务上的结果 |\n| H2：上下文丢失 | 失败任务中出现遗漏的项目约束 | 检查构建后的上下文与原始约束 |\n| H3：工具版本退化 | 错误开始时间与工具升级接近 | 对照旧版和新版工具 |\n| H4：任务难度上升 | 最近任务包含更多文件与依赖 | 按难度和任务类型分层比较 |\n| H5：验收环境异常 | 多种专家都在同一测试环境失败 | 使用独立环境重跑测试 |\n\n这些假设可能同时成立，也可能全部不成立。\n\n## 4.1 必须区分相关性与因果关系\n\n例如，失败率上升的同时，模型版本也发生了变化。\n\n这只能说明两者在时间上相关，不能直接证明模型升级导致了失败。\n\n还可能存在其他变化：\n\n- 任务难度同时增加；\n- 工具版本也发生了变化；\n- 验收标准更加严格；\n- 样本构成发生了变化。\n\n如果这些因素没有得到控制，系统就可能把错误归因于模型，并修改路由策略，结果反而让系统变差。\n\n## 4.2 为每个假设定义反证条件\n\n一个好的诊断假设不仅要解释当前现象，还应该说明什么证据会让它被否定。\n\n例如：\n\n> 假设：上下文压缩策略导致代码约束丢失。\n\n支持证据可能是失败任务的关键约束在压缩后消失。\n\n反证条件可以是：在同样的任务输入下，完整上下文与压缩上下文均保留了相关约束，并且错误在两种条件下都同样发生。\n\n这会迫使系统通过证据更新判断，而不是不断寻找支持自己最初结论的信息。\n\n## 4.3 诊断置信度必须与证据强度相匹配\n\n建议为诊断记录：\n\n- 当前最可能的解释；\n- 备选解释；\n- 每个解释的支持证据；\n- 反证与缺失证据；\n- 已执行的验证；\n- 尚未验证的部分；\n- 下一步最有价值的实验。\n\n系统可以给出概率或置信等级，但不应仅凭语言模型自我评估的信心，就认为根因已经得到证明。\n\n---\n\n# 五、改进对象选择：到底应该修改哪个模块？\n\nEvoAgent 是一个分层系统。同一个表面问题，可能由不同层级的缺陷引起。\n\n建议建立统一的改进对象分类。\n\n| 改进对象 | 典型问题 | 可能的候选改进 |\n|--------|--------|--------|\n| Router | 专家选择错误 | 路由特征、分类规则、置信度门槛 |\n| Planner | 计划不完整或分解不合理 | 规划策略、依赖分析、停止条件 |\n| ReAct 策略 | 反复尝试、缺乏进展 | 行动选择、观察策略、退出条件 |\n| 专家能力包 | 特定领域表现差 | 领域规则、专用算法、专业工具 |\n| 上下文系统 | 关键约束遗漏 | 检索、压缩、排序、信息保留策略 |\n| 模型路由 | 模型不适合任务 | 能力匹配、成本策略、回退机制 |\n| 工具运行时 | 调用失败或结果不可靠 | 接口适配、超时、幂等、结果核验 |\n| 工作流 | 重复步骤、依赖错误 | DAG 模板、并行策略、局部重规划 |\n| 记忆与经验 | 错误经验重复影响决策 | 记忆验证、过期策略、冲突处理 |\n| 共享内核 | 多领域都出现相同问题 | 公共契约、状态管理、通用执行策略 |\n\n改进对象选择的基本原则是：\n\n**修复能够解释问题的最小充分范围，不要因为一个局部缺陷就修改整个通用内核。**\n\n例如，如果错误只发生在代码专家的 AST 重构能力上，优先调整代码能力包，而不是修改所有专家共用的上下文压缩策略。\n\n但如果相同的上下文遗漏在多个领域专家中反复出现，就值得进一步检查共享上下文系统。\n\n## 5.1 建立改进影响图\n\n建议将模块依赖关系扩展为一张“改进影响图”。\n\n例如：\n\n- 修改 Router，可能影响所有依赖该路由的专家；\n- 修改共享上下文压缩策略，可能影响所有专家的输入质量；\n- 修改代码专家，只影响相关代码任务；\n- 修改工具运行时，可能影响所有调用该工具的工作流；\n- 修改授权门禁，可能影响所有具有副作用的操作。\n\n候选改进的评测范围应由影响图决定，而不是只测试触发问题的那一个案例。\n\n## 5.2 区分局部改进与共享内核改进\n\n建议为改进范围设置四个层级：\n\n- **L1：任务级修复**——只修复当前任务或当前产物；\n- **L2：专家级改进**——只改变某个领域专家的策略或能力；\n- **L3：共享能力改进**——改变模型路由、上下文、工具或公共执行机制；\n- **L4：系统根规则改进**——涉及权限根规则、核心状态语义或整体安全边界。\n\nL1 和 L2 可以拥有相对快速的验证流程；L3 需要更广泛的回归测试；L4 不能被普通的自动进化流程直接修改，必须进入独立的架构与安全治理流程。\n\n这样可以避免一个专家的问题污染整个系统，也可以降低共享内核变更的风险。\n\n---\n\n# 六、实验设计：如何证明改进真的有效？\n\n这是本专项最重要的技术问题。\n\n系统需要区分：\n\n1. 改进前后的表现是否不同；\n2. 这种差异是否由候选改动造成；\n3. 这种提升能否推广到目标任务范围；\n4. 提升是否伴随着其他维度的退化。\n\n仅仅运行一次改进前的任务和一次改进后的任务，通常不足以得出可靠结论。\n\n## 6.1 建立不可变的基线\n\n每次改进实验开始前，应记录：\n\n- 稳定版本；\n- 候选版本；\n- 测试数据集版本；\n- 任务类型与难度；\n- 模型与工具版本；\n- 运行配置；\n- 验收标准；\n- 成本和时间限制；\n- 安全与权限约束；\n- 评测结果的计算方式。\n\n测试集和验收规则不能因为候选版本表现不佳，就临时修改成更容易通过的形式。\n\n否则，系统可能通过降低标准制造出虚假的提升。\n\n## 6.2 优先使用配对对照\n\n假设要测试新的代码规划策略。\n\n可以选择一组代表性的代码任务，让稳定版本和候选版本在尽可能一致的条件下运行，再比较结果。\n\n### A · 稳定版本\n\n相同任务、相同验收规则、受控运行条件。\n\n### B · 候选版本\n\n相同任务、相同验收规则、只改变目标改进因素。\n\n---\n\n**对比结果**\n\n质量、成功率、耗时、成本、重试次数、稳定性与安全约束。\n\n配对测试的优势在于，可以减少任务难度不同造成的偏差。\n\n但也要注意随机性：如果模型生成存在明显波动，可以在适当情况下重复运行，或使用固定种子、确定性工具和可重放输入来减少噪声。并非所有外部模型或生成服务都支持完全可重复的运行，因此仍需记录无法控制的随机因素。\n\n## 6.3 采用分层测试，防止总体指标掩盖局部退化\n\n假设新路由策略让所有代码任务的平均成功率提高了 5%，但复杂仓库任务的成功率下降了 20%。\n\n如果只看整体平均值，就可能错误发布。\n\n因此，应按以下维度分层：\n\n- 任务类别；\n- 难度；\n- 专家；\n- 模型与工具版本；\n- 是否需要多专家协作；\n- 资源条件；\n- 是否涉及外部副作用。\n\n候选改进应当在它声称适用的任务范围内进行评估，而不是只报告一个全局平均数。\n\n---\n\n# 七、因果归因：不只知道哪个版本更好，还要知道为什么\n\n实验发现候选版本表现更好，并不意味着我们已经完全理解收益来源。\n\n例如，一个新版本同时修改了：\n\n- Router 的专家选择策略；\n- 上下文压缩算法；\n- Planner 的任务分解方式。\n\n如果最终成功率提高，我们仍然不知道是哪一项修改起作用，也不知道是否有某一项其实降低了质量，只是被其他改动掩盖。\n\n这会给下一轮进化带来问题：系统可能保留无效改动，甚至在其他任务中触发退化。\n\n## 7.1 默认一次只改变一个主要因素\n\n对于能够独立测试的改进，建议优先使用单因素实验。\n\n例如，先单独测试新的上下文压缩策略；确认收益后，再测试新的 Planner 策略。\n\n这样更容易识别收益来源，也便于失败时回滚。\n\n## 7.2 多个因素必须一起修改时，使用分阶段实验\n\n有些改进存在强依赖，无法完全拆开。\n\n例如，新版 Planner 只有配合新版工具契约才能正常工作。\n\n这时可以将其作为一个有明确边界的候选组合进行评测，再在后续实验中逐步分离因素。\n\n如果样本量和成本允许，也可以使用析因实验或分阶段消融实验，研究不同因素之间的交互作用。\n\n关键是记录哪些因素同时发生了变化，不能把整个组合的效果武断地归因于其中一个模块。\n\n## 7.3 关注效果差异，而不只是单个成功率\n\n例如，稳定版本在 100 个测试任务中成功 80 个，候选版本成功 85 个。\n\n观察到的提升是 5 个百分点，但是否足以证明候选版本具有稳定优势，还取决于：\n\n- 样本代表性；\n- 任务之间的相关性；\n- 运行随机性；\n- 失败类型；\n- 评测指标是否可靠；\n- 额外成本与风险；\n- 统计不确定性。\n\n因此，系统应该保存样本数量、原始结果、差异分布和不确定性，而不是只保留“提升 5%”这样的结论。\n\n## 7.4 建立证据等级\n\n建议将改进结论分为以下几级：\n\n| 等级 | 含义 |\n|--------|--------|\n| E0 · 未验证 | 只有问题观察或改进想法 |\n| E1 · 初步证据 | 有诊断依据或少量测试支持 |\n| E2 · 受控验证 | 在明确的测试条件下完成对照评测 |\n| E3 · 稳健验证 | 在多个代表性场景中重复验证，且关键回归门槛通过 |\n| E4 · 运行验证 | 发布后在实际任务中持续观察到收益，未发现不可接受的退化 |\n\n这是建议的治理等级，不是概率或统计显著性的直接替代。\n\n对于高风险的共享内核改动，仅达到 E2 可能还不够；对于低风险的局部优化，经过适当的受控验证后，可能就已经具备有限发布资格。\n\n---\n\n# 八、候选改进对象：让每次进化都有完整档案\n\n建议建立统一的 `EvolutionCandidate` 数据对象。\n\n每个候选改进都应当记录：\n\n- 候选 ID；\n- 问题 ID；\n- 目标模块；\n- 根因假设；\n- 改动范围；\n- 稳定基线版本；\n- 候选版本；\n- 预期收益；\n- 可能的负面影响；\n- 测试范围；\n- 评测结果；\n- 证据等级；\n- 安全与兼容性检查；\n- 发布状态；\n- 回滚条件；\n- 后续监测结果。\n\n例如：\n\n```json\n{\n  \"candidate_id\": \"evo-042\",\n  \"target\": \"context_compression\",\n  \"hypothesis\": \"关键约束在长任务压缩过程中被遗漏\",\n  \"baseline_version\": \"stable-12\",\n  \"candidate_version\": \"candidate-13\",\n  \"expected_benefit\": [\n    \"减少约束遗漏\",\n    \"降低返工率\"\n  ],\n  \"guardrails\": [\n    \"不降低关键验收通过率\",\n    \"不突破上下文预算\",\n    \"不改变权限规则\"\n  ],\n  \"evaluation_status\": \"PENDING\"\n}\n```\n\n这只是示意结构。正式 Schema 还需要包括实验数据引用、版本哈希、指标计算版本、适用范围和审计信息。\n\n## 8.1 候选改进不等于正式版本\n\n候选版本必须与稳定版本分离。\n\n它可以运行在独立测试环境、候选配置空间或受控实验任务中，但不能在尚未获得发布资格时，直接覆盖正式专家策略。\n\n尤其是涉及共享内核、任务状态、授权、安全根规则和恢复机制的改动，需要更加严格的隔离与验证。\n\n---\n\n# 九、发布治理：改进有效，不代表可以立即全量上线\n\n候选版本通过实验后，还需要判断它是否适合真实任务。\n\n建议建立五级发布流程。\n\n这些是逻辑发布阶段，不要求每种改进都采用完全相同的发布流程。\n\n例如，某个低风险提示词调整可能在通过回归测试后直接发布；而共享上下文策略的变化，需要覆盖多个专家；涉及安全授权或核心状态语义的改动，则不能仅凭普通任务成功率提升就发布。\n\n## 9.1 采用风险驱动的发布门槛\n\n建议至少检查：\n\n- 主要质量指标是否达到预设目标；\n- 关键任务类别是否发生明显退化；\n- 成本与耗时是否在可接受范围内；\n- 是否通过安全与权限测试；\n- 是否通过兼容性测试；\n- 是否保留稳定版本和恢复路径；\n- 是否存在尚未解决的关键副作用；\n- 实验数据是否足够支持此次发布。\n\n任何候选版本都不能通过修改验收规则来绕过发布门槛。\n\n## 9.2 回滚条件必须在发布前定义\n\n例如：\n\n- 关键验收通过率低于最低门槛；\n- 未授权操作或数据完整性风险出现；\n- 单位合格任务成本持续超过预算；\n- 某类任务出现显著退化；\n- 错误率或无进展循环超过限制；\n- 运行环境无法兼容当前版本。\n\n具体阈值应根据任务类别和风险等级确定，而不是对所有模块采用同一个固定数字。\n\n回滚后还应记录：\n\n- 哪个候选版本被撤回；\n- 触发了什么条件；\n- 受影响的任务有哪些；\n- 哪些产物需要重新验收；\n- 是否需要进一步根因分析；\n- 原候选是否允许在修复后重新进入评测。\n\n---\n\n# 十、避免自进化中的几个危险陷阱\n\n真正的自进化系统不仅要能优化，还必须避免优化机制本身产生系统性偏差。\n\n## 10.1 指标投机\n\n如果只奖励任务成功率，系统可能无限重试；如果只奖励速度，可能跳过验证；如果只奖励低成本，可能选择不合适的模型。\n\n应当通过硬约束、多个质量指标和独立验收，防止系统利用指标漏洞。\n\n## 10.2 评测集过拟合\n\n如果候选策略反复针对同一组测试案例优化，最终可能只会解决这些案例，而无法泛化到真实任务。\n\n建议区分：\n\n- 开发测试集；\n- 验证测试集；\n- 保留的最终评测集；\n- 实际运行监测数据。\n\n对重要改进，最终评测集不应被无限次用于调参，否则其独立验证价值会下降。\n\n## 10.3 多个改动同时发布\n\n如果同时更新模型、上下文、路由和 Planner，就很难判断出现退化时应回滚哪一项。\n\n应尽量保持候选改动范围明确，必要时将强依赖改动组合成一个可整体回滚的发布单元。\n\n## 10.4 诊断与执行互相证明\n\n如果 RCAE 提出某项修复，候选生成器实施修复，评测系统又直接采纳 RCAE 自己的解释作为成功证据，就容易形成自我强化。\n\n因此，根因假设与改进方案可以来自同一条诊断链，但评测结果必须基于独立的验收标准和真实运行证据。\n\n## 10.5 过度进化\n\n系统不应该因为可以优化，就不断修改已经稳定的模块。\n\n每项改进都应考虑预期收益、实施成本、回归风险与维护成本。\n\n有时最好的决定是保留稳定版本，继续积累证据，而不是立刻生成新候选。\n\n---\n\n# 十一、让诊断能力与执行能力保持分离\n\n这是你之前特别关注的问题：如果诊断和执行耦合在一起，当系统判断错误时，怎么知道究竟是诊断出了问题，还是执行能力出了问题？\n\nSELCIA 建议从架构上明确分离三个角色。\n\n### RCAE · 诊断与根因分析\n\n分析运行证据，提出根因假设、反证条件与验证建议。它不直接修改正式系统。\n\n---\n\n### Evolution Controller · 进化控制器\n\n选择改进目标，管理候选版本、实验预算、发布资格与回滚。它不自行宣布候选有效。\n\n---\n\n### EQEAG · 独立评测\n\n依据预先定义的测试集、验收规则和安全门槛，判断候选改进是否达到发布要求。\n\n这三者共同使用 ODERI 的运行证据，但具有不同的职责。\n\n## 11.1 分别评测诊断能力与执行能力\n\n建议至少建立两组独立评测。\n\n**诊断能力评测：**\n\n- 能否识别真正的失败现象；\n- 能否提出合理的候选原因；\n- 能否区分事实与推测；\n- 能否找到反证；\n- 能否提出有效的验证实验；\n- 能否在证据不足时承认不确定性。\n\n**执行能力评测：**\n\n- 能否正确实施候选修复；\n- 能否通过功能和回归测试；\n- 能否遵守权限与预算；\n- 能否在失败时正确恢复；\n- 能否保持其他任务类别的表现。\n\n如果诊断正确，但修复实施错误，应该改进执行能力；如果修复实施完全符合方案，却没有解决问题，则需要重新审视根因假设；如果修复有效，但破坏了其他专家，则说明影响范围或回归评测不足。\n\n这样，系统才不会把所有失败都归咎于同一个模块。\n\n---\n\n# 十二、建议冻结的架构决策\n\n以下是建议纳入 EvoAgent 全量架构的自进化治理基线。\n\n这些是建议纳入 EvoAgent 全量架构的自进化基线。正式实施时，还需要定义问题对象 Schema、根因假设格式、候选改进格式、实验记录、因果评测协议、发布门槛和回滚接口。\n\n---\n\n# 十三、下一专项：能力学习、经验沉淀与长期知识演化\n\nSELCIA 解决了“如何发现问题并证明改进有效”。\n\n但还有一个问题没有完全解决：\n\n**当 EvoAgent 在一次任务中学到了有价值的东西，如何判断它应该被保存在哪里、适用于哪些场景，以及何时可以成为系统长期能力的一部分？**\n\n例如，EvoAgent 完成了一次复杂代码重构，发现 AST 分析结合测试验证比直接文本替换更可靠。\n\n这条经验可能有四种不同的去向：\n\n- 保存为当前项目的经验；\n- 沉淀为代码专家的领域知识；\n- 形成可复用的代码重构工作流；\n- 最终转化为通用工具或正式能力。\n\n它们的作用范围、验证要求和失效条件都不同。\n\n如果系统把每次成功经验都直接写入通用记忆，就会导致知识污染；如果什么都不沉淀，则每次任务都可能重复探索；如果只记录成功而不记录失败条件，还可能把偶然成功的策略推广到不适合的场景。\n\n因此，下一专项建议定义为：\n\n**Capability Learning, Experience Consolidation &amp; Long-Term Knowledge Evolution，简称 CLEK。**\n\n重点研究：\n\n1. 如何区分事实、用户偏好、任务经验、工作流与正式能力；\n2. 如何判断一条经验是否具有长期价值；\n3. 如何确定经验应该属于当前任务、当前项目、某个专家还是共享内核；\n4. 如何记录经验的适用条件、证据来源和失效条件；\n5. 如何防止错误经验、偶然成功和过时知识进入长期记忆；\n6. 如何将重复经验逐渐转化为结构化规则、工作流或工具；\n7. 如何处理不同专家之间的经验冲突；\n8. 如何检测旧经验是否仍然有效；\n9. 如何让新经验影响后续任务，同时避免改变正在执行的任务；\n10. 如何通过评测决定经验升级、降级、废弃或回滚；\n11. 如何区分用户个人偏好与对所有用户或所有任务都成立的通用规律；\n12. 如何让记忆、上下文、工作流和正式能力之间形成清晰的晋升与退役机制。\n\n这一专项将进一步连接 MEEG、CERG、MACTDG、SELCIA 和独立进化控制器。\n\n它的核心目标是：\n\n**让 EvoAgent 不只是积累越来越多的信息，而是逐渐形成越来越可靠、适用范围越来越清晰、能够被验证和更新的长期能力。**\n\n下一轮将从第一性原理开始，研究“经验如何从一次任务中的观察，逐步变成经过验证、可复用、可退役的系统能力”，并明确哪些内容可以自动沉淀，哪些必须经过独立评测。","fallbackMarkdownVersion":1,"clientDefinedWidgets":{"14da09ef-dc33-52d6-8393-bed69ef99356":{"status":"resolved","refIndex":0,"isStreaming":false}},"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"code_blocks":{"0":{"id":"28fsmm","edited":false,"previewable":false,"preview_language":null}},"model_slug":"gpt-6","turn_exchange_id":"8c6a9eda-ce6c-4a37-878b-d414bdee90cd","request_id":"c8454275-7a32-4fac-9dd4-ed186aac0af6","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[{"type":"client_defined_widget","category":"code_block","data":{"content":"{\n  \"candidate_id\": \"evo-042\",\n  \"target\": \"context_compression\",\n  \"hypothesis\": \"关键约束在长任务压缩过程中被遗漏\",\n  \"baseline_version\": \"stable-12\",\n  \"candidate_version\": \"candidate-13\",\n  \"expected_benefit\": [\n    \"减少约束遗漏\",\n    \"降低返工率\"\n  ],\n  \"guardrails\": [\n    \"不降低关键验收通过率\",\n    \"不突破上下文预算\",\n    \"不改变权限规则\"\n  ],\n  \"evaluation_status\": \"PENDING\"\n}","language":"json","widget_type":"code_block"},"matched_text":"```json\n{\n  \"candidate_id\": \"evo-042\",\n  \"target\": \"context_compression\",\n  \"hypothesis\": \"关键约束在长任务压缩过程中被遗漏\",\n  \"baseline_version\": \"stable-12\",\n  \"candidate_version\": \"candidate-13\",\n  \"expected_benefit\": [\n    \"减少约束遗漏\",\n    \"降低返工率\"\n  ],\n  \"guardrails\": [\n    \"不降低关键验收通过率\",\n    \"不突破上下文预算\",\n    \"不改变权限规则\"\n  ],\n  \"evaluation_status\": \"PENDING\"\n}\n```","start_idx":6831,"end_idx":7179,"safe_urls":[],"refs":[],"alt":null,"prompt_text":null}],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"working_turn_id":"8c6a9eda-ce6c-4a37-878b-d414bdee90cd","default_model_slug":"gpt-6","can_save":true,"parent_id":"cf4eb5a4-efc7-4304-8c