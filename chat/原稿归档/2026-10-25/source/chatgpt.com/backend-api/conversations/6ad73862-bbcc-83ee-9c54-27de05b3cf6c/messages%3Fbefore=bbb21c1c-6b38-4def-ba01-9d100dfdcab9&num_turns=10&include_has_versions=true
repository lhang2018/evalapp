"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"560\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"561\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"562\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"563\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"564\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"565\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"566\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"567\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"568\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"569\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"570\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"571\"]))),__dil.jsx(\"text\",null,__dilConstants[\"572\"]),__dil.jsx(\"text\",null,__dilConstants[\"573\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"574\"])),__dil.jsx(\"text\",null,__dilConstants[\"575\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第五十六专项：质量工程、评测体系与进化治理","1":"QEEG · Quality Engineering & Evaluation Governance","2":"前面我们已经讨论了专家系统、任务 DAG、记忆与上下文、GECO 观测、TSEG 安全、RERA 可靠性，以及 APRO 性能与成本优化。","3":"现在进入一个决定 EvoAgent 能否真正持续进化的核心专项：","4":"如何定义好坏、如何验证改进，以及如何防止系统错误地认为自己已经进步。","5":"这次需要从第一性原理重新思考。","6":"假设 EvoAgent 的编程专家升级了一个版本：","7":"任务完成速度提高了 30%；","8":"Token 消耗减少了 25%；","9":"模型自评的满意度从 80 分提高到了 92 分；","10":"但实际回归测试通过率从 95% 降到了 88%。","11":"这个版本算不算进步？","12":"显然，不能只看速度、成本或模型自己的评分。对于代码交付，回归测试退化可能意味着整个改进不可接受。","13":"再假设另一种情况：一个版本的成功率从 80% 提高到 85%，但只测试了 10 个任务，而且这些任务比旧版本简单得多。这也不能证明能力真正提高了。","14":"更复杂的是，如果负责改进的智能体能够修改测试用例、评测器或成功标准，它甚至可能通过降低难度，让自己的分数越来越高。","15":"因此，QEEG 不能只是一个评分模块。它必须成为贯穿 EvoAgent 所有专家、技能、工作流、路由策略和自进化方案的","16":"独立质量验证体系","17":"。","18":"本专项要回答九个问题：","19":"什么才算任务真正完成？","20":"不同领域的质量应该怎样定义？","21":"哪些结果可以自动验证，哪些需要人工判断？","22":"怎样评测 Router、Planner、ReAct、专家和记忆系统？","23":"怎样证明多专家协作比单专家更好？","24":"如何区分真实进步、随机波动和任务难度变化？","25":"如何防止评测器被优化对象操纵？","26":"如何将评测结果接入 SELCIA 的发布与回滚流程？","27":"怎样让用户反馈持续改善质量，而不让系统被少数异常反馈带偏？","28":"核心原则是：","29":"系统可以自行提出改进、生成测试和解释结果，但正式晋升必须依据独立、可追溯、与任务目标一致的证据。","30":"一、第一性原理：质量不是一个分数","31":"智能体很容易把复杂任务压缩成一个看似精确的数字，例如“质量 92 分”。","32":"但不同任务的质量结构完全不同。","33":"代码能否正确运行，不能只看代码是否整洁；","34":"研究报告是否可靠，不能只看文字是否流畅；","35":"漫剧是否合格，不能只看画面是否漂亮；","36":"手机自动化是否成功，不能只看操作步骤是否执行；","37":"记忆系统是否有效，不能只看检索结果是否相关；","38":"Router 是否准确，不能只看它是否选中了某个热门专家。","39":"因此，QEEG 首先要将质量从单一分数拆成","40":"质量契约、验证证据、约束门槛和综合评价","41":"。","42":"1.1 四层质量模型","43":"这四层不能简单互相抵消。","44":"例如，任务极快完成，但没有满足用户的核心要求，就不能因为速度优势获得高质量结论。","45":"同样，代码测试全部通过，但程序未经授权修改了用户目录之外的文件，也不能被判定为合格交付。","46":"1.2 区分硬性门槛与可权衡指标","47":"建议把质量要求分为两类。","48":"硬性门槛：","49":"必须满足的用户约束；","50":"必须通过的功能测试；","51":"必须遵守的安全和授权规则；","52":"必须达到的产物完整性要求；","53":"必须完成的关键验收步骤。","54":"可权衡指标：","55":"完成速度；","56":"成本；","57":"可读性；","58":"维护便利性；","59":"视觉表现；","60":"用户体验；","61":"非关键的优化程度。","62":"可权衡指标可以在不同任务之间采用不同权重，但硬性门槛不能被平均分抵消。","63":"建议将正式验收表示为：","64":"\\operatorname{Accept}(x)\n=\n\\operatorname{GatesPass}(x)\n\\land\n\\operatorname{EvidenceSufficient}(x)","65":"其中 ","66":"x","67":" 是待验收产物。","68":"通过所有必要门槛且证据充分，才有资格进入综合质量评价。如果必要证据缺失，应标记为“未能确认合格”，而不是默认通过。","69":"二、建立统一质量契约：每项任务先明确怎样才算成功","70":"QEEG 的核心对象不是一个抽象的“评分”，而是 ","71":"QualityContract","72":"。","73":"它定义当前任务需要交付什么、必须满足哪些条件、如何验证，以及证据不足时应该怎样处理。","74":"2.1 质量契约包含哪些内容？","75":"建议至少包括：","76":"字段","77":"作用","78":"goal_ref","79":"关联用户目标与任务契约","80":"deliverables","81":"明确需要交付的产物","82":"acceptance_criteria","83":"定义合格条件","84":"hard_gates","85":"定义不可被综合评分抵消的门槛","86":"validators","87":"指定需要运行的测试、规则或评审方法","88":"evidence_requirements","89":"定义通过验收必须提供的证据","90":"quality_dimensions","91":"定义可比较的质量维度","92":"risk_profile","93":"确定验证深度与人工确认要求","94":"budget_constraints","95":"记录时间、费用与资源约束","96":"version","97":"追踪契约变更","98":"unknown_policy","99":"规定证据缺失、无法验证时的处理方式","100":"质量契约可以由用户明确提供，也可以由 Planner 根据请求生成候选，再通过结构化澄清或已验证的默认规则确定。","101":"对于低风险、目标清楚的任务，不必每次都打断用户确认全部细节。","102":"但对于高风险或验收条件不明确的任务，系统不能默默假设一个宽松标准。","103":"2.2 质量契约不能被待验收对象随意修改","104":"例如，编程专家生成了代码，并且测试失败。","105":"它可以提出修复方案，但不能为了让当前代码通过而自行删除失败测试或降低验收标准。","106":"如果发现原始质量契约存在错误，可以提出单独的契约变更请求。","107":"变更必须记录：","108":"原始要求；","109":"修改原因；","110":"新旧契约差异；","111":"对任务结果的影响；","112":"谁或哪个受控流程批准了变更。","113":"如果要求来自用户，涉及用户目标或交付标准的实质性变更，应按照授权策略请求用户确认。","114":"这也是 QEEG 与 TSEG 的重要接口：质量标准可以演进，但不能被待评测的对象悄悄重写。","115":"2.3 质量契约与领域专家如何配合？","116":"建议采用两级结构：","117":"全局质量契约：","118":" 目标符合性、安全、可靠性、交付完整性、证据要求。","119":"领域质量契约：","120":" 编程、漫剧、研究、数据分析等领域自己的专业标准。","121":"例如，代码专家可以增加单元测试、静态分析和接口兼容性要求；漫剧专家可以增加角色一致性、音画同步、时长和画面质量要求。","122":"领域专家可以提出专业验收条件，但不能覆盖全局硬性门槛。","123":"三、评测体系：不同问题必须使用不同的验证方法","124":"不是所有任务都能通过同一种方法判断质量。","125":"代码可以运行测试，数据分析可以检查计算结果，研究报告需要核对来源，创意作品需要综合评价，而 Router 的准确性需要对照真实任务意图和适用专家能力。","126":"因此，QEEG 应建立统一的评测编排机制 ","127":"Evaluation Orchestrator","128":"，但允许不同领域使用专门的验证器。","129":"3.1 建立六类评测器","130":"这些评测器可以组合使用。","131":"例如，一份研究报告可以同时经过结构检查、来源核验、事实交叉验证和模型辅助评审。模型评审不能替代来源核验，格式检查也不能证明结论正确。","132":"3.2 建立证据等级","133":"建议统一记录评测结论的证据状态：","134":"PASS","135":"：必要条件已通过验证；","136":"FAIL","137":"：有证据表明必要条件不满足；","138":"INCONCLUSIVE","139":"：证据不足，无法判断；","140":"NOT_APPLICABLE","141":"：该条件不适用于当前任务；","142":"BLOCKED","143":"：因权限、依赖或环境限制，无法执行必要验证。","144":"这些状态不能随意互相转换。","145":"例如，测试环境不可用时，不能将 ","146":"BLOCKED","147":" 自动转成 ","148":"PASS","149":"；模型认为代码“看起来正确”，也不能替代实际执行测试。","150":"最终任务状态应结合所有必要门槛判定，而不是把五个通过项和一个未知项平均成一个高分。","151":"3.3 确定性验证应优先","152":"凡是可以用低成本、稳定、可复现的方式验证的条件，都应优先使用确定性方法。","153":"例如：","154":"JSON 输出是否符合 Schema；","155":"代码是否通过规定的测试；","156":"文件是否存在且哈希正确；","157":"数据总量是否守恒；","158":"生成视频是否满足时长与编码要求；","159":"任务是否遵守预算；","160":"指定的操作是否真的完成；","161":"引用的来源是否存在且支持相关结论。","162":"只有无法通过确定性方法充分判断的部分，才需要增加模型辅助评审或人工评审。","163":"这不仅能够提高可靠性，还能降低评测费用和模型评审的随机性。","164":"四、领域评测：每种专家都需要自己的质量标准","165":"EvoAgent 的专家体系不能只区分“谁负责什么”，还必须区分“怎样证明该专家做得好”。","166":"建议建立 ","167":"DomainEvaluationPack","168":"，让每个专家绑定一套领域专用评测集、评测器和质量契约。","169":"4.1 编程专家","170":"核心质量维度","171":"功能正确性与回归测试","172":"接口兼容性与需求符合度","173":"静态分析、类型检查与必要的 AST 结构检查","174":"安全性与依赖风险","175":"代码可维护性与复杂度","176":"修改范围与副作用控制","177":"主要证据","178":"测试结果、代码差异、静态分析报告、执行日志、依赖版本、变更范围和验收契约。","179":"编程任务不能只靠另一个模型阅读代码后给出高分。","180":"如果存在可运行的测试，应优先执行；如果缺乏测试，则应明确标记验证覆盖不足，而不是把模型评审当成完整替代品。","181":"4.2 AI 漫剧专家","182":"核心质量维度","183":"剧情与分镜的一致性","184":"角色外观与身份连续性","185":"画面质量、构图与镜头连贯性","186":"配音、字幕和画面的同步","187":"时长、分辨率、帧率和音视频编码","188":"生成费用、返工率与交付完整性","189":"主要证据","190":"角色素材 ID、分镜与时间线、生成服务任务记录、视频抽帧、音频检测、FFmpeg 输出日志及最终文件验证。","191":"部分技术条件可以自动检测，但剧情感染力、视觉风格和角色一致性的整体感知通常需要多种证据结合。","192":"单个视觉模型的评分不能直接等同于观众的真实体验。","193":"4.3 研究与文档专家","194":"核心质量维度","195":"事实准确性与来源可靠性","196":"引用是否真实支持对应结论","197":"论证是否完整、存在矛盾或遗漏","198":"事实、推断与假设是否清晰区分","199":"是否覆盖用户要求的范围","200":"结构、可读性与交付格式","201":"主要证据","202":"原始来源、引用映射、事实核验结果、覆盖清单、论证结构与文档格式检查。","203":"对于研究报告，流畅的语言并不能证明结论可靠。尤其是高影响结论，需要更严格的来源核验和不确定性说明。","204":"4.4 数据分析专家","205":"核心质量维度应包括：","206":"数据输入与 Schema 正确性；","207":"数据清洗和转换可追溯性；","208":"计算逻辑与统计方法正确性；","209":"可复现性；","210":"结果解释是否超出证据范围；","211":"可视化是否准确表达数据。","212":"主要证据包括原始数据引用、转换步骤、计算代码、校验结果和可复现输出。","213":"4.5 Router 与 Planner 本身也需要评测","214":"不能只评测最终产物，还要评测决定任务如何执行的上游组件。","215":"Router 应评测：","216":"是否选择了适合的专家；","217":"是否正确识别多领域任务；","218":"是否能够发现能力缺口；","219":"是否在不确定时合理澄清或回退；","220":"是否避免不必要的专家调用。","221":"Planner 应评测：","222":"是否覆盖所有必要子目标；","223":"DAG 依赖是否正确；","224":"是否存在无意义节点；","225":"是否遗漏关键验收步骤；","226":"计划是否符合预算与执行环境；","227":"上游变更后是否正确识别下游影响。","228":"但需要注意，Router 选择了与标准标签不同的专家，不一定意味着路由错误。只要另一专家同样具备所需能力，并且实际完成质量合格，就应允许评测记录多个合理路径。","229":"因此，Router 的评测不能完全依赖单一的“标准答案专家 ID”。","230":"五、ReAct、Plan、专家和 DAG：怎样分别评测？","231":"这是 EvoAgent 架构中的一个关键问题。","232":"Router、Planner、ReAct 循环、专家和 DAG 处于不同层级。如果全部使用最终任务成功率来评价，就很难知道到底是哪一部分产生了改善或退化。","233":"建议建立分层评测模型。","234":"对象","235":"主要评测目标","236":"关键证据","237":"Router","238":"能力匹配、路由准确性、澄清与回退质量","239":"任务标签、候选专家、路由决策与最终结果","240":"专家","241":"领域任务质量、约束遵守和专业能力","242":"领域评测集、产物与验收结果","243":"Planner","244":"子目标覆盖、依赖正确性、计划成本与可执行性","245":"DAG 版本、依赖图、执行结果","246":"ReAct 循环","247":"行动选择、反馈利用、无进展检测和停止时机","248":"每轮动作、观察结果、策略变化","249":"工具执行器","250":"操作正确性、幂等性、权限与副作用控制","251":"操作账本、工具回执和实际状态","252":"记忆系统","253":"检索相关性、事实保持、过期信息处理","254":"记忆引用、来源、检索结果和下游表现","255":"上下文系统","256":"关键约束保留、压缩损失和 Token 效率","257":"压缩前后信息覆盖、任务结果","258":"专家团队","259":"协作增益、交接质量、重复劳动与协调成本","260":"工作包、交接事件、产物与团队总成本","261":"DAG 执行器","262":"调度效率、恢复能力、依赖失效处理","263":"节点状态、关键路径和恢复记录","264":"自进化控制器","265":"改进候选质量、评测有效性与回滚能力","266":"实验记录、评测报告、发布及回滚结果","267":"5.1 评测过程能力与最终结果必须分开","268":"例如，一个任务最终失败，但 Planner 的分解完全合理，真正的问题是外部 API 长时间不可用。","269":"不能因此直接判定 Planner 质量很差。","270":"同样，某个任务最终成功了，也不意味着 ReAct 策略优秀。如果它调用了十次不必要的工具，只是偶然得到了正确结果，那么它的效率和稳定性仍然值得改进。","271":"因此，QEEG 需要把以下两类结论分别记录：","272":"结果质量：","273":" 最终交付是否满足要求；","274":"过程质量：","275":" 路由、规划、工具使用、恢复和协作是否合理。","276":"两者相关，但不能相互替代。","277":"5.2 ReAct 不能仅凭轮数评价","278":"ReAct 循环的目标不是尽可能减少思考轮数，而是通过观察和行动逐步解决问题。","279":"一个简单任务只需要一轮就完成，是合理的；一个复杂故障可能需要多轮诊断和验证。","280":"因此，ReAct 评测应关注：","281":"每轮是否获得了有价值的新信息；","282":"动作是否有明确目的；","283":"观察结果是否改变了后续决策；","284":"是否重复尝试已经证明无效的方法；","285":"是否识别出无进展循环；","286":"是否在证据充分时停止；","287":"是否在达到预算或安全边界时及时停止。","288":"这样才能将“有效探索”和“无效循环”区分开。","289":"六、评测集设计：系统如何知道自己有没有进步？","290":"没有可靠的评测集，就无法可靠地比较版本。","291":"但单一的固定测试集也不够。随着 EvoAgent 不断改进，它可能逐渐适应已有案例，却无法处理新的任务分布。","292":"建议建立四类互补的评测集。","293":"6.1 固定回归集：保证过去解决的问题不会反复出现","294":"假设编程专家曾经发生过一个严重问题：修改代码时错误地删除了一个兼容接口。","295":"修复之后，应将这个案例及其验证条件加入固定回归集。","296":"后续修改 Router、Planner、上下文压缩、代码技能或执行器时，只要相关依赖发生变化，就应重新运行适用的回归测试。","297":"但回归集不应该无限增长而不做治理。应保留高价值案例，并合并重复、失效或不再适用的测试，同时记录测试集版本和变更原因。","298":"6.2 困难案例集：重点测试系统容易犯错的地方","299":"困难案例可以来自：","300":"GECO 发现的真实失败；","301":"SOCDEA 已确认或高度怀疑的根因；","302":"用户纠正过的结果；","303":"曾经导致返工的任务；","304":"边界条件和罕见输入；","305":"跨专家协作失败；","306":"模型切换或断网后的恢复问题；","307":"自进化过程中出现的回归。","308":"这些案例可以形成一个持续扩展的知识资产，但需要脱敏、版本化和适当的隐私控制。","309":"6.3 防止评测集污染","310":"如果候选模型能够提前看到所有正式测试案例，并针对这些案例专门调整，它可能在评测集上表现很好，却没有真正提高泛化能力。","311":"建议将评测数据分成：","312":"开发集：允许用于调试和改进；","313":"验证集：用于比较候选策略；","314":"保留测试集：用于正式晋升判定；","315":"真实运行观察集：用于评估部署后的实际表现。","316":"对于个人项目，不一定需要复杂的数据科学平台，但至少要避免让候选版本随意修改正式测试集及其预期结果。","317":"当保留测试集被大量重复用于优化时，也应考虑数据泄漏和过拟合风险，必要时引入新的独立案例。","318":"6.4 评测集必须跟随任务分布变化","319":"用户的使用方式可能改变，模型和工具也可能升级。","320":"因此，评测集应同时包含历史代表性任务和近期真实任务。","321":"如果 EvoAgent 从主要处理简单问答，逐渐转向代码工程和复杂视频制作，那么仅依赖早期的通用问答集就不再足以衡量系统的真实能力。","322":"但新任务也不能直接覆盖旧的回归集。正确做法是保留历史稳定基线，并通过版本化更新扩展评测覆盖。","323":"七、模型评审的局限：评测者自己也可能出错","324":"对于代码风格、文档质量、视觉连贯性等难以完全规则化的任务，模型辅助评审具有实际价值。","325":"但如果评测者和被评测者存在相同的盲点，或者评测提示词对某种风格有偏好，评分就可能产生系统性偏差。","326":"因此，QEEG 不应把单个模型的主观评分当成绝对真值。","327":"7.1 建立模型评审的校准机制","328":"建议对模型评审器持续检查：","329":"与人工评审的一致程度；","330":"对同一结果重复评审的稳定性；","331":"是否偏好较长、较流畅或特定风格的输出；","332":"是否能识别事实错误和证据不足；","333":"是否容易被无关的措辞、排序或格式影响；","334":"在不同任务类型中的表现是否一致。","335":"评审器可以有自己的版本、评测集和发布记录。","336":"如果评审器本身发生变化，就需要重新检查其评分与历史结果之间的可比性。","337":"7.2 使用多种证据，而不是简单堆叠多个模型","338":"三个模型给出相同判断，并不必然意味着结论可靠，尤其当它们共享类似的训练偏差或信息来源时。","339":"更合理的做法是让不同评测方法承担不同职责。","340":"例如：","341":"测试验证代码能否正确运行；","342":"静态分析检查特定缺陷；","343":"独立模型审查设计与可维护性；","344":"人工评审处理重要的架构取舍。","345":"这些方法提供的是不同类型的证据，比单纯增加相似模型的投票数量更有价值。","346":"7.3 评分必须提供依据","347":"模型辅助评审至少应输出：","348":"评价维度；","349":"评分或结论；","350":"支持该结论的产物引用；","351":"发现的问题；","352":"证据不足的部分；","353":"评审器版本；","354":"是否需要人工复核。","355":"如果评审器无法指出结果中具体存在什么问题，就不应该让它单独决定高风险任务的发布。","356":"7.4 不确定时应该升级，而不是伪造精确度","357":"对于主观任务，可以采用等级或区间，而不是强行给出精确到小数点的分数。","358":"例如，视觉连贯性可以标记为“符合要求”“存在可改进问题”或“无法确认”。","359":"如果某项评测结果对发布决策非常关键，而评审器又缺乏足够的校准证据，就应该增加独立评审或人工检查。","360":"八、统计显著性与真实进步：如何避免被随机波动欺骗？","361":"即使评测方法正确，也可能因为样本太少而得出错误结论。","362":"例如，某个 Router 版本在 20 个任务中正确选择了 18 次，另一个版本正确选择了 19 次。","363":"这一个任务的差异不足以证明新版本一定更好。","364":"对于随机性较强的模型，评测还会受到生成随机性、外部服务变化、运行环境和任务难度的影响。","365":"8.1 建立配对比较机制","366":"当比较两个版本时，尽量让它们使用相同的任务集、相同的验收标准和可比的运行条件。","367":"例如：","368":"旧 Router 与新 Router 使用相同的请求集；","369":"旧技能与新技能处理相同的代码修复案例；","370":"旧上下文压缩策略与新策略使用相同的任务输入；","371":"旧恢复机制与新恢复机制注入相同类型的故障。","372":"配对比较能够减少任务难度差异带来的干扰。","373":"但对于会产生外部副作用的真实任务，应在隔离环境或模拟工具中进行比较，不能为了测试而重复提交真实订单、消息或其他不可逆操作。","374":"8.2 同时报告效果大小与不确定性","375":"建议评测报告包含：","376":"样本量；","377":"指标变化；","378":"任务类型分布；","379":"统计不确定性；","380":"失败案例；","381":"资源成本；","382":"是否满足所有硬性门槛。","383":"对于成功率这类比例指标，可以使用置信区间或其他适合的方法；对于主观评分，应关注评审一致性和评分分布。","384":"统计显著性也不等于实际价值显著。一个极小的提升即使在大样本下具有统计显著性，也可能不足以抵消新版本的维护成本。","385":"8.3 建立多目标晋升规则","386":"例如，某个版本：","387":"成功率提高；","388":"成本下降；","389":"延迟略有上升；","390":"安全测试没有退化；","391":"可靠性指标保持稳定。","392":"它可能是一个值得晋升的候选，但是否晋升仍取决于任务类型和预先确定的约束。","393":"建议采用以下判定顺序：","394":"检查安全与权限硬门槛；","395":"检查必要的功能和质量门槛；","396":"检查可靠性与恢复要求；","397":"比较成本、延迟与资源表现；","398":"评估统计不确定性和实际收益；","399":"决定发布、继续测试、人工复核或拒绝。","400":"不能把所有指标压缩成一个综合分数，再让高效率抵消严重的安全或质量退化。","401":"九、多专家协作是否真的有价值：建立反事实评测","402":"EvoAgent 采用多专家架构，但不能默认多专家一定优于单专家。","403":"有些任务需要专业分工；有些任务增加专家，只会增加协调开销和重复推理。","404":"因此，QEEG 应单独评估协作机制的真实收益。","405":"9.1 建立三种对照方案","406":"以一个复杂代码修复任务为例，可以比较：","407":"A：由单个编程专家完成；","408":"B：由编程专家完成，并使用独立测试专家；","409":"C：由多个专家分工，包括分析、实现、测试和代码审查。","410":"比较时，应尽可能使用相同的任务目标、验收标准、资源约束和可比的模型能力。","411":"需要注意，公平比较不一定意味着所有方案使用相同数量的模型调用。多专家方案本身就可能需要更多调用，因此应同时比较：","412":"在相同预算下的质量；","413":"达到相同质量所需的成本；","414":"完成时间；","415":"返工率；","416":"缺陷漏检率；","417":"协调开销；","418":"最终交付的稳定性。","419":"9.2 建立协作净收益指标","420":"可以用以下形式表达协作净收益：","421":"G_{\\text{team}}\n=\nV_{\\text{team}}\n-\nV_{\\text{baseline}}\n-\nC_{\\text{coordination}}","422":"其中：","423":"V_{\\text{team}}","424":"：团队方案相对于任务目标的综合价值；","425":"V_{\\text{baseline}}","426":"：基线方案的综合价值；","427":"C_{\\text{coordination}}","428":"：额外的协调、重复工作和资源成本。","429":"实际评测时，各项需要采用统一口径，不能直接把不同单位的原始数值相减。","430":"如果团队方案提高了缺陷检测率，但明显增加成本，那么它可能适合高风险任务，却不适合简单修改。","431":"9.3 建立按任务类型选择协作策略的规则","432":"建议最终形成一套有证据支持的策略：","433":"简单任务优先单专家；","434":"存在独立验证价值的任务采用双专家或专家加确定性验证器；","435":"可分解且具有明显并行收益的任务采用小团队；","436":"高风险任务增加独立审查；","437":"协作收益不足或协调成本过高时，回退到更简单的执行方案。","438":"这使 MEODT 的动态组队不只是根据任务描述决定“找几个人”，而是根据历史评测确定不同组队策略在什么条件下真正有效。","439":"十、用户反馈：怎样把真实使用中的问题变成可靠改进？","440":"固定评测集能够发现已知问题，但无法覆盖用户所有真实需求。","441":"因此，QEEG 还需要利用用户反馈和真实任务结果。","442":"不过，用户反馈也不是绝对真值。","443":"用户可能因为结果不符合预期而给出低分，也可能因为表达流畅而给出高分，即使结果中存在事实错误。","444":"10.1 区分反馈类型","445":"建议把反馈分为：","446":"目标修正：","447":" 用户说明原本真正想要的结果；","448":"事实纠正：","449":" 用户指出明确的错误；","450":"质量评价：","451":" 用户评价可读性、视觉效果、代码风格等；","452":"行为纠正：","453":" 用户指出系统做了不该做的操作；","454":"效率反馈：","455":" 用户指出过程太慢、太贵或过于繁琐；","456":"长期结果反馈：","457":" 用户报告产物在真实使用中是否有效。","458":"不同反馈需要不同的处理方式。","459":"例如，用户说“这个答案太长”，可以作为表达偏好的证据，但不能直接推导出所有任务都应该缩短上下文。","460":"用户指出“这个函数返回错误值”，则应进一步通过代码、测试或实际行为核验。","461":"10.2 建立反馈到评测案例的闭环","462":"建议采用以下流程：","463":"10.3 用户习惯与客观质量必须分开","464":"这一点与此前讨论的用户记忆系统直接相关。","465":"例如，用户长期偏好简洁的代码解释，这是可以逐步学习的个人偏好。","466":"但如果用户偏好简短回答，并不代表系统可以省略必要的安全警告、测试结果或关键限制。","467":"建议将用户偏好纳入个性化质量契约，而不是修改全局的客观正确性门槛。","468":"这样，EvoAgent 可以逐渐适应用户，同时不至于把个人偏好误当成适用于所有人的普遍规则。","469":"10.4 真实结果反馈应考虑延迟和归因","470":"一些任务的真实价值要过一段时间才能体现。","471":"例如：","472":"生成的代码可能在后续集成时才暴露缺陷；","473":"研究报告可能在决策时才发现引用不准确；","474":"漫剧可能在发布后才获得真实观众反馈；","475":"自动化工作流可能运行数周后才显现维护成本。","476":"因此，QEEG 应允许长期结果反馈与原任务关联。","477":"但不能把后续出现的所有问题都归因于最初的智能体版本。中间的需求变化、环境变化和用户修改也需要纳入分析。","478":"十一、与现有模块的职责边界","479":"模块","480":"在 QEEG 中的职责","481":"QEEG","482":"定义统一评测协议、质量契约、评测集治理和晋升证据要求","483":"UQEAG","484":"执行任务级验收，确认产物是否满足质量契约","485":"Router","486":"提供路由决策及相关证据，接受路由质量评测","487":"Planner / DAG","488":"提供计划与执行结构，接受计划质量和调度结果评测","489":"MEODT","490":"提供专家分工、交接和协作数据，接受协作净收益评测","491":"GECO","492":"提供事件、追踪、版本、产物血缘和运行证据","493":"SOCDEA","494":"分析失败原因，提出根因假设与改进候选","495":"RERA","496":"提供故障恢复、状态一致性和可靠性评测结果","497":"APRO","498":"提供成本、延迟、资源和调度效率数据","499":"TSEG / PCP","500":"保护正式评测集、权限规则和评测发布边界","501":"CEKCE / CIL","502":"管理能力版本与复用情况，关联技能级评测","503":"MEEG / CLEK / ACMO","504":"提供记忆与上下文相关的质量证据","505":"SELCIA","506":"根据独立评测证据管理候选晋升、部署与回滚","507":"HACCG","508":"呈现用户可理解的结果、限制与必要的人工确认","509":"这里要特别明确：","510":"UQEAG 负责判断一个具体任务是否合格，QEEG 负责定义并治理整个系统怎样证明合格。","511":"两者密切相关，但不能混为一个模块。","512":"十二、架构决策记录 ADR-801～ADR-820","513":"以下建议纳入 EvoAgent 全量架构，作为 QEEG 的治理基线。","514":"这些是建议纳入全量架构的质量治理基线。进入工程实施阶段后，还需要进一步定义 ","515":"QualityContract","516":"、","517":"EvaluationRun","518":"、","519":"EvaluationEvidence","520":"、","521":"DomainEvaluationPack","522":"、","523":"BenchmarkVersion","524":"、","525":"JudgeCalibrationReport","526":" 和 ","527":"PromotionDecision","528":" 的接口、状态机与持久化协议。","529":"十三、第一版实施路线：先让质量可验证，再让系统自主优化","530":"对于 EvoAgent 的个人部署方向，QEEG 第一版不需要建立庞大的评测平台。重点是把质量契约、真实测试、版本比较和晋升门槛跑通。","531":"13.1 第一版必须通过的验收测试","532":"建议用一个真实的代码修复任务完成质量闭环。","533":"用户提出需求，Router 选择编程专家。","534":"Planner 生成任务 DAG 和明确的验收契约。","535":"专家完成代码修改，GECO 记录执行过程和产物版本。","536":"UQEAG 执行测试、静态分析及必要的人工确认。","537":"QEEG 汇总证据，分别判断硬门槛与可权衡指标。","538":"系统记录任务质量、成本、耗时和失败原因。","539":"将该任务加入适当的回归集，保留契约与评测版本。","540":"生成一个改进候选，在相同评测条件下与旧版本比较。","541":"如果质量或安全硬门槛失败，候选不得晋升。","542":"如果证据不足，系统应保留不确定状态，而不是自行宣布进步。","543":"这条链路跑通后，EvoAgent 才具备真正可操作的质量进化基础。","544":"十四、下一专项：知识资产、技能生命周期与能力复用治理","545":"目前，我们已经设计了能力的执行、观测、安全、恢复、资源优化与质量评测。","546":"但还存在一个重要问题：随着系统持续运行，它会积累越来越多的技能、工作流、记忆、修复方案和经验案例。","547":"如果不对这些资产进行系统治理，EvoAgent 可能逐渐出现：","548":"同一种能力被重复实现；","549":"新旧技能互相冲突；","550":"过期技能继续被 Router 选中；","551":"某次偶然成功被误认为通用经验；","552":"工作流升级后，依赖它的技能仍然使用旧接口；","553":"技能数量不断增加，但真正可复用的能力没有提高；","554":"历史失败被记录了，却没有转化为可验证的长期知识。","555":"因此，下一专项建议定义为：","556":"Knowledge & Capability Lifecycle Governance，简称 KCLG。","557":"重点研究：","558":"如何区分用户记忆、领域知识、技能、工作流、评测案例和执行经验；","559":"如何判断新能力应该创建、扩展现有能力，还是复用已有能力；","560":"如何建立能力的版本、依赖、来源和适用范围；","561":"如何判断一次成功究竟是可复用经验，还是偶然结果；","562":"如何防止错误记忆、过期知识和未经验证的经验进入共享能力库；","563":"如何评估技能的真实复用价值与维护成本；","564":"如何管理技能的晋升、降级、冻结、弃用与退役；","565":"如何在技能升级后识别受影响的工作流和依赖节点；","566":"如何避免多个专家重复创建相似技能；","567":"如何把 GECO 的故障证据和 QEEG 的评测案例转化为长期能力改进；","568":"如何让领域专家拥有专业知识，同时避免全局记忆被某一领域的经验污染；","569":"如何在本地存储有限的情况下进行知识压缩、去重和归档；","570":"如何让系统在复用旧能力时检查版本兼容性、安全状态和适用条件；","571":"如何判断某项能力应该继续维护、重新设计，还是彻底退役。","572":"这个专项与 CEKCE、CIL、MEEG 和 CLEK 密切相关，但职责仍然需要明确：记忆系统负责保存和检索信息，能力系统负责执行与复用，KCLG 则治理这些资产从产生到退役的整个生命周期。","573":"其核心原则是：","574":"积累更多记忆和技能，不等于获得更多可靠能力；只有来源清晰、适用范围明确、经过验证且能够持续维护的知识资产，才能真正提高 EvoAgent 的长期能力。","575":"完成 KCLG 后，我们就能进一步解决 EvoAgent 的长期成长问题：不仅能从失败中改进，还能将有效经验沉淀为可复用、可验证、可维护的能力资产，并避免系统随着时间推移变得越来越臃肿、混乱和脆弱。"},"fallbackMarkdown":"# EvoAgent 第五十六专项：质量工程、评测体系与进化治理\n\nQEEG · Quality Engineering &amp; Evaluation Governance\n\n前面我们已经讨论了专家系统、任务 DAG、记忆与上下文、GECO 观测、TSEG 安全、RERA 可靠性，以及 APRO 性能与成本优化。\n\n现在进入一个决定 EvoAgent 能否真正持续进化的核心专项：**如何定义好坏、如何验证改进，以及如何防止系统错误地认为自己已经进步。**\n\n这次需要从第一性原理重新思考。\n\n假设 EvoAgent 的编程专家升级了一个版本：\n\n- 任务完成速度提高了 30%；\n- Token 消耗减少了 25%；\n- 模型自评的满意度从 80 分提高到了 92 分；\n- 但实际回归测试通过率从 95% 降到了 88%。\n\n这个版本算不算进步？\n\n显然，不能只看速度、成本或模型自己的评分。对于代码交付，回归测试退化可能意味着整个改进不可接受。\n\n再假设另一种情况：一个版本的成功率从 80% 提高到 85%，但只测试了 10 个任务，而且这些任务比旧版本简单得多。这也不能证明能力真正提高了。\n\n更复杂的是，如果负责改进的智能体能够修改测试用例、评测器或成功标准，它甚至可能通过降低难度，让自己的分数越来越高。\n\n因此，QEEG 不能只是一个评分模块。它必须成为贯穿 EvoAgent 所有专家、技能、工作流、路由策略和自进化方案的**独立质量验证体系**。\n\n本专项要回答九个问题：\n\n1. 什么才算任务真正完成？\n2. 不同领域的质量应该怎样定义？\n3. 哪些结果可以自动验证，哪些需要人工判断？\n4. 怎样评测 Router、Planner、ReAct、专家和记忆系统？\n5. 怎样证明多专家协作比单专家更好？\n6. 如何区分真实进步、随机波动和任务难度变化？\n7. 如何防止评测器被优化对象操纵？\n8. 如何将评测结果接入 SELCIA 的发布与回滚流程？\n9. 怎样让用户反馈持续改善质量，而不让系统被少数异常反馈带偏？\n\n核心原则是：\n\n**系统可以自行提出改进、生成测试和解释结果，但正式晋升必须依据独立、可追溯、与任务目标一致的证据。**\n\n---\n\n# 一、第一性原理：质量不是一个分数\n\n智能体很容易把复杂任务压缩成一个看似精确的数字，例如“质量 92 分”。\n\n但不同任务的质量结构完全不同。\n\n- 代码能否正确运行，不能只看代码是否整洁；\n- 研究报告是否可靠，不能只看文字是否流畅；\n- 漫剧是否合格，不能只看画面是否漂亮；\n- 手机自动化是否成功，不能只看操作步骤是否执行；\n- 记忆系统是否有效，不能只看检索结果是否相关；\n- Router 是否准确，不能只看它是否选中了某个热门专家。\n\n因此，QEEG 首先要将质量从单一分数拆成**质量契约、验证证据、约束门槛和综合评价**。\n\n## 1.1 四层质量模型\n\n这四层不能简单互相抵消。\n\n例如，任务极快完成，但没有满足用户的核心要求，就不能因为速度优势获得高质量结论。\n\n同样，代码测试全部通过，但程序未经授权修改了用户目录之外的文件，也不能被判定为合格交付。\n\n## 1.2 区分硬性门槛与可权衡指标\n\n建议把质量要求分为两类。\n\n**硬性门槛：**\n\n- 必须满足的用户约束；\n- 必须通过的功能测试；\n- 必须遵守的安全和授权规则；\n- 必须达到的产物完整性要求；\n- 必须完成的关键验收步骤。\n\n**可权衡指标：**\n\n- 完成速度；\n- 成本；\n- 可读性；\n- 维护便利性；\n- 视觉表现；\n- 用户体验；\n- 非关键的优化程度。\n\n可权衡指标可以在不同任务之间采用不同权重，但硬性门槛不能被平均分抵消。\n\n建议将正式验收表示为：\n\n\\[\n\\operatorname{Accept}(x)\n=\n\\operatorname{GatesPass}(x)\n\\land\n\\operatorname{EvidenceSufficient}(x)\n\\]\n\n其中 \\(x\\) 是待验收产物。\n\n通过所有必要门槛且证据充分，才有资格进入综合质量评价。如果必要证据缺失，应标记为“未能确认合格”，而不是默认通过。\n\n---\n\n# 二、建立统一质量契约：每项任务先明确怎样才算成功\n\nQEEG 的核心对象不是一个抽象的“评分”，而是 `QualityContract`。\n\n它定义当前任务需要交付什么、必须满足哪些条件、如何验证，以及证据不足时应该怎样处理。\n\n## 2.1 质量契约包含哪些内容？\n\n建议至少包括：\n\n| 字段 | 作用 |\n|--------|--------|\n| `goal_ref` | 关联用户目标与任务契约 |\n| `deliverables` | 明确需要交付的产物 |\n| `acceptance_criteria` | 定义合格条件 |\n| `hard_gates` | 定义不可被综合评分抵消的门槛 |\n| `validators` | 指定需要运行的测试、规则或评审方法 |\n| `evidence_requirements` | 定义通过验收必须提供的证据 |\n| `quality_dimensions` | 定义可比较的质量维度 |\n| `risk_profile` | 确定验证深度与人工确认要求 |\n| `budget_constraints` | 记录时间、费用与资源约束 |\n| `version` | 追踪契约变更 |\n| `unknown_policy` | 规定证据缺失、无法验证时的处理方式 |\n\n质量契约可以由用户明确提供，也可以由 Planner 根据请求生成候选，再通过结构化澄清或已验证的默认规则确定。\n\n对于低风险、目标清楚的任务，不必每次都打断用户确认全部细节。\n\n但对于高风险或验收条件不明确的任务，系统不能默默假设一个宽松标准。\n\n## 2.2 质量契约不能被待验收对象随意修改\n\n例如，编程专家生成了代码，并且测试失败。\n\n它可以提出修复方案，但不能为了让当前代码通过而自行删除失败测试或降低验收标准。\n\n如果发现原始质量契约存在错误，可以提出单独的契约变更请求。\n\n变更必须记录：\n\n- 原始要求；\n- 修改原因；\n- 新旧契约差异；\n- 对任务结果的影响；\n- 谁或哪个受控流程批准了变更。\n\n如果要求来自用户，涉及用户目标或交付标准的实质性变更，应按照授权策略请求用户确认。\n\n这也是 QEEG 与 TSEG 的重要接口：质量标准可以演进，但不能被待评测的对象悄悄重写。\n\n## 2.3 质量契约与领域专家如何配合？\n\n建议采用两级结构：\n\n- **全局质量契约：** 目标符合性、安全、可靠性、交付完整性、证据要求。\n- **领域质量契约：** 编程、漫剧、研究、数据分析等领域自己的专业标准。\n\n例如，代码专家可以增加单元测试、静态分析和接口兼容性要求；漫剧专家可以增加角色一致性、音画同步、时长和画面质量要求。\n\n领域专家可以提出专业验收条件，但不能覆盖全局硬性门槛。\n\n---\n\n# 三、评测体系：不同问题必须使用不同的验证方法\n\n不是所有任务都能通过同一种方法判断质量。\n\n代码可以运行测试，数据分析可以检查计算结果，研究报告需要核对来源，创意作品需要综合评价，而 Router 的准确性需要对照真实任务意图和适用专家能力。\n\n因此，QEEG 应建立统一的评测编排机制 `Evaluation Orchestrator`，但允许不同领域使用专门的验证器。\n\n## 3.1 建立六类评测器\n\n这些评测器可以组合使用。\n\n例如，一份研究报告可以同时经过结构检查、来源核验、事实交叉验证和模型辅助评审。模型评审不能替代来源核验，格式检查也不能证明结论正确。\n\n## 3.2 建立证据等级\n\n建议统一记录评测结论的证据状态：\n\n- `PASS`：必要条件已通过验证；\n- `FAIL`：有证据表明必要条件不满足；\n- `INCONCLUSIVE`：证据不足，无法判断；\n- `NOT_APPLICABLE`：该条件不适用于当前任务；\n- `BLOCKED`：因权限、依赖或环境限制，无法执行必要验证。\n\n这些状态不能随意互相转换。\n\n例如，测试环境不可用时，不能将 `BLOCKED` 自动转成 `PASS`；模型认为代码“看起来正确”，也不能替代实际执行测试。\n\n最终任务状态应结合所有必要门槛判定，而不是把五个通过项和一个未知项平均成一个高分。\n\n## 3.3 确定性验证应优先\n\n凡是可以用低成本、稳定、可复现的方式验证的条件，都应优先使用确定性方法。\n\n例如：\n\n- JSON 输出是否符合 Schema；\n- 代码是否通过规定的测试；\n- 文件是否存在且哈希正确；\n- 数据总量是否守恒；\n- 生成视频是否满足时长与编码要求；\n- 任务是否遵守预算；\n- 指定的操作是否真的完成；\n- 引用的来源是否存在且支持相关结论。\n\n只有无法通过确定性方法充分判断的部分，才需要增加模型辅助评审或人工评审。\n\n这不仅能够提高可靠性，还能降低评测费用和模型评审的随机性。\n\n---\n\n# 四、领域评测：每种专家都需要自己的质量标准\n\nEvoAgent 的专家体系不能只区分“谁负责什么”，还必须区分“怎样证明该专家做得好”。\n\n建议建立 `DomainEvaluationPack`，让每个专家绑定一套领域专用评测集、评测器和质量契约。\n\n## 4.1 编程专家\n\n### 核心质量维度\n\n- 功能正确性与回归测试\n- 接口兼容性与需求符合度\n- 静态分析、类型检查与必要的 AST 结构检查\n- 安全性与依赖风险\n- 代码可维护性与复杂度\n- 修改范围与副作用控制\n  \n  ---\n  \n  ### 主要证据\n  \n  测试结果、代码差异、静态分析报告、执行日志、依赖版本、变更范围和验收契约。\n\n编程任务不能只靠另一个模型阅读代码后给出高分。\n\n如果存在可运行的测试，应优先执行；如果缺乏测试，则应明确标记验证覆盖不足，而不是把模型评审当成完整替代品。\n\n## 4.2 AI 漫剧专家\n\n### 核心质量维度\n\n- 剧情与分镜的一致性\n- 角色外观与身份连续性\n- 画面质量、构图与镜头连贯性\n- 配音、字幕和画面的同步\n- 时长、分辨率、帧率和音视频编码\n- 生成费用、返工率与交付完整性\n  \n  ---\n  \n  ### 主要证据\n  \n  角色素材 ID、分镜与时间线、生成服务任务记录、视频抽帧、音频检测、FFmpeg 输出日志及最终文件验证。\n\n部分技术条件可以自动检测，但剧情感染力、视觉风格和角色一致性的整体感知通常需要多种证据结合。\n\n单个视觉模型的评分不能直接等同于观众的真实体验。\n\n## 4.3 研究与文档专家\n\n### 核心质量维度\n\n- 事实准确性与来源可靠性\n- 引用是否真实支持对应结论\n- 论证是否完整、存在矛盾或遗漏\n- 事实、推断与假设是否清晰区分\n- 是否覆盖用户要求的范围\n- 结构、可读性与交付格式\n  \n  ---\n  \n  ### 主要证据\n  \n  原始来源、引用映射、事实核验结果、覆盖清单、论证结构与文档格式检查。\n\n对于研究报告，流畅的语言并不能证明结论可靠。尤其是高影响结论，需要更严格的来源核验和不确定性说明。\n\n## 4.4 数据分析专家\n\n核心质量维度应包括：\n\n- 数据输入与 Schema 正确性；\n- 数据清洗和转换可追溯性；\n- 计算逻辑与统计方法正确性；\n- 可复现性；\n- 结果解释是否超出证据范围；\n- 可视化是否准确表达数据。\n\n主要证据包括原始数据引用、转换步骤、计算代码、校验结果和可复现输出。\n\n## 4.5 Router 与 Planner 本身也需要评测\n\n不能只评测最终产物，还要评测决定任务如何执行的上游组件。\n\nRouter 应评测：\n\n- 是否选择了适合的专家；\n- 是否正确识别多领域任务；\n- 是否能够发现能力缺口；\n- 是否在不确定时合理澄清或回退；\n- 是否避免不必要的专家调用。\n\nPlanner 应评测：\n\n- 是否覆盖所有必要子目标；\n- DAG 依赖是否正确；\n- 是否存在无意义节点；\n- 是否遗漏关键验收步骤；\n- 计划是否符合预算与执行环境；\n- 上游变更后是否正确识别下游影响。\n\n但需要注意，Router 选择了与标准标签不同的专家，不一定意味着路由错误。只要另一专家同样具备所需能力，并且实际完成质量合格，就应允许评测记录多个合理路径。\n\n因此，Router 的评测不能完全依赖单一的“标准答案专家 ID”。\n\n---\n\n# 五、ReAct、Plan、专家和 DAG：怎样分别评测？\n\n这是 EvoAgent 架构中的一个关键问题。\n\nRouter、Planner、ReAct 循环、专家和 DAG 处于不同层级。如果全部使用最终任务成功率来评价，就很难知道到底是哪一部分产生了改善或退化。\n\n建议建立分层评测模型。\n\n| 对象 | 主要评测目标 | 关键证据 |\n|--------|--------|--------|\n| Router | 能力匹配、路由准确性、澄清与回退质量 | 任务标签、候选专家、路由决策与最终结果 |\n| 专家 | 领域任务质量、约束遵守和专业能力 | 领域评测集、产物与验收结果 |\n| Planner | 子目标覆盖、依赖正确性、计划成本与可执行性 | DAG 版本、依赖图、执行结果 |\n| ReAct 循环 | 行动选择、反馈利用、无进展检测和停止时机 | 每轮动作、观察结果、策略变化 |\n| 工具执行器 | 操作正确性、幂等性、权限与副作用控制 | 操作账本、工具回执和实际状态 |\n| 记忆系统 | 检索相关性、事实保持、过期信息处理 | 记忆引用、来源、检索结果和下游表现 |\n| 上下文系统 | 关键约束保留、压缩损失和 Token 效率 | 压缩前后信息覆盖、任务结果 |\n| 专家团队 | 协作增益、交接质量、重复劳动与协调成本 | 工作包、交接事件、产物与团队总成本 |\n| DAG 执行器 | 调度效率、恢复能力、依赖失效处理 | 节点状态、关键路径和恢复记录 |\n| 自进化控制器 | 改进候选质量、评测有效性与回滚能力 | 实验记录、评测报告、发布及回滚结果 |\n\n## 5.1 评测过程能力与最终结果必须分开\n\n例如，一个任务最终失败，但 Planner 的分解完全合理，真正的问题是外部 API 长时间不可用。\n\n不能因此直接判定 Planner 质量很差。\n\n同样，某个任务最终成功了，也不意味着 ReAct 策略优秀。如果它调用了十次不必要的工具，只是偶然得到了正确结果，那么它的效率和稳定性仍然值得改进。\n\n因此，QEEG 需要把以下两类结论分别记录：\n\n- **结果质量：** 最终交付是否满足要求；\n- **过程质量：** 路由、规划、工具使用、恢复和协作是否合理。\n\n两者相关，但不能相互替代。\n\n## 5.2 ReAct 不能仅凭轮数评价\n\nReAct 循环的目标不是尽可能减少思考轮数，而是通过观察和行动逐步解决问题。\n\n一个简单任务只需要一轮就完成，是合理的；一个复杂故障可能需要多轮诊断和验证。\n\n因此，ReAct 评测应关注：\n\n- 每轮是否获得了有价值的新信息；\n- 动作是否有明确目的；\n- 观察结果是否改变了后续决策；\n- 是否重复尝试已经证明无效的方法；\n- 是否识别出无进展循环；\n- 是否在证据充分时停止；\n- 是否在达到预算或安全边界时及时停止。\n\n这样才能将“有效探索”和“无效循环”区分开。\n\n---\n\n# 六、评测集设计：系统如何知道自己有没有进步？\n\n没有可靠的评测集，就无法可靠地比较版本。\n\n但单一的固定测试集也不够。随着 EvoAgent 不断改进，它可能逐渐适应已有案例，却无法处理新的任务分布。\n\n建议建立四类互补的评测集。\n\n## 6.1 固定回归集：保证过去解决的问题不会反复出现\n\n假设编程专家曾经发生过一个严重问题：修改代码时错误地删除了一个兼容接口。\n\n修复之后，应将这个案例及其验证条件加入固定回归集。\n\n后续修改 Router、Planner、上下文压缩、代码技能或执行器时，只要相关依赖发生变化，就应重新运行适用的回归测试。\n\n但回归集不应该无限增长而不做治理。应保留高价值案例，并合并重复、失效或不再适用的测试，同时记录测试集版本和变更原因。\n\n## 6.2 困难案例集：重点测试系统容易犯错的地方\n\n困难案例可以来自：\n\n- GECO 发现的真实失败；\n- SOCDEA 已确认或高度怀疑的根因；\n- 用户纠正过的结果；\n- 曾经导致返工的任务；\n- 边界条件和罕见输入；\n- 跨专家协作失败；\n- 模型切换或断网后的恢复问题；\n- 自进化过程中出现的回归。\n\n这些案例可以形成一个持续扩展的知识资产，但需要脱敏、版本化和适当的隐私控制。\n\n## 6.3 防止评测集污染\n\n如果候选模型能够提前看到所有正式测试案例，并针对这些案例专门调整，它可能在评测集上表现很好，却没有真正提高泛化能力。\n\n建议将评测数据分成：\n\n- 开发集：允许用于调试和改进；\n- 验证集：用于比较候选策略；\n- 保留测试集：用于正式晋升判定；\n- 真实运行观察集：用于评估部署后的实际表现。\n\n对于个人项目，不一定需要复杂的数据科学平台，但至少要避免让候选版本随意修改正式测试集及其预期结果。\n\n当保留测试集被大量重复用于优化时，也应考虑数据泄漏和过拟合风险，必要时引入新的独立案例。\n\n## 6.4 评测集必须跟随任务分布变化\n\n用户的使用方式可能改变，模型和工具也可能升级。\n\n因此，评测集应同时包含历史代表性任务和近期真实任务。\n\n如果 EvoAgent 从主要处理简单问答，逐渐转向代码工程和复杂视频制作，那么仅依赖早期的通用问答集就不再足以衡量系统的真实能力。\n\n但新任务也不能直接覆盖旧的回归集。正确做法是保留历史稳定基线，并通过版本化更新扩展评测覆盖。\n\n---\n\n# 七、模型评审的局限：评测者自己也可能出错\n\n对于代码风格、文档质量、视觉连贯性等难以完全规则化的任务，模型辅助评审具有实际价值。\n\n但如果评测者和被评测者存在相同的盲点，或者评测提示词对某种风格有偏好，评分就可能产生系统性偏差。\n\n因此，QEEG 不应把单个模型的主观评分当成绝对真值。\n\n## 7.1 建立模型评审的校准机制\n\n建议对模型评审器持续检查：\n\n- 与人工评审的一致程度；\n- 对同一结果重复评审的稳定性；\n- 是否偏好较长、较流畅或特定风格的输出；\n- 是否能识别事实错误和证据不足；\n- 是否容易被无关的措辞、排序或格式影响；\n- 在不同任务类型中的表现是否一致。\n\n评审器可以有自己的版本、评测集和发布记录。\n\n如果评审器本身发生变化，就需要重新检查其评分与历史结果之间的可比性。\n\n## 7.2 使用多种证据，而不是简单堆叠多个模型\n\n三个模型给出相同判断，并不必然意味着结论可靠，尤其当它们共享类似的训练偏差或信息来源时。\n\n更合理的做法是让不同评测方法承担不同职责。\n\n例如：\n\n- 测试验证代码能否正确运行；\n- 静态分析检查特定缺陷；\n- 独立模型审查设计与可维护性；\n- 人工评审处理重要的架构取舍。\n\n这些方法提供的是不同类型的证据，比单纯增加相似模型的投票数量更有价值。\n\n## 7.3 评分必须提供依据\n\n模型辅助评审至少应输出：\n\n- 评价维度；\n- 评分或结论；\n- 支持该结论的产物引用；\n- 发现的问题；\n- 证据不足的部分；\n- 评审器版本；\n- 是否需要人工复核。\n\n如果评审器无法指出结果中具体存在什么问题，就不应该让它单独决定高风险任务的发布。\n\n## 7.4 不确定时应该升级，而不是伪造精确度\n\n对于主观任务，可以采用等级或区间，而不是强行给出精确到小数点的分数。\n\n例如，视觉连贯性可以标记为“符合要求”“存在可改进问题”或“无法确认”。\n\n如果某项评测结果对发布决策非常关键，而评审器又缺乏足够的校准证据，就应该增加独立评审或人工检查。\n\n---\n\n# 八、统计显著性与真实进步：如何避免被随机波动欺骗？\n\n即使评测方法正确，也可能因为样本太少而得出错误结论。\n\n例如，某个 Router 版本在 20 个任务中正确选择了 18 次，另一个版本正确选择了 19 次。\n\n这一个任务的差异不足以证明新版本一定更好。\n\n对于随机性较强的模型，评测还会受到生成随机性、外部服务变化、运行环境和任务难度的影响。\n\n## 8.1 建立配对比较机制\n\n当比较两个版本时，尽量让它们使用相同的任务集、相同的验收标准和可比的运行条件。\n\n例如：\n\n- 旧 Router 与新 Router 使用相同的请求集；\n- 旧技能与新技能处理相同的代码修复案例；\n- 旧上下文压缩策略与新策略使用相同的任务输入；\n- 旧恢复机制与新恢复机制注入相同类型的故障。\n\n配对比较能够减少任务难度差异带来的干扰。\n\n但对于会产生外部副作用的真实任务，应在隔离环境或模拟工具中进行比较，不能为了测试而重复提交真实订单、消息或其他不可逆操作。\n\n## 8.2 同时报告效果大小与不确定性\n\n建议评测报告包含：\n\n- 样本量；\n- 指标变化；\n- 任务类型分布；\n- 统计不确定性；\n- 失败案例；\n- 资源成本；\n- 是否满足所有硬性门槛。\n\n对于成功率这类比例指标，可以使用置信区间或其他适合的方法；对于主观评分，应关注评审一致性和评分分布。\n\n统计显著性也不等于实际价值显著。一个极小的提升即使在大样本下具有统计显著性，也可能不足以抵消新版本的维护成本。\n\n## 8.3 建立多目标晋升规则\n\n例如，某个版本：\n\n- 成功率提高；\n- 成本下降；\n- 延迟略有上升；\n- 安全测试没有退化；\n- 可靠性指标保持稳定。\n\n它可能是一个值得晋升的候选，但是否晋升仍取决于任务类型和预先确定的约束。\n\n建议采用以下判定顺序：\n\n1. 检查安全与权限硬门槛；\n2. 检查必要的功能和质量门槛；\n3. 检查可靠性与恢复要求；\n4. 比较成本、延迟与资源表现；\n5. 评估统计不确定性和实际收益；\n6. 决定发布、继续测试、人工复核或拒绝。\n\n不能把所有指标压缩成一个综合分数，再让高效率抵消严重的安全或质量退化。\n\n---\n\n# 九、多专家协作是否真的有价值：建立反事实评测\n\nEvoAgent 采用多专家架构，但不能默认多专家一定优于单专家。\n\n有些任务需要专业分工；有些任务增加专家，只会增加协调开销和重复推理。\n\n因此，QEEG 应单独评估协作机制的真实收益。\n\n## 9.1 建立三种对照方案\n\n以一个复杂代码修复任务为例，可以比较：\n\n- A：由单个编程专家完成；\n- B：由编程专家完成，并使用独立测试专家；\n- C：由多个专家分工，包括分析、实现、测试和代码审查。\n\n比较时，应尽可能使用相同的任务目标、验收标准、资源约束和可比的模型能力。\n\n需要注意，公平比较不一定意味着所有方案使用相同数量的模型调用。多专家方案本身就可能需要更多调用，因此应同时比较：\n\n- 在相同预算下的质量；\n- 达到相同质量所需的成本；\n- 完成时间；\n- 返工率；\n- 缺陷漏检率；\n- 协调开销；\n- 最终交付的稳定性。\n\n## 9.2 建立协作净收益指标\n\n可以用以下形式表达协作净收益：\n\n\\[\nG_{\\text{team}}\n=\nV_{\\text{team}}\n-\nV_{\\text{baseline}}\n-\nC_{\\text{coordination}}\n\\]\n\n其中：\n\n- \\(V_{\\text{team}}\\)：团队方案相对于任务目标的综合价值；\n- \\(V_{\\text{baseline}}\\)：基线方案的综合价值；\n- \\(C_{\\text{coordination}}\\)：额外的协调、重复工作和资源成本。\n\n实际评测时，各项需要采用统一口径，不能直接把不同单位的原始数值相减。\n\n如果团队方案提高了缺陷检测率，但明显增加成本，那么它可能适合高风险任务，却不适合简单修改。\n\n## 9.3 建立按任务类型选择协作策略的规则\n\n建议最终形成一套有证据支持的策略：\n\n- 简单任务优先单专家；\n- 存在独立验证价值的任务采用双专家或专家加确定性验证器；\n- 可分解且具有明显并行收益的任务采用小团队；\n- 高风险任务增加独立审查；\n- 协作收益不足或协调成本过高时，回退到更简单的执行方案。\n\n这使 MEODT 的动态组队不只是根据任务描述决定“找几个人”，而是根据历史评测确定不同组队策略在什么条件下真正有效。\n\n---\n\n# 十、用户反馈：怎样把真实使用中的问题变成可靠改进？\n\n固定评测集能够发现已知问题，但无法覆盖用户所有真实需求。\n\n因此，QEEG 还需要利用用户反馈和真实任务结果。\n\n不过，用户反馈也不是绝对真值。\n\n用户可能因为结果不符合预期而给出低分，也可能因为表达流畅而给出高分，即使结果中存在事实错误。\n\n## 10.1 区分反馈类型\n\n建议把反馈分为：\n\n- **目标修正：** 用户说明原本真正想要的结果；\n- **事实纠正：** 用户指出明确的错误；\n- **质量评价：** 用户评价可读性、视觉效果、代码风格等；\n- **行为纠正：** 用户指出系统做了不该做的操作；\n- **效率反馈：** 用户指出过程太慢、太贵或过于繁琐；\n- **长期结果反馈：** 用户报告产物在真实使用中是否有效。\n\n不同反馈需要不同的处理方式。\n\n例如，用户说“这个答案太长”，可以作为表达偏好的证据，但不能直接推导出所有任务都应该缩短上下文。\n\n用户指出“这个函数返回错误值”，则应进一步通过代码、测试或实际行为核验。\n\n## 10.2 建立反馈到评测案例的闭环\n\n建议采用以下流程：\n\n## 10.3 用户习惯与客观质量必须分开\n\n这一点与此前讨论的用户记忆系统直接相关。\n\n例如，用户长期偏好简洁的代码解释，这是可以逐步学习的个人偏好。\n\n但如果用户偏好简短回答，并不代表系统可以省略必要的安全警告、测试结果或关键限制。\n\n建议将用户偏好纳入个性化质量契约，而不是修改全局的客观正确性门槛。\n\n这样，EvoAgent 可以逐渐适应用户，同时不至于把个人偏好误当成适用于所有人的普遍规则。\n\n## 10.4 真实结果反馈应考虑延迟和归因\n\n一些任务的真实价值要过一段时间才能体现。\n\n例如：\n\n- 生成的代码可能在后续集成时才暴露缺陷；\n- 研究报告可能在决策时才发现引用不准确；\n- 漫剧可能在发布后才获得真实观众反馈；\n- 自动化工作流可能运行数周后才显现维护成本。\n\n因此，QEEG 应允许长期结果反馈与原任务关联。\n\n但不能把后续出现的所有问题都归因于最初的智能体版本。中间的需求变化、环境变化和用户修改也需要纳入分析。\n\n---\n\n# 十一、与现有模块的职责边界\n\n| 模块 | 在 QEEG 中的职责 |\n|--------|--------|\n| QEEG | 定义统一评测协议、质量契约、评测集治理和晋升证据要求 |\n| UQEAG | 执行任务级验收，确认产物是否满足质量契约 |\n| Router | 提供路由决策及相关证据，接受路由质量评测 |\n| Planner / DAG | 提供计划与执行结构，接受计划质量和调度结果评测 |\n| MEODT | 提供专家分工、交接和协作数据，接受协作净收益评测 |\n| GECO | 提供事件、追踪、版本、产物血缘和运行证据 |\n| SOCDEA | 分析失败原因，提出根因假设与改进候选 |\n| RERA | 提供故障恢复、状态一致性和可靠性评测结果 |\n| APRO | 提供成本、延迟、资源和调度效率数据 |\n| TSEG / PCP | 保护正式评测集、权限规则和评测发布边界 |\n| CEKCE / CIL | 管理能力版本与复用情况，关联技能级评测 |\n| MEEG / CLEK / ACMO | 提供记忆与上下文相关的质量证据 |\n| SELCIA | 根据独立评测证据管理候选晋升、部署与回滚 |\n| HACCG | 呈现用户可理解的结果、限制与必要的人工确认 |\n\n这里要特别明确：\n\n**UQEAG 负责判断一个具体任务是否合格，QEEG 负责定义并治理整个系统怎样证明合格。**\n\n两者密切相关，但不能混为一个模块。\n\n---\n\n# 十二、架构决策记录 ADR-801～ADR-820\n\n以下建议纳入 EvoAgent 全量架构，作为 QEEG 的治理基线。\n\n这些是建议纳入全量架构的质量治理基线。进入工程实施阶段后，还需要进一步定义 `QualityContract`、`EvaluationRun`、`EvaluationEvidence`、`DomainEvaluationPack`、`BenchmarkVersion`、`JudgeCalibrationReport` 和 `PromotionDecision` 的接口、状态机与持久化协议。\n\n---\n\n# 十三、第一版实施路线：先让质量可验证，再让系统自主优化\n\n对于 EvoAgent 的个人部署方向，QEEG 第一版不需要建立庞大的评测平台。重点是把质量契约、真实测试、版本比较和晋升门槛跑通。\n\n## 13.1 第一版必须通过的验收测试\n\n建议用一个真实的代码修复任务完成质量闭环。\n\n1. 用户提出需求，Router 选择编程专家。\n2. Planner 生成任务 DAG 和明确的验收契约。\n3. 专家完成代码修改，GECO 记录执行过程和产物版本。\n4. UQEAG 执行测试、静态分析及必要的人工确认。\n5. QEEG 汇总证据，分别判断硬门槛与可权衡指标。\n6. 系统记录任务质量、成本、耗时和失败原因。\n7. 将该任务加入适当的回归集，保留契约与评测版本。\n8. 生成一个改进候选，在相同评测条件下与旧版本比较。\n9. 如果质量或安全硬门槛失败，候选不得晋升。\n10. 如果证据不足，系统应保留不确定状态，而不是自行宣布进步。\n\n这条链路跑通后，EvoAgent 才具备真正可操作的质量进化基础。\n\n---\n\n# 十四、下一专项：知识资产、技能生命周期与能力复用治理\n\n目前，我们已经设计了能力的执行、观测、安全、恢复、资源优化与质量评测。\n\n但还存在一个重要问题：随着系统持续运行，它会积累越来越多的技能、工作流、记忆、修复方案和经验案例。\n\n如果不对这些资产进行系统治理，EvoAgent 可能逐渐出现：\n\n- 同一种能力被重复实现；\n- 新旧技能互相冲突；\n- 过期技能继续被 Router 选中；\n- 某次偶然成功被误认为通用经验；\n- 工作流升级后，依赖它的技能仍然使用旧接口；\n- 技能数量不断增加，但真正可复用的能力没有提高；\n- 历史失败被记录了，却没有转化为可验证的长期知识。\n\n因此，下一专项建议定义为：\n\n**Knowledge &amp; Capability Lifecycle Governance，简称 KCLG。**\n\n重点研究：\n\n1. 如何区分用户记忆、领域知识、技能、工作流、评测案例和执行经验；\n2. 如何判断新能力应该创建、扩展现有能力，还是复用已有能力；\n3. 如何建立能力的版本、依赖、来源和适用范围；\n4. 如何判断一次成功究竟是可复用经验，还是偶然结果；\n5. 如何防止错误记忆、过期知识和未经验证的经验进入共享能力库；\n6. 如何评估技能的真实复用价值与维护成本；\n7. 如何管理技能的晋升、降级、冻结、弃用与退役；\n8. 如何在技能升级后识别受影响的工作流和依赖节点；\n9. 如何避免多个专家重复创建相似技能；\n10. 如何把 GECO 的故障证据和 QEEG 的评测案例转化为长期能力改进；\n11. 如何让领域专家拥有专业知识，同时避免全局记忆被某一领域的经验污染；\n12. 如何在本地存储有限的情况下进行知识压缩、去重和归档；\n13. 如何让系统在复用旧能力时检查版本兼容性、安全状态和适用条件；\n14. 如何判断某项能力应该继续维护、重新设计，还是彻底退役。\n\n这个专项与 CEKCE、CIL、MEEG 和 CLEK 密切相关，但职责仍然需要明确：记忆系统负责保存和检索信息，能力系统负责执行与复用，KCLG 则治理这些资产从产生到退役的整个生命周期。\n\n其核心原则是：\n\n**积累更多记忆和技能，不等于获得更多可靠能力；只有来源清晰、适用范围明确、经过验证且能够持续维护的知识资产，才能真正提高 EvoAgent 的长期能力。**\n\n完成 KCLG 后，我们就能进一步解决 EvoAgent 的长期成长问题：不仅能从失败中改进，还能将有效经验沉淀为可复用、可验证、可维护的能力资产，并避免系统随着时间推移变得越来越臃肿、混乱和脆弱。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6-thinking","turn_exchange_id":"ba13a8e2-9ea2-4fb0-9989-30faa0555653","request_id":"c5162f45-9ee1-4d0b-9806-f3620ea6594d","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"working_turn_id":"ba13a8e2-9ea2-4fb0-9989-30faa0555653","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":true,"parent_id":"b0c26a32-6bb4-4c1a-9e79-068badca9365","logical_answer_prefix_activity":{"visibility":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"}],"safe_urls":[],"blocked_urls":[],"page_info":{"start_cursor":"bbb212cb-03f4-4d40-a88f-1591e77804e5","end_cursor":"a4f61f00-9ddb-435b-a089-8f58fa1def1b","has_previous_page":true,"has_next_page":true}}