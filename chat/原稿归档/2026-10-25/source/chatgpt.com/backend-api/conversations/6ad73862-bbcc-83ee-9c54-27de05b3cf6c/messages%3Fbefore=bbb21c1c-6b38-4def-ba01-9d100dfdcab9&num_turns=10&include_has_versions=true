dil.jsx(\"text\",null,__dilConstants[\"580\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"581\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"582\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"583\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"584\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"585\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"586\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"587\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"588\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"589\"]))),__dil.jsx(\"text\",null,__dilConstants[\"590\"]),__dil.jsx(\"text\",null,__dilConstants[\"591\"]),__dil.jsx(\"text\",null,__dilConstants[\"592\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"593\"])),__dil.jsx(\"text\",null,__dilConstants[\"594\"]),__dil.jsx(\"text\",null,__dilConstants[\"595\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第五十五专项：自适应性能、资源调度与成本优化","1":"APRO · Adaptive Performance & Resource Optimization","2":"前面已经完成了可靠性专项 RERA 的架构设计。现在进入 APRO，解决 EvoAgent 在个人设备上长期运行时的性能与资源问题。","3":"你的部署方向有一个很重要的特点：","4":"以个人电脑、Android 手机和微型 Linux 主机为核心，不假设存在一台始终在线、资源无限的中央服务器。","5":"因此，EvoAgent 不能简单照搬大型云端智能体的架构。它必须学会根据设备能力、任务难度、质量要求和当前负载，动态决定该使用什么模型、多少个专家、怎样执行 DAG，以及哪些工作应当延迟。","6":"APRO 的目标不是单纯减少 Token，也不是让所有任务尽可能快，而是：","7":"在满足任务质量、安全、可靠性和用户授权要求的前提下，尽量用更少的时间、计算资源和金钱完成任务。","8":"例如，同样是代码任务：","9":"修改一个变量名，不需要启动多个专家；","10":"重构一个复杂模块，可能需要 AST 分析、测试专家和独立代码审查；","11":"生成 60 秒动态漫剧，可能需要大量云端生成预算和本地视频合成资源；","12":"手机正在发热或内存不足时，不应该强行运行多个本地模型；","13":"服务器断网时，应优先选择本地可执行的能力，而不是反复请求已经不可用的服务。","14":"这些场景不能依靠一套固定的模型选择规则解决。它们需要一个能够感知资源、预测成本、控制并发并从实际执行结果中学习的系统。","15":"一、第一性原理：优化整个任务，而不是孤立的模块","16":"APRO 首先要避免五种常见的优化误区。","17":"模型越强越好。","18":" 更强的模型可能提高单次推理质量，却不一定提高整个任务的成功率。","19":"并行越多越快。","20":" 多专家并行可能增加协调成本、内存占用和重复工作。","21":"上下文越短越省钱。","22":" 过度压缩可能丢失约束，导致返工成本超过节省的 Token。","23":"缓存越多越高效。","24":" 过期缓存可能使系统使用错误的技能版本、旧代码或失效的任务状态。","25":"本地运行一定更便宜。","26":" 本地模型可能耗时更长、占用更多内存，也可能使其他任务无法运行。","27":"真正的优化对象应该是整个任务的最终交付成本。","28":"1.1 建立统一的任务效用模型","29":"可以把一次任务的综合表现表示为：","30":"J =\nw_q Q +\nw_r R +\nw_t T +\nw_c C +\nw_m M +\nw_e E","31":"其中：","32":"Q","33":"：任务质量；","34":"R","35":"：可靠性与恢复表现；","36":"T","37":"：完成时间；","38":"C","39":"：实际费用；","40":"M","41":"：内存及其他资源占用；","42":"E","43":"：能耗或设备负载。","44":"这里需要注意，质量和可靠性通常是越高越好，而时间、成本、资源占用通常是越低越好。因此，实现时不能直接对这些原始数值做简单加权求和，而应先进行归一化，并明确各项的优化方向。","45":"更重要的是，","46":"安全、授权和必要的质量验收应当作为硬约束，而不是可以被其他收益抵消的普通评分项。","47":"例如，不能因为某个策略降低了 50% 的成本，就允许它绕过必要的安全检查。","48":"实际调度可以采用两阶段决策：","49":"先过滤掉违反安全、质量、授权和硬资源限制的方案；","50":"再在剩余方案中比较延迟、费用、资源消耗和预期收益。","51":"1.2 区分三种优化目标","52":"同一个模型或技能，在不同目标下可能具有完全不同的优先级。","53":"例如，后台进化任务即使能够更快完成，也不应该抢占用户正在使用的本地模型所需的全部内存。","54":"二、总体架构：建立统一的资源感知与调度体系","55":"建议建立六个核心组件。","56":"1. Resource Monitor","57":"采集 CPU、内存、GPU、磁盘、网络、设备温度、模型驻留和实际调用成本。","58":"2. Workload Profiler","59":"分析任务类型、历史耗时、成功率、资源需求和并行机会。","60":"3. Budget Manager","61":"为任务、节点、模型调用、专家团队和后台进化分配预算。","62":"4. Adaptive Scheduler","63":"选择模型与执行位置，调整 DAG 并行度、专家数量、优先级和降级策略。","64":"5. Cache & Context Optimizer","65":"管理模型驻留、缓存、记忆检索、上下文组装和压缩策略。","66":"6. Performance Evaluator","67":"比较实际表现与预测，评估策略是否真正提高了质量、效率和稳定性。","68":"这些组件通过统一的资源预算、任务状态和事件协议协作，不需要成为六个独立的 AI 智能体。","69":"第一版更适合采用确定性调度逻辑和简单的历史统计。随着数据积累，再逐步引入更复杂的预测与自适应策略。","70":"2.1 与已有模块的关系","71":"Router 决定应该由哪个专家处理请求。","72":"Planner 决定任务应该分解成哪些节点。","73":"APRO 决定这些节点使用什么资源、何时执行、在哪里执行，以及是否需要降低并行度。","74":"TERSO 负责落实工具执行与资源限制。","75":"RERA 负责故障、重试、恢复和安全停止。","76":"GECO 记录实际资源消耗与执行结果。","77":"SELCIA 负责评测和发布经过验证的调度改进。","78":"因此，APRO 不应该取代 Router 或 Planner。","79":"Router 解决能力匹配，Planner 解决任务分解，APRO 解决资源约束下的执行优化。","80":"三、统一资源模型：系统必须知道自己还能做什么","81":"如果 APRO 不知道设备当前的资源状况，就只能根据静态配置猜测。","82":"因此，建议建立 ","83":"ResourceSnapshot","84":" 和 ","85":"ResourceBudget","86":" 两类数据结构。","87":"3.1 ResourceSnapshot：当前资源快照","88":"至少应包含：","89":"资源类别","90":"关键数据","91":"CPU","92":"可用核心数、负载、任务队列","93":"内存","94":"可用内存、进程占用、模型驻留占用","95":"GPU / NPU","96":"是否可用、显存或共享内存、当前任务占用","97":"磁盘","98":"剩余空间、读写压力、临时文件占用","99":"网络","100":"可用性、延迟、带宽估计","101":"模型运行时","102":"已加载模型、加载耗时、并发限制","103":"外部费用","104":"已使用预算、待确认费用、剩余预算","105":"设备状态","106":"电池、温度、系统资源压力与运行限制","107":"并不是所有平台都能提供这些指标。例如，Android 应用可能无法直接获取完整的 GPU 占用或精确的系统级资源信息。","108":"因此，资源快照应当支持 ","109":"available","110":"、","111":"estimated","112":" 和 ","113":"unknown","114":" 等状态。不能把无法观测的资源当成无限可用。","115":"3.2 ResourceBudget：预算不是单一的金额","116":"建议将预算分成以下几个维度：","117":"时间预算","118":"：任务允许运行多久；","119":"计算预算","120":"：允许消耗多少 CPU、GPU 时间或推理资源；","121":"Token 预算","122":"：模型输入和输出的允许范围；","123":"费用预算","124":"：允许产生多少外部服务费用；","125":"内存预算","126":"：任务可以占用多少内存；","127":"并发预算","128":"：允许同时运行多少节点、专家和模型请求；","129":"重试预算","130":"：失败后还能进行多少次尝试；","131":"返工预算","132":"：质量不达标时允许多少轮修改。","133":"这些预算需要相互关联。","134":"例如，任务虽然还有 Token 额度，但如果剩余时间不足以完成最终验收，就不应该继续生成大量中间分析。","135":"同样，一个任务可能还有费用额度，但当前设备内存不足，此时应该等待、降级或迁移，而不是继续启动本地模型。","136":"3.3 预算采用分层继承与受控分配","137":"建议采用以下层级：","138":"系统预算","139":"整台设备的资源安全上限、并发限制与全局费用限制。","140":{"left":3},"141":"任务预算","142":"由用户目标、截止时间、质量要求与授权决定。","143":{"left":3},"144":"DAG 节点预算","145":"为分析、生成、测试、合成等节点分配资源。","146":{"left":3},"147":"工具与模型调用预算","148":"限制单次操作的超时、Token、费用和并发。","149":"下层预算不能突破上层剩余额度。","150":"同时，应区分“预留预算”和“实际消耗”。如果多个节点并行运行，每个节点都把整个任务的剩余额度当作自己可用的预算，就会出现预算超支。","151":"因此，APRO 应通过原子化预留、执行后结算和失败释放等机制管理资源。","152":"四、动态模型选择：什么时候需要最强模型？","153":"这是 APRO 最重要的能力之一。","154":"EvoAgent 可能接入本地模型、远程模型以及不同价格、延迟和能力水平的模型适配器。不能简单规定所有任务都使用同一个模型，也不能只根据模型名称或参数规模选择。","155":"建议建立 ","156":"Model Selection Policy","157":"。","158":"4.1 先定义任务所需的能力","159":"每个任务在进入模型调度前，应尽可能明确：","160":"任务类型；","161":"所需能力；","162":"难度与不确定性；","163":"质量验收要求；","164":"输入与输出规模；","165":"是否需要工具调用；","166":"是否涉及高风险操作；","167":"可接受的延迟；","168":"可接受的费用；","169":"可用模型与执行环境。","170":"这些信息可以由 Router、Planner、历史统计和任务契约共同提供，不应完全依赖模型自己给出的难度评分。","171":"4.2 建立候选模型能力表","172":"建议为每个模型适配器维护一个动态的 ","173":"ModelCapabilityProfile","174":"。","175":"属性","176":"用途","177":"任务能力表现","178":"在编程、推理、摘要等任务上的历史验收表现","179":"上下文容量","180":"支持的输入长度与输出限制","181":"工具支持","182":"是否支持所需的工具调用或结构化输出","183":"平均延迟","184":"相似任务的历史执行耗时","185":"费用","186":"输入、输出或其他计费方式","187":"资源需求","188":"内存、GPU、CPU 与模型加载成本","189":"可靠性","190":"超时率、失败率、恢复表现","191":"适用限制","192":"隐私、联网、部署与授权要求","193":"模型能力数据应按任务类型分组，并随着实际评测持续更新。","194":"不能因为某个模型在通用问答中表现很好，就默认它在代码修复、复杂规划或结构化输出上同样优秀。","195":"4.3 采用逐级升级策略","196":"一个可实施的初始策略是：","197":"这不是强制所有任务都从最低级开始。对于复杂代码迁移、高风险数据处理或明确要求高质量的任务，可以直接选择经过验证的高能力路径。","198":"逐级升级只是默认优化策略，不应增加不必要的尝试次数。","199":"4.4 比较总成本，而不是单次调用价格","200":"假设两个模型处理同一类代码任务：","201":"模型 A 单次调用成本较低，但经常需要返工；","202":"模型 B 单次调用成本较高，但更容易一次通过测试。","203":"如果只比较单次 Token 费用，可能会错误选择模型 A。","204":"更合理的比较是：","205":"C_{\\text{effective}}\n=\nC_{\\text{inference}}\n+\nC_{\\text{tools}}\n+\nC_{\\text{rework}}\n+\nC_{\\text{recovery}}","206":"其中包括推理成本、工具成本、返工成本和恢复成本。","207":"实际决策还需要考虑任务失败造成的时间损失，以及质量要求是否已经满足。","208":"例如，模型 A 虽然便宜，但如果它的输出无法通过测试，就不应该仅凭成本优势被选中。","209":"4.5 模型切换不能丢失关键上下文","210":"从本地模型切换到远程模型，或者从一个模型适配器切换到另一个模型时，系统必须重新构建经过验证的任务上下文。","211":"不能只把最近几轮聊天内容直接复制过去。","212":"建议传递：","213":"当前任务目标；","214":"经过验证的需求与约束；","215":"相关产物和版本；","216":"已经执行的操作；","217":"已知失败及其证据；","218":"剩余预算；","219":"仍然有效的授权范围；","220":"当前节点的验收条件。","221":"这与 ACMO、MEEG 和 CLEK 的上下文设计直接相关。APRO 决定上下文使用多少资源，而记忆与上下文模块负责确保传递的信息仍然准确、完整且适用。","222":"五、多专家与 DAG 并行：并行不是越多越好","223":"EvoAgent 采用多专家架构，但专家数量增加后，资源开销并不是线性增长。","224":"多个专家可能各自加载模型、检索记忆、重复分析同一问题，还可能需要额外的协调与结果整合。","225":"因此，APRO 必须根据任务结构和设备资源动态决定并行度。","226":"5.1 建立 DAG 的资源感知调度","227":"Planner 负责生成任务 DAG，APRO 负责在 DAG 的依赖约束下调度可执行节点。","228":"每个节点至少应声明：","229":"依赖节点；","230":"预计执行时间；","231":"预计内存与计算需求；","232":"预计费用；","233":"是否可并行；","234":"是否具有外部副作用；","235":"是否允许取消；","236":"失败后的恢复策略。","237":"APRO 根据当前资源情况选择可运行节点，而不是简单地将所有已解锁节点同时启动。","238":"5.2 区分三类并行任务","239":"类型","240":"处理策略","241":"高度独立的任务","242":"资源充足时优先并行执行","243":"有共享模型或资源竞争的任务","244":"根据模型驻留、内存与队列情况调整并发","245":"存在冲突或强依赖的任务","246":"按依赖顺序执行，或通过明确的隔离与合并机制控制冲突","247":"例如，两个专家分别分析两个互不相关的代码模块，可能适合并行。","248":"但两个专家同时修改同一个文件，可能造成冲突，增加合并和回归测试成本。","249":"即使 CPU 足够空闲，也不意味着同时修改同一个文件是更好的方案。","250":"5.3 估算并行收益","251":"假设任务有多个可并行节点。","252":"理想情况下，关键路径决定最低执行时间；但真实运行还会受到模型加载、资源竞争、任务启动和结果合并的影响。","253":"因此，APRO 应比较：","254":"串行执行的预计时间；","255":"并行执行的预计时间；","256":"并行额外消耗的资源；","257":"任务失败或冲突的概率；","258":"合并与验收所需的额外成本。","259":"只有预期收益足够大时，才增加并行度。","260":"5.4 专家团队规模应当动态调整","261":"建议将团队规模分为三种模式：","262":"单专家模式：","263":" 适用于目标明确、依赖简单的任务；","264":"小团队模式：","265":" 适用于需要专业分工或独立验证的任务；","266":"多专家模式：","267":" 适用于复杂、可分解且并行收益明确的任务。","268":"APRO 不应仅凭任务字数或表面复杂度增加专家。","269":"更有价值的判断是：新增专家是否能够提供独立的专业能力、减少关键路径耗时，或者提高验证质量。","270":"如果多个专家只是重复回答同一个问题，就应减少冗余调用。","271":"六、记忆与上下文优化：省下的 Token 不能靠返工还回去","272":"这一部分与此前讨论的 ACMO、MEEG、CLEK 和各领域专家直接相关。","273":"APRO 不能把上下文压缩当作一个全局统一的“缩短文本”任务。它需要根据任务阶段、专家职责和信息的重要性，决定哪些内容应该加载、哪些内容可以摘要、哪些内容必须保留原始证据。","274":"6.1 建立分层上下文预算","275":"建议把上下文分成五个逻辑层：","276":"这里的层级是逻辑分层，不代表每次请求都必须把前四层完整复制到模型上下文中。","277":"系统应按任务需要选择内容，并确保不可省略的授权与验收约束在压缩和模型切换后仍然有效。","278":"6.2 压缩应保留什么？","279":"建议为上下文压缩建立独立的 ","280":"ContextRetentionPolicy","281":"。","282":"高优先级信息包括：","283":"用户明确提出的约束；","284":"当前有效的授权；","285":"已验证的事实与证据引用；","286":"已完成的操作及其实际结果；","287":"尚未解决的问题；","288":"任务依赖和版本信息；","289":"不可逆操作的状态；","290":"失败原因及已尝试过的方法；","291":"最终验收条件。","292":"可压缩的信息包括重复解释、已经解决且不再影响当前任务的讨论，以及能够通过稳定引用重新读取的长文档。","293":"但对于代码任务，不应只保留“修改了某个函数”的摘要，而忽略实际代码版本、测试结果和变更差异。","294":"对于漫剧任务，也不能只保留“角色素材已生成”，而不保存角色版本、素材引用和质量验收状态。","295":"6.3 全局压缩与专家专用压缩应当分开","296":"建议保留两种能力：","297":"全局上下文治理：","298":" 统一管理 token 预算、保留规则、隐私限制和任务连续性。","299":"领域专用压缩器：","300":" 由不同专家针对特定内容使用适合的结构化表示。","301":"例如：","302":"编程专家可以保留 AST 结构、符号引用、代码差异和测试证据；","303":"漫剧专家可以保留角色 ID、场景 ID、分镜关系、时间线和素材版本；","304":"研究专家可以保留论点、来源、证据强度与待验证假设；","305":"数据分析专家可以保留数据 Schema、筛选条件、转换步骤和统计结果。","306":"这也回答了此前的一个重要问题：上下文压缩不应该只有一个通用算法，也不应该让每个专家各自发明一套互不兼容的记忆系统。","307":"全局模块负责统一治理，领域模块负责专业表达。","308":"6.4 缓存必须具备失效机制","309":"缓存可以减少重复推理、重复读取和重复生成，但需要明确缓存的适用条件。","310":"建议将缓存键与以下信息关联：","311":"输入内容摘要；","312":"任务或节点类型；","313":"模型与技能版本；","314":"关键配置；","315":"数据依赖版本；","316":"权限和隐私范围；","317":"必要的运行环境信息。","318":"如果代码文件发生变化，基于旧代码生成的分析缓存可能失效；如果技能版本升级，旧版本的执行结果也不应自动成为新版本正确性的证据。","319":"缓存只是一种性能优化，不是可信事实的替代品。","320":"七、本地、远程与跨设备调度：根据任务选择执行位置","321":"EvoAgent 的部署路线不是单一云端系统，而是个人设备优先。","322":"因此，APRO 需要建立 ","323":"Execution Placement Policy","324":"，决定任务应该在手机、个人电脑、微型 Linux 主机还是外部服务中执行。","325":"7.1 建立执行位置的选择维度","326":"维度","327":"需要考虑的问题","328":"能力匹配","329":"该设备是否具备所需模型、工具与运行环境？","330":"资源条件","331":"当前内存、计算能力和磁盘空间是否足够？","332":"网络条件","333":"是否需要联网？网络延迟和稳定性如何？","334":"隐私要求","335":"任务数据是否允许离开本地设备？","336":"执行成本","337":"远程调用费用是否值得？","338":"恢复能力","339":"任务中断后能否恢复，产物能否可靠同步？","340":"用户体验","341":"是否会影响当前前台操作、电池或设备温度？","342":"不能只根据设备算力选择执行位置。","343":"例如，本地 Linux 主机可能有足够的计算能力，但如果某个任务涉及不能离开手机的私有数据，就不能为了速度自动把数据发送到远程服务。","344":"7.2 建立三种执行模式","345":"这些是任务级执行策略，不是要求整个 EvoAgent 永远固定在其中一种模式。","346":"同一任务的不同节点可以采用不同执行位置，但每次跨设备或跨信任边界的数据传输，都必须重新检查授权和数据使用范围。","347":"7.3 断网时需要明确降级策略","348":"如果外部模型不可用，APRO 可以：","349":"选择经过验证且能够完成该步骤的本地模型；","350":"使用确定性工具或规则能力完成不需要模型的步骤；","351":"暂停依赖外部服务的节点，继续执行独立节点；","352":"保存检查点，等待网络恢复；","353":"在预算或质量要求无法满足时，明确请求用户决策。","354":"不能为了让任务看起来持续运行，就用明显不具备相应能力的本地模型生成未经验证的结果。","355":"7.4 Android 必须考虑设备状态","356":"手机资源调度和桌面电脑不同。","357":"除了内存、CPU 和网络，APRO 还应考虑：","358":"电池电量与充电状态；","359":"设备温度与系统热限制；","360":"后台执行限制；","361":"用户是否正在进行前台交互；","362":"模型驻留对其他应用的影响。","363":"如果手机正在发热，可以暂停非必要的本地模型推理，延后后台索引和进化评测。","364":"但是，设备降温或资源释放不能通过跳过关键状态保存、授权检查或安全停止流程来实现。","365":"八、成本控制：不只是 Token，更要关注返工和外部费用","366":"EvoAgent 未来可能接入代码执行、云端视频生成、语音合成、文件处理和其他第三方服务。","367":"这些服务的费用结构差异很大。单纯统计模型 Token，无法反映整个任务的真实成本。","368":"8.1 建立统一的 Cost Ledger","369":"建议建立 ","370":"CostLedger","371":"，至少记录：","372":"任务与节点 ID；","373":"模型或服务名称；","374":"调用次数；","375":"输入与输出 Token；","376":"实际或估算费用；","377":"费用确认状态；","378":"重试与返工产生的费用；","379":"任务预算；","380":"剩余额度；","381":"成本对应的产物与验收结果。","382":"对于按量计费但账单延迟返回的外部服务，应区分已确认费用与估算费用。","383":"APRO 不应将尚未确认的费用视为零。","384":"8.2 预算分配应根据任务结构决定","385":"例如，一个 AI 漫剧任务可以将预算划分为：","386":"剧本与分镜；","387":"角色和场景素材；","388":"视频片段生成；","389":"配音与音频处理；","390":"本地合成；","391":"质量验收；","392":"必要的返工预留。","393":"具体比例应根据服务定价、历史成功率和用户质量要求动态估算，而不是硬编码一个适用于所有任务的固定比例。","394":"如果前面的角色素材质量不达标，系统就不应该继续投入大量视频生成费用。","395":"8.3 采用阶段性投入策略","396":"对于高成本生成任务，建议在阶段边界进行质量门控：","397":"先生成低成本的候选内容；","398":"验证结构、时长、角色和基础质量；","399":"只有满足条件后，才进入更昂贵的生成阶段；","400":"保留必要的返工预算；","401":"如果关键约束持续不满足，暂停并请求用户确认。","402":"这能避免错误的上游输入持续放大后续费用。","403":"8.4 评价成本时必须结合产出质量","404":"一个成本很低但最终不能交付的任务，不应被评为优化成功。","405":"建议同时比较：","406":"每个验收通过任务的平均成本；","407":"每个合格产物的平均成本；","408":"返工成本；","409":"失败任务的沉没成本；","410":"资源占用与耗时；","411":"质量是否达到用户要求。","412":"这使 APRO 优化的是“合格交付的成本”，而不是单纯的调用价格。","413":"九、前台、后台与进化任务：资源优先级必须统一","414":"EvoAgent 不仅需要执行用户任务，还可能在后台进行记忆整理、技能评测、工作流分析和进化实验。","415":"如果这些任务各自独立调度，就可能发生资源争抢。","416":"例如，用户正在让编程专家修改代码，后台 SELCIA 同时启动多个候选模型评测，导致本地模型被卸载、内存压力上升，前台任务响应变慢。","417":"因此，建议 APRO 建立统一的 ","418":"WorkloadPriorityManager","419":"。","420":"9.1 建立五类工作负载","421":"工作负载","422":"默认优先级","423":"调度原则","424":"安全控制与关键状态持久化","425":"最高","426":"保证必要的授权撤销、状态记录与安全停止能力","427":"用户前台交互","428":"高","429":"优先保证响应性和当前任务连续性","430":"正在执行的关键任务","431":"中高","432":"尽量减少中断，保护已投入的计算与工作进度","433":"普通后台维护","434":"中低","435":"在资源充足时执行，可暂停和恢复","436":"进化实验与批量评测","437":"低","438":"使用剩余资源，必要时主动让出资源","439":"这是一套建议的默认优先级，不是所有任务都必须采用完全相同的固定顺序。","440":"例如，用户明确启动的大规模视频生成任务可能需要持续占用资源；而后台安全更新或授权撤销相关操作则不应被普通用户任务阻塞。","441":"9.2 防止优先级反转","442":"如果高优先级任务依赖某个低优先级任务持有的资源，就可能出现优先级反转。","443":"例如，前台任务需要加载模型，但后台任务占用了大部分内存。","444":"APRO 可以在必要时暂停后台任务、释放非必要缓存，或者限制其继续申请资源。","445":"同时，关键任务也不能无限制地抢占所有资源，否则可能导致其他必要的系统维护永远无法完成。","446":"9.3 后台任务必须可暂停、可恢复","447":"建议后台进化和批量评测任务具备：","448":"明确的检查点；","449":"可释放的模型与内存资源；","450":"可暂停的工作单元；","451":"恢复后的版本核验；","452":"独立的预算；","453":"对前台资源压力的响应机制。","454":"当资源不足时，系统应优先暂停可恢复的后台任务，而不是让所有任务一起进入不可控状态。","455":"十、性能分析与自适应优化：不要凭感觉调参","456":"APRO 还需要解决一个长期问题：系统怎样知道真正的瓶颈在哪里？","457":"例如，任务响应慢，原因可能是：","458":"Router 多次调用模型；","459":"模型加载时间过长；","460":"DAG 并行度不足；","461":"工具执行等待外部服务；","462":"上下文过长；","463":"磁盘 I/O 成为瓶颈；","464":"多专家重复工作；","465":"返工次数过多。","466":"如果没有明确的性能证据，系统很容易优化错方向。","467":"10.1 建立端到端耗时分解","468":"建议为每个任务追踪以下耗时：","469":"T_{\\text{total}}\n=\nT_{\\text{queue}}\n+\nT_{\\text{routing}}\n+\nT_{\\text{planning}}\n+\nT_{\\text{execution}}\n+\nT_{\\text{waiting}}\n+\nT_{\\text{validation}}","470":"这只是便于诊断的概念分解。对于并行 DAG，端到端耗时不能简单地把所有节点耗时相加，而应结合关键路径和实际等待关系分析。","471":"例如，如果模型推理只占总耗时的 20%，即使把推理速度提升一倍，整个任务的耗时也不会减少一半。","472":"因此，APRO 应优先识别关键路径上的主要瓶颈。","473":"10.2 采用分层优化策略","474":"建议按以下顺序进行优化：","475":"消除无效工作。","476":" 减少重复推理、无效重试和冗余专家调用。","477":"优化任务结构。","478":" 改善 DAG 分解、依赖关系和数据传递。","479":"优化上下文。","480":" 减少无关内容，复用可验证的中间结果。","481":"优化调度。","482":" 调整并行度、优先级、模型驻留和资源分配。","483":"优化单次执行。","484":" 在前面几项完成后，再优化模型选择、推理参数和底层性能。","485":"这样可以避免用更快的模型掩盖糟糕的工作流设计。","486":"10.3 建立策略实验机制","487":"对于模型选择、并行度、上下文压缩和缓存策略，APRO 可以提出不同候选方案，并在隔离环境中比较。","488":"实验应固定或记录：","489":"任务样本；","490":"模型与技能版本；","491":"质量验收条件；","492":"资源环境；","493":"费用统计口径；","494":"测试数据；","495":"失败与恢复规则。","496":"如果实验环境与真实运行环境差异较大，系统不能直接把实验结果视为生产环境中的确定收益。","497":"10.4 优化策略必须可回滚","498":"例如，APRO 学到“增加专家数量可以提高复杂代码任务的成功率”。","499":"这条经验可能只在特定模型、设备和任务分布下成立。","500":"因此，策略发布后应继续监控：","501":"实际成功率；","502":"端到端耗时；","503":"返工率；","504":"费用；","505":"设备资源压力；","506":"不同任务类型的表现。","507":"一旦出现明显退化，就应恢复到经过验证的稳定策略，而不是让错误的自适应规则持续影响后续任务。","508":"十一、APRO 与自进化的边界：调度器不能为了省资源破坏质量","509":"APRO 本身也会成为进化对象。","510":"系统可能发现某个路由策略浪费了很多 Token，或者某个专家团队经常产生重复结果，于是提出优化方案。","511":"但资源优化很容易出现“局部指标改善、整体质量下降”的情况。","512":"例如：","513":"减少独立代码审查，降低成本，却增加缺陷漏检；","514":"缩短上下文，降低 Token 消耗，却导致需求约束丢失；","515":"减少回归测试，加快交付，却提高回归风险；","516":"降低检查点频率，减少磁盘写入，却增加崩溃后的重做成本；","517":"将所有任务切换到本地模型，降低外部费用，却导致任务无法在截止时间前完成。","518":"因此，APRO 必须接受三个不可突破的原则。","519":"第一，安全与授权是硬约束。","520":" 资源不足不能成为绕过 TSEG 的理由。","521":"第二，任务验收标准不能由优化器自行降低。","522":" UQEAG 的必要质量要求不能因为成本压力而自动消失。","523":"第三，调度策略的进化必须独立评测。","524":" 优化器不能只依据自己生成的预测值宣称成功，必须比较实际结果。","525":"建议将 APRO 的策略发布纳入 SELCIA，并要求 GECO 持续记录策略版本、实际资源消耗、质量结果和退化信号。","526":"十二、架构决策记录 ADR-781～ADR-800","527":"以下建议纳入 EvoAgent 全量架构，作为 APRO 的治理基线。","528":"这些是建议纳入全量架构的资源治理基线。工程实施时，还需要进一步定义 ","529":"ResourceSnapshot","530":"、","531":"ResourceBudget","532":"、","533":"ModelCapabilityProfile","534":"、","535":"CostLedger","536":"、","537":"ExecutionPlacementPolicy","538":" 和 ","539":"WorkloadPriorityManager","540":" 的接口、状态机与持久化协议。","541":"十三、第一版实施路线：先做可测量的优化，不急着让系统自主学习调度","542":"对于个人部署的 EvoAgent，APRO 第一版不需要训练一个复杂的资源调度模型。先把资源、费用、质量和执行耗时记录准确，通常比立即引入强化学习或复杂预测器更有价值。","543":"13.1 第一版的验收标准","544":"建议使用三种不同的任务验证 APRO：","545":"一个简单聊天任务；","546":"一个包含分析、修改和测试的代码任务；","547":"一个包含多个生成与合成阶段的漫剧任务。","548":"系统应当能够：","549":"记录任务执行前的资源状态；","550":"选择符合质量要求的模型和能力；","551":"在资源不足时限制并发或延后后台任务；","552":"记录每个节点的实际耗时与成本；","553":"识别重复推理、无效重试和高成本返工；","554":"保持上下文压缩后的任务约束和证据完整；","555":"在模型切换或断网后维持有效的任务状态；","556":"比较优化前后的质量、耗时、费用和资源占用；","557":"在优化策略造成退化时回滚；","558":"证明资源优化没有绕过安全、可靠性和最终验收要求。","559":"只有这些指标能够可靠测量，后续的自适应调度才有可信的学习基础。","560":"十四、下一专项：质量工程、评测体系与结果可信度","561":"到这里，我们已经系统讨论了多个核心领域：","562":"多专家与协作机制；","563":"Router、Plan、ReAct 与任务 DAG；","564":"记忆、上下文与领域专用能力；","565":"GECO 全局观测与因果证据；","566":"TSEG 安全与进化治理；","567":"RERA 可靠性与恢复保证；","568":"APRO 性能、资源与成本优化。","569":"但这些系统还存在一个共同问题：","570":"我们如何知道 EvoAgent 真正变得更好了，而不是仅仅变得更快、更便宜、更复杂，或者更擅长让自己看起来成功？","571":"这需要下一专项解决。","572":"建议将其定义为：","573":"Quality Engineering & Evaluation Governance，简称 QEEG。","574":"它将重点研究：","575":"如何为不同专家、任务类型和工作流定义可执行的质量契约；","576":"如何区分任务完成、产物合格、用户满意和长期效果；","577":"如何为代码、文档、漫剧、研究与自动化任务建立不同的评测方法；","578":"如何组合确定性测试、规则检查、模型评审与人工验收；","579":"如何减少模型评审自身的偏差；","580":"如何建立固定回归集、动态测试集和困难案例集；","581":"如何评价 Router 是否选择了正确的专家；","582":"如何评价 Planner 的分解方式是否合理；","583":"如何评价记忆和上下文压缩是否丢失关键信息；","584":"如何衡量多专家协作带来的真实增益；","585":"如何区分随机波动、任务难度变化和真正的能力提升；","586":"如何防止智能体通过修改评测器、降低标准或隐藏失败来制造虚假的进步；","587":"如何让用户反馈转化为有证据的改进方向；","588":"如何建立跨版本、跨模型、跨设备的可比较评测体系；","589":"如何将质量门槛接入 SELCIA，使所有重要改进都必须证明自己的收益。","590":"这一专项尤其重要，因为它将成为所有自进化模块共同依赖的“进步判定体系”。","591":"APRO 可以提出更高效的调度方案，RERA 可以提出更可靠的恢复方案，CEKCE 可以提出更好的技能，SOCDEA 可以提出根因修复方案。","592":"但最终都需要回答同一个问题：","593":"改进之后，系统是否在真实任务上变得更好？","594":"而且，这个结论必须有独立证据支持，不能仅由提出改进的模块自己宣布。","595":"这就是 QEEG 的核心使命：让 EvoAgent 的持续进化从“不断修改自己”，转变为“持续提出假设、独立验证收益，并只保留真正有效的改进”。"},"fallbackMarkdown":"# EvoAgent 第五十五专项：自适应性能、资源调度与成本优化\n\nAPRO · Adaptive Performance &amp; Resource Optimization\n\n前面已经完成了可靠性专项 RERA 的架构设计。现在进入 APRO，解决 EvoAgent 在个人设备上长期运行时的性能与资源问题。\n\n你的部署方向有一个很重要的特点：**以个人电脑、Android 手机和微型 Linux 主机为核心，不假设存在一台始终在线、资源无限的中央服务器。**\n\n因此，EvoAgent 不能简单照搬大型云端智能体的架构。它必须学会根据设备能力、任务难度、质量要求和当前负载，动态决定该使用什么模型、多少个专家、怎样执行 DAG，以及哪些工作应当延迟。\n\nAPRO 的目标不是单纯减少 Token，也不是让所有任务尽可能快，而是：\n\n**在满足任务质量、安全、可靠性和用户授权要求的前提下，尽量用更少的时间、计算资源和金钱完成任务。**\n\n例如，同样是代码任务：\n\n- 修改一个变量名，不需要启动多个专家；\n- 重构一个复杂模块，可能需要 AST 分析、测试专家和独立代码审查；\n- 生成 60 秒动态漫剧，可能需要大量云端生成预算和本地视频合成资源；\n- 手机正在发热或内存不足时，不应该强行运行多个本地模型；\n- 服务器断网时，应优先选择本地可执行的能力，而不是反复请求已经不可用的服务。\n\n这些场景不能依靠一套固定的模型选择规则解决。它们需要一个能够感知资源、预测成本、控制并发并从实际执行结果中学习的系统。\n\n---\n\n# 一、第一性原理：优化整个任务，而不是孤立的模块\n\nAPRO 首先要避免五种常见的优化误区。\n\n1. **模型越强越好。** 更强的模型可能提高单次推理质量，却不一定提高整个任务的成功率。\n2. **并行越多越快。** 多专家并行可能增加协调成本、内存占用和重复工作。\n3. **上下文越短越省钱。** 过度压缩可能丢失约束，导致返工成本超过节省的 Token。\n4. **缓存越多越高效。** 过期缓存可能使系统使用错误的技能版本、旧代码或失效的任务状态。\n5. **本地运行一定更便宜。** 本地模型可能耗时更长、占用更多内存，也可能使其他任务无法运行。\n\n真正的优化对象应该是整个任务的最终交付成本。\n\n## 1.1 建立统一的任务效用模型\n\n可以把一次任务的综合表现表示为：\n\n\\[\nJ =\nw_q Q +\nw_r R +\nw_t T +\nw_c C +\nw_m M +\nw_e E\n\\]\n\n其中：\n\n- \\(Q\\)：任务质量；\n- \\(R\\)：可靠性与恢复表现；\n- \\(T\\)：完成时间；\n- \\(C\\)：实际费用；\n- \\(M\\)：内存及其他资源占用；\n- \\(E\\)：能耗或设备负载。\n\n这里需要注意，质量和可靠性通常是越高越好，而时间、成本、资源占用通常是越低越好。因此，实现时不能直接对这些原始数值做简单加权求和，而应先进行归一化，并明确各项的优化方向。\n\n更重要的是，**安全、授权和必要的质量验收应当作为硬约束，而不是可以被其他收益抵消的普通评分项。**\n\n例如，不能因为某个策略降低了 50% 的成本，就允许它绕过必要的安全检查。\n\n实际调度可以采用两阶段决策：\n\n1. 先过滤掉违反安全、质量、授权和硬资源限制的方案；\n2. 再在剩余方案中比较延迟、费用、资源消耗和预期收益。\n\n## 1.2 区分三种优化目标\n\n同一个模型或技能，在不同目标下可能具有完全不同的优先级。\n\n例如，后台进化任务即使能够更快完成，也不应该抢占用户正在使用的本地模型所需的全部内存。\n\n---\n\n# 二、总体架构：建立统一的资源感知与调度体系\n\n建议建立六个核心组件。\n\n### 1\\. Resource Monitor\n\n采集 CPU、内存、GPU、磁盘、网络、设备温度、模型驻留和实际调用成本。\n\n### 2\\. Workload Profiler\n\n分析任务类型、历史耗时、成功率、资源需求和并行机会。\n\n### 3\\. Budget Manager\n\n为任务、节点、模型调用、专家团队和后台进化分配预算。\n\n### 4\\. Adaptive Scheduler\n\n选择模型与执行位置，调整 DAG 并行度、专家数量、优先级和降级策略。\n\n### 5\\. Cache &amp; Context Optimizer\n\n管理模型驻留、缓存、记忆检索、上下文组装和压缩策略。\n\n### 6\\. Performance Evaluator\n\n比较实际表现与预测，评估策略是否真正提高了质量、效率和稳定性。\n\n这些组件通过统一的资源预算、任务状态和事件协议协作，不需要成为六个独立的 AI 智能体。\n\n第一版更适合采用确定性调度逻辑和简单的历史统计。随着数据积累，再逐步引入更复杂的预测与自适应策略。\n\n## 2.1 与已有模块的关系\n\n- Router 决定应该由哪个专家处理请求。\n- Planner 决定任务应该分解成哪些节点。\n- APRO 决定这些节点使用什么资源、何时执行、在哪里执行，以及是否需要降低并行度。\n- TERSO 负责落实工具执行与资源限制。\n- RERA 负责故障、重试、恢复和安全停止。\n- GECO 记录实际资源消耗与执行结果。\n- SELCIA 负责评测和发布经过验证的调度改进。\n\n因此，APRO 不应该取代 Router 或 Planner。\n\n**Router 解决能力匹配，Planner 解决任务分解，APRO 解决资源约束下的执行优化。**\n\n---\n\n# 三、统一资源模型：系统必须知道自己还能做什么\n\n如果 APRO 不知道设备当前的资源状况，就只能根据静态配置猜测。\n\n因此，建议建立 `ResourceSnapshot` 和 `ResourceBudget` 两类数据结构。\n\n## 3.1 ResourceSnapshot：当前资源快照\n\n至少应包含：\n\n| 资源类别 | 关键数据 |\n|--------|--------|\n| CPU | 可用核心数、负载、任务队列 |\n| 内存 | 可用内存、进程占用、模型驻留占用 |\n| GPU / NPU | 是否可用、显存或共享内存、当前任务占用 |\n| 磁盘 | 剩余空间、读写压力、临时文件占用 |\n| 网络 | 可用性、延迟、带宽估计 |\n| 模型运行时 | 已加载模型、加载耗时、并发限制 |\n| 外部费用 | 已使用预算、待确认费用、剩余预算 |\n| 设备状态 | 电池、温度、系统资源压力与运行限制 |\n\n并不是所有平台都能提供这些指标。例如，Android 应用可能无法直接获取完整的 GPU 占用或精确的系统级资源信息。\n\n因此，资源快照应当支持 `available`、`estimated` 和 `unknown` 等状态。不能把无法观测的资源当成无限可用。\n\n## 3.2 ResourceBudget：预算不是单一的金额\n\n建议将预算分成以下几个维度：\n\n- **时间预算**：任务允许运行多久；\n- **计算预算**：允许消耗多少 CPU、GPU 时间或推理资源；\n- **Token 预算**：模型输入和输出的允许范围；\n- **费用预算**：允许产生多少外部服务费用；\n- **内存预算**：任务可以占用多少内存；\n- **并发预算**：允许同时运行多少节点、专家和模型请求；\n- **重试预算**：失败后还能进行多少次尝试；\n- **返工预算**：质量不达标时允许多少轮修改。\n\n这些预算需要相互关联。\n\n例如，任务虽然还有 Token 额度，但如果剩余时间不足以完成最终验收，就不应该继续生成大量中间分析。\n\n同样，一个任务可能还有费用额度，但当前设备内存不足，此时应该等待、降级或迁移，而不是继续启动本地模型。\n\n## 3.3 预算采用分层继承与受控分配\n\n建议采用以下层级：\n\n**系统预算**\n\n整台设备的资源安全上限、并发限制与全局费用限制。\n\n**任务预算**\n\n由用户目标、截止时间、质量要求与授权决定。\n\n**DAG 节点预算**\n\n为分析、生成、测试、合成等节点分配资源。\n\n**工具与模型调用预算**\n\n限制单次操作的超时、Token、费用和并发。\n\n下层预算不能突破上层剩余额度。\n\n同时，应区分“预留预算”和“实际消耗”。如果多个节点并行运行，每个节点都把整个任务的剩余额度当作自己可用的预算，就会出现预算超支。\n\n因此，APRO 应通过原子化预留、执行后结算和失败释放等机制管理资源。\n\n---\n\n# 四、动态模型选择：什么时候需要最强模型？\n\n这是 APRO 最重要的能力之一。\n\nEvoAgent 可能接入本地模型、远程模型以及不同价格、延迟和能力水平的模型适配器。不能简单规定所有任务都使用同一个模型，也不能只根据模型名称或参数规模选择。\n\n建议建立 `Model Selection Policy`。\n\n## 4.1 先定义任务所需的能力\n\n每个任务在进入模型调度前，应尽可能明确：\n\n- 任务类型；\n- 所需能力；\n- 难度与不确定性；\n- 质量验收要求；\n- 输入与输出规模；\n- 是否需要工具调用；\n- 是否涉及高风险操作；\n- 可接受的延迟；\n- 可接受的费用；\n- 可用模型与执行环境。\n\n这些信息可以由 Router、Planner、历史统计和任务契约共同提供，不应完全依赖模型自己给出的难度评分。\n\n## 4.2 建立候选模型能力表\n\n建议为每个模型适配器维护一个动态的 `ModelCapabilityProfile`。\n\n| 属性 | 用途 |\n|--------|--------|\n| 任务能力表现 | 在编程、推理、摘要等任务上的历史验收表现 |\n| 上下文容量 | 支持的输入长度与输出限制 |\n| 工具支持 | 是否支持所需的工具调用或结构化输出 |\n| 平均延迟 | 相似任务的历史执行耗时 |\n| 费用 | 输入、输出或其他计费方式 |\n| 资源需求 | 内存、GPU、CPU 与模型加载成本 |\n| 可靠性 | 超时率、失败率、恢复表现 |\n| 适用限制 | 隐私、联网、部署与授权要求 |\n\n模型能力数据应按任务类型分组，并随着实际评测持续更新。\n\n不能因为某个模型在通用问答中表现很好，就默认它在代码修复、复杂规划或结构化输出上同样优秀。\n\n## 4.3 采用逐级升级策略\n\n一个可实施的初始策略是：\n\n这不是强制所有任务都从最低级开始。对于复杂代码迁移、高风险数据处理或明确要求高质量的任务，可以直接选择经过验证的高能力路径。\n\n逐级升级只是默认优化策略，不应增加不必要的尝试次数。\n\n## 4.4 比较总成本，而不是单次调用价格\n\n假设两个模型处理同一类代码任务：\n\n- 模型 A 单次调用成本较低，但经常需要返工；\n- 模型 B 单次调用成本较高，但更容易一次通过测试。\n\n如果只比较单次 Token 费用，可能会错误选择模型 A。\n\n更合理的比较是：\n\n\\[\nC_{\\text{effective}}\n=\nC_{\\text{inference}}\n+\nC_{\\text{tools}}\n+\nC_{\\text{rework}}\n+\nC_{\\text{recovery}}\n\\]\n\n其中包括推理成本、工具成本、返工成本和恢复成本。\n\n实际决策还需要考虑任务失败造成的时间损失，以及质量要求是否已经满足。\n\n例如，模型 A 虽然便宜，但如果它的输出无法通过测试，就不应该仅凭成本优势被选中。\n\n## 4.5 模型切换不能丢失关键上下文\n\n从本地模型切换到远程模型，或者从一个模型适配器切换到另一个模型时，系统必须重新构建经过验证的任务上下文。\n\n不能只把最近几轮聊天内容直接复制过去。\n\n建议传递：\n\n- 当前任务目标；\n- 经过验证的需求与约束；\n- 相关产物和版本；\n- 已经执行的操作；\n- 已知失败及其证据；\n- 剩余预算；\n- 仍然有效的授权范围；\n- 当前节点的验收条件。\n\n这与 ACMO、MEEG 和 CLEK 的上下文设计直接相关。APRO 决定上下文使用多少资源，而记忆与上下文模块负责确保传递的信息仍然准确、完整且适用。\n\n---\n\n# 五、多专家与 DAG 并行：并行不是越多越好\n\nEvoAgent 采用多专家架构，但专家数量增加后，资源开销并不是线性增长。\n\n多个专家可能各自加载模型、检索记忆、重复分析同一问题，还可能需要额外的协调与结果整合。\n\n因此，APRO 必须根据任务结构和设备资源动态决定并行度。\n\n## 5.1 建立 DAG 的资源感知调度\n\nPlanner 负责生成任务 DAG，APRO 负责在 DAG 的依赖约束下调度可执行节点。\n\n每个节点至少应声明：\n\n- 依赖节点；\n- 预计执行时间；\n- 预计内存与计算需求；\n- 预计费用；\n- 是否可并行；\n- 是否具有外部副作用；\n- 是否允许取消；\n- 失败后的恢复策略。\n\nAPRO 根据当前资源情况选择可运行节点，而不是简单地将所有已解锁节点同时启动。\n\n## 5.2 区分三类并行任务\n\n| 类型 | 处理策略 |\n|--------|--------|\n| 高度独立的任务 | 资源充足时优先并行执行 |\n| 有共享模型或资源竞争的任务 | 根据模型驻留、内存与队列情况调整并发 |\n| 存在冲突或强依赖的任务 | 按依赖顺序执行，或通过明确的隔离与合并机制控制冲突 |\n\n例如，两个专家分别分析两个互不相关的代码模块，可能适合并行。\n\n但两个专家同时修改同一个文件，可能造成冲突，增加合并和回归测试成本。\n\n即使 CPU 足够空闲，也不意味着同时修改同一个文件是更好的方案。\n\n## 5.3 估算并行收益\n\n假设任务有多个可并行节点。\n\n理想情况下，关键路径决定最低执行时间；但真实运行还会受到模型加载、资源竞争、任务启动和结果合并的影响。\n\n因此，APRO 应比较：\n\n- 串行执行的预计时间；\n- 并行执行的预计时间；\n- 并行额外消耗的资源；\n- 任务失败或冲突的概率；\n- 合并与验收所需的额外成本。\n\n只有预期收益足够大时，才增加并行度。\n\n## 5.4 专家团队规模应当动态调整\n\n建议将团队规模分为三种模式：\n\n- **单专家模式：** 适用于目标明确、依赖简单的任务；\n- **小团队模式：** 适用于需要专业分工或独立验证的任务；\n- **多专家模式：** 适用于复杂、可分解且并行收益明确的任务。\n\nAPRO 不应仅凭任务字数或表面复杂度增加专家。\n\n更有价值的判断是：新增专家是否能够提供独立的专业能力、减少关键路径耗时，或者提高验证质量。\n\n如果多个专家只是重复回答同一个问题，就应减少冗余调用。\n\n---\n\n# 六、记忆与上下文优化：省下的 Token 不能靠返工还回去\n\n这一部分与此前讨论的 ACMO、MEEG、CLEK 和各领域专家直接相关。\n\nAPRO 不能把上下文压缩当作一个全局统一的“缩短文本”任务。它需要根据任务阶段、专家职责和信息的重要性，决定哪些内容应该加载、哪些内容可以摘要、哪些内容必须保留原始证据。\n\n## 6.1 建立分层上下文预算\n\n建议把上下文分成五个逻辑层：\n\n这里的层级是逻辑分层，不代表每次请求都必须把前四层完整复制到模型上下文中。\n\n系统应按任务需要选择内容，并确保不可省略的授权与验收约束在压缩和模型切换后仍然有效。\n\n## 6.2 压缩应保留什么？\n\n建议为上下文压缩建立独立的 `ContextRetentionPolicy`。\n\n高优先级信息包括：\n\n- 用户明确提出的约束；\n- 当前有效的授权；\n- 已验证的事实与证据引用；\n- 已完成的操作及其实际结果；\n- 尚未解决的问题；\n- 任务依赖和版本信息；\n- 不可逆操作的状态；\n- 失败原因及已尝试过的方法；\n- 最终验收条件。\n\n可压缩的信息包括重复解释、已经解决且不再影响当前任务的讨论，以及能够通过稳定引用重新读取的长文档。\n\n但对于代码任务，不应只保留“修改了某个函数”的摘要，而忽略实际代码版本、测试结果和变更差异。\n\n对于漫剧任务，也不能只保留“角色素材已生成”，而不保存角色版本、素材引用和质量验收状态。\n\n## 6.3 全局压缩与专家专用压缩应当分开\n\n建议保留两种能力：\n\n- **全局上下文治理：** 统一管理 token 预算、保留规则、隐私限制和任务连续性。\n- **领域专用压缩器：** 由不同专家针对特定内容使用适合的结构化表示。\n\n例如：\n\n- 编程专家可以保留 AST 结构、符号引用、代码差异和测试证据；\n- 漫剧专家可以保留角色 ID、场景 ID、分镜关系、时间线和素材版本；\n- 研究专家可以保留论点、来源、证据强度与待验证假设；\n- 数据分析专家可以保留数据 Schema、筛选条件、转换步骤和统计结果。\n\n这也回答了此前的一个重要问题：上下文压缩不应该只有一个通用算法，也不应该让每个专家各自发明一套互不兼容的记忆系统。\n\n**全局模块负责统一治理，领域模块负责专业表达。**\n\n## 6.4 缓存必须具备失效机制\n\n缓存可以减少重复推理、重复读取和重复生成，但需要明确缓存的适用条件。\n\n建议将缓存键与以下信息关联：\n\n- 输入内容摘要；\n- 任务或节点类型；\n- 模型与技能版本；\n- 关键配置；\n- 数据依赖版本；\n- 权限和隐私范围；\n- 必要的运行环境信息。\n\n如果代码文件发生变化，基于旧代码生成的分析缓存可能失效；如果技能版本升级，旧版本的执行结果也不应自动成为新版本正确性的证据。\n\n缓存只是一种性能优化，不是可信事实的替代品。\n\n---\n\n# 七、本地、远程与跨设备调度：根据任务选择执行位置\n\nEvoAgent 的部署路线不是单一云端系统，而是个人设备优先。\n\n因此，APRO 需要建立 `Execution Placement Policy`，决定任务应该在手机、个人电脑、微型 Linux 主机还是外部服务中执行。\n\n## 7.1 建立执行位置的选择维度\n\n| 维度 | 需要考虑的问题 |\n|--------|--------|\n| 能力匹配 | 该设备是否具备所需模型、工具与运行环境？ |\n| 资源条件 | 当前内存、计算能力和磁盘空间是否足够？ |\n| 网络条件 | 是否需要联网？网络延迟和稳定性如何？ |\n| 隐私要求 | 任务数据是否允许离开本地设备？ |\n| 执行成本 | 远程调用费用是否值得？ |\n| 恢复能力 | 任务中断后能否恢复，产物能否可靠同步？ |\n| 用户体验 | 是否会影响当前前台操作、电池或设备温度？ |\n\n不能只根据设备算力选择执行位置。\n\n例如，本地 Linux 主机可能有足够的计算能力，但如果某个任务涉及不能离开手机的私有数据，就不能为了速度自动把数据发送到远程服务。\n\n## 7.2 建立三种执行模式\n\n这些是任务级执行策略，不是要求整个 EvoAgent 永远固定在其中一种模式。\n\n同一任务的不同节点可以采用不同执行位置，但每次跨设备或跨信任边界的数据传输，都必须重新检查授权和数据使用范围。\n\n## 7.3 断网时需要明确降级策略\n\n如果外部模型不可用，APRO 可以：\n\n1. 选择经过验证且能够完成该步骤的本地模型；\n2. 使用确定性工具或规则能力完成不需要模型的步骤；\n3. 暂停依赖外部服务的节点，继续执行独立节点；\n4. 保存检查点，等待网络恢复；\n5. 在预算或质量要求无法满足时，明确请求用户决策。\n\n不能为了让任务看起来持续运行，就用明显不具备相应能力的本地模型生成未经验证的结果。\n\n## 7.4 Android 必须考虑设备状态\n\n手机资源调度和桌面电脑不同。\n\n除了内存、CPU 和网络，APRO 还应考虑：\n\n- 电池电量与充电状态；\n- 设备温度与系统热限制；\n- 后台执行限制；\n- 用户是否正在进行前台交互；\n- 模型驻留对其他应用的影响。\n\n如果手机正在发热，可以暂停非必要的本地模型推理，延后后台索引和进化评测。\n\n但是，设备降温或资源释放不能通过跳过关键状态保存、授权检查或安全停止流程来实现。\n\n---\n\n# 八、成本控制：不只是 Token，更要关注返工和外部费用\n\nEvoAgent 未来可能接入代码执行、云端视频生成、语音合成、文件处理和其他第三方服务。\n\n这些服务的费用结构差异很大。单纯统计模型 Token，无法反映整个任务的真实成本。\n\n## 8.1 建立统一的 Cost Ledger\n\n建议建立 `CostLedger`，至少记录：\n\n- 任务与节点 ID；\n- 模型或服务名称；\n- 调用次数；\n- 输入与输出 Token；\n- 实际或估算费用；\n- 费用确认状态；\n- 重试与返工产生的费用；\n- 任务预算；\n- 剩余额度；\n- 成本对应的产物与验收结果。\n\n对于按量计费但账单延迟返回的外部服务，应区分已确认费用与估算费用。\n\nAPRO 不应将尚未确认的费用视为零。\n\n## 8.2 预算分配应根据任务结构决定\n\n例如，一个 AI 漫剧任务可以将预算划分为：\n\n- 剧本与分镜；\n- 角色和场景素材；\n- 视频片段生成；\n- 配音与音频处理；\n- 本地合成；\n- 质量验收；\n- 必要的返工预留。\n\n具体比例应根据服务定价、历史成功率和用户质量要求动态估算，而不是硬编码一个适用于所有任务的固定比例。\n\n如果前面的角色素材质量不达标，系统就不应该继续投入大量视频生成费用。\n\n## 8.3 采用阶段性投入策略\n\n对于高成本生成任务，建议在阶段边界进行质量门控：\n\n1. 先生成低成本的候选内容；\n2. 验证结构、时长、角色和基础质量；\n3. 只有满足条件后，才进入更昂贵的生成阶段；\n4. 保留必要的返工预算；\n5. 如果关键约束持续不满足，暂停并请求用户确认。\n\n这能避免错误的上游输入持续放大后续费用。\n\n## 8.4 评价成本时必须结合产出质量\n\n一个成本很低但最终不能交付的任务，不应被评为优化成功。\n\n建议同时比较：\n\n- 每个验收通过任务的平均成本；\n- 每个合格产物的平均成本；\n- 返工成本；\n- 失败任务的沉没成本；\n- 资源占用与耗时；\n- 质量是否达到用户要求。\n\n这使 APRO 优化的是“合格交付的成本”，而不是单纯的调用价格。\n\n---\n\n# 九、前台、后台与进化任务：资源优先级必须统一\n\nEvoAgent 不仅需要执行用户任务，还可能在后台进行记忆整理、技能评测、工作流分析和进化实验。\n\n如果这些任务各自独立调度，就可能发生资源争抢。\n\n例如，用户正在让编程专家修改代码，后台 SELCIA 同时启动多个候选模型评测，导致本地模型被卸载、内存压力上升，前台任务响应变慢。\n\n因此，建议 APRO 建立统一的 `WorkloadPriorityManager`。\n\n## 9.1 建立五类工作负载\n\n| 工作负载 | 默认优先级 | 调度原则 |\n|--------|--------|--------|\n| 安全控制与关键状态持久化 | 最高 | 保证必要的授权撤销、状态记录与安全停止能力 |\n| 用户前台交互 | 高 | 优先保证响应性和当前任务连续性 |\n| 正在执行的关键任务 | 中高 | 尽量减少中断，保护已投入的计算与工作进度 |\n| 普通后台维护 | 中低 | 在资源充足时执行，可暂停和恢复 |\n| 进化实验与批量评测 | 低 | 使用剩余资源，必要时主动让出资源 |\n\n这是一套建议的默认优先级，不是所有任务都必须采用完全相同的固定顺序。\n\n例如，用户明确启动的大规模视频生成任务可能需要持续占用资源；而后台安全更新或授权撤销相关操作则不应被普通用户任务阻塞。\n\n## 9.2 防止优先级反转\n\n如果高优先级任务依赖某个低优先级任务持有的资源，就可能出现优先级反转。\n\n例如，前台任务需要加载模型，但后台任务占用了大部分内存。\n\nAPRO 可以在必要时暂停后台任务、释放非必要缓存，或者限制其继续申请资源。\n\n同时，关键任务也不能无限制地抢占所有资源，否则可能导致其他必要的系统维护永远无法完成。\n\n## 9.3 后台任务必须可暂停、可恢复\n\n建议后台进化和批量评测任务具备：\n\n- 明确的检查点；\n- 可释放的模型与内存资源；\n- 可暂停的工作单元；\n- 恢复后的版本核验；\n- 独立的预算；\n- 对前台资源压力的响应机制。\n\n当资源不足时，系统应优先暂停可恢复的后台任务，而不是让所有任务一起进入不可控状态。\n\n---\n\n# 十、性能分析与自适应优化：不要凭感觉调参\n\nAPRO 还需要解决一个长期问题：系统怎样知道真正的瓶颈在哪里？\n\n例如，任务响应慢，原因可能是：\n\n- Router 多次调用模型；\n- 模型加载时间过长；\n- DAG 并行度不足；\n- 工具执行等待外部服务；\n- 上下文过长；\n- 磁盘 I/O 成为瓶颈；\n- 多专家重复工作；\n- 返工次数过多。\n\n如果没有明确的性能证据，系统很容易优化错方向。\n\n## 10.1 建立端到端耗时分解\n\n建议为每个任务追踪以下耗时：\n\n\\[\nT_{\\text{total}}\n=\nT_{\\text{queue}}\n+\nT_{\\text{routing}}\n+\nT_{\\text{planning}}\n+\nT_{\\text{execution}}\n+\nT_{\\text{waiting}}\n+\nT_{\\text{validation}}\n\\]\n\n这只是便于诊断的概念分解。对于并行 DAG，端到端耗时不能简单地把所有节点耗时相加，而应结合关键路径和实际等待关系分析。\n\n例如，如果模型推理只占总耗时的 20%，即使把推理速度提升一倍，整个任务的耗时也不会减少一半。\n\n因此，APRO 应优先识别关键路径上的主要瓶颈。\n\n## 10.2 采用分层优化策略\n\n建议按以下顺序进行优化：\n\n1. **消除无效工作。** 减少重复推理、无效重试和冗余专家调用。\n2. **优化任务结构。** 改善 DAG 分解、依赖关系和数据传递。\n3. **优化上下文。** 减少无关内容，复用可验证的中间结果。\n4. **优化调度。** 调整并行度、优先级、模型驻留和资源分配。\n5. **优化单次执行。** 在前面几项完成后，再优化模型选择、推理参数和底层性能。\n\n这样可以避免用更快的模型掩盖糟糕的工作流设计。\n\n## 10.3 建立策略实验机制\n\n对于模型选择、并行度、上下文压缩和缓存策略，APRO 可以提出不同候选方案，并在隔离环境中比较。\n\n实验应固定或记录：\n\n- 任务样本；\n- 模型与技能版本；\n- 质量验收条件；\n- 资源环境；\n- 费用统计口径；\n- 测试数据；\n- 失败与恢复规则。\n\n如果实验环境与真实运行环境差异较大，系统不能直接把实验结果视为生产环境中的确定收益。\n\n## 10.4 优化策略必须可回滚\n\n例如，APRO 学到“增加专家数量可以提高复杂代码任务的成功率”。\n\n这条经验可能只在特定模型、设备和任务分布下成立。\n\n因此，策略发布后应继续监控：\n\n- 实际成功率；\n- 端到端耗时；\n- 返工率；\n- 费用；\n- 设备资源压力；\n- 不同任务类型的表现。\n\n一旦出现明显退化，就应恢复到经过验证的稳定策略，而不是让错误的自适应规则持续影响后续任务。\n\n---\n\n# 十一、APRO 与自进化的边界：调度器不能为了省资源破坏质量\n\nAPRO 本身也会成为进化对象。\n\n系统可能发现某个路由策略浪费了很多 Token，或者某个专家团队经常产生重复结果，于是提出优化方案。\n\n但资源优化很容易出现“局部指标改善、整体质量下降”的情况。\n\n例如：\n\n- 减少独立代码审查，降低成本，却增加缺陷漏检；\n- 缩短上下文，降低 Token 消耗，却导致需求约束丢失；\n- 减少回归测试，加快交付，却提高回归风险；\n- 降低检查点频率，减少磁盘写入，却增加崩溃后的重做成本；\n- 将所有任务切换到本地模型，降低外部费用，却导致任务无法在截止时间前完成。\n\n因此，APRO 必须接受三个不可突破的原则。\n\n**第一，安全与授权是硬约束。** 资源不足不能成为绕过 TSEG 的理由。\n\n**第二，任务验收标准不能由优化器自行降低。** UQEAG 的必要质量要求不能因为成本压力而自动消失。\n\n**第三，调度策略的进化必须独立评测。** 优化器不能只依据自己生成的预测值宣称成功，必须比较实际结果。\n\n建议将 APRO 的策略发布纳入 SELCIA，并要求 GECO 持续记录策略版本、实际资源消耗、质量结果和退化信号。\n\n---\n\n# 十二、架构决策记录 ADR-781～ADR-800\n\n以下建议纳入 EvoAgent 全量架构，作为 APRO 的治理基线。\n\n这些是建议纳入全量架构的资源治理基线。工程实施时，还需要进一步定义 `ResourceSnapshot`、`ResourceBudget`、`ModelCapabilityProfile`、`CostLedger`、`ExecutionPlacementPolicy` 和 `WorkloadPriorityManager` 的接口、状态机与持久化协议。\n\n---\n\n# 十三、第一版实施路线：先做可测量的优化，不急着让系统自主学习调度\n\n对于个人部署的 EvoAgent，APRO 第一版不需要训练一个复杂的资源调度模型。先把资源、费用、质量和执行耗时记录准确，通常比立即引入强化学习或复杂预测器更有价值。\n\n## 13.1 第一版的验收标准\n\n建议使用三种不同的任务验证 APRO：\n\n- 一个简单聊天任务；\n- 一个包含分析、修改和测试的代码任务；\n- 一个包含多个生成与合成阶段的漫剧任务。\n\n系统应当能够：\n\n1. 记录任务执行前的资源状态；\n2. 选择符合质量要求的模型和能力；\n3. 在资源不足时限制并发或延后后台任务；\n4. 记录每个节点的实际耗时与成本；\n5. 识别重复推理、无效重试和高成本返工；\n6. 保持上下文压缩后的任务约束和证据完整；\n7. 在模型切换或断网后维持有效的任务状态；\n8. 比较优化前后的质量、耗时、费用和资源占用；\n9. 在优化策略造成退化时回滚；\n10. 证明资源优化没有绕过安全、可靠性和最终验收要求。\n\n只有这些指标能够可靠测量，后续的自适应调度才有可信的学习基础。\n\n---\n\n# 十四、下一专项：质量工程、评测体系与结果可信度\n\n到这里，我们已经系统讨论了多个核心领域：\n\n- 多专家与协作机制；\n- Router、Plan、ReAct 与任务 DAG；\n- 记忆、上下文与领域专用能力；\n- GECO 全局观测与因果证据；\n- TSEG 安全与进化治理；\n- RERA 可靠性与恢复保证；\n- APRO 性能、资源与成本优化。\n\n但这些系统还存在一个共同问题：\n\n**我们如何知道 EvoAgent 真正变得更好了，而不是仅仅变得更快、更便宜、更复杂，或者更擅长让自己看起来成功？**\n\n这需要下一专项解决。\n\n建议将其定义为：\n\n**Quality Engineering &amp; Evaluation Governance，简称 QEEG。**\n\n它将重点研究：\n\n1. 如何为不同专家、任务类型和工作流定义可执行的质量契约；\n2. 如何区分任务完成、产物合格、用户满意和长期效果；\n3. 如何为代码、文档、漫剧、研究与自动化任务建立不同的评测方法；\n4. 如何组合确定性测试、规则检查、模型评审与人工验收；\n5. 如何减少模型评审自身的偏差；\n6. 如何建立固定回归集、动态测试集和困难案例集；\n7. 如何评价 Router 是否选择了正确的专家；\n8. 如何评价 Planner 的分解方式是否合理；\n9. 如何评价记忆和上下文压缩是否丢失关键信息；\n10. 如何衡量多专家协作带来的真实增益；\n11. 如何区分随机波动、任务难度变化和真正的能力提升；\n12. 如何防止智能体通过修改评测器、降低标准或隐藏失败来制造虚假的进步；\n13. 如何让用户反馈转化为有证据的改进方向；\n14. 如何建立跨版本、跨模型、跨设备的可比较评测体系；\n15. 如何将质量门槛接入 SELCIA，使所有重要改进都必须证明自己的收益。\n\n这一专项尤其重要，因为它将成为所有自进化模块共同依赖的“进步判定体系”。\n\nAPRO 可以提出更高效的调度方案，RERA 可以提出更可靠的恢复方案，CEKCE 可以提出更好的技能，SOCDEA 可以提出根因修复方案。\n\n但最终都需要回答同一个问题：\n\n**改进之后，系统是否在真实任务上变得更好？**\n\n而且，这个结论必须有独立证据支持，不能仅由提出改进的模块自己宣布。\n\n这就是 QEEG 的核心使命：让 EvoAgent 的持续进化从“不断修改自己”，转变为“持续提出假设、独立验证收益，并只保留真正有效的改进”。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6-thinking","turn_exchange_id":"cb360f0f-d3c1-4f82-b30e-634b23a83a6b","request_id":"620ee1c0-586f-4db3-bd52-1d94e34759d8","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"working_turn_id":"cb360f0f-d3c1-4f82-b30e-634b23a83a6b","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":true,"parent_id":"00359aab-58fb-481d-aa89-669744b4f649","logical_answer_prefix_activity":{"visibility":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"},{"id":"bbb211de-1f6f-47e2-9bd4-bd05225d53e9","author":{"role":"user","name":null,"metadata":{}},"create_time":1792510926.697793,"update_time":1792511231.180511,"content":{"content_type":"text","parts":["可以"]},"status":"finished_successfully","end_turn":null,"weight":1.0,"metadata":{"model_slug":"gpt-6-thinking","default_model_slug":"gpt-6-thinking","is_visually_hidden_from_conversation":false,"search_result_groups":[],"search_queries":[],"image_results":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","real_time_audio_has_video":false,"system_hints":[],"dictation":false,"voice_mode_message":false,"trigger_async_ux":false,"writing_blocks":{},"request_id":"c5162f45-9ee1-4d0b-9806-f3620ea6594d","message_source":null,"turn_exchange_id":"ba13a8e2-9ea2-4fb0-9989-30faa0555653","working_turn_id":"ba13a8e2-9ea2-4fb0-9989-30faa0555653","can_save":false},"recipient":"all","channel":null},{"id":"b0c26a32-6bb4-4c1a-9e79-068badca9365","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792511166.952933,"update_time":1792511166.95998,"content":{"content_type":"reasoning_recap","content":"思考了 3m 59s"},"status":"finished_successfully","end_turn":false,"weight":1.0,"metadata":{"reasoning_status":"reasoning_ended","finished_duration_sec":239,"reasoning_start_time":1792510927.1683226,"reasoning_end_time":1792511166.9344256,"reasoning_recap_type":"hide_all","cot_version":"v5","reasoning_group_id":"f4e61b08-0914-47b4-8446-38f785ff47fd","conversation_followup_suggestions_eligible":false,"request_id":"c5162f45-9ee1-4d0b-9806-f3620ea6594d","message_type":"next","turn_exchange_id":"ba13a8e2-9ea2-4fb0-9989-30faa0555653","working_turn_id":"ba13a8e2-9ea2-4fb0-9989-30faa0555653","model_slug":"gpt-6-thinking","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":false,"parent_id":"bc554f5d-2f4f-421b-9fef-6bf7a87b8776","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"a4f61f00-9ddb-435b-a089-8f58fa1def1b","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792510933.201869,"update_time":1792511207.723777,"content":{"content_type":"text","parts":["# EvoAgent 第五十六专项：质量工程、评测体系与进化治理\n\n<text color=\"secondary\" size=\"sm\">QEEG · Quality Engineering & Evaluation Governance</text>\n\n前面我们已经讨论了专家系统、任务 DAG、记忆与上下文、GECO 观测、TSEG 安全、RERA 可靠性，以及 APRO 性能与成本优化。\n\n现在进入一个决定 EvoAgent 能否真正持续进化的核心专项：**如何定义好坏、如何验证改进，以及如何防止系统错误地认为自己已经进步。**\n\n这次需要从第一性原理重新思考。\n\n假设 EvoAgent 的编程专家升级了一个版本：\n\n- 任务完成速度提高了 30%；\n- Token 消耗减少了 25%；\n- 模型自评的满意度从 80 分提高到了 92 分；\n- 但实际回归测试通过率从 95% 降到了 88%。\n\n这个版本算不算进步？\n\n显然，不能只看速度、成本或模型自己的评分。对于代码交付，回归测试退化可能意味着整个改进不可接受。\n\n再假设另一种情况：一个版本的成功率从 80% 提高到 85%，但只测试了 10 个任务，而且这些任务比旧版本简单得多。这也不能证明能力真正提高了。\n\n更复杂的是，如果负责改进的智能体能够修改测试用例、评测器或成功标准，它甚至可能通过降低难度，让自己的分数越来越高。\n\n因此，QEEG 不能只是一个评分模块。它必须成为贯穿 EvoAgent 所有专家、技能、工作流、路由策略和自进化方案的**独立质量验证体系**。\n\n本专项要回答九个问题：\n\n1. 什么才算任务真正完成？\n2. 不同领域的质量应该怎样定义？\n3. 哪些结果可以自动验证，哪些需要人工判断？\n4. 怎样评测 Router、Planner、ReAct、专家和记忆系统？\n5. 怎样证明多专家协作比单专家更好？\n6. 如何区分真实进步、随机波动和任务难度变化？\n7. 如何防止评测器被优化对象操纵？\n8. 如何将评测结果接入 SELCIA 的发布与回滚流程？\n9. 怎样让用户反馈持续改善质量，而不让系统被少数异常反馈带偏？\n\n核心原则是：\n\n**系统可以自行提出改进、生成测试和解释结果，但正式晋升必须依据独立、可追溯、与任务目标一致的证据。**\n\n---\n\n# 一、第一性原理：质量不是一个分数\n\n智能体很容易把复杂任务压缩成一个看似精确的数字，例如“质量 92 分”。\n\n但不同任务的质量结构完全不同。\n\n- 代码能否正确运行，不能只看代码是否整洁；\n- 研究报告是否可靠，不能只看文字是否流畅；\n- 漫剧是否合格，不能只看画面是否漂亮；\n- 手机自动化是否成功，不能只看操作步骤是否执行；\n- 记忆系统是否有效，不能只看检索结果是否相关；\n- Router 是否准确，不能只看它是否选中了某个热门专家。\n\n因此，QEEG 首先要将质量从单一分数拆成**质量契约、验证证据、约束门槛和综合评价**。\n\n## 1.1 四层质量模型\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"L1 · 目标符合性\",\"系统是否理解并完成了用户真正要求的事情？\"],\n    [\"L2 · 产物正确性\",\"结果是否满足可验证的事实、功能、结构与领域约束？\"],\n    [\"L3 · 交付可靠性\",\"结果是否经过必要测试，能够稳定使用，并且没有未解决的关键风险？\"],\n    [\"L4 · 效率与体验\",\"在满足前面要求的前提下，时间、费用、可维护性和用户体验是否合理？\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"L4 · 效率与体验\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这四层不能简单互相抵消。\n\n例如，任务极快完成，但没有满足用户的核心要求，就不能因为速度优势获得高质量结论。\n\n同样，代码测试全部通过，但程序未经授权修改了用户目录之外的文件，也不能被判定为合格交付。\n\n## 1.2 区分硬性门槛与可权衡指标\n\n建议把质量要求分为两类。\n\n**硬性门槛：**\n\n- 必须满足的用户约束；\n- 必须通过的功能测试；\n- 必须遵守的安全和授权规则；\n- 必须达到的产物完整性要求；\n- 必须完成的关键验收步骤。\n\n**可权衡指标：**\n\n- 完成速度；\n- 成本；\n- 可读性；\n- 维护便利性；\n- 视觉表现；\n- 用户体验；\n- 非关键的优化程度。\n\n可权衡指标可以在不同任务之间采用不同权重，但硬性门槛不能被平均分抵消。\n\n建议将正式验收表示为：\n\n\\[\n\\operatorname{Accept}(x)\n=\n\\operatorname{GatesPass}(x)\n\\land\n\\operatorname{EvidenceSufficient}(x)\n\\]\n\n其中 \\(x\\) 是待验收产物。\n\n通过所有必要门槛且证据充分，才有资格进入综合质量评价。如果必要证据缺失，应标记为“未能确认合格”，而不是默认通过。\n\n---\n\n# 二、建立统一质量契约：每项任务先明确怎样才算成功\n\nQEEG 的核心对象不是一个抽象的“评分”，而是 `QualityContract`。\n\n它定义当前任务需要交付什么、必须满足哪些条件、如何验证，以及证据不足时应该怎样处理。\n\n## 2.1 质量契约包含哪些内容？\n\n建议至少包括：\n\n| 字段 | 作用 |\n|---|---|\n| `goal_ref` | 关联用户目标与任务契约 |\n| `deliverables` | 明确需要交付的产物 |\n| `acceptance_criteria` | 定义合格条件 |\n| `hard_gates` | 定义不可被综合评分抵消的门槛 |\n| `validators` | 指定需要运行的测试、规则或评审方法 |\n| `evidence_requirements` | 定义通过验收必须提供的证据 |\n| `quality_dimensions` | 定义可比较的质量维度 |\n| `risk_profile` | 确定验证深度与人工确认要求 |\n| `budget_constraints` | 记录时间、费用与资源约束 |\n| `version` | 追踪契约变更 |\n| `unknown_policy` | 规定证据缺失、无法验证时的处理方式 |\n\n质量契约可以由用户明确提供，也可以由 Planner 根据请求生成候选，再通过结构化澄清或已验证的默认规则确定。\n\n对于低风险、目标清楚的任务，不必每次都打断用户确认全部细节。\n\n但对于高风险或验收条件不明确的任务，系统不能默默假设一个宽松标准。\n\n## 2.2 质量契约不能被待验收对象随意修改\n\n例如，编程专家生成了代码，并且测试失败。\n\n它可以提出修复方案，但不能为了让当前代码通过而自行删除失败测试或降低验收标准。\n\n如果发现原始质量契约存在错误，可以提出单独的契约变更请求。\n\n变更必须记录：\n\n- 原始要求；\n- 修改原因；\n- 新旧契约差异；\n- 对任务结果的影响；\n- 谁或哪个受控流程批准了变更。\n\n如果要求来自用户，涉及用户目标或交付标准的实质性变更，应按照授权策略请求用户确认。\n\n这也是 QEEG 与 TSEG 的重要接口：质量标准可以演进，但不能被待评测的对象悄悄重写。\n\n## 2.3 质量契约与领域专家如何配合？\n\n建议采用两级结构：\n\n- **全局质量契约：** 目标符合性、安全、可靠性、交付完整性、证据要求。\n- **领域质量契约：** 编程、漫剧、研究、数据分析等领域自己的专业标准。\n\n例如，代码专家可以增加单元测试、静态分析和接口兼容性要求；漫剧专家可以增加角色一致性、音画同步、时长和画面质量要求。\n\n领域专家可以提出专业验收条件，但不能覆盖全局硬性门槛。\n\n---\n\n# 三、评测体系：不同问题必须使用不同的验证方法\n\n不是所有任务都能通过同一种方法判断质量。\n\n代码可以运行测试，数据分析可以检查计算结果，研究报告需要核对来源，创意作品需要综合评价，而 Router 的准确性需要对照真实任务意图和适用专家能力。\n\n因此，QEEG 应建立统一的评测编排机制 `Evaluation Orchestrator`，但允许不同领域使用专门的验证器。\n\n## 3.1 建立六类评测器\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"E1 · 确定性验证器\",\"使用测试、Schema 校验、文件完整性检查、数值校验和规则引擎验证明确条件。\"],\n    [\"E2 · 执行验证器\",\"在受控环境中实际运行程序、工作流或工具，观察行为是否符合预期。\"],\n    [\"E3 · 证据验证器\",\"检查来源、引用、版本、数据血缘和事实证据是否支持结果。\"],\n    [\"E4 · 模型辅助评审器\",\"评价难以完全规则化的内容，例如表达质量、解释完整性和视觉连贯性。\"],\n    [\"E5 · 人工评审器\",\"处理高风险、存在实质歧义或必须由用户决定的事项。\"],\n    [\"E6 · 真实结果评估器\",\"在有可靠反馈与明确统计口径时，评估用户后续采用、实际效果和长期表现。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"E6 · 真实结果评估器\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这些评测器可以组合使用。\n\n例如，一份研究报告可以同时经过结构检查、来源核验、事实交叉验证和模型辅助评审。模型评审不能替代来源核验，格式检查也不能证明结论正确。\n\n## 3.2 建立证据等级\n\n建议统一记录评测结论的证据状态：\n\n- `PASS`：必要条件已通过验证；\n- `FAIL`：有证据表明必要条件不满足；\n- `INCONCLUSIVE`：证据不足，无法判断；\n- `NOT_APPLICABLE`：该条件不适用于当前任务；\n- `BLOCKED`：因权限、依赖或环境限制，无法执行必要验证。\n\n这些状态不能随意互相转换。\n\n例如，测试环境不可用时，不能将 `BLOCKED` 自动转成 `PASS`；模型认为代码“看起来正确”，也不能替代实际执行测试。\n\n最终任务状态应结合所有必要门槛判定，而不是把五个通过项和一个未知项平均成一个高分。\n\n## 3.3 确定性验证应优先\n\n凡是可以用低成本、稳定、可复现的方式验证的条件，都应优先使用确定性方法。\n\n例如：\n\n- JSON 输出是否符合 Schema；\n- 代码是否通过规定的测试；\n- 文件是否存在且哈希正确；\n- 数据总量是否守恒；\n- 生成视频是否满足时长与编码要求；\n- 任务是否遵守预算；\n- 指定的操作是否真的完成；\n- 引用的来源是否存在且支持相关结论。\n\n只有无法通过确定性方法充分判断的部分，才需要增加模型辅助评审或人工评审。\n\n这不仅能够提高可靠性，还能降低评测费用和模型评审的随机性。\n\n---\n\n# 四、领域评测：每种专家都需要自己的质量标准\n\nEvoAgent 的专家体系不能只区分“谁负责什么”，还必须区分“怎样证明该专家做得好”。\n\n建议建立 `DomainEvaluationPack`，让每个专家绑定一套领域专用评测集、评测器和质量契约。\n\n## 4.1 编程专家\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  <title size=\"md\">核心质量维度</title>\n  - 功能正确性与回归测试\n  - 接口兼容性与需求符合度\n  - 静态分析、类型检查与必要的 AST 结构检查\n  - 安全性与依赖风险\n  - 代码可维护性与复杂度\n  - 修改范围与副作用控制\n  <divider color=\"subtle\"/>\n  <title size=\"md\">主要证据</title>\n  <text color=\"secondary\" size=\"sm\">测试结果、代码差异、静态分析报告、执行日志、依赖版本、变更范围和验收契约。</text>\n</box>\n\n编程任务不能只靠另一个模型阅读代码后给出高分。\n\n如果存在可运行的测试，应优先执行；如果缺乏测试，则应明确标记验证覆盖不足，而不是把模型评审当成完整替代品。\n\n## 4.2 AI 漫剧专家\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  <title size=\"md\">核心质量维度</title>\n  - 剧情与分镜的一致性\n  - 角色外观与身份连续性\n  - 画面质量、构图与镜头连贯性\n  - 配音、字幕和画面的同步\n  - 时长、分辨率、帧率和音视频编码\n  - 生成费用、返工率与交付完整性\n  <divider color=\"subtle\"/>\n  <title size=\"md\">主要证据</title>\n  <text color=\"secondary\" size=\"sm\">角色素材 ID、分镜与时间线、生成服务任务记录、视频抽帧、音频检测、FFmpeg 输出日志及最终文件验证。</text>\n</box>\n\n部分技术条件可以自动检测，但剧情感染力、视觉风格和角色一致性的整体感知通常需要多种证据结合。\n\n单个视觉模型的评分不能直接等同于观众的真实体验。\n\n## 4.3 研究与文档专家\n\n<box border radius=\"lg\" padding={3} gap={2}>\n  <title size=\"md\">核心质量维度</title>\n  - 事实准确性与来源可靠性\n  - 引用是否真实支持对应结论\n  - 论证是否完整、存在矛盾或遗漏\n  - 事实、推断与假设是否清晰区分\n  - 是否覆盖用户要求的范围\n  - 结构、可读性与交付格式\n  <divider color=\"subtle\"/>\n  <title size=\"md\">主要证据</title>\n  <text color=\"secondary\" size=\"sm\">原始来源、引用映射、事实核验结果、覆盖清单、论证结构与文档格式检查。</text>\n</box>\n\n对于研究报告，流畅的语言并不能证明结论可靠。尤其是高影响结论，需要更严格的来源核验和不确定性说明。\n\n## 4.4 数据分析专家\n\n核心质量维度应包括：\n\n- 数据输入与 Schema 正确性；\n- 数据清洗和转换可追溯性；\n- 计算逻辑与统计方法正确性；\n- 可复现性；\n- 结果解释是否超出证据范围；\n- 可视化是否准确表达数据。\n\n主要证据包括原始数据引用、转换步骤、计算代码、校验结果和可复现输出。\n\n## 4.5 Router 与 Planner 本身也需要评测\n\n不能只评测最终产物，还要评测决定任务如何执行的上游组件。\n\nRouter 应评测：\n\n- 是否选择了适合的专家；\n- 是否正确识别多领域任务；\n- 是否能够发现能力缺口；\n- 是否在不确定时合理澄清或回退；\n- 是否避免不必要的专家调用。\n\nPlanner 应评测：\n\n- 是否覆盖所有必要子目标；\n- DAG 依赖是否正确；\n- 是否存在无意义节点；\n- 是否遗漏关键验收步骤；\n- 计划是否符合预算与执行环境；\n- 上游变更后是否正确识别下游影响。\n\n但需要注意，Router 选择了与标准标签不同的专家，不一定意味着路由错误。只要另一专家同样具备所需能力，并且实际完成质量合格，就应允许评测记录多个合理路径。\n\n因此，Router 的评测不能完全依赖单一的“标准答案专家 ID”。\n\n---\n\n# 五、ReAct、Plan、专家和 DAG：怎样分别评测？\n\n这是 EvoAgent 架构中的一个关键问题。\n\nRouter、Planner、ReAct 循环、专家和 DAG 处于不同层级。如果全部使用最终任务成功率来评价，就很难知道到底是哪一部分产生了改善或退化。\n\n建议建立分层评测模型。\n\n| 对象 | 主要评测目标 | 关键证据 |\n|---|---|---|\n| Router | 能力匹配、路由准确性、澄清与回退质量 | 任务标签、候选专家、路由决策与最终结果 |\n| 专家 | 领域任务质量、约束遵守和专业能力 | 领域评测集、产物与验收结果 |\n| Planner | 子目标覆盖、依赖正确性、计划成本与可执行性 | DAG 版本、依赖图、执行结果 |\n| ReAct 循环 | 行动选择、反馈利用、无进展检测和停止时机 | 每轮动作、观察结果、策略变化 |\n| 工具执行器 | 操作正确性、幂等性、权限与副作用控制 | 操作账本、工具回执和实际状态 |\n| 记忆系统 | 检索相关性、事实保持、过期信息处理 | 记忆引用、来源、检索结果和下游表现 |\n| 上下文系统 | 关键约束保留、压缩损失和 Token 效率 | 压缩前后信息覆盖、任务结果 |\n| 专家团队 | 协作增益、交接质量、重复劳动与协调成本 | 工作包、交接事件、产物与团队总成本 |\n| DAG 执行器 | 调度效率、恢复能力、依赖失效处理 | 节点状态、关键路径和恢复记录 |\n| 自进化控制器 | 改进候选质量、评测有效性与回滚能力 | 实验记录、评测报告、发布及回滚结果 |\n\n## 5.1 评测过程能力与最终结果必须分开\n\n例如，一个任务最终失败，但 Planner 的分解完全合理，真正的问题是外部 API 长时间不可用。\n\n不能因此直接判定 Planner 质量很差。\n\n同样，某个任务最终成功了，也不意味着 ReAct 策略优秀。如果它调用了十次不必要的工具，只是偶然得到了正确结果，那么它的效率和稳定性仍然值得改进。\n\n因此，QEEG 需要把以下两类结论分别记录：\n\n- **结果质量：** 最终交付是否满足要求；\n- **过程质量：** 路由、规划、工具使用、恢复和协作是否合理。\n\n两者相关，但不能相互替代。\n\n## 5.2 ReAct 不能仅凭轮数评价\n\nReAct 循环的目标不是尽可能减少思考轮数，而是通过观察和行动逐步解决问题。\n\n一个简单任务只需要一轮就完成，是合理的；一个复杂故障可能需要多轮诊断和验证。\n\n因此，ReAct 评测应关注：\n\n- 每轮是否获得了有价值的新信息；\n- 动作是否有明确目的；\n- 观察结果是否改变了后续决策；\n- 是否重复尝试已经证明无效的方法；\n- 是否识别出无进展循环；\n- 是否在证据充分时停止；\n- 是否在达到预算或安全边界时及时停止。\n\n这样才能将“有效探索”和“无效循环”区分开。\n\n---\n\n# 六、评测集设计：系统如何知道自己有没有进步？\n\n没有可靠的评测集，就无法可靠地比较版本。\n\n但单一的固定测试集也不够。随着 EvoAgent 不断改进，它可能逐渐适应已有案例，却无法处理新的任务分布。\n\n建议建立四类互补的评测集。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"1. 固定回归集\",\"长期保留，用于比较版本并发现已经修复的问题是否再次出现。\"],\n    [\"2. 领域基准集\",\"覆盖编程、研究、漫剧、数据分析等领域的代表性任务。\"],\n    [\"3. 困难与对抗案例集\",\"覆盖边界条件、歧义任务、提示注入、故障恢复与容易失败的案例。\"],\n    [\"4. 新鲜度评测集\",\"定期引入未参与调参的新任务，检查能力是否能迁移到未知场景。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"4. 新鲜度评测集\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n## 6.1 固定回归集：保证过去解决的问题不会反复出现\n\n假设编程专家曾经发生过一个严重问题：修改代码时错误地删除了一个兼容接口。\n\n修复之后，应将这个案例及其验证条件加入固定回归集。\n\n后续修改 Router、Planner、上下文压缩、代码技能或执行器时，只要相关依赖发生变化，就应重新运行适用的回归测试。\n\n但回归集不应该无限增长而不做治理。应保留高价值案例，并合并重复、失效或不再适用的测试，同时记录测试集版本和变更原因。\n\n## 6.2 困难案例集：重点测试系统容易犯错的地方\n\n困难案例可以来自：\n\n- GECO 发现的真实失败；\n- SOCDEA 已确认或高度怀疑的根因；\n- 用户纠正过的结果；\n- 曾经导致返工的任务；\n- 边界条件和罕见输入；\n- 跨专家协作失败；\n- 模型切换或断网后的恢复问题；\n- 自进化过程中出现的回归。\n\n这些案例可以形成一个持续扩展的知识资产，但需要脱敏、版本化和适当的隐私控制。\n\n## 6.3 防止评测集污染\n\n如果候选模型能够提前看到所有正式测试案例，并针对这些案例专门调整，它可能在评测集上表现很好，却没有真正提高泛化能力。\n\n建议将评测数据分成：\n\n- 开发集：允许用于调试和改进；\n- 验证集：用于比较候选策略；\n- 保留测试集：用于正式晋升判定；\n- 真实运行观察集：用于评估部署后的实际表现。\n\n对于个人项目，不一定需要复杂的数据科学平台，但至少要避免让候选版本随意修改正式测试集及其预期结果。\n\n当保留测试集被大量重复用于优化时，也应考虑数据泄漏和过拟合风险，必要时引入新的独立案例。\n\n## 6.4 评测集必须跟随任务分布变化\n\n用户的使用方式可能改变，模型和工具也可能升级。\n\n因此，评测集应同时包含历史代表性任务和近期真实任务。\n\n如果 EvoAgent 从主要处理简单问答，逐渐转向代码工程和复杂视频制作，那么仅依赖早期的通用问答集就不再足以衡量系统的真实能力。\n\n但新任务也不能直接覆盖旧的回归集。正确做法是保留历史稳定基线，并通过版本化更新扩展评测覆盖。\n\n---\n\n# 七、模型评审的局限：评测者自己也可能出错\n\n对于代码风格、文档质量、视觉连贯性等难以完全规则化的任务，模型辅助评审具有实际价值。\n\n但如果评测者和被评测者存在相同的盲点，或者评测提示词对某种风格有偏好，评分就可能产生系统性偏差。\n\n因此，QEEG 不应把单个模型的主观评分当成绝对真值。\n\n## 7.1 建立模型评审的校准机制\n\n建议对模型评审器持续检查：\n\n- 与人工评审的一致程度；\n- 对同一结果重复评审的稳定性；\n- 是否偏好较长、较流畅或特定风格的输出；\n- 是否能识别事实错误和证据不足；\n- 是否容易被无关的措辞、排序或格式影响；\n- 在不同任务类型中的表现是否一致。\n\n评审器可以有自己的版本、评测集和发布记录。\n\n如果评审器本身发生变化，就需要重新检查其评分与历史结果之间的可比性。\n\n## 7.2 使用多种证据，而不是简单堆叠多个模型\n\n三个模型给出相同判断，并不必然意味着结论可靠，尤其当它们共享类似的训练偏差或信息来源时。\n\n更合理的做法是让不同评测方法承担不同职责。\n\n例如：\n\n- 测试验证代码能否正确运行；\n- 静态分析检查特定缺陷；\n- 独立模型审查设计与可维护性；\n- 人工评审处理重要的架构取舍。\n\n这些方法提供的是不同类型的证据，比单纯增加相似模型的投票数量更有价值。\n\n## 7.3 评分必须提供依据\n\n模型辅助评审至少应输出：\n\n- 评价维度；\n- 评分或结论；\n- 支持该结论的产物引用；\n- 发现的问题；\n- 证据不足的部分；\n- 评审器版本；\n- 是否需要人工复核。\n\n如果评审器无法指出结果中具体存在什么问题，就不应该让它单独决定高风险任务的发布。\n\n## 7.4 不确定时应该升级，而不是伪造精确度\n\n对于主观任务，可以采用等级或区间，而不是强行给出精确到小数点的分数。\n\n例如，视觉连贯性可以标记为“符合要求”“存在可改进问题”或“无法确认”。\n\n如果某项评测结果对发布决策非常关键，而评审器又缺乏足够的校准证据，就应该增加独立评审或人工检查。\n\n---\n\n# 八、统计显著性与真实进步：如何避免被随机波动欺骗？\n\n即使评测方法正确，也可能因为样本太少而得出错误结论。\n\n例如，某个 Router 版本在 20 个任务中正确选择了 18 次，另一个版本正确选择了 19 次。\n\n这一个任务的差异不足以证明新版本一定更好。\n\n对于随机性较强的模型，评测还会受到生成随机性、外部服务变化、运行环境和任务难度的影响。\n\n## 8.1 建立配对比较机制\n\n当比较两个版本时，尽量让它们使用相同的任务集、相同的验收标准和可比的运行条件。\n\n例如：\n\n- 旧 Router 与新 Router 使用相同的请求集；\n- 旧技能与新技能处理相同的代码修复案例；\n- 旧上下文压缩策略与新策略使用相同的任务输入；\n- 旧恢复机制与新恢复机制注入相同类型的故障。\n\n配对比较能够减少任务难度差异带来的干扰。\n\n但对于会产生外部副作用的真实任务，应在隔离环境或模拟工具中进行比较，不能为了测试而重复提交真实订单、消息或其他不可逆操作。\n\n## 8.2 同时报告效果大小与不确定性\n\n建议评测报告包含：\n\n- 样本量；\n- 指标变化；\n- 任务类型分布；\n- 统计不确定性；\n- 失败案例；\n- 资源成本；\n- 是否满足所有硬性门槛。\n\n对于成功率这类比例指标，可以使用置信区间或其他适合的方法；对于主观评分，应关注评审一致性和评分分布。\n\n统计显著性也不等于实际价值显著。一个极小的提升即使在大样本下具有统计显著性，也可能不足以抵消新版本的维护成本。\n\n## 8.3 建立多目标晋升规则\n\n例如，某个版本：\n\n- 成功率提高；\n- 成本下降；\n- 延迟略有上升；\n- 安全测试没有退化；\n- 可靠性指标保持稳定。\n\n它可能是一个值得晋升的候选，但是否晋升仍取决于任务类型和预先确定的约束。\n\n建议采用以下判定顺序：\n\n1. 检查安全与权限硬门槛；\n2. 检查必要的功能和质量门槛；\n3. 检查可靠性与恢复要求；\n4. 比较成本、延迟与资源表现；\n5. 评估统计不确定性和实际收益；\n6. 决定发布、继续测试、人工复核或拒绝。\n\n不能把所有指标压缩成一个综合分数，再让高效率抵消严重的安全或质量退化。\n\n---\n\n# 九、多专家协作是否真的有价值：建立反事实评测\n\nEvoAgent 采用多专家架构，但不能默认多专家一定优于单专家。\n\n有些任务需要专业分工；有些任务增加专家，只会增加协调开销和重复推理。\n\n因此，QEEG 应单独评估协作机制的真实收益。\n\n## 9.1 建立三种对照方案\n\n以一个复杂代码修复任务为例，可以比较：\n\n- A：由单个编程专家完成；\n- B：由编程专家完成，并使用独立测试专家；\n- C：由多个专家分工，包括分析、实现、测试和代码审查。\n\n比较时，应尽可能使用相同的任务目标、验收标准、资源约束和可比的模型能力。\n\n需要注意，公平比较不一定意味着所有方案使用相同数量的模型调用。多专家方案本身就可能需要更多调用，因此应同时比较：\n\n- 在相同预算下的质量；\n- 达到相同质量所需的成本；\n- 完成时间；\n- 返工率；\n- 缺陷漏检率；\n- 协调开销；\n- 最终交付的稳定性。\n\n## 9.2 建立协作净收益指标\n\n可以用以下形式表达协作净收益：\n\n\\[\nG_{\\text{team}}\n=\nV_{\\text{team}}\n-\nV_{\\text{baseline}}\n-\nC_{\\text{coordination}}\n\\]\n\n其中：\n\n- \\(V_{\\text{team}}\\)：团队方案相对于任务目标的综合价值；\n- \\(V_{\\text{baseline}}\\)：基线方案的综合价值；\n- \\(C_{\\text{coordination}}\\)：额外的协调、重复工作和资源成本。\n\n实际评测时，各项需要采用统一口径，不能直接把不同单位的原始数值相减。\n\n如果团队方案提高了缺陷检测率，但明显增加成本，那么它可能适合高风险任务，却不适合简单修改。\n\n## 9.3 建立按任务类型选择协作策略的规则\n\n建议最终形成一套有证据支持的策略：\n\n- 简单任务优先单专家；\n- 存在独立验证价值的任务采用双专家或专家加确定性验证器；\n- 可分解且具有明显并行收益的任务采用小团队；\n- 高风险任务增加独立审查；\n- 协作收益不足或协调成本过高时，回退到更简单的执行方案。\n\n这使 MEODT 的动态组队不只是根据任务描述决定“找几个人”，而是根据历史评测确定不同组队策略在什么条件下真正有效。\n\n---\n\n# 十、用户反馈：怎样把真实使用中的问题变成可靠改进？\n\n固定评测集能够发现已知问题，但无法覆盖用户所有真实需求。\n\n因此，QEEG 还需要利用用户反馈和真实任务结果。\n\n不过，用户反馈也不是绝对真值。\n\n用户可能因为结果不符合预期而给出低分，也可能因为表达流畅而给出高分，即使结果中存在事实错误。\n\n## 10.1 区分反馈类型\n\n建议把反馈分为：\n\n- **目标修正：** 用户说明原本真正想要的结果；\n- **事实纠正：** 用户指出明确的错误；\n- **质量评价：** 用户评价可读性、视觉效果、代码风格等；\n- **行为纠正：** 用户指出系统做了不该做的操作；\n- **效率反馈：** 用户指出过程太慢、太贵或过于繁琐；\n- **长期结果反馈：** 用户报告产物在真实使用中是否有效。\n\n不同反馈需要不同的处理方式。\n\n例如，用户说“这个答案太长”，可以作为表达偏好的证据，但不能直接推导出所有任务都应该缩短上下文。\n\n用户指出“这个函数返回错误值”，则应进一步通过代码、测试或实际行为核验。\n\n## 10.2 建立反馈到评测案例的闭环\n\n建议采用以下流程：\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  {#each [\n    [\"1. 收集反馈\",\"记录反馈类型、关联任务、产物版本和用户明确表达的要求。\"],\n    [\"2. 判断反馈性质\",\"区分目标变化、真实缺陷、主观偏好与证据不足的意见。\"],\n    [\"3. 核验问题\",\"通过测试、来源核验、产物检查或必要的用户澄清确认问题。\"],\n    [\"4. 形成回归案例\",\"把已确认、可复现且具有长期价值的问题加入适当评测集。\"],\n    [\"5. 生成改进候选\",\"由对应专家或 SOCDEA 提出修复方案。\"],\n    [\"6. 独立评测\",\"验证新方案是否解决问题，以及是否引入新的退化。\"],\n    [\"7. 受控发布\",\"由 SELCIA 按晋升规则发布并持续观察。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"7. 受控发布\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n## 10.3 用户习惯与客观质量必须分开\n\n这一点与此前讨论的用户记忆系统直接相关。\n\n例如，用户长期偏好简洁的代码解释，这是可以逐步学习的个人偏好。\n\n但如果用户偏好简短回答，并不代表系统可以省略必要的安全警告、测试结果或关键限制。\n\n建议将用户偏好纳入个性化质量契约，而不是修改全局的客观正确性门槛。\n\n这样，EvoAgent 可以逐渐适应用户，同时不至于把个人偏好误当成适用于所有人的普遍规则。\n\n## 10.4 真实结果反馈应考虑延迟和归因\n\n一些任务的真实价值要过一段时间才能体现。\n\n例如：\n\n- 生成的代码可能在后续集成时才暴露缺陷；\n- 研究报告可能在决策时才发现引用不准确；\n- 漫剧可能在发布后才获得真实观众反馈；\n- 自动化工作流可能运行数周后才显现维护成本。\n\n因此，QEEG 应允许长期结果反馈与原任务关联。\n\n但不能把后续出现的所有问题都归因于最初的智能体版本。中间的需求变化、环境变化和用户修改也需要纳入分析。\n\n---\n\n# 十一、与现有模块的职责边界\n\n| 模块 | 在 QEEG 中的职责 |\n|---|---|\n| QEEG | 定义统一评测协议、质量契约、评测集治理和晋升证据要求 |\n| UQEAG | 执行任务级验收，确认产物是否满足质量契约 |\n| Router | 提供路由决策及相关证据，接受路由质量评测 |\n| Planner / DAG | 提供计划与执行结构，接受计划质量和调度结果评测 |\n| MEODT | 提供专家分工、交接和协作数据，接受协作净收益评测 |\n| GECO | 提供事件、追踪、版本、产物血缘和运行证据 |\n| SOCDEA | 分析失败原因，提出根因假设与改进候选 |\n| RERA | 提供故障恢复、状态一致性和可靠性评测结果 |\n| APRO | 提供成本、延迟、资源和调度效率数据 |\n| TSEG / PCP | 保护正式评测集、权限规则和评测发布边界 |\n| CEKCE / CIL | 管理能力版本与复用情况，关联技能级评测 |\n| MEEG / CLEK / ACMO | 提供记忆与上下文相关的质量证据 |\n| SELCIA | 根据独立评测证据管理候选晋升、部署与回滚 |\n| HACCG | 呈现用户可理解的结果、限制与必要的人工确认 |\n\n这里要特别明确：\n\n**UQEAG 负责判断一个具体任务是否合格，QEEG 负责定义并治理整个系统怎样证明合格。**\n\n两者密切相关，但不能混为一个模块。\n\n---\n\n# 十二、架构决策记录 ADR-801～ADR-820\n\n以下建议纳入 EvoAgent 全量架构，作为 QEEG 的治理基线。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"ADR-801\",\"建立统一质量契约\",\"每项重要任务明确交付物、验收条件、硬门槛和证据要求。\"],\n    [\"ADR-802\",\"区分硬门槛与可权衡指标\",\"安全、授权和必要质量要求不能被综合评分抵消。\"],\n    [\"ADR-803\",\"建立统一评测状态\",\"明确 PASS、FAIL、INCONCLUSIVE、NOT_APPLICABLE 与 BLOCKED。\"],\n    [\"ADR-804\",\"优先使用确定性验证\",\"可通过测试、规则和结构检查验证的条件，不应仅依赖模型评分。\"],\n    [\"ADR-805\",\"建立领域专用评测包\",\"编程、漫剧、研究、数据分析等领域使用适配自身特点的评测器。\"],\n    [\"ADR-806\",\"评测器必须版本化\",\"记录评测器版本、配置、输入和结论，保证结果可追溯。\"],\n    [\"ADR-807\",\"评测标准变更必须独立治理\",\"待评测对象不能自行降低或修改正式验收门槛。\"],\n    [\"ADR-808\",\"区分过程质量与结果质量\",\"最终成功不代表过程最优，过程规范也不保证最终结果正确。\"],\n    [\"ADR-809\",\"建立分层组件评测\",\"分别评价 Router、Planner、ReAct、专家、记忆、DAG 与工具执行器。\"],\n    [\"ADR-810\",\"评测协作净收益\",\"比较单专家与多专家方案的质量、成本、延迟和协调开销。\"],\n    [\"ADR-811\",\"建立固定回归集\",\"保留历史高价值案例，持续防止已修复问题复发。\"],\n    [\"ADR-812\",\"建立多类互补评测集\",\"组合领域基准、困难案例、对抗案例和新鲜度评测。\"],\n    [\"ADR-813\",\"防止正式评测集污染\",\"控制访问、记录变更，并监控对保留测试集的过拟合。\"],\n    [\"ADR-814\",\"校准模型辅助评审器\",\"检查评审一致性、稳定性、偏差和任务适用范围。\"],\n    [\"ADR-815\",\"评分必须有证据依据\",\"评审结果应关联具体产物、缺陷和证据引用。\"],\n    [\"ADR-816\",\"比较版本时控制混杂因素\",\"尽量采用配对任务、固定契约和可比环境。\"],\n    [\"ADR-817\",\"报告不确定性与实际效果\",\"同时报告样本量、指标变化、失败案例与实际收益。\"],\n    [\"ADR-818\",\"用户反馈必须分类与核验\",\"区分事实纠正、目标修正、主观偏好和长期结果。\"],\n    [\"ADR-819\",\"建立评测到进化的闭环\",\"已确认的失败形成回归案例，修复候选通过独立评测后才能晋升。\"],\n    [\"ADR-820\",\"正式晋升必须有独立证据\",\"改进提出者不能单独决定自己的方案已经成功。\"]\n  ] as item}\n    <box gap={1}>\n      <row align=\"center\" gap={2}>\n        <badge>{item[0]}</badge>\n        <title size=\"md\">{item[1]}</title>\n      </row>\n      <text color=\"secondary\" size=\"sm\">{item[2]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些是建议纳入全量架构的质量治理基线。进入工程实施阶段后，还需要进一步定义 `QualityContract`、`EvaluationRun`、`EvaluationEvidence`、`DomainEvaluationPack`、`BenchmarkVersion`、`JudgeCalibrationReport` 和 `PromotionDecision` 的接口、状态机与持久化协议。\n\n---\n\n# 十三、第一版实施路线：先让质量可验证，再让系统自主优化\n\n对于 EvoAgent 的个人部署方向，QEEG 第一版不需要建立庞大的评测平台。重点是把质量契约、真实测试、版本比较和晋升门槛跑通。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"V0.1 · 质量契约\",\"实现统一验收标准、硬门槛、验证器接口和证据引用。\"],\n    [\"V0.2 · 领域评测器\",\"先为编程、通用任务和漫剧工作流接入适用的确定性验证器。\"],\n    [\"V0.3 · 固定评测集\",\"建立回归案例、领域基准、困难案例和评测版本管理。\"],\n    [\"V0.4 · 组件级评测\",\"分别评测 Router、Planner、ReAct、专家、记忆与上下文策略。\"],\n    [\"V0.5 · 版本对照实验\",\"比较新旧版本的质量、成功率、成本、耗时和不确定性。\"],\n    [\"V0.6 · 用户反馈闭环\",\"将经过核验的反馈转化为测试案例和改进候选。\"],\n    [\"V1.0 · 受控晋升治理\",\"将质量、安全、可靠性与资源评测统一接入 SELCIA。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"V1.0 · 受控晋升治理\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n## 13.1 第一版必须通过的验收测试\n\n建议用一个真实的代码修复任务完成质量闭环。\n\n1. 用户提出需求，Router 选择编程专家。\n2. Planner 生成任务 DAG 和明确的验收契约。\n3. 专家完成代码修改，GECO 记录执行过程和产物版本。\n4. UQEAG 执行测试、静态分析及必要的人工确认。\n5. QEEG 汇总证据，分别判断硬门槛与可权衡指标。\n6. 系统记录任务质量、成本、耗时和失败原因。\n7. 将该任务加入适当的回归集，保留契约与评测版本。\n8. 生成一个改进候选，在相同评测条件下与旧版本比较。\n9. 如果质量或安全硬门槛失败，候选不得晋升。\n10. 如果证据不足，系统应保留不确定状态，而不是自行宣布进步。\n\n这条链路跑通后，EvoAgent 才具备真正可操作的质量进化基础。\n\n---\n\n# 十四、下一专项：知识资产、技能生命周期与能力复用治理\n\n目前，我们已经设计了能力的执行、观测、安全、恢复、资源优化与质量评测。\n\n但还存在一个重要问题：随着系统持续运行，它会积累越来越多的技能、工作流、记忆、修复方案和经验案例。\n\n如果不对这些资产进行系统治理，EvoAgent 可能逐渐出现：\n\n- 同一种能力被重复实现；\n- 新旧技能互相冲突；\n- 过期技能继续被 Router 选中；\n- 某次偶然成功被误认为通用经验；\n- 工作流升级后，依赖它的技能仍然使用旧接口；\n- 技能数量不断增加，但真正可复用的能力没有提高；\n- 历史失败被记录了，却没有转化为可验证的长期知识。\n\n因此，下一专项建议定义为：\n\n**Knowledge & Capability Lifecycle Governance，简称 KCLG。**\n\n重点研究：\n\n1. 如何区分用户记忆、领域知识、技能、工作流、评测案例和执行经验；\n2. 如何判断新能力应该创建、扩展现有能力，还是复用已有能力；\n3. 如何建立能力的版本、依赖、来源和适用范围；\n4. 如何判断一次成功究竟是可复用经验，还是偶然结果；\n5. 如何防止错误记忆、过期知识和未经验证的经验进入共享能力库；\n6. 如何评估技能的真实复用价值与维护成本；\n7. 如何管理技能的晋升、降级、冻结、弃用与退役；\n8. 如何在技能升级后识别受影响的工作流和依赖节点；\n9. 如何避免多个专家重复创建相似技能；\n10. 如何把 GECO 的故障证据和 QEEG 的评测案例转化为长期能力改进；\n11. 如何让领域专家拥有专业知识，同时避免全局记忆被某一领域的经验污染；\n12. 如何在本地存储有限的情况下进行知识压缩、去重和归档；\n13. 如何让系统在复用旧能力时检查版本兼容性、安全状态和适用条件；\n14. 如何判断某项能力应该继续维护、重新设计，还是彻底退役。\n\n这个专项与 CEKCE、CIL、MEEG 和 CLEK 密切相关，但职责仍然需要明确：记忆系统负责保存和检索信息，能力系统负责执行与复用，KCLG 则治理这些资产从产生到退役的整个生命周期。\n\n其核心原则是：\n\n**积累更多记忆和技能，不等于获得更多可靠能力；只有来源清晰、适用范围明确、经过验证且能够持续维护的知识资产，才能真正提高 EvoAgent 的长期能力。**\n\n完成 KCLG 后，我们就能进一步解决 EvoAgent 的长期成长问题：不仅能从失败中改进，还能将有效经验沉淀为可复用、可验证、可维护的能力资产，并避免系统随着时间推移变得越来越臃肿、混乱和脆弱。"]},"status":"finished_successfully","end_turn":true,"weight":1.0,"metadata":{"is_merged_message":true,"source_message_ids":["89b140ff-0a5d-408f-adec-94988ce83b95","28162207-8148-41c3-881e-d8a4695c17ad","7f3857c6-a60b-4c27-ac3b-a54a788d2177","40d1344f-2d61-4972-95a3-5a9956c7d12c","36b7374a-8ca5-4d94-befc-94d9a8bca398"],"continuation_message_id":"36b7374a-8ca5-4d94-befc-94d9a8bca398","model_dil_v2":{"code":"function __dilSafe(evaluate,failureValue){try{return evaluate()}catch{return failureValue}}\n\nDIL.render(__dil.jsx(()=>{const __dilConstants=DIL.useConstants();const __dilModelDataBindings=DIL.useAppData((appData)=>appData.opGenui?.modelDataBindings??{});return __dil.jsx(__dil.Fragment,null,__dil.jsx(\"title\",{\"size\":\"xl\"},__dilConstants[\"0\"]),__dil.jsx(\"text\",{\"color\":\"secondary\",\"size\":\"sm\"},__dilConstants[\"1\"]),__dil.jsx(\"text\",null,