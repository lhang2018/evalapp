ull,__dil.jsx(\"text\",null,__dilConstants[\"399\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"400\"]))),__dil.jsx(\"text\",null,__dilConstants[\"401\"]),__dil.jsx(\"text\",null,__dilConstants[\"402\"]),__dil.jsx(\"text\",null,__dilConstants[\"403\"],__dil.jsx(\"code\",null,__dilConstants[\"404\"]),__dilConstants[\"405\"]),__dil.jsx(\"list\",{\"marker\":\"number\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"406\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"407\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"408\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"409\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"410\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"411\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"412\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"413\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"414\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"415\"]))),__dil.jsx(\"text\",null,__dilConstants[\"416\"],__dil.jsx(\"bold\",null,__dilConstants[\"417\"]),__dilConstants[\"418\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第十四专项：能力边界、自主权限与长期目标一致性","1":"这一轮要解决的是 EvoAgent 从“能做事的智能体”走向“可以长期放心使用的个人智能体”必须跨过的一道门槛。","2":"我们已经讨论了如何让它理解意图、路由到专家、规划任务、调用工具、管理记忆、发现故障、自我修复和持续进化。","3":"但这些能力越强，一个问题就越重要：","4":"EvoAgent 有能力完成一件事，不代表它有权执行这件事；它认为自己应该做，也不代表用户真的授权了。","5":"例如：","6":"用户说“帮我整理一下手机”，不代表授权删除文件。","7":"用户说“帮我把代码修好”，不代表允许它修改所有项目文件或直接发布版本。","8":"用户说“帮我回复这条消息”，不一定意味着允许它不经确认就发送。","9":"用户说“尽可能自动完成”，不代表允许它绕过系统权限。","10":"智能体发现自己的工具有缺陷，也不能因此自行修改安全内核。","11":"智能体从历史对话中知道用户经常使用某项服务，不代表它可以自动进行新的付费操作。","12":"所以，我建议将本专项设计为：","13":"Capability Boundary & Autonomy Governance Engine（能力边界与自主权限治理引擎，简称 CAGE）。","14":"它负责明确智能体实际能做什么、当前被允许做什么，以及面对不确定性时应该如何限制自己的行动。","15":"一、首先区分四个容易混淆的概念","16":"这是整个权限架构的基础。","17":"1. 技术能力 Capability","18":"系统在当前环境下，实际上能够执行什么操作？","19":"例如：Android 无障碍服务能够读取部分界面节点，并尝试执行点击操作。","20":"2. 能力可信度 Competence","21":"系统是否有足够证据证明自己能够可靠完成这类操作？","22":"例如：系统可以点击按钮，但尚未证明它能稳定识别该应用的动态弹窗。","23":"3. 执行权限 Authorization","24":"当前用户、Android 系统和应用权限是否允许这次具体操作？","25":"例如：系统可以打开应用，但没有获得执行某项敏感操作所需的授权。","26":"4. 当前行动许可 Action Permission","27":"结合当前任务、目标对象、风险、授权范围和环境状态，这个动作现在是否可以执行？","28":"例如：用户授权发送一条消息，但当前收件人识别不确定，因此仍需暂停发送。","29":"这四者必须分开管理。","30":"一个工具可以在技术上可用，但可靠性不足；系统可以具备可靠的发送能力，但没有当前授权；用户也可能授权了某类操作，但当前对象不明确，不能安全执行。","31":"因此，不能让模型仅凭“我能做”或“用户大概想让我做”就直接调用工具。","32":"二、建立四层权限架构：谁决定智能体能做什么？","33":"我建议采用四层控制，而不是把权限判断全部放进提示词里。","34":"L1：系统硬性边界","35":"Android 权限、系统安全机制、不可绕过的授权要求、硬性预算与安全限制。","36":"L2：用户授权策略","37":"用户允许哪些操作、作用于哪些对象、在什么条件下生效，以及何时需要再次确认。","38":"L3：任务级行动许可","39":"结合本次任务目标、具体动作、目标对象、可逆性、风险和当前状态，判断是否允许执行。","40":"L4：执行网关","41":"对实际工具调用进行确定性校验；只有通过授权检查的动作才能执行。","42":"这四层不是简单地把权限从上往下传递，而是形成一道道必须通过的检查。","43":"例如，用户允许 EvoAgent 自动操作某个应用，但 Android 无障碍服务已被关闭，那么操作仍然不能执行。","44":"即使 Android 权限存在，如果本次任务没有获得发送消息的授权，执行网关也必须拒绝发送。","45":"如果所有权限检查都通过，但目标收件人无法确定，任务级行动许可仍然应当暂停。","46":"最终决定权不能只存在于模型的推理结果中，必须落实到工具执行之前的确定性控制。","47":"2.1 权限控制与能力判断不能混为一体","48":"CAGE 可以读取模型能力画像和工具健康状态，但它不应因为模型自认为能力很强，就自动扩大权限。","49":"例如：","50":"编程专家的代码修改成功率提高，可以提高其能力评估；","51":"但这不能自动赋予它修改安全内核的权限；","52":"手机操作专家在某个应用中表现稳定，可以降低该场景的验证成本；","53":"但不能因此自动获得其他应用的敏感操作权限。","54":"能力进步可以影响系统选择什么策略，却不能直接改变谁有权批准该策略。","55":"三、设计自主等级：哪些事情可以自动做，哪些必须问你？","56":"你希望 EvoAgent 尽可能自动完成任务，同时保留硬性权限边界。因此，我不建议所有操作都要求确认，也不建议所有操作都默认自动执行。","57":"更合理的是建立明确的自主等级，并允许不同专家、不同任务和不同操作采用不同等级。","58":"3.1 建议采用五级自主模型","59":"A0","60":"只观察与建议","61":"可以读取允许访问的信息、分析问题和提出建议，不执行改变外部状态的动作。","62":"示例：分析手机界面并告诉你下一步可以怎么操作。","63":"A1","64":"低风险自动执行","65":"自动执行已授权、可逆、低风险的动作，并验证结果。","66":"示例：打开指定应用、读取项目文件、生成草稿。","67":"A2","68":"有界自主执行","69":"在预先规定的对象、操作范围、成本和恢复条件内，自主完成多步骤任务。","70":"示例：在指定工作区修改代码、运行测试、修复非破坏性错误。","71":"A3","72":"受控的高影响操作","73":"可以准备、检查和执行部分高影响动作，但必须满足该操作专属的授权、身份和验收要求；需要确认时必须暂停。","74":"示例：准备发送消息、正式提交代码、执行会影响外部系统的操作。","75":"A4","76":"禁止或仅允许受严格约束的动作","77":"越权操作、绕过安全机制、超出用户授权的不可逆操作，以及违反硬性规则的行为。","78":"示例：擅自绕过 Android 权限，或未经授权执行付款。","79":"需要强调：A4 不是“再确认一次就可以做”的等级。它表示该动作在当前规则下禁止执行；如果某类操作本身可以被合法授权，应由正式权限策略定义条件，而不是让模型临时决定例外。","80":"3.2 自主等级不能只设置在整个智能体上","81":"假设你把 EvoAgent 的默认自主等级设为 A2。","82":"这不应该意味着所有操作都可以自动执行。","83":"更合理的方式是同时设置：","84":"全局自主上限；","85":"专家级默认策略；","86":"工具级操作限制；","87":"当前任务的自主范围；","88":"单个敏感动作的授权要求。","89":"最终动作许可取决于所有适用规则中最严格的约束。","90":"例如，编程专家可以自动修改指定项目中的普通源文件，但修改安全配置、删除大量文件或执行生产部署时，必须走更严格的流程。","91":"这比简单地给智能体一个“自主程度 80%”的分数可靠得多。","92":"四、授权必须精确到动作，而不是只精确到专家","93":"这是整个权限系统最关键的设计细节之一。","94":"假设你对 EvoAgent 说：","95":"“你可以帮我自动操作手机。”","96":"这句话表达了总体意愿，却不足以定义每种操作的授权边界。","97":"打开应用、读取通知、修改联系人、发送消息、删除文件、进行支付，虽然都可能属于“操作手机”，但它们的风险和副作用完全不同。","98":"所以，授权不能只绑定到某个专家或某个应用，而应该尽可能绑定到","99":"具体动作、目标对象、操作范围和有效条件","100":"。","101":"4.1 设计授权策略实体","102":"建议使用 ","103":"Authorization Policy","104":" 管理授权规则，至少包含以下字段：","105":"d18fc8b5-e96d-5aac-a5db-1508c82ab12e","106":null,"107":"这只是协议示例，实际实现需要使用真实的应用标识、权限能力和有效期限，并且在执行时检查这些字段。","108":"特别要注意：","109":"不能让模型自行扩大 ","110":"applications","111":" 或 ","112":"actions","113":" 范围；","114":"不能把历史上的一次确认解释为永久授权；","115":"不能因为某个工具已经成功调用过，就认为以后任何参数都可以自动执行；","116":"不能仅凭应用包名认定操作安全，具体动作和目标对象仍然重要。","117":"4.2 授权应该有范围、期限和撤销能力","118":"建议每项授权都可以回答以下问题：","119":"允许谁执行？","120":"允许什么动作？","121":"允许作用于哪些目标？","122":"在什么条件下允许？","123":"授权什么时候到期？","124":"哪些情况必须重新确认？","125":"如何撤销？","126":"撤销后如何处理正在执行的任务？","127":"例如，你可以允许 EvoAgent 在指定工作区内自动修改代码，但不允许它修改工作区外的文件。","128":"如果你撤销这项授权，系统应立即阻止后续相关写入，并在可行的情况下停止正在执行的工作。","129":"对于已经完成的外部副作用，撤销授权不代表它们能够自动恢复。因此，系统还需要记录哪些动作已经发生，哪些仍然可以取消。","130":"五、如何判断一个具体动作是否可以执行？","131":"我建议将每次工具调用前的权限判断设计为一个独立的 ","132":"Action Authorization Gate","133":"。","134":"它不是大模型，而是执行网关内部的确定性决策组件。","135":"每次准备执行动作时，都需要检查：","136":"当前用户和任务是否匹配；","137":"工具是否处于允许使用的状态；","138":"动作是否属于已授权范围；","139":"目标对象是否明确；","140":"是否存在额外的 Android 系统权限要求；","141":"当前自主等级是否允许此类动作；","142":"风险和可逆性是否满足规则；","143":"当前状态是否足够明确；","144":"是否满足必要的用户确认条件；","145":"动作是否会突破预算、次数或范围限制。","146":"模型提出动作","147":"例如：点击按钮、修改文件、发送消息。","148":"Action Authorization Gate","149":"核验身份、授权、范围、风险、状态和预算。","150":"允许","151":"交给工具执行器","152":"拒绝或暂停","153":"记录原因并采取安全降级","154":"执行后再次核验","155":"检查实际状态、结果和副作用。","156":"这里需要区分“拒绝”和“暂停”。","157":"拒绝","158":"：动作违反当前硬性规则或超出授权范围。","159":"暂停","160":"：动作本身可能合法，但当前缺少信息、授权或必要证据。","161":"允许","162":"：所有适用的前置条件均已满足。","163":"如果目标对象不明确，系统不能通过降低风险等级让动作自动通过。","164":"如果授权不足，模型也不能以“用户大概率希望完成任务”为理由绕过执行网关。","165":"5.1 运行时必须重新检查授权","166":"不能只在任务开始时检查一次权限。","167":"例如，用户授权执行一组文件操作，但执行过程中撤销了授权；又或者任务计划发生变化，原本只读取文件，后来决定删除文件。","168":"这时必须重新检查。","169":"我建议至少在以下节点重新核验：","170":"新工具调用；","171":"动作类型发生变化；","172":"目标对象发生变化；","173":"任务权限范围扩大；","174":"从读取切换到写入或外部提交；","175":"高影响动作执行之前；","176":"授权被撤销或环境状态发生关键变化。","177":"对于低风险且连续的内部操作，可以复用有效授权，避免频繁打扰用户；但不能复用授权来覆盖新的敏感动作。","178":"六、能力不足时，智能体应该怎样处理？","179":"权限解决的是“能不能做”，能力评估解决的是“能不能可靠地做”。","180":"即使用户已经授权，也不代表系统必须盲目尝试。","181":"例如：","182":"编程专家被允许修改代码，但无法正确解析目标语言；","183":"手机操作专家有无障碍权限，但当前页面的关键按钮无法识别；","184":"漫剧专家可以调用视频生成服务，但当前角色一致性检查还没有可靠的验收方法；","185":"某个模型在短任务上表现很好，但没有经过长上下文任务的验证；","186":"某个工具刚刚更新，旧版本的成功率数据可能不再适用。","187":"这些情况下，系统应当根据能力证据选择降级、换工具、局部试验、请求协助或停止。","188":"6.1 建立能力状态，而不是只记录一个成功率","189":"建议每项能力都具有以下状态：","190":"状态","191":"含义","192":"默认行为","193":"UNTESTED","194":"尚未经过充分测试","195":"限制使用范围，优先测试","196":"QUALIFIED","197":"在明确的条件下通过了必要评测","198":"在已验证范围内使用","199":"DEGRADED","200":"近期表现下降或环境发生变化","201":"降低自主程度，增加验证","202":"UNRELIABLE","203":"已发现重大缺陷或持续失败","204":"隔离相关能力，禁止承担关键任务","205":"RECOVERING","206":"正在重新测试或恢复","207":"限制使用，等待重新验收","208":"能力状态必须绑定适用范围。","209":"例如，某个视觉识别能力可能在指定应用、指定 Android 版本下处于 ","210":"QUALIFIED","211":"，但在另一种应用界面中仍然是 ","212":"UNTESTED","213":"。","214":"这比简单地说“手机操作能力已经通过测试”更加精确。","215":"6.2 能力状态不能自动转化为权限","216":"假设编程专家的测试成功率从 90% 提高到 98%。","217":"这可以支持系统减少某些低风险任务的额外检查，但不能自动让它获得部署生产代码的权限。","218":"同样，某个工具连续成功执行 100 次，也不能因此绕过权限校验。","219":"能力评估可以影响执行策略，权限规则决定动作边界。","220":"这两者需要分别管理，并通过明确的策略接口协作。","221":"6.3 能力不足时，优先采取最小降级","222":"我建议采用以下顺序，但允许根据风险直接跳到更严格的处理方式：","223":"重新观察或补充必要信息；","224":"切换到已验证的工具或策略；","225":"将任务拆分成更容易验证的子任务；","226":"仅对不确定部分开展隔离试验；","227":"请求用户提供缺失信息或批准替代方案；","228":"停止当前任务，并保存可恢复的进度。","229":"例如，代码专家无法安全地自动完成一次复杂重构时，可以先生成补丁、运行静态检查和测试，再把剩余不确定部分交给用户审查，而不是直接修改整个项目。","230":"七、历史记忆和用户习惯，不能被误认为当前授权","231":"这是个人智能体长期使用后很容易出现的问题。","232":"EvoAgent 可能记住：","233":"你通常喜欢自动完成任务；","234":"你经常使用某个应用；","235":"你倾向于让它直接修改代码；","236":"你一般不喜欢频繁确认；","237":"你经常使用某种模型或工作流。","238":"这些记忆很有价值，可以减少重复沟通，但它们不等于新的授权。","239":"建议将相关信息严格区分为三类。","240":"用户偏好 Preference","241":"影响默认交互方式，例如偏好简洁回复、先生成草稿或减少低风险确认。","242":"用户授权 Authorization","243":"明确规定哪些操作可以执行、作用范围和有效条件，必须来自正式授权流程。","244":"当前任务意图 Intent","245":"用户当前希望达成什么目标，决定这次任务应做什么，而不是永久改变系统权限。","246":"例如，用户偏好“尽可能自动操作手机”，可以让系统在低风险、可逆操作中减少提问。","247":"但如果本次任务涉及删除文件、发送消息或支付，仍然必须遵循对应动作的授权规则。","248":"同样，用户过去授权某个工作区的写入操作，不代表现在可以将文件写到其他目录。","249":"7.1 如何处理模糊指令？","250":"建议根据缺失信息的性质选择不同方式：","251":"缺少非关键偏好：可以采用已知偏好或安全默认值；","252":"缺少任务对象：尝试从当前上下文确认，仍然有歧义时提问；","253":"缺少授权：进入授权流程，不能通过记忆补足；","254":"缺少状态证据：先观察或核验环境；","255":"缺少专业能力：换用已验证的能力，或明确说明限制。","256":"这样既能利用记忆提高效率，又能避免“记得用户通常这么做”演变成“替用户决定这次应该这么做”。","257":"八、自进化系统不能自行扩大自己的权限","258":"这是 CAGE 必须拥有的一条硬性规则。","259":"因为 EvoAgent 不仅会执行任务，还会修改提示词、工具策略、路由、工作流和部分运行配置。","260":"如果它可以通过一次普通的进化任务修改自己的权限策略，那么之前所有的权限控制都可能失去意义。","261":"例如，智能体发现发送消息时总是需要用户确认，于是它提出优化建议：","262":"“为了提高自动化率，将发送消息的确认条件取消。”","263":"从任务完成率角度看，这可能让执行更顺畅；但从授权治理角度看，这种改动可能扩大系统的行动范围。","264":"因此，我建议将权限系统与普通进化资产彻底分离。","265":"8.1 建立权限策略的保护级别","266":"资产类型","267":"普通进化系统能否直接修改","268":"普通提示词和领域策略","269":"可以生成候选，经过评测后发布","270":"模型路由与规划参数","271":"可以生成候选，经过门禁后发布","272":"工具实现","273":"可以提出补丁，必须经过测试和权限检查","274":"普通工作流配置","275":"可以在限定范围内迭代，需验证副作用","276":"权限策略与自主等级上限","277":"只能提出变更建议，不能自行批准","278":"安全内核与发布门禁","279":"受保护，普通进化任务无权解除或绕过","280":"用户授权记录","281":"只能通过正式授权或撤销流程更新，不能由模型伪造","282":"这里并不意味着所有权限策略都永远不能变化，而是要求变化必须经过独立、明确的授权流程。","283":"例如，你可以主动在设置中允许某个新的操作范围；但模型不能因为某个操作经常失败，就自行把它加入已授权范围。","284":"8.2 权限修改应采用独立的变更流程","285":"建议将权限变更拆成：","286":"系统发现当前权限限制影响了某项任务；","287":"生成一份明确的变更建议；","288":"展示变更前后的差异、影响范围和风险；","289":"由具备相应权限的用户或正式策略管理流程批准；","290":"更新授权策略并记录版本；","291":"对新策略进行必要的安全测试；","292":"如果发生异常，撤销新策略并恢复原配置。","293":"不能把“用户批准了某项任务”解释成“用户批准了永久扩大权限”。","294":"批准范围必须明确，任务级批准与策略级变更必须分开。","295":"九、离线、断网和恢复连接时，权限如何保持一致？","296":"结合 EvoAgent 的手机优先方向，这一问题必须在本地架构中解决，而不能完全依赖远端服务器。","297":"建议将权限执行分成两个部分：","298":"本地权限执行内核","299":"：负责 Android 当前能够执行的动作，检查本地授权、系统权限、动作范围和风险规则。","300":"远端策略同步接口","301":"：在可用时同步策略版本、审计事件、撤销信息和必要的配置变更。","302":"本地内核必须能在断网时继续执行允许的低风险操作，也必须能够在断网时拒绝未经授权的操作。","303":"9.1 离线权限策略的原则","304":"建议遵循以下规则：","305":"已缓存且仍然有效的低风险授权，可以在明确范围内继续使用；","306":"需要在线核验的授权，如果网络不可用，则暂停依赖该核验的操作；","307":"远端任务结果未知时，不能因本地超时而重复执行可能产生副作用的动作；","308":"本地不能确认授权状态时，不应自动扩大授权范围；","309":"权限策略的版本和生效范围应当被记录；","310":"恢复连接后，先同步授权变更和撤销信息，再恢复相关任务。","311":"这里还需要明确一个现实限制：如果手机完全离线，远端刚刚发生的授权撤销无法立即传到本地。","312":"因此，对于高风险动作，不能依赖一个可能过期的本地授权缓存。如果某项授权要求实时在线确认，断网就必须暂停该动作。","313":"对于低风险、可逆、已明确授权的操作，可以允许离线执行，但必须有清晰的有效期和范围。","314":"9.2 断网不应该成为权限降级的理由","315":"有一种危险设计是：在线时检查权限，离线时为了保证任务完成，就放宽权限。","316":"我建议明确禁止这种行为。","317":"网络故障可以改变可用能力，但不能自动扩大权限。","318":"例如，云端模型不可用时，手机可以继续打开允许打开的应用、读取允许读取的界面、保存任务进度；但不能因为无法联系服务端，就自动执行原本需要额外确认的敏感动作。","319":"十、完整的行动许可决策流程","320":"前面的设计可以落实成一个统一的 ","321":"Action Authorization Gate","322":"。","323":"它应该在每次实际工具调用之前运行，而不是只在任务开始时执行一次。","324":"这里的许可结果最好是明确的枚举状态，而不是让模型返回一句模糊的“应该可以”。","325":"ALLOW","326":"：所有适用的执行条件均满足。","327":"DENY","328":"：违反硬性规则或明确超出授权范围。","329":"REQUIRE_APPROVAL","330":"：需要用户确认或其他正式授权。","331":"DEFER","332":"：当前状态、能力或外部条件不足，需要先补充证据。","333":"实际实现中，授权状态应由确定性控制器生成。模型只能提交动作提案，不能自行伪造许可结果。","334":"10.1 一个关键的实现细节：防止检查后状态发生变化","335":"假设系统检查了目标页面，确认可以点击某个按钮；但在真正执行之前，页面已经发生变化。","336":"如果执行器直接使用旧的检查结果，可能会操作错误的对象。","337":"因此，对于依赖环境状态的动作，行动许可还应该绑定相关状态版本或检查点。执行时如果发现关键状态已经变化，就需要重新检查。","338":"同样，授权被撤销、目标对象变化、任务范围扩大时，也必须重新核验。","339":"对于具有外部副作用的操作，最好采用支持幂等键、状态查询或明确提交确认的工具协议，降低重复执行风险。","340":"十一、如何评估权限治理是否真正有效？","341":"CAGE 不能只看它拦截了多少次操作。","342":"拦截越多不代表越安全，因为系统可能变得过度保守；拦截越少也不代表体验越好，因为它可能漏掉了必要的限制。","343":"建议建立独立的权限与自主能力评测集。","344":"指标","345":"衡量内容","346":"未授权动作拦截率","347":"超出授权范围的动作是否被正确阻止","348":"错误放行率","349":"不应执行的动作是否被错误允许","350":"错误拒绝率","351":"本来允许的安全动作是否被不必要地阻止","352":"授权范围准确率","353":"是否正确识别动作、目标对象和有效范围","354":"撤销生效时间","355":"授权撤销后，后续动作多久停止","356":"离线权限一致性","357":"断网后是否仍然遵守已定义的权限边界","358":"越权尝试检测率","359":"模型或工具是否尝试超出当前权限范围","360":"结果核验率","361":"实际执行后是否正确检查了结果和副作用","362":"用户确认负担","363":"在保障安全的前提下，需要多少额外确认","364":"自主任务完成率","365":"在授权范围内，系统能否真正自动完成任务","366":"还需要专门测试一些反例：","367":"用户曾经授权，但后来已经撤销；","368":"任务目标从读取变成删除；","369":"模型自信地声称用户已经授权，但实际没有授权记录；","370":"工具返回成功，但实际状态未改变；","371":"远端操作超时，无法确认是否已执行；","372":"模型提出修改权限系统的进化方案；","373":"旧模型和新模型对授权语义的理解不同；","374":"本地离线策略与已知的远端策略版本不一致。","375":"这些测试比只验证正常流程更重要，因为权限系统的价值主要体现在异常情况下仍然能够守住边界。","376":"十二、建议冻结的架构决策","377":"这些是建议纳入 EvoAgent 全量架构的权限治理基线。正式实施时，还需要结合 Android 系统权限、各工具的副作用和真实任务评测进行验证。","378":"十三、下一专项：智能体的可观测性、因果归因与可解释执行","379":"到目前为止，我们已经设计了：","380":"如何理解用户意图并路由到专家；","381":"如何规划和执行复杂任务；","382":"如何管理记忆与上下文；","383":"如何诊断、修复和恢复故障；","384":"如何适配不同模型并独立进化；","385":"如何决定优化什么、分配多少资源；","386":"如何确保进化方向符合全局目标；","387":"如何控制自主程度和行动权限。","388":"但还缺少一个贯穿所有这些模块的基础能力：","389":"当 EvoAgent 完成或失败一次任务时，我们能否真正还原它为什么这样做、哪个组件影响了结果，以及究竟是什么变化让系统变好了或变差了？","390":"这不只是日志记录问题。","391":"例如，一次代码任务失败，可能同时涉及：","392":"意图识别；","393":"路由选择；","394":"记忆检索；","395":"上下文压缩；","396":"Planner 的任务分解；","397":"ReAct 的行动选择；","398":"工具执行；","399":"结果验收；","400":"自我修复。","401":"如果只保存最终回答和错误日志，系统很难知道应该优化哪个环节。","402":"更麻烦的是，如果修改提示词后任务成功率提升，也不能直接证明提示词就是原因。可能是模型版本变化、测试样本差异或工具环境变化导致的。","403":"下一专项建议设计 ","404":"Observability, Causal Attribution & Explainable Execution Engine","405":"，重点研究：","406":"如何建立从用户请求到最终结果的完整执行轨迹；","407":"如何关联任务、专家、模型、工具、工作流和配置版本；","408":"如何区分相关性、故障位置与真正的根因；","409":"如何在不泄露敏感信息的前提下保留足够诊断证据；","410":"如何通过回放、对照实验和消融测试验证改进原因；","411":"如何定位共享组件对多个专家的影响；","412":"如何发现模型或工具升级造成的隐性退化；","413":"如何让每次进化都有明确的基线、变更、评测和回滚依据；","414":"如何在个人电脑和 Android 断联时仍然保持事件可追溯；","415":"如何把可观测性结果反馈给 EPRA、GOCG、CAGE 和自我修复系统。","416":"这一步会让 EvoAgent 不仅能够行动、学习和保护自己，还能够","417":"基于证据理解自身行为，判断哪些改进真正有效，并把整个进化过程变成可追踪、可验证、可纠错的工程闭环","418":"。"},"fallbackMarkdown":"# EvoAgent 第十四专项：能力边界、自主权限与长期目标一致性\n\n这一轮要解决的是 EvoAgent 从“能做事的智能体”走向“可以长期放心使用的个人智能体”必须跨过的一道门槛。\n\n我们已经讨论了如何让它理解意图、路由到专家、规划任务、调用工具、管理记忆、发现故障、自我修复和持续进化。\n\n但这些能力越强，一个问题就越重要：\n\n**EvoAgent 有能力完成一件事，不代表它有权执行这件事；它认为自己应该做，也不代表用户真的授权了。**\n\n例如：\n\n- 用户说“帮我整理一下手机”，不代表授权删除文件。\n- 用户说“帮我把代码修好”，不代表允许它修改所有项目文件或直接发布版本。\n- 用户说“帮我回复这条消息”，不一定意味着允许它不经确认就发送。\n- 用户说“尽可能自动完成”，不代表允许它绕过系统权限。\n- 智能体发现自己的工具有缺陷，也不能因此自行修改安全内核。\n- 智能体从历史对话中知道用户经常使用某项服务，不代表它可以自动进行新的付费操作。\n\n所以，我建议将本专项设计为：\n\n**Capability Boundary &amp; Autonomy Governance Engine（能力边界与自主权限治理引擎，简称 CAGE）。**\n\n它负责明确智能体实际能做什么、当前被允许做什么，以及面对不确定性时应该如何限制自己的行动。\n\n## 一、首先区分四个容易混淆的概念\n\n这是整个权限架构的基础。\n\n## 1\\. 技术能力 Capability\n\n系统在当前环境下，实际上能够执行什么操作？\n\n例如：Android 无障碍服务能够读取部分界面节点，并尝试执行点击操作。\n\n## 2\\. 能力可信度 Competence\n\n系统是否有足够证据证明自己能够可靠完成这类操作？\n\n例如：系统可以点击按钮，但尚未证明它能稳定识别该应用的动态弹窗。\n\n## 3\\. 执行权限 Authorization\n\n当前用户、Android 系统和应用权限是否允许这次具体操作？\n\n例如：系统可以打开应用，但没有获得执行某项敏感操作所需的授权。\n\n## 4\\. 当前行动许可 Action Permission\n\n结合当前任务、目标对象、风险、授权范围和环境状态，这个动作现在是否可以执行？\n\n例如：用户授权发送一条消息，但当前收件人识别不确定，因此仍需暂停发送。\n\n这四者必须分开管理。\n\n一个工具可以在技术上可用，但可靠性不足；系统可以具备可靠的发送能力，但没有当前授权；用户也可能授权了某类操作，但当前对象不明确，不能安全执行。\n\n因此，不能让模型仅凭“我能做”或“用户大概想让我做”就直接调用工具。\n\n---\n\n# 二、建立四层权限架构：谁决定智能体能做什么？\n\n我建议采用四层控制，而不是把权限判断全部放进提示词里。\n\n**L1：系统硬性边界**\n\nAndroid 权限、系统安全机制、不可绕过的授权要求、硬性预算与安全限制。\n\n**L2：用户授权策略**\n\n用户允许哪些操作、作用于哪些对象、在什么条件下生效，以及何时需要再次确认。\n\n**L3：任务级行动许可**\n\n结合本次任务目标、具体动作、目标对象、可逆性、风险和当前状态，判断是否允许执行。\n\n**L4：执行网关**\n\n对实际工具调用进行确定性校验；只有通过授权检查的动作才能执行。\n\n这四层不是简单地把权限从上往下传递，而是形成一道道必须通过的检查。\n\n例如，用户允许 EvoAgent 自动操作某个应用，但 Android 无障碍服务已被关闭，那么操作仍然不能执行。\n\n即使 Android 权限存在，如果本次任务没有获得发送消息的授权，执行网关也必须拒绝发送。\n\n如果所有权限检查都通过，但目标收件人无法确定，任务级行动许可仍然应当暂停。\n\n**最终决定权不能只存在于模型的推理结果中，必须落实到工具执行之前的确定性控制。**\n\n## 2.1 权限控制与能力判断不能混为一体\n\nCAGE 可以读取模型能力画像和工具健康状态，但它不应因为模型自认为能力很强，就自动扩大权限。\n\n例如：\n\n- 编程专家的代码修改成功率提高，可以提高其能力评估；\n- 但这不能自动赋予它修改安全内核的权限；\n- 手机操作专家在某个应用中表现稳定，可以降低该场景的验证成本；\n- 但不能因此自动获得其他应用的敏感操作权限。\n\n能力进步可以影响系统选择什么策略，却不能直接改变谁有权批准该策略。\n\n---\n\n# 三、设计自主等级：哪些事情可以自动做，哪些必须问你？\n\n你希望 EvoAgent 尽可能自动完成任务，同时保留硬性权限边界。因此，我不建议所有操作都要求确认，也不建议所有操作都默认自动执行。\n\n更合理的是建立明确的自主等级，并允许不同专家、不同任务和不同操作采用不同等级。\n\n## 3.1 建议采用五级自主模型\n\n## A0\n\n**只观察与建议**\n\n可以读取允许访问的信息、分析问题和提出建议，不执行改变外部状态的动作。\n\n示例：分析手机界面并告诉你下一步可以怎么操作。\n\n---\n\n## A1\n\n**低风险自动执行**\n\n自动执行已授权、可逆、低风险的动作，并验证结果。\n\n示例：打开指定应用、读取项目文件、生成草稿。\n\n---\n\n## A2\n\n**有界自主执行**\n\n在预先规定的对象、操作范围、成本和恢复条件内，自主完成多步骤任务。\n\n示例：在指定工作区修改代码、运行测试、修复非破坏性错误。\n\n---\n\n## A3\n\n**受控的高影响操作**\n\n可以准备、检查和执行部分高影响动作，但必须满足该操作专属的授权、身份和验收要求；需要确认时必须暂停。\n\n示例：准备发送消息、正式提交代码、执行会影响外部系统的操作。\n\n---\n\n## A4\n\n**禁止或仅允许受严格约束的动作**\n\n越权操作、绕过安全机制、超出用户授权的不可逆操作，以及违反硬性规则的行为。\n\n示例：擅自绕过 Android 权限，或未经授权执行付款。\n\n需要强调：A4 不是“再确认一次就可以做”的等级。它表示该动作在当前规则下禁止执行；如果某类操作本身可以被合法授权，应由正式权限策略定义条件，而不是让模型临时决定例外。\n\n## 3.2 自主等级不能只设置在整个智能体上\n\n假设你把 EvoAgent 的默认自主等级设为 A2。\n\n这不应该意味着所有操作都可以自动执行。\n\n更合理的方式是同时设置：\n\n- 全局自主上限；\n- 专家级默认策略；\n- 工具级操作限制；\n- 当前任务的自主范围；\n- 单个敏感动作的授权要求。\n\n最终动作许可取决于所有适用规则中最严格的约束。\n\n例如，编程专家可以自动修改指定项目中的普通源文件，但修改安全配置、删除大量文件或执行生产部署时，必须走更严格的流程。\n\n这比简单地给智能体一个“自主程度 80%”的分数可靠得多。\n\n---\n\n# 四、授权必须精确到动作，而不是只精确到专家\n\n这是整个权限系统最关键的设计细节之一。\n\n假设你对 EvoAgent 说：\n\n“你可以帮我自动操作手机。”\n\n这句话表达了总体意愿，却不足以定义每种操作的授权边界。\n\n打开应用、读取通知、修改联系人、发送消息、删除文件、进行支付，虽然都可能属于“操作手机”，但它们的风险和副作用完全不同。\n\n所以，授权不能只绑定到某个专家或某个应用，而应该尽可能绑定到**具体动作、目标对象、操作范围和有效条件**。\n\n## 4.1 设计授权策略实体\n\n建议使用 `Authorization Policy` 管理授权规则，至少包含以下字段：\n\n```json\n\n{\n  \"policy_id\": \"policy-mobile-012\",\n  \"subject\": \"evoagent_mobile_operator\",\n  \"scope\": {\n    \"applications\": [\n      \"user_approved_app\"\n    ],\n    \"actions\": [\n      \"launch_app\",\n      \"read_visible_ui\"\n    ],\n    \"excluded_actions\": [\n      \"send_message\",\n      \"delete_data\",\n      \"make_payment\"\n    ]\n  },\n  \"conditions\": {\n    \"max_risk\": \"LOW\",\n    \"network_required\": false,\n    \"verify_result\": true\n  },\n  \"approval_mode\": \"PREAUTHORIZED_WITHIN_SCOPE\",\n  \"expiry\": \"USER_DEFINED\",\n  \"revocation_supported\": true,\n  \"policy_version\": 3\n}\n```\n\n这只是协议示例，实际实现需要使用真实的应用标识、权限能力和有效期限，并且在执行时检查这些字段。\n\n特别要注意：\n\n- 不能让模型自行扩大 `applications` 或 `actions` 范围；\n- 不能把历史上的一次确认解释为永久授权；\n- 不能因为某个工具已经成功调用过，就认为以后任何参数都可以自动执行；\n- 不能仅凭应用包名认定操作安全，具体动作和目标对象仍然重要。\n\n## 4.2 授权应该有范围、期限和撤销能力\n\n建议每项授权都可以回答以下问题：\n\n- 允许谁执行？\n- 允许什么动作？\n- 允许作用于哪些目标？\n- 在什么条件下允许？\n- 授权什么时候到期？\n- 哪些情况必须重新确认？\n- 如何撤销？\n- 撤销后如何处理正在执行的任务？\n\n例如，你可以允许 EvoAgent 在指定工作区内自动修改代码，但不允许它修改工作区外的文件。\n\n如果你撤销这项授权，系统应立即阻止后续相关写入，并在可行的情况下停止正在执行的工作。\n\n对于已经完成的外部副作用，撤销授权不代表它们能够自动恢复。因此，系统还需要记录哪些动作已经发生，哪些仍然可以取消。\n\n---\n\n# 五、如何判断一个具体动作是否可以执行？\n\n我建议将每次工具调用前的权限判断设计为一个独立的 `Action Authorization Gate`。\n\n它不是大模型，而是执行网关内部的确定性决策组件。\n\n每次准备执行动作时，都需要检查：\n\n1. 当前用户和任务是否匹配；\n2. 工具是否处于允许使用的状态；\n3. 动作是否属于已授权范围；\n4. 目标对象是否明确；\n5. 是否存在额外的 Android 系统权限要求；\n6. 当前自主等级是否允许此类动作；\n7. 风险和可逆性是否满足规则；\n8. 当前状态是否足够明确；\n9. 是否满足必要的用户确认条件；\n10. 动作是否会突破预算、次数或范围限制。\n\n**模型提出动作**\n\n例如：点击按钮、修改文件、发送消息。\n\n**Action Authorization Gate**\n\n核验身份、授权、范围、风险、状态和预算。\n\n**允许**\n\n交给工具执行器\n\n**拒绝或暂停**\n\n记录原因并采取安全降级\n\n**执行后再次核验**\n\n检查实际状态、结果和副作用。\n\n这里需要区分“拒绝”和“暂停”。\n\n- **拒绝**：动作违反当前硬性规则或超出授权范围。\n- **暂停**：动作本身可能合法，但当前缺少信息、授权或必要证据。\n- **允许**：所有适用的前置条件均已满足。\n\n如果目标对象不明确，系统不能通过降低风险等级让动作自动通过。\n\n如果授权不足，模型也不能以“用户大概率希望完成任务”为理由绕过执行网关。\n\n## 5.1 运行时必须重新检查授权\n\n不能只在任务开始时检查一次权限。\n\n例如，用户授权执行一组文件操作，但执行过程中撤销了授权；又或者任务计划发生变化，原本只读取文件，后来决定删除文件。\n\n这时必须重新检查。\n\n我建议至少在以下节点重新核验：\n\n- 新工具调用；\n- 动作类型发生变化；\n- 目标对象发生变化；\n- 任务权限范围扩大；\n- 从读取切换到写入或外部提交；\n- 高影响动作执行之前；\n- 授权被撤销或环境状态发生关键变化。\n\n对于低风险且连续的内部操作，可以复用有效授权，避免频繁打扰用户；但不能复用授权来覆盖新的敏感动作。\n\n---\n\n# 六、能力不足时，智能体应该怎样处理？\n\n权限解决的是“能不能做”，能力评估解决的是“能不能可靠地做”。\n\n即使用户已经授权，也不代表系统必须盲目尝试。\n\n例如：\n\n- 编程专家被允许修改代码，但无法正确解析目标语言；\n- 手机操作专家有无障碍权限，但当前页面的关键按钮无法识别；\n- 漫剧专家可以调用视频生成服务，但当前角色一致性检查还没有可靠的验收方法；\n- 某个模型在短任务上表现很好，但没有经过长上下文任务的验证；\n- 某个工具刚刚更新，旧版本的成功率数据可能不再适用。\n\n这些情况下，系统应当根据能力证据选择降级、换工具、局部试验、请求协助或停止。\n\n## 6.1 建立能力状态，而不是只记录一个成功率\n\n建议每项能力都具有以下状态：\n\n| 状态 | 含义 | 默认行为 |\n|--------|--------|--------|\n| `UNTESTED` | 尚未经过充分测试 | 限制使用范围，优先测试 |\n| `QUALIFIED` | 在明确的条件下通过了必要评测 | 在已验证范围内使用 |\n| `DEGRADED` | 近期表现下降或环境发生变化 | 降低自主程度，增加验证 |\n| `UNRELIABLE` | 已发现重大缺陷或持续失败 | 隔离相关能力，禁止承担关键任务 |\n| `RECOVERING` | 正在重新测试或恢复 | 限制使用，等待重新验收 |\n\n能力状态必须绑定适用范围。\n\n例如，某个视觉识别能力可能在指定应用、指定 Android 版本下处于 `QUALIFIED`，但在另一种应用界面中仍然是 `UNTESTED`。\n\n这比简单地说“手机操作能力已经通过测试”更加精确。\n\n## 6.2 能力状态不能自动转化为权限\n\n假设编程专家的测试成功率从 90% 提高到 98%。\n\n这可以支持系统减少某些低风险任务的额外检查，但不能自动让它获得部署生产代码的权限。\n\n同样，某个工具连续成功执行 100 次，也不能因此绕过权限校验。\n\n**能力评估可以影响执行策略，权限规则决定动作边界。**\n\n这两者需要分别管理，并通过明确的策略接口协作。\n\n## 6.3 能力不足时，优先采取最小降级\n\n我建议采用以下顺序，但允许根据风险直接跳到更严格的处理方式：\n\n1. 重新观察或补充必要信息；\n2. 切换到已验证的工具或策略；\n3. 将任务拆分成更容易验证的子任务；\n4. 仅对不确定部分开展隔离试验；\n5. 请求用户提供缺失信息或批准替代方案；\n6. 停止当前任务，并保存可恢复的进度。\n\n例如，代码专家无法安全地自动完成一次复杂重构时，可以先生成补丁、运行静态检查和测试，再把剩余不确定部分交给用户审查，而不是直接修改整个项目。\n\n---\n\n# 七、历史记忆和用户习惯，不能被误认为当前授权\n\n这是个人智能体长期使用后很容易出现的问题。\n\nEvoAgent 可能记住：\n\n- 你通常喜欢自动完成任务；\n- 你经常使用某个应用；\n- 你倾向于让它直接修改代码；\n- 你一般不喜欢频繁确认；\n- 你经常使用某种模型或工作流。\n\n这些记忆很有价值，可以减少重复沟通，但它们不等于新的授权。\n\n建议将相关信息严格区分为三类。\n\n**用户偏好 Preference**\n\n影响默认交互方式，例如偏好简洁回复、先生成草稿或减少低风险确认。\n\n**用户授权 Authorization**\n\n明确规定哪些操作可以执行、作用范围和有效条件，必须来自正式授权流程。\n\n**当前任务意图 Intent**\n\n用户当前希望达成什么目标，决定这次任务应做什么，而不是永久改变系统权限。\n\n例如，用户偏好“尽可能自动操作手机”，可以让系统在低风险、可逆操作中减少提问。\n\n但如果本次任务涉及删除文件、发送消息或支付，仍然必须遵循对应动作的授权规则。\n\n同样，用户过去授权某个工作区的写入操作，不代表现在可以将文件写到其他目录。\n\n## 7.1 如何处理模糊指令？\n\n建议根据缺失信息的性质选择不同方式：\n\n- 缺少非关键偏好：可以采用已知偏好或安全默认值；\n- 缺少任务对象：尝试从当前上下文确认，仍然有歧义时提问；\n- 缺少授权：进入授权流程，不能通过记忆补足；\n- 缺少状态证据：先观察或核验环境；\n- 缺少专业能力：换用已验证的能力，或明确说明限制。\n\n这样既能利用记忆提高效率，又能避免“记得用户通常这么做”演变成“替用户决定这次应该这么做”。\n\n---\n\n# 八、自进化系统不能自行扩大自己的权限\n\n这是 CAGE 必须拥有的一条硬性规则。\n\n因为 EvoAgent 不仅会执行任务，还会修改提示词、工具策略、路由、工作流和部分运行配置。\n\n如果它可以通过一次普通的进化任务修改自己的权限策略，那么之前所有的权限控制都可能失去意义。\n\n例如，智能体发现发送消息时总是需要用户确认，于是它提出优化建议：\n\n“为了提高自动化率，将发送消息的确认条件取消。”\n\n从任务完成率角度看，这可能让执行更顺畅；但从授权治理角度看，这种改动可能扩大系统的行动范围。\n\n因此，我建议将权限系统与普通进化资产彻底分离。\n\n## 8.1 建立权限策略的保护级别\n\n| 资产类型 | 普通进化系统能否直接修改 |\n|--------|--------|\n| 普通提示词和领域策略 | 可以生成候选，经过评测后发布 |\n| 模型路由与规划参数 | 可以生成候选，经过门禁后发布 |\n| 工具实现 | 可以提出补丁，必须经过测试和权限检查 |\n| 普通工作流配置 | 可以在限定范围内迭代，需验证副作用 |\n| 权限策略与自主等级上限 | 只能提出变更建议，不能自行批准 |\n| 安全内核与发布门禁 | 受保护，普通进化任务无权解除或绕过 |\n| 用户授权记录 | 只能通过正式授权或撤销流程更新，不能由模型伪造 |\n\n这里并不意味着所有权限策略都永远不能变化，而是要求变化必须经过独立、明确的授权流程。\n\n例如，你可以主动在设置中允许某个新的操作范围；但模型不能因为某个操作经常失败，就自行把它加入已授权范围。\n\n## 8.2 权限修改应采用独立的变更流程\n\n建议将权限变更拆成：\n\n1. 系统发现当前权限限制影响了某项任务；\n2. 生成一份明确的变更建议；\n3. 展示变更前后的差异、影响范围和风险；\n4. 由具备相应权限的用户或正式策略管理流程批准；\n5. 更新授权策略并记录版本；\n6. 对新策略进行必要的安全测试；\n7. 如果发生异常，撤销新策略并恢复原配置。\n\n不能把“用户批准了某项任务”解释成“用户批准了永久扩大权限”。\n\n批准范围必须明确，任务级批准与策略级变更必须分开。\n\n---\n\n# 九、离线、断网和恢复连接时，权限如何保持一致？\n\n结合 EvoAgent 的手机优先方向，这一问题必须在本地架构中解决，而不能完全依赖远端服务器。\n\n建议将权限执行分成两个部分：\n\n- **本地权限执行内核**：负责 Android 当前能够执行的动作，检查本地授权、系统权限、动作范围和风险规则。\n- **远端策略同步接口**：在可用时同步策略版本、审计事件、撤销信息和必要的配置变更。\n\n本地内核必须能在断网时继续执行允许的低风险操作，也必须能够在断网时拒绝未经授权的操作。\n\n## 9.1 离线权限策略的原则\n\n建议遵循以下规则：\n\n- 已缓存且仍然有效的低风险授权，可以在明确范围内继续使用；\n- 需要在线核验的授权，如果网络不可用，则暂停依赖该核验的操作；\n- 远端任务结果未知时，不能因本地超时而重复执行可能产生副作用的动作；\n- 本地不能确认授权状态时，不应自动扩大授权范围；\n- 权限策略的版本和生效范围应当被记录；\n- 恢复连接后，先同步授权变更和撤销信息，再恢复相关任务。\n\n这里还需要明确一个现实限制：如果手机完全离线，远端刚刚发生的授权撤销无法立即传到本地。\n\n因此，对于高风险动作，不能依赖一个可能过期的本地授权缓存。如果某项授权要求实时在线确认，断网就必须暂停该动作。\n\n对于低风险、可逆、已明确授权的操作，可以允许离线执行，但必须有清晰的有效期和范围。\n\n## 9.2 断网不应该成为权限降级的理由\n\n有一种危险设计是：在线时检查权限，离线时为了保证任务完成，就放宽权限。\n\n我建议明确禁止这种行为。\n\n网络故障可以改变可用能力，但不能自动扩大权限。\n\n例如，云端模型不可用时，手机可以继续打开允许打开的应用、读取允许读取的界面、保存任务进度；但不能因为无法联系服务端，就自动执行原本需要额外确认的敏感动作。\n\n---\n\n# 十、完整的行动许可决策流程\n\n前面的设计可以落实成一个统一的 `Action Authorization Gate`。\n\n它应该在每次实际工具调用之前运行，而不是只在任务开始时执行一次。\n\n这里的许可结果最好是明确的枚举状态，而不是让模型返回一句模糊的“应该可以”。\n\n- `ALLOW`：所有适用的执行条件均满足。\n- `DENY`：违反硬性规则或明确超出授权范围。\n- `REQUIRE_APPROVAL`：需要用户确认或其他正式授权。\n- `DEFER`：当前状态、能力或外部条件不足，需要先补充证据。\n\n实际实现中，授权状态应由确定性控制器生成。模型只能提交动作提案，不能自行伪造许可结果。\n\n## 10.1 一个关键的实现细节：防止检查后状态发生变化\n\n假设系统检查了目标页面，确认可以点击某个按钮；但在真正执行之前，页面已经发生变化。\n\n如果执行器直接使用旧的检查结果，可能会操作错误的对象。\n\n因此，对于依赖环境状态的动作，行动许可还应该绑定相关状态版本或检查点。执行时如果发现关键状态已经变化，就需要重新检查。\n\n同样，授权被撤销、目标对象变化、任务范围扩大时，也必须重新核验。\n\n对于具有外部副作用的操作，最好采用支持幂等键、状态查询或明确提交确认的工具协议，降低重复执行风险。\n\n---\n\n# 十一、如何评估权限治理是否真正有效？\n\nCAGE 不能只看它拦截了多少次操作。\n\n拦截越多不代表越安全，因为系统可能变得过度保守；拦截越少也不代表体验越好，因为它可能漏掉了必要的限制。\n\n建议建立独立的权限与自主能力评测集。\n\n| 指标 | 衡量内容 |\n|--------|--------|\n| 未授权动作拦截率 | 超出授权范围的动作是否被正确阻止 |\n| 错误放行率 | 不应执行的动作是否被错误允许 |\n| 错误拒绝率 | 本来允许的安全动作是否被不必要地阻止 |\n| 授权范围准确率 | 是否正确识别动作、目标对象和有效范围 |\n| 撤销生效时间 | 授权撤销后，后续动作多久停止 |\n| 离线权限一致性 | 断网后是否仍然遵守已定义的权限边界 |\n| 越权尝试检测率 | 模型或工具是否尝试超出当前权限范围 |\n| 结果核验率 | 实际执行后是否正确检查了结果和副作用 |\n| 用户确认负担 | 在保障安全的前提下，需要多少额外确认 |\n| 自主任务完成率 | 在授权范围内，系统能否真正自动完成任务 |\n\n还需要专门测试一些反例：\n\n- 用户曾经授权，但后来已经撤销；\n- 任务目标从读取变成删除；\n- 模型自信地声称用户已经授权，但实际没有授权记录；\n- 工具返回成功，但实际状态未改变；\n- 远端操作超时，无法确认是否已执行；\n- 模型提出修改权限系统的进化方案；\n- 旧模型和新模型对授权语义的理解不同；\n- 本地离线策略与已知的远端策略版本不一致。\n\n这些测试比只验证正常流程更重要，因为权限系统的价值主要体现在异常情况下仍然能够守住边界。\n\n---\n\n# 十二、建议冻结的架构决策\n\n这些是建议纳入 EvoAgent 全量架构的权限治理基线。正式实施时，还需要结合 Android 系统权限、各工具的副作用和真实任务评测进行验证。\n\n# 十三、下一专项：智能体的可观测性、因果归因与可解释执行\n\n到目前为止，我们已经设计了：\n\n- 如何理解用户意图并路由到专家；\n- 如何规划和执行复杂任务；\n- 如何管理记忆与上下文；\n- 如何诊断、修复和恢复故障；\n- 如何适配不同模型并独立进化；\n- 如何决定优化什么、分配多少资源；\n- 如何确保进化方向符合全局目标；\n- 如何控制自主程度和行动权限。\n\n但还缺少一个贯穿所有这些模块的基础能力：\n\n**当 EvoAgent 完成或失败一次任务时，我们能否真正还原它为什么这样做、哪个组件影响了结果，以及究竟是什么变化让系统变好了或变差了？**\n\n这不只是日志记录问题。\n\n例如，一次代码任务失败，可能同时涉及：\n\n- 意图识别；\n- 路由选择；\n- 记忆检索；\n- 上下文压缩；\n- Planner 的任务分解；\n- ReAct 的行动选择；\n- 工具执行；\n- 结果验收；\n- 自我修复。\n\n如果只保存最终回答和错误日志，系统很难知道应该优化哪个环节。\n\n更麻烦的是，如果修改提示词后任务成功率提升，也不能直接证明提示词就是原因。可能是模型版本变化、测试样本差异或工具环境变化导致的。\n\n下一专项建议设计 `Observability, Causal Attribution & Explainable Execution Engine`，重点研究：\n\n1. 如何建立从用户请求到最终结果的完整执行轨迹；\n2. 如何关联任务、专家、模型、工具、工作流和配置版本；\n3. 如何区分相关性、故障位置与真正的根因；\n4. 如何在不泄露敏感信息的前提下保留足够诊断证据；\n5. 如何通过回放、对照实验和消融测试验证改进原因；\n6. 如何定位共享组件对多个专家的影响；\n7. 如何发现模型或工具升级造成的隐性退化；\n8. 如何让每次进化都有明确的基线、变更、评测和回滚依据；\n9. 如何在个人电脑和 Android 断联时仍然保持事件可追溯；\n10. 如何把可观测性结果反馈给 EPRA、GOCG、CAGE 和自我修复系统。\n\n这一步会让 EvoAgent 不仅能够行动、学习和保护自己，还能够**基于证据理解自身行为，判断哪些改进真正有效，并把整个进化过程变成可追踪、可验证、可纠错的工程闭环**。","fallbackMarkdownVersion":1,"clientDefinedWidgets":{"d18fc8b5-e96d-5aac-a5db-1508c82ab12e":{"status":"resolved","refIndex":0,"isStreaming":false}},"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6","turn_exchange_id":"12165444-3325-4640-b765-b84ffc1543c8","request_id":"861ce18b-47ac-45bb-b707-b65a75894e23","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"