ty":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"},{"id":"bbb21c93-705f-4fbb-9b61-35c0ddac6cf1","author":{"role":"user","name":null,"metadata":{}},"create_time":1792493623.429495,"update_time":1792493844.606204,"content":{"content_type":"text","parts":["继续"]},"status":"finished_successfully","end_turn":null,"weight":1.0,"metadata":{"model_slug":"gpt-6","default_model_slug":"gpt-6","is_visually_hidden_from_conversation":false,"search_result_groups":[],"search_queries":[],"image_results":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","real_time_audio_has_video":false,"system_hints":[],"dictation":false,"voice_mode_message":false,"trigger_async_ux":false,"writing_blocks":{},"request_id":"8b9043c9-1ece-4961-821d-b5af92dda9ef","message_source":null,"turn_exchange_id":"365770ce-2182-4057-952b-91c434982339","working_turn_id":"365770ce-2182-4057-952b-91c434982339","can_save":false},"recipient":"all","channel":null},{"id":"9a906416-42ab-4d4d-8589-283c80a85162","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792493827.920542,"update_time":1792493828.164918,"content":{"content_type":"reasoning_recap","content":"思考了 3m 23s"},"status":"finished_successfully","end_turn":false,"weight":1.0,"metadata":{"reasoning_status":"reasoning_ended","finished_duration_sec":203,"reasoning_start_time":1792493623.8905444,"reasoning_end_time":1792493827.8544924,"reasoning_recap_type":"hide_all","cot_version":"v5","reasoning_group_id":"37621b9f-d92b-4ff7-b52a-f4e8ab53bfca","conversation_followup_suggestions_eligible":false,"request_id":"8b9043c9-1ece-4961-821d-b5af92dda9ef","message_type":"next","turn_exchange_id":"365770ce-2182-4057-952b-91c434982339","working_turn_id":"365770ce-2182-4057-952b-91c434982339","model_slug":"gpt-6","default_model_slug":"gpt-6","can_save":false,"parent_id":"90bcd8a0-2913-4534-8163-e363cbe9088f","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"d568335e-2029-4eb7-9c93-21b372d01431","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792493625.782728,"update_time":1792493835.427467,"content":{"content_type":"text","parts":["# EvoAgent 第十五专项：可观测性、因果归因与可解释执行引擎\n\n这一轮要解决 EvoAgent 自我进化中最基础、也最容易被低估的问题：\n\n**系统必须知道自己做过什么、为什么这么做、哪里出了问题，以及有什么证据证明一次改进真的有效。**\n\n前面我们已经设计了执行、记忆、上下文、专家路由、ReAct、Planner、工具调用、结果验收、自我修复、模型适配、进化调度、全局治理和权限控制。\n\n这些模块如果没有统一的可观测性体系，就会形成一个很大的盲区：\n\n智能体可能越来越复杂，但我们无法可靠地解释它为什么成功、为什么失败，也无法确定下一步应该优化什么。\n\n例如，一次代码任务失败，表面上是编程专家写错了代码，实际根因可能是：\n\n- 路由器选择了不合适的专家；\n- 记忆检索返回了过时的项目约束；\n- 上下文压缩删除了关键接口信息；\n- Planner 漏掉了必要的测试步骤；\n- ReAct 在观察结果后仍然重复原来的动作；\n- 工具执行失败，但返回状态被错误解释；\n- 验收器没有发现实际缺陷；\n- 自我修复策略选择了错误的修复方向。\n\n如果系统只记录最终回答和异常堆栈，它很可能优化错对象。\n\n我建议把本专项设计为：\n\n**Observability, Causal Attribution & Explainable Execution Engine，简称 OCAE。**\n\n它负责将任务执行、问题诊断、能力评估和持续进化连接到同一套可验证的证据体系。\n\n## 一、第一性原理：记录不是目的，证据才是目的\n\n我们先区分四件事。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"记录事实\",\"系统实际收到了什么输入、调用了什么工具、观察到了什么结果。\"],\n    [\"解释行为\",\"系统为什么选择这个专家、计划、工具或恢复策略。\"],\n    [\"定位原因\",\"哪个因素对失败或性能变化产生了实际影响。\"],\n    [\"验证改进\",\"修改之后，目标指标是否真的改善，其他关键能力是否退化。\"]\n  ] as item}\n    <row align=\"start\" gap={3}>\n      <icon name=\"check-circle-2\" size=\"lg\" color=\"secondary\"/>\n      <box flex=\"1\" gap={1}>\n        **{item[0]}**\n        <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n      </box>\n    </row>\n  {/each}\n</box>\n\n这四个层次不能混为一谈。\n\n例如，日志显示某次任务中路由器选择了编程专家，只能证明发生了这次选择；它不能证明选择编程专家就是失败的根因。\n\n同样，模型解释“因为上下文不足，所以任务失败”，也只能视为一个诊断假设，而不是事实。\n\n真正的根因需要结合执行轨迹、工具结果、任务约束、对照实验和其他证据来判断。\n\n因此，OCAE 必须遵守一条原则：\n\n**事实记录、模型解释、诊断假设和实验结论，必须使用不同的数据类型和可信度标记。**\n\n这能防止 EvoAgent 把自己生成的解释当作事实，再把错误诊断写进长期记忆，最终导致后续进化不断强化错误判断。\n\n---\n\n# 二、建立统一执行轨迹：一项任务必须能够完整追溯\n\n建议建立 `Execution Trace`（执行轨迹）作为整个系统的核心可观测性实体。\n\n每次用户请求都创建一个根任务，随后发生的专家路由、模型调用、记忆检索、上下文组装、规划、工具执行、验收和恢复，都关联到这条任务轨迹。\n\n复杂任务可以包含多个子任务、多个专家以及一张 DAG，但仍然需要能够回溯到原始用户目标。\n\n## 2.1 统一的追踪层级\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    **Task Trace**\n    <text color=\"secondary\" size=\"sm\">原始请求、任务目标、最终状态、验收结论与总成本</text>\n  </box>\n  <icon name=\"arrow-down\" size=\"lg\"/>\n  <grid columns={2} gap={2}>\n    <grid-item>\n      <box border radius=\"md\" padding={3} gap={1}>\n        **Agent Span**\n        <text color=\"secondary\" size=\"sm\">专家选择、任务规划、ReAct 循环、记忆和上下文处理</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box border radius=\"md\" padding={3} gap={1}>\n        **Workflow Span**\n        <text color=\"secondary\" size=\"sm\">DAG 节点、依赖关系、检查点、重试与恢复</text>\n      </box>\n    </grid-item>\n  </grid>\n  <icon name=\"arrow-down\" size=\"lg\"/>\n  <box border radius=\"md\" padding={3} align=\"center\" gap={1}>\n    **Operation Span**\n    <text color=\"secondary\" size=\"sm\">模型调用、工具调用、检索、文件操作、验证与状态变化</text>\n  </box>\n  <icon name=\"arrow-down\" size=\"lg\"/>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap={1}>\n    **Events & Evidence**\n    <text color=\"secondary\" size=\"sm\">时间、输入输出摘要、执行结果、错误码、证据引用和版本信息</text>\n  </box>\n</box>\n\n这里的 Span 指一次有明确开始和结束的执行区间，Event 则记录该区间内的重要状态变化。\n\n例如，模型调用是一个 Span；模型返回结构化工具请求是一个 Event；工具实际执行和验收又分别有自己的 Span。\n\n这样就能看出时间消耗发生在哪个环节，也能分辨模型提出了操作、工具接受了操作、操作真正完成，以及最终结果通过验收这四件不同的事。\n\n## 2.2 每条轨迹必须关联哪些 ID？\n\n建议至少包含以下标识：\n\n| 标识 | 作用 |\n|---|---|\n| `task_id` | 贯穿用户请求及其全部子任务 |\n| `trace_id` | 关联一次完整的执行轨迹 |\n| `span_id` | 唯一标识一个执行区间 |\n| `parent_span_id` | 记录父子关系，重建执行层级 |\n| `attempt_id` | 区分同一操作的不同尝试 |\n| `workflow_run_id` | 关联一次工作流运行 |\n| `expert_id` | 标识参与执行的专家 |\n| `model_snapshot_id` | 标识模型及其适配版本 |\n| `config_snapshot_id` | 标识提示词、路由、上下文和策略配置 |\n| `evolution_run_id` | 将实验、候选改进与相关任务连接起来 |\n\n其中，`task_id` 应在任务从 Android 手机传到个人电脑时保持不变。服务端接收任务时可以生成新的本地 `trace_id`，但必须保留任务关联关系。\n\n**任务关联 ID 不是用户身份，也不是权限凭证。** 任何知道某个 `task_id` 的组件都不应该因此获得访问任务内容的权限。\n\n## 2.3 轨迹必须保存真实顺序与因果关系\n\n复杂工作流不一定按顺序执行。\n\n例如，漫剧制作中，角色素材生成和背景素材生成可能并行；编程任务中，不同模块的静态分析可能并行运行。\n\n因此，不能仅靠日志时间戳重建整个 DAG。\n\n建议同时保存：\n\n- 父子执行关系；\n- 工作流节点依赖；\n- 显式的先后关系；\n- 任务检查点；\n- 事件发生时间；\n- 事件被系统接收的时间；\n- 必要的跨设备关联信息。\n\n这样既能重建实际执行顺序，也能区分“发生得更早”和“真正导致了后续动作”。\n\n---\n\n# 三、统一事件模型：不能让每个专家各记各的日志\n\n如果编程专家使用自己的日志格式，手机操作专家使用另一套格式，漫剧专家又使用第三套格式，那么全局治理引擎就很难比较它们的表现。\n\n建议建立统一的 `Agent Event Schema`，所有专家、工具、工作流和进化模块都通过同一事件接口记录重要事实。\n\n## 3.1 建议的事件分类\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"任务事件\",\"TASK_CREATED、TASK_STARTED、TASK_COMPLETED、TASK_FAILED、TASK_CANCELLED\"],\n    [\"路由事件\",\"ROUTE_SELECTED、ROUTE_FALLBACK、ROUTE_REJECTED\"],\n    [\"上下文事件\",\"MEMORY_RETRIEVED、CONTEXT_ASSEMBLED、CONTEXT_COMPRESSED\"],\n    [\"规划事件\",\"PLAN_CREATED、PLAN_REVISED、STEP_BLOCKED\"],\n    [\"执行事件\",\"TOOL_REQUESTED、TOOL_STARTED、TOOL_SUCCEEDED、TOOL_FAILED\"],\n    [\"验收事件\",\"VERIFICATION_STARTED、VERIFICATION_PASSED、VERIFICATION_FAILED\"],\n    [\"恢复事件\",\"RECOVERY_PROPOSED、RECOVERY_ATTEMPTED、RECOVERY_SUCCEEDED\"],\n    [\"治理事件\",\"AUTHORIZATION_ALLOWED、AUTHORIZATION_DENIED、BUDGET_LIMIT_REACHED\"],\n    [\"进化事件\",\"ISSUE_DETECTED、CANDIDATE_CREATED、EVALUATION_COMPLETED、CANDIDATE_PROMOTED\"]\n  ] as item}\n    <box gap={1}>\n      **{item[0]}**\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些事件名称是建议的规范化词汇，并不是要求每个模块都实现全部事件。正式 Schema 应当定义字段、必填条件、事件版本和状态转换约束。\n\n例如，工具执行不能只记录一个 `TOOL_SUCCEEDED`，还应该区分：\n\n- 请求是否通过授权；\n- 工具是否真正开始执行；\n- 工具接口是否返回成功；\n- 外部状态是否发生预期变化；\n- 最终验收是否通过。\n\n这样才能避免把“API 调用成功”误认为“用户任务成功”。\n\n## 3.2 事件记录应该包含什么？\n\n建议采用如下结构：\n\n<CodeBlock language=\"json\" editable>\n{\n  \"event_id\": \"evt-001\",\n  \"schema_version\": 1,\n  \"event_type\": \"TOOL_FAILED\",\n  \"task_id\": \"task-884\",\n  \"trace_id\": \"trace-884\",\n  \"span_id\": \"span-019\",\n  \"parent_span_id\": \"span-012\",\n  \"sequence_no\": 42,\n  \"occurred_at\": \"2026-10-20T10:30:15Z\",\n  \"recorded_at\": \"2026-10-20T10:30:16Z\",\n  \"component\": {\n    \"name\": \"file_tool\",\n    \"version\": \"tool-v5\"\n  },\n  \"context\": {\n    \"expert_id\": \"coding\",\n    \"model_snapshot_id\": \"model-b-snapshot-04\",\n    \"config_snapshot_id\": \"config-21\"\n  },\n  \"outcome\": {\n    \"status\": \"FAILED\",\n    \"error_code\": \"MISSING_REQUIRED_FIELD\",\n    \"retryable\": false\n  },\n  \"evidence_refs\": [\n    \"evidence-102\"\n  ]\n}\n</CodeBlock>\n\n这是概念示例。正式实现还需要定义字段校验、时钟来源、脱敏规则和证据保留策略。\n\n其中 `occurred_at` 表示事件发生时间，`recorded_at` 表示记录时间。两者不同，可能是因为离线缓存或日志批量上传。\n\n对于同一设备，可以使用单调递增的本地序列号辅助排序；跨设备事件则应保留各自的时钟信息和因果关联，不能假设不同设备的系统时间绝对一致。\n\n## 3.3 事件记录不能无限膨胀\n\n不是所有内部细节都值得永久保存。\n\n例如，简单的工具调用可以记录请求摘要、结果、耗时和错误码；只有出现异常、触发诊断或进入进化实验时，才按策略保留更详细的上下文。\n\n建议分成三种记录级别：\n\n- **基础轨迹：** 每项任务都记录，用于恢复、统计和审计。\n- **诊断轨迹：** 发生失败、异常或明显退化时，增加更细粒度的事件。\n- **实验轨迹：** 对照实验、模型适配和候选进化任务记录完整的版本差异与评测证据。\n\n这样可以控制磁盘占用、模型分析费用和隐私风险。\n\n---\n\n# 四、最关键的设计：事实、假设、根因和结论必须分开\n\n这是 OCAE 与普通日志系统最大的区别。\n\n我建议建立独立的 `Diagnostic Case`（诊断案例）实体，而不是把模型生成的故障分析直接写进日志或长期记忆。\n\n## 4.1 诊断案例的生命周期\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  {#each [\n    [\"D1：发现异常\",\"检测到失败、超时、指标退化、用户纠正或结果与预期不一致。\"],\n    [\"D2：形成假设\",\"提出一个或多个可能的原因，并列出支持证据与反例。\"],\n    [\"D3：收集证据\",\"查看执行轨迹、复现案例、工具结果和配置差异。\"],\n    [\"D4：区分假设\",\"选择成本合理、能够区分不同原因的诊断实验。\"],\n    [\"D5：确认或保留未知\",\"记录得到支持的原因，或者明确标记为尚未确定。\"],\n    [\"D6：产生改进候选\",\"将有足够依据的根因转化为具体、可验证的改进方案。\"],\n    [\"D7：验证实际效果\",\"对比基线和候选结果，确认修复是否解决目标问题并检查回归。\"],\n    [\"D8：沉淀经验\",\"保存根因、适用条件、反例和证据来源，供后续诊断使用。\"]\n  ] as item}\n    <row align=\"start\" gap={3}>\n      <box background=\"surface-secondary\" radius=\"md\" minWidth=\"36px\" padding={2} align=\"center\">\n        <text size=\"sm\" weight=\"medium\">{item[0].split(\"：\")[0]}</text>\n      </box>\n      <box flex=\"1\" gap={1}>\n        **{item[0].split(\"：\")[1]}**\n        <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n      </box>\n    </row>\n    {#if item[0]!==\"D8\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n注意，诊断案例不一定必须走完全部阶段。\n\n如果只是一个可重复的工具参数错误，可以快速形成诊断和修复候选；如果涉及多个模块、难以复现的偶发故障，则可能需要长时间保留多个竞争假设。\n\n## 4.2 一个诊断假设应该包含什么？\n\n例如，系统怀疑编程任务失败是因为上下文压缩丢失了接口约束。\n\n这条假设应该记录：\n\n- `hypothesis_id`：假设标识；\n- `target_component`：疑似相关组件；\n- `supporting_evidence`：支持证据；\n- `contradicting_evidence`：反例或冲突证据；\n- `confidence_state`：当前证据状态；\n- `testable_prediction`：如果假设正确，预计观察到什么；\n- `test_plan`：如何验证；\n- `result`：验证后支持、否定或仍然未知。\n\n例如：\n\n> 假设：上下文压缩丢失了某个接口的必填参数约束。\n\n可检验的预测是：使用原始完整上下文回放时，模型更可能正确调用工具；使用压缩后的上下文回放时，错误更容易出现。\n\n如果实验结果并不支持这一预测，就不应该因为最初的解释听起来合理而继续修改压缩器。\n\n## 4.3 根因应该允许多因素共同成立\n\n真实失败经常不是单一原因。\n\n例如，路由器将任务分给了一个不合适的专家，同时上下文压缩又丢失了关键约束，最后验收器也没有发现问题。\n\n这时不能强迫系统只选一个根因。\n\n建议支持：\n\n- 直接触发原因；\n- 促成失败的因素；\n- 未能拦截问题的防护缺陷；\n- 与本次失败无关的伴随现象。\n\n这样，系统才能分别改进执行环节与防护环节，而不是只修复最接近错误发生位置的组件。\n\n---\n\n# 五、如何区分相关性与真正的因果关系？\n\n这是整个专项最难的技术问题之一。\n\n假设在最近 100 次失败任务中，70 次都使用了模型 B。\n\n这不代表模型 B 一定是失败根因。\n\n可能是系统最近把更多复杂任务路由给了 B；也可能是这 70 次任务恰好使用了有缺陷的工具版本；还可能是 B 真的存在某种能力退化。\n\n单纯统计相关性，无法区分这些情况。\n\n## 5.1 建立四级因果证据\n\n| 证据等级 | 说明 | 可以支持的结论 |\n|---|---|---|\n| E0：观察到关联 | 两个现象经常同时出现 | 形成诊断假设 |\n| E1：可重复复现 | 同样条件下能够重复观察到问题 | 证明现象稳定存在 |\n| E2：对照实验支持 | 控制其他条件后，改变某个因素会改变结果 | 支持该因素对结果有影响 |\n| E3：跨场景验证 | 在不同任务、样本或环境中得到一致证据 | 增强对因果机制与适用范围的信心 |\n\n这不是绝对的科学证明等级，而是用于指导工程决策的证据分类。\n\n某些问题无法完全复现，也无法进行随机实验。例如，已经发生的外部状态变化不能随意重新执行。这时系统应该保留不确定性，使用日志、状态快照和其他证据综合判断，而不是强行给出确定根因。\n\n## 5.2 对照实验比反复询问模型更有价值\n\n假设怀疑 Planner 的计划过于复杂，导致模型调用成本增加。\n\n可以构造一组代表性任务，比较：\n\n- 当前 Planner；\n- 降低规划深度的候选；\n- 保持规划不变、只减少冗余验证的候选。\n\n尽量固定模型版本、工具版本、任务输入、预算和验收标准，再比较任务成功率、调用次数、耗时和回归情况。\n\n如果只比较两段不同时间的生产日志，无法排除任务难度和环境变化带来的影响。\n\n对于具有随机性的模型，还应当重复运行、记录随机性相关参数（如果可控），并报告结果的波动范围，而不是只选择最好的一次。\n\n## 5.3 需要控制实验风险\n\n因果实验不意味着可以随意在生产环境中改变系统。\n\n建议优先使用：\n\n1. 离线日志回放；\n2. 模拟工具或沙箱；\n3. 固定评测集上的候选对照；\n4. 不产生外部副作用的影子执行；\n5. 低风险、受控的灰度测试；\n6. 经过授权的真实任务验证。\n\n对于发送消息、删除文件、支付等有外部副作用的操作，不能为了比较两种策略而重复执行真实动作。\n\n必须优先选择模拟、状态快照、只读观察或可安全撤销的测试方案。\n\n---\n\n# 六、如何追踪一次复杂任务的完整决策过程？\n\nOCAE 不能只追踪调用了哪些工具，还需要记录关键决策的输入依据。\n\n但这里有个重要边界：我们不需要、也不应该要求模型输出一份看似完整的内心思考过程，才能实现可追溯性。\n\n真正有工程价值的是**可核验的决策摘要、候选选项、约束条件、选择结果和执行证据**。\n\n## 6.1 记录什么样的决策信息？\n\n例如，用户要求 EvoAgent 自动修复一个 Python 项目的测试失败。\n\n系统可以记录：\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box gap={1}>\n    <text color=\"secondary\" size=\"sm\">决策节点 1 · 专家路由</text>\n    **选择编程专家**\n    <text size=\"sm\">依据：用户要求修改代码；项目检测到 Python 文件和测试配置。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <text color=\"secondary\" size=\"sm\">决策节点 2 · 任务规划</text>\n    **先复现失败，再定位代码，最后执行回归测试**\n    <text size=\"sm\">约束：不得修改项目范围之外的文件；不得直接发布。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <text color=\"secondary\" size=\"sm\">决策节点 3 · 工具选择</text>\n    **运行指定测试命令**\n    <text size=\"sm\">依据：测试配置存在，命令属于已授权的本地执行范围。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <text color=\"secondary\" size=\"sm\">决策节点 4 · 结果核验</text>\n    **测试失败，任务不能标记为完成**\n    <text size=\"sm\">证据：退出码、失败测试名称和测试报告。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <text color=\"secondary\" size=\"sm\">决策节点 5 · 恢复策略</text>\n    **生成修复候选并重新测试**\n    <text size=\"sm\">约束：限制修改范围；修复后必须重新执行相关回归集。</text>\n  </box>\n</box>\n\n这种记录足以回答关键工程问题：\n\n- 为什么选择这个专家？\n- 为什么执行这项操作？\n- 当时有哪些硬性约束？\n- 哪些证据支持下一步行动？\n- 为什么任务没有被提前判定为完成？\n- 哪次修改真正改变了执行结果？\n\n相比保存大段模型自由生成的解释，这种结构化记录更容易被程序检查、被测试复现，也更适合用于长期进化。\n\n## 6.2 必须保留“当时的状态”，而不只是最终配置\n\n假设某次任务失败后，系统更新了提示词。\n\n如果日志只保存最新提示词，后续就无法还原任务失败时究竟使用了什么配置。\n\n因此，关键执行轨迹必须引用不可变的配置快照，至少覆盖：\n\n- 模型标识与适配版本；\n- 系统提示词及相关指令版本；\n- 路由、规划、ReAct 和上下文策略版本；\n- 记忆检索策略版本；\n- 工具与工作流版本；\n- 关键预算参数；\n- 验收器版本；\n- 运行环境信息。\n\n不一定每条事件都复制完整配置内容，但必须能够通过快照 ID 和内容哈希准确定位到当时使用的版本。\n\n如果外部模型版本无法固定，也必须记录这一限制，避免误以为同样的配置一定能够产生完全相同的输出。\n\n---\n\n# 七、从日志到进化：如何让每项改进都有证据链？\n\n这是 OCAE 与 EPRA、GOCG、模型适配系统协同的关键。\n\n我建议为每项进化候选建立一个 `Evidence Bundle`（证据包），将问题、诊断、改动、评测和发布结果关联起来。\n\n## 7.1 证据包的结构\n\n<CodeBlock language=\"json\" editable>\n{\n  \"evolution_candidate_id\": \"candidate-042\",\n  \"source_diagnostic_id\": \"diagnostic-019\",\n  \"target_scope\": {\n    \"component\": \"context_compressor\",\n    \"expert\": \"coding\",\n    \"model_snapshot\": \"model-b-snapshot-04\"\n  },\n  \"problem_evidence\": [\n    \"trace-101\",\n    \"trace-115\",\n    \"trace-127\"\n  ],\n  \"hypothesis\": {\n    \"summary\": \"Compression may drop required interface constraints\",\n    \"status\": \"SUPPORTED_BY_EXPERIMENT\"\n  },\n  \"change\": {\n    \"baseline_config\": \"context-v7\",\n    \"candidate_config\": \"context-v8\",\n    \"code_revision\": \"commit-reference\"\n  },\n  \"evaluation\": {\n    \"dataset_version\": \"coding-eval-v12\",\n    \"baseline_result_ref\": \"eval-baseline-51\",\n    \"candidate_result_ref\": \"eval-candidate-52\",\n    \"protection_suite_passed\": true\n  },\n  \"governance\": {\n    \"decision\": \"PENDING_REVIEW\",\n    \"reason\": \"Awaiting broader regression validation\"\n  }\n}\n</CodeBlock>\n\n这里的 ID 都是示例。正式实现中，证据包还应包含数据集内容哈希、统计结果、置信区间或其他不确定性信息、成本记录、依赖版本以及发布审批记录。\n\n## 7.2 一条完整的进化证据链\n\n建议使用如下关系：\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  {#each [\n    [\"Execution Trace\",\"原始任务执行事实\"],\n    [\"Diagnostic Case\",\"问题假设与证据\"],\n    [\"Improvement Candidate\",\"针对根因提出的改动\"],\n    [\"Evaluation Run\",\"基线和候选的对照结果\"],\n    [\"Governance Decision\",\"批准、拒绝或继续验证\"],\n    [\"Release Snapshot\",\"发布后的稳定版本\"],\n    [\"Post-Release Observation\",\"真实运行中的后续表现\"]\n  ] as item}\n    <box border radius=\"md\" padding={3} align=\"center\" gap={1}>\n      **{item[0]}**\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"Post-Release Observation\"}\n      <icon name=\"arrow-down\" size=\"md\" color=\"secondary\"/>\n    {/if}\n  {/each}\n</box>\n\n这条链的价值在于：当发布后的真实表现退化时，系统可以回溯到具体候选、诊断证据和改动，而不是只能看到“最近一次更新后效果变差”。\n\n同时，也能验证一次进化是否产生了预期收益，或者只是改善了评测集上的表现。\n\n## 7.3 不要让证据链本身变成新的成本黑洞\n\n不是所有改进都需要昂贵的因果实验。\n\n对于简单且明确的错误，例如工具必填参数缺失，修复后通过契约测试和相关回归测试就可能足够。\n\n对于跨模型迁移、上下文压缩、复杂规划和高风险权限逻辑等问题，则需要更强的证据。\n\n建议根据变更风险、影响范围和诊断不确定性决定证据强度，而不是对每个候选一律执行同样昂贵的流程。\n\n---\n\n# 八、个人设备架构：手机、个人电脑与离线日志如何协作？\n\n结合你之前确定的方向，EvoAgent 是手机优先的个人智能体，个人电脑或 Mini PC 承担更重的分析和进化工作。\n\n因此，可观测性不能假设所有设备始终在线，也不能把全部原始对话和屏幕内容都上传到服务端。\n\n建议采用“本地事件账本 + 可选诊断证据 + 跨设备同步”的结构。\n\n## 8.1 手机端负责什么？\n\nAndroid 端负责记录：\n\n- 用户请求与任务 ID；\n- 当前使用的专家和策略版本；\n- 本地模型与远端模型调用的基本元数据；\n- 应用操作、无障碍操作和原生接口调用结果；\n- Android 权限状态及授权决策；\n- 任务状态变化和关键检查点；\n- 本地错误、超时、取消和恢复结果；\n- 需要上传但尚未同步的事件。\n\n手机端应该优先记录结构化元数据，而不是默认保存全部屏幕截图、完整模型上下文和所有语音原文。\n\n## 8.2 个人电脑或 Mini PC 负责什么？\n\n本地服务端可以负责：\n\n- 汇总不同任务和设备的执行轨迹；\n- 统计失败模式、成本与延迟；\n- 构建诊断案例；\n- 运行回放和本地测试；\n- 比较稳定版本与候选版本；\n- 生成进化证据包；\n- 保存长期评测历史和版本关联；\n- 将经过验证的改进发布为新的配置或适配快照。\n\n这些职责不要求一开始就拆成多个独立服务。对于个人使用，优先实现一个模块化的本地进化服务，内部保持清晰的模块边界即可。\n\n## 8.3 离线事件同步协议\n\n建议每条待同步事件具有：\n\n- 全局唯一的 `event_id`；\n- 本地设备 ID；\n- 本地递增序列号；\n- 事件 Schema 版本；\n- 记录时间；\n- 任务和轨迹关联 ID；\n- 同步状态；\n- 载荷校验和。\n\n同步采用至少一次投递，并通过唯一事件 ID 实现幂等去重。\n\n也就是说，同一条事件可以因为断网被重复上传，但服务端不能重复计算它对任务统计的贡献。\n\n事件同步成功与任务执行成功是两个完全不同的状态。日志上传失败，不应该导致已经完成的手机任务被重新执行。\n\n### 一个典型的离线场景\n\n1. 手机离线执行一项已授权的低风险任务。\n2. 手机把任务事件和结果写入本地持久化队列。\n3. 任务结束后，事件仍然保存在本地，不依赖服务端确认。\n4. 网络恢复后，手机批量同步未确认事件。\n5. 服务端根据 `event_id` 去重，并验证事件格式。\n6. 服务端更新任务轨迹、诊断统计和待分析候选。\n7. 进化系统生成新配置后，通过独立的版本发布机制返回手机。\n8. 手机验证配置签名、兼容性和适用范围后，才允许启用。\n\n如果日志包含尚未上传的敏感数据，系统应提供本地删除、脱敏和保留期限控制。对于已在服务端形成的派生诊断记录，也需要明确其数据来源和删除策略，避免原始日志删除后仍然保留不必要的敏感内容。\n\n---\n\n# 九、隐私与安全：可观测性不能成为另一个监控系统\n\n这是个人智能体尤其需要重视的地方。\n\n为了诊断问题，系统可能涉及语音转录、消息内容、屏幕截图、代码、文件路径和用户偏好。\n\n如果全部永久保存，即使诊断能力变强，也会产生严重的隐私与存储风险。\n\n我建议采用以下原则。\n\n## 9.1 默认保存最少必要证据\n\n优先保存：\n\n- 事件类型；\n- 错误码；\n- 组件和版本标识；\n- 时间、耗时和成本；\n- 必要的状态摘要；\n- 验收结果；\n- 指向经过授权的诊断证据的引用。\n\n只有当详细内容对故障诊断有明确价值时，才在授权范围内保留更完整的证据。\n\n例如，普通的应用启动失败通常不需要永久保存完整屏幕截图；但如果某个 UI 识别错误反复发生，短期保存脱敏后的界面结构或用户批准的截图，可能有助于复现问题。\n\n## 9.2 将原始内容与诊断元数据分开存储\n\n建议区分：\n\n- **事件元数据：** 用于统计和追踪；\n- **原始内容：** 用户对话、代码、截图、语音等；\n- **诊断证据：** 为特定问题选取的必要内容；\n- **长期经验：** 从问题中提炼的、适用范围明确的规则。\n\n这几类数据的访问权限和保留期限应该不同。\n\n例如，诊断记录可以长期保留“工具必填参数校验缺失导致失败”的结论，但不一定需要永久保留当时完整的用户文件内容。\n\n## 9.3 诊断证据不能直接变成长期记忆\n\n原始错误案例中可能包含：\n\n- 过期的项目路径；\n- 临时令牌；\n- 用户消息中的敏感内容；\n- 错误的模型生成建议；\n- 只适用于某个模型版本的补偿规则。\n\n因此，长期记忆应保存经过筛选和验证的经验，并保留来源、适用范围和失效条件。\n\n不要把所有日志自动向量化后写入共享记忆库。否则，错误经验可能被检索到其他专家中，形成跨领域污染。\n\n---\n\n# 十、如何让诊断结果反过来改进其他模块？\n\nOCAE 的价值不仅是解释过去，还要为其他智能组件提供可靠输入。\n\n建议建立标准化的诊断输出接口，让各模块通过结构化结果协作，而不是各自读取一堆日志、独立猜测根因。\n\n例如：\n\n<CodeBlock language=\"json\" editable>\n{\n  \"diagnostic_id\": \"diagnostic-019\",\n  \"target\": {\n    \"component\": \"context_compressor\",\n    \"scope\": \"coding_expert\"\n  },\n  \"problem_type\": \"CONSTRAINT_LOSS\",\n  \"evidence_level\": \"E2\",\n  \"status\": \"SUPPORTED\",\n  \"affected_task_classes\": [\n    \"multi_file_refactoring\"\n  ],\n  \"estimated_impact\": {\n    \"direction\": \"NEGATIVE\",\n    \"magnitude\": \"NOT_YET_CALIBRATED\"\n  },\n  \"recommended_actions\": [\n    \"ADD_CONTEXT_REGRESSION_CASE\",\n    \"CREATE_COMPRESSION_POLICY_CANDIDATE\"\n  ],\n  \"required_validation\": [\n    \"CODING_REGRESSION_SUITE\",\n    \"CONTEXT_PRESERVATION_SUITE\"\n  ],\n  \"promotion_allowed\": false\n}\n</CodeBlock>\n\n这是概念接口，正式版本还需要定义枚举、字段约束、证据引用和版本兼容规则。\n\n注意其中的 `promotion_allowed` 不应由诊断模型自行决定。它只能表示当前治理流程的状态；最终发布权限仍属于独立的门禁系统。\n\n## 10.1 各模块如何消费诊断结果？\n\n| 模块 | 可以利用的诊断信息 |\n|---|---|\n| 路由器 | 哪类任务在什么条件下容易路由错误 |\n| 记忆系统 | 哪些经验有效、过期或不适用于当前模型 |\n| 上下文引擎 | 哪些约束在压缩后容易丢失 |\n| Planner | 哪些计划模式导致重复步骤或遗漏关键检查 |\n| ReAct 控制器 | 哪些动作在观察后没有根据新证据调整 |\n| 工具系统 | 哪些参数、状态码或副作用处理存在缺陷 |\n| 验收器 | 哪些检查遗漏了真实失败，或产生了错误拒绝 |\n| 自我修复系统 | 哪些恢复策略有效，哪些只增加成本 |\n| EPRA | 哪些候选值得优先投入资源 |\n| GOCG | 候选是否真的改善整体目标，是否存在局部退化 |\n| 模型适配系统 | 问题是否与特定模型、版本或上下文策略有关 |\n\n这样，各模块不需要自行从原始日志中重复推理，而是可以共享已经整理好的诊断证据。\n\n但必须保留一个原则：**诊断结果是可追踪的输入，不是不可质疑的真理。** 当新证据出现时，诊断可以被修正，原有结论也必须保留历史版本。\n\n---\n\n# 十一、OCAE 的工程架构：怎样实现而不把个人项目做得过重？\n\n考虑到 EvoAgent 的部署方向，我建议先把 OCAE 设计成一个模块化能力层，而不是独立建设庞大的观测平台。\n\n## 11.1 推荐模块\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"Event SDK\",\"统一事件结构、关联 ID、事件校验和敏感字段过滤。\"],\n    [\"Trace Recorder\",\"记录 Span、Event、任务层级和工作流依赖。\"],\n    [\"Evidence Store\",\"保存经过授权的诊断证据、内容哈希和来源引用。\"],\n    [\"Trace Query Engine\",\"按任务、组件、模型、版本和错误类型检索轨迹。\"],\n    [\"Diagnostic Engine\",\"生成诊断案例、竞争假设和可验证的实验建议。\"],\n    [\"Experiment Evaluator\",\"执行回放、对照测试、指标统计和保护集评测。\"],\n    [\"Evolution Evidence Registry\",\"将问题、候选、评测、治理决策和发布版本关联起来。\"],\n    [\"Retention & Privacy Controller\",\"管理保留期限、访问权限、脱敏、删除和数据导出。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n## 11.2 推荐的个人部署方式\n\n第一阶段不需要引入专门的分布式追踪平台。\n\n可以采用：\n\n- Android 本地数据库保存任务状态和待同步事件；\n- 个人电脑或 Mini PC 使用 SQLite 或其他合适的本地数据库保存事件索引和诊断元数据；\n- 原始诊断证据使用独立的受控文件存储；\n- 通过唯一事件 ID、内容哈希和版本引用管理关联关系；\n- 用结构化查询和本地报表分析任务失败、成本与延迟；\n- 仅在确有需要时接入更专业的日志和指标工具。\n\n如果未来任务规模、设备数量或并发程度增加，再考虑专门的时序指标存储、分布式追踪后端和独立分析服务。\n\n这样既保留完整的架构扩展能力，又不会让个人使用的 EvoAgent 一开始就承担不必要的运维成本。\n\n## 11.3 与之前架构的边界\n\nOCAE 不应该成为所有模块都必须通过的同步中间层。\n\n正常执行任务时，日志记录应该尽可能轻量，不阻塞关键动作。诊断和进化可以在后台异步处理。\n\n但某些安全审计、授权决策和关键状态检查属于执行正确性的一部分，不能因为日志系统不可用就被跳过。\n\n因此，应当区分：\n\n- **普通遥测：** 可以缓冲、延迟或在明确策略下丢弃低价值记录；\n- **关键审计事件：** 必须可靠保存，否则需要按风险策略阻止相关高风险动作；\n- **任务状态与检查点：** 必须由任务执行系统负责持久化，不能只依赖遥测；\n- **进化证据：** 在候选发布之前必须达到对应证据要求。\n\n这能避免出现一种错误架构：为了保证日志完整而让所有任务停摆，或者为了保证任务继续运行而丢失关键授权记录。\n\n---\n\n# 十二、如何衡量可观测性与因果归因的效果？\n\n可观测性本身也需要评测，否则系统可能记录了越来越多的日志，却没有提高诊断能力。\n\n建议重点关注以下指标。\n\n| 指标 | 目的 |\n|---|---|\n| 轨迹完整率 | 关键任务是否拥有足够的执行记录 |\n| 版本关联完整率 | 能否确定任务实际使用的模型、工具和配置版本 |\n| 失败复现率 | 是否能够在相近条件下重现关键问题 |\n| 诊断准确率 | 诊断假设是否得到后续证据支持 |\n| 错误归因率 | 是否经常把相关因素误判为根因 |\n| 根因未知率 | 仍无法确定根因的问题占比 |\n| 诊断成本 | 找到有用结论需要多少模型调用、时间和计算资源 |\n| 修复有效率 | 发布后是否真正改善目标问题 |\n| 回归发现率 | 是否能及时发现其他能力的退化 |\n| 证据可追溯率 | 进化结论是否能回溯到原始任务、实验和发布记录 |\n| 离线同步完整率 | 断网期间的重要事件是否能够正确补传和去重 |\n| 敏感信息暴露率 | 诊断与存储是否发生不必要的敏感内容暴露 |\n\n这里有两个特别重要的判断。\n\n第一，根因未知率不能简单追求越低越好。面对证据不足的问题，诚实地保留未知状态，比强行给出错误诊断更好。\n\n第二，轨迹完整率也不能靠永久保存所有原始内容来提升。真正的目标是以合理的存储和隐私成本，保留足以支持任务追溯、问题诊断和进化验证的证据。\n\n---\n\n# 十三、建议冻结的架构决策\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"ADR-089\",\"统一执行轨迹\",\"每个任务、专家、工作流和工具操作都通过稳定的关联 ID 追踪。\"],\n    [\"ADR-090\",\"统一事件 Schema\",\"所有关键组件使用统一事件类型、字段和版本兼容规则。\"],\n    [\"ADR-091\",\"事实与解释分离\",\"原始事件、模型解释、诊断假设、根因结论和实验结果采用不同的数据类型。\"],\n    [\"ADR-092\",\"诊断支持多根因\",\"允许直接原因、促成因素和防护缺陷共同存在，并保留反例。\"],\n    [\"ADR-093\",\"因果结论需要证据\",\"通过复现、对照实验和跨场景验证提高诊断可信度，不把相关性当作根因。\"],\n    [\"ADR-094\",\"记录可核验的决策依据\",\"保存选择结果、约束、证据摘要和策略版本，不要求依赖完整的模型内在思考过程。\"],\n    [\"ADR-095\",\"进化证据链完整\",\"问题、诊断、改动、评测、治理决策和发布版本必须可以相互追溯。\"],\n    [\"ADR-096\",\"离线事件可补传\",\"使用唯一事件 ID、持久化队列和幂等去重，区分事件同步与任务执行状态。\"],\n    [\"ADR-097\",\"诊断数据分级保护\",\"分离事件元数据、原始内容、诊断证据和长期经验，并实施最小化保留。\"],\n    [\"ADR-098\",\"可观测性不阻塞普通执行\",\"普通遥测异步处理，关键审计、权限检查和任务状态持久化仍由可靠执行机制保障。\"],\n    [\"ADR-099\",\"诊断结论可修正\",\"保留历史假设与证据，新证据可以推翻旧结论，不直接覆盖诊断历史。\"],\n    [\"ADR-100\",\"按风险决定证据强度\",\"简单修复使用轻量验证，跨模型迁移、共享组件和高风险改动使用更严格的评测。\"]\n  ] as item}\n    <box gap={1}>\n      <row align=\"center\" gap={2}>\n        <badge>{item[0]}</badge>\n        <title size=\"md\">{item[1]}</title>\n      </row>\n      <text color=\"secondary\" size=\"sm\">{item[2]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些是建议纳入 EvoAgent 全量架构的可观测性与因果归因基线。正式实施时，还需要定义完整的事件 Schema、存储策略、脱敏规则、保留期限和评测门槛。\n\n---\n\n# 十四、下一专项：记忆生命周期、经验可信度与跨专家知识治理\n\n现在，我们已经为 EvoAgent 建立了比较完整的执行证据链。\n\n但还有一个问题必须继续深入：\n\n**当系统积累了越来越多的任务记录、失败案例、用户偏好和修复经验时，究竟应该把什么保存为记忆，保存多久，允许谁使用，又如何判断它仍然有效？**\n\n这是你之前反复强调的记忆系统核心问题，也是长期自进化最容易发生隐性退化的地方。\n\n例如：\n\n- 某个编程专家从模型 A 的错误中总结出一条提示词补偿规则；\n- 路由器把一条过时经验用于新的领域；\n- 用户修改了偏好，但旧记忆仍然影响任务行为；\n- 某个工作流在旧工具版本上成功，却在新版本上不再可靠；\n- 一条错误诊断被写入长期记忆，之后反复影响新的判断；\n- 上下文压缩把不同来源、不同可信度的经验混在一起；\n- 某项经验长期没有被使用，但仍占据检索空间；\n- 多个专家对同一问题形成相互冲突的结论。\n\n下一专项建议设计 **Memory Lifecycle & Knowledge Governance Engine（记忆生命周期与知识治理引擎）**，重点讨论：\n\n1. 如何区分工作记忆、情景记忆、语义记忆、用户偏好和程序性经验；\n2. 哪些内容应该永久保存，哪些只需要在当前任务中存在；\n3. 如何为经验记录来源、证据强度、适用范围和失效条件；\n4. 如何防止未经验证的诊断进入共享记忆；\n5. 如何让专家拥有独立记忆，同时共享经过验证的通用知识；\n6. 如何处理冲突、过期、重复和错误记忆；\n7. 如何判断记忆是否值得继续保留；\n8. 如何设计记忆检索、重排、压缩和遗忘机制；\n9. 如何让用户偏好更新、撤销和删除具有一致的传播语义；\n10. 如何让记忆在模型切换、断网、跨设备同步和版本回滚时保持可追溯。\n\n这一专项将进一步明确：EvoAgent 如何从一次次任务中积累真正有用的长期能力，而不是仅仅变成一个越来越庞大、却越来越难以控制的历史记录库。\n\n## 十五、先确立记忆系统的核心原则\n\n在进入下一专项之前，我建议先冻结三个基本原则：\n\n1. **记录不等于记忆。** 一次任务的完整执行轨迹应当进入可追溯的历史记录，但只有经过筛选、具有未来价值的内容，才应该进入长期记忆。\n2. **记忆不等于事实。** 记忆必须保留来源、可信度、适用范围和有效性状态，不能因为某条信息被反复检索，就自动认为它正确。\n3. **共享不等于全局可用。** 某条经验可以被多个专家检索，不代表它适用于所有专家；共享范围必须受到适用条件和证据的约束。\n\n这也意味着，记忆系统不能仅仅是一个向量数据库。它需要与执行轨迹、诊断案例、模型适配、权限治理和全局目标共同协作。\n\n下一轮应该从记忆分类与数据模型开始，逐步深入到记忆生成、验证、检索、更新、冲突处理、失效、遗忘和跨设备同步，最终形成一套可以直接落入 EvoAgent 全量架构的记忆治理设计。"]},"status":"finished_successfully","end_turn":true,"weight":1.0,"metadata":{"is_merged_message":true,"source_message_ids":["823d009f-3c15-43ea-8eb3-b1085d1f5c9e","12aa7661-49b0-4e2b-ba84-9c8f9c2b519f","e6a4b42d-9240-47a6-9516-d1a641d67f04","c48da33f-6e5b-4e65-818e-038f86699660","875f0b59-b50b-4da2-bf9c-83105fdde62f","0c7dedd4-3f7b-4fc6-a3d2-fe0afd01aa71","d0670bf8-c64b-40a1-bc13-ff294b9cb823","8136a2a3-a440-42e2-9f18-7d013487eb96"],"continuation_message_id":"8136a2a3-a440-42e2-9f18-7d013487eb96","model_dil_v2":{"code":"function __dilSafe(evaluate,failureValue){try{return evaluate()}catch{return failureValue}}\n\nDIL.render(__dil.jsx(()=>{const __dilConstants=DIL.useConstants();const __dilModelDataBindings=DIL.useAppData((appData)=>appData.opGenui?.modelDataBindings??{});return __dil.jsx(__dil.Fragment,null,__dil.jsx(\"title\",{\"size\":\"xl\"},__dilConstants[\"0\"]),__dil.jsx(\"text\",null,__dilConstants[\"1\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"2\"])),__dil.jsx(\"text\",null,__dilConstants[\"3\"]),__dil.jsx(\"text\",null,__dilConstants[\"4\"]),__dil.jsx(\"text\",null,__dilConstants[\"5\"]),__dil.jsx(\"text\",null,__dilConstants[\"6\"]),__dil.jsx(\"list\",{\"marker\":\"bullet\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"7\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"8\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"9\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"10\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"11\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"12\"])),__dil.jsx(\"list-item