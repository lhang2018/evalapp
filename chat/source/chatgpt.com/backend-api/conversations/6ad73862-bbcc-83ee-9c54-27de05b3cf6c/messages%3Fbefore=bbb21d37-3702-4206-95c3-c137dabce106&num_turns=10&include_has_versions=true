ll,__dilConstants[\"450\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"451\"]))),__dil.jsx(\"text\",null,__dilConstants[\"452\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第十七专项：上下文工程与长任务连续性引擎","1":"这一轮继续深入 EvoAgent 的智能内核。","2":"前面我们已经区分了历史记录、长期记忆、经验和策略，也明确了专家隔离、跨专家知识共享、记忆可信度与上下文压缩的基本原则。","3":"现在要解决更贴近执行的问题：","4":"当一个任务很长、涉及多个专家、几十个工具调用，甚至中途断网、切换模型、重启应用时，EvoAgent 如何确保自己没有忘记目标、没有丢失关键约束，也不会把尚未完成的工作误认为已经完成？","5":"这不是单纯的上下文窗口问题。","6":"即使模型拥有很大的上下文窗口，如果任务状态、工具结果、记忆来源和恢复检查点没有正确管理，智能体仍然会迷失方向。","7":"反过来，即使模型上下文有限，只要任务状态保存得当、信息选择合理、执行能够恢复，智能体也可以可靠地完成很长的工作。","8":"我建议将本专项定义为：","9":"Context Engineering & Long-Running Task Continuity Engine，简称 CLTC。","10":"它负责将任务目标、运行状态、必要记忆、执行证据和模型上下文组织成一个可持续推进、可中断恢复、可验证的任务系统。","11":"一、第一性原理：上下文不是记忆库，也不是任务状态数据库","12":"首先必须把四个容易混淆的概念分开。","13":"它们之间的关系应该是：","14":"任务状态保存“现在实际处于什么状态”；","15":"执行证据说明“为什么可以认为处于这个状态”；","16":"长期记忆提供“以前学到的哪些知识可能有帮助”；","17":"模型上下文只装入“本轮决策需要使用的内容”。","18":"例如，一项视频生成任务的状态数据库记录某个镜头已经生成，文件路径和内容哈希也已保存；执行证据记录生成服务返回的任务 ID 与最终文件验收结果。","19":"此时，模型不需要反复看到整个生成历史，只需要知道这个镜头已经验收通过、文件在哪里、哪些后续节点依赖它。","20":"关键原则：不能依靠模型记住全部历史来维持任务连续性。任务连续性必须由外部持久化状态保证。","21":"二、建立五层上下文架构","22":"我建议 CLTC 采用五层逻辑架构。它们可以共享存储和代码基础设施，但职责必须分开。","23":"L1 · 目标与约束层","24":"保存原始用户目标、明确约束、授权范围、验收标准、预算上限和禁止事项。","25":"核心要求：不能被普通摘要静默改写。","26":"L2 · 持久化任务状态层","27":"保存 DAG、节点状态、依赖、当前检查点、重试计数、资源占用和待处理动作。","28":"核心要求：状态变化需要明确、可验证、可恢复。","29":"L3 · 执行证据层","30":"关联工具结果、文件版本、模型调用摘要、验收报告、错误记录和状态转换依据。","31":"核心要求：区分动作已尝试、结果已观察和结果已验收。","32":"L4 · 上下文组装层","33":"根据当前节点、专家、模型能力、风险和 token 预算选择需要的信息。","34":"核心要求：按需加载，而不是把所有历史一并塞进上下文。","35":"L5 · 推理与行动层","36":"由专家、Planner、ReAct 和工具接口根据当前上下文提出下一步动作。","37":"核心要求：推理结果必须经过状态、权限和执行门禁检查。","38":"这里有一个关键的架构决定：","39":"上下文组装层不应该成为事实的唯一来源。","40":"它是一个面向模型的视图，而不是权威数据库。","41":"如果摘要说某个步骤已完成，但任务状态库和执行证据显示该步骤仍在等待外部结果，就必须以经过验证的状态记录为准，并将摘要视为过期信息。","42":"三、目标、约束和任务状态必须分开保存","43":"长任务最容易出现的问题之一，是随着对话推进，原始目标逐渐被新指令、临时决定和模型摘要覆盖。","44":"例如，用户最初要求：","45":"制作一部 45 秒的动态视频漫剧，角色形象保持一致，总预算不超过指定额度，最后必须检查音画同步。","46":"任务进行到一半时，用户又提出“先把前 15 秒做出来看看”。","47":"这是一项阶段性要求，不意味着原来的 45 秒总目标、角色一致性要求和总预算自动失效。","48":"因此，CLTC 应当把任务目标拆成三个层次。","49":"3.1 原始目标、当前阶段目标和执行计划","50":"原始目标 Original Objective","51":"用户希望最终实现什么，以及明确提出的全局限制。","52":"除非发生明确的目标变更，否则持续有效。","53":"阶段目标 Phase Objective","54":"当前阶段需要交付什么中间成果。","55":"例如：先交付 15 秒样片，供用户确认角色和风格。","56":"执行计划 Execution Plan","57":"当前准备采用的 DAG、节点顺序、工具和恢复策略。","58":"可以根据执行结果修改，但必须继续满足有效的目标与约束。","59":"这三个层次不能合并成一段不断改写的摘要。","60":"否则模型可能因为最新阶段目标只提到 15 秒，就把总时长误解为 15 秒；也可能因为某个执行计划发生变化，就丢失原始验收要求。","61":"3.2 目标变更必须形成明确的变更记录","62":"建议将目标变更设计成独立的 ","63":"Objective Revision","64":"：","65":"原始目标版本；","66":"新目标版本；","67":"用户明确提出的变更；","68":"被修改、被保留和被取消的约束；","69":"变更影响的任务节点；","70":"是否需要重新规划；","71":"是否需要重新评估预算；","72":"是否需要用户确认。","73":"例如，用户明确说“不要做 45 秒了，改成 15 秒”，系统才能把总时长目标正式修改为 15 秒。","74":"如果只是说“先做 15 秒给我看”，系统应该建立一个阶段目标，不应覆盖总目标。","75":"3.3 约束需要结构化，而不是只放在提示词中","76":"建议将任务约束分为：","77":"质量约束；","78":"预算约束；","79":"时间约束；","80":"工具与环境约束；","81":"文件和数据范围约束；","82":"用户授权约束；","83":"验收约束；","84":"禁止事项。","85":"其中，硬性约束应保存在独立的结构化记录中，模型上下文只是它们的呈现形式。","86":"如果上下文压缩器把“预算不超过 100 元”压缩成“尽量节约成本”，这不是无害的摘要，而是约束丢失。","87":"四、长任务必须有持久化状态机","88":"接下来解决一个关键问题：一个任务究竟在什么状态下才算完成？","89":"不能仅依赖模型回答“我已经完成了”。","90":"对于长任务，我建议采用显式状态机，并区分任务状态、节点状态和外部操作状态。","91":"4.1 任务级状态","92":"这是一组建议的任务级状态，并不意味着每个任务都必须依次经过所有状态。","93":"例如，简单任务可能从 ","94":"READY","95":" 直接进入 ","96":"RUNNING","97":"，最后进入 ","98":"VERIFYING","99":" 和 ","100":"COMPLETED","101":"。","102":"4.2 节点级状态","103":"DAG 中的每个节点还需要独立状态：","104":"BLOCKED","105":"：依赖尚未满足；","106":"READY","107":"：可以执行；","108":"RUNNING","109":"：执行中；","110":"WAITING_EXTERNAL","111":"：等待外部结果；","112":"SUCCEEDED","113":"：执行结果已通过该节点的验收条件；","114":"FAILED","115":"：执行失败；","116":"RETRY_PENDING","117":"：允许重试，等待调度；","118":"SKIPPED","119":"：经过明确的策略决定跳过；","120":"CANCELLED","121":"：已取消；","122":"NEEDS_RECONCILIATION","123":"：结果不确定，需要核对真实状态。","124":"特别注意，","125":"SUCCEEDED","126":" 必须有明确的定义。","127":"例如，一个视频生成 API 返回了任务 ID，只能证明生成请求已被接受，不能证明视频文件已经生成，更不能证明视频质量验收已经通过。","128":"4.3 状态变更必须通过合法转换","129":"建议由任务引擎管理状态迁移，不允许 Planner 或模型直接把任意节点改成成功。","130":"例如：","131":"READY → RUNNING","132":"：执行器已取得执行权；","133":"RUNNING → WAITING_EXTERNAL","134":"：外部操作已提交，等待结果；","135":"WAITING_EXTERNAL → NEEDS_RECONCILIATION","136":"：等待超时，实际结果未知；","137":"NEEDS_RECONCILIATION → SUCCEEDED","138":"：通过外部状态核查与验收确认成功；","139":"RUNNING → FAILED","140":"：符合失败条件，并记录失败证据。","141":"这能防止模型因为摘要中写着“已完成”，就直接跳过尚未完成的节点。","142":"五、检查点与断点恢复：不能把“重新开始”当作默认恢复策略","143":"对于几十个节点的 DAG，如果中途断网、进程崩溃或模型调用超时，直接重新执行整个任务可能会重复花钱、覆盖文件，甚至重复触发外部副作用。","144":"因此，CLTC 必须与工作流引擎协作，建立持久化检查点。","145":"5.1 检查点保存什么？","146":"一个有效检查点至少需要记录：","147":"类别","148":"必须保存的内容","149":"任务身份","150":"task_id","151":"、任务版本和目标版本","152":"当前状态","153":"任务状态、节点状态和已完成依赖","154":"执行进度","155":"已完成步骤、待执行步骤、当前执行尝试","156":"产物清单","157":"文件路径、版本、内容哈希和验收状态","158":"外部操作","159":"外部任务 ID、请求幂等键、操作状态与查询方式","160":"资源信息","161":"已使用预算、剩余预算、重试次数和时间限制","162":"运行版本","163":"专家配置、工具版本、模型适配版本","164":"恢复信息","165":"最近的可信检查点、未决操作和恢复策略","166":"检查点不需要保存全部模型上下文。","167":"相反，应该优先保存可以重建上下文的结构化状态和证据引用。这样即使模型换了、上下文窗口不同，任务仍然可以恢复。","168":"5.2 检查点何时创建？","169":"建议至少在以下节点创建检查点：","170":"一个具有实际副作用的操作开始之前；","171":"重要外部操作已提交之后；","172":"DAG 节点完成并通过验收之后；","173":"大型文件或素材生成完成之后；","174":"任务阶段切换时；","175":"用户暂停或取消任务时；","176":"执行计划发生重大变化时。","177":"对于高成本或难以重现的节点，可以提高检查点频率；对于低成本、无副作用的内部步骤，则不必每一步都持久化完整快照。","178":"5.3 必须区分执行一次与结果确认","179":"这是断点恢复最重要的规则。","180":"假设 EvoAgent 调用云端视频生成服务，服务已经收到请求，但手机断网，系统没有收到结果。","181":"此时有三种可能：","182":"请求根本没有到达服务端；","183":"请求已经执行，结果尚未返回；","184":"请求已完成，但返回消息丢失。","185":"如果系统直接重试，可能重复生成视频并再次收费。","186":"正确的恢复顺序应当是：","187":"查找原操作的幂等键和外部任务 ID；","188":"如果服务支持，先查询原任务状态；","189":"如果已完成，恢复结果引用；","190":"如果仍在运行，继续等待；","191":"如果明确失败，按策略决定是否重试；","192":"如果无法确定状态，则保持 ","193":"NEEDS_RECONCILIATION","194":"，不要假定失败。","195":"对于不支持幂等请求或状态查询的外部服务，系统必须显式标记这种限制，并采取保守的恢复策略。","196":"超时不等于失败，进程崩溃不等于操作没有发生。","197":"5.4 文件产物也必须具备幂等性","198":"例如，漫剧制作流程中的视频合成节点不应该每次恢复时都随意覆盖同一个文件。","199":"建议采用：","200":"稳定的节点产物 ID；","201":"明确的输入版本；","202":"内容哈希；","203":"临时输出文件；","204":"验收成功后原子提交；","205":"已验收产物的复用规则。","206":"如果输入素材没有变化、工具版本和合成参数也满足复用条件，就可以复用已验收产物，避免重复计算。","207":"但如果角色素材、分镜或音轨发生变化，系统必须识别依赖失效，只重做受影响的节点，而不是错误地复用旧结果。","208":"六、上下文组装：每次推理究竟应该看到什么？","209":"现在进入模型上下文设计本身。","210":"我不建议把上下文构造成一段不断增长的对话，而建议将它视为一个有预算、可重建、有明确来源的工作视图。","211":"6.1 统一上下文包","212":"建议定义 ","213":"Context Package","214":"，每次模型调用之前由上下文引擎生成。","215":"755886d4-5668-52be-b777-0ff58b017b03","216":null,"217":"这是一个概念示例。实际上下文包还需要记录组装器版本、所用模型的实际限制、信息优先级和来源完整性状态。","218":"其中最重要的不是这些字段本身，而是三个原则：","219":"上下文必须能够从持久化状态重建；","220":"重要信息必须能追溯到来源；","221":"被省略的信息必须在必要时可以重新获取。","222":"模型看到的是上下文包渲染后的内容，而不是直接拥有修改任务状态的权限。","223":"6.2 上下文选择应该按优先级进行","224":"建议采用以下顺序：","225":"当前任务的硬性约束与有效授权；","226":"当前节点的目标和验收条件；","227":"当前节点的输入、依赖和真实状态；","228":"尚未解决的问题和关键不确定性；","229":"必要的历史决策与证据；","230":"与当前任务相关的有效记忆；","231":"其他有助于推理的历史信息。","232":"这不是说高优先级内容一定要以固定文本顺序出现，而是说，在预算不足时，系统不能先丢掉硬性约束，却保留大量无关的历史对话。","233":"如果连最低必要上下文都无法装入模型输入窗口，系统应当拆分任务、改用适配的模型或采用结构化工具，而不是继续压缩到关键约束无法辨认。","234":"七、上下文压缩：不能只看节省了多少 Token","235":"上下文压缩通常很容易被错误地定义为“在尽可能少的 token 里保留尽可能多的信息”。","236":"对于 EvoAgent，这个目标不够准确。","237":"更合理的目标是：","238":"在满足任务正确性、约束完整性和可追溯性要求的前提下，以合理成本提供完成当前决策所需的最少信息。","239":"7.1 不同信息采用不同压缩策略","240":"信息类型","241":"建议策略","242":"原始目标与硬性约束","243":"结构化保存，压缩后必须能验证语义完整性","244":"用户当前明确指令","245":"保留原始语义和变更关系，不得由历史摘要覆盖","246":"任务节点状态","247":"使用结构化状态，不通过自然语言摘要推断","248":"工具返回的大型结果","249":"保存原始结果引用，提取当前决策需要的字段","250":"代码、配置和技术文档","251":"优先使用结构化提取、AST、符号索引或按需读取","252":"视觉与视频素材","253":"保存资产 ID、版本、元数据和验收结果，按需加载素材","254":"历史对话","255":"生成有来源的摘要，保留必要的原文引用","256":"失败诊断与经验","257":"保留证据、假设状态、适用范围和反例","258":"模型自由生成的中间内容","259":"可以压缩或丢弃，但不能把未经验证的内容升级为事实","260":"7.2 全局压缩引擎与领域策略如何分工？","261":"建议继续采用共享基础设施、领域独立策略的架构。","262":"全局上下文引擎负责：","263":"token 预算；","264":"消息格式与上下文包；","265":"结构化信息装配；","266":"压缩接口；","267":"来源引用；","268":"截断检测；","269":"约束完整性检查；","270":"上下文版本与重建。","271":"领域专家负责定义：","272":"哪些信息是该领域的关键约束；","273":"哪些字段必须完整保留；","274":"哪些结果需要引用原文；","275":"哪些历史内容可以重新检索；","276":"哪些压缩错误会导致严重退化。","277":"模型适配层则负责调整不同模型的提示词组织、上下文长度和输入格式。","278":"这样可以共享工程能力，同时避免用一套通用摘要规则损害编程、手机操作或漫剧制作等不同场景。","279":"7.3 压缩后必须有完整性校验","280":"我建议将关键约束单独保留，并在压缩后进行确定性核验。","281":"例如，原始约束是：","282":"总时长 45 秒；","283":"预算不得超过指定上限；","284":"角色外观保持一致；","285":"最终必须完成音画同步检查。","286":"压缩后，系统需要验证这四项约束仍然存在，并且没有被改变含义。","287":"如果某项约束无法验证，系统应标记为上下文不完整，重新装配或检索原始内容。","288":"不能让模型仅仅回答“我认为约束都保留了”，就认为压缩通过。","289":"7.4 上下文压缩也必须有成本收益判断","290":"更复杂的压缩器可能减少 token，但自身也会产生模型调用和处理延迟。","291":"因此，评估应该比较：","292":"输入 token 减少量；","293":"压缩所需调用成本；","294":"上下文组装延迟；","295":"关键约束保留率；","296":"任务成功率；","297":"返工率；","298":"错误恢复成本。","299":"如果一项压缩策略只能节省少量 token，却需要额外调用一个昂贵模型，而且增加了约束丢失风险，就没有理由默认对所有任务启用。","300":"八、任务恢复时，模型和上下文发生变化怎么办？","301":"这是长任务设计中一个非常重要的边界。","302":"假设 EvoAgent 开始时使用模型 A，运行到一半时手机断网；恢复后，模型 A 不可用，系统只能使用模型 B。","303":"这时不能简单地把原始对话和摘要直接交给模型 B，然后继续。","304":"因为不同模型可能对提示词结构、工具调用格式、上下文压缩方式和规划策略有不同要求。","305":"我建议将恢复分为三个阶段。","306":"8.1 第一阶段：恢复事实状态","307":"先恢复：","308":"当前任务与目标版本；","309":"已验收节点和产物；","310":"未决外部操作；","311":"当前预算与剩余资源；","312":"有效授权和约束；","313":"任务依赖及失败节点。","314":"这个阶段尽可能不依赖大模型推理。","315":"8.2 第二阶段：重新组装模型上下文","316":"根据当前模型和适配策略，重新生成上下文包。","317":"例如：","318":"旧模型使用的提示词格式不再直接沿用；","319":"当前模型无法使用原来的工具协议时，重新生成兼容的工具描述；","320":"旧上下文摘要与持久化状态冲突时，以经过验证的状态为准；","321":"记忆中依赖旧模型的补偿规则，需要检查是否仍然适用。","322":"8.3 第三阶段：重新评估是否能够继续","323":"如果只是模型切换，可以在原任务约束下继续。","324":"但如果模型切换影响了关键能力，或者新模型无法满足当前任务的最低能力要求，就应该暂停相关节点、采用已验证的替代策略，或者请求用户确认。","325":"模型可以变化，任务事实不能随模型一起改变。","326":"这也意味着，长任务的持续性不能依赖某个特定模型记住过去的对话。真正的连续性来自持久化状态、可追溯证据和可重建的上下文。","327":"九、跨设备同步：手机与个人电脑必须有明确的状态所有权","328":"结合 EvoAgent 的手机优先架构，任务可能在 Android 上发起，在个人电脑或 Mini PC 上执行复杂工作，再将结果返回手机。","329":"如果没有明确的状态所有权，就可能出现：","330":"手机认为节点已经完成，电脑却认为还在执行；","331":"电脑更新了任务目标，手机仍然使用旧约束；","332":"两边同时恢复同一个任务，重复执行外部操作；","333":"离线期间双方都修改了同一份任务状态；","334":"任务结果已生成，但手机一直没有收到完成通知。","335":"因此，不能只同步对话历史，而必须同步任务状态、版本和事件。","336":"9.1 建议的状态所有权模型","337":"对于单个任务，在任意时刻应有一个明确的协调者负责推进其状态机。","338":"例如：","339":"手机本地任务：Android 任务引擎是协调者；","340":"电脑执行的长任务：个人电脑上的任务引擎是协调者；","341":"手机负责展示、补充指令和接收结果，但不应与电脑同时独立推进同一组节点。","342":"协调者可以转移，但必须有明确的租约、版本或所有权转移记录，避免两个执行器同时认为自己拥有推进权限。","343":"这并不意味着任务协调者拥有全部数据访问权。文件权限、工具权限和用户授权仍然由独立的权限系统控制。","344":"9.2 使用版本号检测过期状态","345":"建议每次重要状态变更都增加任务修订号，例如：","346":"task_revision","347":"：任务整体修订版本；","348":"state_version","349":"：状态记录版本；","350":"plan_version","351":"：当前 DAG 版本；","352":"context_package_id","353":"：当前上下文快照；","354":"checkpoint_id","355":"：最近一个可信检查点。","356":"当手机恢复连接并提交一项修改时，电脑应当检查该修改基于哪个版本。","357":"如果基础版本已经过期，不能直接覆盖最新状态，而应当进行冲突解决。","358":"例如，用户在手机上取消了一个任务，而电脑离线期间仍然在运行。重新连接后，电脑不能因为本地仍然显示 ","359":"RUNNING","360":"，就忽略取消请求并继续启动新的节点。","361":"系统需要根据任务状态、已经发生的外部副作用和取消规则执行安全收尾。","362":"9.3 不要把事件同步当成状态同步","363":"事件同步解决的是“发生过什么”。","364":"状态同步解决的是“当前权威状态是什么”。","365":"两者相关，但并不等价。","366":"建议采用：","367":"事件日志：保留可追溯的变化历史；","368":"状态快照：快速恢复当前任务；","369":"修订号：检测并发修改；","370":"协调者租约：防止重复推进；","371":"检查点：恢复执行进度；","372":"对账流程：发现事件与状态不一致时重新核验。","373":"这样，即使设备离线很久，也能够在恢复连接后通过事件、版本和检查点重建一致的任务状态。","374":"十、长任务上下文的完整运行流程","375":"把以上机制组合起来，CLTC 的执行闭环应该如下。","376":"这里有两个需要强调的边界。","377":"第一，模型可以提出计划调整，但任务引擎必须检查调整是否违反原始目标、预算和依赖关系。","378":"第二，恢复任务时不能默认从最近一次模型回答继续。应当先恢复持久化状态，核实未决副作用，再决定重新生成哪些上下文。","379":"十一、如何评估上下文与长任务连续性？","380":"上下文系统不能只通过 token 节省量评估。它必须证明任务在压缩、恢复、模型切换和跨设备同步后仍然正确。","381":"建议建立以下评测指标。","382":"指标","383":"需要回答的问题","384":"约束保留率","385":"压缩和恢复后，关键约束是否完整且语义一致？","386":"状态重建准确率","387":"从检查点和事件恢复后，节点状态是否与真实执行状态一致？","388":"恢复成功率","389":"中断后能否在不重复执行危险动作的前提下继续任务？","390":"重复副作用率","391":"是否重复发送、删除、支付或重复生成昂贵产物？","392":"产物复用率","393":"能否正确复用未失效的已验收产物？","394":"任务目标漂移率","395":"长任务执行中是否偏离用户原始目标？","396":"上下文组装成本","397":"每次决策需要多少 token、耗时和额外模型调用？","398":"上下文相关性","399":"被加载的信息是否对当前节点决策有实际帮助？","400":"预算一致性","401":"恢复后是否正确计算已使用与剩余预算？","402":"跨设备状态一致率","403":"手机与个人电脑恢复连接后，权威任务状态是否一致？","404":"未决操作对账率","405":"超时或崩溃后的外部操作是否得到明确核实？","406":"最终验收正确率","407":"是否只有真正满足验收条件的任务才被标记为完成？","408":"其中，约束保留率不能只依靠模型自评。应当通过结构化约束比对、针对性测试和必要的人工抽检来验证。","409":"对于恢复能力，也不能只测试普通进程重启。还应模拟网络中断、外部请求已提交但结果丢失、文件写入中断、模型切换和并发修改等情况。","410":"11.1 建立专门的故障注入测试","411":"我建议至少包含以下测试：","412":"在工具执行前崩溃；","413":"在外部操作提交后崩溃；","414":"在结果返回但尚未保存状态时崩溃；","415":"在节点完成后、检查点写入前崩溃；","416":"上下文压缩时故意移除一项关键约束；","417":"在任务中途切换模型；","418":"手机与个人电脑同时尝试推进任务；","419":"恢复时发现外部任务已完成，但本地状态仍为等待；","420":"用户取消任务后，设备恢复连接；","421":"预算已接近上限时触发恢复和重试。","422":"这些测试能检验系统是否真正具备连续性，而不是仅仅在正常流程中运行顺利。","423":"十二、建议冻结的架构决策","424":"以上是建议纳入 EvoAgent 全量架构的上下文工程与长任务连续性基线。真正落地时，还需要根据不同工具是否支持幂等操作、状态查询、取消和恢复，进一步确定每类节点的执行协议。","425":"十三、下一专项：任务编排、动态 DAG 与 ReAct 的协同治理","426":"现在，我们已经分别讨论了记忆、上下文、持久化状态和长任务恢复。","427":"但这些设计最终都要服务于一个实际问题：","428":"EvoAgent 面对复杂任务时，究竟由谁决定下一步做什么？由谁决定任务应该拆成哪些节点？什么时候使用固定工作流，什么时候动态规划，又什么时候应该让 ReAct 临场调整？","429":"这不是简单地在 Planner、ReAct 和 DAG 之间三选一。","430":"一个复杂任务可能需要：","431":"用 Planner 制定初始方案；","432":"用 DAG 表达依赖和并行关系；","433":"用 ReAct 执行单个节点内的动态工具调用；","434":"用验收器判断节点结果；","435":"用恢复控制器处理失败；","436":"用任务治理层批准计划变更；","437":"用长任务引擎持久化状态并恢复执行。","438":"如果这些模块之间没有明确的控制权边界，就可能出现多个规划器反复改计划、ReAct 绕过工作流依赖、失败后重复执行已完成节点，或者局部智能体不断重试却耗尽整个任务预算。","439":"下一专项建议设计 ","440":"Task Orchestration & Dynamic DAG Governance Engine（任务编排与动态 DAG 治理引擎）","441":"，重点研究：","442":"专家智能体、Planner、ReAct、DAG 和任务执行器各自的职责；","443":"如何区分固定工作流、动态计划和临时行动策略；","444":"哪些节点可以并行、哪些必须串行，以及依赖如何验证；","445":"如何在执行过程中动态修改 DAG，而不破坏已完成节点和原始目标；","446":"如何决定重试、重新规划、局部回滚还是全局恢复；","447":"如何避免多个专家同时修改计划造成冲突；","448":"如何让失败诊断真正改变后续执行策略，而不是只生成更多重试；","449":"如何协调模型调用预算、任务时间预算和外部工具成本；","450":"如何把成功跑通的任务沉淀为稳定工作流，同时保留必要的动态分支；","451":"如何评估计划质量、执行效率、恢复效果和最终任务完成质量。","452":"这一步会把前面设计的智能模块连接到统一的执行控制体系中，明确 EvoAgent 如何从理解目标走到稳定交付结果，同时保留处理未知情况的灵活性。"},"fallbackMarkdown":"# EvoAgent 第十七专项：上下文工程与长任务连续性引擎\n\n这一轮继续深入 EvoAgent 的智能内核。\n\n前面我们已经区分了历史记录、长期记忆、经验和策略，也明确了专家隔离、跨专家知识共享、记忆可信度与上下文压缩的基本原则。\n\n现在要解决更贴近执行的问题：\n\n**当一个任务很长、涉及多个专家、几十个工具调用，甚至中途断网、切换模型、重启应用时，EvoAgent 如何确保自己没有忘记目标、没有丢失关键约束，也不会把尚未完成的工作误认为已经完成？**\n\n这不是单纯的上下文窗口问题。\n\n即使模型拥有很大的上下文窗口，如果任务状态、工具结果、记忆来源和恢复检查点没有正确管理，智能体仍然会迷失方向。\n\n反过来，即使模型上下文有限，只要任务状态保存得当、信息选择合理、执行能够恢复，智能体也可以可靠地完成很长的工作。\n\n我建议将本专项定义为：\n\n**Context Engineering &amp; Long-Running Task Continuity Engine，简称 CLTC。**\n\n它负责将任务目标、运行状态、必要记忆、执行证据和模型上下文组织成一个可持续推进、可中断恢复、可验证的任务系统。\n\n## 一、第一性原理：上下文不是记忆库，也不是任务状态数据库\n\n首先必须把四个容易混淆的概念分开。\n\n它们之间的关系应该是：\n\n- 任务状态保存“现在实际处于什么状态”；\n- 执行证据说明“为什么可以认为处于这个状态”；\n- 长期记忆提供“以前学到的哪些知识可能有帮助”；\n- 模型上下文只装入“本轮决策需要使用的内容”。\n\n例如，一项视频生成任务的状态数据库记录某个镜头已经生成，文件路径和内容哈希也已保存；执行证据记录生成服务返回的任务 ID 与最终文件验收结果。\n\n此时，模型不需要反复看到整个生成历史，只需要知道这个镜头已经验收通过、文件在哪里、哪些后续节点依赖它。\n\n**关键原则：不能依靠模型记住全部历史来维持任务连续性。任务连续性必须由外部持久化状态保证。**\n\n---\n\n# 二、建立五层上下文架构\n\n我建议 CLTC 采用五层逻辑架构。它们可以共享存储和代码基础设施，但职责必须分开。\n\n## L1 · 目标与约束层\n\n保存原始用户目标、明确约束、授权范围、验收标准、预算上限和禁止事项。\n\n核心要求：不能被普通摘要静默改写。\n\n## L2 · 持久化任务状态层\n\n保存 DAG、节点状态、依赖、当前检查点、重试计数、资源占用和待处理动作。\n\n核心要求：状态变化需要明确、可验证、可恢复。\n\n## L3 · 执行证据层\n\n关联工具结果、文件版本、模型调用摘要、验收报告、错误记录和状态转换依据。\n\n核心要求：区分动作已尝试、结果已观察和结果已验收。\n\n## L4 · 上下文组装层\n\n根据当前节点、专家、模型能力、风险和 token 预算选择需要的信息。\n\n核心要求：按需加载，而不是把所有历史一并塞进上下文。\n\n## L5 · 推理与行动层\n\n由专家、Planner、ReAct 和工具接口根据当前上下文提出下一步动作。\n\n核心要求：推理结果必须经过状态、权限和执行门禁检查。\n\n这里有一个关键的架构决定：\n\n**上下文组装层不应该成为事实的唯一来源。**\n\n它是一个面向模型的视图，而不是权威数据库。\n\n如果摘要说某个步骤已完成，但任务状态库和执行证据显示该步骤仍在等待外部结果，就必须以经过验证的状态记录为准，并将摘要视为过期信息。\n\n---\n\n# 三、目标、约束和任务状态必须分开保存\n\n长任务最容易出现的问题之一，是随着对话推进，原始目标逐渐被新指令、临时决定和模型摘要覆盖。\n\n例如，用户最初要求：\n\n> 制作一部 45 秒的动态视频漫剧，角色形象保持一致，总预算不超过指定额度，最后必须检查音画同步。\n\n任务进行到一半时，用户又提出“先把前 15 秒做出来看看”。\n\n这是一项阶段性要求，不意味着原来的 45 秒总目标、角色一致性要求和总预算自动失效。\n\n因此，CLTC 应当把任务目标拆成三个层次。\n\n## 3.1 原始目标、当前阶段目标和执行计划\n\n**原始目标 Original Objective**\n\n用户希望最终实现什么，以及明确提出的全局限制。\n\n除非发生明确的目标变更，否则持续有效。\n\n**阶段目标 Phase Objective**\n\n当前阶段需要交付什么中间成果。\n\n例如：先交付 15 秒样片，供用户确认角色和风格。\n\n**执行计划 Execution Plan**\n\n当前准备采用的 DAG、节点顺序、工具和恢复策略。\n\n可以根据执行结果修改，但必须继续满足有效的目标与约束。\n\n这三个层次不能合并成一段不断改写的摘要。\n\n否则模型可能因为最新阶段目标只提到 15 秒，就把总时长误解为 15 秒；也可能因为某个执行计划发生变化，就丢失原始验收要求。\n\n## 3.2 目标变更必须形成明确的变更记录\n\n建议将目标变更设计成独立的 `Objective Revision`：\n\n- 原始目标版本；\n- 新目标版本；\n- 用户明确提出的变更；\n- 被修改、被保留和被取消的约束；\n- 变更影响的任务节点；\n- 是否需要重新规划；\n- 是否需要重新评估预算；\n- 是否需要用户确认。\n\n例如，用户明确说“不要做 45 秒了，改成 15 秒”，系统才能把总时长目标正式修改为 15 秒。\n\n如果只是说“先做 15 秒给我看”，系统应该建立一个阶段目标，不应覆盖总目标。\n\n## 3.3 约束需要结构化，而不是只放在提示词中\n\n建议将任务约束分为：\n\n- 质量约束；\n- 预算约束；\n- 时间约束；\n- 工具与环境约束；\n- 文件和数据范围约束；\n- 用户授权约束；\n- 验收约束；\n- 禁止事项。\n\n其中，硬性约束应保存在独立的结构化记录中，模型上下文只是它们的呈现形式。\n\n如果上下文压缩器把“预算不超过 100 元”压缩成“尽量节约成本”，这不是无害的摘要，而是约束丢失。\n\n---\n\n# 四、长任务必须有持久化状态机\n\n接下来解决一个关键问题：一个任务究竟在什么状态下才算完成？\n\n不能仅依赖模型回答“我已经完成了”。\n\n对于长任务，我建议采用显式状态机，并区分任务状态、节点状态和外部操作状态。\n\n## 4.1 任务级状态\n\n这是一组建议的任务级状态，并不意味着每个任务都必须依次经过所有状态。\n\n例如，简单任务可能从 `READY` 直接进入 `RUNNING`，最后进入 `VERIFYING` 和 `COMPLETED`。\n\n## 4.2 节点级状态\n\nDAG 中的每个节点还需要独立状态：\n\n- `BLOCKED`：依赖尚未满足；\n- `READY`：可以执行；\n- `RUNNING`：执行中；\n- `WAITING_EXTERNAL`：等待外部结果；\n- `SUCCEEDED`：执行结果已通过该节点的验收条件；\n- `FAILED`：执行失败；\n- `RETRY_PENDING`：允许重试，等待调度；\n- `SKIPPED`：经过明确的策略决定跳过；\n- `CANCELLED`：已取消；\n- `NEEDS_RECONCILIATION`：结果不确定，需要核对真实状态。\n\n特别注意，`SUCCEEDED` 必须有明确的定义。\n\n例如，一个视频生成 API 返回了任务 ID，只能证明生成请求已被接受，不能证明视频文件已经生成，更不能证明视频质量验收已经通过。\n\n## 4.3 状态变更必须通过合法转换\n\n建议由任务引擎管理状态迁移，不允许 Planner 或模型直接把任意节点改成成功。\n\n例如：\n\n- `READY → RUNNING`：执行器已取得执行权；\n- `RUNNING → WAITING_EXTERNAL`：外部操作已提交，等待结果；\n- `WAITING_EXTERNAL → NEEDS_RECONCILIATION`：等待超时，实际结果未知；\n- `NEEDS_RECONCILIATION → SUCCEEDED`：通过外部状态核查与验收确认成功；\n- `RUNNING → FAILED`：符合失败条件，并记录失败证据。\n\n这能防止模型因为摘要中写着“已完成”，就直接跳过尚未完成的节点。\n\n---\n\n# 五、检查点与断点恢复：不能把“重新开始”当作默认恢复策略\n\n对于几十个节点的 DAG，如果中途断网、进程崩溃或模型调用超时，直接重新执行整个任务可能会重复花钱、覆盖文件，甚至重复触发外部副作用。\n\n因此，CLTC 必须与工作流引擎协作，建立持久化检查点。\n\n## 5.1 检查点保存什么？\n\n一个有效检查点至少需要记录：\n\n| 类别 | 必须保存的内容 |\n|--------|--------|\n| 任务身份 | `task_id`、任务版本和目标版本 |\n| 当前状态 | 任务状态、节点状态和已完成依赖 |\n| 执行进度 | 已完成步骤、待执行步骤、当前执行尝试 |\n| 产物清单 | 文件路径、版本、内容哈希和验收状态 |\n| 外部操作 | 外部任务 ID、请求幂等键、操作状态与查询方式 |\n| 资源信息 | 已使用预算、剩余预算、重试次数和时间限制 |\n| 运行版本 | 专家配置、工具版本、模型适配版本 |\n| 恢复信息 | 最近的可信检查点、未决操作和恢复策略 |\n\n检查点不需要保存全部模型上下文。\n\n相反，应该优先保存可以重建上下文的结构化状态和证据引用。这样即使模型换了、上下文窗口不同，任务仍然可以恢复。\n\n## 5.2 检查点何时创建？\n\n建议至少在以下节点创建检查点：\n\n- 一个具有实际副作用的操作开始之前；\n- 重要外部操作已提交之后；\n- DAG 节点完成并通过验收之后；\n- 大型文件或素材生成完成之后；\n- 任务阶段切换时；\n- 用户暂停或取消任务时；\n- 执行计划发生重大变化时。\n\n对于高成本或难以重现的节点，可以提高检查点频率；对于低成本、无副作用的内部步骤，则不必每一步都持久化完整快照。\n\n## 5.3 必须区分执行一次与结果确认\n\n这是断点恢复最重要的规则。\n\n假设 EvoAgent 调用云端视频生成服务，服务已经收到请求，但手机断网，系统没有收到结果。\n\n此时有三种可能：\n\n1. 请求根本没有到达服务端；\n2. 请求已经执行，结果尚未返回；\n3. 请求已完成，但返回消息丢失。\n\n如果系统直接重试，可能重复生成视频并再次收费。\n\n正确的恢复顺序应当是：\n\n1. 查找原操作的幂等键和外部任务 ID；\n2. 如果服务支持，先查询原任务状态；\n3. 如果已完成，恢复结果引用；\n4. 如果仍在运行，继续等待；\n5. 如果明确失败，按策略决定是否重试；\n6. 如果无法确定状态，则保持 `NEEDS_RECONCILIATION`，不要假定失败。\n\n对于不支持幂等请求或状态查询的外部服务，系统必须显式标记这种限制，并采取保守的恢复策略。\n\n**超时不等于失败，进程崩溃不等于操作没有发生。**\n\n## 5.4 文件产物也必须具备幂等性\n\n例如，漫剧制作流程中的视频合成节点不应该每次恢复时都随意覆盖同一个文件。\n\n建议采用：\n\n- 稳定的节点产物 ID；\n- 明确的输入版本；\n- 内容哈希；\n- 临时输出文件；\n- 验收成功后原子提交；\n- 已验收产物的复用规则。\n\n如果输入素材没有变化、工具版本和合成参数也满足复用条件，就可以复用已验收产物，避免重复计算。\n\n但如果角色素材、分镜或音轨发生变化，系统必须识别依赖失效，只重做受影响的节点，而不是错误地复用旧结果。\n\n---\n\n# 六、上下文组装：每次推理究竟应该看到什么？\n\n现在进入模型上下文设计本身。\n\n我不建议把上下文构造成一段不断增长的对话，而建议将它视为一个有预算、可重建、有明确来源的工作视图。\n\n## 6.1 统一上下文包\n\n建议定义 `Context Package`，每次模型调用之前由上下文引擎生成。\n\n```json\n\n{\n  \"context_package_id\": \"ctx-9001\",\n  \"task_id\": \"task-884\",\n  \"task_revision\": 7,\n  \"target_node_id\": \"render-final-video\",\n  \"objective\": {\n    \"summary\": \"Render and validate the final video\",\n    \"constraints_ref\": \"constraints-v3\",\n    \"acceptance_ref\": \"acceptance-v5\"\n  },\n  \"current_state\": {\n    \"completed_nodes\": [\n      \"storyboard\",\n      \"voiceover\",\n      \"scene_generation\"\n    ],\n    \"blocked_nodes\": [],\n    \"pending_node\": \"render-final-video\"\n  },\n  \"relevant_evidence_refs\": [\n    \"artifact-manifest-21\",\n    \"verification-report-18\"\n  ],\n  \"relevant_memory_refs\": [\n    \"mem-2048\"\n  ],\n  \"active_policy_refs\": [\n    \"budget-policy-v2\",\n    \"authorization-policy-v3\"\n  ],\n  \"context_budget\": {\n    \"max_input_tokens\": 12000,\n    \"reserved_output_tokens\": 2000\n  },\n  \"omissions\": [\n    \"Old intermediate dialogue not needed for this node\"\n  ]\n}\n```\n\n这是一个概念示例。实际上下文包还需要记录组装器版本、所用模型的实际限制、信息优先级和来源完整性状态。\n\n其中最重要的不是这些字段本身，而是三个原则：\n\n- 上下文必须能够从持久化状态重建；\n- 重要信息必须能追溯到来源；\n- 被省略的信息必须在必要时可以重新获取。\n\n模型看到的是上下文包渲染后的内容，而不是直接拥有修改任务状态的权限。\n\n## 6.2 上下文选择应该按优先级进行\n\n建议采用以下顺序：\n\n1. 当前任务的硬性约束与有效授权；\n2. 当前节点的目标和验收条件；\n3. 当前节点的输入、依赖和真实状态；\n4. 尚未解决的问题和关键不确定性；\n5. 必要的历史决策与证据；\n6. 与当前任务相关的有效记忆；\n7. 其他有助于推理的历史信息。\n\n这不是说高优先级内容一定要以固定文本顺序出现，而是说，在预算不足时，系统不能先丢掉硬性约束，却保留大量无关的历史对话。\n\n如果连最低必要上下文都无法装入模型输入窗口，系统应当拆分任务、改用适配的模型或采用结构化工具，而不是继续压缩到关键约束无法辨认。\n\n---\n\n# 七、上下文压缩：不能只看节省了多少 Token\n\n上下文压缩通常很容易被错误地定义为“在尽可能少的 token 里保留尽可能多的信息”。\n\n对于 EvoAgent，这个目标不够准确。\n\n更合理的目标是：\n\n**在满足任务正确性、约束完整性和可追溯性要求的前提下，以合理成本提供完成当前决策所需的最少信息。**\n\n## 7.1 不同信息采用不同压缩策略\n\n| 信息类型 | 建议策略 |\n|--------|--------|\n| 原始目标与硬性约束 | 结构化保存，压缩后必须能验证语义完整性 |\n| 用户当前明确指令 | 保留原始语义和变更关系，不得由历史摘要覆盖 |\n| 任务节点状态 | 使用结构化状态，不通过自然语言摘要推断 |\n| 工具返回的大型结果 | 保存原始结果引用，提取当前决策需要的字段 |\n| 代码、配置和技术文档 | 优先使用结构化提取、AST、符号索引或按需读取 |\n| 视觉与视频素材 | 保存资产 ID、版本、元数据和验收结果，按需加载素材 |\n| 历史对话 | 生成有来源的摘要，保留必要的原文引用 |\n| 失败诊断与经验 | 保留证据、假设状态、适用范围和反例 |\n| 模型自由生成的中间内容 | 可以压缩或丢弃，但不能把未经验证的内容升级为事实 |\n\n## 7.2 全局压缩引擎与领域策略如何分工？\n\n建议继续采用共享基础设施、领域独立策略的架构。\n\n全局上下文引擎负责：\n\n- token 预算；\n- 消息格式与上下文包；\n- 结构化信息装配；\n- 压缩接口；\n- 来源引用；\n- 截断检测；\n- 约束完整性检查；\n- 上下文版本与重建。\n\n领域专家负责定义：\n\n- 哪些信息是该领域的关键约束；\n- 哪些字段必须完整保留；\n- 哪些结果需要引用原文；\n- 哪些历史内容可以重新检索；\n- 哪些压缩错误会导致严重退化。\n\n模型适配层则负责调整不同模型的提示词组织、上下文长度和输入格式。\n\n这样可以共享工程能力，同时避免用一套通用摘要规则损害编程、手机操作或漫剧制作等不同场景。\n\n## 7.3 压缩后必须有完整性校验\n\n我建议将关键约束单独保留，并在压缩后进行确定性核验。\n\n例如，原始约束是：\n\n- 总时长 45 秒；\n- 预算不得超过指定上限；\n- 角色外观保持一致；\n- 最终必须完成音画同步检查。\n\n压缩后，系统需要验证这四项约束仍然存在，并且没有被改变含义。\n\n如果某项约束无法验证，系统应标记为上下文不完整，重新装配或检索原始内容。\n\n不能让模型仅仅回答“我认为约束都保留了”，就认为压缩通过。\n\n## 7.4 上下文压缩也必须有成本收益判断\n\n更复杂的压缩器可能减少 token，但自身也会产生模型调用和处理延迟。\n\n因此，评估应该比较：\n\n- 输入 token 减少量；\n- 压缩所需调用成本；\n- 上下文组装延迟；\n- 关键约束保留率；\n- 任务成功率；\n- 返工率；\n- 错误恢复成本。\n\n如果一项压缩策略只能节省少量 token，却需要额外调用一个昂贵模型，而且增加了约束丢失风险，就没有理由默认对所有任务启用。\n\n---\n\n# 八、任务恢复时，模型和上下文发生变化怎么办？\n\n这是长任务设计中一个非常重要的边界。\n\n假设 EvoAgent 开始时使用模型 A，运行到一半时手机断网；恢复后，模型 A 不可用，系统只能使用模型 B。\n\n这时不能简单地把原始对话和摘要直接交给模型 B，然后继续。\n\n因为不同模型可能对提示词结构、工具调用格式、上下文压缩方式和规划策略有不同要求。\n\n我建议将恢复分为三个阶段。\n\n## 8.1 第一阶段：恢复事实状态\n\n先恢复：\n\n- 当前任务与目标版本；\n- 已验收节点和产物；\n- 未决外部操作；\n- 当前预算与剩余资源；\n- 有效授权和约束；\n- 任务依赖及失败节点。\n\n这个阶段尽可能不依赖大模型推理。\n\n## 8.2 第二阶段：重新组装模型上下文\n\n根据当前模型和适配策略，重新生成上下文包。\n\n例如：\n\n- 旧模型使用的提示词格式不再直接沿用；\n- 当前模型无法使用原来的工具协议时，重新生成兼容的工具描述；\n- 旧上下文摘要与持久化状态冲突时，以经过验证的状态为准；\n- 记忆中依赖旧模型的补偿规则，需要检查是否仍然适用。\n\n## 8.3 第三阶段：重新评估是否能够继续\n\n如果只是模型切换，可以在原任务约束下继续。\n\n但如果模型切换影响了关键能力，或者新模型无法满足当前任务的最低能力要求，就应该暂停相关节点、采用已验证的替代策略，或者请求用户确认。\n\n**模型可以变化，任务事实不能随模型一起改变。**\n\n这也意味着，长任务的持续性不能依赖某个特定模型记住过去的对话。真正的连续性来自持久化状态、可追溯证据和可重建的上下文。\n\n---\n\n# 九、跨设备同步：手机与个人电脑必须有明确的状态所有权\n\n结合 EvoAgent 的手机优先架构，任务可能在 Android 上发起，在个人电脑或 Mini PC 上执行复杂工作，再将结果返回手机。\n\n如果没有明确的状态所有权，就可能出现：\n\n- 手机认为节点已经完成，电脑却认为还在执行；\n- 电脑更新了任务目标，手机仍然使用旧约束；\n- 两边同时恢复同一个任务，重复执行外部操作；\n- 离线期间双方都修改了同一份任务状态；\n- 任务结果已生成，但手机一直没有收到完成通知。\n\n因此，不能只同步对话历史，而必须同步任务状态、版本和事件。\n\n## 9.1 建议的状态所有权模型\n\n对于单个任务，在任意时刻应有一个明确的协调者负责推进其状态机。\n\n例如：\n\n- 手机本地任务：Android 任务引擎是协调者；\n- 电脑执行的长任务：个人电脑上的任务引擎是协调者；\n- 手机负责展示、补充指令和接收结果，但不应与电脑同时独立推进同一组节点。\n\n协调者可以转移，但必须有明确的租约、版本或所有权转移记录，避免两个执行器同时认为自己拥有推进权限。\n\n这并不意味着任务协调者拥有全部数据访问权。文件权限、工具权限和用户授权仍然由独立的权限系统控制。\n\n## 9.2 使用版本号检测过期状态\n\n建议每次重要状态变更都增加任务修订号，例如：\n\n- `task_revision`：任务整体修订版本；\n- `state_version`：状态记录版本；\n- `plan_version`：当前 DAG 版本；\n- `context_package_id`：当前上下文快照；\n- `checkpoint_id`：最近一个可信检查点。\n\n当手机恢复连接并提交一项修改时，电脑应当检查该修改基于哪个版本。\n\n如果基础版本已经过期，不能直接覆盖最新状态，而应当进行冲突解决。\n\n例如，用户在手机上取消了一个任务，而电脑离线期间仍然在运行。重新连接后，电脑不能因为本地仍然显示 `RUNNING`，就忽略取消请求并继续启动新的节点。\n\n系统需要根据任务状态、已经发生的外部副作用和取消规则执行安全收尾。\n\n## 9.3 不要把事件同步当成状态同步\n\n事件同步解决的是“发生过什么”。\n\n状态同步解决的是“当前权威状态是什么”。\n\n两者相关，但并不等价。\n\n建议采用：\n\n- 事件日志：保留可追溯的变化历史；\n- 状态快照：快速恢复当前任务；\n- 修订号：检测并发修改；\n- 协调者租约：防止重复推进；\n- 检查点：恢复执行进度；\n- 对账流程：发现事件与状态不一致时重新核验。\n\n这样，即使设备离线很久，也能够在恢复连接后通过事件、版本和检查点重建一致的任务状态。\n\n---\n\n# 十、长任务上下文的完整运行流程\n\n把以上机制组合起来，CLTC 的执行闭环应该如下。\n\n这里有两个需要强调的边界。\n\n第一，模型可以提出计划调整，但任务引擎必须检查调整是否违反原始目标、预算和依赖关系。\n\n第二，恢复任务时不能默认从最近一次模型回答继续。应当先恢复持久化状态，核实未决副作用，再决定重新生成哪些上下文。\n\n---\n\n# 十一、如何评估上下文与长任务连续性？\n\n上下文系统不能只通过 token 节省量评估。它必须证明任务在压缩、恢复、模型切换和跨设备同步后仍然正确。\n\n建议建立以下评测指标。\n\n| 指标 | 需要回答的问题 |\n|--------|--------|\n| 约束保留率 | 压缩和恢复后，关键约束是否完整且语义一致？ |\n| 状态重建准确率 | 从检查点和事件恢复后，节点状态是否与真实执行状态一致？ |\n| 恢复成功率 | 中断后能否在不重复执行危险动作的前提下继续任务？ |\n| 重复副作用率 | 是否重复发送、删除、支付或重复生成昂贵产物？ |\n| 产物复用率 | 能否正确复用未失效的已验收产物？ |\n| 任务目标漂移率 | 长任务执行中是否偏离用户原始目标？ |\n| 上下文组装成本 | 每次决策需要多少 token、耗时和额外模型调用？ |\n| 上下文相关性 | 被加载的信息是否对当前节点决策有实际帮助？ |\n| 预算一致性 | 恢复后是否正确计算已使用与剩余预算？ |\n| 跨设备状态一致率 | 手机与个人电脑恢复连接后，权威任务状态是否一致？ |\n| 未决操作对账率 | 超时或崩溃后的外部操作是否得到明确核实？ |\n| 最终验收正确率 | 是否只有真正满足验收条件的任务才被标记为完成？ |\n\n其中，约束保留率不能只依靠模型自评。应当通过结构化约束比对、针对性测试和必要的人工抽检来验证。\n\n对于恢复能力，也不能只测试普通进程重启。还应模拟网络中断、外部请求已提交但结果丢失、文件写入中断、模型切换和并发修改等情况。\n\n## 11.1 建立专门的故障注入测试\n\n我建议至少包含以下测试：\n\n- 在工具执行前崩溃；\n- 在外部操作提交后崩溃；\n- 在结果返回但尚未保存状态时崩溃；\n- 在节点完成后、检查点写入前崩溃；\n- 上下文压缩时故意移除一项关键约束；\n- 在任务中途切换模型；\n- 手机与个人电脑同时尝试推进任务；\n- 恢复时发现外部任务已完成，但本地状态仍为等待；\n- 用户取消任务后，设备恢复连接；\n- 预算已接近上限时触发恢复和重试。\n\n这些测试能检验系统是否真正具备连续性，而不是仅仅在正常流程中运行顺利。\n\n---\n\n# 十二、建议冻结的架构决策\n\n以上是建议纳入 EvoAgent 全量架构的上下文工程与长任务连续性基线。真正落地时，还需要根据不同工具是否支持幂等操作、状态查询、取消和恢复，进一步确定每类节点的执行协议。\n\n# 十三、下一专项：任务编排、动态 DAG 与 ReAct 的协同治理\n\n现在，我们已经分别讨论了记忆、上下文、持久化状态和长任务恢复。\n\n但这些设计最终都要服务于一个实际问题：\n\n**EvoAgent 面对复杂任务时，究竟由谁决定下一步做什么？由谁决定任务应该拆成哪些节点？什么时候使用固定工作流，什么时候动态规划，又什么时候应该让 ReAct 临场调整？**\n\n这不是简单地在 Planner、ReAct 和 DAG 之间三选一。\n\n一个复杂任务可能需要：\n\n- 用 Planner 制定初始方案；\n- 用 DAG 表达依赖和并行关系；\n- 用 ReAct 执行单个节点内的动态工具调用；\n- 用验收器判断节点结果；\n- 用恢复控制器处理失败；\n- 用任务治理层批准计划变更；\n- 用长任务引擎持久化状态并恢复执行。\n\n如果这些模块之间没有明确的控制权边界，就可能出现多个规划器反复改计划、ReAct 绕过工作流依赖、失败后重复执行已完成节点，或者局部智能体不断重试却耗尽整个任务预算。\n\n下一专项建议设计 **Task Orchestration &amp; Dynamic DAG Governance Engine（任务编排与动态 DAG 治理引擎）**，重点研究：\n\n1. 专家智能体、Planner、ReAct、DAG 和任务执行器各自的职责；\n2. 如何区分固定工作流、动态计划和临时行动策略；\n3. 哪些节点可以并行、哪些必须串行，以及依赖如何验证；\n4. 如何在执行过程中动态修改 DAG，而不破坏已完成节点和原始目标；\n5. 如何决定重试、重新规划、局部回滚还是全局恢复；\n6. 如何避免多个专家同时修改计划造成冲突；\n7. 如何让失败诊断真正改变后续执行策略，而不是只生成更多重试；\n8. 如何协调模型调用预算、任务时间预算和外部工具成本；\n9. 如何把成功跑通的任务沉淀为稳定工作流，同时保留必要的动态分支；\n10. 如何评估计划质量、执行效率、恢复效果和最终任务完成质量。\n\n这一步会把前面设计的智能模块连接到统一的执行控制体系中，明确 EvoAgent 如何从理解目标走到稳定交付结果，同时保留处理未知情况的灵活性。","fallbackMarkdownVersion":1,"clientDefinedWidgets":{"755886d4-5668-52be-b777-0ff58b017b03":{"status":"resolved","refIndex":0,"isStreaming":false}},"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6","turn_exchange_id":"5e4f6d52-da8f-4786-9c74-8955202d2c2f","request_id":"faf0767a-fc74-49fe-a665-3bccc40d1615","message_type":