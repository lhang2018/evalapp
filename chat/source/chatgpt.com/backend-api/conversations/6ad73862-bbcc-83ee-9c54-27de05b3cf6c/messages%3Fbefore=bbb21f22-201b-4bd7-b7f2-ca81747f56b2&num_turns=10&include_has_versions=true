,null,__dilConstants[\"382\"]),__dilConstants[\"383\"]),__dil.jsx(\"list\",{\"marker\":\"number\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"384\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"385\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"386\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"387\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"388\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"389\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"390\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"391\"]))),__dil.jsx(\"text\",null,__dilConstants[\"392\"],__dil.jsx(\"bold\",null,__dilConstants[\"393\"]),__dilConstants[\"394\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第九专项：自我诊断、自我修复与故障恢复系统","1":"这一轮我们继续深入智能体本身的智能机制，暂时不展开服务器部署和分布式基础设施。","2":"前面已经设计了经验学习系统和能力自我模型。现在要解决更直接的问题：","3":"当 EvoAgent 正在执行任务时发现自己出了问题，它如何判断问题在哪里、选择正确的修复方法、验证修复效果，并决定是否将这次修复沉淀为长期改进？","4":"这与普通的重试机制有本质区别。","5":"普通重试是：失败了，再试一次。","6":"自我修复是：发现异常，分析原因，选择修复策略，验证是否有效，并决定是否需要改变后续执行方式。","7":"例如，EvoAgent 让手机自动打开某个应用，结果没有进入目标页面。","8":"一个简单智能体可能不断重复点击。","9":"一个具备自我修复能力的智能体应该依次判断：","10":"应用是否真的启动了？","11":"当前页面是否与预期不同？","12":"是点击坐标错误，还是界面布局变化？","13":"是无障碍节点识别失败，还是权限不足？","14":"是网络请求没有完成，还是页面仍在加载？","15":"是否需要重新观察界面、改用另一种定位方式，或者暂停任务？","16":"核心原则：先诊断，再修复；先验证，再恢复；只有找到可复用的证据，才考虑长期进化。","17":"一、自我修复系统必须与执行系统分离","18":"我建议为 EvoAgent 建立独立的 ","19":"Self-Repair Engine","20":"，而不是把所有恢复逻辑塞进 ReAct 循环。","21":"原因很简单：执行智能体的目标是完成当前任务，而诊断器的目标是判断当前执行为什么没有达到预期。这两个目标有关联，但不能完全合并。","22":"如果执行模型既负责做事，又负责判断自己的行为是否正确，它可能会为已经失败的方案不断寻找理由。","23":"因此，系统应该有三个相互协作但职责不同的部分：","24":"执行智能体","25":"理解目标、制定计划、调用工具、完成当前任务。","26":"异常检测与诊断器","27":"识别异常、重建事实、提出根因假设、评估证据。","28":"自我修复控制器","29":"选择修复动作，检查风险与预算，批准或拒绝恢复方案。","30":"恢复执行与独立验收","31":"执行修复，检查实际状态，确认成功、部分恢复或仍然失败。","32":"这里的诊断器可以调用模型辅助分析，但关键事实应来自实际执行轨迹、工具结果和可验证状态。","33":"修复控制器则负责决定哪些动作可以自动执行，哪些必须等待用户授权，哪些必须停止。","34":"二、第一步：系统如何发现自己正在出问题？","35":"如果只在最终任务失败后才启动诊断，很多问题已经造成了额外成本，甚至产生不可逆副作用。","36":"所以，自我修复系统需要同时识别两种情况：","37":"结果异常：","38":" 已经明确失败，例如工具返回错误、测试未通过。","39":"过程异常：","40":" 任务暂时还没失败，但执行轨迹显示出明显风险，例如连续重复操作、成本异常增长、状态没有进展。","41":"我建议建立五类异常检测机制。","42":"异常类型","43":"识别依据","44":"示例","45":"结果异常","46":"预期结果与实际结果不一致","47":"文件修改后测试失败","48":"状态异常","49":"实际环境状态与任务状态冲突","50":"任务记录显示应用已打开，但系统实际没有打开","51":"行为异常","52":"出现重复、循环或无效动作","53":"连续三次点击同一个无响应按钮","54":"资源异常","55":"预算、延迟、内存或调用次数超出限制","56":"模型调用成本持续增加","57":"可信度异常","58":"关键结论缺乏证据，或证据相互矛盾","59":"模型声称操作成功，但没有状态验证","60":"这些异常不应该全部依赖大模型判断。","61":"例如，超时、预算超限、重复调用、状态字段缺失等情况，可以由确定性规则检测。复杂的语义异常、意图偏差和疑似推理错误，才需要模型辅助诊断。","62":"2.1 一个关键设计：预期状态与实际状态必须分开保存","63":"假设手机操作智能体执行“打开某个应用”。","64":"它可能记录了：","65":"计划状态：应用已启动；","66":"工具状态：启动请求已提交；","67":"实际观察：当前前台仍然是桌面；","68":"验收状态：目标未达成。","69":"如果只维护一个 ","70":"success=true/false","71":" 字段，这些信息就会被混在一起。","72":"建议将任务状态拆分为：","73":"desired_state","74":"：希望达到的状态；","75":"predicted_state","76":"：模型认为当前应该是什么状态；","77":"observed_state","78":"：实际观察到的状态；","79":"verified_state","80":"：经过验收确认的状态；","81":"execution_status","82":"：当前执行生命周期状态。","83":"这样，系统可以检测到模型判断、工具返回和实际环境之间的差异，而不是盲目相信其中某一个。","84":"2.2 检测到异常后，不要立即启动昂贵诊断","85":"我建议采用分级触发：","86":"轻微异常：执行一次低成本状态检查；","87":"可恢复错误：调用工具契约规定的恢复机制；","88":"重复异常：启动根因诊断；","89":"高风险异常：立即暂停相关动作并检查安全状态；","90":"重大异常：隔离相关能力或版本，阻止继续调用。","91":"例如，普通的文件读取失败可能只需要检查路径和权限；如果一个工具连续返回与实际状态不符的成功结果，就应该提高警惕，暂停依赖该工具的后续关键操作。","92":"三、第二步：诊断器如何找到真正的根因？","93":"这是整个自修复系统最难、也最有价值的部分。","94":"我建议把根因分析拆成四个层次，而不是让模型直接回答“为什么失败”。","95":"D1：现象确认","96":"发生了什么？是否确实偏离预期？有没有足够证据确认异常？","97":"D2：故障定位","98":"问题最早出现在哪个环节：理解、规划、上下文、工具、环境、状态管理还是验收？","99":"D3：根因假设","100":"列出可能原因、支持证据、反证、未验证条件及其相对可信程度。","101":"D4：根因验证","102":"通过安全的状态检查、回放、对照实验或局部测试，判断哪种解释最符合事实。","103":"3.1 必须区分故障位置与根本原因","104":"例如，任务在验收阶段失败，并不意味着验收器就是根因。","105":"可能是：","106":"上游工具真的没有完成操作；","107":"工具完成了，但没有返回必要证据；","108":"任务状态没有及时更新；","109":"验收器读取了过期数据；","110":"验收规则本身写错了。","111":"“失败在哪个环节被发现”和“哪个组件导致了失败”是两个不同问题。","112":"系统应先定位首次出现的异常，再分析原因。这样才能避免只修补最后暴露问题的模块。","113":"3.2 诊断器应输出结构化报告","114":"例如：","115":"7bf82ad7-9a4c-52a0-947e-1af1ee0ad7e6","116":null,"117":"这是结构示例。真实系统需要引用实际存在的事件 ID、工具结果和状态快照，不能让模型随意编造证据编号。","118":"这里最重要的字段是 ","119":"root_cause_status","120":"。如果原因还没有确认，修复控制器就不应该把某个假设当成事实，更不能据此自动修改共享工具或通用提示词。","121":"3.3 不确定时，优先做最便宜的鉴别实验","122":"例如，诊断器怀疑是界面识别错误，也怀疑应用启动失败。","123":"最便宜的检查可能是重新读取当前前台应用信息。如果读取结果已经表明目标应用根本没有启动，就没必要先调用昂贵的视觉模型分析整张屏幕。","124":"建议诊断器选择能够最大程度区分候选原因、同时风险和成本最低的检查。","125":"但不能为了节省成本而跳过必要的安全核验。对于可能产生不可逆副作用的操作，应先确保当前状态明确，再决定是否继续。","126":"四、第三步：建立分级自我修复策略","127":"我不建议让智能体遇到错误后直接自由发挥，尝试任何它想到的修复方法。","128":"更可靠的方式是建立一个","129":"从低风险、低成本到高风险、高成本的修复阶梯","130":"。","131":"这是一个推荐的修复阶梯，不是要求每次严格从 R0 走到 R6。","132":"如果检测到权限错误，系统不应该先不断重试；如果发现工具可能重复提交了支付请求，也不能通过再次调用来验证。控制器应根据故障类型、风险和证据，直接选择最合适的安全路径。","133":"4.1 不同故障类型对应不同的修复策略","134":"故障","135":"合理的修复方向","136":"不应该做的事","137":"参数格式错误","138":"按契约修正并重新校验","139":"不断使用相同错误参数重试","140":"短暂网络故障","141":"检查状态，再按契约重试","142":"盲目重复提交有副作用的请求","143":"上下文遗漏","144":"恢复缺失约束，重新编译请求","145":"无差别增加所有提示词长度","146":"路由错误","147":"重新评估任务与能力匹配","148":"让原专家无限尝试不擅长的任务","149":"工具实现缺陷","150":"隔离工具，进入测试与修复流程","151":"通过提示词掩盖工具缺陷","152":"工作流依赖错误","153":"调整受影响的 DAG 节点和依赖","154":"无条件从头重跑整个任务","155":"验收器误判","156":"核查证据与验收规则","157":"为提高成功率直接放宽标准","158":"权限不足","159":"请求授权或停止","160":"自动寻找绕过权限的方法","161":"这张表体现了一个核心思想：修复动作必须针对故障类型，而不是统一使用“多想一遍”或“换个提示词”。","162":"4.2 自我修复要有明确的预算","163":"你之前强调过，能力可以提升，成本也可以适度增加，但不能无限增长。","164":"因此，每次自我修复都应拥有独立的预算，包括：","165":"最大诊断模型调用次数；","166":"最大修复尝试次数；","167":"最大额外 Token；","168":"最大额外费用；","169":"最大恢复时长；","170":"最大允许副作用风险。","171":"当预算耗尽时，系统应暂停并给出当前已知事实、未解决的问题和建议下一步，而不是继续调用模型直到偶然成功。","172":"更重要的是，","173":"预算耗尽不代表任务已经失败，也不代表任务已经成功","174":"。如果外部状态尚不明确，应保持 ","175":"INCONCLUSIVE","176":" 或等待状态。","177":"五、第四步：修复成功后，怎样证明问题真的解决了？","178":"修复动作执行成功，并不等于原始问题已经解决。","179":"例如：","180":"重新点击按钮成功，不代表目标业务操作已经完成；","181":"修复代码并成功保存，不代表代码通过测试；","182":"重启应用成功，不代表原来的异常不再出现；","183":"修改提示词后一次回答正确，不代表策略整体改善。","184":"因此，修复控制器必须在修复前明确成功条件，并在修复后使用独立证据重新验收。","185":"5.1 建立修复前后的对照","186":"每次修复都应记录：","187":"原始异常；","188":"修复前的实际状态；","189":"修复动作及其依据；","190":"修复后的实际状态；","191":"原始验收条件是否满足；","192":"是否引入新的异常；","193":"实际成本；","194":"是否需要继续观察。","195":"例如，代码修改失败后，系统不仅要检查新代码是否成功写入，还需要重新运行相关测试、检查代码差异，并确认没有意外修改其他文件。","196":"对于间歇性故障，一次成功可能不足以证明问题已解决。应根据故障性质进行重复测试或在后续任务中持续观察。","197":"5.2 不能用降低验收标准来制造修复成功","198":"这是自修复系统必须具备的硬性规则。","199":"假设任务要求所有测试通过，而系统修复三次后仍有测试失败。它不能为了结束任务而自动把验收条件改成“主要功能可用”。","200":"如果用户明确允许降级方案，系统可以提出一个新的任务目标，并在需要时征求用户确认；否则，应保留原始验收标准，并如实报告未完成的部分。","201":"六、自我修复与自我进化：必须是两个独立闭环","202":"这是本专项最重要的架构决策之一。","203":"假设 EvoAgent 今天遇到一个网页按钮定位失败的问题。","204":"它可能有两种处理方式：","205":"当前任务的修复闭环：","206":"重新观察页面，发现按钮位置发生变化，改用无障碍节点定位，完成当前任务并通过验收。","207":"长期系统的进化闭环：","208":"将此次故障作为候选经验，收集其他页面的类似案例，验证无障碍节点定位在相应场景中是否更可靠，再决定是否修改手机操作专家的默认策略。","209":"第一件事是让当前任务恢复正常；第二件事是让未来任务减少类似问题。","210":"两者可以共享证据，但不能互相替代。","211":"运行时自我修复","212":"异常 → 诊断 → 修复 → 验收 → 恢复当前任务","213":"经验沉淀接口","214":"保存经过脱敏的故障记录、根因证据和修复结果","215":"后台进化闭环","216":"跨任务分析 → 生成候选 → 评测 → 发布或拒绝","217":"这里的箭头代表受控的数据流，而不是运行时修复可以直接修改后台稳定版本。","218":"6.1 为什么不能让运行时直接修改自己？","219":"因为当前任务中的局部信息往往不足以支持全局修改。","220":"例如，某个应用的按钮位置变了，运行时切换定位方法可能是正确的；但如果直接将“所有手机操作都优先使用视觉识别”写进全局策略，反而可能降低稳定性、增加延迟和模型成本。","221":"所以，我建议：","222":"运行时可以执行已经批准的恢复策略；","223":"运行时可以生成经验与改进候选；","224":"后台进化系统负责验证跨任务效果；","225":"只有通过发布门禁的候选才能成为新的稳定策略。","226":"对于低风险且可逆的运行参数调整，可以允许在当前任务范围内自动生效，但必须有明确的适用范围、预算和恢复方式。","227":"6.2 修复经验什么时候应该升级？","228":"建议采用以下规则：","229":"一次偶发错误：记录事件，通常不需要修改系统；","230":"重复出现的相似故障：分析是否存在稳定的故障模式；","231":"根因明确且可复现：生成针对性改进候选；","232":"改进通过专项测试：允许在对应范围内试运行；","233":"改进通过跨场景回归：考虑晋升为稳定策略；","234":"发布后出现退化：停止扩大范围，并回滚或重新诊断。","235":"这让自我修复与自我进化形成闭环，但又不会因为一次偶然成功而不断修改整个系统。","236":"七、诊断器自身出错怎么办？","237":"这是一个必须继续往下追问的问题。","238":"如果执行智能体可能出错，工具可能出错，那么诊断器也一定可能出错。","239":"例如，诊断器认为某次失败是上下文遗漏，于是增加了提示词；但真实原因是工具返回了错误状态。后续任务成本变高，问题却没有解决。","240":"如果系统没有评估诊断器自身的机制，它就可能持续沿着错误方向优化。","241":"我建议建立三项保护机制。","242":"7.1 证据与结论分离","243":"诊断器必须明确区分：","244":"已观测事实；","245":"推测原因；","246":"支持证据；","247":"反对证据；","248":"未验证的条件；","249":"最终诊断状态。","250":"它不能通过一段流畅的解释，就把一个假设升级为已确认根因。","251":"7.2 关键诊断使用独立验证","252":"对于低风险问题，可以直接执行廉价检查；对于涉及工具实现、共享提示词、安全策略或大量任务的改动，必须进行独立验证。","253":"例如，怀疑 AST 工具有缺陷时，应当用能够复现问题的最小代码样例进行测试，而不是只让另一个大模型评价原工具是否可靠。","254":"7.3 建立诊断回归集","255":"每次诊断策略升级，都应该在已知故障案例上测试：","256":"是否能识别真正的故障类别；","257":"是否会把工具问题误判成提示词问题；","258":"是否会把环境问题误判成模型问题；","259":"是否能够识别多个共同根因；","260":"是否会在证据不足时承认不确定；","261":"是否会提出超出权限的修复动作。","262":"建议重点监控误归因率和错误修复成本，而不仅是诊断器自报的置信度。","263":"八、Android 端的自我修复需要特别设计","264":"结合 EvoAgent 的手机优先方向，自我修复不能只考虑云端模型任务，还必须处理 Android 环境中的实际异常。","265":"例如：","266":"目标应用被系统关闭；","267":"无障碍服务被用户关闭；","268":"应用页面发生变化；","269":"权限弹窗阻止操作；","270":"网络断开；","271":"系统回收后台进程；","272":"当前任务状态与实际界面不一致；","273":"服务端已经收到任务，但手机没有收到确认。","274":"这些问题不一定需要重新调用大模型。","275":"我建议将手机自修复分成三层。","276":"第一层：本地确定性恢复","277":"重新读取界面状态、检查权限、查询应用前台状态、恢复本地任务检查点、检测重复动作。","278":"目标：以最低成本解决可以确定性处理的问题。","279":"第二层：智能策略恢复","280":"重新识别界面、调整操作路径、选择替代工具、局部重规划或请求云端模型辅助诊断。","281":"目标：处理需要语义理解或动态决策的异常。","282":"第三层：受控人工介入","283":"权限不足、状态无法确认、可能造成不可逆副作用、恢复预算耗尽或安全风险无法排除时暂停。","284":"目标：避免为了自动完成而越过安全边界。","285":"8.1 断网时应该怎么办？","286":"如果 Android 与个人电脑或 Mini PC 失去连接，本地执行轨道仍然可以：","287":"保存任务状态和必要日志；","288":"运行已批准的本地恢复策略；","289":"对能够离线验证的任务继续处理；","290":"将需要云端能力的节点标记为等待或阻塞；","291":"保存待同步的事件；","292":"恢复连接后继续上传诊断证据。","293":"但断网时不能假装远端操作已经成功。","294":"如果手机无法确认云端任务是否执行，正确状态是“结果待核实”，而不是简单地再次提交同一个请求。","295":"8.2 哪些修复动作可以完全自动化？","296":"建议按风险划分：","297":"风险等级","298":"示例","299":"默认策略","300":"低风险、可逆","301":"重新读取界面、修正无害参数、恢复本地检查点","302":"可以自动执行","303":"中风险、可控","304":"替换工具实现、重新生成非最终产物","305":"需要额外校验和预算限制","306":"高风险、有副作用","307":"删除文件、发送消息、支付、提交正式发布","308":"根据权限与授权要求执行，必要时必须确认","309":"状态不确定","310":"无法确认远端操作是否完成","311":"先核查，不盲目重试","312":"风险不应该只由工具名称决定，而应结合当前参数、目标对象、实际副作用和可恢复程度来评估。","313":"例如，读取文件通常是低风险操作，但读取包含敏感信息的文件仍然需要权限检查；生成视频通常可以重试，但如果每次调用都会产生费用，就需要预算和任务状态核查。","314":"九、自我修复系统的核心状态机","315":"为了防止恢复逻辑散落在各个专家中，我建议建立统一的修复状态机。","316":"NORMAL","317":"正常执行","318":"DETECTED","319":"检测到异常，记录事件并暂停受影响的动作","320":"DIAGNOSING","321":"收集证据，分析根因与风险","322":"REPAIR","323":"_","324":"APPROVED","325":"修复策略通过权限、风险和预算检查","326":"REPAIRING","327":"执行修复并记录实际状态变化","328":"VERIFYING","329":"使用原始验收标准核查修复结果","330":"RECOVERED","331":"恢复原任务或继续剩余节点","332":"ESCALATED","333":"停止、等待或请求进一步介入","334":"还需要支持 ","335":"ROLLING_BACK","336":" 和 ","337":"QUARANTINED","338":" 等状态：","339":"ROLLING_BACK","340":"：撤销已知可逆的部分变更，恢复到安全检查点。","341":"QUARANTINED","342":"：将疑似有缺陷的工具或策略暂时移出正常调度。","343":"这些状态的转移应由确定性控制器管理。模型可以提出恢复建议，但不能绕过状态机直接把任务标记为已恢复。","344":"尤其需要注意，回滚不是万能的。发送消息、外部支付、已经被第三方获取的文件等操作，可能无法真正撤销。因此，系统必须区分“回滚本地状态”和“补偿外部副作用”。","345":"十、如何评估自我修复是否真的变强？","346":"我建议建立独立的自我修复评测集，而不是只看任务成功率。","347":"指标","348":"说明","349":"异常检测召回率","350":"真实异常中，有多少被检测到","351":"误报率","352":"正常执行中，有多少被错误判定为异常","353":"根因归因准确率","354":"是否正确定位故障来源","355":"修复成功率","356":"修复后是否真正满足原始验收标准","357":"误修复率","358":"是否修改了本来正常的组件或策略","359":"平均恢复时间","360":"从发现异常到恢复或安全停止的时间","361":"恢复成本","362":"额外模型调用、Token、工具费用和时间","363":"重复副作用率","364":"修复或重试是否造成重复外部操作","365":"安全停止准确率","366":"应当停止时是否及时停止","367":"复发率","368":"同类问题在修复后是否再次出现","369":"这里有一个容易忽略的指标：","370":"修复成功率必须结合修复成本来看。","371":"如果一种修复方法能够让成功率提升 2%，却让每次任务平均多调用十次大模型，那么它未必值得默认启用。","372":"同样，如果某种快速恢复策略能解决 90% 的普通故障，但在少数高风险操作中可能造成重复提交，就需要把它限定在安全的适用范围，而不是简单以平均成功率决定是否发布。","373":"建议每次自修复策略升级都同时评估质量、成本、恢复时间和安全指标。","374":"十一、这一专项建议冻结的架构决策","375":"这些是建议纳入全量架构的设计基线，后续还需要通过故障测试、真实任务回放和安全评审验证。","376":"十二、下一专项：不确定性判断与主动决策系统","377":"自我修复完成后，我建议继续研究另一个更深层的智能问题：","378":"EvoAgent 怎样判断自己到底知道多少、什么时候应该相信当前判断、什么时候应该继续探索、什么时候应该问你，以及什么时候应该停止？","379":"这与普通的模型置信度不同。","380":"一个模型可能对错误答案非常自信；一个任务也可能没有明显错误，却缺少足够证据证明成功。","381":"下一专项建议设计 ","382":"Uncertainty & Active Decision Engine","383":"，重点包括：","384":"区分模型信心、证据充分性、环境不确定性和执行风险；","385":"判断何时可以直接执行，何时需要检索、验证或澄清；","386":"决定是否值得增加一次模型调用或使用更强的模型；","387":"判断何时继续探索的预期收益已经低于成本；","388":"防止系统因为过度谨慎而频繁打断用户；","389":"防止系统因为过度自信而错误执行；","390":"将不确定性纳入路由、规划、ReAct、验收和自我修复；","391":"通过实际结果校准判断，而不是依赖模型自报置信度。","392":"这一步很重要，因为真正成熟的个人智能体，不是永远自信地执行，也不是遇到一点不确定就问用户，而是","393":"知道何时可以放心行动、何时必须验证、何时值得继续投入，以及何时应该停止","394":"。"},"fallbackMarkdown":"# EvoAgent 第九专项：自我诊断、自我修复与故障恢复系统\n\n这一轮我们继续深入智能体本身的智能机制，暂时不展开服务器部署和分布式基础设施。\n\n前面已经设计了经验学习系统和能力自我模型。现在要解决更直接的问题：\n\n**当 EvoAgent 正在执行任务时发现自己出了问题，它如何判断问题在哪里、选择正确的修复方法、验证修复效果，并决定是否将这次修复沉淀为长期改进？**\n\n这与普通的重试机制有本质区别。\n\n普通重试是：失败了，再试一次。\n\n自我修复是：发现异常，分析原因，选择修复策略，验证是否有效，并决定是否需要改变后续执行方式。\n\n例如，EvoAgent 让手机自动打开某个应用，结果没有进入目标页面。\n\n一个简单智能体可能不断重复点击。\n\n一个具备自我修复能力的智能体应该依次判断：\n\n- 应用是否真的启动了？\n- 当前页面是否与预期不同？\n- 是点击坐标错误，还是界面布局变化？\n- 是无障碍节点识别失败，还是权限不足？\n- 是网络请求没有完成，还是页面仍在加载？\n- 是否需要重新观察界面、改用另一种定位方式，或者暂停任务？\n\n**核心原则：先诊断，再修复；先验证，再恢复；只有找到可复用的证据，才考虑长期进化。**\n\n# 一、自我修复系统必须与执行系统分离\n\n我建议为 EvoAgent 建立独立的 `Self-Repair Engine`，而不是把所有恢复逻辑塞进 ReAct 循环。\n\n原因很简单：执行智能体的目标是完成当前任务，而诊断器的目标是判断当前执行为什么没有达到预期。这两个目标有关联，但不能完全合并。\n\n如果执行模型既负责做事，又负责判断自己的行为是否正确，它可能会为已经失败的方案不断寻找理由。\n\n因此，系统应该有三个相互协作但职责不同的部分：\n\n**执行智能体**\n\n理解目标、制定计划、调用工具、完成当前任务。\n\n**异常检测与诊断器**\n\n识别异常、重建事实、提出根因假设、评估证据。\n\n**自我修复控制器**\n\n选择修复动作，检查风险与预算，批准或拒绝恢复方案。\n\n**恢复执行与独立验收**\n\n执行修复，检查实际状态，确认成功、部分恢复或仍然失败。\n\n这里的诊断器可以调用模型辅助分析，但关键事实应来自实际执行轨迹、工具结果和可验证状态。\n\n修复控制器则负责决定哪些动作可以自动执行，哪些必须等待用户授权，哪些必须停止。\n\n# 二、第一步：系统如何发现自己正在出问题？\n\n如果只在最终任务失败后才启动诊断，很多问题已经造成了额外成本，甚至产生不可逆副作用。\n\n所以，自我修复系统需要同时识别两种情况：\n\n- **结果异常：** 已经明确失败，例如工具返回错误、测试未通过。\n- **过程异常：** 任务暂时还没失败，但执行轨迹显示出明显风险，例如连续重复操作、成本异常增长、状态没有进展。\n\n我建议建立五类异常检测机制。\n\n| 异常类型 | 识别依据 | 示例 |\n|--------|--------|--------|\n| 结果异常 | 预期结果与实际结果不一致 | 文件修改后测试失败 |\n| 状态异常 | 实际环境状态与任务状态冲突 | 任务记录显示应用已打开，但系统实际没有打开 |\n| 行为异常 | 出现重复、循环或无效动作 | 连续三次点击同一个无响应按钮 |\n| 资源异常 | 预算、延迟、内存或调用次数超出限制 | 模型调用成本持续增加 |\n| 可信度异常 | 关键结论缺乏证据，或证据相互矛盾 | 模型声称操作成功，但没有状态验证 |\n\n这些异常不应该全部依赖大模型判断。\n\n例如，超时、预算超限、重复调用、状态字段缺失等情况，可以由确定性规则检测。复杂的语义异常、意图偏差和疑似推理错误，才需要模型辅助诊断。\n\n## 2.1 一个关键设计：预期状态与实际状态必须分开保存\n\n假设手机操作智能体执行“打开某个应用”。\n\n它可能记录了：\n\n- 计划状态：应用已启动；\n- 工具状态：启动请求已提交；\n- 实际观察：当前前台仍然是桌面；\n- 验收状态：目标未达成。\n\n如果只维护一个 `success=true/false` 字段，这些信息就会被混在一起。\n\n建议将任务状态拆分为：\n\n- `desired_state`：希望达到的状态；\n- `predicted_state`：模型认为当前应该是什么状态；\n- `observed_state`：实际观察到的状态；\n- `verified_state`：经过验收确认的状态；\n- `execution_status`：当前执行生命周期状态。\n\n这样，系统可以检测到模型判断、工具返回和实际环境之间的差异，而不是盲目相信其中某一个。\n\n## 2.2 检测到异常后，不要立即启动昂贵诊断\n\n我建议采用分级触发：\n\n- 轻微异常：执行一次低成本状态检查；\n- 可恢复错误：调用工具契约规定的恢复机制；\n- 重复异常：启动根因诊断；\n- 高风险异常：立即暂停相关动作并检查安全状态；\n- 重大异常：隔离相关能力或版本，阻止继续调用。\n\n例如，普通的文件读取失败可能只需要检查路径和权限；如果一个工具连续返回与实际状态不符的成功结果，就应该提高警惕，暂停依赖该工具的后续关键操作。\n\n---\n\n# 三、第二步：诊断器如何找到真正的根因？\n\n这是整个自修复系统最难、也最有价值的部分。\n\n我建议把根因分析拆成四个层次，而不是让模型直接回答“为什么失败”。\n\n**D1：现象确认**\n\n发生了什么？是否确实偏离预期？有没有足够证据确认异常？\n\n**D2：故障定位**\n\n问题最早出现在哪个环节：理解、规划、上下文、工具、环境、状态管理还是验收？\n\n**D3：根因假设**\n\n列出可能原因、支持证据、反证、未验证条件及其相对可信程度。\n\n**D4：根因验证**\n\n通过安全的状态检查、回放、对照实验或局部测试，判断哪种解释最符合事实。\n\n## 3.1 必须区分故障位置与根本原因\n\n例如，任务在验收阶段失败，并不意味着验收器就是根因。\n\n可能是：\n\n- 上游工具真的没有完成操作；\n- 工具完成了，但没有返回必要证据；\n- 任务状态没有及时更新；\n- 验收器读取了过期数据；\n- 验收规则本身写错了。\n\n“失败在哪个环节被发现”和“哪个组件导致了失败”是两个不同问题。\n\n系统应先定位首次出现的异常，再分析原因。这样才能避免只修补最后暴露问题的模块。\n\n## 3.2 诊断器应输出结构化报告\n\n例如：\n\n```json\n\n{\n  \"incident_id\": \"incident-0214\",\n  \"observed_failure\": \"目标应用未进入前台\",\n  \"first_divergence\": \"post_launch_verification\",\n  \"hypotheses\": [\n    {\n      \"cause\": \"launch_request_rejected\",\n      \"supporting_evidence\": [\n        \"launch_result_code\"\n      ],\n      \"status\": \"SUPPORTED\"\n    },\n    {\n      \"cause\": \"foreground_detection_stale\",\n      \"supporting_evidence\": [],\n      \"status\": \"UNTESTED\"\n    }\n  ],\n  \"root_cause_status\": \"UNCONFIRMED\",\n  \"recommended_check\": \"refresh_foreground_state\",\n  \"risk_class\": \"LOW\",\n  \"repair_budget\": {\n    \"max_actions\": 2,\n    \"max_model_calls\": 1\n  }\n}\n```\n\n这是结构示例。真实系统需要引用实际存在的事件 ID、工具结果和状态快照，不能让模型随意编造证据编号。\n\n这里最重要的字段是 `root_cause_status`。如果原因还没有确认，修复控制器就不应该把某个假设当成事实，更不能据此自动修改共享工具或通用提示词。\n\n## 3.3 不确定时，优先做最便宜的鉴别实验\n\n例如，诊断器怀疑是界面识别错误，也怀疑应用启动失败。\n\n最便宜的检查可能是重新读取当前前台应用信息。如果读取结果已经表明目标应用根本没有启动，就没必要先调用昂贵的视觉模型分析整张屏幕。\n\n建议诊断器选择能够最大程度区分候选原因、同时风险和成本最低的检查。\n\n但不能为了节省成本而跳过必要的安全核验。对于可能产生不可逆副作用的操作，应先确保当前状态明确，再决定是否继续。\n\n---\n\n# 四、第三步：建立分级自我修复策略\n\n我不建议让智能体遇到错误后直接自由发挥，尝试任何它想到的修复方法。\n\n更可靠的方式是建立一个**从低风险、低成本到高风险、高成本的修复阶梯**。\n\n这是一个推荐的修复阶梯，不是要求每次严格从 R0 走到 R6。\n\n如果检测到权限错误，系统不应该先不断重试；如果发现工具可能重复提交了支付请求，也不能通过再次调用来验证。控制器应根据故障类型、风险和证据，直接选择最合适的安全路径。\n\n## 4.1 不同故障类型对应不同的修复策略\n\n| 故障 | 合理的修复方向 | 不应该做的事 |\n|--------|--------|--------|\n| 参数格式错误 | 按契约修正并重新校验 | 不断使用相同错误参数重试 |\n| 短暂网络故障 | 检查状态，再按契约重试 | 盲目重复提交有副作用的请求 |\n| 上下文遗漏 | 恢复缺失约束，重新编译请求 | 无差别增加所有提示词长度 |\n| 路由错误 | 重新评估任务与能力匹配 | 让原专家无限尝试不擅长的任务 |\n| 工具实现缺陷 | 隔离工具，进入测试与修复流程 | 通过提示词掩盖工具缺陷 |\n| 工作流依赖错误 | 调整受影响的 DAG 节点和依赖 | 无条件从头重跑整个任务 |\n| 验收器误判 | 核查证据与验收规则 | 为提高成功率直接放宽标准 |\n| 权限不足 | 请求授权或停止 | 自动寻找绕过权限的方法 |\n\n这张表体现了一个核心思想：修复动作必须针对故障类型，而不是统一使用“多想一遍”或“换个提示词”。\n\n## 4.2 自我修复要有明确的预算\n\n你之前强调过，能力可以提升，成本也可以适度增加，但不能无限增长。\n\n因此，每次自我修复都应拥有独立的预算，包括：\n\n- 最大诊断模型调用次数；\n- 最大修复尝试次数；\n- 最大额外 Token；\n- 最大额外费用；\n- 最大恢复时长；\n- 最大允许副作用风险。\n\n当预算耗尽时，系统应暂停并给出当前已知事实、未解决的问题和建议下一步，而不是继续调用模型直到偶然成功。\n\n更重要的是，**预算耗尽不代表任务已经失败，也不代表任务已经成功**。如果外部状态尚不明确，应保持 `INCONCLUSIVE` 或等待状态。\n\n---\n\n# 五、第四步：修复成功后，怎样证明问题真的解决了？\n\n修复动作执行成功，并不等于原始问题已经解决。\n\n例如：\n\n- 重新点击按钮成功，不代表目标业务操作已经完成；\n- 修复代码并成功保存，不代表代码通过测试；\n- 重启应用成功，不代表原来的异常不再出现；\n- 修改提示词后一次回答正确，不代表策略整体改善。\n\n因此，修复控制器必须在修复前明确成功条件，并在修复后使用独立证据重新验收。\n\n## 5.1 建立修复前后的对照\n\n每次修复都应记录：\n\n- 原始异常；\n- 修复前的实际状态；\n- 修复动作及其依据；\n- 修复后的实际状态；\n- 原始验收条件是否满足；\n- 是否引入新的异常；\n- 实际成本；\n- 是否需要继续观察。\n\n例如，代码修改失败后，系统不仅要检查新代码是否成功写入，还需要重新运行相关测试、检查代码差异，并确认没有意外修改其他文件。\n\n对于间歇性故障，一次成功可能不足以证明问题已解决。应根据故障性质进行重复测试或在后续任务中持续观察。\n\n## 5.2 不能用降低验收标准来制造修复成功\n\n这是自修复系统必须具备的硬性规则。\n\n假设任务要求所有测试通过，而系统修复三次后仍有测试失败。它不能为了结束任务而自动把验收条件改成“主要功能可用”。\n\n如果用户明确允许降级方案，系统可以提出一个新的任务目标，并在需要时征求用户确认；否则，应保留原始验收标准，并如实报告未完成的部分。\n\n---\n\n# 六、自我修复与自我进化：必须是两个独立闭环\n\n这是本专项最重要的架构决策之一。\n\n假设 EvoAgent 今天遇到一个网页按钮定位失败的问题。\n\n它可能有两种处理方式：\n\n**当前任务的修复闭环：**\n\n重新观察页面，发现按钮位置发生变化，改用无障碍节点定位，完成当前任务并通过验收。\n\n**长期系统的进化闭环：**\n\n将此次故障作为候选经验，收集其他页面的类似案例，验证无障碍节点定位在相应场景中是否更可靠，再决定是否修改手机操作专家的默认策略。\n\n第一件事是让当前任务恢复正常；第二件事是让未来任务减少类似问题。\n\n两者可以共享证据，但不能互相替代。\n\n**运行时自我修复**\n\n异常 → 诊断 → 修复 → 验收 → 恢复当前任务\n\n**经验沉淀接口**\n\n保存经过脱敏的故障记录、根因证据和修复结果\n\n**后台进化闭环**\n\n跨任务分析 → 生成候选 → 评测 → 发布或拒绝\n\n这里的箭头代表受控的数据流，而不是运行时修复可以直接修改后台稳定版本。\n\n## 6.1 为什么不能让运行时直接修改自己？\n\n因为当前任务中的局部信息往往不足以支持全局修改。\n\n例如，某个应用的按钮位置变了，运行时切换定位方法可能是正确的；但如果直接将“所有手机操作都优先使用视觉识别”写进全局策略，反而可能降低稳定性、增加延迟和模型成本。\n\n所以，我建议：\n\n- 运行时可以执行已经批准的恢复策略；\n- 运行时可以生成经验与改进候选；\n- 后台进化系统负责验证跨任务效果；\n- 只有通过发布门禁的候选才能成为新的稳定策略。\n\n对于低风险且可逆的运行参数调整，可以允许在当前任务范围内自动生效，但必须有明确的适用范围、预算和恢复方式。\n\n## 6.2 修复经验什么时候应该升级？\n\n建议采用以下规则：\n\n- 一次偶发错误：记录事件，通常不需要修改系统；\n- 重复出现的相似故障：分析是否存在稳定的故障模式；\n- 根因明确且可复现：生成针对性改进候选；\n- 改进通过专项测试：允许在对应范围内试运行；\n- 改进通过跨场景回归：考虑晋升为稳定策略；\n- 发布后出现退化：停止扩大范围，并回滚或重新诊断。\n\n这让自我修复与自我进化形成闭环，但又不会因为一次偶然成功而不断修改整个系统。\n\n---\n\n# 七、诊断器自身出错怎么办？\n\n这是一个必须继续往下追问的问题。\n\n如果执行智能体可能出错，工具可能出错，那么诊断器也一定可能出错。\n\n例如，诊断器认为某次失败是上下文遗漏，于是增加了提示词；但真实原因是工具返回了错误状态。后续任务成本变高，问题却没有解决。\n\n如果系统没有评估诊断器自身的机制，它就可能持续沿着错误方向优化。\n\n我建议建立三项保护机制。\n\n## 7.1 证据与结论分离\n\n诊断器必须明确区分：\n\n- 已观测事实；\n- 推测原因；\n- 支持证据；\n- 反对证据；\n- 未验证的条件；\n- 最终诊断状态。\n\n它不能通过一段流畅的解释，就把一个假设升级为已确认根因。\n\n## 7.2 关键诊断使用独立验证\n\n对于低风险问题，可以直接执行廉价检查；对于涉及工具实现、共享提示词、安全策略或大量任务的改动，必须进行独立验证。\n\n例如，怀疑 AST 工具有缺陷时，应当用能够复现问题的最小代码样例进行测试，而不是只让另一个大模型评价原工具是否可靠。\n\n## 7.3 建立诊断回归集\n\n每次诊断策略升级，都应该在已知故障案例上测试：\n\n- 是否能识别真正的故障类别；\n- 是否会把工具问题误判成提示词问题；\n- 是否会把环境问题误判成模型问题；\n- 是否能够识别多个共同根因；\n- 是否会在证据不足时承认不确定；\n- 是否会提出超出权限的修复动作。\n\n建议重点监控误归因率和错误修复成本，而不仅是诊断器自报的置信度。\n\n---\n\n# 八、Android 端的自我修复需要特别设计\n\n结合 EvoAgent 的手机优先方向，自我修复不能只考虑云端模型任务，还必须处理 Android 环境中的实际异常。\n\n例如：\n\n- 目标应用被系统关闭；\n- 无障碍服务被用户关闭；\n- 应用页面发生变化；\n- 权限弹窗阻止操作；\n- 网络断开；\n- 系统回收后台进程；\n- 当前任务状态与实际界面不一致；\n- 服务端已经收到任务，但手机没有收到确认。\n\n这些问题不一定需要重新调用大模型。\n\n我建议将手机自修复分成三层。\n\n**第一层：本地确定性恢复**\n\n重新读取界面状态、检查权限、查询应用前台状态、恢复本地任务检查点、检测重复动作。\n\n目标：以最低成本解决可以确定性处理的问题。\n\n**第二层：智能策略恢复**\n\n重新识别界面、调整操作路径、选择替代工具、局部重规划或请求云端模型辅助诊断。\n\n目标：处理需要语义理解或动态决策的异常。\n\n**第三层：受控人工介入**\n\n权限不足、状态无法确认、可能造成不可逆副作用、恢复预算耗尽或安全风险无法排除时暂停。\n\n目标：避免为了自动完成而越过安全边界。\n\n## 8.1 断网时应该怎么办？\n\n如果 Android 与个人电脑或 Mini PC 失去连接，本地执行轨道仍然可以：\n\n- 保存任务状态和必要日志；\n- 运行已批准的本地恢复策略；\n- 对能够离线验证的任务继续处理；\n- 将需要云端能力的节点标记为等待或阻塞；\n- 保存待同步的事件；\n- 恢复连接后继续上传诊断证据。\n\n但断网时不能假装远端操作已经成功。\n\n如果手机无法确认云端任务是否执行，正确状态是“结果待核实”，而不是简单地再次提交同一个请求。\n\n## 8.2 哪些修复动作可以完全自动化？\n\n建议按风险划分：\n\n| 风险等级 | 示例 | 默认策略 |\n|--------|--------|--------|\n| 低风险、可逆 | 重新读取界面、修正无害参数、恢复本地检查点 | 可以自动执行 |\n| 中风险、可控 | 替换工具实现、重新生成非最终产物 | 需要额外校验和预算限制 |\n| 高风险、有副作用 | 删除文件、发送消息、支付、提交正式发布 | 根据权限与授权要求执行，必要时必须确认 |\n| 状态不确定 | 无法确认远端操作是否完成 | 先核查，不盲目重试 |\n\n风险不应该只由工具名称决定，而应结合当前参数、目标对象、实际副作用和可恢复程度来评估。\n\n例如，读取文件通常是低风险操作，但读取包含敏感信息的文件仍然需要权限检查；生成视频通常可以重试，但如果每次调用都会产生费用，就需要预算和任务状态核查。\n\n---\n\n# 九、自我修复系统的核心状态机\n\n为了防止恢复逻辑散落在各个专家中，我建议建立统一的修复状态机。\n\n**NORMAL**\n\n正常执行\n\n**DETECTED**\n\n检测到异常，记录事件并暂停受影响的动作\n\n**DIAGNOSING**\n\n收集证据，分析根因与风险\n\n**REPAIR\\_APPROVED**\n\n修复策略通过权限、风险和预算检查\n\n**REPAIRING**\n\n执行修复并记录实际状态变化\n\n**VERIFYING**\n\n使用原始验收标准核查修复结果\n\n**RECOVERED**\n\n恢复原任务或继续剩余节点\n\n**ESCALATED**\n\n停止、等待或请求进一步介入\n\n还需要支持 `ROLLING_BACK` 和 `QUARANTINED` 等状态：\n\n- `ROLLING_BACK`：撤销已知可逆的部分变更，恢复到安全检查点。\n- `QUARANTINED`：将疑似有缺陷的工具或策略暂时移出正常调度。\n\n这些状态的转移应由确定性控制器管理。模型可以提出恢复建议，但不能绕过状态机直接把任务标记为已恢复。\n\n尤其需要注意，回滚不是万能的。发送消息、外部支付、已经被第三方获取的文件等操作，可能无法真正撤销。因此，系统必须区分“回滚本地状态”和“补偿外部副作用”。\n\n---\n\n# 十、如何评估自我修复是否真的变强？\n\n我建议建立独立的自我修复评测集，而不是只看任务成功率。\n\n| 指标 | 说明 |\n|--------|--------|\n| 异常检测召回率 | 真实异常中，有多少被检测到 |\n| 误报率 | 正常执行中，有多少被错误判定为异常 |\n| 根因归因准确率 | 是否正确定位故障来源 |\n| 修复成功率 | 修复后是否真正满足原始验收标准 |\n| 误修复率 | 是否修改了本来正常的组件或策略 |\n| 平均恢复时间 | 从发现异常到恢复或安全停止的时间 |\n| 恢复成本 | 额外模型调用、Token、工具费用和时间 |\n| 重复副作用率 | 修复或重试是否造成重复外部操作 |\n| 安全停止准确率 | 应当停止时是否及时停止 |\n| 复发率 | 同类问题在修复后是否再次出现 |\n\n这里有一个容易忽略的指标：**修复成功率必须结合修复成本来看。**\n\n如果一种修复方法能够让成功率提升 2%，却让每次任务平均多调用十次大模型，那么它未必值得默认启用。\n\n同样，如果某种快速恢复策略能解决 90% 的普通故障，但在少数高风险操作中可能造成重复提交，就需要把它限定在安全的适用范围，而不是简单以平均成功率决定是否发布。\n\n建议每次自修复策略升级都同时评估质量、成本、恢复时间和安全指标。\n\n---\n\n# 十一、这一专项建议冻结的架构决策\n\n这些是建议纳入全量架构的设计基线，后续还需要通过故障测试、真实任务回放和安全评审验证。\n\n# 十二、下一专项：不确定性判断与主动决策系统\n\n自我修复完成后，我建议继续研究另一个更深层的智能问题：\n\n**EvoAgent 怎样判断自己到底知道多少、什么时候应该相信当前判断、什么时候应该继续探索、什么时候应该问你，以及什么时候应该停止？**\n\n这与普通的模型置信度不同。\n\n一个模型可能对错误答案非常自信；一个任务也可能没有明显错误，却缺少足够证据证明成功。\n\n下一专项建议设计 `Uncertainty & Active Decision Engine`，重点包括：\n\n1. 区分模型信心、证据充分性、环境不确定性和执行风险；\n2. 判断何时可以直接执行，何时需要检索、验证或澄清；\n3. 决定是否值得增加一次模型调用或使用更强的模型；\n4. 判断何时继续探索的预期收益已经低于成本；\n5. 防止系统因为过度谨慎而频繁打断用户；\n6. 防止系统因为过度自信而错误执行；\n7. 将不确定性纳入路由、规划、ReAct、验收和自我修复；\n8. 通过实际结果校准判断，而不是依赖模型自报置信度。\n\n这一步很重要，因为真正成熟的个人智能体，不是永远自信地执行，也不是遇到一点不确定就问用户，而是**知道何时可以放心行动、何时必须验证、何时值得继续投入，以及何时应该停止**。","fallbackMarkdownVersion":1,"clientDefinedWidgets":{"7bf82ad7-9a4c-52a0-947e-1af1ee0ad7e6":{"status":"resolved","refIndex":0,"isStreaming":false}},"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6","turn_exchange_id":"2dfdd57d-cab8-442a-82c4-ca6e4bf62978","request_id":"0e52d78b-6a2f-42d9-bd0e-686822558335","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[{"type":"client_defined_widget","category":"code_block","data":{"content":"\n{\n  \"incident_id\": \"incident-0214\",\n  \"observed_failure\": \"目标应用未进入前台\",\n  \"first_divergence\": \"post_launch_verification\",\n  \"hypotheses\": [\n    {\n      \"cause\": \"launch_request_rejected\",\n      \"supporting_evidence\": [\n        \"launch_result_code\"\n      ],\n      \"status\": \"SUPPORTED\"\n    },\n    {\n      \"cause\": \"foreground_detection_stale\",\n      \"supporting_evidence\": [],\n      \"status\": \"UNTESTED\"\n    }\n  ],\n  \"root_cause_status\": \"UNCONFIRMED\",\n  \"recommended_check\": \"refresh_foreground_state\",\n  \"risk_class\": \"LOW\",\n  \"repair_budget\": {\n    \"max_actions\": 2,\n    \"max_model_calls\": 1\n  }\n}\n","language":"json","editable":true,"widget_type":"code_block"},"matched_text":"```json\n\n{\n  \"incident_id\": \"incident-0214\",\n  \"observed_failure\": \"目标应用未进入前台\",\n  \"first_divergence\": \"post_launch_verification\",\n  \"hypotheses\": [\n    {\n      \"cause\": \"launch_request_rejected\",\n      \"supporting_evidence\": [\n        \"launch_result_code\"\n      ],\n      \"status\": \"SUPPORTED\"\n    },\n    {\n      \"cause\": \"foreground_detection_stale\",\n      \"supporting_evidence\": [],\n      \"status\": \"UNTESTED\"\n    }\n  ],\n  \"root_cause_status\": \"UNCO