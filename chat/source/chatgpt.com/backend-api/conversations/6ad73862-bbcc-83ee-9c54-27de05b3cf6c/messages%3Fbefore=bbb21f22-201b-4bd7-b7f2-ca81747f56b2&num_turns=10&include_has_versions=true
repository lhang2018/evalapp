em\",null,__dil.jsx(\"text\",null,__dilConstants[\"233\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"234\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"235\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"236\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"237\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"238\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"239\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"240\"]))),__dil.jsx(\"text\",null,__dilConstants[\"241\"],__dil.jsx(\"bold\",null,__dilConstants[\"242\"])));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第十专项：不确定性判断与主动决策系统","1":"这一轮我们继续研究智能体内部的核心智能机制。","2":"前面已经设计了路由、规划、ReAct、记忆、经验学习、自我诊断和自我修复。现在需要解决一个贯穿所有模块的问题：","3":"EvoAgent 在什么情况下应该相信当前判断，什么情况下应该进一步验证，什么情况下应该向用户提问，以及什么情况下应该停止行动？","4":"这决定了智能体究竟是一个真正可靠的个人助手，还是一个看起来很有能力、实际却可能盲目行动的系统。","5":"举几个例子：","6":"用户说“帮我打开微信”，目标明确、风险低，通常不需要反复询问。","7":"用户说“把这个整理一下”，但没有提供对象，系统可能需要澄清。","8":"用户让智能体修改代码，模型认为已经完成，但测试尚未运行，就不能直接宣布全部成功。","9":"用户让智能体发送一条消息，收件人和内容虽然明确，但发送会产生外部副作用，需要满足相应授权条件。","10":"云端请求超时，系统无法判断任务是否已执行，这不是简单的失败，而是结果不确定。","11":"一个问题连续修复三次仍然失败，系统应该考虑更换策略或停止，而不是继续消耗预算。","12":"所以，我们需要的不是一个简单的“模型置信度”，而是一套贯穿理解、决策、执行、验证和恢复的","13":"不确定性治理机制","14":"。","15":"一、首先区分五种不确定性","16":"我建议不要把所有不确定性都压缩成一个数字。它们的来源不同，解决方法也不同。","17":"U1：意图不确定性","18":"系统是否理解了用户真正想要的结果？","19":"示例：用户说“把它处理一下”，但不知道“它”指什么，也不知道期望的处理方式。","20":"U2：知识不确定性","21":"系统是否掌握足够可靠的信息来作出判断？","22":"示例：模型不确定某个 Android API 在当前系统版本中的行为。","23":"U3：状态不确定性","24":"系统是否知道真实环境当前处于什么状态？","25":"示例：启动应用的请求已经提交，但无法确认应用是否进入前台。","26":"U4：结果不确定性","27":"即使操作已经完成，系统是否有足够证据确认结果满足目标？","28":"示例：代码已保存，但还没有运行测试。","29":"U5：策略不确定性","30":"系统是否知道哪种执行方案最适合当前任务？","31":"示例：不确定使用 AST 重构还是简单文本补丁更稳妥。","32":"这五类不确定性不能用同一种方法解决。","33":"意图不确定，可能需要询问用户。","34":"知识不确定，可能需要检索资料或调用专业工具。","35":"状态不确定，应该重新观察实际环境。","36":"结果不确定，应该执行验收。","37":"策略不确定，可以比较方案、开展低风险试验，或选择更稳妥的执行方式。","38":"这是本专项的第一项核心原则：","39":"先判断不确定性来自哪里，再决定如何降低它。","40":"二、建立独立的不确定性评估引擎","41":"建议增加 ","42":"Uncertainty Assessment Engine","43":"，但它不应该成为每个任务都必须调用一次的大模型。","44":"它的主要职责是整合多个组件已有的信号，判断当前任务的哪些部分仍然不确定，以及这种不确定性是否会影响下一步决策。","45":"它可以使用四类信息：","46":"确定性信号","47":"：工具返回码、参数校验、测试结果、状态查询结果。","48":"模型判断信号","49":"：多个方案的差异、未解决的假设、对任务理解的分歧。","50":"历史经验信号","51":"：当前能力在相似任务、相同模型和相似环境中的实际表现。","52":"环境信号","53":"：网络状态、权限、资源限制、界面变化、远端任务是否可查询。","54":"注意：这不是把四类信号简单平均成一个分数。不同信号回答的问题不同，而且可靠程度也不同。","55":"例如，编译器报告语法错误，是关于语法正确性的强证据；模型说“我有 95% 把握代码正确”，则不能代替编译和测试。","56":"2.1 统一的不确定性记录","57":"每个关键决策可以产生一条 ","58":"UncertaintyAssessment","59":"：","60":"5aa0e9d9-5c7e-58a4-872d-2c077b99c519","61":null,"62":"这只是协议示例。","63":"重点在于：系统不只是记录“我不确定”，还要说明","64":"具体不确定什么、缺少什么证据、判断错了有什么后果，以及下一步哪种动作最有价值","65":"。","66":"2.2 不确定性评估不必每一步都调用模型","67":"建议采用两级机制：","68":"快速评估层","69":"：通过规则、任务状态和现有证据判断是否存在明显缺口。","70":"深度评估层","71":"：当问题复杂、证据冲突或风险较高时，调用模型进行分析，必要时使用独立评审或专项工具。","72":"例如，测试尚未运行时，快速评估层就可以判断“代码正确性尚未得到测试验证”，不需要额外调用大模型来回答这个问题。","73":"只有当系统需要判断“是否值得运行昂贵的集成测试，还是先进行更便宜的静态分析”时，才可能需要更复杂的决策。","74":"这样既能控制成本，也能避免把本来可以确定性解决的问题交给模型自由推理。","75":"三、不要把置信度当成真实概率","76":"这是整个系统必须特别注意的地方。","77":"模型给出 0.9 的置信度，并不意味着它在类似任务中有 90% 的概率正确。","78":"因此，EvoAgent 应该区分三个概念：","79":"概念","80":"含义","81":"例子","82":"主观置信度","83":"模型或判断器认为答案有多可信","84":"模型认为某个 API 用法正确","85":"经验校准概率","86":"相似条件下，历史判断实际正确的比例","87":"同类代码诊断在独立测试集上的准确率","88":"证据充分性","89":"当前是否具备足够证据支持这个结论","90":"编译和必要测试是否通过","91":"它们不能相互替代。","92":"一个模型可能对答案非常自信，但知识已经过时；一个判断器可能在相似任务中表现很好，但当前输入缺少关键条件；一个结论即使概率上很可能正确，也可能因为后果严重而必须进一步验证。","93":"3.1 如何校准能力判断？","94":"建议按任务类型、模型版本、执行环境和风险级别，使用历史可验证结果进行校准。","95":"例如，对编程任务分别统计：","96":"语法分析是否正确；","97":"修改方案是否满足目标；","98":"测试结果是否符合预期；","99":"最终验收是否成功。","100":"对手机操作任务，则可以统计：","101":"目标应用识别是否正确；","102":"页面状态识别是否正确；","103":"操作是否产生预期状态变化；","104":"是否需要人工纠正。","105":"这些指标比一个笼统的“智能体成功率”更有价值。","106":"同时，校准数据需要保留样本量和不确定范围。只有三次成功的能力，不能因为成功率是 100%，就被认为已充分证明可靠。","107":"3.2 不确定性也需要独立评测","108":"建议评估：","109":"高风险错误是否能被识别为不确定；","110":"明显正确且证据充分的任务是否被过度质疑；","111":"不确定性评分是否与实际错误率相关；","112":"新模型和新工具上线后，旧校准是否仍然有效；","113":"证据缺失时，系统是否能够拒绝作出无依据的成功声明。","114":"最后一点尤其重要：","115":"一个好的不确定性系统，不只是尽量答对，还应该尽量避免把没有证据的判断说成已经确认的事实。","116":"四、核心决策：下一步应该做什么？","117":"识别不确定性之后，系统还必须选择行动。","118":"我建议建立 ","119":"Active Decision Policy","120":"，把下一步分成六类：","121":"这些动作不是固定顺序。系统应该选择最符合当前不确定性来源、任务目标和风险边界的行动。","122":"例如：","123":"不知道当前手机页面是什么：先观察，不要问用户。","124":"不知道用户想删除哪一个文件：应当澄清目标。","125":"不知道代码是否正确：运行适当测试。","126":"不知道某项外部 API 的最新行为：查阅权威资料或进行受控验证。","127":"无法确认某个外部支付是否成功：暂停重复提交，优先查询状态。","128":"4.1 引入“信息价值”判断","129":"每一次额外行动都需要成本。系统应该判断：再做一步，能否实质性降低不确定性，并改善决策？","130":"例如，代码修改后运行单元测试通常成本较低，而且能提供直接证据；再调用三个大模型评价同一段代码，可能成本更高，却没有增加多少独立证据。","131":"因此，我建议引入 ","132":"Value of Information","133":"（信息价值）机制。","134":"其核心问题是：","135":"获取这条新信息，能否改变当前决策？如果能，改变决策所带来的预期收益是否大于获取信息的成本？","136":"概念上可以表示为：","137":"VOI(a)=\n\\mathbb{E}[\\text{获得信息后最优决策的收益}]\n-\\text{当前最优决策收益}\n-\\text{获取信息的成本}","138":"这里的收益不仅包括成功率，还应考虑时间、费用、错误后果和恢复成本。","139":"这个公式是决策框架，不意味着所有收益都能准确转换为一个数字。对于权限、安全和不可逆操作，仍然需要硬性规则，不能仅凭期望收益为正就自动执行。","140":"4.2 一个实际例子","141":"用户要求修改代码中的一个函数。","142":"系统有三种选择：","143":"直接应用补丁；","144":"先解析 AST，再应用补丁；","145":"调用更强的模型重新分析整个项目。","146":"如果修改范围小、目标明确、补丁可逆，直接应用补丁并运行相关测试可能最划算。","147":"如果涉及跨文件符号引用，AST 分析可能显著降低误改风险。","148":"如果涉及复杂架构决策、需求本身存在冲突，才可能值得调用更强模型。","149":"所以，系统不应该永远选择最便宜的方案，也不应该永远选择最强的模型，而应该选择","150":"在当前风险与预算约束下，预期综合表现最好的方案","151":"。","152":"五、什么时候应该向用户提问？","153":"个人智能体最容易出现两个极端：","154":"过度自主：不确定也继续做，最后做错；","155":"过度谨慎：一点不确定就问用户，用户反而成了系统的执行控制器。","156":"EvoAgent 应该根据“这条信息是否会改变行动”和“错误行动的代价”来决定是否澄清。","157":"5.1 建议采用四类判断","158":"情况","159":"建议行为","160":"目标明确、低风险","161":"直接执行","162":"目标大体明确，细节可以安全推断","163":"采用合理默认值，必要时告知用户","164":"多种解释会导致明显不同的结果","165":"先澄清","166":"存在权限、隐私或重大不可逆风险","167":"满足授权条件前暂停","168":"例如，用户说“帮我整理桌面”，系统可以先检查桌面文件类型，提出分类方案；如果要批量删除文件，就不能把“整理”擅自解释成“删除”。","169":"如果用户说“帮我给他发消息”，而“他”指代不明确，系统应该先确认收件人。即使历史记忆显示用户通常联系某个人，也不应在存在实质歧义时自动选择并发送。","170":"5.2 设计澄清阈值，而不是统一置信度阈值","171":"不同任务不应使用同一个提问阈值。","172":"例如：","173":"推荐一部电影：可以容忍较大的偏好不确定性；","174":"制定旅行计划：可以先给出方案，再让用户调整偏好；","175":"修改项目代码：可以在可逆范围内先分析和提出补丁；","176":"删除文件、发送消息、支付：需要严格满足目标明确性和授权条件。","177":"所以，澄清策略应该结合任务类别、错误代价、可逆性和用户负担，而不是规定“置信度低于 80% 就提问”。","178":"5.3 用户偏好也可以影响澄清方式","179":"如果用户已经明确表达了某些长期工作习惯，系统可以据此调整交互：","180":"用户偏好先看方案：复杂任务先提供计划；","181":"用户希望减少打扰：对低风险、可逆的细节采用合理默认值；","182":"用户要求谨慎操作：扩大需要确认的操作范围。","183":"但这些偏好不能覆盖当前明确指令，也不能绕过权限边界。用户希望“尽可能自动”不等于允许系统在目标不明确时自行执行不可逆动作。","184":"六、什么时候应该停止继续思考或尝试？","185":"这是控制成本和防止无效循环的关键。","186":"前面已经设计了 ReAct 的步数限制和自我修复预算，但还缺少一个更智能的判断：即使预算还没有耗尽，是否已经不值得继续？","187":"我建议区分三种停止。","188":"成功停止","189":"目标已经通过验收，继续调用模型或工具没有足够的额外收益。","190":"暂时停止","191":"缺少授权、等待网络恢复、远端任务仍在运行，或需要用户补充信息。","192":"失败停止","193":"已达到预算上限、连续尝试没有进展、存在不可接受风险，或现有能力无法可靠完成任务。","194":"这里有一个很重要的区别：停止当前行动，不一定意味着放弃整个任务。","195":"例如，云端视频生成服务暂时不可用时，智能体可以保存已完成的剧本、角色素材和分镜，暂停生成节点，等待服务恢复，而不需要重新执行整个漫剧工作流。","196":"6.1 无进展检测","197":"建议结合以下信号判断是否陷入循环：","198":"连续调用相同工具，结果没有变化；","199":"连续生成相同或高度相似的计划；","200":"反复尝试已被证明无效的策略；","201":"新一轮推理没有产生新的有效证据；","202":"任务状态没有推进；","203":"额外成本持续增加，但成功可能性没有明显改善。","204":"当检测到无进展时，系统可以先切换诊断策略，再决定是否继续。","205":"不能仅仅因为连续两次调用同一工具，就认定任务陷入循环。有些操作本来就需要重复执行，例如逐个处理多个文件。真正要判断的是：","206":"重复是否符合当前计划，是否带来了预期状态变化。","207":"6.2 预期收益递减","208":"假设某个代码错误已经经过三轮诊断：","209":"第一次发现可能是类型不匹配；","210":"第二次检查确认类型问题；","211":"第三次修复后仍然测试失败，且没有新的证据。","212":"此时继续使用相同方法的价值可能很低。系统应该切换到不同的诊断手段，或停止并报告剩余的不确定性。","213":"但如果每一轮都产生了新证据，那么即使已经尝试三次，也可能值得继续。","214":"因此，停止条件应结合预算、风险、信息价值和实际进展，而不是只依赖固定次数。","215":"七、将不确定性治理嵌入整个 EvoAgent","216":"这一专项不能只成为一个额外模块。它需要影响前面设计的所有核心组件。","217":"这里还有一个关键约束：不确定性评估本身也要受成本限制。","218":"如果每个工具调用前后都启动一次大模型评估，系统会变得很慢、很贵。低风险任务应该优先使用轻量规则；只有当信息缺口确实会影响决策时，才投入更多资源。","219":"八、系统如何形成真正的闭环？","220":"我建议让不确定性系统贯穿一次任务的完整生命周期。","221":"这里最重要的是第 5 步：每次行动后，系统都应重新评估当前状态，而不是继续沿用执行前的判断。","222":"例如，手机界面发生变化后，之前对按钮位置的判断可能已经失效；模型切换后，之前针对旧模型校准的能力概率也可能不再适用。","223":"不确定性不是任务开始时评估一次就结束的静态属性，而是随着环境、证据和执行结果持续变化的状态。","224":"九、本专项建议冻结的架构决策","225":"这些是建议纳入 EvoAgent 全量架构的决策基线，具体阈值和策略需要在后续评测中确定。","226":"十、下一专项：模型适配、能力迁移与版本进化","227":"接下来，我建议进入一个与你最初的目标直接相关、但还没有彻底解决的专项：","228":"当 EvoAgent 从当前大语言模型切换到另一个模型时，如何保留已经积累的能力，又避免把只适用于旧模型的经验、提示词和执行策略错误地迁移过去？","229":"你最初提出的目标，是把当前环境、当前模型下已经优化好的智能体保存下来，在新的分支上继续优化另一种模型。这实际上要求系统具备明确的模型适配与能力迁移机制。","230":"下一专项应该深入：","231":"哪些组件与模型无关，哪些高度依赖特定模型；","232":"如何保存模型版本、提示词、上下文策略、路由策略和评测结果的完整适配快照；","233":"如何判断某条经验是通用规律，还是旧模型特有的行为补偿；","234":"新模型上线时，如何评估工具调用、规划、记忆检索和验收能力；","235":"如何通过对照评测决定继承、重新校准、隔离或废弃旧策略；","236":"如何管理多个模型的独立优化分支；","237":"如何根据任务难度、成本和质量选择不同模型；","238":"如何避免模型切换后出现能力退化、成本失控或诊断错误；","239":"如何在保留旧模型稳定版本的同时，让新模型独立进化；","240":"如何将跨模型验证成功的改进晋升为真正通用的能力。","241":"这会把 EvoAgent 的自进化机制进一步推进到一个重要目标：","242":"不仅能适应一个模型，而且能持续适配不同模型，同时保留历史成果、控制迁移风险，并让每个模型的优化互不污染。"},"fallbackMarkdown":"# EvoAgent 第十专项：不确定性判断与主动决策系统\n\n这一轮我们继续研究智能体内部的核心智能机制。\n\n前面已经设计了路由、规划、ReAct、记忆、经验学习、自我诊断和自我修复。现在需要解决一个贯穿所有模块的问题：\n\n**EvoAgent 在什么情况下应该相信当前判断，什么情况下应该进一步验证，什么情况下应该向用户提问，以及什么情况下应该停止行动？**\n\n这决定了智能体究竟是一个真正可靠的个人助手，还是一个看起来很有能力、实际却可能盲目行动的系统。\n\n举几个例子：\n\n- 用户说“帮我打开微信”，目标明确、风险低，通常不需要反复询问。\n- 用户说“把这个整理一下”，但没有提供对象，系统可能需要澄清。\n- 用户让智能体修改代码，模型认为已经完成，但测试尚未运行，就不能直接宣布全部成功。\n- 用户让智能体发送一条消息，收件人和内容虽然明确，但发送会产生外部副作用，需要满足相应授权条件。\n- 云端请求超时，系统无法判断任务是否已执行，这不是简单的失败，而是结果不确定。\n- 一个问题连续修复三次仍然失败，系统应该考虑更换策略或停止，而不是继续消耗预算。\n\n所以，我们需要的不是一个简单的“模型置信度”，而是一套贯穿理解、决策、执行、验证和恢复的**不确定性治理机制**。\n\n## 一、首先区分五种不确定性\n\n我建议不要把所有不确定性都压缩成一个数字。它们的来源不同，解决方法也不同。\n\n## U1：意图不确定性\n\n系统是否理解了用户真正想要的结果？\n\n示例：用户说“把它处理一下”，但不知道“它”指什么，也不知道期望的处理方式。\n\n## U2：知识不确定性\n\n系统是否掌握足够可靠的信息来作出判断？\n\n示例：模型不确定某个 Android API 在当前系统版本中的行为。\n\n## U3：状态不确定性\n\n系统是否知道真实环境当前处于什么状态？\n\n示例：启动应用的请求已经提交，但无法确认应用是否进入前台。\n\n## U4：结果不确定性\n\n即使操作已经完成，系统是否有足够证据确认结果满足目标？\n\n示例：代码已保存，但还没有运行测试。\n\n## U5：策略不确定性\n\n系统是否知道哪种执行方案最适合当前任务？\n\n示例：不确定使用 AST 重构还是简单文本补丁更稳妥。\n\n这五类不确定性不能用同一种方法解决。\n\n- 意图不确定，可能需要询问用户。\n- 知识不确定，可能需要检索资料或调用专业工具。\n- 状态不确定，应该重新观察实际环境。\n- 结果不确定，应该执行验收。\n- 策略不确定，可以比较方案、开展低风险试验，或选择更稳妥的执行方式。\n\n这是本专项的第一项核心原则：**先判断不确定性来自哪里，再决定如何降低它。**\n\n# 二、建立独立的不确定性评估引擎\n\n建议增加 `Uncertainty Assessment Engine`，但它不应该成为每个任务都必须调用一次的大模型。\n\n它的主要职责是整合多个组件已有的信号，判断当前任务的哪些部分仍然不确定，以及这种不确定性是否会影响下一步决策。\n\n它可以使用四类信息：\n\n1. **确定性信号**：工具返回码、参数校验、测试结果、状态查询结果。\n2. **模型判断信号**：多个方案的差异、未解决的假设、对任务理解的分歧。\n3. **历史经验信号**：当前能力在相似任务、相同模型和相似环境中的实际表现。\n4. **环境信号**：网络状态、权限、资源限制、界面变化、远端任务是否可查询。\n\n注意：这不是把四类信号简单平均成一个分数。不同信号回答的问题不同，而且可靠程度也不同。\n\n例如，编译器报告语法错误，是关于语法正确性的强证据；模型说“我有 95% 把握代码正确”，则不能代替编译和测试。\n\n## 2.1 统一的不确定性记录\n\n每个关键决策可以产生一条 `UncertaintyAssessment`：\n\n```json\n\n{\n  \"assessment_id\": \"ua-00821\",\n  \"task_id\": \"task-123\",\n  \"decision_point\": \"verify_code_change\",\n  \"uncertainty_types\": [\n    \"outcome\"\n  ],\n  \"unknowns\": [\n    {\n      \"question\": \"修改是否破坏现有功能\",\n      \"evidence_available\": [\n        \"patch_applied\"\n      ],\n      \"missing_evidence\": [\n        \"regression_test_result\"\n      ]\n    }\n  ],\n  \"risk_if_wrong\": \"MEDIUM\",\n  \"reversibility\": \"HIGH\",\n  \"recommended_action\": \"RUN_REGRESSION_TESTS\",\n  \"budget_limit_ref\": \"budget-123\",\n  \"status\": \"OPEN\"\n}\n```\n\n这只是协议示例。\n\n重点在于：系统不只是记录“我不确定”，还要说明**具体不确定什么、缺少什么证据、判断错了有什么后果，以及下一步哪种动作最有价值**。\n\n## 2.2 不确定性评估不必每一步都调用模型\n\n建议采用两级机制：\n\n- **快速评估层**：通过规则、任务状态和现有证据判断是否存在明显缺口。\n- **深度评估层**：当问题复杂、证据冲突或风险较高时，调用模型进行分析，必要时使用独立评审或专项工具。\n\n例如，测试尚未运行时，快速评估层就可以判断“代码正确性尚未得到测试验证”，不需要额外调用大模型来回答这个问题。\n\n只有当系统需要判断“是否值得运行昂贵的集成测试，还是先进行更便宜的静态分析”时，才可能需要更复杂的决策。\n\n这样既能控制成本，也能避免把本来可以确定性解决的问题交给模型自由推理。\n\n---\n\n# 三、不要把置信度当成真实概率\n\n这是整个系统必须特别注意的地方。\n\n模型给出 0.9 的置信度，并不意味着它在类似任务中有 90% 的概率正确。\n\n因此，EvoAgent 应该区分三个概念：\n\n| 概念 | 含义 | 例子 |\n|--------|--------|--------|\n| 主观置信度 | 模型或判断器认为答案有多可信 | 模型认为某个 API 用法正确 |\n| 经验校准概率 | 相似条件下，历史判断实际正确的比例 | 同类代码诊断在独立测试集上的准确率 |\n| 证据充分性 | 当前是否具备足够证据支持这个结论 | 编译和必要测试是否通过 |\n\n它们不能相互替代。\n\n一个模型可能对答案非常自信，但知识已经过时；一个判断器可能在相似任务中表现很好，但当前输入缺少关键条件；一个结论即使概率上很可能正确，也可能因为后果严重而必须进一步验证。\n\n## 3.1 如何校准能力判断？\n\n建议按任务类型、模型版本、执行环境和风险级别，使用历史可验证结果进行校准。\n\n例如，对编程任务分别统计：\n\n- 语法分析是否正确；\n- 修改方案是否满足目标；\n- 测试结果是否符合预期；\n- 最终验收是否成功。\n\n对手机操作任务，则可以统计：\n\n- 目标应用识别是否正确；\n- 页面状态识别是否正确；\n- 操作是否产生预期状态变化；\n- 是否需要人工纠正。\n\n这些指标比一个笼统的“智能体成功率”更有价值。\n\n同时，校准数据需要保留样本量和不确定范围。只有三次成功的能力，不能因为成功率是 100%，就被认为已充分证明可靠。\n\n## 3.2 不确定性也需要独立评测\n\n建议评估：\n\n- 高风险错误是否能被识别为不确定；\n- 明显正确且证据充分的任务是否被过度质疑；\n- 不确定性评分是否与实际错误率相关；\n- 新模型和新工具上线后，旧校准是否仍然有效；\n- 证据缺失时，系统是否能够拒绝作出无依据的成功声明。\n\n最后一点尤其重要：**一个好的不确定性系统，不只是尽量答对，还应该尽量避免把没有证据的判断说成已经确认的事实。**\n\n---\n\n# 四、核心决策：下一步应该做什么？\n\n识别不确定性之后，系统还必须选择行动。\n\n我建议建立 `Active Decision Policy`，把下一步分成六类：\n\n这些动作不是固定顺序。系统应该选择最符合当前不确定性来源、任务目标和风险边界的行动。\n\n例如：\n\n- 不知道当前手机页面是什么：先观察，不要问用户。\n- 不知道用户想删除哪一个文件：应当澄清目标。\n- 不知道代码是否正确：运行适当测试。\n- 不知道某项外部 API 的最新行为：查阅权威资料或进行受控验证。\n- 无法确认某个外部支付是否成功：暂停重复提交，优先查询状态。\n\n## 4.1 引入“信息价值”判断\n\n每一次额外行动都需要成本。系统应该判断：再做一步，能否实质性降低不确定性，并改善决策？\n\n例如，代码修改后运行单元测试通常成本较低，而且能提供直接证据；再调用三个大模型评价同一段代码，可能成本更高，却没有增加多少独立证据。\n\n因此，我建议引入 `Value of Information`（信息价值）机制。\n\n其核心问题是：\n\n> 获取这条新信息，能否改变当前决策？如果能，改变决策所带来的预期收益是否大于获取信息的成本？\n\n概念上可以表示为：\n\n\\[\nVOI(a)=\n\\mathbb{E}[\\text{获得信息后最优决策的收益}]\n-\\text{当前最优决策收益}\n-\\text{获取信息的成本}\n\\]\n\n这里的收益不仅包括成功率，还应考虑时间、费用、错误后果和恢复成本。\n\n这个公式是决策框架，不意味着所有收益都能准确转换为一个数字。对于权限、安全和不可逆操作，仍然需要硬性规则，不能仅凭期望收益为正就自动执行。\n\n## 4.2 一个实际例子\n\n用户要求修改代码中的一个函数。\n\n系统有三种选择：\n\n- 直接应用补丁；\n- 先解析 AST，再应用补丁；\n- 调用更强的模型重新分析整个项目。\n\n如果修改范围小、目标明确、补丁可逆，直接应用补丁并运行相关测试可能最划算。\n\n如果涉及跨文件符号引用，AST 分析可能显著降低误改风险。\n\n如果涉及复杂架构决策、需求本身存在冲突，才可能值得调用更强模型。\n\n所以，系统不应该永远选择最便宜的方案，也不应该永远选择最强的模型，而应该选择**在当前风险与预算约束下，预期综合表现最好的方案**。\n\n---\n\n# 五、什么时候应该向用户提问？\n\n个人智能体最容易出现两个极端：\n\n- 过度自主：不确定也继续做，最后做错；\n- 过度谨慎：一点不确定就问用户，用户反而成了系统的执行控制器。\n\nEvoAgent 应该根据“这条信息是否会改变行动”和“错误行动的代价”来决定是否澄清。\n\n## 5.1 建议采用四类判断\n\n| 情况 | 建议行为 |\n|--------|--------|\n| 目标明确、低风险 | 直接执行 |\n| 目标大体明确，细节可以安全推断 | 采用合理默认值，必要时告知用户 |\n| 多种解释会导致明显不同的结果 | 先澄清 |\n| 存在权限、隐私或重大不可逆风险 | 满足授权条件前暂停 |\n\n例如，用户说“帮我整理桌面”，系统可以先检查桌面文件类型，提出分类方案；如果要批量删除文件，就不能把“整理”擅自解释成“删除”。\n\n如果用户说“帮我给他发消息”，而“他”指代不明确，系统应该先确认收件人。即使历史记忆显示用户通常联系某个人，也不应在存在实质歧义时自动选择并发送。\n\n## 5.2 设计澄清阈值，而不是统一置信度阈值\n\n不同任务不应使用同一个提问阈值。\n\n例如：\n\n- 推荐一部电影：可以容忍较大的偏好不确定性；\n- 制定旅行计划：可以先给出方案，再让用户调整偏好；\n- 修改项目代码：可以在可逆范围内先分析和提出补丁；\n- 删除文件、发送消息、支付：需要严格满足目标明确性和授权条件。\n\n所以，澄清策略应该结合任务类别、错误代价、可逆性和用户负担，而不是规定“置信度低于 80% 就提问”。\n\n## 5.3 用户偏好也可以影响澄清方式\n\n如果用户已经明确表达了某些长期工作习惯，系统可以据此调整交互：\n\n- 用户偏好先看方案：复杂任务先提供计划；\n- 用户希望减少打扰：对低风险、可逆的细节采用合理默认值；\n- 用户要求谨慎操作：扩大需要确认的操作范围。\n\n但这些偏好不能覆盖当前明确指令，也不能绕过权限边界。用户希望“尽可能自动”不等于允许系统在目标不明确时自行执行不可逆动作。\n\n---\n\n# 六、什么时候应该停止继续思考或尝试？\n\n这是控制成本和防止无效循环的关键。\n\n前面已经设计了 ReAct 的步数限制和自我修复预算，但还缺少一个更智能的判断：即使预算还没有耗尽，是否已经不值得继续？\n\n我建议区分三种停止。\n\n**成功停止**\n\n目标已经通过验收，继续调用模型或工具没有足够的额外收益。\n\n**暂时停止**\n\n缺少授权、等待网络恢复、远端任务仍在运行，或需要用户补充信息。\n\n**失败停止**\n\n已达到预算上限、连续尝试没有进展、存在不可接受风险，或现有能力无法可靠完成任务。\n\n这里有一个很重要的区别：停止当前行动，不一定意味着放弃整个任务。\n\n例如，云端视频生成服务暂时不可用时，智能体可以保存已完成的剧本、角色素材和分镜，暂停生成节点，等待服务恢复，而不需要重新执行整个漫剧工作流。\n\n## 6.1 无进展检测\n\n建议结合以下信号判断是否陷入循环：\n\n- 连续调用相同工具，结果没有变化；\n- 连续生成相同或高度相似的计划；\n- 反复尝试已被证明无效的策略；\n- 新一轮推理没有产生新的有效证据；\n- 任务状态没有推进；\n- 额外成本持续增加，但成功可能性没有明显改善。\n\n当检测到无进展时，系统可以先切换诊断策略，再决定是否继续。\n\n不能仅仅因为连续两次调用同一工具，就认定任务陷入循环。有些操作本来就需要重复执行，例如逐个处理多个文件。真正要判断的是：**重复是否符合当前计划，是否带来了预期状态变化。**\n\n## 6.2 预期收益递减\n\n假设某个代码错误已经经过三轮诊断：\n\n- 第一次发现可能是类型不匹配；\n- 第二次检查确认类型问题；\n- 第三次修复后仍然测试失败，且没有新的证据。\n\n此时继续使用相同方法的价值可能很低。系统应该切换到不同的诊断手段，或停止并报告剩余的不确定性。\n\n但如果每一轮都产生了新证据，那么即使已经尝试三次，也可能值得继续。\n\n因此，停止条件应结合预算、风险、信息价值和实际进展，而不是只依赖固定次数。\n\n---\n\n# 七、将不确定性治理嵌入整个 EvoAgent\n\n这一专项不能只成为一个额外模块。它需要影响前面设计的所有核心组件。\n\n这里还有一个关键约束：不确定性评估本身也要受成本限制。\n\n如果每个工具调用前后都启动一次大模型评估，系统会变得很慢、很贵。低风险任务应该优先使用轻量规则；只有当信息缺口确实会影响决策时，才投入更多资源。\n\n---\n\n# 八、系统如何形成真正的闭环？\n\n我建议让不确定性系统贯穿一次任务的完整生命周期。\n\n这里最重要的是第 5 步：每次行动后，系统都应重新评估当前状态，而不是继续沿用执行前的判断。\n\n例如，手机界面发生变化后，之前对按钮位置的判断可能已经失效；模型切换后，之前针对旧模型校准的能力概率也可能不再适用。\n\n不确定性不是任务开始时评估一次就结束的静态属性，而是随着环境、证据和执行结果持续变化的状态。\n\n---\n\n# 九、本专项建议冻结的架构决策\n\n这些是建议纳入 EvoAgent 全量架构的决策基线，具体阈值和策略需要在后续评测中确定。\n\n# 十、下一专项：模型适配、能力迁移与版本进化\n\n接下来，我建议进入一个与你最初的目标直接相关、但还没有彻底解决的专项：\n\n**当 EvoAgent 从当前大语言模型切换到另一个模型时，如何保留已经积累的能力，又避免把只适用于旧模型的经验、提示词和执行策略错误地迁移过去？**\n\n你最初提出的目标，是把当前环境、当前模型下已经优化好的智能体保存下来，在新的分支上继续优化另一种模型。这实际上要求系统具备明确的模型适配与能力迁移机制。\n\n下一专项应该深入：\n\n1. 哪些组件与模型无关，哪些高度依赖特定模型；\n2. 如何保存模型版本、提示词、上下文策略、路由策略和评测结果的完整适配快照；\n3. 如何判断某条经验是通用规律，还是旧模型特有的行为补偿；\n4. 新模型上线时，如何评估工具调用、规划、记忆检索和验收能力；\n5. 如何通过对照评测决定继承、重新校准、隔离或废弃旧策略；\n6. 如何管理多个模型的独立优化分支；\n7. 如何根据任务难度、成本和质量选择不同模型；\n8. 如何避免模型切换后出现能力退化、成本失控或诊断错误；\n9. 如何在保留旧模型稳定版本的同时，让新模型独立进化；\n10. 如何将跨模型验证成功的改进晋升为真正通用的能力。\n\n这会把 EvoAgent 的自进化机制进一步推进到一个重要目标：**不仅能适应一个模型，而且能持续适配不同模型，同时保留历史成果、控制迁移风险，并让每个模型的优化互不污染。**","fallbackMarkdownVersion":1,"clientDefinedWidgets":{"5aa0e9d9-5c7e-58a4-872d-2c077b99c519":{"status":"resolved","refIndex":0,"isStreaming":false}},"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6","turn_exchange_id":"107cb0a7-3de2-43cd-bd86-3e984bfd5f9e","request_id":"f342ba89-be1f-470b-846b-e1b6f6f9bb58","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[{"type":"client_defined_widget","category":"code_block","data":{"content":"\n{\n  \"assessment_id\": \"ua-00821\",\n  \"task_id\": \"task-123\",\n  \"decision_point\": \"verify_code_change\",\n  \"uncertainty_types\": [\n    \"outcome\"\n  ],\n  \"unknowns\": [\n    {\n      \"question\": \"修改是否破坏现有功能\",\n      \"evidence_available\": [\n        \"patch_applied\"\n      ],\n      \"missing_evidence\": [\n        \"regression_test_result\"\n      ]\n    }\n  ],\n  \"risk_if_wrong\": \"MEDIUM\",\n  \"reversibility\": \"HIGH\",\n  \"recommended_action\": \"RUN_REGRESSION_TESTS\",\n  \"budget_limit_ref\": \"budget-123\",\n  \"status\": \"OPEN\"\n}\n","language":"json","editable":true,"widget_type":"code_block"},"matched_text":"```json\n\n{\n  \"assessment_id\": \"ua-00821\",\n  \"task_id\": \"task-123\",\n  \"decision_point\": \"verify_code_change\",\n  \"uncertainty_types\": [\n    \"outcome\"\n  ],\n  \"unknowns\": [\n    {\n      \"question\": \"修改是否破坏现有功能\",\n      \"evidence_available\": [\n        \"patch_applied\"\n      ],\n      \"missing_evidence\": [\n        \"regression_test_result\"\n      ]\n    }\n  ],\n  \"risk_if_wrong\": \"MEDIUM\",\n  \"reversibility\": \"HIGH\",\n  \"recommended_action\": \"RUN_REGRESSION_TESTS\",\n  \"budget_limit_ref\": \"budget-123\",\n  \"status\": \"OPEN\"\n}\n```","start_idx":1583,"end_idx":2097,"safe_u