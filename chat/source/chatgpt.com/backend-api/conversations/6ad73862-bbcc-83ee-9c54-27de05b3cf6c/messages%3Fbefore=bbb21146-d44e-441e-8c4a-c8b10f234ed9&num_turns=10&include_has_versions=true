,null,__dil.jsx(\"bold\",null,__dilConstants[\"391\"])),__dil.jsx(\"text\",null,__dilConstants[\"392\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第四十专项：主动感知、信息获取与不确定性治理","1":"本轮解决 EvoAgent 从“根据已有信息执行任务”走向“主动发现信息缺口、寻找证据、判断何时足以行动”的关键问题。","2":"前面已经建立了多个基础模块：","3":"Router：判断由哪个专家处理任务；","4":"Planner、ReAct 与 DAG：决定任务如何分解和执行；","5":"MEEG、CLEK：管理记忆、经验和长期知识；","6":"ACMO：决定当前模型调用需要哪些上下文；","7":"ARCBG：管理推理深度、模型选择和资源预算；","8":"RCAE、EQEAG、SELCIA：分析失败、独立评测并管理改进。","9":"现在需要把这些能力连接起来。","10":"例如，用户说：","11":"“帮我找出这个项目为什么运行越来越慢，并修复它。”","12":"EvoAgent 不能直接假设问题出在数据库，也不能一开始就读取所有文件或调用所有专家。它需要判断当前证据是否充分、下一步观察什么最有价值、何时开始修复，以及如何证明问题真正得到解决。","13":"本专项建议定义为：","14":"Active Perception, Information Acquisition & Uncertainty Governance，简称 APIUG。","15":"它负责信息缺口识别、主动观察、信息获取策略、证据可信度、行动门槛和不确定性治理。","16":"一、第一性原理：不知道，并不可怕；不知道自己不知道，才危险","17":"一个可靠的智能体必须区分四种状态：","18":"1. 已知且有证据","19":"例如，性能分析报告显示某个函数占用了 65% 的执行时间，且报告对应当前代码版本。","20":"2. 已知但证据不足","21":"例如，模型怀疑数据库查询过慢，但尚未获取查询计划或运行指标。","22":"3. 明确存在信息缺口","23":"例如，不知道性能下降从哪个版本开始，也没有历史基线。","24":"4. 当前无法确认","25":"例如，性能分析工具无法运行、远程设备离线，或现有证据相互矛盾。","26":"这四种状态对应不同的行动。","27":"已知且有证据：可以进入下一步决策，但仍需满足任务的验收要求。","28":"已知但证据不足：优先获取能够验证或反驳该判断的信息。","29":"明确存在信息缺口：规划有针对性的信息获取动作。","30":"当前无法确认：缩小任务范围、请求必要信息、等待恢复或明确报告限制。","31":"APIUG 的目标不是让系统永远消除不确定性，而是让它知道哪些不确定性可以接受，哪些必须先解决。","32":"二、建立统一的不确定性模型","33":"建议不要只让模型输出一个“我有 80% 把握”的数字。","34":"这种主观置信度容易受表达方式影响，也未必经过校准。更可靠的做法是记录不确定性的具体来源、影响和可验证条件。","35":"2.1 六种不确定性","36":"类型","37":"典型问题","38":"首选处理方向","39":"目标不确定性","40":"用户究竟想要什么结果？","41":"澄清需求、确认验收标准","42":"事实不确定性","43":"实际发生了什么？","44":"查询文件、日志、权威来源","45":"因果不确定性","46":"为什么出现这个问题？","47":"对照实验、诊断、反证","48":"能力不确定性","49":"当前模型、专家或工具能否完成？","50":"能力评测、最小验证任务","51":"环境不确定性","52":"设备、服务、依赖是否可用？","53":"环境检查、状态探测","54":"结果不确定性","55":"当前产物是否正确、完整？","56":"测试、独立验收、运行验证","57":"这六类问题不能全部通过增加模型推理来解决。","58":"如果目标不明确，继续推理可能只是猜测用户意图；如果缺少事实，工具调用可能更有价值；如果因果关系不清楚，就需要设计能够区分不同原因的实验。","59":"2.2 将不确定性与任务状态关联","60":"建议建立 ","61":"UncertaintyRecord","62":"，记录：","63":"uncertainty_id","64":"：唯一标识；","65":"task_id","66":"：关联任务；","67":"uncertainty_type","68":"：不确定性类别；","69":"question","70":"：尚未解决的具体问题；","71":"current_hypotheses","72":"：候选解释；","73":"supporting_evidence","74":"：支持证据；","75":"contradicting_evidence","76":"：反证；","77":"impact_if_wrong","78":"：判断错误的影响；","79":"resolution_options","80":"：可能的信息获取方式；","81":"resolution_status","82":"：未解决、调查中、已解决、可接受或无法确认。","83":"这个对象用于表达“系统还需要知道什么”，而不是替代任务规划、运行日志或长期记忆。","84":"例如，代码专家可以记录“数据库查询是否为主要瓶颈”这一不确定性，并关联性能日志、查询计划和后续实验。其他专家无需重新猜测问题，可以直接读取当前状态与证据。","85":"三、主动感知：智能体下一步应该观察什么？","86":"传统工作流往往预先规定步骤：先读取文件，再运行测试，最后生成报告。","87":"主动感知则要求 EvoAgent 根据当前观察结果，动态决定下一步获取什么信息。","88":"例如，性能问题可能有多个候选原因：","89":"数据库查询变慢；","90":"CPU 密集计算增加；","91":"缓存命中率下降；","92":"网络请求阻塞；","93":"最近的代码修改引入退化。","94":"此时，最合理的下一步不一定是继续阅读代码，而可能是获取一次性能采样，因为它能够同时区分多个候选原因。","95":"3.1 建立观察动作目录","96":"建议将信息获取能力统一注册为 ","97":"ObservationAction","98":"。","99":"动作类型","100":"示例","101":"主要作用","102":"直接读取","103":"文件、配置、历史记录","104":"获取已有事实","105":"状态探测","106":"服务健康检查、设备状态","107":"确认当前环境","108":"结构化分析","109":"AST 分析、依赖图、数据库查询计划","110":"获取结构性证据","111":"运行测量","112":"性能分析、基准测试、资源监控","113":"观察实际行为","114":"外部检索","115":"官方文档、API 规范、版本信息","116":"获取外部事实","117":"受控实验","118":"对比不同参数、执行隔离测试","119":"区分候选原因","120":"用户澄清","121":"询问目标、范围或偏好","122":"消除无法从外部获取的歧义","123":"独立验证","124":"测试、产物检查、交叉核验","125":"判断结果是否可信","126":"每种观察动作都应定义输入、输出、成本、权限、执行风险、超时策略和可验证程度。","127":"这样，模型可以选择观察方式，但不需要自行发明工具接口，也不能绕过工具运行时的权限控制。","128":"3.2 根据观察结果动态分支","129":"例如：","130":"发现性能退化","131":"现有证据不足以确定根因。","132":"获取性能采样与历史基线","133":"CPU 计算占主导","134":"分析热点函数与调用路径。","135":"数据库等待占主导","136":"分析查询计划、锁与等待时间。","137":"验证根因假设，再决定是否修改代码","138":"如果证据仍不充分，则选择下一项能够区分候选原因的观察或实验。","139":"这里的分支只是示例，不意味着所有性能问题都能被一次采样准确定位。","140":"关键在于：任务 DAG 可以保留总体目标、硬约束和验收节点，而内部观察步骤可以根据真实结果动态生成或调整。","141":"DAG 负责依赖与状态约束，主动感知负责决定下一步需要获取什么信息。二者不是替代关系。","142":"四、信息价值评估：哪一次观察最值得执行？","143":"主动感知不能演变成无限调查。系统需要判断下一项观察是否值得花费资源。","144":"建议引入“预期信息价值”，将候选观察动作按其决策价值进行比较。","145":"4.1 评估四个方面","146":"对于一个候选观察动作，至少评估：","147":"区分能力：","148":" 它能否区分当前的重要假设？","149":"决策影响：","150":" 结果是否可能改变下一步行动？","151":"可靠程度：","152":" 该动作能否产生可信、可复现的证据？","153":"执行成本与风险：","154":" 需要多少时间、Token、费用和副作用？","155":"可以用简化的价值模型：","156":"VOI(a)=\n\\mathbb{E}[\\text{决策损失减少}\\mid a]\n-\n\\text{成本}(a)\n-\n\\text{风险}(a)","157":"这里的 ","158":"VOI","159":" 表示信息价值。公式用于指导候选动作排序，不代表系统总能精确计算这些数值。","160":"例如：","161":"读取现有日志，成本低且可能快速定位问题；","162":"运行完整压力测试，可能产生更强证据，但耗时更长；","163":"让三个专家重复阅读相同日志，可能成本很高，却几乎不增加信息。","164":"在其他条件相近时，应优先选择能够以较低成本减少关键不确定性的动作。","165":"4.2 观察结果可能改变决策时，信息价值才更高","166":"假设系统已经确认某个函数占用了绝大部分执行时间。","167":"如果无论查询数据库还是检查网络，都会继续优化这个函数，那么再做这些观察的价值可能很低。","168":"反之，如果不同观察结果会导致完全不同的修复方案，就值得进一步调查。","169":"这能防止系统陷入“为了更确定而不断收集信息”的循环。","170":"4.3 风险约束不能被平均信息价值抵消","171":"某项检查可能成本较高，但如果它是高风险操作的必要验收步骤，就不能因为估算信息收益低而跳过。","172":"因此，APIUG 的动作选择必须同时满足：","173":"预期价值约束；","174":"任务硬约束；","175":"安全与授权要求；","176":"时间与资源预算。","177":"信息价值用于选择可选动作，不能取代必要的安全检查。","178":"五、证据治理：信息获取之后，如何判断它是否可信？","179":"主动获取的信息并不天然可靠。","180":"文件可能过期，日志可能对应旧版本，外部资料可能已经失效，模型生成的解释也可能存在错误。","181":"建议建立统一的 ","182":"EvidenceRecord","183":"，让系统在使用信息时能够回答：它来自哪里、支持什么结论、适用于哪个版本，以及是否有反证。","184":"5.1 证据的六个关键属性","185":"属性","186":"含义","187":"来源","188":"文件、工具、用户、外部文档或模型假设","189":"时间与版本","190":"证据何时产生，对应哪个系统状态","191":"直接性","192":"是实际测量，还是间接推断","193":"可复现性","194":"是否能够重新获取或验证","195":"适用范围","196":"能支持哪些任务、环境与结论","197":"冲突情况","198":"是否存在相反证据或尚未解释的差异","199":"例如，“服务响应变慢”可以由用户报告提出，也可以由性能监控证实。","200":"用户报告足以触发调查，但不能单独证明具体根因。性能监控则可能支持延迟确实增加，但仍未必能够证明是哪个组件导致的。","201":"5.2 区分观察事实与根因假设","202":"建议在所有诊断与上下文记录中严格区分：","203":"Observation：","204":" 实际观察到的现象；","205":"Evidence：","206":" 支持某个判断的证据；","207":"Hypothesis：","208":" 对原因的解释；","209":"Conclusion：","210":" 在当前证据下能够支持的结论；","211":"Unknown：","212":" 仍未解决的问题。","213":"例如：","214":"观察：请求耗时从 200 ms 增加到 900 ms；","215":"证据：性能采样显示数据库等待时间明显增加；","216":"假设：某次索引变更导致查询计划退化；","217":"验证：对比变更前后的查询计划；","218":"结论：只有在证据足够时，才能把索引变更认定为主要原因。","219":"这样可以避免模型把“可能是数据库问题”在多轮摘要之后逐渐变成“数据库问题已经确认”。","220":"5.3 冲突证据不能简单取平均","221":"如果日志显示服务正常，但用户反馈操作失败，系统不应直接认为双方各有一半正确。","222":"更合理的做法是检查：","223":"是否观察的是不同时间段；","224":"是否来自不同设备或实例；","225":"是否存在局部故障；","226":"是否有日志采集缺失；","227":"两者是否衡量了不同的指标。","228":"很多证据冲突最终可以通过明确时间、对象和测量范围来解决，而不是强制选择一个来源。","229":"六、什么时候应该询问用户，而不是继续猜测？","230":"这是主动感知与通用智能体交互之间的关键接口。","231":"EvoAgent 不应该遇到任何未知信息都询问用户，否则会让用户承担本来可以自动完成的调查工作。","232":"也不应该为了保持自动化，就在关键需求不明确时擅自做出不可逆的决定。","233":"建议将信息缺口分为三类。","234":"A 类：可以自行获取","235":"例如项目路径、工具版本、文件结构、运行日志。优先使用已有权限的工具获取，不必询问用户。","236":"B 类：可以采用可逆的默认值","237":"例如报告的默认排版、临时文件命名、低风险任务的展示方式。使用合理默认值，并在必要时说明。","238":"C 类：必须澄清或授权","239":"例如相互冲突的硬性要求、无法推断的关键业务目标、未经授权的高风险操作。停止相关决策，提出具体问题或请求授权。","240":"6.1 询问问题也需要价值判断","241":"一个好的澄清问题应当：","242":"直接针对会改变执行方案的信息；","243":"尽可能一次解决关键歧义；","244":"提供清晰、容易回答的选项；","245":"避免询问系统可以自行可靠获取的信息；","246":"不重复询问用户已经明确提供的条件。","247":"例如，“你希望优化什么？”通常过于宽泛。","248":"如果现有证据显示主要瓶颈可能涉及响应延迟或内存占用，系统可以先进行低成本测量，再询问用户是否有必须满足的延迟目标或内存上限。","249":"这样既降低了用户负担，也提高了决策质量。","250":"6.2 用户沉默不等于授权","251":"如果任务涉及删除数据、覆盖文件、对外发送信息或其他需要明确授权的操作，系统不能把用户未回复理解为同意。","252":"可以继续执行不依赖该授权的安全子任务，但必须将需要授权的步骤保留为阻塞节点。","253":"这与之前的 SBAAG 安全授权机制保持一致。","254":"七、与 Planner、ReAct 和 DAG 的关系：固定骨架，动态观察","255":"主动感知不能成为一个独立于任务执行系统的平行智能体，否则容易出现多个模块各自规划、重复调用工具的问题。","256":"建议明确以下职责：","257":"模块","258":"职责","259":"Planner","260":"生成任务计划、目标和依赖结构","261":"DAG 执行器","262":"管理节点状态、依赖、并行和恢复","263":"ReAct 控制器","264":"在局部执行循环中根据观察调整行动","265":"APIUG","266":"识别信息缺口，选择高价值观察和验证动作","267":"ACMO","268":"将必要的观察结果组织进当前模型上下文","269":"ARCBG","270":"为信息获取和后续推理分配资源","271":"RCAE","272":"分析失败原因和证据链","273":"EQEAG","274":"验证新的观察策略是否提高了任务表现","275":"一个合理的执行过程是：","276":"Planner 确定总体目标与必要验收条件；","277":"DAG 执行器启动当前可执行节点；","278":"APIUG 判断节点所需的信息是否充分；","279":"若不足，选择合适的观察动作；","280":"ACMO 将新证据组织为下一次调用的上下文；","281":"ReAct 根据观察决定继续、切换工具或请求重新规划；","282":"节点完成后，由相应的验收机制检查结果；","283":"运行证据进入 ODERI，必要时由 RCAE 分析异常。","284":"APIUG 不应该重新发明一套任务规划器。它应当为现有规划与执行体系提供更好的信息决策能力。","285":"八、主动感知必须有边界：避免无限探索","286":"主动感知最容易出现的问题，是系统不断发现新的未知信息，最终永远无法完成任务。","287":"例如，调查一个程序的性能时，可以不断深入操作系统、数据库、网络、编译器乃至硬件层。技术上总能找到更多值得研究的问题，但用户未必需要这些调查。","288":"因此，APIUG 需要明确的停止条件。","289":"8.1 六种合理的停止状态","290":"SUFFICIENT","291":"：现有证据已经足以支持当前决策；","292":"RESOLVED","293":"：目标不确定性已得到解决；","294":"ACCEPTABLE","295":"：仍有不确定性，但其风险在任务允许范围内；","296":"BUDGET_EXHAUSTED","297":"：达到预算上限；","298":"BLOCKED","299":"：缺少必要授权、输入或外部条件；","300":"UNRESOLVED","301":"：经过合理调查仍无法确认。","302":"这些状态应当与任务执行状态分开管理。","303":"例如，一个性能根因可以是 ","304":"UNRESOLVED","305":"，但任务仍然可以交付一份已验证的诊断报告。反过来，根因已经找到，也不代表代码修复和回归测试已经完成。","306":"8.2 建立观察次数与重复动作限制","307":"建议按任务类别配置：","308":"单次观察的超时限制；","309":"相同观察动作的重复次数；","310":"连续无新证据的停止门槛；","311":"调查阶段预算；","312":"最大依赖展开深度；","313":"必须升级到人工判断的条件。","314":"这些限制不是为了让系统机械地停止，而是防止它重复进行没有新增价值的调查。","315":"如果连续几轮获取的证据没有改变假设排序或后续决策，系统就应该重新评估信息获取策略。","316":"8.3 不确定性可以被接受，但必须记录","317":"不是所有未知信息都值得消除。","318":"例如，一份研究报告可以明确说明某项结论尚未被验证，而不必为了追求绝对确定而无限搜索。","319":"但是，对于影响安全、数据完整性或关键验收结果的不确定性，系统可能必须继续验证或暂停执行。","320":"因此，是否允许带着不确定性继续，应该由任务风险和验收规则决定，而不是由模型主观判断。","321":"九、让主动感知本身也能持续进化","322":"APIUG 不仅要执行信息获取策略，还需要判断这些策略是否有效。","323":"例如，系统可能发现：","324":"先检查项目状态比直接搜索代码更快；","325":"某类故障通过日志与性能采样即可定位，不需要多个专家；","326":"某个外部资料源经常过期；","327":"某种诊断流程会反复收集相同证据；","328":"某些澄清问题可以由低风险的自动探测替代。","329":"这些发现可以成为改进候选，但不能直接变成新的全局规则。","330":"9.1 建立主动感知评测指标","331":"建议至少评估以下维度：","332":"指标","333":"评价什么","334":"信息缺口识别率","335":"是否识别出会影响任务决策的关键未知项","336":"观察动作有效率","337":"执行的观察是否产生新的、可用的信息","338":"关键假设区分能力","339":"观察是否能够排除或支持候选原因","340":"证据可靠性","341":"获取的信息是否准确、适用且可追溯","342":"过度调查率","343":"是否收集了大量不会改变决策的信息","344":"用户澄清效率","345":"是否以较少问题解决关键歧义","346":"诊断返工率","347":"是否因过早下结论而重复调查","348":"信息获取成本","349":"为解决关键未知项消耗了多少时间、费用和资源","350":"不能只用“调查次数减少”作为优化目标，因为少调查可能意味着漏掉关键证据。","351":"同样，不能只用“信息缺口识别率提高”作为目标，因为系统可能把大量无关未知项都标记出来。","352":"9.2 用对照实验验证新的观察策略","353":"例如，针对同类性能故障，可以比较：","354":"稳定策略：按照现有诊断流程获取信息；","355":"候选策略：先选择预期信息价值最高的观察动作；","356":"验收：比较根因识别质量、修复成功率、调查成本和错误结论率。","357":"测试时需要尽量控制任务难度、工具版本和验收规则。","358":"对于复杂问题，还应检查策略是否在某些任务类别中退化，不能仅根据平均调查时间缩短就批准发布。","359":"这与 SELCIA 的候选评测和发布治理机制一致。","360":"十、建议冻结的架构决策","361":"以下是建议纳入 EvoAgent 全量架构的 APIUG 治理基线。","362":"这些是建议纳入 EvoAgent 全量架构的主动感知与不确定性治理基线。正式实施时，还需要定义 ","363":"UncertaintyRecord","364":"、","365":"EvidenceRecord","366":"、","367":"ObservationAction","368":"、信息价值评估协议和主动感知评测集。","369":"十一、下一专项：长期任务自治、执行恢复与跨会话连续性","370":"到这里，我们已经分别设计了任务规划、专家能力、长期知识、上下文、资源预算和主动感知。","371":"接下来需要研究一个把它们真正连接起来的问题：","372":"当一个任务持续数小时、数天甚至更久，中间发生应用关闭、设备重启、网络断开、工具失败或用户切换任务时，EvoAgent 如何准确恢复，而不是从头开始或错误地重复执行？","373":"这对于你选择的个人电脑、Android 手机和微型 Linux 主机部署方向尤其重要。","374":"例如，AI 漫剧制作任务可能已经完成剧本、角色设定和部分镜头生成，但随后云端服务断开。如果系统只保存聊天记录，恢复后就可能重新生成已完成的镜头、重复扣费，或者把旧版分镜与新版素材混合。","375":"下一专项建议定义为：","376":"Long-Horizon Task Autonomy & Recovery，简称 LTAR。","377":"重点研究：","378":"如何把长期任务的权威状态持久化；","379":"如何区分任务状态、模型上下文、记忆和执行日志；","380":"如何实现检查点、断点恢复和跨会话继续执行；","381":"如何处理任务暂停、取消、超时和用户中断；","382":"如何防止恢复时重复执行有副作用的操作；","383":"如何管理部分成功、部分失败和结果未知的节点；","384":"如何在工具或模型版本变化后判断原任务能否继续；","385":"如何恢复 DAG、ReAct 循环与多专家协作的中间状态；","386":"如何在 Android、本地电脑和微型 Linux 主机之间处理设备能力差异；","387":"如何让离线任务安全排队，并在连接恢复后继续；","388":"如何验证恢复后的任务状态与实际文件、工具和外部服务一致；","389":"如何在任务恢复后继续使用正确的记忆、上下文和资源预算。","390":"本专项的核心原则是：","391":"恢复任务时，优先恢复可验证的执行状态，而不是仅凭历史聊天重新猜测发生了什么。","392":"完成 LTAR 后，EvoAgent 的长任务执行、异常恢复和跨会话连续性就会有更明确的架构基础。"},"fallbackMarkdown":"# EvoAgent 第四十专项：主动感知、信息获取与不确定性治理\n\n本轮解决 EvoAgent 从“根据已有信息执行任务”走向“主动发现信息缺口、寻找证据、判断何时足以行动”的关键问题。\n\n前面已经建立了多个基础模块：\n\n- Router：判断由哪个专家处理任务；\n- Planner、ReAct 与 DAG：决定任务如何分解和执行；\n- MEEG、CLEK：管理记忆、经验和长期知识；\n- ACMO：决定当前模型调用需要哪些上下文；\n- ARCBG：管理推理深度、模型选择和资源预算；\n- RCAE、EQEAG、SELCIA：分析失败、独立评测并管理改进。\n\n现在需要把这些能力连接起来。\n\n例如，用户说：\n\n“帮我找出这个项目为什么运行越来越慢，并修复它。”\n\nEvoAgent 不能直接假设问题出在数据库，也不能一开始就读取所有文件或调用所有专家。它需要判断当前证据是否充分、下一步观察什么最有价值、何时开始修复，以及如何证明问题真正得到解决。\n\n本专项建议定义为：\n\n**Active Perception, Information Acquisition &amp; Uncertainty Governance，简称 APIUG。**\n\n它负责信息缺口识别、主动观察、信息获取策略、证据可信度、行动门槛和不确定性治理。\n\n## 一、第一性原理：不知道，并不可怕；不知道自己不知道，才危险\n\n一个可靠的智能体必须区分四种状态：\n\n### 1\\. 已知且有证据\n\n例如，性能分析报告显示某个函数占用了 65% 的执行时间，且报告对应当前代码版本。\n\n---\n\n### 2\\. 已知但证据不足\n\n例如，模型怀疑数据库查询过慢，但尚未获取查询计划或运行指标。\n\n---\n\n### 3\\. 明确存在信息缺口\n\n例如，不知道性能下降从哪个版本开始，也没有历史基线。\n\n---\n\n### 4\\. 当前无法确认\n\n例如，性能分析工具无法运行、远程设备离线，或现有证据相互矛盾。\n\n这四种状态对应不同的行动。\n\n- 已知且有证据：可以进入下一步决策，但仍需满足任务的验收要求。\n- 已知但证据不足：优先获取能够验证或反驳该判断的信息。\n- 明确存在信息缺口：规划有针对性的信息获取动作。\n- 当前无法确认：缩小任务范围、请求必要信息、等待恢复或明确报告限制。\n\n**APIUG 的目标不是让系统永远消除不确定性，而是让它知道哪些不确定性可以接受，哪些必须先解决。**\n\n---\n\n# 二、建立统一的不确定性模型\n\n建议不要只让模型输出一个“我有 80% 把握”的数字。\n\n这种主观置信度容易受表达方式影响，也未必经过校准。更可靠的做法是记录不确定性的具体来源、影响和可验证条件。\n\n## 2.1 六种不确定性\n\n| 类型 | 典型问题 | 首选处理方向 |\n|--------|--------|--------|\n| 目标不确定性 | 用户究竟想要什么结果？ | 澄清需求、确认验收标准 |\n| 事实不确定性 | 实际发生了什么？ | 查询文件、日志、权威来源 |\n| 因果不确定性 | 为什么出现这个问题？ | 对照实验、诊断、反证 |\n| 能力不确定性 | 当前模型、专家或工具能否完成？ | 能力评测、最小验证任务 |\n| 环境不确定性 | 设备、服务、依赖是否可用？ | 环境检查、状态探测 |\n| 结果不确定性 | 当前产物是否正确、完整？ | 测试、独立验收、运行验证 |\n\n这六类问题不能全部通过增加模型推理来解决。\n\n如果目标不明确，继续推理可能只是猜测用户意图；如果缺少事实，工具调用可能更有价值；如果因果关系不清楚，就需要设计能够区分不同原因的实验。\n\n## 2.2 将不确定性与任务状态关联\n\n建议建立 `UncertaintyRecord`，记录：\n\n- `uncertainty_id`：唯一标识；\n- `task_id`：关联任务；\n- `uncertainty_type`：不确定性类别；\n- `question`：尚未解决的具体问题；\n- `current_hypotheses`：候选解释；\n- `supporting_evidence`：支持证据；\n- `contradicting_evidence`：反证；\n- `impact_if_wrong`：判断错误的影响；\n- `resolution_options`：可能的信息获取方式；\n- `resolution_status`：未解决、调查中、已解决、可接受或无法确认。\n\n这个对象用于表达“系统还需要知道什么”，而不是替代任务规划、运行日志或长期记忆。\n\n例如，代码专家可以记录“数据库查询是否为主要瓶颈”这一不确定性，并关联性能日志、查询计划和后续实验。其他专家无需重新猜测问题，可以直接读取当前状态与证据。\n\n---\n\n# 三、主动感知：智能体下一步应该观察什么？\n\n传统工作流往往预先规定步骤：先读取文件，再运行测试，最后生成报告。\n\n主动感知则要求 EvoAgent 根据当前观察结果，动态决定下一步获取什么信息。\n\n例如，性能问题可能有多个候选原因：\n\n- 数据库查询变慢；\n- CPU 密集计算增加；\n- 缓存命中率下降；\n- 网络请求阻塞；\n- 最近的代码修改引入退化。\n\n此时，最合理的下一步不一定是继续阅读代码，而可能是获取一次性能采样，因为它能够同时区分多个候选原因。\n\n## 3.1 建立观察动作目录\n\n建议将信息获取能力统一注册为 `ObservationAction`。\n\n| 动作类型 | 示例 | 主要作用 |\n|--------|--------|--------|\n| 直接读取 | 文件、配置、历史记录 | 获取已有事实 |\n| 状态探测 | 服务健康检查、设备状态 | 确认当前环境 |\n| 结构化分析 | AST 分析、依赖图、数据库查询计划 | 获取结构性证据 |\n| 运行测量 | 性能分析、基准测试、资源监控 | 观察实际行为 |\n| 外部检索 | 官方文档、API 规范、版本信息 | 获取外部事实 |\n| 受控实验 | 对比不同参数、执行隔离测试 | 区分候选原因 |\n| 用户澄清 | 询问目标、范围或偏好 | 消除无法从外部获取的歧义 |\n| 独立验证 | 测试、产物检查、交叉核验 | 判断结果是否可信 |\n\n每种观察动作都应定义输入、输出、成本、权限、执行风险、超时策略和可验证程度。\n\n这样，模型可以选择观察方式，但不需要自行发明工具接口，也不能绕过工具运行时的权限控制。\n\n## 3.2 根据观察结果动态分支\n\n例如：\n\n**发现性能退化**\n\n现有证据不足以确定根因。\n\n**获取性能采样与历史基线**\n\nCPU 计算占主导\n\n分析热点函数与调用路径。\n\n数据库等待占主导\n\n分析查询计划、锁与等待时间。\n\n**验证根因假设，再决定是否修改代码**\n\n如果证据仍不充分，则选择下一项能够区分候选原因的观察或实验。\n\n这里的分支只是示例，不意味着所有性能问题都能被一次采样准确定位。\n\n关键在于：任务 DAG 可以保留总体目标、硬约束和验收节点，而内部观察步骤可以根据真实结果动态生成或调整。\n\n**DAG 负责依赖与状态约束，主动感知负责决定下一步需要获取什么信息。二者不是替代关系。**\n\n---\n\n# 四、信息价值评估：哪一次观察最值得执行？\n\n主动感知不能演变成无限调查。系统需要判断下一项观察是否值得花费资源。\n\n建议引入“预期信息价值”，将候选观察动作按其决策价值进行比较。\n\n## 4.1 评估四个方面\n\n对于一个候选观察动作，至少评估：\n\n1. **区分能力：** 它能否区分当前的重要假设？\n2. **决策影响：** 结果是否可能改变下一步行动？\n3. **可靠程度：** 该动作能否产生可信、可复现的证据？\n4. **执行成本与风险：** 需要多少时间、Token、费用和副作用？\n\n可以用简化的价值模型：\n\n\\[\nVOI(a)=\n\\mathbb{E}[\\text{决策损失减少}\\mid a]\n-\n\\text{成本}(a)\n-\n\\text{风险}(a)\n\\]\n\n这里的 \\(VOI\\) 表示信息价值。公式用于指导候选动作排序，不代表系统总能精确计算这些数值。\n\n例如：\n\n- 读取现有日志，成本低且可能快速定位问题；\n- 运行完整压力测试，可能产生更强证据，但耗时更长；\n- 让三个专家重复阅读相同日志，可能成本很高，却几乎不增加信息。\n\n在其他条件相近时，应优先选择能够以较低成本减少关键不确定性的动作。\n\n## 4.2 观察结果可能改变决策时，信息价值才更高\n\n假设系统已经确认某个函数占用了绝大部分执行时间。\n\n如果无论查询数据库还是检查网络，都会继续优化这个函数，那么再做这些观察的价值可能很低。\n\n反之，如果不同观察结果会导致完全不同的修复方案，就值得进一步调查。\n\n这能防止系统陷入“为了更确定而不断收集信息”的循环。\n\n## 4.3 风险约束不能被平均信息价值抵消\n\n某项检查可能成本较高，但如果它是高风险操作的必要验收步骤，就不能因为估算信息收益低而跳过。\n\n因此，APIUG 的动作选择必须同时满足：\n\n- 预期价值约束；\n- 任务硬约束；\n- 安全与授权要求；\n- 时间与资源预算。\n\n信息价值用于选择可选动作，不能取代必要的安全检查。\n\n---\n\n# 五、证据治理：信息获取之后，如何判断它是否可信？\n\n主动获取的信息并不天然可靠。\n\n文件可能过期，日志可能对应旧版本，外部资料可能已经失效，模型生成的解释也可能存在错误。\n\n建议建立统一的 `EvidenceRecord`，让系统在使用信息时能够回答：它来自哪里、支持什么结论、适用于哪个版本，以及是否有反证。\n\n## 5.1 证据的六个关键属性\n\n| 属性 | 含义 |\n|--------|--------|\n| 来源 | 文件、工具、用户、外部文档或模型假设 |\n| 时间与版本 | 证据何时产生，对应哪个系统状态 |\n| 直接性 | 是实际测量，还是间接推断 |\n| 可复现性 | 是否能够重新获取或验证 |\n| 适用范围 | 能支持哪些任务、环境与结论 |\n| 冲突情况 | 是否存在相反证据或尚未解释的差异 |\n\n例如，“服务响应变慢”可以由用户报告提出，也可以由性能监控证实。\n\n用户报告足以触发调查，但不能单独证明具体根因。性能监控则可能支持延迟确实增加，但仍未必能够证明是哪个组件导致的。\n\n## 5.2 区分观察事实与根因假设\n\n建议在所有诊断与上下文记录中严格区分：\n\n- **Observation：** 实际观察到的现象；\n- **Evidence：** 支持某个判断的证据；\n- **Hypothesis：** 对原因的解释；\n- **Conclusion：** 在当前证据下能够支持的结论；\n- **Unknown：** 仍未解决的问题。\n\n例如：\n\n- 观察：请求耗时从 200 ms 增加到 900 ms；\n- 证据：性能采样显示数据库等待时间明显增加；\n- 假设：某次索引变更导致查询计划退化；\n- 验证：对比变更前后的查询计划；\n- 结论：只有在证据足够时，才能把索引变更认定为主要原因。\n\n这样可以避免模型把“可能是数据库问题”在多轮摘要之后逐渐变成“数据库问题已经确认”。\n\n## 5.3 冲突证据不能简单取平均\n\n如果日志显示服务正常，但用户反馈操作失败，系统不应直接认为双方各有一半正确。\n\n更合理的做法是检查：\n\n- 是否观察的是不同时间段；\n- 是否来自不同设备或实例；\n- 是否存在局部故障；\n- 是否有日志采集缺失；\n- 两者是否衡量了不同的指标。\n\n很多证据冲突最终可以通过明确时间、对象和测量范围来解决，而不是强制选择一个来源。\n\n---\n\n# 六、什么时候应该询问用户，而不是继续猜测？\n\n这是主动感知与通用智能体交互之间的关键接口。\n\nEvoAgent 不应该遇到任何未知信息都询问用户，否则会让用户承担本来可以自动完成的调查工作。\n\n也不应该为了保持自动化，就在关键需求不明确时擅自做出不可逆的决定。\n\n建议将信息缺口分为三类。\n\n### A 类：可以自行获取\n\n例如项目路径、工具版本、文件结构、运行日志。优先使用已有权限的工具获取，不必询问用户。\n\n---\n\n### B 类：可以采用可逆的默认值\n\n例如报告的默认排版、临时文件命名、低风险任务的展示方式。使用合理默认值，并在必要时说明。\n\n---\n\n### C 类：必须澄清或授权\n\n例如相互冲突的硬性要求、无法推断的关键业务目标、未经授权的高风险操作。停止相关决策，提出具体问题或请求授权。\n\n## 6.1 询问问题也需要价值判断\n\n一个好的澄清问题应当：\n\n- 直接针对会改变执行方案的信息；\n- 尽可能一次解决关键歧义；\n- 提供清晰、容易回答的选项；\n- 避免询问系统可以自行可靠获取的信息；\n- 不重复询问用户已经明确提供的条件。\n\n例如，“你希望优化什么？”通常过于宽泛。\n\n如果现有证据显示主要瓶颈可能涉及响应延迟或内存占用，系统可以先进行低成本测量，再询问用户是否有必须满足的延迟目标或内存上限。\n\n这样既降低了用户负担，也提高了决策质量。\n\n## 6.2 用户沉默不等于授权\n\n如果任务涉及删除数据、覆盖文件、对外发送信息或其他需要明确授权的操作，系统不能把用户未回复理解为同意。\n\n可以继续执行不依赖该授权的安全子任务，但必须将需要授权的步骤保留为阻塞节点。\n\n这与之前的 SBAAG 安全授权机制保持一致。\n\n---\n\n# 七、与 Planner、ReAct 和 DAG 的关系：固定骨架，动态观察\n\n主动感知不能成为一个独立于任务执行系统的平行智能体，否则容易出现多个模块各自规划、重复调用工具的问题。\n\n建议明确以下职责：\n\n| 模块 | 职责 |\n|--------|--------|\n| Planner | 生成任务计划、目标和依赖结构 |\n| DAG 执行器 | 管理节点状态、依赖、并行和恢复 |\n| ReAct 控制器 | 在局部执行循环中根据观察调整行动 |\n| APIUG | 识别信息缺口，选择高价值观察和验证动作 |\n| ACMO | 将必要的观察结果组织进当前模型上下文 |\n| ARCBG | 为信息获取和后续推理分配资源 |\n| RCAE | 分析失败原因和证据链 |\n| EQEAG | 验证新的观察策略是否提高了任务表现 |\n\n一个合理的执行过程是：\n\n1. Planner 确定总体目标与必要验收条件；\n2. DAG 执行器启动当前可执行节点；\n3. APIUG 判断节点所需的信息是否充分；\n4. 若不足，选择合适的观察动作；\n5. ACMO 将新证据组织为下一次调用的上下文；\n6. ReAct 根据观察决定继续、切换工具或请求重新规划；\n7. 节点完成后，由相应的验收机制检查结果；\n8. 运行证据进入 ODERI，必要时由 RCAE 分析异常。\n\n**APIUG 不应该重新发明一套任务规划器。它应当为现有规划与执行体系提供更好的信息决策能力。**\n\n---\n\n# 八、主动感知必须有边界：避免无限探索\n\n主动感知最容易出现的问题，是系统不断发现新的未知信息，最终永远无法完成任务。\n\n例如，调查一个程序的性能时，可以不断深入操作系统、数据库、网络、编译器乃至硬件层。技术上总能找到更多值得研究的问题，但用户未必需要这些调查。\n\n因此，APIUG 需要明确的停止条件。\n\n## 8.1 六种合理的停止状态\n\n- `SUFFICIENT`：现有证据已经足以支持当前决策；\n- `RESOLVED`：目标不确定性已得到解决；\n- `ACCEPTABLE`：仍有不确定性，但其风险在任务允许范围内；\n- `BUDGET_EXHAUSTED`：达到预算上限；\n- `BLOCKED`：缺少必要授权、输入或外部条件；\n- `UNRESOLVED`：经过合理调查仍无法确认。\n\n这些状态应当与任务执行状态分开管理。\n\n例如，一个性能根因可以是 `UNRESOLVED`，但任务仍然可以交付一份已验证的诊断报告。反过来，根因已经找到，也不代表代码修复和回归测试已经完成。\n\n## 8.2 建立观察次数与重复动作限制\n\n建议按任务类别配置：\n\n- 单次观察的超时限制；\n- 相同观察动作的重复次数；\n- 连续无新证据的停止门槛；\n- 调查阶段预算；\n- 最大依赖展开深度；\n- 必须升级到人工判断的条件。\n\n这些限制不是为了让系统机械地停止，而是防止它重复进行没有新增价值的调查。\n\n如果连续几轮获取的证据没有改变假设排序或后续决策，系统就应该重新评估信息获取策略。\n\n## 8.3 不确定性可以被接受，但必须记录\n\n不是所有未知信息都值得消除。\n\n例如，一份研究报告可以明确说明某项结论尚未被验证，而不必为了追求绝对确定而无限搜索。\n\n但是，对于影响安全、数据完整性或关键验收结果的不确定性，系统可能必须继续验证或暂停执行。\n\n因此，是否允许带着不确定性继续，应该由任务风险和验收规则决定，而不是由模型主观判断。\n\n---\n\n# 九、让主动感知本身也能持续进化\n\nAPIUG 不仅要执行信息获取策略，还需要判断这些策略是否有效。\n\n例如，系统可能发现：\n\n- 先检查项目状态比直接搜索代码更快；\n- 某类故障通过日志与性能采样即可定位，不需要多个专家；\n- 某个外部资料源经常过期；\n- 某种诊断流程会反复收集相同证据；\n- 某些澄清问题可以由低风险的自动探测替代。\n\n这些发现可以成为改进候选，但不能直接变成新的全局规则。\n\n## 9.1 建立主动感知评测指标\n\n建议至少评估以下维度：\n\n| 指标 | 评价什么 |\n|--------|--------|\n| 信息缺口识别率 | 是否识别出会影响任务决策的关键未知项 |\n| 观察动作有效率 | 执行的观察是否产生新的、可用的信息 |\n| 关键假设区分能力 | 观察是否能够排除或支持候选原因 |\n| 证据可靠性 | 获取的信息是否准确、适用且可追溯 |\n| 过度调查率 | 是否收集了大量不会改变决策的信息 |\n| 用户澄清效率 | 是否以较少问题解决关键歧义 |\n| 诊断返工率 | 是否因过早下结论而重复调查 |\n| 信息获取成本 | 为解决关键未知项消耗了多少时间、费用和资源 |\n\n不能只用“调查次数减少”作为优化目标，因为少调查可能意味着漏掉关键证据。\n\n同样，不能只用“信息缺口识别率提高”作为目标，因为系统可能把大量无关未知项都标记出来。\n\n## 9.2 用对照实验验证新的观察策略\n\n例如，针对同类性能故障，可以比较：\n\n- 稳定策略：按照现有诊断流程获取信息；\n- 候选策略：先选择预期信息价值最高的观察动作；\n- 验收：比较根因识别质量、修复成功率、调查成本和错误结论率。\n\n测试时需要尽量控制任务难度、工具版本和验收规则。\n\n对于复杂问题，还应检查策略是否在某些任务类别中退化，不能仅根据平均调查时间缩短就批准发布。\n\n这与 SELCIA 的候选评测和发布治理机制一致。\n\n---\n\n# 十、建议冻结的架构决策\n\n以下是建议纳入 EvoAgent 全量架构的 APIUG 治理基线。\n\n这些是建议纳入 EvoAgent 全量架构的主动感知与不确定性治理基线。正式实施时，还需要定义 `UncertaintyRecord`、`EvidenceRecord`、`ObservationAction`、信息价值评估协议和主动感知评测集。\n\n---\n\n# 十一、下一专项：长期任务自治、执行恢复与跨会话连续性\n\n到这里，我们已经分别设计了任务规划、专家能力、长期知识、上下文、资源预算和主动感知。\n\n接下来需要研究一个把它们真正连接起来的问题：\n\n**当一个任务持续数小时、数天甚至更久，中间发生应用关闭、设备重启、网络断开、工具失败或用户切换任务时，EvoAgent 如何准确恢复，而不是从头开始或错误地重复执行？**\n\n这对于你选择的个人电脑、Android 手机和微型 Linux 主机部署方向尤其重要。\n\n例如，AI 漫剧制作任务可能已经完成剧本、角色设定和部分镜头生成，但随后云端服务断开。如果系统只保存聊天记录，恢复后就可能重新生成已完成的镜头、重复扣费，或者把旧版分镜与新版素材混合。\n\n下一专项建议定义为：\n\n**Long-Horizon Task Autonomy &amp; Recovery，简称 LTAR。**\n\n重点研究：\n\n1. 如何把长期任务的权威状态持久化；\n2. 如何区分任务状态、模型上下文、记忆和执行日志；\n3. 如何实现检查点、断点恢复和跨会话继续执行；\n4. 如何处理任务暂停、取消、超时和用户中断；\n5. 如何防止恢复时重复执行有副作用的操作；\n6. 如何管理部分成功、部分失败和结果未知的节点；\n7. 如何在工具或模型版本变化后判断原任务能否继续；\n8. 如何恢复 DAG、ReAct 循环与多专家协作的中间状态；\n9. 如何在 Android、本地电脑和微型 Linux 主机之间处理设备能力差异；\n10. 如何让离线任务安全排队，并在连接恢复后继续；\n11. 如何验证恢复后的任务状态与实际文件、工具和外部服务一致；\n12. 如何在任务恢复后继续使用正确的记忆、上下文和资源预算。\n\n本专项的核心原则是：\n\n**恢复任务时，优先恢复可验证的执行状态，而不是仅凭历史聊天重新猜测发生了什么。**\n\n完成 LTAR 后，EvoAgent 的长任务执行、异常恢复和跨会话连续性就会有更明确的架构基础。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"request_id":"0a6f3104-b757-423c-95d1-63c19c20061a","message_type":"next","turn_exchange_id":"0d9bb346-4a16-4dcb-9d41-7778ec0933d0","working_turn_id":"0d9bb346-4a16-4dcb-9d41-7778ec0933d0","model_slug":"gpt-6","default_model_slug":"gpt-6","can_save":true,"parent_id":"e69684ed-0141-4f8c-93fd-1d891b61878a","logical_answer_prefix_activity":{"visibility":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"},{"id":"bbb21590-9646-489f-9d0d-1b969db715c8","author":{"role":"user","name":null,"metadata":{}},"create_time":1792504133.836829,"update_time":1792504369.42866,"content":{"content_type":"text","parts":["继续"]},"status":"finished_successfully","end_turn":null,"weight":1.0,"metadata":{"model_slug":"gpt-6","default_model_slug":"gpt-6","is_visually_hidden_from_conversation":false,"search_result_groups":[],"search_queries":[],"image_results":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","real_time_audio_has_video":false,"system_hints":[],"dictation":false,"voice_mode_message":false,"trigger_async_ux":false,"writing_blocks":{},"request_id":"47673be7-42a0-494a-a719-ac0d63e585fa","message_source":null,"turn_exchange_id":"b65bdf5f-f4ad-4e03-8380-300769603169","working_turn_id":"b65bdf5f-f4ad-4e03-8380-300769603169","can_save":false},"recipient":"all","channel":null},{"id":"837633b4-dc46-49cb-a863-40f225574132","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792504333.720401,"update_time":1792504333.741251,"content":{"content_type":"reasoning_recap","content":"思考了 3m 18s"},"status":"finished_successfully","end_turn":false,"weight":1.0,"metadata":{"reasoning_status":"reasoning_ended","finished_duration_sec":198,"reasoning_start_time":1792504134.5840442,"reasoning_end_time":1792504333.4815726,"reasoning_recap_type":"hide_all","cot_version":"v5","reasoning_group_id":"02ba9d0c-e505-4be7-bd82-f73643c68ecc","conversation_followup_suggestions_eligible":false,"request_id":"47673be7-42a0-494a-a719-ac0d63e585fa","message_type":"next","turn_exchange_id":"b65bdf5f-f4ad-4e03-8380-300769603169","working_turn_id":"b65bdf5f-f4ad-4e03-8380-300769603169","model_slug":"gpt-6","default_model_slug":"gpt-6","can_save":false,"parent_id":"20b6cc51-8e41-4a96-93db-cb1db963bc46","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"60fecb7a-02c3-4e5f-812d-1a91517c1229","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792504137.888872,"update_time":1792504349.887581,"content":{"content_type":"text","parts":["# EvoAgent 第四十一专项：长期任务自治、执行恢复与跨会话连续性\n\n本轮解决 EvoAgent 从“能够执行复杂任务”走向“能够持续执行复杂任务，并在中断后可靠恢复”的问题。\n\n对个人使用的 EvoAgent 来说，这一点非常重要。你的部署方向是手机优先，同时允许个人电脑或微型 Linux 主机承担更多计算与服务能力。设备可能休眠、应用可能被系统回收、网络可能断开，云端生成服务也可能临时不可用。\n\n因此，**长期任务不能依赖一个一直运行的模型会话，而必须建立在持久化任务状态、可恢复执行记录和经过验证的产物之上。**\n\n例如，一项 60 秒 AI 漫剧制作任务可能需要数小时，包含剧本、角色设计、分镜、素材生成、配音、视频合成和质量验收。\n\n如果在视频合成阶段发生断电，系统恢复后必须知道：\n\n- 哪些节点已经完成；\n- 哪些产物已经保存；\n- 哪些产物对应哪个版本的分镜；\n- 哪个节点正在执行；\n- 哪些外部生成请求的结果尚不确定；\n- 哪些操作可以安全重试；\n- 哪些验收需要重新执行。\n\n如果系统只是读取最后一段聊天记录，就无法可靠回答这些问题。\n\n本专项建议定义为：\n\n**Long-Horizon Task Autonomy & Recovery，简称 LTAR。**\n\n它负责长期任务状态持久化、检查点、断点恢复、执行一致性、跨会话连续性、取消与暂停、离线排队及恢复后的状态核验。\n\n## 一、第一性原理：恢复的对象是任务状态，不是聊天记录\n\n首先要区分五类数据。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box gap={1}>\n    <title size=\"md\">1. 任务状态</title>\n    <text color=\"secondary\" size=\"sm\">目标、约束、DAG 节点状态、依赖关系、进度、预算、暂停原因和恢复策略。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">2. 执行日志</title>\n    <text color=\"secondary\" size=\"sm\">发生了什么、何时发生、调用了什么工具、返回了什么结果、出现了什么异常。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">3. 产物与检查点</title>\n    <text color=\"secondary\" size=\"sm\">代码文件、视频片段、素材、测试报告、中间文件及其版本和完整性信息。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">4. 模型上下文</title>\n    <text color=\"secondary\" size=\"sm\">某次调用使用的上下文快照、检索知识、摘要版本和来源引用。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">5. 长期记忆与经验</title>\n    <text color=\"secondary\" size=\"sm\">可跨任务复用的用户偏好、项目知识、已验证经验和专家策略。</text>\n  </box>\n</box>\n\n这五类数据相互关联，但不能互相替代。\n\n例如，日志记录了“FFmpeg 执行成功”，并不代表最终视频文件完整、已经持久化或通过质量验收。\n\n同样，模型上下文中写着“已经生成全部镜头”，也不能代替对真实素材文件的检查。\n\n因此，LTAR 的首要原则是：\n\n**以持久化任务状态为执行依据，以真实产物和可验证证据确认状态，以日志解释发生过什么。**\n\n---\n\n# 二、建立任务状态机：每个任务必须处于明确状态\n\n建议将长期任务设计成显式状态机，而不是用一段不断增长的文本描述进度。\n\n任务级状态建议包括：\n\n| 状态 | 含义 |\n|---|---|\n| `CREATED` | 任务已创建，尚未开始执行 |\n| `READY` | 前置条件满足，可以调度 |\n| `RUNNING` | 正在执行 |\n| `WAITING` | 等待用户、设备、服务或外部条件 |\n| `PAUSING` | 正在安全地暂停 |\n| `PAUSED` | 已暂停，状态已经持久化 |\n| `RECOVERING` | 正在核对状态并恢复 |\n| `CANCELLING` | 正在取消并处理正在执行的操作 |\n| `COMPLETED` | 任务已通过规定的最终验收 |\n| `PARTIAL` | 产生了可交付的部分结果，但目标尚未全部完成 |\n| `FAILED` | 任务无法继续，且没有自动恢复路径 |\n| `CANCELLED` | 任务已按取消流程终止 |\n\n这些状态必须有明确的合法转换规则。\n\n例如，`RUNNING → PAUSED` 不能只是将状态字段改成 `PAUSED`，还需要确保已经执行的步骤、产物引用和未完成操作的状态得到持久化。\n\n`COMPLETED` 也不能只因为所有 DAG 节点都显示成功就自动设置。如果任务定义要求最终验收，那么最终验收必须通过。\n\n## 2.1 任务状态与节点状态分开管理\n\n一个长期任务可能包含几十个 DAG 节点。即使整体任务处于 `RUNNING`，某些节点也可能已经完成，另一些正在执行，还有一些因依赖关系而等待。\n\n建议节点状态至少包括：\n\n- `PENDING`：尚未开始；\n- `READY`：依赖已满足；\n- `RUNNING`：正在执行；\n- `SUCCEEDED`：执行结果已通过节点验收；\n- `RETRY_WAIT`：等待重试；\n- `BLOCKED`：被前置条件或外部条件阻塞；\n- `UNKNOWN`：无法确认执行是否产生了结果；\n- `FAILED`：节点失败；\n- `CANCELLED`：节点已取消；\n- `SKIPPED`：经规则允许而跳过。\n\n其中，`UNKNOWN` 非常重要。\n\n如果远程视频生成请求已经提交，但网络在返回结果前断开，系统不能简单地将节点标记为失败并再次提交，因为第一次请求可能仍然在运行，甚至已经完成并产生费用。\n\n必须先进行状态核验，再决定是否重试。\n\n---\n\n# 三、任务检查点：把可以恢复的状态保存下来\n\n检查点（Checkpoint）不是简单地保存一段摘要，而是记录一个任务在特定时刻能够被恢复所需要的最小充分状态。\n\n建议定义 `TaskCheckpoint`，包含以下内容：\n\n| 字段 | 用途 |\n|---|---|\n| `checkpoint_id` | 检查点唯一标识 |\n| `task_id` | 所属任务 |\n| `checkpoint_sequence` | 检查点顺序号 |\n| `task_state_version` | 对应的任务状态版本 |\n| `dag_version` | 当前任务 DAG 版本 |\n| `completed_nodes` | 已完成节点及验收结果引用 |\n| `active_nodes` | 正在执行或结果尚不确定的节点 |\n| `pending_nodes` | 尚未执行的节点 |\n| `artifact_refs` | 已持久化产物及其版本、哈希 |\n| `budget_snapshot` | 已消耗和剩余预算 |\n| `external_operation_refs` | 外部操作的关联 ID 与核验状态 |\n| `context_refs` | 必要的上下文快照引用 |\n| `created_at` | 检查点创建时间 |\n\n检查点应引用已有日志、产物和上下文，而不是把所有内容重复复制进去。\n\n## 3.1 哪些时刻应该创建检查点？\n\n建议至少覆盖以下情况：\n\n- 任务正式开始执行前；\n- 一个重要 DAG 节点完成并通过验收后；\n- 即将启动高成本或长时间运行的操作前；\n- 外部副作用执行后，获得可验证结果时；\n- 任务暂停或进入等待状态前；\n- 应用主动退出或服务计划重启前；\n- 资源预算接近阶段性上限时；\n- 系统完成恢复并确认新的权威状态后。\n\n对于高成本任务，检查点可以更频繁；对于简单、可快速重建的任务，则不需要过度保存。\n\n**检查点频率应该由恢复成本、数据丢失风险和存储开销共同决定。**\n\n## 3.2 检查点必须具备一致性\n\n假设一个节点执行了以下操作：\n\n1. 生成视频片段；\n2. 将片段保存到文件；\n3. 写入素材数据库；\n4. 更新 DAG 节点状态。\n\n如果系统只完成了第 2 步就突然断电，恢复后可能出现文件存在、数据库没有记录的情况。\n\n因此，检查点需要与产物持久化、数据库状态更新和日志记录协调。\n\n对于同一台设备上的本地任务，可以通过事务、临时文件、原子替换和校验等机制提高一致性。对于跨设备或跨服务的任务，通常无法依靠单个数据库事务保证所有操作同时成功，需要使用操作记录、幂等机制、补偿操作和恢复核验。\n\n---\n\n# 四、执行恢复：恢复之前，先确定真实状态\n\n建议建立独立的 `RecoveryManager`，不让普通模型直接决定从哪一步继续。\n\n恢复流程如下。\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  {#each [\n    [\"1. 读取最后一个有效检查点\",\"验证检查点完整性、状态版本和引用是否有效。\"],\n    [\"2. 对账任务状态与日志\",\"检查检查点之后是否存在已经记录但尚未反映到状态中的事件。\"],\n    [\"3. 核验真实产物\",\"检查文件、数据库记录、测试报告和其他外部结果是否实际存在且完整。\"],\n    [\"4. 核验未决操作\",\"查询外部请求、工具调用和可能产生副作用的操作是否已经完成。\"],\n    [\"5. 修复状态差异\",\"通过安全的状态重建、幂等重试或补偿操作处理不一致。\"],\n    [\"6. 重建可执行 DAG\",\"重新计算节点依赖，识别可继续、需重试、被阻塞和结果未知的节点。\"],\n    [\"7. 恢复预算与上下文\",\"加载有效预算，按当前任务状态重新构建模型上下文。\"],\n    [\"8. 恢复调度\",\"只启动已经满足前置条件且允许执行的节点。\"]\n  ] as item}\n    <row align=\"start\" gap={3}>\n      <box background=\"surface-secondary\" radius=\"md\" minWidth=\"32px\" padding={2} align=\"center\">\n        <text weight=\"medium\" size=\"sm\">{item[0].split(\".\")[0]}</text>\n      </box>\n      <box flex=\"1\" gap={1}>\n        **{item[0].slice(item[0].indexOf(\" \") + 1)}**\n        <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n      </box>\n    </row>\n    {#if item[0]!==\"8. 恢复调度\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n恢复不是将历史上下文直接交给模型，然后让模型自由决定下一步。\n\n模型可以参与解释异常、建议修复路径或重新规划，但任务状态重建、权限检查和操作去重应由确定性机制负责。\n\n## 4.1 恢复后不一定从原节点继续\n\n恢复结果可以分为四种：\n\n- **直接继续：** 产物和节点状态都已经验证；\n- **重新执行：** 节点没有产生有效结果，且执行可安全重试；\n- **先核验：** 外部操作的执行结果不确定；\n- **局部重规划：** 原依赖或环境发生变化，旧计划已不再适用。\n\n例如，视频生成节点的请求已经成功，但本地没有下载完成的素材。恢复后应优先尝试获取已有生成结果，而不是重新生成视频。\n\n相反，如果本地 FFmpeg 合成任务未完成、临时文件已损坏，且该节点没有不可逆外部副作用，则可以清理无效临时产物并重新执行合成。\n\n---\n\n# 五、幂等与副作用治理：防止恢复造成重复执行\n\n这是长期任务可靠性的核心问题。\n\n对于普通的本地计算，重复执行可能只增加成本；对于远程生成、付费 API、发送消息、发布文件或修改数据库，重复执行可能产生重复费用或不可逆后果。\n\n建议建立统一的 `OperationLedger`，记录每个可能产生副作用的操作。\n\n每项操作至少记录：\n\n- `operation_id`：稳定的操作标识；\n- `task_id` 和 `node_id`；\n- `idempotency_key`：服务支持时使用的幂等键；\n- `request_digest`：请求内容摘要；\n- `status`：待提交、已提交、执行中、成功、失败或结果未知；\n- `external_operation_id`：外部服务返回的操作标识；\n- `result_ref`：结果引用；\n- `retry_policy`：允许的重试规则；\n- `last_verified_at`：最后一次状态核验时间。\n\n## 5.1 区分三种操作\n\n| 类型 | 示例 | 恢复策略 |\n|---|---|---|\n| 可重复执行 | 本地只读分析、确定性计算 | 满足条件时可以安全重跑 |\n| 可幂等执行 | 使用相同幂等键提交的受支持请求 | 由服务端保证重复请求不会产生重复效果时，可按契约重试 |\n| 非幂等或结果不明 | 不支持幂等的付费生成、发送消息、外部发布 | 先查询状态或核验结果，必要时请求人工判断 |\n\n这里不能假设所有服务都支持幂等键，也不能假设提供幂等键就一定覆盖所有业务副作用。必须根据具体服务的契约确定其有效范围和保留时间。\n\n## 5.2 不要承诺无法保证的“恰好执行一次”\n\n在分布式系统中，如果请求已经发出，但客户端在收到结果前断线，客户端可能无法判断远端是否完成了操作。\n\n因此，通用系统不能仅依靠本地状态实现所有外部操作的“恰好一次执行”。\n\n更现实的设计是：\n\n- 对可重复操作采用至少一次执行并确保幂等；\n- 对支持幂等键的服务使用稳定的请求标识；\n- 对结果未知的操作优先查询或核验；\n- 对无法核验且重复执行风险较高的操作暂停并请求判断；\n- 对跨系统的部分成功情况提供补偿或人工恢复路径。\n\n**目标不是假装不会出现不确定状态，而是让不确定状态能够被发现、隔离和安全处理。**\n\n---\n\n# 六、任务暂停、取消与中断：三者必须区分\n\n暂停、取消和进程中断并不是同一种情况。\n\n## 6.1 暂停：保留继续执行的能力\n\n暂停意味着任务暂时不再启动新的执行步骤，但保留已完成的工作和后续恢复所需的状态。\n\n建议流程：\n\n1. 停止派发新的节点；\n2. 对正在执行的节点执行安全暂停或等待策略；\n3. 记录无法立即停止的操作；\n4. 持久化任务状态、产物引用和预算；\n5. 确认检查点有效；\n6. 将任务标记为 `PAUSED`。\n\n对于无法中断的外部操作，暂停并不意味着远端任务已经停止。系统必须记录其真实状态，并在恢复时继续核验。\n\n## 6.2 取消：停止后续工作并处理副作用\n\n取消意味着用户不再希望继续原任务。\n\n取消流程应当：\n\n- 停止启动新的节点；\n- 向支持取消的工具或服务发送取消请求；\n- 等待或核验正在运行的操作；\n- 保留已完成产物；\n- 清理允许清理的临时文件；\n- 对必要的部分成功操作执行补偿；\n- 持久化取消结果。\n\n取消请求不能保证所有外部操作都能撤销。例如，已经发送的邮件可能无法撤回，已经完成的云端生成也可能已经产生费用。\n\n因此，系统需要区分“任务取消成功”和“所有副作用均已撤销”。\n\n## 6.3 进程意外中断：由恢复管理器接管\n\n应用被系统回收、设备重启或服务崩溃时，可能完全来不及执行暂停流程。\n\n此时不能假设最后一次正常保存的状态就是实际执行状态。\n\n恢复管理器必须通过检查点、日志、操作记录和真实产物进行对账，再决定继续、重试、等待或停止。\n\n---\n\n# 七、跨会话连续性：新会话应该接管任务，而不是重新猜测任务\n\n用户可能今天启动一个复杂任务，明天再继续；也可能在手机上查看进度，在个人电脑上执行重计算任务。\n\n建议将长期任务设计成独立于聊天会话的持久化实体。\n\n也就是说：\n\n- 聊天会话负责交互；\n- 任务 ID 负责标识长期工作；\n- 任务状态保存执行进度；\n- 检查点支持恢复；\n- 记忆与上下文引用支持理解历史；\n- 产物仓库保存实际成果。\n\n当用户开启新会话并选择继续某项任务时，系统应当根据任务 ID 恢复其状态，而不是把新会话当作一个全新任务。\n\n## 7.1 建立 `TaskResumeContext`\n\n建议恢复时向模型提供一份专门的恢复摘要，包含：\n\n- 当前任务目标；\n- 当前有效约束；\n- 最后一个有效检查点；\n- 已验收的成果；\n- 尚未完成的节点；\n- 结果未知的操作；\n- 当前预算与剩余预算；\n- 已知风险；\n- 恢复后建议的下一步；\n- 需要用户确认的事项。\n\n这份摘要由权威任务状态和相关证据构建，不应仅从聊天历史自动生成。\n\n模型可以使用它理解任务，但实际调度仍由任务协调器和恢复管理器控制。\n\n## 7.2 任务计划变更必须有版本\n\n如果用户在第二天修改了需求，不能直接把旧任务的目标字段覆盖掉。\n\n建议建立版本化变更记录：\n\n- 旧目标和旧约束；\n- 新目标和新增、删除或修改的约束；\n- 已完成产物是否仍然适用；\n- 哪些 DAG 节点需要重跑；\n- 哪些节点可以继续复用；\n- 预算和验收标准是否需要重新确认。\n\n例如，用户将视频时长从 60 秒改为 90 秒，不代表剧本、角色素材和所有已完成镜头都必须丢弃。但分镜、配音、合成和最终验收可能需要重新规划。\n\n系统应该根据依赖图进行局部失效分析，而不是无条件从头执行。\n\n---\n\n# 八、手机、个人电脑与微型 Linux 主机：全局任务状态，本地能力执行\n\n结合你此前确定的手机优先战略，以及个人电脑、微型 Linux 主机作为后续执行设备的方向，建议 LTAR 采用设备能力与任务状态分离的架构。\n\n核心原则是：\n\n**任务可以跨会话恢复；具体执行能力由当前设备和可用服务决定。**\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box gap={1}>\n    <title size=\"md\">Android 手机</title>\n    <text color=\"secondary\" size=\"sm\">创建任务、查看进度、审批操作、轻量执行、保存本地状态，以及在系统允许时调度后台工作。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">个人电脑</title>\n    <text color=\"secondary\" size=\"sm\">适合代码项目、大文件处理、复杂工具执行、本地模型和需要较高计算资源的任务。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">微型 Linux 主机</title>\n    <text color=\"secondary\" size=\"sm\">适合长期运行的任务协调器、状态数据库、日志接收、轻量模型和后台调度，具体能力取决于硬件。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">可选云端服务</title>\n    <text color=\"secondary\" size=\"sm\">承担已授权的远程模型推理、素材生成或其他外部任务；其状态必须独立核验。</text>\n  </box>\n</box>\n\n这些设备不需要各自维护互相矛盾的任务真相。\n\n如果采用多设备部署，应明确一个任务状态的权威写入者，或者使用具备事务和冲突解决机制的协调服务。不能让手机和 Linux 主机各自修改同一个任务状态，却没有版本检查。\n\n## 8.1 设备离线时的处理\n\n如果手机与主机断联：\n\n- 手机可以继续查看已经同步的状态；\n- 允许在本地创建离线任务草稿；\n- 已有授权的本地任务可以按策略继续；\n- 需要主机或云端能力的节点进入等待状态；\n- 恢复连接后，通过任务 ID、事件序号和版本信息同步状态。\n\n离线期间的状态不应直接覆盖主机上更新的权威状态。\n\n对于冲突的任务修改，需要通过版本比较和明确的冲突解决规则处理。\n\n## 8.2 Android 后台执行需要遵守平台限制\n\n手机应用可能受到后台运行、耗电优化、进程回收和网络限制的影响。\n\n因此，不能承诺 Android 应用在任何情况下都可以无限期后台执行。\n\n对于长时间任务，更可靠的方案是将执行安排在具备持续运行能力的主机或服务上，手机主要负责控制和观察；纯本地手机任务则应根据系统支持的后台任务机制、持久化和恢复策略设计。\n\n---\n\n# 九、离线队列与恢复同步：连接恢复后如何避免重复工作？\n\nLTAR 需要与此前设计的日志同步、设备关联和断点恢复机制共同工作。\n\n建议建立本地持久化的 `TaskEventOutbox`，记录尚未同步的任务事件。\n\n每条事件至少包括：\n\n- `event_id`：全局唯一事件 ID；\n- `task_id`：所属任务；\n- `device_id`：事件产生设备；\n- `sequence_number`：设备或任务内的单调递增序号；\n- `base_state_version`：事件基于哪个任务状态版本产生；\n- `event_type`：节点完成、任务暂停、产物生成、操作结果等；\n- `payload_ref`：事件数据或产物引用；\n- `created_at`：事件产生时间；\n- `sync_status`：待同步、已确认或冲突待处理。\n\n## 9.1 推荐同步流程\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  {#each [\n    [\"本地记录事件\",\"执行状态先持久化到本地，再进入待同步队列。\"],\n    [\"建立连接\",\"确认目标服务身份、任务权限和同步协议版本。\"],\n    [\"上传未确认事件\",\"按序号和事件 ID 发送，允许断线后继续上传。\"],\n    [\"服务端去重与校验\",\"识别重复事件，验证状态版本、权限和事件合法性。\"],\n    [\"返回确认与冲突\",\"确认已接收的事件，并明确返回无法自动合并的冲突。\"],\n    [\"核对权威状态\",\"设备比较本地与权威状态，重建必要的任务状态。\"],\n    [\"恢复调度\",\"只有在依赖、产物和外部操作状态核验后才继续执行。\"]\n  ] as item}\n    <row align=\"start\" gap={3}>\n      <box background=\"surface-secondary\" radius=\"md\" minWidth=\"30px\" padding={2} align=\"center\">\n        <text weight=\"medium\" size=\"sm\">{item[0].split(\" \")[0]}</text>\n      </box>\n      <box flex=\"1\" gap={1}>\n        **{item[0]}**\n        <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n      </box>\n    </row>\n    {#if item[0]!==\"恢复调度\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n## 9.2 日志同步不等于任务状态合并\n\n日志通常是追加式的，比较容易通过唯一事件 ID 去重。\n\n任务状态则可能包含互相冲突的更新。例如，手机离线时将任务标记为暂停，而主机在此期间完成了一个节点。\n\n系统不能简单采用“最后写入者获胜”，因为设备时间可能不一致，较晚到达的事件也不一定代表更权威的状态。\n\n建议：\n\n- 使用服务端状态版本或明确的版本比较机制；\n- 对任务状态变化执行合法性检查；\n- 对可自动合并的独立字段使用明确规则；\n- 对互相矛盾的关键状态进入冲突处理；\n- 对权限、预算和不可逆操作保留更严格的协调机制。\n\n如果只是日志上传成功，但任务状态仍存在冲突，系统不应该自动恢复可能产生副作用的节点。\n\n---\n\n# 十、产物版本与依赖失效：任务恢复不意味着所有旧成果都能复用\n\n长期任务通常会产生大量中间成果。\n\n例如，代码任务可能产生补丁、测试报告和构建产物；AI 漫剧任务可能产生剧本、分镜、角色图、音频、视频片段和最终视频。\n\n每项产物都应该具备：\n\n- 稳定的 `artifact_id`；\n- 版本或内容哈希；\n- 生成它的任务和节点；\n- 输入产物引用；\n- 工具或模型版本；\n- 生成状态；\n- 验收状态；\n- 文件位置或存储引用。\n\n## 10.1 使用依赖图判断哪些成果需要重建\n\n假设视频制作 DAG 为：\n\n剧本 → 分镜 → 视频镜头 → 配音 → 合成 → 最终验收。\n\n如果用户只修改了字幕字体，系统可能只需要重新执行合成和最终验收，而不必重新生成视频镜头。\n\n如果角色设定发生变化，则可能需要使依赖该角色设定的分镜、镜头和相关合成节点失效。\n\n建议通过输入版本和依赖关系建立产物有效性判断。\n\n某个节点的旧结果只有在以下条件满足时才可复用：\n\n- 输入版本仍然匹配；\n- 工具契约兼容；\n- 任务约束没有改变其适用性；\n- 产物完整且可访问；\n- 必要验收仍然有效。\n\n如果无法证明旧结果仍然有效，就应重新验证或重建，而不是盲目复用。\n\n---\n\n# 十一、长期任务的可观测性：如何知道恢复机制本身有没有出错？\n\nLTAR 也需要独立评测，不能只检查任务最终是否完成。\n\n建议建立以下指标：\n\n| 指标 | 含义 |\n|---|---|\n| 恢复成功率 | 中断后能够恢复到正确可执行状态的比例 |\n| 恢复时间 | 从启动恢复到重新进入可执行状态的耗时 |\n| 重复执行率 | 因恢复逻辑错误导致的重复操作比例 |\n| 状态不一致率 | 任务状态与真实产物、外部操作状态不一致的比例 |\n| 检查点恢复损失 | 中断后需要重做的有效工作量 |\n| 产物复用率 | 在有效性确认后成功复用已有产物的比例 |\n| 冲突处理准确率 | 设备间状态冲突被正确识别与解决的比例 |\n| 未决操作处理质量 | 结果未知的外部操作是否被安全核验 |\n| 预算恢复准确率 | 恢复后剩余预算是否与真实消耗一致 |\n| 取消与暂停正确性 | 任务暂停或取消后是否仍出现不应发生的操作 |\n\n## 11.1 建立故障注入测试\n\n建议在隔离环境中主动模拟：\n\n- 写入检查点前后突然断电；\n- 产物保存成功但数据库更新失败；\n- 数据库更新成功但日志同步失败；\n- 外部请求成功但响应丢失；\n- 手机与主机在不同节点上同时更新状态；\n- 恢复时发现工具版本已经变化；\n- 任务预算在暂停期间发生调整；\n- 取消请求到达时，外部操作仍在执行；\n- 产物文件存在但内容不完整；\n- 检查点引用的某个文件已经被删除。\n\n每种故障都需要预期结果和验收标准。\n\n例如，模拟外部请求成功但响应丢失时，正确结果不一定是自动重试，而可能是先查询外部操作状态，确保不会重复扣费。\n\n---\n\n# 十二、建议冻结的架构决策\n\n以下是建议纳入 EvoAgent 全量架构的 LTAR 治理基线。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"ADR-501\",\"任务状态独立于聊天会话\",\"长期任务使用稳定的 task_id 标识，聊天会话只承担交互与任务入口职责。\"],\n    [\"ADR-502\",\"建立显式任务状态机\",\"明确创建、就绪、运行、等待、暂停、恢复、取消、完成、部分完成与失败等状态。\"],\n    [\"ADR-503\",\"任务状态与 DAG 节点状态分离\",\"任务级状态管理总体生命周期，节点级状态管理依赖、执行和验收。\"],\n    [\"ADR-504\",\"结果未知必须显式表示\",\"外部请求断联或执行结果无法确认时，不得直接假定成功或失败。\"],\n    [\"ADR-505\",\"检查点必须具备可恢复性\",\"检查点记录状态版本、节点状态、产物引用、预算和未决操作。\"],\n    [\"ADR-506\",\"检查点与产物持久化协调\",\"通过事务、原子写入、校验和恢复核验处理部分成功。\"],\n    [\"ADR-507\",\"恢复前必须核验真实状态\",\"对账检查点、日志、文件、数据库与外部操作状态后才能恢复调度。\"],\n    [\"ADR-508\",\"恢复管理器负责确定性状态重建\",\"模型可以辅助诊断和重新规划，但不能直接覆盖权威任务状态。\"],\n    [\"ADR-509\",\"建立统一操作账本\",\"为可能产生副作用的操作记录稳定 ID、幂等键、请求摘要、外部结果和重试规则。\"],\n    [\"ADR-510\",\"重试策略必须基于操作契约\",\"区分可重复、可幂等和结果未知的操作，不承诺无法保证的恰好执行一次。\"],\n    [\"ADR-511\",\"暂停、取消和意外中断分别处理\",\"三种情况使用不同的停止、持久化、补偿和恢复流程。\"],\n    [\"ADR-512\",\"跨会话恢复依赖权威任务状态\",\"通过 task_id 恢复状态与必要上下文，不依靠历史聊天猜测进度。\"],\n    [\"ADR-513\",\"任务计划变更必须版本化\",\"记录新旧目标、约束、依赖失效和需要重新验收的产物。\"],\n    [\"ADR-514\",\"跨设备任务需要明确的状态协调权\",\"禁止无协调机制的多设备竞争写入权威任务状态。\"],\n    [\"ADR-515\",\"离线事件采用持久化 Outbox\",\"通过事件 ID、序号、状态版本和确认机制支持断线续传与去重。\"],\n    [\"ADR-516\",\"日志同步与任务状态合并分离\",\"日志可以去重追加，任务状态必须经过合法性检查和冲突治理。\"],\n    [\"ADR-517\",\"产物必须具有版本与依赖引用\",\"通过输入版本、工具契约和验收状态判断已有成果能否复用。\"],\n    [\"ADR-518\",\"取消不等于所有副作用均已撤销\",\"必须分别记录任务终止、远程操作停止和补偿结果。\"],\n    [\"ADR-519\",\"恢复过程纳入统一可观测性\",\"记录恢复决策、状态差异、未决操作、资源变化和最终恢复结果。\"],\n    [\"ADR-520\",\"通过故障注入独立验证恢复能力\",\"在发布前验证断电、断网、部分成功、重复事件和状态冲突等场景。\"]\n  ] as item}\n    <box gap={1}>\n      <row align=\"center\" gap={2}>\n        <badge>{item[0]}</badge>\n        <title size=\"md\">{item[1]}</title>\n      </row>\n      <text color=\"secondary\" size=\"sm\">{item[2]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些是建议纳入 EvoAgent 全量架构的长期任务治理基线。正式实施时，还需要定义任务状态 Schema、检查点协议、恢复算法、操作账本、事件同步协议、产物依赖模型和故障注入测试集。\n\n---\n\n# 十三、下一专项：任务并发、资源隔离与多任务协同调度\n\nLTAR 解决了长期任务如何保存、暂停和恢复，但还存在一个自然延伸的问题：\n\n**如果 EvoAgent 同时运行多个任务、多个专家和多个工具，如何避免任务相互干扰、争抢资源、覆盖文件或耗尽预算？**\n\n例如，EvoAgent 可能同时执行：\n\n- 一个大型代码重构；\n- 一个 AI 漫剧视频合成任务；\n- 一个后台知识整理任务；\n- 一个等待外部服务恢复的远程生成任务。\n\n如果这些任务共享同一台个人电脑或微型 Linux 主机，就会出现 CPU、内存、GPU、磁盘、模型调用配额和外部服务预算之间的竞争。\n\n如果多个任务修改同一个项目，还可能发生文件覆盖、基于过期代码生成补丁，或者一个任务清理了另一个任务仍在使用的临时文件。\n\n下一专项建议定义为：\n\n**Multi-Task Scheduling, Resource Isolation & Coordination，简称 MTSRIC。**\n\n重点研究：\n\n1. 如何决定多个任务的执行优先级；\n2. 如何为任务、专家、工具和模型调用分配资源；\n3. 如何防止多个任务争抢同一设备资源；\n4. 如何识别任务之间的文件、数据库和产物冲突；\n5. 如何在 DAG 内部并行执行，同时保持正确的依赖顺序；\n6. 如何在多个长期任务之间分配 CPU、GPU、内存、磁盘和网络；\n7. 如何隔离不同任务的工作目录、临时文件、记忆和执行状态；\n8. 如何管理共享模型服务与外部 API 配额；\n9. 如何在高优先级任务到来时暂停或让出资源；\n10. 如何防止一个失败任务反复重试，拖垮其他任务；\n11. 如何跨手机、个人电脑和微型 Linux 主机调度可迁移任务；\n12. 如何在资源不足时选择排队、降级、暂停或终止；\n13. 如何保证任务隔离不破坏专家之间必要的知识共享；\n14. 如何通过并发、冲突和资源压力测试验证调度质量。\n\n它将连接 LTAR、ARCBG、DAG 执行器、工具运行时、设备能力注册表和任务状态协调机制。\n\n最终目标是：\n\n**让 EvoAgent 不仅能可靠完成一个长期任务，还能在有限的个人设备资源下，安全、可预测地协调多个长期任务。**"]},"status":"finished_successfully","end_turn":true,"weight":1.0,"metadata":{"is_merged_message":true,"source_message_ids":["e5b9b300-310a-482c-87cd-69b6872e2986","94d7b412-5ce5-4695-861b-52f39d8b79c0","3400889b-35ad-453e-8474-566131be170c","de68eb84-607a-4409-b61f-27d66a13e3e7","20b6cc51-8e41-4a96-93db-cb1db963bc46","d4141809-b1ea-4106-b4ba-caff4966020e"],"continuation_message_id":"d4141809-b1ea-4106-b4ba-caff4966020e","model_dil_v2":{"code":"function __dilSafe(evaluate,failureValue){try{return evaluate()}catch{return failureValue}}\n\nDIL.render(__dil.jsx(()=>{const __dilConstants=DIL.useConstants();const __dilModelDataBindings=DIL.useAppData((appData)=>appData.opGenui?.modelDataBindings??{});return __dil.jsx(__dil.Fragment,null,__dil.jsx(\"title\",{\"size\":\"xl\"},__dilConstants[\"0\"]),__dil.jsx(\"text\",null,__dilConstants[\"1\"]),__dil.jsx(\"text\",null,__dilConstants[\"2\"]),__dil.jsx(\"text\",null,__dilConstants[\"3\"],__dil.jsx(\"bold\",null,__dilConstants[\"4\"])),__dil.jsx(\"text\",null,__dilConstants[\"5\"]),__dil.jsx(\"text\",null,