ext\",null,__dilConstants[\"584\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"585\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"586\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"587\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"588\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"589\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"590\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"591\"]))),__dil.jsx(\"text\",null,__dilConstants[\"592\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"593\"])),__dil.jsx(\"text\",null,__dilConstants[\"594\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第五十四专项：可靠性工程、故障注入与恢复保证","1":"RERA · Reliability Engineering & Recovery Assurance","2":"前面已经完成了几个重要的基础设计：","3":"MEODT：多专家协作与动态组队；","4":"GECO：全局事件、运行追踪与因果证据；","5":"TSEG：安全边界、信任体系与自进化治理。","6":"现在要解决的是一个更贴近实际运行的问题：","7":"当 EvoAgent 长时间运行、执行复杂任务、调用外部工具，甚至在任务中途遭遇断电、崩溃或断网时，怎样保证它不会丢失关键进度、重复执行危险操作，或者在恢复过程中制造新的故障？","8":"这里有一个重要区别。","9":"普通应用的可靠性，主要关注程序是否崩溃、数据是否丢失、服务是否可用。","10":"EvoAgent 的可靠性还必须考虑智能体自身的行为：它可能错误地判断任务已经完成，可能无限重试，可能恢复一个已经失效的计划，也可能在上游结果变化后继续使用旧的下游产物。","11":"因此，RERA 不应只是增加异常捕获、重试和日志，而应建立一套完整的","12":"任务可靠性状态机、故障分类、恢复协议、故障注入测试和可靠性评测体系","13":"。","14":"一、第一性原理：失败不可避免，但失控可以被限制","15":"设想一个真实的 AI 漫剧制作任务。","16":"编剧、分镜、视觉生成已经完成，配音服务也已返回结果。此时 Linux 主机突然断电。","17":"重新启动后，系统面临几个问题：","18":"哪些工作已经真正完成？","19":"哪些产物已经写入磁盘？","20":"哪些产物虽然生成了，但尚未记录完成事件？","21":"视频合成是否已经启动？","22":"如果外部服务已经扣费，但本地没有收到响应，是否应该再次调用？","23":"当前工作流使用的角色设定是否已经发生变化？","24":"哪些任务可以直接恢复，哪些必须重新执行？","25":"如果关键状态无法确认，应该继续、等待还是终止？","26":"如果系统只保存一个“任务进度 70%”的数值，这些问题都无法可靠回答。","27":"因此，RERA 的第一条原则是：","28":"恢复必须依据可验证的状态和产物，而不能仅依赖模型记忆、进度百分比或上一次的自然语言总结。","29":"1.1 将可靠性分为六个维度","30":"这六个维度需要分别评测。","31":"例如，一个任务最终成功了，不代表它的恢复机制可靠；它可能只是因为故障恰好没有影响最终产物。","32":"同样，恢复成功也不代表没有发生重复扣费、数据泄露或未经授权的外部操作。","33":"1.2 可靠性不能只看成功率","34":"假设两个版本的编程专家都完成了 95% 的任务。","35":"版本 A 在失败时能够准确报告问题，并从检查点恢复。","36":"版本 B 在失败时会反复执行修改命令，偶尔覆盖用户文件，还可能误报任务完成。","37":"它们的表面成功率相同，但工程可靠性显然不同。","38":"因此，RERA 必须同时评价正常执行和异常路径，尤其要关注失败后的行为。","39":"二、总体架构：建立统一的可靠性控制层","40":"建议建立 ","41":"RERA Reliability Control Plane","42":"，作为 EvoAgent 可靠性治理的统一控制层。","43":"它不替代 GECO 的事件记录，也不替代 LTAR 的任务生命周期管理，而是根据任务状态、故障类型、恢复策略和资源条件，决定如何安全地继续执行。","44":"任务执行层","45":"Router、Planner、DAG、ReAct、专家团队、技能和工具适配器。","46":"可靠性控制层 · RERA","47":"故障分类、重试决策、熔断、降级、恢复规划、可靠性预算和恢复验证。","48":"GECO","49":"提供事件、追踪、操作结果与证据。","50":"LTAR","51":"保存任务状态、检查点和生命周期。","52":"TERSO","53":"执行受控工具操作、取消与结果核验。","54":"SOCDEA","55":"分析根因，判断故障是否来自系统缺陷。","56":"恢复与验证","57":"检查点恢复、依赖重算、产物校验、回归测试、安全检查与最终验收。","58":"需要明确几个职责边界：","59":"GECO","60":" 记录实际发生的事情；","61":"LTAR","62":" 维护任务状态与检查点；","63":"RERA","64":" 决定采用什么恢复策略；","65":"TERSO","66":" 负责受控执行和操作结果核验；","67":"SOCDEA","68":" 诊断故障原因；","69":"UQEAG","70":" 验证恢复后的最终产物是否合格；","71":"TSEG","72":" 保证恢复行为不突破安全和授权边界。","73":"RERA 可以提出恢复方案，但不能自行放宽权限、绕过安全检查或宣称未经验证的结果已经成功。","74":"三、故障分类：不同故障必须采用不同处理策略","75":"很多智能体系统把所有异常都当作“再试一次”。","76":"这是不可靠的。","77":"例如，模型服务暂时超时，可能适合有限重试；但如果一个付费 API 请求已经提交，响应却丢失，再次发送可能产生第二笔费用。","78":"因此，建议建立统一的 ","79":"FailureTaxonomy","80":"。","81":"故障类型","82":"典型场景","83":"默认处理策略","84":"暂时性故障","85":"网络短暂中断、服务限流","86":"有界重试、退避等待","87":"永久性故障","88":"配置错误、缺失依赖、权限不足","89":"停止重试，修复配置或请求人工介入","90":"结果未知","91":"请求已发出但响应丢失","92":"查询实际状态或执行对账，不盲目重试","93":"数据与契约故障","94":"输出格式错误、输入版本不匹配","95":"校验、修复或重新生成","96":"状态一致性故障","97":"事件与实际产物不一致","98":"暂停相关节点，进行状态对账","99":"资源故障","100":"内存不足、磁盘写满、CPU 过载","101":"限流、释放资源、降级或暂停","102":"依赖故障","103":"上游产物变化、技能版本失效","104":"重新评估受影响的下游节点","105":"安全故障","106":"越权、授权撤销、安全校验失败","107":"阻断相关操作，执行安全响应","108":"智能体决策故障","109":"错误规划、循环、重复劳动","110":"停止当前策略，诊断并有限重规划","111":"质量故障","112":"最终产物不满足验收要求","113":"返工、局部重跑或终止交付","114":"这里的“默认处理”是建议策略，不是所有场景的绝对规则。最终行为还需要结合任务风险、操作可逆性、授权范围和剩余预算决定。","115":"3.1 区分三种最重要的执行结果","116":"对任何可能产生副作用的操作，系统都应能够区分：","117":"SUCCEEDED","118":"：执行成功，并且结果已经得到必要的核验；","119":"FAILED","120":"：有证据表明操作失败，且实际影响已知；","121":"UNKNOWN","122":"：无法确定操作是否成功或产生了什么影响。","123":"UNKNOWN","124":" 不是普通失败。","125":"例如，调用外部视频生成服务时，连接在提交请求后断开。服务可能已经接受请求并开始生成视频，也可能根本没有收到请求。","126":"此时不能直接认定失败并再次调用。","127":"应该先尝试使用请求 ID、服务端任务 ID 或其他可用证据查询状态。如果服务不支持状态查询，则需要根据费用风险和操作策略决定等待、人工确认或在明确接受重复风险后重试。","128":"未知状态必须成为系统的一等状态，而不是被强行归类为失败。","129":"四、重试机制：防止智能体陷入无限循环","130":"重试是必要能力，但无约束的重试会造成一系列问题：","131":"模型调用费用持续增加；","132":"同一个工具被反复调用；","133":"多个专家同时重试同一个失败节点；","134":"失败原因没有改变，结果却不断重复；","135":"自动恢复与人工取消相互冲突；","136":"上游失败引发整个 DAG 的重试风暴。","137":"建议建立 ","138":"RetryController","139":"，统一管理重试次数、等待策略、故障分类和任务级预算。","140":"4.1 重试必须满足准入条件","141":"每次重试前，至少检查：","142":"该故障是否属于允许重试的类型？","143":"前一次操作是否已经产生副作用？","144":"重试是否具有幂等保障？","145":"当前授权是否仍然有效？","146":"是否仍有足够的时间、资源和费用预算？","147":"前一次失败的原因是否可能已经改变？","148":"是否需要先执行状态核验或补偿操作？","149":"如果关键条件不满足，系统应暂停或终止，而不是为了追求任务完成率继续尝试。","150":"4.2 采用分层重试预算","151":"建议同时设置四种限制：","152":"预算层级","153":"限制对象","154":"防止的问题","155":"操作级","156":"单个工具调用","157":"同一操作无限重试","158":"节点级","159":"单个 DAG 节点","160":"某个子任务持续失败","161":"任务级","162":"整个任务","163":"多个节点共同消耗过多资源","164":"系统级","165":"同时运行的所有任务","166":"故障期间产生重试风暴","167":"预算需要相互约束。","168":"例如，某个工具还有一次重试额度，并不意味着任务已经达到费用上限后仍然允许重试。","169":"4.3 使用退避与抖动","170":"对于网络中断、限流等暂时性故障，可以使用指数退避。","171":"d_n=\\min(d_{\\max},d_0\\cdot 2^n)","172":"其中 ","173":"d_0","174":" 为初始等待时间，","175":"d_{\\max}","176":" 为等待上限。","177":"如果多个任务可能同时重试，还可以增加随机抖动，避免所有请求在同一时刻再次冲击故障服务。","178":"但退避不是通用解决方案。","179":"权限不足、输入契约错误、无效配置和安全阻断等故障，通常不应通过反复重试来解决。","180":"4.4 重规划也必须受限制","181":"智能体可能认为当前方案失败，于是重新规划；新方案再次失败，又重新规划。这样就会出现不断改变策略却始终无法完成任务的循环。","182":"建议分别设置：","183":"最大普通重试次数；","184":"最大重规划次数；","185":"最大连续无进展次数；","186":"最大返工轮数；","187":"最大总执行时间；","188":"最大任务成本。","189":"当同一问题连续出现、方案没有实质变化，或者连续多轮没有产生新的有效证据时，应触发熔断或转入诊断，而不是继续重复执行。","190":"4.5 重试必须记录原因","191":"每次重试都应在 GECO 中记录：","192":"前一次失败事件；","193":"当前故障分类；","194":"重试理由；","195":"采用的等待策略；","196":"是否进行了状态核验；","197":"使用的预算；","198":"重试后的结果；","199":"是否产生了新的副作用。","200":"这样，SOCDEA 才能判断重试是否真的提高了成功概率，还是只增加了成本。","201":"五、幂等性与副作用：恢复机制最容易出错的地方","202":"这是 RERA 最值得优先实现的部分。","203":"假设一个工具调用已经成功修改文件，但进程在记录成功事件前崩溃。系统重启后发现没有成功记录，于是再次执行同一个修改。","204":"如果工具操作是简单覆盖，也许结果没有变化；如果它是追加内容、提交代码、发送消息或创建付费任务，就可能造成重复副作用。","205":"5.1 建立操作级幂等协议","206":"建议为每个重要操作生成唯一的 ","207":"operation_id","208":"。","209":"执行器至少应维护：","210":"操作标识；","211":"请求内容摘要；","212":"目标资源；","213":"当前执行状态；","214":"已知的副作用；","215":"结果引用；","216":"是否允许安全重试；","217":"实际核验结果。","218":"当相同操作被重复请求时，执行器应先查询已有状态，而不是默认再次执行。","219":"对于支持幂等键的外部 API，应使用稳定的操作标识；对于不支持幂等的服务，则必须设计状态查询、人工确认或明确接受重复风险的策略。","220":"不能仅依赖客户端生成一个 ID，就宣称外部操作已经实现幂等。","221":" 真正的幂等保障还取决于执行器和目标系统如何处理重复请求。","222":"5.2 区分四种操作阶段","223":"建议使用以下状态：","224":"这里的 ","225":"FAILED_OR_UNKNOWN","226":" 在正式实现时建议拆分为两个独立状态，避免混淆。上面的分组只是展示概念。","227":"操作成功的判定标准应根据工具类型决定。例如：","228":"文件修改：核验目标文件内容或版本；","229":"代码提交：核验提交标识与远端状态；","230":"付费 API：核验请求 ID、任务状态或服务端账单记录；","231":"外部消息：核验服务端接受状态，不能把“请求发送成功”直接等同于“对方已经收到”。","232":"5.3 对不可逆操作采用更严格策略","233":"以下操作尤其需要谨慎：","234":"发送外部消息；","235":"创建付费生成任务；","236":"提交或发布代码；","237":"修改外部系统状态；","238":"删除文件或数据；","239":"执行金融或其他高影响操作。","240":"如果系统无法确认第一次操作是否成功，就不应自动再次执行不可逆操作。","241":"优先查询真实状态；无法查询时，暂停相关步骤并向用户说明不确定性。","242":"5.4 补偿操作不等于真正回滚","243":"有些操作无法完全撤销。","244":"例如，已经发送的消息无法保证被对方撤回；已经发生的 API 费用可能无法退还；已经发布的代码可能已经被其他系统拉取。","245":"因此，RERA 需要区分：","246":"回滚：","247":" 将系统状态恢复到先前版本；","248":"补偿：","249":" 通过另一项操作降低先前操作造成的影响；","250":"停止：","251":" 阻止后续副作用继续发生；","252":"对账：","253":" 查明当前真实状态。","254":"系统不应承诺所有副作用都能够回滚。","255":"六、检查点与恢复：从“保存进度”升级为“保存可恢复状态”","256":"检查点不是简单地保存任务百分比，也不应该只是保存模型的对话摘要。","257":"建议建立 ","258":"RecoveryCheckpoint","259":"，保存足以判断任务能否继续执行的关键状态。","260":"6.1 检查点至少需要保存什么？","261":"数据类别","262":"必要内容","263":"任务状态","264":"任务 ID、当前状态、生命周期版本","265":"计划状态","266":"DAG 版本、节点状态、依赖关系","267":"产物状态","268":"产物 ID、版本、校验摘要、存储引用","269":"执行状态","270":"正在运行的操作、已确认结果、未知结果","271":"授权状态","272":"授权引用、有效期、相关撤销状态","273":"团队状态","274":"成员、职责、未完成工作包与交接情况","275":"资源状态","276":"已消耗预算、剩余额度、截止条件","277":"版本状态","278":"专家、技能、工具、模型适配器与配置版本","279":"恢复信息","280":"最近一次有效检查点、待对账操作和已知故障","281":"完整日志、视频文件和大型产物不需要全部复制进检查点，可以通过版本化引用访问。","282":"但这些引用必须仍然有效，并且相关产物必须能够被找到和验证。","283":"6.2 检查点必须有明确的一致性边界","284":"例如，某个 DAG 节点同时修改了三个文件，并更新了数据库中的任务状态。","285":"如果检查点只记录了两个文件的更新，就可能产生一个无法继续执行的中间状态。","286":"因此，建议优先在明确的安全边界创建检查点，例如：","287":"一个节点完成并且产物已验证；","288":"一组相关文件完成原子提交；","289":"外部操作状态已经核验；","290":"一次计划变更已经提交；","291":"一次团队交接已经完成。","292":"对于无法原子提交的跨资源操作，应记录操作阶段，并在恢复时执行对账或补偿。","293":"6.3 恢复前先执行一致性检查","294":"恢复流程建议采用以下顺序：","295":"恢复过程中，如果发现状态无法确认，系统应保留未知状态并暂停相关操作。","296":"不能为了让任务继续而擅自假定某个操作成功或失败。","297":"6.4 检查点恢复必须考虑版本兼容性","298":"假设一个任务暂停了一周，期间某个技能已经升级，原来的 DAG 也发生了变化。","299":"系统不能不加检查地使用最新技能继续执行旧计划。","300":"建议在恢复时检查：","301":"原技能版本是否仍然可用；","302":"是否存在已知安全缺陷；","303":"旧计划是否兼容当前工作流版本；","304":"原产物是否仍然满足下游契约；","305":"是否需要使用原版本、迁移状态或重新规划。","306":"对于无法安全迁移的任务，可以继续使用受保护的兼容版本，也可以暂停并请求用户决策。","307":"七、DAG 恢复：不是从失败节点简单地重新开始","308":"对于复杂工作流，恢复机制必须理解任务之间的依赖关系。","309":"例如，AI 漫剧工作流包含：","310":"故事脚本 → 分镜 → 角色素材 → 视频片段 → 配音与合成 → 最终验收","311":"如果最终视频合成失败，而所有上游产物都经过验证，系统可以只重新执行合成节点。","312":"但如果故事脚本发生变化，依赖它的分镜、部分角色素材、视频片段和最终合成结果可能都需要重新生成或验证。","313":"因此，RERA 必须与 DAG 编排器建立 ","314":"Dependency Invalidation","315":" 机制。","316":"7.1 区分三种下游节点","317":"类型","318":"处理原则","319":"完全不受影响","320":"输入、契约与依赖均未变化，可以保留已验证结果","321":"需要重新验证","322":"输入变化可能影响结果，但尚不能确定是否必须重跑","323":"必须重新执行","324":"关键输入已改变，原结果不再满足有效性条件","325":"不能简单地将所有下游节点全部重跑，也不能因为某个节点过去执行成功就永久信任其结果。","326":"7.2 使用产物血缘判断影响范围","327":"GECO 应记录产物与输入、工具、技能版本之间的关联。","328":"当某个输入发生变化时，RERA 根据血缘关系找到受影响节点，再结合契约与变化类型判断是否需要重新执行。","329":"例如，配音文件重新生成，通常不需要重新编写故事脚本；但如果角色台词发生变化，就可能需要重新配音、重新合成，并重新验证字幕和时长。","330":"7.3 恢复必须考虑计划变更","331":"如果 SOCDEA 诊断发现原 DAG 的分解方式本身存在缺陷，恢复过程可能需要重新规划。","332":"但新的计划必须：","333":"保留原始目标和有效约束；","334":"明确变更原因；","335":"记录新旧计划版本；","336":"检查受影响的产物和节点；","337":"重新检查授权与预算；","338":"通过必要的治理检查。","339":"计划变更不能覆盖历史记录，否则系统将无法解释原计划为什么失败，也无法准确评价 Planner 的表现。","340":"八、降级运行：资源不足时，不一定要完全停止","341":"个人电脑和微型 Linux 主机的计算资源有限。系统可能同时运行本地模型、工具执行、数据库和后台进化任务。","342":"如果资源不足，EvoAgent 不应只有“继续运行”或“整个系统崩溃”两种状态。","343":"建议建立 ","344":"DegradedOperationPolicy","345":"。","346":"8.1 设计四种运行模式","347":"系统可以根据磁盘剩余空间、内存压力、执行失败率、任务积压和关键组件健康状态切换模式。","348":"具体阈值需要通过目标设备的实际测试确定，不能仅凭一组固定数字适用于所有电脑。","349":"8.2 建立任务优先级","350":"建议优先保障：","351":"安全控制、授权撤销和必要的执行停止；","352":"正在进行的关键状态持久化与故障对账；","353":"用户当前明确要求的前台任务；","354":"已开始且可安全完成的工作流；","355":"普通后台任务；","356":"进化实验、批量评测和非紧急优化。","357":"例如，当内存不足时，可以先暂停后台技能评测，而不是让任务恢复机制和安全控制也因资源竞争而失效。","358":"8.3 磁盘写满必须有专门策略","359":"磁盘写满会同时影响事件记录、检查点、产物生成和状态恢复。","360":"因此，建议预留关键状态存储空间，并对大型调试日志和临时产物设置独立配额。","361":"系统不能在磁盘写满后继续宣称所有操作都具备完整的审计和恢复保障。","362":"如果无法持久化关键状态，应根据操作风险暂停可能产生副作用的工作，释放可清理空间后再恢复。","363":"8.4 降级不等于绕过质量要求","364":"资源不足时，可以选择：","365":"减少并行度；","366":"暂停非关键专家；","367":"使用经过验证的低成本模型或能力；","368":"缩小允许处理的批次；","369":"将任务暂停，等待设备资源恢复。","370":"但不能因为资源不足就降低必要的安全门槛，或者把未经验证的结果直接当成合格产物。","371":"九、故障注入：主动制造故障，才能验证恢复能力","372":"仅靠正常运行测试，很难证明系统真的具备可靠恢复能力。","373":"很多缺陷只会在特定时机出现，例如：","374":"工具操作已经成功，但成功事件尚未写入；","375":"产物已经保存，但任务状态尚未提交；","376":"用户撤销授权时，设备正好断网；","377":"两个专家同时提交产物；","378":"检查点创建过程中进程崩溃；","379":"任务恢复时，旧技能版本已经被禁用。","380":"因此，建议建立 ","381":"Fault Injection Framework","382":"，在可控环境中主动注入故障。","383":"9.1 第一版必须测试的故障场景","384":"故障注入","385":"需要验证的结果","386":"工具执行前崩溃","387":"操作没有被误判为已经成功","388":"工具执行后、记录前崩溃","389":"系统能够通过对账识别实际效果","390":"重复发送同一操作请求","391":"幂等机制能够阻止不必要的重复副作用","392":"模型服务超时","393":"任务按策略重试、暂停或切换，不进入无限循环","394":"磁盘写满","395":"关键状态受到保护，危险操作能够安全停止","396":"网络中断","397":"本地事件可以保存，恢复后能够同步和对账","398":"检查点损坏","399":"系统拒绝不可信检查点，尝试其他有效恢复路径","400":"上游产物版本变化","401":"下游节点被正确保留、重新验证或重跑","402":"授权撤销","403":"相关执行被阻止，未知状态被明确标记","404":"多专家并发修改","405":"冲突被发现，不发生静默覆盖","406":"进化候选引入回归","407":"版本不能绕过质量和安全发布门槛","408":"恢复过程再次崩溃","409":"可以从最新有效检查点重新恢复，不无限重复副作用","410":"9.2 故障注入必须在隔离环境进行","411":"不能为了测试恢复机制而在真实用户项目中随意删除文件、断开关键存储或重复调用付费 API。","412":"建议使用模拟工具、测试文件、虚拟外部服务和独立任务数据库构建故障注入环境。","413":"对于确实需要验证真实系统行为的测试，应明确操作范围、测试数据和回滚方法。","414":"9.3 测试应覆盖不同故障发生时机","415":"同一种故障在不同阶段发生，可能导致完全不同的结果。","416":"例如，工具调用过程中的崩溃至少可以分为：","417":"调用尚未发出；","418":"调用已发出但未被确认；","419":"远端已经执行；","420":"返回结果已经收到；","421":"结果尚未持久化；","422":"结果已经持久化但任务状态尚未更新。","423":"因此，故障注入应覆盖关键状态转换之间的中断点，而不是只测试“进程崩溃一次”。","424":"十、可靠性指标：如何判断系统真正变得更可靠？","425":"RERA 需要把可靠性变成可测量、可比较的工程目标。","426":"建议建立 ","427":"ReliabilityMetricCatalog","428":"，与 GECO 的事件和指标体系统一。","429":"10.1 核心指标","430":"指标","431":"含义","432":"任务成功率","433":"满足最终验收契约的任务占比","434":"首次执行成功率","435":"不依赖重试与恢复即完成的任务占比","436":"恢复成功率","437":"发生符合统计口径的故障后，最终成功恢复的任务占比","438":"状态对账成功率","439":"恢复时能够核实实际状态并解决不一致的操作占比","440":"重复副作用率","441":"非预期重复产生外部影响的操作占比","442":"检查点恢复耗时","443":"从开始恢复到达到可安全继续状态的耗时","444":"平均恢复时间","445":"在明确的故障统计口径下，从故障发生到恢复的平均时间","446":"任务超时率","447":"超过规定时间预算的任务占比","448":"资源故障率","449":"因内存、磁盘、CPU 或其他资源限制而中断的任务占比","450":"故障重试收益","451":"重试后新增成功数、额外成本与无效重试数量","452":"恢复后回归率","453":"恢复后重新验收发现缺陷的任务占比","454":"关键事件缺失率","455":"关键运行事件未被可靠记录的比例","456":"这里需要特别注意指标的统计口径。","457":"例如，恢复成功率不能只统计“成功恢复的任务”，还必须明确哪些故障进入分母、哪些任务被取消，以及哪些任务因证据不足而无法判定。","458":"10.2 为不同任务定义可靠性目标","459":"并不是所有任务都需要相同的可靠性要求。","460":"普通聊天任务可以优先保证响应及时与上下文连续；","461":"代码修改任务需要重点保证文件安全、测试证据与恢复正确性；","462":"AI 漫剧任务需要重点保证大型产物不丢失、生成费用可追踪和阶段性恢复；","463":"外部系统操作需要重点保证授权、幂等和副作用核验；","464":"自进化任务则必须重点保证版本可追溯、安全回归和可靠回滚。","465":"因此，建议按任务类型定义可靠性配置，而不是为所有任务硬编码一套相同策略。","466":"10.3 不要通过降低标准制造更高成功率","467":"如果某个版本把原本需要通过的测试删除，任务成功率可能上升，但系统并没有变得更可靠。","468":"因此，RERA 的可靠性指标必须与 UQEAG 的固定验收契约、TSEG 的安全门槛以及 GECO 的真实事件证据关联。","469":"任何影响成功率定义、恢复判定和测试标准的变更，都需要独立记录与审核。","470":"十一、可靠性与自进化：把恢复能力本身纳入进化闭环","471":"RERA 不只是给系统增加恢复机制，它还应该让 EvoAgent 能够逐步发现恢复机制自身的问题。","472":"例如，系统发现：","473":"某类任务的重试经常无效；","474":"某个工具适配器无法区分超时和真正失败；","475":"某种检查点无法恢复并行任务；","476":"某个技能版本经常造成下游节点失效；","477":"某个工作流恢复时会重复生成付费视频。","478":"这些问题都可以成为可靠性改进候选。","479":"建议建立以下闭环：","480":"关键要求是：","481":"发现故障的机制、修复故障的机制，以及证明修复有效的机制，不能完全依赖同一个未经独立验证的判断。","482":"例如，SOCDEA 认为某个重试策略有问题，可以提出修改建议；但候选策略是否有效，仍然需要通过独立故障场景和固定评测集验证。","483":"11.1 建立可靠性回归集","484":"每次可靠性改进，都应保留一组能够重现原始问题的测试案例。","485":"如果系统修复了“工具超时导致重复调用”的问题，未来修改 TERSO、RetryController 或相关技能时，就必须重新运行这个案例。","486":"这样可以避免同一类故障不断重复出现，或者一个版本修复了旧问题，却引入新的恢复缺陷。","487":"11.2 评价改进的净收益","488":"可靠性改进也可能产生代价。","489":"例如，增加更频繁的检查点能够降低崩溃后的重做量，但会增加磁盘写入和存储占用。","490":"因此，改进评估应同时比较：","491":"故障恢复成功率；","492":"恢复耗时；","493":"任务总成本；","494":"资源开销；","495":"重复副作用；","496":"运行复杂度；","497":"新增故障模式。","498":"如果一项改进只让某个指标变好，却显著损害其他关键指标，就不能简单地认定它是全局进步。","499":"十二、与现有架构的集成边界","500":"模块","501":"在可靠性体系中的职责","502":"GECO","503":"记录事件、追踪、产物血缘和实际操作证据","504":"LTAR","505":"维护任务生命周期、检查点和恢复状态","506":"RERA","507":"管理故障分类、重试、熔断、降级与恢复决策","508":"TERSO","509":"执行工具操作、控制副作用并提供结果核验","510":"SOCDEA","511":"分析故障根因并提出改进假设","512":"UQEAG","513":"验证恢复后的产物是否满足最终验收要求","514":"MEODT","515":"重新分配失败工作包、替换专家并协调团队恢复","516":"Planner / DAG","517":"维护任务依赖、节点状态和受控重规划","518":"CEKCE / CIL","519":"提供可替换的能力与工作流版本","520":"TSEG / APE","521":"保证恢复、替换和重试不会突破安全边界","522":"SELCIA","523":"管理可靠性改进的独立评测、发布和回滚","524":"MTSRIC / ARCBG","525":"控制恢复期间的资源消耗、并发和预算","526":"HACCG","527":"展示任务不确定性，支持用户暂停、取消和人工接管","528":"其中，RERA 应作为跨模块的可靠性策略层，而不是接管其他模块的全部职责。","529":"十三、架构决策记录 ADR-761～ADR-780","530":"以下建议纳入 EvoAgent 全量架构，作为 RERA 的治理基线。","531":"这些是建议纳入全量架构的可靠性治理基线。进入工程实施阶段后，还需要定义 ","532":"FailureRecord","533":"、","534":"RetryPolicy","535":"、","536":"OperationLedger","537":"、","538":"RecoveryCheckpoint","539":"、","540":"RecoveryPlan","541":"、","542":"DependencyInvalidationPolicy","543":" 和 ","544":"ReliabilityMetricCatalog","545":" 的具体接口与状态机。","546":"十四、第一版实施路线：先实现最小可靠性闭环","547":"对于 EvoAgent 的个人部署方向，建议先使用本地数据库、结构化事件、明确的状态机和受限执行器完成第一版，不必立即引入复杂的分布式容错系统。","548":"14.1 第一版必须通过的端到端测试","549":"建议用一个真实的代码修复任务完成验收：","550":"创建任务，生成 DAG 并执行代码分析。","551":"修改代码并运行测试。","552":"在关键状态转换之间模拟进程崩溃。","553":"重启系统，加载检查点并读取后续事件。","554":"对账文件、工具操作和测试结果的实际状态。","555":"仅恢复尚未完成且满足执行条件的节点。","556":"验证没有重复修改、重复提交或丢失产物。","557":"重新运行必要的回归测试。","558":"由 UQEAG 根据真实证据判定最终结果。","559":"由 GECO 保留完整的故障、恢复和验收轨迹。","560":"核心验收标准不是“崩溃后程序能重新启动”，而是“重新启动后，系统能够准确判断哪些工作已完成、哪些状态未知、哪些工作可以安全继续”。","561":"这才是复杂智能体真正需要的可靠性。","562":"十五、下一专项：性能工程、资源调度与成本优化","563":"完成 RERA 后，EvoAgent 已经具备了任务执行、专家协作、运行观测、安全治理和故障恢复的基本架构。","564":"但还有一个与个人部署密切相关的问题尚未系统解决：","565":"当 EvoAgent 同时拥有多个专家、模型适配器、记忆系统、工作流和后台进化任务时，怎样在有限的 CPU、内存、GPU、磁盘和网络资源下，让整个系统既足够聪明，又不会拖垮用户设备？","566":"这不是简单的“减少模型调用”。","567":"例如：","568":"Router 过于复杂，可能每次聊天都调用多个模型，导致响应变慢；","569":"记忆检索过度，可能每次任务都加载大量无关内容；","570":"多专家并行执行，可能同时占满内存；","571":"后台进化任务可能与用户的前台任务争抢 GPU；","572":"为了提高恢复能力而频繁创建检查点，可能产生大量磁盘写入；","573":"过度压缩上下文，可能减少 Token 消耗，却增加返工率；","574":"为了节省成本而切换低能力模型，可能使任务成功率下降，最终花费更多。","575":"因此，建议下一专项定义为：","576":"Adaptive Performance & Resource Optimization，简称 APRO。","577":"重点研究：","578":"如何建立模型、工具、专家、任务和设备的统一资源预算；","579":"如何动态选择模型，而不是所有任务都使用最高成本模型；","580":"如何在响应质量、延迟、Token、内存和外部费用之间进行权衡；","581":"如何根据任务依赖和设备负载调整 DAG 并行度；","582":"如何控制专家数量，避免协调成本超过协作收益；","583":"如何决定记忆检索、上下文压缩和缓存的使用策略；","584":"如何管理模型预热、驻留、卸载与后台任务；","585":"如何在 Android、Windows 和微型 Linux 主机之间分配执行任务；","586":"如何根据任务价值和截止条件分配计算资源；","587":"如何优化检查点频率、事件存储和产物缓存；","588":"如何识别无效模型调用、重复推理、无进展循环和高成本返工；","589":"如何通过性能剖析发现真正的瓶颈，而不是凭感觉优化；","590":"如何将性能改进纳入 SELCIA 的独立评测和回归体系；","591":"如何保证资源优化不能绕过 TSEG 的安全门槛和 UQEAG 的质量要求。","592":"本专项的核心原则是：","593":"优化的目标不是让每个模块单独运行得最快，而是让整个 EvoAgent 在满足质量、安全与可靠性要求的前提下，用合理的资源成本完成用户真正需要的任务。","594":"这将把 EvoAgent 从“能够执行、能够恢复、能够自我改进的系统”，进一步推进到“能够根据任务价值、运行环境和资源约束，自适应地选择最合适执行策略的个人智能体”。"},"fallbackMarkdown":"# EvoAgent 第五十四专项：可靠性工程、故障注入与恢复保证\n\nRERA · Reliability Engineering &amp; Recovery Assurance\n\n前面已经完成了几个重要的基础设计：\n\n- MEODT：多专家协作与动态组队；\n- GECO：全局事件、运行追踪与因果证据；\n- TSEG：安全边界、信任体系与自进化治理。\n\n现在要解决的是一个更贴近实际运行的问题：\n\n**当 EvoAgent 长时间运行、执行复杂任务、调用外部工具，甚至在任务中途遭遇断电、崩溃或断网时，怎样保证它不会丢失关键进度、重复执行危险操作，或者在恢复过程中制造新的故障？**\n\n这里有一个重要区别。\n\n普通应用的可靠性，主要关注程序是否崩溃、数据是否丢失、服务是否可用。\n\nEvoAgent 的可靠性还必须考虑智能体自身的行为：它可能错误地判断任务已经完成，可能无限重试，可能恢复一个已经失效的计划，也可能在上游结果变化后继续使用旧的下游产物。\n\n因此，RERA 不应只是增加异常捕获、重试和日志，而应建立一套完整的**任务可靠性状态机、故障分类、恢复协议、故障注入测试和可靠性评测体系**。\n\n## 一、第一性原理：失败不可避免，但失控可以被限制\n\n设想一个真实的 AI 漫剧制作任务。\n\n编剧、分镜、视觉生成已经完成，配音服务也已返回结果。此时 Linux 主机突然断电。\n\n重新启动后，系统面临几个问题：\n\n- 哪些工作已经真正完成？\n- 哪些产物已经写入磁盘？\n- 哪些产物虽然生成了，但尚未记录完成事件？\n- 视频合成是否已经启动？\n- 如果外部服务已经扣费，但本地没有收到响应，是否应该再次调用？\n- 当前工作流使用的角色设定是否已经发生变化？\n- 哪些任务可以直接恢复，哪些必须重新执行？\n- 如果关键状态无法确认，应该继续、等待还是终止？\n\n如果系统只保存一个“任务进度 70%”的数值，这些问题都无法可靠回答。\n\n因此，RERA 的第一条原则是：\n\n**恢复必须依据可验证的状态和产物，而不能仅依赖模型记忆、进度百分比或上一次的自然语言总结。**\n\n### 1.1 将可靠性分为六个维度\n\n这六个维度需要分别评测。\n\n例如，一个任务最终成功了，不代表它的恢复机制可靠；它可能只是因为故障恰好没有影响最终产物。\n\n同样，恢复成功也不代表没有发生重复扣费、数据泄露或未经授权的外部操作。\n\n### 1.2 可靠性不能只看成功率\n\n假设两个版本的编程专家都完成了 95% 的任务。\n\n- 版本 A 在失败时能够准确报告问题，并从检查点恢复。\n- 版本 B 在失败时会反复执行修改命令，偶尔覆盖用户文件，还可能误报任务完成。\n\n它们的表面成功率相同，但工程可靠性显然不同。\n\n因此，RERA 必须同时评价正常执行和异常路径，尤其要关注失败后的行为。\n\n---\n\n# 二、总体架构：建立统一的可靠性控制层\n\n建议建立 `RERA Reliability Control Plane`，作为 EvoAgent 可靠性治理的统一控制层。\n\n它不替代 GECO 的事件记录，也不替代 LTAR 的任务生命周期管理，而是根据任务状态、故障类型、恢复策略和资源条件，决定如何安全地继续执行。\n\n### 任务执行层\n\nRouter、Planner、DAG、ReAct、专家团队、技能和工具适配器。\n\n### 可靠性控制层 · RERA\n\n故障分类、重试决策、熔断、降级、恢复规划、可靠性预算和恢复验证。\n\n### GECO\n\n提供事件、追踪、操作结果与证据。\n\n### LTAR\n\n保存任务状态、检查点和生命周期。\n\n### TERSO\n\n执行受控工具操作、取消与结果核验。\n\n### SOCDEA\n\n分析根因，判断故障是否来自系统缺陷。\n\n### 恢复与验证\n\n检查点恢复、依赖重算、产物校验、回归测试、安全检查与最终验收。\n\n需要明确几个职责边界：\n\n- **GECO** 记录实际发生的事情；\n- **LTAR** 维护任务状态与检查点；\n- **RERA** 决定采用什么恢复策略；\n- **TERSO** 负责受控执行和操作结果核验；\n- **SOCDEA** 诊断故障原因；\n- **UQEAG** 验证恢复后的最终产物是否合格；\n- **TSEG** 保证恢复行为不突破安全和授权边界。\n\nRERA 可以提出恢复方案，但不能自行放宽权限、绕过安全检查或宣称未经验证的结果已经成功。\n\n---\n\n# 三、故障分类：不同故障必须采用不同处理策略\n\n很多智能体系统把所有异常都当作“再试一次”。\n\n这是不可靠的。\n\n例如，模型服务暂时超时，可能适合有限重试；但如果一个付费 API 请求已经提交，响应却丢失，再次发送可能产生第二笔费用。\n\n因此，建议建立统一的 `FailureTaxonomy`。\n\n| 故障类型 | 典型场景 | 默认处理策略 |\n|--------|--------|--------|\n| 暂时性故障 | 网络短暂中断、服务限流 | 有界重试、退避等待 |\n| 永久性故障 | 配置错误、缺失依赖、权限不足 | 停止重试，修复配置或请求人工介入 |\n| 结果未知 | 请求已发出但响应丢失 | 查询实际状态或执行对账，不盲目重试 |\n| 数据与契约故障 | 输出格式错误、输入版本不匹配 | 校验、修复或重新生成 |\n| 状态一致性故障 | 事件与实际产物不一致 | 暂停相关节点，进行状态对账 |\n| 资源故障 | 内存不足、磁盘写满、CPU 过载 | 限流、释放资源、降级或暂停 |\n| 依赖故障 | 上游产物变化、技能版本失效 | 重新评估受影响的下游节点 |\n| 安全故障 | 越权、授权撤销、安全校验失败 | 阻断相关操作，执行安全响应 |\n| 智能体决策故障 | 错误规划、循环、重复劳动 | 停止当前策略，诊断并有限重规划 |\n| 质量故障 | 最终产物不满足验收要求 | 返工、局部重跑或终止交付 |\n\n这里的“默认处理”是建议策略，不是所有场景的绝对规则。最终行为还需要结合任务风险、操作可逆性、授权范围和剩余预算决定。\n\n## 3.1 区分三种最重要的执行结果\n\n对任何可能产生副作用的操作，系统都应能够区分：\n\n- `SUCCEEDED`：执行成功，并且结果已经得到必要的核验；\n- `FAILED`：有证据表明操作失败，且实际影响已知；\n- `UNKNOWN`：无法确定操作是否成功或产生了什么影响。\n\n`UNKNOWN` 不是普通失败。\n\n例如，调用外部视频生成服务时，连接在提交请求后断开。服务可能已经接受请求并开始生成视频，也可能根本没有收到请求。\n\n此时不能直接认定失败并再次调用。\n\n应该先尝试使用请求 ID、服务端任务 ID 或其他可用证据查询状态。如果服务不支持状态查询，则需要根据费用风险和操作策略决定等待、人工确认或在明确接受重复风险后重试。\n\n**未知状态必须成为系统的一等状态，而不是被强行归类为失败。**\n\n---\n\n# 四、重试机制：防止智能体陷入无限循环\n\n重试是必要能力，但无约束的重试会造成一系列问题：\n\n- 模型调用费用持续增加；\n- 同一个工具被反复调用；\n- 多个专家同时重试同一个失败节点；\n- 失败原因没有改变，结果却不断重复；\n- 自动恢复与人工取消相互冲突；\n- 上游失败引发整个 DAG 的重试风暴。\n\n建议建立 `RetryController`，统一管理重试次数、等待策略、故障分类和任务级预算。\n\n## 4.1 重试必须满足准入条件\n\n每次重试前，至少检查：\n\n1. 该故障是否属于允许重试的类型？\n2. 前一次操作是否已经产生副作用？\n3. 重试是否具有幂等保障？\n4. 当前授权是否仍然有效？\n5. 是否仍有足够的时间、资源和费用预算？\n6. 前一次失败的原因是否可能已经改变？\n7. 是否需要先执行状态核验或补偿操作？\n\n如果关键条件不满足，系统应暂停或终止，而不是为了追求任务完成率继续尝试。\n\n## 4.2 采用分层重试预算\n\n建议同时设置四种限制：\n\n| 预算层级 | 限制对象 | 防止的问题 |\n|--------|--------|--------|\n| 操作级 | 单个工具调用 | 同一操作无限重试 |\n| 节点级 | 单个 DAG 节点 | 某个子任务持续失败 |\n| 任务级 | 整个任务 | 多个节点共同消耗过多资源 |\n| 系统级 | 同时运行的所有任务 | 故障期间产生重试风暴 |\n\n预算需要相互约束。\n\n例如，某个工具还有一次重试额度，并不意味着任务已经达到费用上限后仍然允许重试。\n\n## 4.3 使用退避与抖动\n\n对于网络中断、限流等暂时性故障，可以使用指数退避。\n\n\\[\nd_n=\\min(d_{\\max},d_0\\cdot 2^n)\n\\]\n\n其中 \\(d_0\\) 为初始等待时间，\\(d_{\\max}\\) 为等待上限。\n\n如果多个任务可能同时重试，还可以增加随机抖动，避免所有请求在同一时刻再次冲击故障服务。\n\n但退避不是通用解决方案。\n\n权限不足、输入契约错误、无效配置和安全阻断等故障，通常不应通过反复重试来解决。\n\n## 4.4 重规划也必须受限制\n\n智能体可能认为当前方案失败，于是重新规划；新方案再次失败，又重新规划。这样就会出现不断改变策略却始终无法完成任务的循环。\n\n建议分别设置：\n\n- 最大普通重试次数；\n- 最大重规划次数；\n- 最大连续无进展次数；\n- 最大返工轮数；\n- 最大总执行时间；\n- 最大任务成本。\n\n当同一问题连续出现、方案没有实质变化，或者连续多轮没有产生新的有效证据时，应触发熔断或转入诊断，而不是继续重复执行。\n\n## 4.5 重试必须记录原因\n\n每次重试都应在 GECO 中记录：\n\n- 前一次失败事件；\n- 当前故障分类；\n- 重试理由；\n- 采用的等待策略；\n- 是否进行了状态核验；\n- 使用的预算；\n- 重试后的结果；\n- 是否产生了新的副作用。\n\n这样，SOCDEA 才能判断重试是否真的提高了成功概率，还是只增加了成本。\n\n---\n\n# 五、幂等性与副作用：恢复机制最容易出错的地方\n\n这是 RERA 最值得优先实现的部分。\n\n假设一个工具调用已经成功修改文件，但进程在记录成功事件前崩溃。系统重启后发现没有成功记录，于是再次执行同一个修改。\n\n如果工具操作是简单覆盖，也许结果没有变化；如果它是追加内容、提交代码、发送消息或创建付费任务，就可能造成重复副作用。\n\n## 5.1 建立操作级幂等协议\n\n建议为每个重要操作生成唯一的 `operation_id`。\n\n执行器至少应维护：\n\n- 操作标识；\n- 请求内容摘要；\n- 目标资源；\n- 当前执行状态；\n- 已知的副作用；\n- 结果引用；\n- 是否允许安全重试；\n- 实际核验结果。\n\n当相同操作被重复请求时，执行器应先查询已有状态，而不是默认再次执行。\n\n对于支持幂等键的外部 API，应使用稳定的操作标识；对于不支持幂等的服务，则必须设计状态查询、人工确认或明确接受重复风险的策略。\n\n**不能仅依赖客户端生成一个 ID，就宣称外部操作已经实现幂等。** 真正的幂等保障还取决于执行器和目标系统如何处理重复请求。\n\n## 5.2 区分四种操作阶段\n\n建议使用以下状态：\n\n这里的 `FAILED_OR_UNKNOWN` 在正式实现时建议拆分为两个独立状态，避免混淆。上面的分组只是展示概念。\n\n操作成功的判定标准应根据工具类型决定。例如：\n\n- 文件修改：核验目标文件内容或版本；\n- 代码提交：核验提交标识与远端状态；\n- 付费 API：核验请求 ID、任务状态或服务端账单记录；\n- 外部消息：核验服务端接受状态，不能把“请求发送成功”直接等同于“对方已经收到”。\n\n## 5.3 对不可逆操作采用更严格策略\n\n以下操作尤其需要谨慎：\n\n- 发送外部消息；\n- 创建付费生成任务；\n- 提交或发布代码；\n- 修改外部系统状态；\n- 删除文件或数据；\n- 执行金融或其他高影响操作。\n\n如果系统无法确认第一次操作是否成功，就不应自动再次执行不可逆操作。\n\n优先查询真实状态；无法查询时，暂停相关步骤并向用户说明不确定性。\n\n## 5.4 补偿操作不等于真正回滚\n\n有些操作无法完全撤销。\n\n例如，已经发送的消息无法保证被对方撤回；已经发生的 API 费用可能无法退还；已经发布的代码可能已经被其他系统拉取。\n\n因此，RERA 需要区分：\n\n- **回滚：** 将系统状态恢复到先前版本；\n- **补偿：** 通过另一项操作降低先前操作造成的影响；\n- **停止：** 阻止后续副作用继续发生；\n- **对账：** 查明当前真实状态。\n\n系统不应承诺所有副作用都能够回滚。\n\n---\n\n# 六、检查点与恢复：从“保存进度”升级为“保存可恢复状态”\n\n检查点不是简单地保存任务百分比，也不应该只是保存模型的对话摘要。\n\n建议建立 `RecoveryCheckpoint`，保存足以判断任务能否继续执行的关键状态。\n\n## 6.1 检查点至少需要保存什么？\n\n| 数据类别 | 必要内容 |\n|--------|--------|\n| 任务状态 | 任务 ID、当前状态、生命周期版本 |\n| 计划状态 | DAG 版本、节点状态、依赖关系 |\n| 产物状态 | 产物 ID、版本、校验摘要、存储引用 |\n| 执行状态 | 正在运行的操作、已确认结果、未知结果 |\n| 授权状态 | 授权引用、有效期、相关撤销状态 |\n| 团队状态 | 成员、职责、未完成工作包与交接情况 |\n| 资源状态 | 已消耗预算、剩余额度、截止条件 |\n| 版本状态 | 专家、技能、工具、模型适配器与配置版本 |\n| 恢复信息 | 最近一次有效检查点、待对账操作和已知故障 |\n\n完整日志、视频文件和大型产物不需要全部复制进检查点，可以通过版本化引用访问。\n\n但这些引用必须仍然有效，并且相关产物必须能够被找到和验证。\n\n## 6.2 检查点必须有明确的一致性边界\n\n例如，某个 DAG 节点同时修改了三个文件，并更新了数据库中的任务状态。\n\n如果检查点只记录了两个文件的更新，就可能产生一个无法继续执行的中间状态。\n\n因此，建议优先在明确的安全边界创建检查点，例如：\n\n- 一个节点完成并且产物已验证；\n- 一组相关文件完成原子提交；\n- 外部操作状态已经核验；\n- 一次计划变更已经提交；\n- 一次团队交接已经完成。\n\n对于无法原子提交的跨资源操作，应记录操作阶段，并在恢复时执行对账或补偿。\n\n## 6.3 恢复前先执行一致性检查\n\n恢复流程建议采用以下顺序：\n\n恢复过程中，如果发现状态无法确认，系统应保留未知状态并暂停相关操作。\n\n不能为了让任务继续而擅自假定某个操作成功或失败。\n\n## 6.4 检查点恢复必须考虑版本兼容性\n\n假设一个任务暂停了一周，期间某个技能已经升级，原来的 DAG 也发生了变化。\n\n系统不能不加检查地使用最新技能继续执行旧计划。\n\n建议在恢复时检查：\n\n- 原技能版本是否仍然可用；\n- 是否存在已知安全缺陷；\n- 旧计划是否兼容当前工作流版本；\n- 原产物是否仍然满足下游契约；\n- 是否需要使用原版本、迁移状态或重新规划。\n\n对于无法安全迁移的任务，可以继续使用受保护的兼容版本，也可以暂停并请求用户决策。\n\n---\n\n# 七、DAG 恢复：不是从失败节点简单地重新开始\n\n对于复杂工作流，恢复机制必须理解任务之间的依赖关系。\n\n例如，AI 漫剧工作流包含：\n\n`故事脚本 → 分镜 → 角色素材 → 视频片段 → 配音与合成 → 最终验收`\n\n如果最终视频合成失败，而所有上游产物都经过验证，系统可以只重新执行合成节点。\n\n但如果故事脚本发生变化，依赖它的分镜、部分角色素材、视频片段和最终合成结果可能都需要重新生成或验证。\n\n因此，RERA 必须与 DAG 编排器建立 `Dependency Invalidation` 机制。\n\n## 7.1 区分三种下游节点\n\n| 类型 | 处理原则 |\n|--------|--------|\n| 完全不受影响 | 输入、契约与依赖均未变化，可以保留已验证结果 |\n| 需要重新验证 | 输入变化可能影响结果，但尚不能确定是否必须重跑 |\n| 必须重新执行 | 关键输入已改变，原结果不再满足有效性条件 |\n\n不能简单地将所有下游节点全部重跑，也不能因为某个节点过去执行成功就永久信任其结果。\n\n## 7.2 使用产物血缘判断影响范围\n\nGECO 应记录产物与输入、工具、技能版本之间的关联。\n\n当某个输入发生变化时，RERA 根据血缘关系找到受影响节点，再结合契约与变化类型判断是否需要重新执行。\n\n例如，配音文件重新生成，通常不需要重新编写故事脚本；但如果角色台词发生变化，就可能需要重新配音、重新合成，并重新验证字幕和时长。\n\n## 7.3 恢复必须考虑计划变更\n\n如果 SOCDEA 诊断发现原 DAG 的分解方式本身存在缺陷，恢复过程可能需要重新规划。\n\n但新的计划必须：\n\n- 保留原始目标和有效约束；\n- 明确变更原因；\n- 记录新旧计划版本；\n- 检查受影响的产物和节点；\n- 重新检查授权与预算；\n- 通过必要的治理检查。\n\n计划变更不能覆盖历史记录，否则系统将无法解释原计划为什么失败，也无法准确评价 Planner 的表现。\n\n---\n\n# 八、降级运行：资源不足时，不一定要完全停止\n\n个人电脑和微型 Linux 主机的计算资源有限。系统可能同时运行本地模型、工具执行、数据库和后台进化任务。\n\n如果资源不足，EvoAgent 不应只有“继续运行”或“整个系统崩溃”两种状态。\n\n建议建立 `DegradedOperationPolicy`。\n\n## 8.1 设计四种运行模式\n\n系统可以根据磁盘剩余空间、内存压力、执行失败率、任务积压和关键组件健康状态切换模式。\n\n具体阈值需要通过目标设备的实际测试确定，不能仅凭一组固定数字适用于所有电脑。\n\n## 8.2 建立任务优先级\n\n建议优先保障：\n\n1. 安全控制、授权撤销和必要的执行停止；\n2. 正在进行的关键状态持久化与故障对账；\n3. 用户当前明确要求的前台任务；\n4. 已开始且可安全完成的工作流；\n5. 普通后台任务；\n6. 进化实验、批量评测和非紧急优化。\n\n例如，当内存不足时，可以先暂停后台技能评测，而不是让任务恢复机制和安全控制也因资源竞争而失效。\n\n## 8.3 磁盘写满必须有专门策略\n\n磁盘写满会同时影响事件记录、检查点、产物生成和状态恢复。\n\n因此，建议预留关键状态存储空间，并对大型调试日志和临时产物设置独立配额。\n\n系统不能在磁盘写满后继续宣称所有操作都具备完整的审计和恢复保障。\n\n如果无法持久化关键状态，应根据操作风险暂停可能产生副作用的工作，释放可清理空间后再恢复。\n\n## 8.4 降级不等于绕过质量要求\n\n资源不足时，可以选择：\n\n- 减少并行度；\n- 暂停非关键专家；\n- 使用经过验证的低成本模型或能力；\n- 缩小允许处理的批次；\n- 将任务暂停，等待设备资源恢复。\n\n但不能因为资源不足就降低必要的安全门槛，或者把未经验证的结果直接当成合格产物。\n\n---\n\n# 九、故障注入：主动制造故障，才能验证恢复能力\n\n仅靠正常运行测试，很难证明系统真的具备可靠恢复能力。\n\n很多缺陷只会在特定时机出现，例如：\n\n- 工具操作已经成功，但成功事件尚未写入；\n- 产物已经保存，但任务状态尚未提交；\n- 用户撤销授权时，设备正好断网；\n- 两个专家同时提交产物；\n- 检查点创建过程中进程崩溃；\n- 任务恢复时，旧技能版本已经被禁用。\n\n因此，建议建立 `Fault Injection Framework`，在可控环境中主动注入故障。\n\n## 9.1 第一版必须测试的故障场景\n\n| 故障注入 | 需要验证的结果 |\n|--------|--------|\n| 工具执行前崩溃 | 操作没有被误判为已经成功 |\n| 工具执行后、记录前崩溃 | 系统能够通过对账识别实际效果 |\n| 重复发送同一操作请求 | 幂等机制能够阻止不必要的重复副作用 |\n| 模型服务超时 | 任务按策略重试、暂停或切换，不进入无限循环 |\n| 磁盘写满 | 关键状态受到保护，危险操作能够安全停止 |\n| 网络中断 | 本地事件可以保存，恢复后能够同步和对账 |\n| 检查点损坏 | 系统拒绝不可信检查点，尝试其他有效恢复路径 |\n| 上游产物版本变化 | 下游节点被正确保留、重新验证或重跑 |\n| 授权撤销 | 相关执行被阻止，未知状态被明确标记 |\n| 多专家并发修改 | 冲突被发现，不发生静默覆盖 |\n| 进化候选引入回归 | 版本不能绕过质量和安全发布门槛 |\n| 恢复过程再次崩溃 | 可以从最新有效检查点重新恢复，不无限重复副作用 |\n\n## 9.2 故障注入必须在隔离环境进行\n\n不能为了测试恢复机制而在真实用户项目中随意删除文件、断开关键存储或重复调用付费 API。\n\n建议使用模拟工具、测试文件、虚拟外部服务和独立任务数据库构建故障注入环境。\n\n对于确实需要验证真实系统行为的测试，应明确操作范围、测试数据和回滚方法。\n\n## 9.3 测试应覆盖不同故障发生时机\n\n同一种故障在不同阶段发生，可能导致完全不同的结果。\n\n例如，工具调用过程中的崩溃至少可以分为：\n\n1. 调用尚未发出；\n2. 调用已发出但未被确认；\n3. 远端已经执行；\n4. 返回结果已经收到；\n5. 结果尚未持久化；\n6. 结果已经持久化但任务状态尚未更新。\n\n因此，故障注入应覆盖关键状态转换之间的中断点，而不是只测试“进程崩溃一次”。\n\n---\n\n# 十、可靠性指标：如何判断系统真正变得更可靠？\n\nRERA 需要把可靠性变成可测量、可比较的工程目标。\n\n建议建立 `ReliabilityMetricCatalog`，与 GECO 的事件和指标体系统一。\n\n## 10.1 核心指标\n\n| 指标 | 含义 |\n|--------|--------|\n| 任务成功率 | 满足最终验收契约的任务占比 |\n| 首次执行成功率 | 不依赖重试与恢复即完成的任务占比 |\n| 恢复成功率 | 发生符合统计口径的故障后，最终成功恢复的任务占比 |\n| 状态对账成功率 | 恢复时能够核实实际状态并解决不一致的操作占比 |\n| 重复副作用率 | 非预期重复产生外部影响的操作占比 |\n| 检查点恢复耗时 | 从开始恢复到达到可安全继续状态的耗时 |\n| 平均恢复时间 | 在明确的故障统计口径下，从故障发生到恢复的平均时间 |\n| 任务超时率 | 超过规定时间预算的任务占比 |\n| 资源故障率 | 因内存、磁盘、CPU 或其他资源限制而中断的任务占比 |\n| 故障重试收益 | 重试后新增成功数、额外成本与无效重试数量 |\n| 恢复后回归率 | 恢复后重新验收发现缺陷的任务占比 |\n| 关键事件缺失率 | 关键运行事件未被可靠记录的比例 |\n\n这里需要特别注意指标的统计口径。\n\n例如，恢复成功率不能只统计“成功恢复的任务”，还必须明确哪些故障进入分母、哪些任务被取消，以及哪些任务因证据不足而无法判定。\n\n## 10.2 为不同任务定义可靠性目标\n\n并不是所有任务都需要相同的可靠性要求。\n\n- 普通聊天任务可以优先保证响应及时与上下文连续；\n- 代码修改任务需要重点保证文件安全、测试证据与恢复正确性；\n- AI 漫剧任务需要重点保证大型产物不丢失、生成费用可追踪和阶段性恢复；\n- 外部系统操作需要重点保证授权、幂等和副作用核验；\n- 自进化任务则必须重点保证版本可追溯、安全回归和可靠回滚。\n\n因此，建议按任务类型定义可靠性配置，而不是为所有任务硬编码一套相同策略。\n\n## 10.3 不要通过降低标准制造更高成功率\n\n如果某个版本把原本需要通过的测试删除，任务成功率可能上升，但系统并没有变得更可靠。\n\n因此，RERA 的可靠性指标必须与 UQEAG 的固定验收契约、TSEG 的安全门槛以及 GECO 的真实事件证据关联。\n\n任何影响成功率定义、恢复判定和测试标准的变更，都需要独立记录与审核。\n\n---\n\n# 十一、可靠性与自进化：把恢复能力本身纳入进化闭环\n\nRERA 不只是给系统增加恢复机制，它还应该让 EvoAgent 能够逐步发现恢复机制自身的问题。\n\n例如，系统发现：\n\n- 某类任务的重试经常无效；\n- 某个工具适配器无法区分超时和真正失败；\n- 某种检查点无法恢复并行任务；\n- 某个技能版本经常造成下游节点失效；\n- 某个工作流恢复时会重复生成付费视频。\n\n这些问题都可以成为可靠性改进候选。\n\n建议建立以下闭环：\n\n关键要求是：**发现故障的机制、修复故障的机制，以及证明修复有效的机制，不能完全依赖同一个未经独立验证的判断。**\n\n例如，SOCDEA 认为某个重试策略有问题，可以提出修改建议；但候选策略是否有效，仍然需要通过独立故障场景和固定评测集验证。\n\n## 11.1 建立可靠性回归集\n\n每次可靠性改进，都应保留一组能够重现原始问题的测试案例。\n\n如果系统修复了“工具超时导致重复调用”的问题，未来修改 TERSO、RetryController 或相关技能时，就必须重新运行这个案例。\n\n这样可以避免同一类故障不断重复出现，或者一个版本修复了旧问题，却引入新的恢复缺陷。\n\n## 11.2 评价改进的净收益\n\n可靠性改进也可能产生代价。\n\n例如，增加更频繁的检查点能够降低崩溃后的重做量，但会增加磁盘写入和存储占用。\n\n因此，改进评估应同时比较：\n\n- 故障恢复成功率；\n- 恢复耗时；\n- 任务总成本；\n- 资源开销；\n- 重复副作用；\n- 运行复杂度；\n- 新增故障模式。\n\n如果一项改进只让某个指标变好，却显著损害其他关键指标，就不能简单地认定它是全局进步。\n\n---\n\n# 十二、与现有架构的集成边界\n\n| 模块 | 在可靠性体系中的职责 |\n|--------|--------|\n| GECO | 记录事件、追踪、产物血缘和实际操作证据 |\n| LTAR | 维护任务生命周期、检查点和恢复状态 |\n| RERA | 管理故障分类、重试、熔断、降级与恢复决策 |\n| TERSO | 执行工具操作、控制副作用并提供结果核验 |\n| SOCDEA | 分析故障根因并提出改进假设 |\n| UQEAG | 验证恢复后的产物是否满足最终验收要求 |\n| MEODT | 重新分配失败工作包、替换专家并协调团队恢复 |\n| Planner / DAG | 维护任务依赖、节点状态和受控重规划 |\n| CEKCE / CIL | 提供可替换的能力与工作流版本 |\n| TSEG / APE | 保证恢复、替换和重试不会突破安全边界 |\n| SELCIA | 管理可靠性改进的独立评测、发布和回滚 |\n| MTSRIC / ARCBG | 控制恢复期间的资源消耗、并发和预算 |\n| HACCG | 展示任务不确定性，支持用户暂停、取消和人工接管 |\n\n其中，RERA 应作为跨模块的可靠性策略层，而不是接管其他模块的全部职责。\n\n---\n\n# 十三、架构决策记录 ADR-761～ADR-780\n\n以下建议纳入 EvoAgent 全量架构，作为 RERA 的治理基线。\n\n这些是建议纳入全量架构的可靠性治理基线。进入工程实施阶段后，还需要定义 `FailureRecord`、`RetryPolicy`、`OperationLedger`、`RecoveryCheckpoint`、`RecoveryPlan`、`DependencyInvalidationPolicy` 和 `ReliabilityMetricCatalog` 的具体接口与状态机。\n\n---\n\n# 十四、第一版实施路线：先实现最小可靠性闭环\n\n对于 EvoAgent 的个人部署方向，建议先使用本地数据库、结构化事件、明确的状态机和受限执行器完成第一版，不必立即引入复杂的分布式容错系统。\n\n## 14.1 第一版必须通过的端到端测试\n\n建议用一个真实的代码修复任务完成验收：\n\n1. 创建任务，生成 DAG 并执行代码分析。\n2. 修改代码并运行测试。\n3. 在关键状态转换之间模拟进程崩溃。\n4. 重启系统，加载检查点并读取后续事件。\n5. 对账文件、工具操作和测试结果的实际状态。\n6. 仅恢复尚未完成且满足执行条件的节点。\n7. 验证没有重复修改、重复提交或丢失产物。\n8. 重新运行必要的回归测试。\n9. 由 UQEAG 根据真实证据判定最终结果。\n10. 由 GECO 保留完整的故障、恢复和验收轨迹。\n\n**核心验收标准不是“崩溃后程序能重新启动”，而是“重新启动后，系统能够准确判断哪些工作已完成、哪些状态未知、哪些工作可以安全继续”。**\n\n这才是复杂智能体真正需要的可靠性。\n\n---\n\n# 十五、下一专项：性能工程、资源调度与成本优化\n\n完成 RERA 后，EvoAgent 已经具备了任务执行、专家协作、运行观测、安全治理和故障恢复的基本架构。\n\n但还有一个与个人部署密切相关的问题尚未系统解决：\n\n**当 EvoAgent 同时拥有多个专家、模型适配器、记忆系统、工作流和后台进化任务时，怎样在有限的 CPU、内存、GPU、磁盘和网络资源下，让整个系统既足够聪明，又不会拖垮用户设备？**\n\n这不是简单的“减少模型调用”。\n\n例如：\n\n- Router 过于复杂，可能每次聊天都调用多个模型，导致响应变慢；\n- 记忆检索过度，可能每次任务都加载大量无关内容；\n- 多专家并行执行，可能同时占满内存；\n- 后台进化任务可能与用户的前台任务争抢 GPU；\n- 为了提高恢复能力而频繁创建检查点，可能产生大量磁盘写入；\n- 过度压缩上下文，可能减少 Token 消耗，却增加返工率；\n- 为了节省成本而切换低能力模型，可能使任务成功率下降，最终花费更多。\n\n因此，建议下一专项定义为：\n\n**Adaptive Performance &amp; Resource Optimization，简称 APRO。**\n\n重点研究：\n\n1. 如何建立模型、工具、专家、任务和设备的统一资源预算；\n2. 如何动态选择模型，而不是所有任务都使用最高成本模型；\n3. 如何在响应质量、延迟、Token、内存和外部费用之间进行权衡；\n4. 如何根据任务依赖和设备负载调整 DAG 并行度；\n5. 如何控制专家数量，避免协调成本超过协作收益；\n6. 如何决定记忆检索、上下文压缩和缓存的使用策略；\n7. 如何管理模型预热、驻留、卸载与后台任务；\n8. 如何在 Android、Windows 和微型 Linux 主机之间分配执行任务；\n9. 如何根据任务价值和截止条件分配计算资源；\n10. 如何优化检查点频率、事件存储和产物缓存；\n11. 如何识别无效模型调用、重复推理、无进展循环和高成本返工；\n12. 如何通过性能剖析发现真正的瓶颈，而不是凭感觉优化；\n13. 如何将性能改进纳入 SELCIA 的独立评测和回归体系；\n14. 如何保证资源优化不能绕过 TSEG 的安全门槛和 UQEAG 的质量要求。\n\n本专项的核心原则是：\n\n**优化的目标不是让每个模块单独运行得最快，而是让整个 EvoAgent 在满足质量、安全与可靠性要求的前提下，用合理的资源成本完成用户真正需要的任务。**\n\n这将把 EvoAgent 从“能够执行、能够恢复、能够自我改进的系统”，进一步推进到“能够根据任务价值、运行环境和资源约束，自适应地选择最合适执行策略的个人智能体”。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6-thinking","turn_exchange_id":"1dfaf30a-582d-43dc-b059-382695752272","request_id":"0e2fe8a1-5e00-4c87-9c91-79c8a005808a","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"working_turn_id":"1dfaf30a-582d-43dc-b059-382695752272","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":true,"parent_id":"cc06b4f8-3bdb-4adb-a28b-e4dc2240cb59","logical_answer_prefix_activity":{"visibility":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"},{"id":"bbb210de-f208-48ea-b2d2-4ded9297fef1","author":{"role":"user","name":null,"metadata":{}},"create_time":1792510428.147966,"update_time":1792510725.468884,"content":{"content_type":"text","parts":["继续"]},"status":"finished_successfully","end_turn":null,"weight":1.0,"metadata":{"model_slug":"gpt-6-thinking","default_model_slug":"gpt-6-thinking","is_visually_hidden_from_conversation":false,"search_result_groups":[],"search_queries":[],"image_results":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","real_time_audio_has_video":false,"system_hints":[],"dictation":false,"voice_mode_message":false,"trigger_async_ux":false,"writing_blocks":{},"request_id":"620ee1c0-586f-4db3-bd52-1d94e34759d8","message_source":null,"turn_exchange_id":"cb360f0f-d3c1-4f82-b30e-634b23a83a6b","working_turn_id":"cb360f0f-d3c1-4f82-b30e-634b23a83a6b","can_save":false},"recipient":"all","channel":null},{"id":"00359aab-58fb-481d-aa89-669744b4f649","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792510674.131316,"update_time":1792510674.154964,"content":{"content_type":"reasoning_recap","content":"思考了 4m 4s"},"status":"finished_successfully","end_turn":false,"weight":1.0,"metadata":{"reasoning_status":"reasoning_ended","finished_duration_sec":244,"reasoning_start_time":1792510429.1890786,"reasoning_end_time":1792510673.8227322,"reasoning_recap_type":"hide_all","cot_version":"v5","reasoning_group_id":"ac6bac5b-84be-4291-aa91-579f93cfdf85","conversation_followup_suggestions_eligible":false,"request_id":"620ee1c0-586f-4db3-bd52-1d94e34759d8","message_type":"next","turn_exchange_id":"cb360f0f-d3c1-4f82-b30e-634b23a83a6b","working_turn_id":"cb360f0f-d3c1-4f82-b30e-634b23a83a6b","model_slug":"gpt-6-thinking","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":false,"parent_id":"ea6c3637-10b7-4f35-bd08-f082574881ab","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"dcc0d8ac-32d9-4352-8d63-802ca281c53d","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792510441.592547,"update_time":1792510705.845577,"content":{"content_type":"text","parts":["# EvoAgent 第五十五专项：自适应性能、资源调度与成本优化\n\n<text color=\"secondary\" size=\"sm\">APRO · Adaptive Performance & Resource Optimization</text>\n\n前面已经完成了可靠性专项 RERA 的架构设计。现在进入 APRO，解决 EvoAgent 在个人设备上长期运行时的性能与资源问题。\n\n你的部署方向有一个很重要的特点：**以个人电脑、Android 手机和微型 Linux 主机为核心，不假设存在一台始终在线、资源无限的中央服务器。**\n\n因此，EvoAgent 不能简单照搬大型云端智能体的架构。它必须学会根据设备能力、任务难度、质量要求和当前负载，动态决定该使用什么模型、多少个专家、怎样执行 DAG，以及哪些工作应当延迟。\n\nAPRO 的目标不是单纯减少 Token，也不是让所有任务尽可能快，而是：\n\n**在满足任务质量、安全、可靠性和用户授权要求的前提下，尽量用更少的时间、计算资源和金钱完成任务。**\n\n例如，同样是代码任务：\n\n- 修改一个变量名，不需要启动多个专家；\n- 重构一个复杂模块，可能需要 AST 分析、测试专家和独立代码审查；\n- 生成 60 秒动态漫剧，可能需要大量云端生成预算和本地视频合成资源；\n- 手机正在发热或内存不足时，不应该强行运行多个本地模型；\n- 服务器断网时，应优先选择本地可执行的能力，而不是反复请求已经不可用的服务。\n\n这些场景不能依靠一套固定的模型选择规则解决。它们需要一个能够感知资源、预测成本、控制并发并从实际执行结果中学习的系统。\n\n---\n\n# 一、第一性原理：优化整个任务，而不是孤立的模块\n\nAPRO 首先要避免五种常见的优化误区。\n\n1. **模型越强越好。** 更强的模型可能提高单次推理质量，却不一定提高整个任务的成功率。\n2. **并行越多越快。** 多专家并行可能增加协调成本、内存占用和重复工作。\n3. **上下文越短越省钱。** 过度压缩可能丢失约束，导致返工成本超过节省的 Token。\n4. **缓存越多越高效。** 过期缓存可能使系统使用错误的技能版本、旧代码或失效的任务状态。\n5. **本地运行一定更便宜。** 本地模型可能耗时更长、占用更多内存，也可能使其他任务无法运行。\n\n真正的优化对象应该是整个任务的最终交付成本。\n\n## 1.1 建立统一的任务效用模型\n\n可以把一次任务的综合表现表示为：\n\n\\[\nJ =\nw_q Q +\nw_r R +\nw_t T +\nw_c C +\nw_m M +\nw_e E\n\\]\n\n其中：\n\n- \\(Q\\)：任务质量；\n- \\(R\\)：可靠性与恢复表现；\n- \\(T\\)：完成时间；\n- \\(C\\)：实际费用；\n- \\(M\\)：内存及其他资源占用；\n- \\(E\\)：能耗或设备负载。\n\n这里需要注意，质量和可靠性通常是越高越好，而时间、成本、资源占用通常是越低越好。因此，实现时不能直接对这些原始数值做简单加权求和，而应先进行归一化，并明确各项的优化方向。\n\n更重要的是，**安全、授权和必要的质量验收应当作为硬约束，而不是可以被其他收益抵消的普通评分项。**\n\n例如，不能因为某个策略降低了 50% 的成本，就允许它绕过必要的安全检查。\n\n实际调度可以采用两阶段决策：\n\n1. 先过滤掉违反安全、质量、授权和硬资源限制的方案；\n2. 再在剩余方案中比较延迟、费用、资源消耗和预期收益。\n\n## 1.2 区分三种优化目标\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"交互型任务\",\"优先保证响应速度、上下文连续性和用户体验。适用于聊天、简单问答与轻量操作。\"],\n    [\"交付型任务\",\"优先保证最终产物质量、可验证性与合理成本。适用于代码修改、文档制作和视频生成。\"],\n    [\"后台型任务\",\"优先控制资源占用、运行预算与对前台任务的影响。适用于评测、索引、记忆整理和进化实验。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"后台型任务\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n同一个模型或技能，在不同目标下可能具有完全不同的优先级。\n\n例如，后台进化任务即使能够更快完成，也不应该抢占用户正在使用的本地模型所需的全部内存。\n\n---\n\n# 二、总体架构：建立统一的资源感知与调度体系\n\n建议建立六个核心组件。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">1. Resource Monitor</title>\n    <text color=\"secondary\" size=\"sm\">采集 CPU、内存、GPU、磁盘、网络、设备温度、模型驻留和实际调用成本。</text>\n  </box>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">2. Workload Profiler</title>\n    <text color=\"secondary\" size=\"sm\">分析任务类型、历史耗时、成功率、资源需求和并行机会。</text>\n  </box>\n  <box border radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">3. Budget Manager</title>\n    <text color=\"secondary\" size=\"sm\">为任务、节点、模型调用、专家团队和后台进化分配预算。</text>\n  </box>\n  <box border radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">4. Adaptive Scheduler</title>\n    <text color=\"secondary\" size=\"sm\">选择模型与执行位置，调整 DAG 并行度、专家数量、优先级和降级策略。</text>\n  </box>\n  <box border radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">5. Cache & Context Optimizer</title>\n    <text color=\"secondary\" size=\"sm\">管理模型驻留、缓存、记忆检索、上下文组装和压缩策略。</text>\n  </box>\n  <box border radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">6. Performance Evaluator</title>\n    <text color=\"secondary\" size=\"sm\">比较实际表现与预测，评估策略是否真正提高了质量、效率和稳定性。</text>\n  </box>\n</box>\n\n这些组件通过统一的资源预算、任务状态和事件协议协作，不需要成为六个独立的 AI 智能体。\n\n第一版更适合采用确定性调度逻辑和简单的历史统计。随着数据积累，再逐步引入更复杂的预测与自适应策略。\n\n## 2.1 与已有模块的关系\n\n- Router 决定应该由哪个专家处理请求。\n- Planner 决定任务应该分解成哪些节点。\n- APRO 决定这些节点使用什么资源、何时执行、在哪里执行，以及是否需要降低并行度。\n- TERSO 负责落实工具执行与资源限制。\n- RERA 负责故障、重试、恢复和安全停止。\n- GECO 记录实际资源消耗与执行结果。\n- SELCIA 负责评测和发布经过验证的调度改进。\n\n因此，APRO 不应该取代 Router 或 Planner。\n\n**Router 解决能力匹配，Planner 解决任务分解，APRO 解决资源约束下的执行优化。**\n\n---\n\n# 三、统一资源模型：系统必须知道自己还能做什么\n\n如果 APRO 不知道设备当前的资源状况，就只能根据静态配置猜测。\n\n因此，建议建立 `ResourceSnapshot` 和 `ResourceBudget` 两类数据结构。\n\n## 3.1 ResourceSnapshot：当前资源快照\n\n至少应包含：\n\n| 资源类别 | 关键数据 |\n|---|---|\n| CPU | 可用核心数、负载、任务队列 |\n| 内存 | 可用内存、进程占用、模型驻留占用 |\n| GPU / NPU | 是否可用、显存或共享内存、当前任务占用 |\n| 磁盘 | 剩余空间、读写压力、临时文件占用 |\n| 网络 | 可用性、延迟、带宽估计 |\n| 模型运行时 | 已加载模型、加载耗时、并发限制 |\n| 外部费用 | 已使用预算、待确认费用、剩余预算 |\n| 设备状态 | 电池、温度、系统资源压力与运行限制 |\n\n并不是所有平台都能提供这些指标。例如，Android 应用可能无法直接获取完整的 GPU 占用或精确的系统级资源信息。\n\n因此，资源快照应当支持 `available`、`estimated` 和 `unknown` 等状态。不能把无法观测的资源当成无限可用。\n\n## 3.2 ResourceBudget：预算不是单一的金额\n\n建议将预算分成以下几个维度：\n\n- **时间预算**：任务允许运行多久；\n- **计算预算**：允许消耗多少 CPU、GPU 时间或推理资源；\n- **Token 预算**：模型输入和输出的允许范围；\n- **费用预算**：允许产生多少外部服务费用；\n- **内存预算**：任务可以占用多少内存；\n- **并发预算**：允许同时运行多少节点、专家和模型请求；\n- **重试预算**：失败后还能进行多少次尝试；\n- **返工预算**：质量不达标时允许多少轮修改。\n\n这些预算需要相互关联。\n\n例如，任务虽然还有 Token 额度，但如果剩余时间不足以完成最终验收，就不应该继续生成大量中间分析。\n\n同样，一个任务可能还有费用额度，但当前设备内存不足，此时应该等待、降级或迁移，而不是继续启动本地模型。\n\n## 3.3 预算采用分层继承与受控分配\n\n建议采用以下层级：\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  <box background=\"surface-secondary\" radius=\"md\" padding={3}>\n    **系统预算**\n\n    <text color=\"secondary\" size=\"sm\">整台设备的资源安全上限、并发限制与全局费用限制。</text>\n  </box>\n  <box padding={{left:3}} gap={2}>\n    <box border radius=\"md\" padding={3}>\n      **任务预算**\n\n      <text color=\"secondary\" size=\"sm\">由用户目标、截止时间、质量要求与授权决定。</text>\n    </box>\n    <box padding={{left:3}} gap={2}>\n      <box border radius=\"md\" padding={3}>\n        **DAG 节点预算**\n\n        <text color=\"secondary\" size=\"sm\">为分析、生成、测试、合成等节点分配资源。</text>\n      </box>\n      <box padding={{left:3}}>\n        <box border radius=\"md\" padding={3}>\n          **工具与模型调用预算**\n\n          <text color=\"secondary\" size=\"sm\">限制单次操作的超时、Token、费用和并发。</text>\n        </box>\n      </box>\n    </box>\n  </box>\n</box>\n\n下层预算不能突破上层剩余额度。\n\n同时，应区分“预留预算”和“实际消耗”。如果多个节点并行运行，每个节点都把整个任务的剩余额度当作自己可用的预算，就会出现预算超支。\n\n因此，APRO 应通过原子化预留、执行后结算和失败释放等机制管理资源。\n\n---\n\n# 四、动态模型选择：什么时候需要最强模型？\n\n这是 APRO 最重要的能力之一。\n\nEvoAgent 可能接入本地模型、远程模型以及不同价格、延迟和能力水平的模型适配器。不能简单规定所有任务都使用同一个模型，也不能只根据模型名称或参数规模选择。\n\n建议建立 `Model Selection Policy`。\n\n## 4.1 先定义任务所需的能力\n\n每个任务在进入模型调度前，应尽可能明确：\n\n- 任务类型；\n- 所需能力；\n- 难度与不确定性；\n- 质量验收要求；\n- 输入与输出规模；\n- 是否需要工具调用；\n- 是否涉及高风险操作；\n- 可接受的延迟；\n- 可接受的费用；\n- 可用模型与执行环境。\n\n这些信息可以由 Router、Planner、历史统计和任务契约共同提供，不应完全依赖模型自己给出的难度评分。\n\n## 4.2 建立候选模型能力表\n\n建议为每个模型适配器维护一个动态的 `ModelCapabilityProfile`。\n\n| 属性 | 用途 |\n|---|---|\n| 任务能力表现 | 在编程、推理、摘要等任务上的历史验收表现 |\n| 上下文容量 | 支持的输入长度与输出限制 |\n| 工具支持 | 是否支持所需的工具调用或结构化输出 |\n| 平均延迟 | 相似任务的历史执行耗时 |\n| 费用 | 输入、输出或其他计费方式 |\n| 资源需求 | 内存、GPU、CPU 与模型加载成本 |\n| 可靠性 | 超时率、失败率、恢复表现 |\n| 适用限制 | 隐私、联网、部署与授权要求 |\n\n模型能力数据应按任务类型分组，并随着实际评测持续更新。\n\n不能因为某个模型在通用问答中表现很好，就默认它在代码修复、复杂规划或结构化输出上同样优秀。\n\n## 4.3 采用逐级升级策略\n\n一个可实施的初始策略是：\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"第一级：低成本尝试\",\"使用已验证、成本较低且满足任务最低要求的模型或规则能力。\"],\n    [\"第二级：验证输出\",\"使用测试、Schema 校验、静态分析或其他独立方法检查结果。\"],\n    [\"第三级：针对性升级\",\"如果证据显示结果不合格或问题复杂度超出当前能力，则切换更适合的模型或专业技能。\"],\n    [\"第四级：高能力处理\",\"对复杂、歧义较大或高返工成本的任务，使用更强模型与必要的专家协作。\"],\n    [\"第五级：终止或请求协助\",\"如果预算耗尽、权限不足或无法验证结果，则暂停并说明限制，而不是无限升级。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"第五级：终止或请求协助\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这不是强制所有任务都从最低级开始。对于复杂代码迁移、高风险数据处理或明确要求高质量的任务，可以直接选择经过验证的高能力路径。\n\n逐级升级只是默认优化策略，不应增加不必要的尝试次数。\n\n## 4.4 比较总成本，而不是单次调用价格\n\n假设两个模型处理同一类代码任务：\n\n- 模型 A 单次调用成本较低，但经常需要返工；\n- 模型 B 单次调用成本较高，但更容易一次通过测试。\n\n如果只比较单次 Token 费用，可能会错误选择模型 A。\n\n更合理的比较是：\n\n\\[\nC_{\\text{effective}}\n=\nC_{\\text{inference}}\n+\nC_{\\text{tools}}\n+\nC_{\\text{rework}}\n+\nC_{\\text{recovery}}\n\\]\n\n其中包括推理成本、工具成本、返工成本和恢复成本。\n\n实际决策还需要考虑任务失败造成的时间损失，以及质量要求是否已经满足。\n\n例如，模型 A 虽然便宜，但如果它的输出无法通过测试，就不应该仅凭成本优势被选中。\n\n## 4.5 模型切换不能丢失关键上下文\n\n从本地模型切换到远程模型，或者从一个模型适配器切换到另一个模型时，系统必须重新构建经过验证的任务上下文。\n\n不能只把最近几轮聊天内容直接复制过去。\n\n建议传递：\n\n- 当前任务目标；\n- 经过验证的需求与约束；\n- 相关产物和版本；\n- 已经执行的操作；\n- 已知失败及其证据；\n- 剩余预算；\n- 仍然有效的授权范围；\n- 当前节点的验收条件。\n\n这与 ACMO、MEEG 和 CLEK 的上下文设计直接相关。APRO 决定上下文使用多少资源，而记忆与上下文模块负责确保传递的信息仍然准确、完整且适用。\n\n---\n\n# 五、多专家与 DAG 并行：并行不是越多越好\n\nEvoAgent 采用多专家架构，但专家数量增加后，资源开销并不是线性增长。\n\n多个专家可能各自加载模型、检索记忆、重复分析同一问题，还可能需要额外的协调与结果整合。\n\n因此，APRO 必须根据任务结构和设备资源动态决定并行度。\n\n## 5.1 建立 DAG 的资源感知调度\n\nPlanner 负责生成任务 DAG，APRO 负责在 DAG 的依赖约束下调度可执行节点。\n\n每个节点至少应声明：\n\n- 依赖节点；\n- 预计执行时间；\n- 预计内存与计算需求；\n- 预计费用；\n- 是否可并行；\n- 是否具有外部副作用；\n- 是否允许取消；\n- 失败后的恢复策略。\n\nAPRO 根据当前资源情况选择可运行节点，而不是简单地将所有已解锁节点同时启动。\n\n## 5.2 区分三类并行任务\n\n| 类型 | 处理策略 |\n|---|---|\n| 高度独立的任务 | 资源充足时优先并行执行 |\n| 有共享模型或资源竞争的任务 | 根据模型驻留、内存与队列情况调整并发 |\n| 存在冲突或强依赖的任务 | 按依赖顺序执行，或通过明确的隔离与合并机制控制冲突 |\n\n例如，两个专家分别分析两个互不相关的代码模块，可能适合并行。\n\n但两个专家同时修改同一个文件，可能造成冲突，增加合并和回归测试成本。\n\n即使 CPU 足够空闲，也不意味着同时修改同一个文件是更好的方案。\n\n## 5.3 估算并行收益\n\n假设任务有多个可并行节点。\n\n理想情况下，关键路径决定最低执行时间；但真实运行还会受到模型加载、资源竞争、任务启动和结果合并的影响。\n\n因此，APRO 应比较：\n\n- 串行执行的预计时间；\n- 并行执行的预计时间；\n- 并行额外消耗的资源；\n- 任务失败或冲突的概率；\n- 合并与验收所需的额外成本。\n\n只有预期收益足够大时，才增加并行度。\n\n## 5.4 专家团队规模应当动态调整\n\n建议将团队规模分为三种模式：\n\n- **单专家模式：** 适用于目标明确、依赖简单的任务；\n- **小团队模式：** 适用于需要专业分工或独立验证的任务；\n- **多专家模式：** 适用于复杂、可分解且并行收益明确的任务。\n\nAPRO 不应仅凭任务字数或表面复杂度增加专家。\n\n更有价值的判断是：新增专家是否能够提供独立的专业能力、减少关键路径耗时，或者提高验证质量。\n\n如果多个专家只是重复回答同一个问题，就应减少冗余调用。\n\n---\n\n# 六、记忆与上下文优化：省下的 Token 不能靠返工还回去\n\n这一部分与此前讨论的 ACMO、MEEG、CLEK 和各领域专家直接相关。\n\nAPRO 不能把上下文压缩当作一个全局统一的“缩短文本”任务。它需要根据任务阶段、专家职责和信息的重要性，决定哪些内容应该加载、哪些内容可以摘要、哪些内容必须保留原始证据。\n\n## 6.1 建立分层上下文预算\n\n建议把上下文分成五个逻辑层：\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"L0 · 全局控制上下文\",\"当前系统规则、授权边界、用户当前目标及必要的安全约束。\"],\n    [\"L1 · 任务上下文\",\"当前任务契约、验收标准、计划版本、预算和关键依赖。\"],\n    [\"L2 · 专家上下文\",\"当前专家的领域知识、工具使用约束、专业方法与相关历史经验。\"],\n    [\"L3 · 当前执行上下文\",\"当前节点输入、相关产物、近期结果、错误证据和待解决问题。\"],\n    [\"L4 · 按需读取内容\",\"完整文件、历史对话、详细日志、长文档和其他大型资料。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"L4 · 按需读取内容\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这里的层级是逻辑分层，不代表每次请求都必须把前四层完整复制到模型上下文中。\n\n系统应按任务需要选择内容，并确保不可省略的授权与验收约束在压缩和模型切换后仍然有效。\n\n## 6.2 压缩应保留什么？\n\n建议为上下文压缩建立独立的 `ContextRetentionPolicy`。\n\n高优先级信息包括：\n\n- 用户明确提出的约束；\n- 当前有效的授权；\n- 已验证的事实与证据引用；\n- 已完成的操作及其实际结果；\n- 尚未解决的问题；\n- 任务依赖和版本信息；\n- 不可逆操作的状态；\n- 失败原因及已尝试过的方法；\n- 最终验收条件。\n\n可压缩的信息包括重复解释、已经解决且不再影响当前任务的讨论，以及能够通过稳定引用重新读取的长文档。\n\n但对于代码任务，不应只保留“修改了某个函数”的摘要，而忽略实际代码版本、测试结果和变更差异。\n\n对于漫剧任务，也不能只保留“角色素材已生成”，而不保存角色版本、素材引用和质量验收状态。\n\n## 6.3 全局压缩与专家专用压缩应当分开\n\n建议保留两种能力：\n\n- **全局上下文治理：** 统一管理 token 预算、保留规则、隐私限制和任务连续性。\n- **领域专用压缩器：** 由不同专家针对特定内容使用适合的结构化表示。\n\n例如：\n\n- 编程专家可以保留 AST 结构、符号引用、代码差异和测试证据；\n- 漫剧专家可以保留角色 ID、场景 ID、分镜关系、时间线和素材版本；\n- 研究专家可以保留论点、来源、证据强度与待验证假设；\n- 数据分析专家可以保留数据 Schema、筛选条件、转换步骤和统计结果。\n\n这也回答了此前的一个重要问题：上下文压缩不应该只有一个通用算法，也不应该让每个专家各自发明一套互不兼容的记忆系统。\n\n**全局模块负责统一治理，领域模块负责专业表达。**\n\n## 6.4 缓存必须具备失效机制\n\n缓存可以减少重复推理、重复读取和重复生成，但需要明确缓存的适用条件。\n\n建议将缓存键与以下信息关联：\n\n- 输入内容摘要；\n- 任务或节点类型；\n- 模型与技能版本；\n- 关键配置；\n- 数据依赖版本；\n- 权限和隐私范围；\n- 必要的运行环境信息。\n\n如果代码文件发生变化，基于旧代码生成的分析缓存可能失效；如果技能版本升级，旧版本的执行结果也不应自动成为新版本正确性的证据。\n\n缓存只是一种性能优化，不是可信事实的替代品。\n\n---\n\n# 七、本地、远程与跨设备调度：根据任务选择执行位置\n\nEvoAgent 的部署路线不是单一云端系统，而是个人设备优先。\n\n因此，APRO 需要建立 `Execution Placement Policy`，决定任务应该在手机、个人电脑、微型 Linux 主机还是外部服务中执行。\n\n## 7.1 建立执行位置的选择维度\n\n| 维度 | 需要考虑的问题 |\n|---|---|\n| 能力匹配 | 该设备是否具备所需模型、工具与运行环境？ |\n| 资源条件 | 当前内存、计算能力和磁盘空间是否足够？ |\n| 网络条件 | 是否需要联网？网络延迟和稳定性如何？ |\n| 隐私要求 | 任务数据是否允许离开本地设备？ |\n| 执行成本 | 远程调用费用是否值得？ |\n| 恢复能力 | 任务中断后能否恢复，产物能否可靠同步？ |\n| 用户体验 | 是否会影响当前前台操作、电池或设备温度？ |\n\n不能只根据设备算力选择执行位置。\n\n例如，本地 Linux 主机可能有足够的计算能力，但如果某个任务涉及不能离开手机的私有数据，就不能为了速度自动把数据发送到远程服务。\n\n## 7.2 建立三种执行模式\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"Local-first · 本地优先\",\"优先使用本地工具、规则能力与适合的本地模型，适用于隐私要求高、网络不稳定或成本敏感的任务。\"],\n    [\"Hybrid · 混合执行\",\"本地负责数据准备、权限控制和产物处理，远程服务负责经授权的高成本或高能力生成。\"],\n    [\"Remote-assisted · 远程辅助\",\"在满足授权、隐私、费用和网络要求时，使用远程模型或设备完成特定步骤，本地保留任务治理与结果验收能力。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"Remote-assisted · 远程辅助\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这些是任务级执行策略，不是要求整个 EvoAgent 永远固定在其中一种模式。\n\n同一任务的不同节点可以采用不同执行位置，但每次跨设备或跨信任边界的数据传输，都必须重新检查授权和数据使用范围。\n\n## 7.3 断网时需要明确降级策略\n\n如果外部模型不可用，APRO 可以：\n\n1. 选择经过验证且能够完成该步骤的本地模型；\n2. 使用确定性工具或规则能力完成不需要模型的步骤；\n3. 暂停依赖外部服务的节点，继续执行独立节点；\n4. 保存检查点，等待网络恢复；\n5. 在预算或质量要求无法满足时，明确请求用户决策。\n\n不能为了让任务看起来持续运行，就用明显不具备相应能力的本地模型生成未经验证的结果。\n\n## 7.4 Android 必须考虑设备状态\n\n手机资源调度和桌面电脑不同。\n\n除了内存、CPU 和网络，APRO 还应考虑：\n\n- 电池电量与充电状态；\n- 设备温度与系统热限制；\n- 后台执行限制；\n- 用户是否正在进行前台交互；\n- 模型驻留对其他应用的影响。\n\n如果手机正在发热，可以暂停非必要的本地模型推理，延后后台索引和进化评测。\n\n但是，设备降温或资源释放不能通过跳过关键状态保存、授权检查或安全停止流程来实现。\n\n---\n\n# 八、成本控制：不只是 Token，更要关注返工和外部费用\n\nEvoAgent 未来可能接入代码执行、云端视频生成、语音合成、文件处理和其他第三方服务。\n\n这些服务的费用结构差异很大。单纯统计模型 Token，无法反映整个任务的真实成本。\n\n## 8.1 建立统一的 Cost Ledger\n\n建议建立 `CostLedger`，至少记录：\n\n- 任务与节点 ID；\n- 模型或服务名称；\n- 调用次数；\n- 输入与输出 Token；\n- 实际或估算费用；\n- 费用确认状态；\n- 重试与返工产生的费用；\n- 任务预算；\n- 剩余额度；\n- 成本对应的产物与验收结果。\n\n对于按量计费但账单延迟返回的外部服务，应区分已确认费用与估算费用。\n\nAPRO 不应将尚未确认的费用视为零。\n\n## 8.2 预算分配应根据任务结构决定\n\n例如，一个 AI 漫剧任务可以将预算划分为：\n\n- 剧本与分镜；\n- 角色和场景素材；\n- 视频片段生成；\n- 配音与音频处理；\n- 本地合成；\n- 质量验收；\n- 必要的返工预留。\n\n具体比例应根据服务定价、历史成功率和用户质量要求动态估算，而不是硬编码一个适用于所有任务的固定比例。\n\n如果前面的角色素材质量不达标，系统就不应该继续投入大量视频生成费用。\n\n## 8.3 采用阶段性投入策略\n\n对于高成本生成任务，建议在阶段边界进行质量门控：\n\n1. 先生成低成本的候选内容；\n2. 验证结构、时长、角色和基础质量；\n3. 只有满足条件后，才进入更昂贵的生成阶段；\n4. 保留必要的返工预算；\n5. 如果关键约束持续不满足，暂停并请求用户确认。\n\n这能避免错误的上游输入持续放大后续费用。\n\n## 8.4 评价成本时必须结合产出质量\n\n一个成本很低但最终不能交付的任务，不应被评为优化成功。\n\n建议同时比较：\n\n- 每个验收通过任务的平均成本；\n- 每个合格产物的平均成本；\n- 返工成本；\n- 失败任务的沉没成本；\n- 资源占用与耗时；\n- 质量是否达到用户要求。\n\n这使 APRO 优化的是“合格交付的成本”，而不是单纯的调用价格。\n\n---\n\n# 九、前台、后台与进化任务：资源优先级必须统一\n\nEvoAgent 不仅需要执行用户任务，还可能在后台进行记忆整理、技能评测、工作流分析和进化实验。\n\n如果这些任务各自独立调度，就可能发生资源争抢。\n\n例如，用户正在让编程专家修改代码，后台 SELCIA 同时启动多个候选模型评测，导致本地模型被卸载、内存压力上升，前台任务响应变慢。\n\n因此，建议 APRO 建立统一的 `WorkloadPriorityManager`。\n\n## 9.1 建立五类工作负载\n\n| 工作负载 | 默认优先级 | 调度原则 |\n|---|---|---|\n| 安全控制与关键状态持久化 | 最高 | 保证必要的授权撤销、状态记录与安全停止能力 |\n| 用户前台交互 | 高 | 优先保证响应性和当前任务连续性 |\n| 正在执行的关键任务 | 中高 | 尽量减少中断，保护已投入的计算与工作进度 |\n| 普通后台维护 | 中低 | 在资源充足时执行，可暂停和恢复 |\n| 进化实验与批量评测 | 低 | 使用剩余资源，必要时主动让出资源 |\n\n这是一套建议的默认优先级，不是所有任务都必须采用完全相同的固定顺序。\n\n例如，用户明确启动的大规模视频生成任务可能需要持续占用资源；而后台安全更新或授权撤销相关操作则不应被普通用户任务阻塞。\n\n## 9.2 防止优先级反转\n\n如果高优先级任务依赖某个低优先级任务持有的资源，就可能出现优先级反转。\n\n例如，前台任务需要加载模型，但后台任务占用了大部分内存。\n\nAPRO 可以在必要时暂停后台任务、释放非必要缓存，或者限制其继续申请资源。\n\n同时，关键任务也不能无限制地抢占所有资源，否则可能导致其他必要的系统维护永远无法完成。\n\n## 9.3 后台任务必须可暂停、可恢复\n\n建议后台进化和批量评测任务具备：\n\n- 明确的检查点；\n- 可释放的模型与内存资源；\n- 可暂停的工作单元；\n- 恢复后的版本核验；\n- 独立的预算；\n- 对前台资源压力的响应机制。\n\n当资源不足时，系统应优先暂停可恢复的后台任务，而不是让所有任务一起进入不可控状态。\n\n---\n\n# 十、性能分析与自适应优化：不要凭感觉调参\n\nAPRO 还需要解决一个长期问题：系统怎样知道真正的瓶颈在哪里？\n\n例如，任务响应慢，原因可能是：\n\n- Router 多次调用模型；\n- 模型加载时间过长；\n- DAG 并行度不足；\n- 工具执行等待外部服务；\n- 上下文过长；\n- 磁盘 I/O 成为瓶颈；\n- 多专家重复工作；\n- 返工次数过多。\n\n如果没有明确的性能证据，系统很容易优化错方向。\n\n## 10.1 建立端到端耗时分解\n\n建议为每个任务追踪以下耗时：\n\n\\[\nT_{\\text{total}}\n=\nT_{\\text{queue}}\n+\nT_{\\text{routing}}\n+\nT_{\\text{planning}}\n+\nT_{\\text{execution}}\n+\nT_{\\text{waiting}}\n+\nT_{\\text{validation}}\n\\]\n\n这只是便于诊断的概念分解。对于并行 DAG，端到端耗时不能简单地把所有节点耗时相加，而应结合关键路径和实际等待关系分析。\n\n例如，如果模型推理只占总耗时的 20%，即使把推理速度提升一倍，整个任务的耗时也不会减少一半。\n\n因此，APRO 应优先识别关键路径上的主要瓶颈。\n\n## 10.2 采用分层优化策略\n\n建议按以下顺序进行优化：\n\n1. **消除无效工作。** 减少重复推理、无效重试和冗余专家调用。\n2. **优化任务结构。** 改善 DAG 分解、依赖关系和数据传递。\n3. **优化上下文。** 减少无关内容，复用可验证的中间结果。\n4. **优化调度。** 调整并行度、优先级、模型驻留和资源分配。\n5. **优化单次执行。** 在前面几项完成后，再优化模型选择、推理参数和底层性能。\n\n这样可以避免用更快的模型掩盖糟糕的工作流设计。\n\n## 10.3 建立策略实验机制\n\n对于模型选择、并行度、上下文压缩和缓存策略，APRO 可以提出不同候选方案，并在隔离环境中比较。\n\n实验应固定或记录：\n\n- 任务样本；\n- 模型与技能版本；\n- 质量验收条件；\n- 资源环境；\n- 费用统计口径；\n- 测试数据；\n- 失败与恢复规则。\n\n如果实验环境与真实运行环境差异较大，系统不能直接把实验结果视为生产环境中的确定收益。\n\n## 10.4 优化策略必须可回滚\n\n例如，APRO 学到“增加专家数量可以提高复杂代码任务的成功率”。\n\n这条经验可能只在特定模型、设备和任务分布下成立。\n\n因此，策略发布后应继续监控：\n\n- 实际成功率；\n- 端到端耗时；\n- 返工率；\n- 费用；\n- 设备资源压力；\n- 不同任务类型的表现。\n\n一旦出现明显退化，就应恢复到经过验证的稳定策略，而不是让错误的自适应规则持续影响后续任务。\n\n---\n\n# 十一、APRO 与自进化的边界：调度器不能为了省资源破坏质量\n\nAPRO 本身也会成为进化对象。\n\n系统可能发现某个路由策略浪费了很多 Token，或者某个专家团队经常产生重复结果，于是提出优化方案。\n\n但资源优化很容易出现“局部指标改善、整体质量下降”的情况。\n\n例如：\n\n- 减少独立代码审查，降低成本，却增加缺陷漏检；\n- 缩短上下文，降低 Token 消耗，却导致需求约束丢失；\n- 减少回归测试，加快交付，却提高回归风险；\n- 降低检查点频率，减少磁盘写入，却增加崩溃后的重做成本；\n- 将所有任务切换到本地模型，降低外部费用，却导致任务无法在截止时间前完成。\n\n因此，APRO 必须接受三个不可突破的原则。\n\n**第一，安全与授权是硬约束。** 资源不足不能成为绕过 TSEG 的理由。\n\n**第二，任务验收标准不能由优化器自行降低。** UQEAG 的必要质量要求不能因为成本压力而自动消失。\n\n**第三，调度策略的进化必须独立评测。** 优化器不能只依据自己生成的预测值宣称成功，必须比较实际结果。\n\n建议将 APRO 的策略发布纳入 SELCIA，并要求 GECO 持续记录策略版本、实际资源消耗、质量结果和退化信号。\n\n---\n\n# 十二、架构决策记录 ADR-781～ADR-800\n\n以下建议纳入 EvoAgent 全量架构，作为 APRO 的治理基线。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"ADR-781\",\"建立统一资源快照\",\"为 CPU、内存、GPU、磁盘、网络、模型驻留和外部费用提供统一资源视图。\"],\n    [\"ADR-782\",\"区分可用、估算与未知资源\",\"不能把无法观测的资源当作无限可用。\"],\n    [\"ADR-783\",\"建立分层预算模型\",\"系统、任务、DAG 节点和单次调用分别管理资源预算。\"],\n    [\"ADR-784\",\"预算采用预留与结算机制\",\"并发节点不得重复使用同一份剩余额度。\"],\n    [\"ADR-785\",\"资源优化不得抵消硬约束\",\"安全、授权、必要质量和可靠性要求不能通过普通效用评分绕过。\"],\n    [\"ADR-786\",\"建立动态模型能力档案\",\"按任务类型评估模型质量、延迟、费用、资源需求与可靠性。\"],\n    [\"ADR-787\",\"模型选择基于任务要求\",\"不得仅根据模型名称、参数规模或通用排行榜选择模型。\"],\n    [\"ADR-788\",\"比较任务总成本\",\"将返工、恢复、工具调用和失败损失纳入成本评估。\"],\n    [\"ADR-789\",\"模型切换必须保持任务契约\",\"保留必要的目标、约束、证据、版本、授权和验收条件。\"],\n    [\"ADR-790\",\"建立资源感知 DAG 调度\",\"在依赖约束下，根据资源需求与关键路径调整并行度。\"],\n    [\"ADR-791\",\"专家数量必须具有明确收益\",\"避免重复推理、过度协调和无效并行。\"],\n    [\"ADR-792\",\"建立全局上下文预算\",\"统一治理保留规则、Token 预算、隐私与上下文连续性。\"],\n    [\"ADR-793\",\"允许领域专用压缩\",\"编程、漫剧、研究和数据分析可以使用各自的结构化上下文表示。\"],\n    [\"ADR-794\",\"缓存必须具备版本与失效条件\",\"过期缓存不得替代最新输入、当前授权或有效验收证据。\"],\n    [\"ADR-795\",\"建立执行位置策略\",\"综合能力、隐私、资源、网络、成本与恢复能力选择执行设备。\"],\n    [\"ADR-796\",\"资源压力下优先保护关键任务\",\"后台进化和批量评测应能够暂停、释放资源并恢复。\"],\n    [\"ADR-797\",\"建立端到端性能分析\",\"通过事件追踪、关键路径和资源采样定位真实瓶颈。\"],\n    [\"ADR-798\",\"性能策略必须通过对照评测\",\"固定任务、版本和验收口径，比较质量、延迟、成本和资源消耗。\"],\n    [\"ADR-799\",\"调度策略必须可回滚\",\"出现质量、稳定性或资源退化时恢复已验证的策略。\"],\n    [\"ADR-800\",\"APRO 不得修改自身治理门槛\",\"资源优化候选必须经过独立质量、安全与可靠性验证。\"]\n  ] as item}\n    <box gap={1}>\n      <row align=\"center\" gap={2}>\n        <badge>{item[0]}</badge>\n        <title size=\"md\">{item[1]}</title>\n      </row>\n      <text color=\"secondary\" size=\"sm\">{item[2]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些是建议纳入全量架构的资源治理基线。工程实施时，还需要进一步定义 `ResourceSnapshot`、`ResourceBudget`、`ModelCapabilityProfile`、`CostLedger`、`ExecutionPlacementPolicy` 和 `WorkloadPriorityManager` 的接口、状态机与持久化协议。\n\n---\n\n# 十三、第一版实施路线：先做可测量的优化，不急着让系统自主学习调度\n\n对于个人部署的 EvoAgent，APRO 第一版不需要训练一个复杂的资源调度模型。先把资源、费用、质量和执行耗时记录准确，通常比立即引入强化学习或复杂预测器更有价值。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"V0.1 · 资源与成本观测\",\"采集模型调用、Token、任务耗时、内存、费用和并发数据。\"],\n    [\"V0.2 · 预算与并发控制\",\"实现任务预算、节点预算、并发限制、超时和后台任务让步。\"],\n    [\"V0.3 · 动态模型选择\",\"根据任务类型、最低能力要求、费用与资源情况选择经过验证的模型。\"],\n    [\"V0.4 · DAG 资源调度\",\"根据依赖关系、关键路径、资源占用和冲突情况调整并行度。\"],\n    [\"V0.5 · 上下文与缓存优化\",\"实现按需检索、领域专用压缩、缓存版本校验和失效机制。\"],\n    [\"V0.6 · 本地与远程协同\",\"根据隐私、网络、资源和成本选择执行位置，并支持离线降级。\"],\n    [\"V1.0 · 受控自适应优化\",\"基于真实执行数据提出优化候选，经过对照评测后受控发布。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"V1.0 · 受控自适应优化\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n## 13.1 第一版的验收标准\n\n建议使用三种不同的任务验证 APRO：\n\n- 一个简单聊天任务；\n- 一个包含分析、修改和测试的代码任务；\n- 一个包含多个生成与合成阶段的漫剧任务。\n\n系统应当能够：\n\n1. 记录任务执行前的资源状态；\n2. 选择符合质量要求的模型和能力；\n3. 在资源不足时限制并发或延后后台任务；\n4. 记录每个节点的实际耗时与成本；\n5. 识别重复推理、无效重试和高成本返工；\n6. 保持上下文压缩后的任务约束和证据完整；\n7. 在模型切换或断网后维持有效的任务状态；\n8. 比较优化前后的质量、耗时、费用和资源占用；\n9. 在优化策略造成退化时回滚；\n10. 证明资源优化没有绕过安全、可靠性和最终验收要求。\n\n只有这些指标能够可靠测量，后续的自适应调度才有可信的学习基础。\n\n---\n\n# 十四、下一专项：质量工程、评测体系与结果可信度\n\n到这里，我们已经系统讨论了多个核心领域：\n\n- 多专家与协作机制；\n- Router、Plan、ReAct 与任务 DAG；\n- 记忆、上下文与领域专用能力；\n- GECO 全局观测与因果证据；\n- TSEG 安全与进化治理；\n- RERA 可靠性与恢复保证；\n- APRO 性能、资源与成本优化。\n\n但这些系统还存在一个共同问题：\n\n**我们如何知道 EvoAgent 真正变得更好了，而不是仅仅变得更快、更便宜、更复杂，或者更擅长让自己看起来成功？**\n\n这需要下一专项解决。\n\n建议将其定义为：\n\n**Quality Engineering & Evaluation Governance，简称 QEEG。**\n\n它将重点研究：\n\n1. 如何为不同专家、任务类型和工作流定义可执行的质量契约；\n2. 如何区分任务完成、产物合格、用户满意和长期效果；\n3. 如何为代码、文档、漫剧、研究与自动化任务建立不同的评测方法；\n4. 如何组合确定性测试、规则检查、模型评审与人工验收；\n5. 如何减少模型评审自身的偏差；\n6. 如何建立固定回归集、动态测试集和困难案例集；\n7. 如何评价 Router 是否选择了正确的专家；\n8. 如何评价 Planner 的分解方式是否合理；\n9. 如何评价记忆和上下文压缩是否丢失关键信息；\n10. 如何衡量多专家协作带来的真实增益；\n11. 如何区分随机波动、任务难度变化和真正的能力提升；\n12. 如何防止智能体通过修改评测器、降低标准或隐藏失败来制造虚假的进步；\n13. 如何让用户反馈转化为有证据的改进方向；\n14. 如何建立跨版本、跨模型、跨设备的可比较评测体系；\n15. 如何将质量门槛接入 SELCIA，使所有重要改进都必须证明自己的收益。\n\n这一专项尤其重要，因为它将成为所有自进化模块共同依赖的“进步判定体系”。\n\nAPRO 可以提出更高效的调度方案，RERA 可以提出更可靠的恢复方案，CEKCE 可以提出更好的技能，SOCDEA 可以提出根因修复方案。\n\n但最终都需要回答同一个问题：\n\n**改进之后，系统是否在真实任务上变得更好？**\n\n而且，这个结论必须有独立证据支持，不能仅由提出改进的模块自己宣布。\n\n这就是 QEEG 的核心使命：让 EvoAgent 的持续进化从“不断修改自己”，转变为“持续提出假设、独立验证收益，并只保留真正有效的改进”。"]},"status":"finished_successfully","end_turn":true,"weight":1.0,"metadata":{"is_merged_message":true,"source_message_ids":["15b4e052-dfee-4ba4-8d7e-dfd802b04df0","cf33ff68-6c76-4ce8-bc23-db219b685add","ec6e3037-0131-4e95-9c48-2d8f23d77d2d","88c77faf-fced-4647-b339-7e165f39be61","13db5591-9c7f-4e48-abd3-83ed6efc30b2"],"continuation_message_id":"13db5591-9c7f-4e48-abd3-83ed6efc30b2","model_dil_v2":{"code":"function __dilSafe(evaluate,failureValue){try{return evaluate()}catch{return failureValue}}\n\nDIL.render(__dil.jsx(()=>{const __dilConstants=DIL.useConstants();const __dilModelDataBindings=DIL.useAppData((appData)=>appData.opGenui?.modelDataBindings??{});return __dil.jsx(__dil.Fragment,null,__dil.jsx(\"title\",{\"size\":\"xl\"},__dilConstants[\"0\"]),__dil.jsx(\"text\",{\"color\":\"secondary\",\"size\":\"sm\"},__dilConstants[\"1\"]),__dil.jsx(\"text\",null,__dilConstants[\"2\"]),__dil.jsx(\"text\",null,__dilConstants[\"3\"],__dil.jsx(\"bold\",null,__dilConstants[\"4\"])),__dil.jsx(\"text\",null,__dilConstants[\"5\"]),__dil.jsx(\"text\",null,__dilConstants[\"6\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"7\"])),__dil.jsx(\"text\",null,__dilConstants[\"8\"]),__dil.jsx(\"list\",{\"marker\":\"bullet\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"9\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"10\"])),__di