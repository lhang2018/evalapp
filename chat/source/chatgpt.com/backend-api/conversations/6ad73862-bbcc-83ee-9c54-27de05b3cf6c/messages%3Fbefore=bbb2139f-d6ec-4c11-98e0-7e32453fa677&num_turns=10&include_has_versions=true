58\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"359\"]))),__dil.jsx(\"text\",null,__dilConstants[\"360\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"361\"])),__dil.jsx(\"text\",null,__dilConstants[\"362\"]),__dil.jsx(\"list\",{\"marker\":\"number\"},__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"363\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"364\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"365\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"366\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"367\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"368\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"369\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"370\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"371\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"372\"]))),__dil.jsx(\"text\",null,__dilConstants[\"373\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第二十七专项：工具运行时与能力插件治理","1":"这一轮要解决 EvoAgent 扩展能力时的基础问题：","2":"如何让智能体不断获得新工具和新能力，同时不让系统变得不可控、不可维护，或者因为工具升级而破坏已有专家。","3":"你之前提出过一个非常关键的设计方向：编程专家可能需要 AST 语法树、静态分析和测试工具；AI 漫剧专家需要图像生成、视频生成、配音和 FFmpeg；其他领域也可能拥有自己的专用技术。","4":"这些能力不应该全部塞进通用智能体，也不应该让每个专家自己随意安装、调用和管理工具。","5":"更合理的方式是建立一个统一的工具运行时，同时允许领域专家声明自己的能力需求、工具组合和验收标准。","6":"本专项建议定义为：","7":"Tool Runtime & Capability Plugin Governance，简称 TRCPG。","8":"它负责工具注册、能力发现、工具契约、执行隔离、结果验证、版本兼容、工具健康监测和插件生命周期管理。","9":"一、第一性原理：工具、技能、工作流和专家不是同一种东西","10":"首先要建立清晰的概念边界，否则系统会不断出现重复抽象。","11":"1. 工具 Tool","12":"完成一个边界明确的操作，例如解析 Python AST、读取文件、运行测试、调用视频生成 API。","13":"2. 技能 Skill","14":"将领域知识、判断方法、工具使用策略和验收要求组织起来，指导智能体完成某类工作。","15":"3. 工作流 Workflow","16":"定义多个步骤的依赖、分支、并行、重试、恢复和验收关系。","17":"4. 专家 Expert","18":"拥有领域目标理解、任务策略、专属记忆、能力选择和质量标准的领域智能体。","19":"5. 模型适配策略 Model Adapter","20":"负责将不同模型的输入输出、工具调用、上下文限制和能力差异适配到统一接口。","21":"举一个编程任务的例子：","22":"AST 解析器是工具；","23":"“跨文件重构前先分析符号引用”是技能或策略；","24":"“分析、修改、测试、验收、失败恢复”是工作流；","25":"编程专家负责理解用户的代码目标并决定使用哪种方案；","26":"模型适配器负责将该专家的推理请求转换为具体模型可执行的形式。","27":"这样，领域专家可以选择不同工具组合，而不用将所有工具实现细节写入提示词。","28":"二、建立三层能力架构","29":"我建议采用“能力声明层、工具治理层、执行运行时层”三层结构。","30":"能力声明层","31":"专家、技能、工作流声明所需能力与验收要求","32":"工具治理层","33":"工具注册、能力发现、契约验证、权限策略、版本与健康状态","34":"工具执行运行时","35":"参数校验、授权检查、资源调度、隔离执行、结果核验与审计","36":"本地工具","37":"文件、AST、Git、FFmpeg、本地模型","38":"外部工具","39":"搜索、云端模型、生成服务、外部 API","40":"这三层之间通过明确的接口协作，但不需要部署成三个独立服务。","41":"对个人使用的 EvoAgent，我建议先将工具治理和执行运行时放在同一个本地进程中；对需要隔离的命令执行、第三方插件或高风险工具，再使用独立子进程或受限执行环境。","42":"三、工具注册表：系统如何知道自己拥有哪些能力？","43":"不能仅仅保存一张“工具名称列表”。","44":"如果系统只知道存在一个叫 ","45":"python_tool","46":" 的工具，却不知道它能读取哪些目录、是否允许联网、会不会修改文件、支持什么参数、运行在哪个平台，那么就无法安全地选择和执行它。","47":"因此，建议建立统一的 ","48":"Tool Registry（工具注册表）","49":"。","50":"每个工具都必须声明：","51":"工具身份与版本；","52":"能力类别和用途；","53":"输入与输出 Schema；","54":"执行平台与运行环境；","55":"文件、网络、设备等访问需求；","56":"副作用类型；","57":"超时、取消和重试能力；","58":"幂等性与恢复能力；","59":"资源需求与费用；","60":"结果验证方式；","61":"兼容版本与依赖；","62":"健康状态和历史评测结果。","63":"3.1 工具能力不是一句自然语言描述","64":"例如，下面是一个概念性工具声明：","65":"0bbfc1ff-af81-5768-af19-2f8c2d11e849","66":null,"67":"这里的字段用于展示设计思路，不代表已经存在这个工具或已完成实现。实际 Schema 应采用明确的数据类型、必填约束和可执行的参数校验规则。","68":"特别需要注意：工具自己声明“只读”，并不意味着它就真的只能读取。执行运行时仍然需要通过操作系统权限、受限工作目录和实际执行方式来约束它。","69":"3.2 工具声明、工具能力和工具权限必须分开","70":"这是三个不同的概念：","71":"声明能力：","72":" 工具声称能够做什么。","73":"验证能力：","74":" 系统通过测试确认它实际上能做什么。","75":"授予权限：","76":" 系统允许它在当前任务中做什么。","77":"一个工具可能具有删除文件的技术能力，但某个任务只允许它读取文件。","78":"一个第三方插件也可能声明自己不访问网络，但在缺乏沙箱和运行时限制的情况下，系统不能仅凭声明就信任它。","79":"因此，注册成功并不意味着自动获得全部权限。","80":"四、能力发现与工具选择：专家如何找到合适的工具？","81":"当用户提出任务时，专家不应该凭工具名称猜测，也不应该让模型在所有工具中随意挑选。","82":"建议将工具选择设计为一个受约束的过程。","83":"4.1 选择工具不能只优化调用价格","84":"假设两个代码分析工具都能检查语法错误：","85":"工具 A：调用便宜、速度快，但无法解析项目的真实运行环境；","86":"工具 B：速度稍慢、成本较高，但能够识别特定版本的语法与类型约束。","87":"对于简单语法检查，A 可能更合适；对于复杂迁移任务，B 可能更值得使用。","88":"建议工具排序综合考虑：","89":"能力是否匹配；","90":"历史验收效果；","91":"输入输出契约是否可靠；","92":"当前版本是否兼容；","93":"权限与风险是否可接受；","94":"预期总成本；","95":"执行延迟；","96":"失败恢复能力。","97":"硬性约束必须先过滤，不能通过一个综合分数让高分工具绕过权限或兼容性检查。","98":"4.2 不要为所有任务都重新搜索全部工具","99":"工具发现也需要控制成本。","100":"建议对工具注册表建立能力索引，并按领域、输入类型、输出类型、平台和任务类型缩小候选范围。","101":"例如，编程专家优先查询代码分析、文件操作、测试和版本控制能力；漫剧专家优先查询图像、视频、音频和媒体处理能力。","102":"但如果领域内没有合适工具，系统仍然可以查询经过授权的共享工具，而不是把领域划分变成绝对封闭的工具列表。","103":"五、统一工具执行契约：调用成功不等于结果正确","104":"这是工具系统中最重要的工程边界之一。","105":"工具返回了一个正常结果，不代表任务已经成功；进程退出码为 0，也不代表生成的产物满足用户要求。","106":"例如：","107":"FFmpeg 成功退出，但输出视频时长不正确；","108":"代码测试命令执行成功，但实际上没有发现任何测试；","109":"浏览器提交表单成功，但目标业务状态尚未更新；","110":"图像生成服务返回图片，但角色一致性不合格；","111":"AST 分析器解析成功，但没有覆盖目标文件；","112":"文件写入成功，但写入了错误的工作目录。","113":"因此，工具执行需要分成至少四个阶段。","114":"这四个阶段应该分别记录状态和证据。","115":"5.1 统一执行结果结构","116":"建议工具执行器统一返回：","117":"tool_call_id","118":"；","119":"工具身份和实际版本；","120":"输入摘要与参数校验结果；","121":"执行状态；","122":"开始和结束时间；","123":"输出数据或产物引用；","124":"错误类别；","125":"外部任务 ID；","126":"副作用记录；","127":"结果验证证据；","128":"是否支持安全重试；","129":"是否需要后续对账。","130":"大型图片、视频、日志或代码文件应通过产物引用传递，而不是全部塞进一次工具返回值。","131":"5.2 统一错误分类","132":"工具失败不能只有一个 ","133":"error","134":" 字符串。","135":"建议至少区分：","136":"INVALID_INPUT","137":"：参数或 Schema 不合法；","138":"PERMISSION_DENIED","139":"：授权不足；","140":"UNAVAILABLE","141":"：工具或外部服务不可用；","142":"TIMEOUT","143":"：等待超时；","144":"RATE_LIMITED","145":"：触发限流；","146":"EXECUTION_FAILED","147":"：执行失败；","148":"OUTPUT_INVALID","149":"：结果格式或产物不符合契约；","150":"VERIFICATION_FAILED","151":"：结果存在，但未通过核验；","152":"OUTCOME_UNKNOWN","153":"：执行结果无法确定；","154":"CANCELLED","155":"：操作已取消或取消请求已确认生效。","156":"这些错误应该触发不同处理策略。","157":"例如，参数错误通常应修正输入；限流可能需要等待；权限不足不能通过无限重试解决；外部操作状态未知时必须先对账，而不是直接再次提交。","158":"5.3 重试必须由执行契约决定","159":"不能统一规定所有工具失败后都重试三次。","160":"对于只读、无副作用的操作，重试通常比较安全；对于支付、视频生成、消息发送和文件覆盖等操作，重复调用可能造成额外费用或重复副作用。","161":"因此，重试策略至少需要考虑：","162":"是否具有幂等键；","163":"外部系统是否支持查询操作状态；","164":"失败发生在提交前还是提交后；","165":"当前操作是否已经产生副作用；","166":"是否满足重试条件；","167":"预算和截止时间是否仍然允许。","168":"如果无法确认上一次操作是否已经执行，应该进入对账状态，而不是假设它失败了。","169":"六、执行隔离：工具可以扩展，但不能随意获得本机控制权","170":"EvoAgent 未来可能加载各种第三方工具和插件。它们的可信程度、运行方式和副作用差异很大，因此不能采用“注册成功就直接执行”的模式。","171":"我建议建立四种执行环境。","172":"E0 · 受控内置工具","173":"适用于经过审核的本地工具，例如只读文件查询、结构化数据校验和安全的计算操作。仍然必须执行参数与权限检查。","174":"E1 · 受限工作区执行","175":"适用于文件修改、代码测试、媒体合成等任务。只访问授权工作区，限制可写目录和资源使用。","176":"E2 · 隔离进程或沙箱","177":"适用于第三方插件、不可信代码和需要较强隔离的执行。根据平台能力限制文件、网络、进程和资源访问。","178":"E3 · 外部服务执行","179":"适用于云端模型、视频生成和外部 API。需要独立处理凭据、预算、网络错误、远端状态和数据传输边界。","180":"这里的 E0–E3 是 EvoAgent 的逻辑执行环境分类，不代表所有操作系统都能提供相同级别的隔离能力。","181":"6.1 第三方插件不能直接继承主进程的全部权限","182":"例如，一个新插件只需要解析 Markdown 文件，就不应该因为运行在 EvoAgent 内部而自动获得完整磁盘访问权、环境变量和网络访问权。","183":"建议遵循：","184":"插件默认没有额外权限；","185":"每项资源访问都需要明确授权；","186":"不可信插件优先运行在独立进程或受限环境；","187":"高风险操作经过统一执行网关；","188":"插件升级后重新验证能力与权限；","189":"插件不能自行修改注册表中的权限声明；","190":"插件不能直接修改安全根规则。","191":"尤其需要注意，单纯使用子进程并不等于实现了安全沙箱。如果子进程仍继承了全部环境变量、文件访问权和网络能力，隔离效果可能非常有限。","192":"6.2 工具与凭据分离","193":"工具注册表只需要引用凭据标识和所需权限，不应该把 API 密钥、密码或其他秘密直接写进普通工具描述、日志或模型上下文。","194":"实际调用时，由凭据管理组件在经过授权后提供必要凭据，并尽量限制：","195":"可调用的服务；","196":"可访问的数据；","197":"可用的费用额度；","198":"凭据有效期；","199":"是否允许委托；","200":"是否允许将请求内容发送到外部服务。","201":"工具日志也必须避免记录完整凭据和不必要的敏感数据。","202":"七、插件生命周期：安装、升级、停用和撤销都需要治理","203":"如果 EvoAgent 允许持续扩展工具能力，就必须管理插件从引入到退出的整个生命周期。","204":"建议定义以下状态：","205":"7.1 安装与启用分开","206":"下载一个插件不等于启用它。","207":"建议安装过程先验证：","208":"来源与完整性；","209":"版本和依赖；","210":"工具声明；","211":"所需权限；","212":"契约测试；","213":"已知风险；","214":"当前平台兼容性。","215":"通过检查后，才允许在指定范围内启用。","216":"7.2 升级必须产生新版本","217":"不要原地覆盖正在使用的工具实现。","218":"建议每次升级都创建新版本，记录变更内容、依赖和评测结果。","219":"新版本可以先在候选环境运行，再通过相关任务的回归测试和治理门槛后替换稳定版本。","220":"如果升级失败，应当能够恢复到已知稳定版本。正在执行的任务则应根据前面设计的配置快照与兼容性规则继续使用旧版本、迁移或安全暂停。","221":"7.3 工具可以失去资格","222":"工具注册并启用后，仍然可能因为以下情况被降级或停用：","223":"输出契约反复失效；","224":"失败率显著升高；","225":"发生未授权访问；","226":"费用异常增长；","227":"当前版本出现已知缺陷；","228":"外部服务长期不可用；","229":"实际能力与声明不一致。","230":"健康监测应将这些信息传递给 SHCRG，而是否停用、隔离或回滚则由工具治理与安全策略共同决定。","231":"八、领域专用能力包：让专家使用专业技术，而不是堆提示词","232":"这一部分直接回应你之前提出的 AST、编程优化，以及其他领域可能拥有特殊技术的问题。","233":"我建议在工具治理层之上，建立可版本化的 ","234":"Capability Pack（能力包）","235":"。","236":"能力包不是单个工具，而是围绕某一类任务组织起来的一组能力资产。","237":"8.1 编程专家能力包示例","238":"静态分析与 AST","239":"语法树解析、符号提取、依赖分析、调用关系与诊断结果。","240":"代码编辑与重构","241":"结构化代码修改、补丁生成、差异检查、冲突检测与格式保持。","242":"测试与验收","243":"单元测试、静态检查、类型检查、集成测试和任务级验收。","244":"Git 与变更管理","245":"独立工作区、变更集管理、版本比较、提交记录和受控合并。","246":"代码质量诊断","247":"错误分类、根因证据、修复候选、回归风险和失败模式分析。","248":"编程专家不需要知道每个工具的所有底层实现，但必须知道各能力的适用条件、前置要求、输出契约和验收标准。","249":"例如，简单文本修改可以使用常规编辑工具；跨文件重构则可能要求 AST、符号索引和调用关系分析。","250":"这不是让 AST 成为所有编程任务的固定步骤，而是让专家根据任务类型和风险选择适当的专业技术。","251":"8.2 AI 漫剧能力包示例","252":"漫剧能力包可以包含：","253":"剧本结构化与分镜规划；","254":"角色与场景素材管理；","255":"图像生成与角色一致性检查；","256":"视频生成与片段验收；","257":"配音、音频处理与字幕生成；","258":"FFmpeg 合成；","259":"产物索引与版本管理；","260":"最终视频质量验收；","261":"预算、重试与失败恢复。","262":"每一项能力可以使用不同工具实现，但整个能力包应保持稳定的接口和验收语义。","263":"例如，替换视频生成供应商时，不应该让整个漫剧专家重写；只要新工具满足所需契约，并通过适配与回归测试，就可以替换对应实现。","264":"8.3 能力包也需要独立版本","265":"建议每个能力包记录：","266":"能力包 ID 与版本；","267":"支持的任务类型；","268":"所需工具及兼容版本；","269":"前置条件；","270":"权限与资源需求；","271":"工作流模板；","272":"验收规则；","273":"评测集；","274":"已知限制；","275":"变更历史；","276":"依赖和回滚方案。","277":"能力包可以独立升级，但升级后的行为仍然必须受到任务配置快照、发布治理和回归测试的约束。","278":"九、工具进化：如何判断一个工具是否真的值得保留？","279":"工具数量增加不等于能力增强。","280":"假设 EvoAgent 安装了五个功能相似的代码分析器，其中两个长期没有带来额外收益，一个在复杂项目中经常失败，另一个只在旧环境中工作。","281":"如果没有工具评测和治理，注册表就会越来越复杂，工具选择成本也会增加。","282":"因此，建议让工具本身也接受评测，但必须区分：","283":"工具实现是否正确；","284":"工具是否适用于某类任务；","285":"工具相对其他工具是否有实际优势；","286":"工具是否值得承担维护和资源成本。","287":"9.1 建立工具评测体系","288":"每个重要工具应当有相应的测试：","289":"评测维度","290":"示例","291":"契约正确性","292":"输入校验、输出 Schema、错误格式","293":"能力有效性","294":"是否完成声明的具体操作","295":"结果可靠性","296":"是否存在漏检、误报或错误产物","297":"资源表现","298":"延迟、内存、CPU、GPU 与外部费用","299":"恢复能力","300":"超时、取消、重试和未知状态处理","301":"安全性","302":"权限边界、路径限制、凭据与网络访问","303":"兼容性","304":"不同平台、依赖和上下游版本","305":"维护成本","306":"安装难度、依赖复杂度、故障诊断难度","307":"工具评分不能只依赖它自己的输出。例如，代码分析器报告“没有错误”，不代表它真的没有漏检。评测应该使用已知结果的测试案例，验证实际能力。","308":"9.2 工具评测结果应反馈到路由和能力治理","309":"如果工具 A 在简单任务上速度更快，而工具 B 在复杂任务上准确率更高，系统可以形成条件化的工具选择策略。","310":"如果某工具在新版本中退化，则可以降低其适用范围、暂停新任务调用或回滚到稳定版本。","311":"但不能仅凭某一次失败就立即永久淘汰工具。应根据问题类型、样本规模、影响程度和可复现性决定处理方式。","312":"9.3 工具选择也必须考虑成本上限","313":"对于一个需要十几步执行的任务，工具调用成本可能远远超过最初的一次模型请求。","314":"因此，工具治理应当与预算系统共享同一套任务级约束。","315":"工具可以报告预计成本，但最终能否执行仍由资源调度和授权策略决定。","316":"当工具实际成本高于预计成本时，应更新预算记录，并根据任务策略决定是否继续、降级或暂停。","317":"十、工具系统如何与其他专项协作？","318":"工具治理不是一个孤立的模块。它需要与前面已经设计的系统形成明确的接口。","319":"相关系统","320":"工具治理需要提供或接收的内容","321":"Router","322":"各专家可用能力、平台约束和工具适用范围","323":"Planner / TODG","324":"工具前置条件、输入输出契约、依赖与恢复语义","325":"ReAct","326":"可调用工具的受限清单、执行结果与错误分类","327":"Memory Engine / MEEG","328":"工具使用经验、失败案例、验证过的适用条件","329":"Context Engine","330":"工具 Schema、必要说明、当前可用性和结果摘要","331":"ASEGE","332":"权限决策、执行环境要求、风险分类和审计","333":"SHCRG","334":"工具健康指标、失败率、成本趋势与版本退化","335":"SIEC","336":"事件、状态、版本、执行结果和跨模块关联协议","337":"TLCIG","338":"任务隔离、并发配额、资源租约、取消与恢复","339":"RCAE","340":"工具故障证据、诊断假设与候选修复建议","341":"这里有一个重要的设计原则：","342":"工具运行时负责可靠地执行操作，但不应该替代专家的领域判断，也不应该自己决定任务已经满足最终目标。","343":"例如，FFmpeg 工具可以确认编码进程已经结束；漫剧工作流仍然需要检查视频时长、分辨率、音轨、画面连续性和其他交付要求。","344":"同样，AST 工具可以返回符号引用分析结果；编程专家仍然需要判断这些结果是否足以支持当前重构方案。","345":"十一、建议冻结的架构决策","346":"这些是建议纳入 EvoAgent 全量架构的工具运行时与能力插件治理基线。正式实施时，还需要定义工具注册 Schema、执行协议、错误模型、插件清单、权限映射和工具评测标准。","347":"十二、下一专项：上下文工程与推理过程治理","348":"现在，我们已经设计了专家、工具、任务 DAG、记忆、经验进化、资源调度与安全治理。","349":"但还有一个核心问题值得专门研究：","350":"当智能体拥有大量记忆、工具、历史任务、工作流和专业知识时，究竟应该向模型提供什么信息、以什么顺序提供、提供多少，以及如何判断这些上下文真正帮助了推理？","351":"这是一个不能仅靠增加上下文窗口解决的问题。","352":"例如：","353":"编程专家检索了 50 条历史经验，但真正相关的只有 3 条；","354":"Planner 生成了很长的计划，执行时却遗漏了用户最初的硬性约束；","355":"ReAct 每轮都重新注入完整历史，导致 Token 成本持续增长；","356":"上下文压缩删除了失败恢复所需的关键状态；","357":"不同专家共享同一种压缩策略，导致领域特定信息被错误丢弃；","358":"工具结果包含大量日志，挤占了真正重要的任务目标；","359":"长任务中模型切换后，原有上下文结构不再适配新模型。","360":"下一专项建议定义为：","361":"Context Engineering & Reasoning Governance（上下文工程与推理治理，简称 CERG）。","362":"重点研究：","363":"如何区分系统规则、当前指令、任务状态、记忆、工具结果和历史推理材料；","364":"如何构建按任务阶段变化的动态上下文，而不是每轮重复拼接所有历史；","365":"如何在压缩过程中保留硬约束、未完成状态、关键证据和失败恢复信息；","366":"如何为不同专家设计独立的上下文策略，同时复用必要的通用机制；","367":"如何在 Planner、ReAct、DAG 节点和工具调用之间传递最小充分信息；","368":"如何评估上下文检索的相关性、遗漏率、冗余度与实际收益；","369":"如何管理 Token 预算、上下文窗口、成本和延迟；","370":"如何防止记忆、网页、工具输出中的不可信内容污染高优先级指令；","371":"如何在模型切换、任务恢复和版本升级时保持上下文语义一致；","372":"如何通过实验验证某种上下文组织方式是否真正提高了成功率、稳定性和效率。","373":"这一专项会直接影响 EvoAgent 的整体质量和调用成本：不仅要让模型获得更多信息，更要让它在正确的时间获得真正有用、可信、适用的信息。"},"fallbackMarkdown":"# EvoAgent 第二十七专项：工具运行时与能力插件治理\n\n这一轮要解决 EvoAgent 扩展能力时的基础问题：**如何让智能体不断获得新工具和新能力，同时不让系统变得不可控、不可维护，或者因为工具升级而破坏已有专家。**\n\n你之前提出过一个非常关键的设计方向：编程专家可能需要 AST 语法树、静态分析和测试工具；AI 漫剧专家需要图像生成、视频生成、配音和 FFmpeg；其他领域也可能拥有自己的专用技术。\n\n这些能力不应该全部塞进通用智能体，也不应该让每个专家自己随意安装、调用和管理工具。\n\n更合理的方式是建立一个统一的工具运行时，同时允许领域专家声明自己的能力需求、工具组合和验收标准。\n\n本专项建议定义为：\n\n**Tool Runtime &amp; Capability Plugin Governance，简称 TRCPG。**\n\n它负责工具注册、能力发现、工具契约、执行隔离、结果验证、版本兼容、工具健康监测和插件生命周期管理。\n\n## 一、第一性原理：工具、技能、工作流和专家不是同一种东西\n\n首先要建立清晰的概念边界，否则系统会不断出现重复抽象。\n\n### 1\\. 工具 Tool\n\n完成一个边界明确的操作，例如解析 Python AST、读取文件、运行测试、调用视频生成 API。\n\n---\n\n### 2\\. 技能 Skill\n\n将领域知识、判断方法、工具使用策略和验收要求组织起来，指导智能体完成某类工作。\n\n---\n\n### 3\\. 工作流 Workflow\n\n定义多个步骤的依赖、分支、并行、重试、恢复和验收关系。\n\n---\n\n### 4\\. 专家 Expert\n\n拥有领域目标理解、任务策略、专属记忆、能力选择和质量标准的领域智能体。\n\n---\n\n### 5\\. 模型适配策略 Model Adapter\n\n负责将不同模型的输入输出、工具调用、上下文限制和能力差异适配到统一接口。\n\n举一个编程任务的例子：\n\n- AST 解析器是工具；\n- “跨文件重构前先分析符号引用”是技能或策略；\n- “分析、修改、测试、验收、失败恢复”是工作流；\n- 编程专家负责理解用户的代码目标并决定使用哪种方案；\n- 模型适配器负责将该专家的推理请求转换为具体模型可执行的形式。\n\n这样，领域专家可以选择不同工具组合，而不用将所有工具实现细节写入提示词。\n\n## 二、建立三层能力架构\n\n我建议采用“能力声明层、工具治理层、执行运行时层”三层结构。\n\n**能力声明层**\n\n专家、技能、工作流声明所需能力与验收要求\n\n**工具治理层**\n\n工具注册、能力发现、契约验证、权限策略、版本与健康状态\n\n**工具执行运行时**\n\n参数校验、授权检查、资源调度、隔离执行、结果核验与审计\n\n**本地工具**\n\n文件、AST、Git、FFmpeg、本地模型\n\n**外部工具**\n\n搜索、云端模型、生成服务、外部 API\n\n这三层之间通过明确的接口协作，但不需要部署成三个独立服务。\n\n对个人使用的 EvoAgent，我建议先将工具治理和执行运行时放在同一个本地进程中；对需要隔离的命令执行、第三方插件或高风险工具，再使用独立子进程或受限执行环境。\n\n---\n\n# 三、工具注册表：系统如何知道自己拥有哪些能力？\n\n不能仅仅保存一张“工具名称列表”。\n\n如果系统只知道存在一个叫 `python_tool` 的工具，却不知道它能读取哪些目录、是否允许联网、会不会修改文件、支持什么参数、运行在哪个平台，那么就无法安全地选择和执行它。\n\n因此，建议建立统一的 **Tool Registry（工具注册表）**。\n\n每个工具都必须声明：\n\n- 工具身份与版本；\n- 能力类别和用途；\n- 输入与输出 Schema；\n- 执行平台与运行环境；\n- 文件、网络、设备等访问需求；\n- 副作用类型；\n- 超时、取消和重试能力；\n- 幂等性与恢复能力；\n- 资源需求与费用；\n- 结果验证方式；\n- 兼容版本与依赖；\n- 健康状态和历史评测结果。\n\n## 3.1 工具能力不是一句自然语言描述\n\n例如，下面是一个概念性工具声明：\n\n```json\n\n{\n  \"tool_id\": \"python.ast_analyzer\",\n  \"version\": \"1.0.0\",\n  \"category\": \"code_analysis\",\n  \"description\": \"Parse Python source and extract syntax structure\",\n  \"capabilities\": [\n    \"parse_python\",\n    \"extract_symbols\",\n    \"report_syntax_errors\"\n  ],\n  \"input_schema\": {\n    \"source_path\": \"authorized_workspace_file\",\n    \"python_version\": \"supported_runtime_version\"\n  },\n  \"output_schema\": {\n    \"syntax_valid\": \"boolean\",\n    \"symbols\": \"array\",\n    \"diagnostics\": \"array\"\n  },\n  \"side_effects\": {\n    \"filesystem\": \"read_only\",\n    \"network\": \"none\"\n  },\n  \"execution\": {\n    \"platforms\": [\"windows\", \"linux\"],\n    \"timeout_seconds\": 10,\n    \"cancellable\": true\n  },\n  \"verification\": {\n    \"method\": \"parse_result_and_diagnostics\"\n  }\n}\n```\n\n这里的字段用于展示设计思路，不代表已经存在这个工具或已完成实现。实际 Schema 应采用明确的数据类型、必填约束和可执行的参数校验规则。\n\n特别需要注意：工具自己声明“只读”，并不意味着它就真的只能读取。执行运行时仍然需要通过操作系统权限、受限工作目录和实际执行方式来约束它。\n\n## 3.2 工具声明、工具能力和工具权限必须分开\n\n这是三个不同的概念：\n\n- **声明能力：** 工具声称能够做什么。\n- **验证能力：** 系统通过测试确认它实际上能做什么。\n- **授予权限：** 系统允许它在当前任务中做什么。\n\n一个工具可能具有删除文件的技术能力，但某个任务只允许它读取文件。\n\n一个第三方插件也可能声明自己不访问网络，但在缺乏沙箱和运行时限制的情况下，系统不能仅凭声明就信任它。\n\n因此，注册成功并不意味着自动获得全部权限。\n\n---\n\n# 四、能力发现与工具选择：专家如何找到合适的工具？\n\n当用户提出任务时，专家不应该凭工具名称猜测，也不应该让模型在所有工具中随意挑选。\n\n建议将工具选择设计为一个受约束的过程。\n\n## 4.1 选择工具不能只优化调用价格\n\n假设两个代码分析工具都能检查语法错误：\n\n- 工具 A：调用便宜、速度快，但无法解析项目的真实运行环境；\n- 工具 B：速度稍慢、成本较高，但能够识别特定版本的语法与类型约束。\n\n对于简单语法检查，A 可能更合适；对于复杂迁移任务，B 可能更值得使用。\n\n建议工具排序综合考虑：\n\n- 能力是否匹配；\n- 历史验收效果；\n- 输入输出契约是否可靠；\n- 当前版本是否兼容；\n- 权限与风险是否可接受；\n- 预期总成本；\n- 执行延迟；\n- 失败恢复能力。\n\n硬性约束必须先过滤，不能通过一个综合分数让高分工具绕过权限或兼容性检查。\n\n## 4.2 不要为所有任务都重新搜索全部工具\n\n工具发现也需要控制成本。\n\n建议对工具注册表建立能力索引，并按领域、输入类型、输出类型、平台和任务类型缩小候选范围。\n\n例如，编程专家优先查询代码分析、文件操作、测试和版本控制能力；漫剧专家优先查询图像、视频、音频和媒体处理能力。\n\n但如果领域内没有合适工具，系统仍然可以查询经过授权的共享工具，而不是把领域划分变成绝对封闭的工具列表。\n\n---\n\n# 五、统一工具执行契约：调用成功不等于结果正确\n\n这是工具系统中最重要的工程边界之一。\n\n工具返回了一个正常结果，不代表任务已经成功；进程退出码为 0，也不代表生成的产物满足用户要求。\n\n例如：\n\n- FFmpeg 成功退出，但输出视频时长不正确；\n- 代码测试命令执行成功，但实际上没有发现任何测试；\n- 浏览器提交表单成功，但目标业务状态尚未更新；\n- 图像生成服务返回图片，但角色一致性不合格；\n- AST 分析器解析成功，但没有覆盖目标文件；\n- 文件写入成功，但写入了错误的工作目录。\n\n因此，工具执行需要分成至少四个阶段。\n\n这四个阶段应该分别记录状态和证据。\n\n## 5.1 统一执行结果结构\n\n建议工具执行器统一返回：\n\n- `tool_call_id`；\n- 工具身份和实际版本；\n- 输入摘要与参数校验结果；\n- 执行状态；\n- 开始和结束时间；\n- 输出数据或产物引用；\n- 错误类别；\n- 外部任务 ID；\n- 副作用记录；\n- 结果验证证据；\n- 是否支持安全重试；\n- 是否需要后续对账。\n\n大型图片、视频、日志或代码文件应通过产物引用传递，而不是全部塞进一次工具返回值。\n\n## 5.2 统一错误分类\n\n工具失败不能只有一个 `error` 字符串。\n\n建议至少区分：\n\n- `INVALID_INPUT`：参数或 Schema 不合法；\n- `PERMISSION_DENIED`：授权不足；\n- `UNAVAILABLE`：工具或外部服务不可用；\n- `TIMEOUT`：等待超时；\n- `RATE_LIMITED`：触发限流；\n- `EXECUTION_FAILED`：执行失败；\n- `OUTPUT_INVALID`：结果格式或产物不符合契约；\n- `VERIFICATION_FAILED`：结果存在，但未通过核验；\n- `OUTCOME_UNKNOWN`：执行结果无法确定；\n- `CANCELLED`：操作已取消或取消请求已确认生效。\n\n这些错误应该触发不同处理策略。\n\n例如，参数错误通常应修正输入；限流可能需要等待；权限不足不能通过无限重试解决；外部操作状态未知时必须先对账，而不是直接再次提交。\n\n## 5.3 重试必须由执行契约决定\n\n不能统一规定所有工具失败后都重试三次。\n\n对于只读、无副作用的操作，重试通常比较安全；对于支付、视频生成、消息发送和文件覆盖等操作，重复调用可能造成额外费用或重复副作用。\n\n因此，重试策略至少需要考虑：\n\n- 是否具有幂等键；\n- 外部系统是否支持查询操作状态；\n- 失败发生在提交前还是提交后；\n- 当前操作是否已经产生副作用；\n- 是否满足重试条件；\n- 预算和截止时间是否仍然允许。\n\n如果无法确认上一次操作是否已经执行，应该进入对账状态，而不是假设它失败了。\n\n---\n\n# 六、执行隔离：工具可以扩展，但不能随意获得本机控制权\n\nEvoAgent 未来可能加载各种第三方工具和插件。它们的可信程度、运行方式和副作用差异很大，因此不能采用“注册成功就直接执行”的模式。\n\n我建议建立四种执行环境。\n\n### E0 · 受控内置工具\n\n适用于经过审核的本地工具，例如只读文件查询、结构化数据校验和安全的计算操作。仍然必须执行参数与权限检查。\n\n---\n\n### E1 · 受限工作区执行\n\n适用于文件修改、代码测试、媒体合成等任务。只访问授权工作区，限制可写目录和资源使用。\n\n---\n\n### E2 · 隔离进程或沙箱\n\n适用于第三方插件、不可信代码和需要较强隔离的执行。根据平台能力限制文件、网络、进程和资源访问。\n\n---\n\n### E3 · 外部服务执行\n\n适用于云端模型、视频生成和外部 API。需要独立处理凭据、预算、网络错误、远端状态和数据传输边界。\n\n这里的 E0–E3 是 EvoAgent 的逻辑执行环境分类，不代表所有操作系统都能提供相同级别的隔离能力。\n\n## 6.1 第三方插件不能直接继承主进程的全部权限\n\n例如，一个新插件只需要解析 Markdown 文件，就不应该因为运行在 EvoAgent 内部而自动获得完整磁盘访问权、环境变量和网络访问权。\n\n建议遵循：\n\n- 插件默认没有额外权限；\n- 每项资源访问都需要明确授权；\n- 不可信插件优先运行在独立进程或受限环境；\n- 高风险操作经过统一执行网关；\n- 插件升级后重新验证能力与权限；\n- 插件不能自行修改注册表中的权限声明；\n- 插件不能直接修改安全根规则。\n\n尤其需要注意，单纯使用子进程并不等于实现了安全沙箱。如果子进程仍继承了全部环境变量、文件访问权和网络能力，隔离效果可能非常有限。\n\n## 6.2 工具与凭据分离\n\n工具注册表只需要引用凭据标识和所需权限，不应该把 API 密钥、密码或其他秘密直接写进普通工具描述、日志或模型上下文。\n\n实际调用时，由凭据管理组件在经过授权后提供必要凭据，并尽量限制：\n\n- 可调用的服务；\n- 可访问的数据；\n- 可用的费用额度；\n- 凭据有效期；\n- 是否允许委托；\n- 是否允许将请求内容发送到外部服务。\n\n工具日志也必须避免记录完整凭据和不必要的敏感数据。\n\n---\n\n# 七、插件生命周期：安装、升级、停用和撤销都需要治理\n\n如果 EvoAgent 允许持续扩展工具能力，就必须管理插件从引入到退出的整个生命周期。\n\n建议定义以下状态：\n\n## 7.1 安装与启用分开\n\n下载一个插件不等于启用它。\n\n建议安装过程先验证：\n\n- 来源与完整性；\n- 版本和依赖；\n- 工具声明；\n- 所需权限；\n- 契约测试；\n- 已知风险；\n- 当前平台兼容性。\n\n通过检查后，才允许在指定范围内启用。\n\n## 7.2 升级必须产生新版本\n\n不要原地覆盖正在使用的工具实现。\n\n建议每次升级都创建新版本，记录变更内容、依赖和评测结果。\n\n新版本可以先在候选环境运行，再通过相关任务的回归测试和治理门槛后替换稳定版本。\n\n如果升级失败，应当能够恢复到已知稳定版本。正在执行的任务则应根据前面设计的配置快照与兼容性规则继续使用旧版本、迁移或安全暂停。\n\n## 7.3 工具可以失去资格\n\n工具注册并启用后，仍然可能因为以下情况被降级或停用：\n\n- 输出契约反复失效；\n- 失败率显著升高；\n- 发生未授权访问；\n- 费用异常增长；\n- 当前版本出现已知缺陷；\n- 外部服务长期不可用；\n- 实际能力与声明不一致。\n\n健康监测应将这些信息传递给 SHCRG，而是否停用、隔离或回滚则由工具治理与安全策略共同决定。\n\n---\n\n# 八、领域专用能力包：让专家使用专业技术，而不是堆提示词\n\n这一部分直接回应你之前提出的 AST、编程优化，以及其他领域可能拥有特殊技术的问题。\n\n我建议在工具治理层之上，建立可版本化的 **Capability Pack（能力包）**。\n\n能力包不是单个工具，而是围绕某一类任务组织起来的一组能力资产。\n\n## 8.1 编程专家能力包示例\n\n### 静态分析与 AST\n\n语法树解析、符号提取、依赖分析、调用关系与诊断结果。\n\n---\n\n### 代码编辑与重构\n\n结构化代码修改、补丁生成、差异检查、冲突检测与格式保持。\n\n---\n\n### 测试与验收\n\n单元测试、静态检查、类型检查、集成测试和任务级验收。\n\n---\n\n### Git 与变更管理\n\n独立工作区、变更集管理、版本比较、提交记录和受控合并。\n\n---\n\n### 代码质量诊断\n\n错误分类、根因证据、修复候选、回归风险和失败模式分析。\n\n编程专家不需要知道每个工具的所有底层实现，但必须知道各能力的适用条件、前置要求、输出契约和验收标准。\n\n例如，简单文本修改可以使用常规编辑工具；跨文件重构则可能要求 AST、符号索引和调用关系分析。\n\n这不是让 AST 成为所有编程任务的固定步骤，而是让专家根据任务类型和风险选择适当的专业技术。\n\n## 8.2 AI 漫剧能力包示例\n\n漫剧能力包可以包含：\n\n- 剧本结构化与分镜规划；\n- 角色与场景素材管理；\n- 图像生成与角色一致性检查；\n- 视频生成与片段验收；\n- 配音、音频处理与字幕生成；\n- FFmpeg 合成；\n- 产物索引与版本管理；\n- 最终视频质量验收；\n- 预算、重试与失败恢复。\n\n每一项能力可以使用不同工具实现，但整个能力包应保持稳定的接口和验收语义。\n\n例如，替换视频生成供应商时，不应该让整个漫剧专家重写；只要新工具满足所需契约，并通过适配与回归测试，就可以替换对应实现。\n\n## 8.3 能力包也需要独立版本\n\n建议每个能力包记录：\n\n- 能力包 ID 与版本；\n- 支持的任务类型；\n- 所需工具及兼容版本；\n- 前置条件；\n- 权限与资源需求；\n- 工作流模板；\n- 验收规则；\n- 评测集；\n- 已知限制；\n- 变更历史；\n- 依赖和回滚方案。\n\n能力包可以独立升级，但升级后的行为仍然必须受到任务配置快照、发布治理和回归测试的约束。\n\n---\n\n# 九、工具进化：如何判断一个工具是否真的值得保留？\n\n工具数量增加不等于能力增强。\n\n假设 EvoAgent 安装了五个功能相似的代码分析器，其中两个长期没有带来额外收益，一个在复杂项目中经常失败，另一个只在旧环境中工作。\n\n如果没有工具评测和治理，注册表就会越来越复杂，工具选择成本也会增加。\n\n因此，建议让工具本身也接受评测，但必须区分：\n\n- 工具实现是否正确；\n- 工具是否适用于某类任务；\n- 工具相对其他工具是否有实际优势；\n- 工具是否值得承担维护和资源成本。\n\n## 9.1 建立工具评测体系\n\n每个重要工具应当有相应的测试：\n\n| 评测维度 | 示例 |\n|--------|--------|\n| 契约正确性 | 输入校验、输出 Schema、错误格式 |\n| 能力有效性 | 是否完成声明的具体操作 |\n| 结果可靠性 | 是否存在漏检、误报或错误产物 |\n| 资源表现 | 延迟、内存、CPU、GPU 与外部费用 |\n| 恢复能力 | 超时、取消、重试和未知状态处理 |\n| 安全性 | 权限边界、路径限制、凭据与网络访问 |\n| 兼容性 | 不同平台、依赖和上下游版本 |\n| 维护成本 | 安装难度、依赖复杂度、故障诊断难度 |\n\n工具评分不能只依赖它自己的输出。例如，代码分析器报告“没有错误”，不代表它真的没有漏检。评测应该使用已知结果的测试案例，验证实际能力。\n\n## 9.2 工具评测结果应反馈到路由和能力治理\n\n如果工具 A 在简单任务上速度更快，而工具 B 在复杂任务上准确率更高，系统可以形成条件化的工具选择策略。\n\n如果某工具在新版本中退化，则可以降低其适用范围、暂停新任务调用或回滚到稳定版本。\n\n但不能仅凭某一次失败就立即永久淘汰工具。应根据问题类型、样本规模、影响程度和可复现性决定处理方式。\n\n## 9.3 工具选择也必须考虑成本上限\n\n对于一个需要十几步执行的任务，工具调用成本可能远远超过最初的一次模型请求。\n\n因此，工具治理应当与预算系统共享同一套任务级约束。\n\n工具可以报告预计成本，但最终能否执行仍由资源调度和授权策略决定。\n\n当工具实际成本高于预计成本时，应更新预算记录，并根据任务策略决定是否继续、降级或暂停。\n\n---\n\n# 十、工具系统如何与其他专项协作？\n\n工具治理不是一个孤立的模块。它需要与前面已经设计的系统形成明确的接口。\n\n| 相关系统 | 工具治理需要提供或接收的内容 |\n|--------|--------|\n| Router | 各专家可用能力、平台约束和工具适用范围 |\n| Planner / TODG | 工具前置条件、输入输出契约、依赖与恢复语义 |\n| ReAct | 可调用工具的受限清单、执行结果与错误分类 |\n| Memory Engine / MEEG | 工具使用经验、失败案例、验证过的适用条件 |\n| Context Engine | 工具 Schema、必要说明、当前可用性和结果摘要 |\n| ASEGE | 权限决策、执行环境要求、风险分类和审计 |\n| SHCRG | 工具健康指标、失败率、成本趋势与版本退化 |\n| SIEC | 事件、状态、版本、执行结果和跨模块关联协议 |\n| TLCIG | 任务隔离、并发配额、资源租约、取消与恢复 |\n| RCAE | 工具故障证据、诊断假设与候选修复建议 |\n\n这里有一个重要的设计原则：\n\n**工具运行时负责可靠地执行操作，但不应该替代专家的领域判断，也不应该自己决定任务已经满足最终目标。**\n\n例如，FFmpeg 工具可以确认编码进程已经结束；漫剧工作流仍然需要检查视频时长、分辨率、音轨、画面连续性和其他交付要求。\n\n同样，AST 工具可以返回符号引用分析结果；编程专家仍然需要判断这些结果是否足以支持当前重构方案。\n\n---\n\n# 十一、建议冻结的架构决策\n\n这些是建议纳入 EvoAgent 全量架构的工具运行时与能力插件治理基线。正式实施时，还需要定义工具注册 Schema、执行协议、错误模型、插件清单、权限映射和工具评测标准。\n\n# 十二、下一专项：上下文工程与推理过程治理\n\n现在，我们已经设计了专家、工具、任务 DAG、记忆、经验进化、资源调度与安全治理。\n\n但还有一个核心问题值得专门研究：\n\n**当智能体拥有大量记忆、工具、历史任务、工作流和专业知识时，究竟应该向模型提供什么信息、以什么顺序提供、提供多少，以及如何判断这些上下文真正帮助了推理？**\n\n这是一个不能仅靠增加上下文窗口解决的问题。\n\n例如：\n\n- 编程专家检索了 50 条历史经验，但真正相关的只有 3 条；\n- Planner 生成了很长的计划，执行时却遗漏了用户最初的硬性约束；\n- ReAct 每轮都重新注入完整历史，导致 Token 成本持续增长；\n- 上下文压缩删除了失败恢复所需的关键状态；\n- 不同专家共享同一种压缩策略，导致领域特定信息被错误丢弃；\n- 工具结果包含大量日志，挤占了真正重要的任务目标；\n- 长任务中模型切换后，原有上下文结构不再适配新模型。\n\n下一专项建议定义为：\n\n**Context Engineering &amp; Reasoning Governance（上下文工程与推理治理，简称 CERG）。**\n\n重点研究：\n\n1. 如何区分系统规则、当前指令、任务状态、记忆、工具结果和历史推理材料；\n2. 如何构建按任务阶段变化的动态上下文，而不是每轮重复拼接所有历史；\n3. 如何在压缩过程中保留硬约束、未完成状态、关键证据和失败恢复信息；\n4. 如何为不同专家设计独立的上下文策略，同时复用必要的通用机制；\n5. 如何在 Planner、ReAct、DAG 节点和工具调用之间传递最小充分信息；\n6. 如何评估上下文检索的相关性、遗漏率、冗余度与实际收益；\n7. 如何管理 Token 预算、上下文窗口、成本和延迟；\n8. 如何防止记忆、网页、工具输出中的不可信内容污染高优先级指令；\n9. 如何在模型切换、任务恢复和版本升级时保持上下文语义一致；\n10. 如何通过实验验证某种上下文组织方式是否真正提高了成功率、稳定性和效率。\n\n这一专项会直接影响 EvoAgent 的整体质量和调用成本：不仅要让模型获得更多信息，更要让它在正确的时间获得真正有用、可信、适用的信息。","fallbackMarkdownVersion":1,"clientDefinedWidgets":{"0bbfc1ff-af81-5768-af19-2f8c2d11e849":{"status":"resolved","refIndex":0,"isStreaming":false}},"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6","turn_exchange_id":"ff0de010-4494-4fe5-92b1-77d2d4437c2d","request_id":"6848faab-be20-4b9d-a778-bca0028774f6","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[{"type":"client_defined_widget","category":"code_block","data":{"content":"\n{\n  \"tool_id\": \"python.ast_analyzer\",\n  \"version\": \"1.0.0\",\n  \"category\": \"code_analysis\",\n  \"description\": \"Parse Python source and extract syntax structure\",\n  \"capabilities\": [\n    \"parse_python\",\n    \"extract_symbols\",\n    \"report_syntax_errors\"\n  ],\n  \"input_schema\": {\n    \"source_path\": \"authorized_workspace_file\",\n    \"python_version\": \"supported_runtime_version\"\n  },\n  \"output_schema\": {\n    \"syntax_valid\": \"boolean\",\n    \"symbols\": \"array\",\n    \"diagnostics\": \"array\"\n  },\n  \"side_effects\": {\n    \"filesystem\": \"read_only\",\n    \"network\": \"none\"\n  },\n  \"execution\": {\n    \"platforms\": [\"windows\", \"linux\"]