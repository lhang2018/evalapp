.jsx(\"text\",null,__dilConstants[\"383\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"384\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"385\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"386\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"387\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"388\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"389\"]))),__dil.jsx(\"text\",null,__dilConstants[\"390\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"391\"])),__dil.jsx(\"text\",null,__dilConstants[\"392\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第四十二专项：多任务调度、资源隔离与协同执行","1":"本轮研究 EvoAgent 从“可靠地执行单个长期任务”走向“同时管理多个任务，并且让它们安全、高效地协同运行”。","2":"结合此前确定的个人使用方向，EvoAgent 需要适配 Android 手机、Windows 个人电脑和微型 Linux 主机，也需要支持可选的云端模型与生成服务。不同设备的计算能力、后台运行限制、存储空间和网络条件差异很大，因此不能假设所有任务都能同时执行。","3":"本专项建议定义为：","4":"Multi-Task Scheduling, Resource Isolation & Coordination，简称 MTSRIC。","5":"它负责任务排队、优先级调度、资源配额、并发控制、任务隔离、冲突检测、设备分配和资源不足时的协调处理。","6":"核心目标不是最大化并发数量，而是：","7":"在有限资源和复杂依赖下，让正确的任务在正确的设备上，以可控的成本安全执行。","8":"一、第一性原理：任务并发不是越多越好","9":"假设个人电脑同时运行：","10":"大型代码项目的构建与测试；","11":"AI 漫剧的本地视频合成；","12":"一个本地语言模型；","13":"后台记忆整理；","14":"多个等待远程生成服务的任务。","15":"如果调度器只追求并发，可能导致内存不足、GPU 争抢、磁盘 I/O 堵塞，甚至让所有任务都变慢。","16":"因此，需要同时优化四个目标：","17":"正确性：","18":" 不破坏任务依赖、文件完整性、权限和验收要求。","19":"稳定性：","20":" 避免资源过载、重复执行、死锁和任务相互干扰。","21":"效率：","22":" 尽可能利用可用资源，减少无效等待。","23":"公平性与响应性：","24":" 避免后台任务长期霸占资源，也避免低优先级任务永远无法执行。","25":"这四个目标有时会互相冲突。例如，提高并行度可能缩短单个任务的等待时间，却增加系统内存压力。","26":"所以，调度器不能只依据一个简单的优先级数字做决定。","27":"二、总体架构：建立独立的多任务调度控制层","28":"建议在已有 LTAR 任务生命周期管理之上增加 MTSRIC，而不是把资源调度直接塞进每个专家或 DAG 节点。","29":"任务入口与任务注册表","30":"接收用户任务、后台任务、恢复任务和周期性任务，建立统一的任务身份与状态。","31":"MTSRIC 多任务调度器","32":"负责优先级、资源预算、并发许可、任务依赖、资源预留、抢占和公平性。","33":"资源管理器","34":"CPU、GPU、内存、磁盘、网络和服务配额。","35":"隔离与冲突管理器","36":"工作目录、文件锁、产物依赖、数据库和外部副作用。","37":"设备与执行适配层","38":"向 Android、Windows、Linux 主机及已授权的云端服务派发符合能力和权限要求的任务。","39":"LTAR 状态持久化与恢复","40":"记录执行事件、检查点、资源消耗、任务迁移状态和异常恢复信息。","41":"各模块的边界如下：","42":"LTAR：","43":" 决定任务处于什么生命周期状态，以及如何恢复。","44":"MTSRIC：","45":" 决定哪些任务可以在什么资源条件下执行。","46":"ARCBG：","47":" 决定单个任务或节点应投入多少推理和计算资源。","48":"DAG 执行器：","49":" 管理任务内部的依赖与节点执行顺序。","50":"工具运行时：","51":" 真正执行命令、代码、文件操作和外部调用。","52":"SBAAG：","53":" 管理权限、授权与危险操作的执行边界。","54":"MTSRIC 可以阻止任务获得超出配额的执行资源，但不能代替工具运行时的安全隔离，也不能自行授予任务原本没有的权限。","55":"三、统一任务调度：所有任务都进入同一套队列吗？","56":"建议建立","57":"统一任务注册表、多个逻辑队列、一个统一调度器","58":"。","59":"不建议让每种专家各自维护完全独立的调度系统，否则会发生资源冲突。例如，代码专家和视频专家可能都认为自己可以占用全部 GPU 内存。","60":"3.1 建立五类逻辑队列","61":"队列","62":"典型任务","63":"调度原则","64":"交互任务","65":"用户正在等待的简单问题或操作","66":"优先保证响应延迟","67":"前台执行任务","68":"用户当前发起的代码、研究、创作任务","69":"根据承诺时限和任务重要性调度","70":"后台持续任务","71":"记忆整理、索引更新、质量分析","72":"利用剩余资源，避免干扰前台","73":"恢复与维护任务","74":"恢复核验、检查点修复、数据一致性检查","75":"根据风险与恢复必要性确定优先级","76":"等待与重试任务","77":"等待网络、设备、模型或外部服务恢复","78":"满足恢复条件后重新进入可调度状态","79":"这些是逻辑队列，不意味着需要五套物理队列或五个独立服务。","80":"统一调度器必须能够看到所有队列的资源需求，才能防止一个队列独占系统资源。","81":"3.2 任务优先级不能只由创建时间决定","82":"建议综合以下因素：","83":"用户当前是否正在等待结果；","84":"是否有明确的时间要求；","85":"任务是否阻塞其他重要任务；","86":"当前任务的风险与恢复紧迫性；","87":"是否已经等待很长时间；","88":"是否存在可用资源；","89":"任务是否适合当前设备；","90":"是否需要用户批准才能继续。","91":"例如，一个正在执行的高成本视频生成任务，不应仅因为后台出现了一个新任务就被反复中断；但如果系统检测到内存不足，且用户发起了一个需要立即响应的简单请求，就应该优先保障交互响应。","92":"建议采用","93":"优先级等级 + 等待时间补偿 + 资源可行性检查","94":"的组合策略。","95":"等待时间补偿能够避免低优先级任务无限期饥饿，但不能让不满足权限或资源要求的任务绕过限制。","96":"四、任务并发与资源治理：不仅要知道任务有多少，还要知道它们会消耗什么","97":"一个系统同时运行三个任务，不一定比运行两个任务更重。三个轻量文本任务可能很便宜，而两个本地大模型和视频合成任务就可能耗尽内存。","98":"因此，每个任务和执行节点都需要声明或估算资源需求。","99":"4.1 建立资源需求描述","100":"建议定义 ","101":"ResourceRequest","102":"：","103":"字段","104":"示例","105":"cpu_class","106":"轻量、普通、重计算","107":"memory_estimate","108":"预计内存需求","109":"gpu_requirements","110":"是否需要 GPU、显存需求","111":"disk_requirements","112":"工作空间、临时文件与产物空间","113":"network_requirements","114":"是否需要联网、预期传输量","115":"service_quota","116":"模型或外部 API 并发配额","117":"duration_estimate","118":"预计执行时间","119":"interruptibility","120":"是否可暂停、可安全终止","121":"resource_exclusivity","122":"是否需要独占某个设备或资源","123":"data_locality","124":"必须访问哪些本地文件或数据","125":"这些数据可以来自工具注册表、历史执行统计、模型配置和运行时监测。","126":"如果任务没有准确的资源估算，可以采用保守估算、限制并发和运行时监控，而不是假设资源消耗很小。","127":"4.2 建立全局资源预算","128":"调度器需要维护当前设备的可用资源，而不只是累计任务声明的需求。","129":"例如，设备可用内存会受到操作系统、其他应用、本地模型、缓存和文件处理的共同影响。","130":"因此建议：","131":"获取当前设备资源状态；","132":"预留操作系统与基础服务所需资源；","133":"统计已运行任务的实际资源占用；","134":"为新任务估算资源需求；","135":"判断启动任务后是否仍有安全余量；","136":"执行期间持续监测；","137":"接近压力阈值时限制新任务、降低并发或暂停可中断任务。","138":"资源估算用于准入，实际监测用于纠偏。","139":" 二者缺一不可。","140":"4.3 不同资源使用不同的调度方式","141":"CPU：可以在安全范围内共享，并通过并发限制避免过载。","142":"GPU：可能需要独占、显存配额或严格的并发限制，具体取决于模型和运行时。","143":"内存：必须考虑不可回收的工作集，不能仅依靠平均使用率。","144":"磁盘：需要管理工作空间、临时文件、缓存和产物增长。","145":"网络：需要限制并发连接、带宽与重试风暴。","146":"外部 API：需要遵守服务端的速率、并发和费用限制。","147":"这些资源不能简单相加为一个统一的“资源分数”。调度器应对每一种资源分别进行准入检查。","148":"五、任务隔离：避免不同任务互相污染","149":"多任务调度的另一个关键问题，是任务之间不能意外共享可变状态。","150":"例如，两个代码任务同时修改同一个仓库，一个任务可能覆盖另一个任务的修改；视频任务的清理逻辑也可能删除其他任务仍在使用的临时素材。","151":"建议建立四级隔离机制。","152":"1. 任务工作空间隔离","153":"每个任务拥有明确的工作目录、临时文件命名空间和产物清单。清理操作只能处理本任务获准管理的文件。","154":"2. 可变资源隔离","155":"通过文件锁、版本检查、独立数据库事务和资源租约，管理共享仓库、数据库与模型服务。","156":"3. 状态与记忆隔离","157":"每个任务拥有独立的执行状态和上下文快照。共享记忆必须经过明确的访问范围与写入规则。","158":"4. 执行环境隔离","159":"根据风险和平台能力使用独立进程、容器、受限目录、权限配置或其他沙箱机制。","160":"并不是每个任务都必须使用容器。个人设备上的简单只读任务，可以使用较轻量的隔离；涉及不可信代码、敏感文件或高风险副作用的任务，则需要更严格的运行环境。","161":"5.1 同一个项目的多个任务如何协作？","162":"建议对共享代码仓库引入版本化工作空间。","163":"例如：","164":"任务 A 在自己的工作区修改登录模块；","165":"任务 B 在自己的工作区修改支付模块；","166":"两个任务基于同一个基础提交；","167":"最终集成时检查文件冲突、接口兼容性和测试结果。","168":"如果两个任务修改同一个文件，就不能只因为它们属于不同专家而认为彼此独立。","169":"系统需要检测实际写入集合、依赖关系和版本变化，必要时暂停集成、重新基于最新版本执行，或请求人工处理冲突。","170":"5.2 共享记忆不等于共享执行状态","171":"多个任务可以读取同一条经过验证的项目知识，但不应直接修改彼此的执行状态。","172":"例如，代码任务 A 发现了一个新的构建命令，可以将证据提交给项目知识层。任务 B 可以在授权范围内使用这条知识，但不能因此自动继承 A 的临时变量、未完成补丁或未经验证的诊断结论。","173":"这与此前设计的 MEEG、ACMO 和多专家隔离原则一致。","174":"六、DAG 内部并行与任务之间并行：两种并发必须统一协调","175":"EvoAgent 的 DAG 可以让一个任务内部的多个节点并行执行，但系统也可能同时运行多个独立任务。","176":"这形成两个层次：","177":"任务内部并行：","178":" 一个 DAG 中互不依赖的节点同时执行；","179":"任务之间并行：","180":" 多个用户任务同时运行。","181":"如果两层分别决定并发度，就容易超出设备资源上限。","182":"例如，三个用户任务各自认为可以启动两个 GPU 节点，最终可能同时启动六个 GPU 工作负载。","183":"因此，建议采用全局资源准入机制。","184":"6.1 节点启动前必须满足三个条件","185":"一个 DAG 节点只有同时满足以下条件才能启动：","186":"依赖节点已经达到规定状态；","187":"资源管理器已批准所需资源；","188":"任务权限、数据访问和副作用约束均满足。","189":"节点的局部计划不能绕过全局调度器。","190":"如果一个节点需要等待 GPU 资源，它应进入资源等待状态，而不是持续重试启动。","191":"6.2 优先并行执行真正独立的节点","192":"假设 AI 漫剧 DAG 包含：","193":"角色素材生成；","194":"场景素材生成；","195":"背景音乐准备；","196":"分镜数据整理。","197":"其中一些节点可能相互独立，可以并行；另一些节点需要前置产物，必须串行。","198":"DAG 执行器应根据依赖关系确定可并行节点，MTSRIC 再根据当前资源状况决定实际启动哪些节点。","199":"这意味着“依赖允许并行”不等于“资源允许并行”。","200":"6.3 避免死锁与资源占用僵局","201":"需要防范一种情况：","202":"任务 A 占有部分资源，等待任务 B 释放另一项资源；任务 B 同时占有另一部分资源，又等待任务 A 释放资源。","203":"建议：","204":"尽可能采用资源预留或统一准入；","205":"对需要多项资源的节点，尽量在启动前整体批准；","206":"为锁设置持有期限和失效处理机制；","207":"对长时间等待建立诊断；","208":"对可以安全暂停的任务支持释放部分资源；","209":"对不能安全释放的资源，禁止采用会导致死锁的抢占策略。","210":"不能简单地对所有资源使用一个锁解决问题，因为这会显著降低并行效率。","211":"七、抢占与公平性：高优先级任务能否打断低优先级任务？","212":"建议将任务划分为三种抢占等级。","213":"等级","214":"行为","215":"典型场景","216":"可抢占","217":"可以在安全检查点暂停并释放资源","218":"大批量分析、后台索引、可重建的计算任务","219":"条件抢占","220":"需要完成当前安全阶段后暂停","221":"文件转换、长时间测试、视频合成","222":"不可直接抢占","223":"必须等待操作完成或进入专门的取消流程","224":"不支持中断的外部操作、可能产生不可逆副作用的操作","225":"“不可直接抢占”不意味着任务永远不能停止，而是不能在不了解执行状态的情况下强行中断。","226":"7.1 避免前台任务永远压制后台任务","227":"如果每次用户发起新任务，都让后台任务立即停止，长期维护任务可能永远无法完成。","228":"建议使用以下机制：","229":"高优先级任务可以获得更快的资源准入；","230":"低优先级任务在等待期间逐步提高调度权重；","231":"后台任务使用可配置的资源上限；","232":"在资源空闲窗口执行低优先级任务；","233":"为必要的恢复与维护工作保留最低资源；","234":"对长期等待任务设置告警或重新评估条件。","235":"这能够在响应速度和长期任务进展之间建立平衡。","236":"7.2 采用受控的资源借用","237":"例如，视频任务预留了部分 GPU 资源，但当前正在等待云端生成服务返回结果。","238":"系统可以将尚未实际使用的资源分配给其他任务，但需要明确：","239":"借用资源是否能够及时收回；","240":"原任务恢复时是否需要重新加载模型；","241":"借用是否会产生明显的恢复成本；","242":"当前任务是否有不可中断的资源需求。","243":"对于本地大模型，卸载和重新加载可能很昂贵；对于等待网络的任务，则可能更适合释放本地资源。","244":"调度器应根据真实的资源释放与恢复成本作出判断。","245":"八、跨设备调度：不是所有任务都应该迁移","246":"你的 EvoAgent 可能同时使用 Android 手机、Windows 电脑、微型 Linux 主机和可选云端服务。","247":"这时需要建立 ","248":"DeviceCapabilityRegistry","249":"，记录每个执行设备的能力和限制。","250":"建议记录：","251":"操作系统与架构；","252":"可用 CPU、内存和 GPU；","253":"已安装的模型与工具；","254":"可访问的项目文件和存储；","255":"网络连通性；","256":"后台运行能力；","257":"当前负载；","258":"设备是否在线；","259":"数据敏感性与执行权限；","260":"任务迁移所需的产物和依赖。","261":"8.1 设备选择应考虑五类因素","262":"能力匹配：","263":" 设备是否具备运行所需工具和模型的能力？","264":"数据位置：","265":" 文件是否已经在该设备上？","266":"资源状态：","267":" 当前是否有足够的可用资源？","268":"执行成本：","269":" 迁移数据和恢复环境需要多少时间？","270":"权限与隐私：","271":" 任务数据是否允许离开当前设备？","272":"例如，手机可以负责任务入口和轻量分析，个人电脑负责大型代码构建，微型 Linux 主机负责长期调度，云端负责已授权的生成服务。","273":"但如果代码包含不允许外传的敏感数据，就不能仅因为云端模型更强而自动上传。","274":"8.2 任务迁移需要明确的状态交接","275":"建议迁移流程为：","276":"源设备请求迁移；","277":"在安全边界内暂停可迁移节点；","278":"持久化检查点与必要产物；","279":"目标设备核验能力、权限和资源；","280":"传输或验证必要数据；","281":"目标设备确认可以接管；","282":"更新权威调度状态；","283":"源设备释放执行权；","284":"目标设备恢复任务。","285":"不能仅把任务状态从设备 A 改成设备 B，就认为迁移已经成功。","286":"对于不支持迁移的节点，应保留在原设备执行，或者使用明确的替代工作流重新执行。","287":"九、资源过载与故障隔离：一个任务失败不能拖垮整个系统","288":"多任务系统必须防止局部故障演变为全局故障。","289":"例如，某个视频生成服务连续失败，任务不断重试，可能占满网络连接、耗尽 API 配额，并让其他任务无法正常执行。","290":"建议建立四种保护机制。","291":"9.1 并发上限","292":"对以下对象分别设置并发限制：","293":"全局运行任务；","294":"单个设备上的任务；","295":"单个 DAG 内的并行节点；","296":"单个模型实例；","297":"单个外部服务；","298":"特定工具类型；","299":"特定资源密集型操作。","300":"这些限制应根据设备能力和服务契约配置，并支持动态调整。","301":"9.2 重试预算与熔断","302":"如果某个外部服务持续失败，应暂停继续向它提交请求，而不是无限重试。","303":"建议建立：","304":"单操作最大重试次数；","305":"指数退避与随机抖动；","306":"服务级失败率监测；","307":"熔断状态；","308":"半开状态下的受控探测；","309":"服务恢复后的逐步放量。","310":"熔断只影响相应的故障服务或能力，不应默认阻止其他无关任务继续执行。","311":"9.3 背压机制","312":"当任务生产速度超过执行能力时，系统应该限制新的工作进入执行队列。","313":"例如，视频任务持续生成大量待合成镜头，但本地磁盘和编码器已经接近容量上限。此时可以暂停新的素材下载或生成节点，先完成已有素材的处理。","314":"背压机制可以避免积压无限增长，也能降低系统内存、磁盘和网络压力。","315":"9.4 故障隔离与恢复","316":"当某个任务发生异常时：","317":"记录其错误和资源消耗；","318":"限制其继续申请资源；","319":"保留必要的诊断材料；","320":"根据 LTAR 恢复规则处理节点状态；","321":"允许无关任务继续运行；","322":"必要时触发服务级熔断；","323":"在恢复后逐步重新开放资源。","324":"系统不能因为一个专家反复失败，就无限增加该专家的调用次数。","325":"十、调度器如何知道自己做得好不好？","326":"MTSRIC 需要独立评测，否则容易出现“并发数提高了，但任务完成更慢、失败更多”的情况。","327":"建议至少跟踪以下指标：","328":"指标","329":"目的","330":"任务完成率","331":"判断调度是否支持任务成功交付","332":"平均与高分位等待时间","333":"判断任务是否长期排队","334":"资源利用率","335":"判断 CPU、GPU、内存和磁盘是否得到合理利用","336":"资源超限事件","337":"判断准入与资源监测是否有效","338":"任务饥饿率","339":"判断低优先级任务是否长期得不到执行","340":"任务冲突率","341":"判断文件、产物和共享状态是否发生冲突","342":"并发执行失败率","343":"判断增加并发是否降低了稳定性","344":"迁移成功率","345":"判断跨设备调度是否可靠","346":"恢复与重试成本","347":"判断故障是否导致过度资源消耗","348":"任务总成本","349":"判断调度是否在质量要求内提高效率","350":"还需要增加几类专门的压力测试：","351":"多个任务同时请求 GPU；","352":"后台任务长时间占用磁盘；","353":"前台任务持续到达；","354":"外部 API 限流；","355":"同一代码仓库被多个任务修改；","356":"设备在任务迁移过程中断网；","357":"任务取消时仍有节点正在运行；","358":"高优先级任务与低优先级任务竞争内存。","359":"评测时必须同时观察正确性、稳定性和效率，而不能只看资源利用率或并发数量。","360":"十一、建议冻结的架构决策","361":"以下是建议纳入 EvoAgent 全量架构的 MTSRIC 治理基线。","362":"这些是建议纳入 EvoAgent 全量架构的多任务治理基线。正式实施时，还需要定义 ","363":"ResourceRequest","364":"、任务优先级策略、资源租约、工作空间协议、设备能力注册表和并发压力测试集。","365":"十二、下一专项：工具执行运行时、沙箱与操作安全","366":"到目前为止，我们已经设计了任务规划、专家协作、上下文、预算、主动感知、长期恢复和多任务调度。","367":"但这些模块最终都需要调用工具来改变现实状态。","368":"例如：","369":"代码专家需要读写文件、运行测试和执行构建；","370":"漫剧专家需要调用生成服务、下载素材和执行 FFmpeg；","371":"手机操作专家需要与 Android 系统交互；","372":"记忆系统需要读写数据库；","373":"恢复管理器需要检查和修复任务状态。","374":"如果工具执行层不可靠，上层再聪明也可能导致文件损坏、重复扣费、权限越界或任务状态不一致。","375":"因此，下一专项建议定义为：","376":"Tool Execution Runtime & Sandboxed Operations，简称 TERSO。","377":"重点研究：","378":"如何建立统一的工具注册、发现、版本和能力契约；","379":"如何区分只读工具、可逆操作和不可逆操作；","380":"如何在执行前验证参数、权限和前置条件；","381":"如何为不同风险等级的工具选择合适的沙箱；","382":"如何管理进程、超时、取消、退出码和异常输出；","383":"如何限制文件访问、网络访问、系统命令和外部副作用；","384":"如何处理执行超时但实际操作已经成功的情况；","385":"如何为工具执行建立审计日志与结果证据；","386":"如何将工具调用与 LTAR 检查点、MTSRIC 资源配额和 SBAAG 授权机制连接；","387":"如何防止不可信文件、网页或工具输出诱导模型越权执行；","388":"如何对工具进行契约测试、故障注入和兼容性验证；","389":"如何在 Android、Windows、Linux 和可选云端环境中建立统一接口，同时保留各平台的安全边界。","390":"这个专项的核心原则是：","391":"模型负责提出行动意图，调度器负责决定何时执行，授权机制负责判断是否允许，工具运行时负责安全执行，验收机制负责确认结果。","392":"只有把这几种职责分开，EvoAgent 才能在高度自动化的同时，保持可控、可审计和可恢复。"},"fallbackMarkdown":"# EvoAgent 第四十二专项：多任务调度、资源隔离与协同执行\n\n本轮研究 EvoAgent 从“可靠地执行单个长期任务”走向“同时管理多个任务，并且让它们安全、高效地协同运行”。\n\n结合此前确定的个人使用方向，EvoAgent 需要适配 Android 手机、Windows 个人电脑和微型 Linux 主机，也需要支持可选的云端模型与生成服务。不同设备的计算能力、后台运行限制、存储空间和网络条件差异很大，因此不能假设所有任务都能同时执行。\n\n本专项建议定义为：\n\n**Multi-Task Scheduling, Resource Isolation &amp; Coordination，简称 MTSRIC。**\n\n它负责任务排队、优先级调度、资源配额、并发控制、任务隔离、冲突检测、设备分配和资源不足时的协调处理。\n\n核心目标不是最大化并发数量，而是：\n\n**在有限资源和复杂依赖下，让正确的任务在正确的设备上，以可控的成本安全执行。**\n\n## 一、第一性原理：任务并发不是越多越好\n\n假设个人电脑同时运行：\n\n- 大型代码项目的构建与测试；\n- AI 漫剧的本地视频合成；\n- 一个本地语言模型；\n- 后台记忆整理；\n- 多个等待远程生成服务的任务。\n\n如果调度器只追求并发，可能导致内存不足、GPU 争抢、磁盘 I/O 堵塞，甚至让所有任务都变慢。\n\n因此，需要同时优化四个目标：\n\n1. **正确性：** 不破坏任务依赖、文件完整性、权限和验收要求。\n2. **稳定性：** 避免资源过载、重复执行、死锁和任务相互干扰。\n3. **效率：** 尽可能利用可用资源，减少无效等待。\n4. **公平性与响应性：** 避免后台任务长期霸占资源，也避免低优先级任务永远无法执行。\n\n这四个目标有时会互相冲突。例如，提高并行度可能缩短单个任务的等待时间，却增加系统内存压力。\n\n所以，调度器不能只依据一个简单的优先级数字做决定。\n\n---\n\n# 二、总体架构：建立独立的多任务调度控制层\n\n建议在已有 LTAR 任务生命周期管理之上增加 MTSRIC，而不是把资源调度直接塞进每个专家或 DAG 节点。\n\n### 任务入口与任务注册表\n\n接收用户任务、后台任务、恢复任务和周期性任务，建立统一的任务身份与状态。\n\n### MTSRIC 多任务调度器\n\n负责优先级、资源预算、并发许可、任务依赖、资源预留、抢占和公平性。\n\n#### 资源管理器\n\nCPU、GPU、内存、磁盘、网络和服务配额。\n\n#### 隔离与冲突管理器\n\n工作目录、文件锁、产物依赖、数据库和外部副作用。\n\n### 设备与执行适配层\n\n向 Android、Windows、Linux 主机及已授权的云端服务派发符合能力和权限要求的任务。\n\n### LTAR 状态持久化与恢复\n\n记录执行事件、检查点、资源消耗、任务迁移状态和异常恢复信息。\n\n各模块的边界如下：\n\n- **LTAR：** 决定任务处于什么生命周期状态，以及如何恢复。\n- **MTSRIC：** 决定哪些任务可以在什么资源条件下执行。\n- **ARCBG：** 决定单个任务或节点应投入多少推理和计算资源。\n- **DAG 执行器：** 管理任务内部的依赖与节点执行顺序。\n- **工具运行时：** 真正执行命令、代码、文件操作和外部调用。\n- **SBAAG：** 管理权限、授权与危险操作的执行边界。\n\nMTSRIC 可以阻止任务获得超出配额的执行资源，但不能代替工具运行时的安全隔离，也不能自行授予任务原本没有的权限。\n\n# 三、统一任务调度：所有任务都进入同一套队列吗？\n\n建议建立**统一任务注册表、多个逻辑队列、一个统一调度器**。\n\n不建议让每种专家各自维护完全独立的调度系统，否则会发生资源冲突。例如，代码专家和视频专家可能都认为自己可以占用全部 GPU 内存。\n\n## 3.1 建立五类逻辑队列\n\n| 队列 | 典型任务 | 调度原则 |\n|--------|--------|--------|\n| 交互任务 | 用户正在等待的简单问题或操作 | 优先保证响应延迟 |\n| 前台执行任务 | 用户当前发起的代码、研究、创作任务 | 根据承诺时限和任务重要性调度 |\n| 后台持续任务 | 记忆整理、索引更新、质量分析 | 利用剩余资源，避免干扰前台 |\n| 恢复与维护任务 | 恢复核验、检查点修复、数据一致性检查 | 根据风险与恢复必要性确定优先级 |\n| 等待与重试任务 | 等待网络、设备、模型或外部服务恢复 | 满足恢复条件后重新进入可调度状态 |\n\n这些是逻辑队列，不意味着需要五套物理队列或五个独立服务。\n\n统一调度器必须能够看到所有队列的资源需求，才能防止一个队列独占系统资源。\n\n## 3.2 任务优先级不能只由创建时间决定\n\n建议综合以下因素：\n\n- 用户当前是否正在等待结果；\n- 是否有明确的时间要求；\n- 任务是否阻塞其他重要任务；\n- 当前任务的风险与恢复紧迫性；\n- 是否已经等待很长时间；\n- 是否存在可用资源；\n- 任务是否适合当前设备；\n- 是否需要用户批准才能继续。\n\n例如，一个正在执行的高成本视频生成任务，不应仅因为后台出现了一个新任务就被反复中断；但如果系统检测到内存不足，且用户发起了一个需要立即响应的简单请求，就应该优先保障交互响应。\n\n建议采用**优先级等级 + 等待时间补偿 + 资源可行性检查**的组合策略。\n\n等待时间补偿能够避免低优先级任务无限期饥饿，但不能让不满足权限或资源要求的任务绕过限制。\n\n---\n\n# 四、任务并发与资源治理：不仅要知道任务有多少，还要知道它们会消耗什么\n\n一个系统同时运行三个任务，不一定比运行两个任务更重。三个轻量文本任务可能很便宜，而两个本地大模型和视频合成任务就可能耗尽内存。\n\n因此，每个任务和执行节点都需要声明或估算资源需求。\n\n## 4.1 建立资源需求描述\n\n建议定义 `ResourceRequest`：\n\n| 字段 | 示例 |\n|--------|--------|\n| `cpu_class` | 轻量、普通、重计算 |\n| `memory_estimate` | 预计内存需求 |\n| `gpu_requirements` | 是否需要 GPU、显存需求 |\n| `disk_requirements` | 工作空间、临时文件与产物空间 |\n| `network_requirements` | 是否需要联网、预期传输量 |\n| `service_quota` | 模型或外部 API 并发配额 |\n| `duration_estimate` | 预计执行时间 |\n| `interruptibility` | 是否可暂停、可安全终止 |\n| `resource_exclusivity` | 是否需要独占某个设备或资源 |\n| `data_locality` | 必须访问哪些本地文件或数据 |\n\n这些数据可以来自工具注册表、历史执行统计、模型配置和运行时监测。\n\n如果任务没有准确的资源估算，可以采用保守估算、限制并发和运行时监控，而不是假设资源消耗很小。\n\n## 4.2 建立全局资源预算\n\n调度器需要维护当前设备的可用资源，而不只是累计任务声明的需求。\n\n例如，设备可用内存会受到操作系统、其他应用、本地模型、缓存和文件处理的共同影响。\n\n因此建议：\n\n1. 获取当前设备资源状态；\n2. 预留操作系统与基础服务所需资源；\n3. 统计已运行任务的实际资源占用；\n4. 为新任务估算资源需求；\n5. 判断启动任务后是否仍有安全余量；\n6. 执行期间持续监测；\n7. 接近压力阈值时限制新任务、降低并发或暂停可中断任务。\n\n**资源估算用于准入，实际监测用于纠偏。** 二者缺一不可。\n\n## 4.3 不同资源使用不同的调度方式\n\n- CPU：可以在安全范围内共享，并通过并发限制避免过载。\n- GPU：可能需要独占、显存配额或严格的并发限制，具体取决于模型和运行时。\n- 内存：必须考虑不可回收的工作集，不能仅依靠平均使用率。\n- 磁盘：需要管理工作空间、临时文件、缓存和产物增长。\n- 网络：需要限制并发连接、带宽与重试风暴。\n- 外部 API：需要遵守服务端的速率、并发和费用限制。\n\n这些资源不能简单相加为一个统一的“资源分数”。调度器应对每一种资源分别进行准入检查。\n\n---\n\n# 五、任务隔离：避免不同任务互相污染\n\n多任务调度的另一个关键问题，是任务之间不能意外共享可变状态。\n\n例如，两个代码任务同时修改同一个仓库，一个任务可能覆盖另一个任务的修改；视频任务的清理逻辑也可能删除其他任务仍在使用的临时素材。\n\n建议建立四级隔离机制。\n\n### 1\\. 任务工作空间隔离\n\n每个任务拥有明确的工作目录、临时文件命名空间和产物清单。清理操作只能处理本任务获准管理的文件。\n\n---\n\n### 2\\. 可变资源隔离\n\n通过文件锁、版本检查、独立数据库事务和资源租约，管理共享仓库、数据库与模型服务。\n\n---\n\n### 3\\. 状态与记忆隔离\n\n每个任务拥有独立的执行状态和上下文快照。共享记忆必须经过明确的访问范围与写入规则。\n\n---\n\n### 4\\. 执行环境隔离\n\n根据风险和平台能力使用独立进程、容器、受限目录、权限配置或其他沙箱机制。\n\n并不是每个任务都必须使用容器。个人设备上的简单只读任务，可以使用较轻量的隔离；涉及不可信代码、敏感文件或高风险副作用的任务，则需要更严格的运行环境。\n\n## 5.1 同一个项目的多个任务如何协作？\n\n建议对共享代码仓库引入版本化工作空间。\n\n例如：\n\n- 任务 A 在自己的工作区修改登录模块；\n- 任务 B 在自己的工作区修改支付模块；\n- 两个任务基于同一个基础提交；\n- 最终集成时检查文件冲突、接口兼容性和测试结果。\n\n如果两个任务修改同一个文件，就不能只因为它们属于不同专家而认为彼此独立。\n\n系统需要检测实际写入集合、依赖关系和版本变化，必要时暂停集成、重新基于最新版本执行，或请求人工处理冲突。\n\n## 5.2 共享记忆不等于共享执行状态\n\n多个任务可以读取同一条经过验证的项目知识，但不应直接修改彼此的执行状态。\n\n例如，代码任务 A 发现了一个新的构建命令，可以将证据提交给项目知识层。任务 B 可以在授权范围内使用这条知识，但不能因此自动继承 A 的临时变量、未完成补丁或未经验证的诊断结论。\n\n这与此前设计的 MEEG、ACMO 和多专家隔离原则一致。\n\n---\n\n# 六、DAG 内部并行与任务之间并行：两种并发必须统一协调\n\nEvoAgent 的 DAG 可以让一个任务内部的多个节点并行执行，但系统也可能同时运行多个独立任务。\n\n这形成两个层次：\n\n- **任务内部并行：** 一个 DAG 中互不依赖的节点同时执行；\n- **任务之间并行：** 多个用户任务同时运行。\n\n如果两层分别决定并发度，就容易超出设备资源上限。\n\n例如，三个用户任务各自认为可以启动两个 GPU 节点，最终可能同时启动六个 GPU 工作负载。\n\n因此，建议采用全局资源准入机制。\n\n## 6.1 节点启动前必须满足三个条件\n\n一个 DAG 节点只有同时满足以下条件才能启动：\n\n1. 依赖节点已经达到规定状态；\n2. 资源管理器已批准所需资源；\n3. 任务权限、数据访问和副作用约束均满足。\n\n节点的局部计划不能绕过全局调度器。\n\n如果一个节点需要等待 GPU 资源，它应进入资源等待状态，而不是持续重试启动。\n\n## 6.2 优先并行执行真正独立的节点\n\n假设 AI 漫剧 DAG 包含：\n\n- 角色素材生成；\n- 场景素材生成；\n- 背景音乐准备；\n- 分镜数据整理。\n\n其中一些节点可能相互独立，可以并行；另一些节点需要前置产物，必须串行。\n\nDAG 执行器应根据依赖关系确定可并行节点，MTSRIC 再根据当前资源状况决定实际启动哪些节点。\n\n这意味着“依赖允许并行”不等于“资源允许并行”。\n\n## 6.3 避免死锁与资源占用僵局\n\n需要防范一种情况：\n\n任务 A 占有部分资源，等待任务 B 释放另一项资源；任务 B 同时占有另一部分资源，又等待任务 A 释放资源。\n\n建议：\n\n- 尽可能采用资源预留或统一准入；\n- 对需要多项资源的节点，尽量在启动前整体批准；\n- 为锁设置持有期限和失效处理机制；\n- 对长时间等待建立诊断；\n- 对可以安全暂停的任务支持释放部分资源；\n- 对不能安全释放的资源，禁止采用会导致死锁的抢占策略。\n\n不能简单地对所有资源使用一个锁解决问题，因为这会显著降低并行效率。\n\n---\n\n# 七、抢占与公平性：高优先级任务能否打断低优先级任务？\n\n建议将任务划分为三种抢占等级。\n\n| 等级 | 行为 | 典型场景 |\n|--------|--------|--------|\n| 可抢占 | 可以在安全检查点暂停并释放资源 | 大批量分析、后台索引、可重建的计算任务 |\n| 条件抢占 | 需要完成当前安全阶段后暂停 | 文件转换、长时间测试、视频合成 |\n| 不可直接抢占 | 必须等待操作完成或进入专门的取消流程 | 不支持中断的外部操作、可能产生不可逆副作用的操作 |\n\n“不可直接抢占”不意味着任务永远不能停止，而是不能在不了解执行状态的情况下强行中断。\n\n## 7.1 避免前台任务永远压制后台任务\n\n如果每次用户发起新任务，都让后台任务立即停止，长期维护任务可能永远无法完成。\n\n建议使用以下机制：\n\n- 高优先级任务可以获得更快的资源准入；\n- 低优先级任务在等待期间逐步提高调度权重；\n- 后台任务使用可配置的资源上限；\n- 在资源空闲窗口执行低优先级任务；\n- 为必要的恢复与维护工作保留最低资源；\n- 对长期等待任务设置告警或重新评估条件。\n\n这能够在响应速度和长期任务进展之间建立平衡。\n\n## 7.2 采用受控的资源借用\n\n例如，视频任务预留了部分 GPU 资源，但当前正在等待云端生成服务返回结果。\n\n系统可以将尚未实际使用的资源分配给其他任务，但需要明确：\n\n- 借用资源是否能够及时收回；\n- 原任务恢复时是否需要重新加载模型；\n- 借用是否会产生明显的恢复成本；\n- 当前任务是否有不可中断的资源需求。\n\n对于本地大模型，卸载和重新加载可能很昂贵；对于等待网络的任务，则可能更适合释放本地资源。\n\n调度器应根据真实的资源释放与恢复成本作出判断。\n\n---\n\n# 八、跨设备调度：不是所有任务都应该迁移\n\n你的 EvoAgent 可能同时使用 Android 手机、Windows 电脑、微型 Linux 主机和可选云端服务。\n\n这时需要建立 `DeviceCapabilityRegistry`，记录每个执行设备的能力和限制。\n\n建议记录：\n\n- 操作系统与架构；\n- 可用 CPU、内存和 GPU；\n- 已安装的模型与工具；\n- 可访问的项目文件和存储；\n- 网络连通性；\n- 后台运行能力；\n- 当前负载；\n- 设备是否在线；\n- 数据敏感性与执行权限；\n- 任务迁移所需的产物和依赖。\n\n## 8.1 设备选择应考虑五类因素\n\n1. **能力匹配：** 设备是否具备运行所需工具和模型的能力？\n2. **数据位置：** 文件是否已经在该设备上？\n3. **资源状态：** 当前是否有足够的可用资源？\n4. **执行成本：** 迁移数据和恢复环境需要多少时间？\n5. **权限与隐私：** 任务数据是否允许离开当前设备？\n\n例如，手机可以负责任务入口和轻量分析，个人电脑负责大型代码构建，微型 Linux 主机负责长期调度，云端负责已授权的生成服务。\n\n但如果代码包含不允许外传的敏感数据，就不能仅因为云端模型更强而自动上传。\n\n## 8.2 任务迁移需要明确的状态交接\n\n建议迁移流程为：\n\n1. 源设备请求迁移；\n2. 在安全边界内暂停可迁移节点；\n3. 持久化检查点与必要产物；\n4. 目标设备核验能力、权限和资源；\n5. 传输或验证必要数据；\n6. 目标设备确认可以接管；\n7. 更新权威调度状态；\n8. 源设备释放执行权；\n9. 目标设备恢复任务。\n\n不能仅把任务状态从设备 A 改成设备 B，就认为迁移已经成功。\n\n对于不支持迁移的节点，应保留在原设备执行，或者使用明确的替代工作流重新执行。\n\n---\n\n# 九、资源过载与故障隔离：一个任务失败不能拖垮整个系统\n\n多任务系统必须防止局部故障演变为全局故障。\n\n例如，某个视频生成服务连续失败，任务不断重试，可能占满网络连接、耗尽 API 配额，并让其他任务无法正常执行。\n\n建议建立四种保护机制。\n\n## 9.1 并发上限\n\n对以下对象分别设置并发限制：\n\n- 全局运行任务；\n- 单个设备上的任务；\n- 单个 DAG 内的并行节点；\n- 单个模型实例；\n- 单个外部服务；\n- 特定工具类型；\n- 特定资源密集型操作。\n\n这些限制应根据设备能力和服务契约配置，并支持动态调整。\n\n## 9.2 重试预算与熔断\n\n如果某个外部服务持续失败，应暂停继续向它提交请求，而不是无限重试。\n\n建议建立：\n\n- 单操作最大重试次数；\n- 指数退避与随机抖动；\n- 服务级失败率监测；\n- 熔断状态；\n- 半开状态下的受控探测；\n- 服务恢复后的逐步放量。\n\n熔断只影响相应的故障服务或能力，不应默认阻止其他无关任务继续执行。\n\n## 9.3 背压机制\n\n当任务生产速度超过执行能力时，系统应该限制新的工作进入执行队列。\n\n例如，视频任务持续生成大量待合成镜头，但本地磁盘和编码器已经接近容量上限。此时可以暂停新的素材下载或生成节点，先完成已有素材的处理。\n\n背压机制可以避免积压无限增长，也能降低系统内存、磁盘和网络压力。\n\n## 9.4 故障隔离与恢复\n\n当某个任务发生异常时：\n\n- 记录其错误和资源消耗；\n- 限制其继续申请资源；\n- 保留必要的诊断材料；\n- 根据 LTAR 恢复规则处理节点状态；\n- 允许无关任务继续运行；\n- 必要时触发服务级熔断；\n- 在恢复后逐步重新开放资源。\n\n系统不能因为一个专家反复失败，就无限增加该专家的调用次数。\n\n---\n\n# 十、调度器如何知道自己做得好不好？\n\nMTSRIC 需要独立评测，否则容易出现“并发数提高了，但任务完成更慢、失败更多”的情况。\n\n建议至少跟踪以下指标：\n\n| 指标 | 目的 |\n|--------|--------|\n| 任务完成率 | 判断调度是否支持任务成功交付 |\n| 平均与高分位等待时间 | 判断任务是否长期排队 |\n| 资源利用率 | 判断 CPU、GPU、内存和磁盘是否得到合理利用 |\n| 资源超限事件 | 判断准入与资源监测是否有效 |\n| 任务饥饿率 | 判断低优先级任务是否长期得不到执行 |\n| 任务冲突率 | 判断文件、产物和共享状态是否发生冲突 |\n| 并发执行失败率 | 判断增加并发是否降低了稳定性 |\n| 迁移成功率 | 判断跨设备调度是否可靠 |\n| 恢复与重试成本 | 判断故障是否导致过度资源消耗 |\n| 任务总成本 | 判断调度是否在质量要求内提高效率 |\n\n还需要增加几类专门的压力测试：\n\n- 多个任务同时请求 GPU；\n- 后台任务长时间占用磁盘；\n- 前台任务持续到达；\n- 外部 API 限流；\n- 同一代码仓库被多个任务修改；\n- 设备在任务迁移过程中断网；\n- 任务取消时仍有节点正在运行；\n- 高优先级任务与低优先级任务竞争内存。\n\n评测时必须同时观察正确性、稳定性和效率，而不能只看资源利用率或并发数量。\n\n---\n\n# 十一、建议冻结的架构决策\n\n以下是建议纳入 EvoAgent 全量架构的 MTSRIC 治理基线。\n\n这些是建议纳入 EvoAgent 全量架构的多任务治理基线。正式实施时，还需要定义 `ResourceRequest`、任务优先级策略、资源租约、工作空间协议、设备能力注册表和并发压力测试集。\n\n---\n\n# 十二、下一专项：工具执行运行时、沙箱与操作安全\n\n到目前为止，我们已经设计了任务规划、专家协作、上下文、预算、主动感知、长期恢复和多任务调度。\n\n但这些模块最终都需要调用工具来改变现实状态。\n\n例如：\n\n- 代码专家需要读写文件、运行测试和执行构建；\n- 漫剧专家需要调用生成服务、下载素材和执行 FFmpeg；\n- 手机操作专家需要与 Android 系统交互；\n- 记忆系统需要读写数据库；\n- 恢复管理器需要检查和修复任务状态。\n\n如果工具执行层不可靠，上层再聪明也可能导致文件损坏、重复扣费、权限越界或任务状态不一致。\n\n因此，下一专项建议定义为：\n\n**Tool Execution Runtime &amp; Sandboxed Operations，简称 TERSO。**\n\n重点研究：\n\n1. 如何建立统一的工具注册、发现、版本和能力契约；\n2. 如何区分只读工具、可逆操作和不可逆操作；\n3. 如何在执行前验证参数、权限和前置条件；\n4. 如何为不同风险等级的工具选择合适的沙箱；\n5. 如何管理进程、超时、取消、退出码和异常输出；\n6. 如何限制文件访问、网络访问、系统命令和外部副作用；\n7. 如何处理执行超时但实际操作已经成功的情况；\n8. 如何为工具执行建立审计日志与结果证据；\n9. 如何将工具调用与 LTAR 检查点、MTSRIC 资源配额和 SBAAG 授权机制连接；\n10. 如何防止不可信文件、网页或工具输出诱导模型越权执行；\n11. 如何对工具进行契约测试、故障注入和兼容性验证；\n12. 如何在 Android、Windows、Linux 和可选云端环境中建立统一接口，同时保留各平台的安全边界。\n\n这个专项的核心原则是：\n\n**模型负责提出行动意图，调度器负责决定何时执行，授权机制负责判断是否允许，工具运行时负责安全执行，验收机制负责确认结果。**\n\n只有把这几种职责分开，EvoAgent 才能在高度自动化的同时，保持可控、可审计和可恢复。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"request_id":"2a6e8bb7-4301-4229-a775-b771cefbba64","message_type":"next","turn_exchange_id":"3c5024fa-3831-42dd-8405-9ecfcf