del_slug":"gpt-6","can_save":false,"parent_id":"2090d775-455c-48ab-9e99-3d8e820d6e7d","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"d53603aa-e876-46d4-8805-7caacf8a7315","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792300264.996949,"update_time":1792300364.648094,"content":{"content_type":"code","language":"unknown","response_format_name":null,"text":"from docx import Document\nfrom docx.shared import Inches, Pt, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.section import WD_SECTION\nfrom docx.oxml import OxmlElement\nfrom docx.oxml.ns import qn\nfrom pathlib import Path\nimport textwrap\n\nout_dir = Path(\"/mnt/data\")\ndocx_path = out_dir / \"EvoAgent_PRD_TAD_V0.1基线设计.docx\"\nmd_path = out_dir / \"EvoAgent_PRD_TAD_V0.1基线设计.md\"\n\ntitle = \"EvoAgent 产品需求文档（PRD）与总体技术架构（TAD）\"\nsubtitle = \"V0.1 产品基线与验收标准\"\n\nsections = [\n(\"0. 文档目的与决策摘要\", [\n(\"正文\", \"本文用于统一 EvoAgent 的产品定位、核心架构、版本边界、数据模型、接口契约、进化机制和 V0.1 验收标准。它是后续工程实现的基线，不意味着所有模块已实现。\"),\n(\"正文\", \"核心决策：EvoAgent 是以目标完成为核心、以可复用工作流为长期资产、以可验证的持续改进为后台能力的个人通用智能体系统。V0.1 优先验证“任务执行—结果验收—运行记录—失败诊断”的完整闭环；工作流编排和进化系统随后分阶段加入。\"),\n(\"要点\", \"稳定执行轨道与候选进化轨道分离；工作流、模型配置、工具适配器和评测集分别版本化；模型不能自行放宽权限或修改评测门禁；所有自动发布必须有独立测试证据和回滚路径。\"),\n]),\n(\"1. 产品定位与目标\", [\n(\"正文\", \"EvoAgent 让用户通过文字或语音提出目标，由系统识别意图、选择已有工作流或动态规划、在授权范围内调用工具、验证结果，并把运行证据用于后续可靠性改进。\"),\n(\"小标题\", \"1.1 产品目标\"),\n(\"要点\", \"完成真实任务，而非只生成建议。\"),\n(\"要点\", \"重复任务优先复用经过验证的稳定工作流。\"),\n(\"要点\", \"遇到失败时可定位、可恢复、可解释地停止，并形成结构化问题记录。\"),\n(\"要点\", \"模型、工具、工作流可独立升级和回滚。\"),\n(\"要点\", \"通过独立评测改善成功率、恢复率、成本、时延和质量，而非以改动次数衡量进化。\"),\n(\"小标题\", \"1.2 非目标（V0.1 不做）\"),\n(\"要点\", \"不追求一次实现所有应用和所有任务。\"),\n(\"要点\", \"不允许模型直接修改核心运行时、权限规则或评测门禁。\"),\n(\"要点\", \"不允许候选版本未经验证影响稳定任务。\"),\n(\"要点\", \"不自动处理支付、密码、验证码等高风险操作。\"),\n(\"要点\", \"不将所有成功轨迹自动视为稳定工作流。\"),\n]),\n(\"2. 用户与核心使用场景\", [\n(\"小标题\", \"2.1 目标用户\"),\n(\"正文\", \"个人用户希望用自然语言委托多步骤数字任务；后续可扩展到内容创作者、开发者和办公用户。\"),\n(\"小标题\", \"2.2 核心场景\"),\n(\"要点\", \"通用任务：将目标拆分为步骤，调用工具并验收结果。\"),\n(\"要点\", \"重复任务：匹配稳定工作流，带入本次参数后执行。\"),\n(\"要点\", \"新任务：在工具白名单、预算、步数和风险限制内动态规划。\"),\n(\"要点\", \"移动端任务：通过 Android App 发起任务、查看状态、授权关键动作和查看结果。\"),\n(\"要点\", \"复杂能力包：例如 AI 漫剧或自主编程，以插件形式复用相同运行时、工作流和评测基础设施。\"),\n]),\n(\"3. 产品体验与任务生命周期\", [\n(\"小标题\", \"3.1 主流程\"),\n(\"正文\", \"用户输入目标 → 意图解析 → 任务分类与风险评估 → 匹配稳定工作流；若无适用工作流则受控动态规划 → 执行节点 → 每一步记录事件并验证输出 → 最终验收 → 交付结果 → 形成诊断和改进候选。\"),\n(\"小标题\", \"3.2 三种执行路径\"),\n(\"要点\", \"路径 A：稳定工作流。检查适用条件和版本兼容后，按固定 DAG 执行。\"),\n(\"要点\", \"路径 B：工作流内嵌 Agent。主流程固定，局部判断交给受约束的 Agent 节点。\"),\n(\"要点\", \"路径 C：动态规划。没有合适流程时，Agent 在工具白名单、预算、最大步数和权限边界内探索。\"),\n(\"小标题\", \"3.3 任务状态\"),\n(\"正文\", \"建议状态：created、classified、planned、running、waiting_approval、recovering、verifying、succeeded、failed、cancelled、needs_user。状态迁移由状态机验证，不能只依赖模型文本判断。\"),\n]),\n(\"4. 产品功能需求\", [\n(\"小标题\", \"4.1 意图与任务管理\"),\n(\"要点\", \"输入：文字优先；语音入口作为 Android 阶段能力。\"),\n(\"要点\", \"输出：结构化目标、约束、验收条件、风险等级和所需能力。\"),\n(\"要点\", \"信息不足时只询问阻塞执行的关键问题。\"),\n(\"小标题\", \"4.2 Agent Runtime\"),\n(\"要点\", \"支持 ReAct：观察、选择动作、执行一个动作、重新观察、验证结果。\"),\n(\"要点\", \"每个任务设置最大步数、超时、预算和重试上限。\"),\n(\"要点\", \"支持取消、检查点、失败分类、有限恢复和人工接管。\"),\n(\"要点\", \"模型只能提出动作；工具注册表、Action Guard 和运行时负责最终授权。\"),\n(\"小标题\", \"4.3 工具注册与契约\"),\n(\"要点\", \"每个工具定义输入/输出 Schema、风险级别、超时、幂等策略、成本估算、权限需求和健康检查。\"),\n(\"要点\", \"工具失败需分类：参数错误、适配器错误、供应商错误、网络错误、配额错误、输出不合格、下游验收失败。\"),\n(\"小标题\", \"4.4 工作流平台\"),\n(\"要点\", \"工作流定义使用 YAML/JSON，具有 ID、不可变版本、输入输出 Schema、节点依赖、条件、重试、补偿、预算和终止条件。\"),\n(\"要点\", \"工作流状态：Draft、Validated、Stable、Deprecated、RolledBack。\"),\n(\"要点\", \"一次成功只生成候选；必须通过独立输入、回归用例和失败注入后才可发布。\"),\n(\"小标题\", \"4.5 可观测性与诊断\"),\n(\"要点\", \"记录任务、节点、工具版本、模型配置版本、耗时、费用、重试、错误类别和验收结果。\"),\n(\"要点\", \"敏感内容和屏幕图像默认不上传；日志采用最小化、脱敏和保留期限策略。\"),\n(\"小标题\", \"4.6 进化与发布\"),\n(\"要点\", \"从运行证据产生改进提案；候选版本在隔离环境执行评测。\"),\n(\"要点\", \"允许自动发布的对象仅限经过 allowlist 的低风险配置，且需满足回归门槛。\"),\n(\"要点\", \"核心运行时、安全边界、权限机制和评测门禁不允许自主放宽。\"),\n]),\n(\"5. 总体技术架构（TAD）\", [\n(\"小标题\", \"5.1 五层架构\"),\n(\"要点\", \"L1 交互层：Android App、语音/文字入口、任务历史、审批和结果展示。\"),\n(\"要点\", \"L2 执行内核：Intent Router、Planner、ReAct Runtime、Context Manager、Action Guard、Recovery Manager。\"),\n(\"要点\", \"L3 能力与工作流：Tool Registry、Skill Registry、Workflow Compiler、Workflow Runtime、Asset Registry。\"),\n(\"要点\", \"L4 可靠性与评测：事件采集、诊断、工具健康、回归测试、成本和质量指标。\"),\n(\"要点\", \"L5 进化与发布：候选生成、隔离实验、模型档案、版本晋级、灰度、回滚。\"),\n(\"小标题\", \"5.2 基础设施\"),\n(\"正文\", \"V0.1 建议 Python 3.11+ 后端、SQLite 持久化、JSONL 事件日志、YAML/JSON 工作流定义、Git 版本控制。后续需要并发队列时再引入 PostgreSQL、Redis 或任务队列；不要在最小闭环未验证前过早引入复杂分布式架构。\"),\n(\"小标题\", \"5.3 推荐目录结构\"),\n(\"代码\", \"\"\"evoagent/\n  apps/mobile-android/\n  api/\n  runtime/\n    intent_router.py\n    planner.py\n    react_loop.py\n    state_machine.py\n    checkpoint.py\n    action_guard.py\n    recovery.py\n  tools/\n    registry.py\n    contracts.py\n    adapters/\n  workflows/\n    definitions/\n    compiler.py\n    validator.py\n    runner.py\n    versioning.py\n  context/\n    manager.py\n    summarizer.py\n    policy.py\n  observability/\n    events.py\n    diagnostics.py\n    tool_health.py\n  evaluation/\n    datasets/\n    regression.py\n    quality.py\n    benchmark.py\n  evolution/\n    proposals.py\n    experiments.py\n    promotion_gate.py\n    model_profiles.py\n  storage/\n    database.py\n    migrations/\n  tests/\n    unit/\n    integration/\n    regression/\n\"\"\"),\n]),\n(\"6. 工作流设计与固化机制\", [\n(\"小标题\", \"6.1 节点类型\"),\n(\"要点\", \"Tool：确定性工具调用。\"),\n(\"要点\", \"Agent：在明确输入、输出 Schema 和工具权限内完成局部判断。\"),\n(\"要点\", \"Condition：基于可验证条件选择分支。\"),\n(\"要点\", \"Approval：等待用户或授权主体确认。\"),\n(\"正文\", \"并行、重试、超时、循环、检查点和补偿操作由 Runtime 提供，不需要第一版设计过多节点类型。\"),\n(\"小标题\", \"6.2 轨迹到工作流的编译\"),\n(\"要点\", \"收集结构化执行轨迹和输入输出引用。\"),\n(\"要点\", \"归并可复用步骤，并结合工具契约识别数据依赖。\"),\n(\"要点\", \"从失败轨迹提取候选恢复分支，但未验证分支不能进入稳定版。\"),\n(\"要点\", \"输出工作流定义、Schema、来源轨迹引用和测试用例。\"),\n(\"要点\", \"执行静态检查、不同输入测试、失败注入和旧版回归。\"),\n(\"小标题\", \"6.3 工作流适用性\"),\n(\"正文\", \"匹配工作流时检查任务类型、输入 Schema、工具可用性、模型兼容性、预算和权限。匹配不充分时进入局部动态规划或完整动态规划，不得强行套用不适用流程。\"),\n]),\n(\"7. 数据模型与数据库\", [\n(\"正文\", \"V0.1 使用 SQLite；大型图片、视频、音频存放在文件系统或对象存储，数据库只保存 URI、哈希、版本和元数据。\"),\n(\"要点\", \"projects/tasks：项目和任务状态。\"),\n(\"要点\", \"task_steps/node_runs：节点执行、输入输出引用、耗时、错误和重试。\"),\n(\"要点\", \"runtime_events/trace_events：结构化事件日志。\"),\n(\"要点\", \"tool_registry/tool_health：工具契约、版本和健康指标。\"),\n(\"要点\", \"workflow_definitions/workflow_runs/workflow_releases：工作流定义、运行和发布历史。\"),\n(\"要点\", \"model_profiles：模型供应商、模型标识、提示词、参数、工具格式、兼容性测试和成本延迟指标。\"),\n(\"要点\", \"evaluation_suites/evaluation_results：评测集版本、测试结果和回归证据。\"),\n(\"要点\", \"evolution_proposals/experiments/promotion_decisions：进化提案、实验和晋级决策。\"),\n(\"要点\", \"approvals/audit_log：审批记录与安全审计。\"),\n]),\n(\"8. 核心接口契约\", [\n(\"正文\", \"建议 V0.1 先实现内部服务接口；对 Android 暴露 HTTP API 时再加认证、限流、请求签名或会话鉴权。\"),\n(\"要点\", \"POST /v1/tasks：创建任务，输入目标、约束、预算和验收条件。\"),\n(\"要点\", \"GET /v1/tasks/{task_id}：查询状态、当前步骤和结果摘要。\"),\n(\"要点\", \"POST /v1/tasks/{task_id}/cancel：取消任务。\"),\n(\"要点\", \"POST /v1/tasks/{task_id}/approvals：提交指定动作的审批决定。\"),\n(\"要点\", \"GET /v1/workflows：查询可用稳定工作流。\"),\n(\"要点\", \"GET /v1/workflows/{id}/versions：查看工作流版本。\"),\n(\"要点\", \"POST /v1/evaluations：提交评测结果。\"),\n(\"要点\", \"GET /v1/model-profiles：查询模型适配档案。\"),\n(\"要点\", \"POST /v1/releases/{id}/ack：确认候选版本激活、健康检查或回滚结果。\"),\n(\"正文\", \"接口必须采用幂等键处理可能重复的创建/付费任务请求；错误返回统一错误码、可重试标记和关联事件 ID。\"),\n]),\n(\"9. 安全、隐私与可靠性边界\", [\n(\"要点\", \"权限最小化：每个工具仅获得完成当前任务所需权限。\"),\n(\"要点\", \"高风险动作需对具体操作、目标和范围进行显式确认；笼统授权不可无限复用。\"),\n(\"要点\", \"模型输出视为不可信输入；必须经过 Schema、权限和策略检查。\"),\n(\"要点\", \"付费调用先预留预算，再提交请求；完成后按供应商实际费用对账。\"),\n(\"要点\", \"超时不等于任务失败；先查询远程任务状态，避免重复计费。\"),\n(\"要点\", \"日志默认最小化收集；敏感内容脱敏，屏幕截图和个人数据需要明确授权。\"),\n(\"要点\", \"发布清单应校验来源、完整性、兼容性和版本；签名不能替代行为测试。\"),\n(\"要点\", \"候选运行与稳定运行隔离；失败时可停止晋级并恢复上一稳定版本。\"),\n]),\n(\"10. 模型与工作流版本管理\", [\n(\"正文\", \"模型档案记录供应商、模型 ID/版本、提示词、上下文策略、工具调用格式、采样参数、超时、Token 预算、测试集版本、评测结果和依赖的工作流/工具版本。\"),\n(\"正文\", \"切换模型时创建新候选档案，执行结构化输出、工具调用、任务回归、质量、成本和时延测试。旧档案不可覆盖；新模型未通过时继续使用旧稳定档案。\"),\n(\"正文\", \"工作流、工具适配器、模型档案和评测集应分别版本化。每次任务固定绑定具体版本组合，禁止任务运行中无控制地热切换。\"),\n]),\n(\"11. 进化闭环与自动发布门禁\", [\n(\"小标题\", \"11.1 问题归因\"),\n(\"正文\", \"故障分类至少包括：意图/规划错误、模型输出格式错误、工具参数错误、适配器缺陷、供应商故障、网络/超时、预算/配额、环境变化、验收标准失败和最终质量不足。\"),\n(\"小标题\", \"11.2 候选评测\"),\n(\"要点\", \"静态检查与 Schema 验证。\"),\n(\"要点\", \"单元、集成、回归和失败注入测试。\"),\n(\"要点\", \"与稳定版本比较任务成功率、成本、时延、恢复率和质量。\"),\n(\"要点\", \"检查权限和隐私策略没有被放宽。\"),\n(\"要点\", \"记录数据集版本、运行环境、随机性和评测报告。\"),\n(\"小标题\", \"11.3 自动发布范围\"),\n(\"正文\", \"V0.1 默认不自动发布任何代码改动。后续可对 allowlist 中的低风险参数和非敏感提示词启用自动晋级，要求最小评测样本、最低质量分、零关键回归、安全规则不变和可回滚。结构性工作流改动、工具实现、Runtime、安全规则和评测门禁变更需更严格审核。\"),\n]),\n(\"12. V0.1 开发范围与里程碑\", [\n(\"小标题\", \"V0.1：最小可运行闭环\"),\n(\"要点\", \"Python 后端、配置、SQLite、结构化事件日志。\"),\n(\"要点\", \"一个云端模型适配器接口；提供 Mock 模式保证无 API Key 时也能跑通测试。\"),\n(\"要点\", \"工具注册表、ReAct 单步执行循环、Action Guard、任务状态机。\"),\n(\"要点\", \"至少 2 个确定性工具和 1 个可验证任务场景。\"),\n(\"要点\", \"最终验收器、失败分类、重试限制和任务取消。\"),\n(\"要点\", \"自动化单元测试、集成测试和一份回归评测集。\"),\n(\"正文\", \"V0.1 暂不要求 Android 无障碍自动化、自动工作流编译、自动发布代码、完整 AI 漫剧生产或多模型自动路由。这些能力在核心闭环验证后分阶段增加。\"),\n(\"小标题\", \"后续里程碑\"),\n(\"要点\", \"V0.2：DAG 工作流运行时、定义 Schema、版本化、检查点和恢复。\"),\n(\"要点\", \"V0.3：轨迹分析、候选工作流编译、模型档案、隔离实验和 Git 分支管理。\"),\n(\"要点\", \"V0.4：Android 入口、应用启动、受控无障碍观察与操作。\"),\n(\"要点\", \"V0.5：复杂专业能力包、限定范围的低风险自动发布。\"),\n]),\n(\"13. V0.1 验收标准\", [\n(\"小标题\", \"13.1 功能验收\"),\n(\"要点\", \"可以创建、查询、取消任务，并持久化任务状态。\"),\n(\"要点\", \"ReAct 每次最多执行一个动作，动作执行后重新观察和验证。\"),\n(\"要点\", \"工具调用经过注册表、Schema 和权限检查。\"),\n(\"要点\", \"成功与失败都会产生结构化事件，关联 task_id、tool_id 和版本信息。\"),\n(\"要点\", \"可区分至少五类故障：模型输出错误、参数错误、工具失败、超时、验收失败。\"),\n(\"要点\", \"达到最大重试次数或不确定状态时安全停止。\"),\n(\"小标题\", \"13.2 可靠性验收\"),\n(\"要点\", \"服务重启后可以恢复未完成任务的状态；不重复执行已确认完成的付费操作。\"),\n(\"要点\", \"同一幂等键不会创建重复的逻辑任务或付费调用。\"),\n(\"要点\", \"权限拒绝、高风险动作未审批、预算超限时均不会执行动作。\"),\n(\"要点\", \"测试集上的成功率、成本和时延有可复现报告。\"),\n(\"小标题\", \"13.3 交付验收\"),\n(\"要点\", \"提供可运行工程、配置样例、数据库迁移、启动说明、测试命令和故障排查文档。\"),\n(\"要点\", \"所有未实现或依赖外部服务的能力明确标注，不得将 Mock 成功报告为真实模型能力。\"),\n(\"要点\", \"至少提供一条从输入目标到结果验收的端到端演示。\"),\n]),\n(\"14. 关键风险与应对\", [\n(\"要点\", \"范围膨胀：以里程碑验收为准，新增能力必须说明归属层、依赖和延后项。\"),\n(\"要点\", \"模型不稳定：结构化输出、重试边界、回归集和模型档案。\"),\n(\"要点\", \"工具自身故障：工具契约测试、健康检查和独立故障分类。\"),\n(\"