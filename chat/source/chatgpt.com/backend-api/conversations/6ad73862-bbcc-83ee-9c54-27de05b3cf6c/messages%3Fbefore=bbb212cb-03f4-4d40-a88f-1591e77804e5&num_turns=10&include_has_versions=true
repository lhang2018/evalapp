tem\",null,__dil.jsx(\"text\",null,__dilConstants[\"629\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"630\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"631\"])),__dil.jsx(\"list-item\",null,__dil.jsx(\"text\",null,__dilConstants[\"632\"]))),__dil.jsx(\"text\",null,__dilConstants[\"633\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"634\"])),__dil.jsx(\"text\",null,__dilConstants[\"635\"]));},{\"key\":\"body:0\"}));","constants":{"0":"EvoAgent 第五十一专项：多专家协作、动态组队与跨专家任务交接","1":"本轮研究 EvoAgent 从“拥有多个独立专家”，走向“多个专家能够协同完成复杂任务”的核心架构。","2":"此前已经设计了多专家系统、统一 Router、Plan、ReAct、DAG、能力资产 CEKCE、质量验收 UQEAG、目标价值评估 GVAAG、人机协作 HACCG，以及故障诊断、版本治理和任务恢复机制。","3":"但这些设计还留下一个关键问题：","4":"当一个任务需要多个专家共同完成时，究竟由谁组织它们？它们如何分工、通信、处理冲突，并最终对整体结果负责？","5":"例如，AI 漫剧制作任务可能需要编剧、分镜、视觉生成、配音、视频合成和质量评测等能力。如果每个专家只是独立接收一段指令，系统很容易出现：","6":"前一个专家输出的格式不符合后一个专家的要求；","7":"多个专家重复分析相同问题，浪费模型调用和计算资源；","8":"一个专家修改了方案，其他专家仍然使用旧版本；","9":"专家之间给出相互矛盾的结论，却没有明确的裁决机制；","10":"某个关键专家失败，导致整个任务无法继续；","11":"每个专家都认为自己完成了工作，但没有任何模块对最终产物负责；","12":"专家数量越多，通信成本越高，整体质量反而下降。","13":"因此，建议将本专项定义为：","14":"Multi-Expert Orchestration & Dynamic Teaming，简称 MEODT。","15":"它负责多专家团队的组建、分工、协作协议、信息共享、冲突解决、动态调整、交接、故障恢复与团队级质量验收。","16":"本专项最重要的原则是：","17":"不是所有复杂任务都需要多个专家。只有当专业分工、并行执行或独立审查所带来的收益，大于协调成本和新增风险时，才应该组建专家团队。","18":"一、第一性原理：专家数量不等于协作能力","19":"先区分三个概念。","20":"专家能力：","21":" 某个专家擅长完成什么工作。","22":"任务编排：","23":" 整个任务应该分解成哪些步骤、有哪些依赖关系。","24":"团队协作：","25":" 多个专家如何共同执行这些步骤，交换必要信息，并对整体结果形成一致判断。","26":"这三者不能互相替代。","27":"一个编程专家可以调用 AST 分析、测试和静态检查等多个技能，但不一定需要组成多个独立专家。反过来，一个复杂的代码重构任务也可能需要代码分析专家、架构专家和独立审查专家协作。","28":"同样，DAG 可以描述任务节点之间的依赖关系，却不能单独解决专家之间的责任归属、通信冲突、共享上下文和协作失败问题。","29":"1.1 多专家协作的价值从哪里来？","30":"专业互补","31":"不同专家拥有不同的知识、工具、评测方法和领域能力，能够弥补单一专家的局限。","32":"并行执行","33":"互不依赖的任务可以同时执行，降低整体等待时间。","34":"独立审查","35":"由不同专家验证关键结果，降低执行者忽略自身错误的风险。","36":"故障隔离与替代","37":"某个专家暂时不可用时，可以在契约允许的情况下切换到替代专家或备用能力。","38":"但协作也有代价：","39":"专家之间需要传递信息；","40":"不同专家可能采用不同的假设；","41":"输出格式和质量标准可能不一致；","42":"并行执行可能产生额外资源消耗；","43":"团队协调本身也可能失败。","44":"因此，团队是否值得组建，应该由 GVAAG 结合任务价值、成本、风险与成功概率评估，而不是由任务复杂度单独决定。","45":"1.2 建立协作收益判断","46":"可以用一个简化模型辅助判断：","47":"\\Delta V_{\\text{team}}\n=\nB_{\\text{specialization}}\n+B_{\\text{parallelism}}\n+B_{\\text{verification}}\n-C_{\\text{coordination}}\n-C_{\\text{resources}}\n-R_{\\text{interaction}}","48":"其中：","49":"B_{\\text{specialization}}","50":"：专业互补带来的收益；","51":"B_{\\text{parallelism}}","52":"：并行执行带来的收益；","53":"B_{\\text{verification}}","54":"：独立审查带来的收益；","55":"C_{\\text{coordination}}","56":"：协调、通信和交接成本；","57":"C_{\\text{resources}}","58":"：新增模型调用、计算和外部服务成本；","59":"R_{\\text{interaction}}","60":"：协作产生的冲突、错误传播和副作用风险。","61":"这不是精确的数学定律，而是一个决策框架。","62":"对于简单任务，一个专家通常就足够。对于需要多个专业领域、可以并行处理且结果需要独立审查的任务，多专家团队可能具有明显优势。","63":"默认从最小团队开始，只在有证据表明需要时增加专家。","64":"二、总体架构：在任务编排之上增加团队协调层","65":"建议建立 ","66":"MEODT Orchestration Layer","67":"，作为多专家团队的统一协调层。","68":"它不取代 Planner、DAG、ReAct 或领域专家，而是负责决定哪些专家参与任务、各自负责什么、如何交换信息，以及如何汇总和验收团队结果。","69":"用户目标与统一任务入口","70":"由 Router 识别领域，由 GVAAG 判断目标价值、授权和团队组建的必要性。","71":"MEODT 团队协调器","72":"决定团队拓扑、专家角色、任务所有权、交接规则、共享信息与协作预算。","73":"专家 A","74":"领域知识、工具和专属策略。","75":"专家 B","76":"独立子任务与领域产物。","77":"专家 C","78":"补充专业能力或独立审查。","79":"协调与集成","80":"处理交接、依赖、冲突与结果汇总。","81":"通过任务契约、共享产物和结构化事件协作","82":"团队级质量验收与状态管理","83":"UQEAG 验收整体结果，LTAR 管理任务生命周期，SOCDEA 处理团队级失败诊断。","84":"2.1 协调器不等于一个必须存在的“总指挥模型”","85":"MEODT 的协调器可以由不同实现组成：","86":"一个规则与状态机驱动的协调服务；","87":"一个负责复杂任务分解的协调智能体；","88":"一个基于 DAG 的确定性编排器；","89":"或者由上述几种机制组合而成。","90":"简单任务可以完全使用确定性编排，不需要额外调用协调模型。","91":"复杂任务则可以由协调智能体提出方案，但最终的任务依赖、授权、预算和状态变更仍然需要由可验证的控制逻辑执行。","92":"这能够避免团队中出现一个新的万能智能体，导致所有决策再次集中到一个难以审计的模型里。","93":"三、团队拓扑：不是所有协作都使用同一种模式","94":"MEODT 首先需要解决一个选择问题：不同类型的任务，应该采用什么样的专家协作结构？","95":"建议支持六种团队拓扑，并由协调器根据任务结构、依赖关系、风险和资源条件选择。","96":"3.1 六种协作模式","97":"模式 A：单专家执行","98":"领域专家","99":"交付结果","100":"适合目标明确、专业范围单一、没有明显并行或独立审查收益的任务。应作为默认模式。","101":"模式 B：顺序交接","102":"专家 A：分析","103":"专家 B：实施","104":"专家 C：验收","105":"适合输出具有明确依赖关系的任务，例如分析需求、生成代码、独立测试。","106":"模式 C：并行分工","107":"协调器：分派任务","108":"专家 A","109":"专家 B","110":"专家 C","111":"汇总与验收","112":"适合互相独立的子任务，例如并行研究多个技术方案或分别分析不同模块。","113":"模式 D：主管—执行者","114":"主管智能体","115":"多个专业执行者","116":"主管检查与再分配","117":"适合目标复杂、任务结构可能动态变化、需要持续协调与资源重新分配的长期工作。","118":"模式 E：独立评审与对抗检查","119":"执行专家：生成结果","120":"评审专家 A","121":"评审专家 B","122":"证据汇总与裁决","123":"适合高价值或高风险任务。评审者需要尽可能独立，不能只复述执行者的结论。","124":"模式 F：动态混合团队","125":"动态任务 DAG 与协调器","126":"按需加入、退出、替换专家与评审者","127":"适合漫剧生产、大型代码工程和跨领域研究等任务，可随新证据调整分工，但必须有预算与变更门槛。","128":"这些模式不是互斥的。","129":"一个 AI 漫剧任务可以采用动态混合团队：先由编剧和分镜专家顺序交接，再让视觉与配音专家并行工作，最后由合成专家整合，并由独立质量专家进行验收。","130":"3.2 如何选择协作模式？","131":"建议由协调器按照以下顺序判断：","132":"单个专家能否在合理成本内完成任务？","133":"是否存在真正独立的子任务？","134":"是否存在必须由不同专业能力承担的阶段？","135":"是否需要独立评审来降低关键错误风险？","136":"是否有足够的资源支持并行？","137":"多专家带来的收益是否超过协调成本？","138":"失败时是否能够安全恢复或替换专家？","139":"如果没有明确的协作收益，就使用单专家模式。","140":"如果只是需要调用多个工具，不应该为了体现多专家架构而强行拆成多个智能体。","141":"四、专家角色模型：谁负责执行，谁负责协调，谁负责验收？","142":"在团队中，领域专家和团队角色不是同一回事。","143":"例如，编程专家可以在一个任务中负责实施，在另一个任务中负责审查。协调器也可以是一个独立的轻量服务，而不是一个领域专家。","144":"建议把团队成员定义为具有明确角色的 ","145":"TeamMember","146":"。","147":"4.1 建议的团队角色","148":"角色","149":"主要职责","150":"COORDINATOR","151":"组织团队、分配任务、跟踪依赖和处理交接","152":"SPECIALIST","153":"提供领域知识与专业产物","154":"EXECUTOR","155":"在授权范围内执行具体操作","156":"RESEARCHER","157":"搜集信息、验证来源、提出候选方案","158":"REVIEWER","159":"独立检查产物、假设和证据","160":"INTEGRATOR","161":"合并不同专家的输出，解决格式与接口问题","162":"OBSERVER","163":"观察进度、成本、风险与异常，不直接修改目标产物","164":"这些角色可以由不同的智能体实例承担，也可以由一个专家在不同阶段切换角色。","165":"但对高风险任务，应避免同一个执行实例同时负责实施、独立评审和最终批准，以降低自我验证的偏差。","166":"4.2 团队成员需要明确责任边界","167":"建议每个成员都具有：","168":"member_id","169":"：团队内唯一标识；","170":"expert_id","171":"：所属专家；","172":"role","173":"：当前团队角色；","174":"owned_tasks","175":"：负责的任务；","176":"input_contract","177":"：接收信息的格式；","178":"output_contract","179":"：交付产物的格式；","180":"allowed_resources","181":"：允许访问的资源；","182":"budget_quota","183":"：资源配额；","184":"completion_criteria","185":"：完成条件；","186":"failure_policy","187":"：失败时的处理策略；","188":"reporting_policy","189":"：需要汇报哪些事件。","190":"这使得协调器可以准确判断某个成员是否完成任务，以及其结果能否进入下一个节点。","191":"4.3 责任不能因为多人协作而消失","192":"多专家系统容易出现一个问题：每个专家都完成了自己的局部任务，但整个项目没有人对最终结果负责。","193":"建议采用明确的责任模型：","194":"每个子任务有唯一的责任主体；","195":"每个共享产物有明确的所有者；","196":"每个团队有唯一的整体协调责任主体；","197":"最终交付必须经过 UQEAG 的团队级验收；","198":"涉及用户授权或重大副作用的操作，仍由独立治理规则决定是否需要用户批准。","199":"整体责任主体负责保证协作闭环，但不能代替实际的质量验收。","200":"五、与 Planner、DAG、ReAct 的关系：不能把架构混成一团","201":"这是多专家架构必须明确的边界。","202":"组件","203":"回答的问题","204":"GVAAG","205":"这项任务是否值得做？是否获得授权？","206":"Router","207":"哪个专家或处理路径最适合？","208":"MEODT","209":"是否需要多个专家？团队如何分工与协作？","210":"Planner","211":"应该采取什么计划？","212":"DAG","213":"任务之间有哪些依赖、并行和汇合关系？","214":"ReAct","215":"当前执行步骤如何根据观察结果动态调整？","216":"TERSO","217":"工具如何被安全、可靠地执行？","218":"UQEAG","219":"任务产物是否达到验收标准？","220":"LTAR","221":"任务状态如何持久化、暂停、恢复和终止？","222":"这里有一条重要原则：","223":"团队协作不替代 DAG，DAG 也不替代团队协调。","224":"DAG 描述任务节点及依赖；MEODT 管理专家如何承担这些节点、如何通信、何时交接，以及发生冲突时由谁处理。","225":"例如，一个 DAG 节点可以分配给编程专家执行，而另一个节点分配给审查专家验证。两个专家的交接和责任由 MEODT 管理，节点之间的执行依赖由 DAG 管理。","226":"对于动态任务，协调器可以请求修改 DAG，但必须经过明确的计划变更、预算检查和授权检查，不能直接在执行过程中任意增加任务。","227":"六、团队协作协议：专家之间应该交换什么信息？","228":"这是决定多专家系统是否稳定的关键。","229":"如果专家之间只传递自然语言对话，系统会很难确定某个结论究竟是事实、假设、建议，还是已经验证的结果。","230":"例如，编程专家说：","231":"“这个重构方案应该没有问题。”","232":"对于后续专家来说，这句话缺少关键信息：它基于什么代码版本？运行过哪些测试？哪些行为尚未验证？是否存在已知风险？","233":"因此，建议建立统一的 ","234":"TeamMessageProtocol","235":" 和 ","236":"WorkPackageContract","237":"。","238":"6.1 任务交接不能只传递一段提示词","239":"每个子任务应通过结构化工作包进行交接。","240":"字段","241":"作用","242":"work_package_id","243":"工作包唯一标识","244":"team_id","245":"所属团队","246":"task_id","247":"关联的主任务","248":"goal_ref","249":"上级目标与验收契约","250":"assigned_member","251":"当前责任成员","252":"input_artifacts","253":"输入产物及版本","254":"required_outputs","255":"必须交付的结果","256":"constraints","257":"范围、预算、时间和禁止事项","258":"dependencies","259":"前置工作与依赖","260":"completion_criteria","261":"明确的完成条件","262":"evidence_requirements","263":"必须提供的证据","264":"handoff_status","265":"当前交接状态","266":"这样，下游专家不需要重新阅读全部历史对话，就能知道自己接收的工作是什么。","267":"6.2 统一团队消息类型","268":"建议至少定义以下消息类型：","269":"TASK_ASSIGNMENT","270":"：分派任务；","271":"STATUS_UPDATE","272":"：汇报进度；","273":"ARTIFACT_READY","274":"：通知产物已经生成；","275":"HANDOFF_REQUEST","276":"：请求交接；","277":"BLOCKER_REPORTED","278":"：报告阻塞；","279":"EVIDENCE_SUBMITTED","280":"：提交验证证据；","281":"CONFLICT_RAISED","282":"：提出结论或产物冲突；","283":"REPLAN_REQUEST","284":"：请求重新规划；","285":"BUDGET_WARNING","286":"：资源消耗达到预警阈值；","287":"TASK_COMPLETED","288":"：报告子任务完成；","289":"TASK_FAILED","290":"：报告任务失败。","291":"消息应有唯一标识、来源、目标、关联任务、时间和版本信息。","292":"重要的状态变更必须持久化，不能只存在于某个模型的临时对话上下文中。","293":"6.3 消息与产物分离","294":"专家可以在消息中说明某个结果已经生成，但实际产物应保存在可引用、可版本化的存储中。","295":"例如，消息可以引用：","296":"代码差异；","297":"研究报告；","298":"分镜清单；","299":"视频文件；","300":"测试报告；","301":"验收证据。","302":"消息负责通知和解释，产物负责保存实际内容。","303":"这样可以减少重复传输大型文件，也能避免多个专家各自持有内容略有不同的副本。","304":"七、共享上下文：团队应该共享多少信息？","305":"多专家协作并不意味着所有专家共享完整对话、全部记忆和全部工具输出。","306":"共享太少，会导致专家缺少必要背景；共享太多，则会增加成本、信息噪声、隐私暴露和上下文冲突。","307":"建议将团队上下文分成四层。","308":"T0 · 团队公共上下文","309":"主目标、任务约束、验收契约、团队分工、当前版本、共同决策和关键风险。","310":"T1 · 任务相关上下文","311":"某个工作包的输入、必要历史、依赖产物、相关证据和局部决策。","312":"T2 · 专家私有上下文","313":"专家自己的领域推理、专属记忆、内部策略与不需要向团队传播的细节。","314":"T3 · 证据与产物存储","315":"完整日志、文件、测试报告、引用来源、版本化产物和必要的审计记录，按需检索。","316":"7.1 公共上下文只保留对协作有用的信息","317":"团队公共上下文不应该成为所有专家输出的拼接集合。","318":"它应优先包含：","319":"当前有效的目标和约束；","320":"每个成员的职责；","321":"已经确认的关键事实；","322":"已经批准的方案；","323":"尚未解决的冲突；","324":"关键产物的版本；","325":"当前风险和资源状态。","326":"冗长的推理过程、重复的工具日志和与当前任务无关的记忆，应保存在相应的私有上下文或证据存储中。","327":"7.2 上下文压缩必须保留协作关键状态","328":"如果 ACMO 对团队上下文进行压缩，必须保留：","329":"未完成工作；","330":"关键决策及其依据；","331":"产物版本；","332":"依赖关系；","333":"未解决的分歧；","334":"用户的有效约束；","335":"当前授权状态；","336":"预算与截止条件。","337":"不能只保留一段自然语言摘要，然后丢失哪些结论已经验证、哪些只是猜测。","338":"7.3 共享上下文不能自动扩大权限","339":"专家能够看到某个文件，不代表它有权修改该文件。","340":"专家收到其他成员的工具调用记录，也不代表它获得了执行相同操作的授权。","341":"因此，团队上下文和能力资产必须与独立的权限检查机制分离。","342":"八、产物所有权与并发冲突：谁可以修改什么？","343":"这是多专家并行执行时非常容易出现的问题。","344":"例如，两个专家同时修改同一个代码模块；或者一个专家正在更新分镜，另一个专家仍然依据旧分镜生成素材。","345":"如果没有明确的产物所有权与版本协议，团队可能产生相互覆盖、重复工作和难以追溯的结果。","346":"建议建立 ","347":"ArtifactOwnershipPolicy","348":"。","349":"8.1 默认采用单一写入者","350":"对于同一份共享产物，建议默认只有一个责任主体能够提交正式修改。","351":"其他专家可以：","352":"读取当前版本；","353":"提交修改建议；","354":"生成独立分支；","355":"在隔离环境中进行候选修改。","356":"但正式合并应经过明确的版本检查与集成流程。","357":"例如，两个代码专家可以分别生成不同的补丁，但不能无协调地同时覆盖同一份工作目录。","358":"8.2 使用版本校验防止陈旧输入","359":"每个工作包都应声明输入产物的版本。","360":"如果下游专家开始工作后，上游产物已经更新，系统应判断：","361":"新版本是否与原版本兼容；","362":"当前工作是否依赖已经变化的内容；","363":"是否需要重新运行相关步骤；","364":"原有输出是否仍然有效。","365":"不能简单地把最新产物覆盖到所有专家的输入中，却不检查依赖关系。","366":"8.3 集成专家不能替代质量验收","367":"集成专家负责合并产物、解决格式与接口冲突，并形成候选的最终结果。","368":"但它不应因为成功合并所有文件，就直接宣称整体任务合格。","369":"最终产物仍然需要经过 UQEAG 的团队级验收；高风险或关键任务还可以增加独立审查。","370":"九、专家冲突：多个专家给出不同结论时怎么办？","371":"多专家协作不能假定所有专家都会达成一致。","372":"它们可能因为知识不同、输入版本不同、目标权重不同，或者评测方法不同而产生分歧。","373":"例如：","374":"架构专家建议拆分服务，成本专家认为当前项目不值得增加服务；","375":"编程专家认为代码修改完成，审查专家发现回归风险；","376":"视觉专家建议重新生成角色素材，视频工程专家认为可以通过后期处理解决；","377":"两个研究专家引用了不同时间的资料，得出相互矛盾的结论。","378":"如果系统仅采用多数投票，可能会选择一个错误的方案；如果总是听从主管智能体，也可能放大主管本身的判断偏差。","379":"建议建立 ","380":"ConflictResolutionEngine","381":"。","382":"9.1 首先区分四种冲突","383":"冲突类型","384":"示例","385":"处理方法","386":"事实冲突","387":"两个专家对同一事实给出不同结论","388":"核对来源、时间和证据","389":"方案冲突","390":"两种实现路径都可行","391":"比较成本、风险、收益与约束","392":"产物冲突","393":"两个专家修改了同一文件或数据","394":"依据所有权、版本和集成规则解决","395":"目标冲突","396":"某个专家的方案违反用户的原始约束","397":"回到有效目标与授权，不以投票覆盖","398":"这四类冲突不能采用同一种解决方式。","399":"9.2 建议的冲突处理流程","400":"9.3 不要让多数投票替代证据","401":"三个专家重复同一个来源，并不等于有三份独立证据。","402":"同一个基础模型在三个不同角色提示下给出相同答案，也不意味着得到了真正独立的验证。","403":"对于事实性或高风险结论，应优先检查证据来源和验证方式的独立性，而不是简单统计专家数量。","404":"对于方案选择，则可以综合比较各自的预期收益、成本、风险和适用条件。","405":"9.4 重大冲突应允许升级到用户","406":"当存在多个合理方案，但它们在成本、产品方向或用户偏好上有实质性差异时，系统应通过 HACCG 向用户展示关键差异，而不是无限组织专家讨论。","407":"如果冲突涉及强制安全约束，协调器也不能通过团队投票改变规则。","408":"专家可以对方案提出异议，但不能通过协商创造新的权限。","409":"十、动态组队：什么时候增加、替换或移除专家？","410":"静态团队容易理解，但复杂任务可能在执行过程中不断出现新问题。","411":"例如，编程专家最初判断只是局部代码修改，后来发现问题来自数据库事务设计，需要架构专家加入；又或者某个外部模型服务不可用，需要替换相关执行专家。","412":"因此，MEODT 需要支持动态组队，但必须避免团队规模不断膨胀。","413":"建议建立 ","414":"TeamReconfigurationPolicy","415":"。","416":"10.1 允许动态调整的触发条件","417":"发现现有团队缺少必要的专业能力；","418":"某个专家反复无法完成任务；","419":"任务目标发生实质性变化；","420":"新证据改变了任务分解方式；","421":"当前团队资源不足；","422":"某个阶段需要独立审查；","423":"某个专家不再有未完成工作；","424":"继续保留某个成员的协调成本已经超过其预期收益。","425":"10.2 增加专家前必须回答三个问题","426":"新专家是否拥有当前团队缺少的能力？","427":"它是否能够利用已有产物和契约，而不需要重复整个任务？","428":"增加它是否会产生足够的预期收益，抵消上下文、通信和执行成本？","429":"如果新专家只是重复现有专家已经完成的工作，而且没有独立验证或替代价值，就不应该加入。","430":"10.3 专家退出不能丢失责任","431":"当一个成员退出团队时，必须处理：","432":"未完成的工作包；","433":"尚未提交的产物；","434":"正在运行的工具；","435":"已占用的资源；","436":"需要交接的决策与证据；","437":"其他成员对它的依赖。","438":"协调器应将任务重新分配、保留为待办，或者明确终止，而不是直接删除成员记录。","439":"10.4 动态组队必须受预算约束","440":"建议为每个团队设置：","441":"最大并发成员数；","442":"最大模型调用量；","443":"总预算上限；","444":"每个成员的资源配额；","445":"最大重规划次数；","446":"最大冲突处理轮数；","447":"最大返工次数。","448":"具体数值应根据任务类型和设备能力配置，而不是在全局硬编码一个适用于所有场景的数字。","449":"对于个人电脑或微型 Linux 主机，还应考虑内存、GPU、并发模型调用和后台任务对前台交互的影响。","450":"十一、专家失败与团队恢复：一个成员失败，不应该让整个任务失去进度","451":"多专家系统必须能够处理局部失败。","452":"例如，漫剧制作中的配音专家暂时无法访问外部服务，但分镜、视觉素材和故事脚本都已完成。如果整个任务因此重新开始，就会浪费大量资源。","453":"建议建立 ","454":"TeamRecoveryManager","455":"，与 LTAR、TERSO、SOCDEA 和 UQEAG 协作。","456":"11.1 将失败分为五类","457":"失败类型","458":"典型情况","459":"默认处理","460":"成员执行失败","461":"某专家输出格式错误","462":"修复或有限重试","463":"能力不可用","464":"所需工具或模型不可用","465":"使用兼容替代能力或等待","466":"交接失败","467":"输入产物缺失、版本不匹配","468":"重新核验契约和依赖","469":"协作失败","470":"冲突无法解决、责任不明确","471":"暂停相关节点，升级协调","472":"团队级失败","473":"关键目标无法达成、预算耗尽","474":"诊断、调整范围、请求用户决策或终止","475":"这些失败需要不同的恢复策略，不能全部交给一个无限重试循环。","476":"11.2 从检查点恢复，而不是从头重做","477":"团队需要保存：","478":"已完成工作包；","479":"当前产物版本；","480":"已验证的证据；","481":"未完成的依赖；","482":"当前团队成员与角色；","483":"资源消耗；","484":"尚未解决的冲突；","485":"当前有效的目标、授权和预算。","486":"恢复时，协调器应判断哪些节点仍然有效，哪些需要重新执行。","487":"如果只是在替换配音专家，而脚本和画面素材没有变化，就不应该无条件重新生成所有视觉素材。","488":"如果上游分镜发生变化，则依赖它的素材生成和合成步骤可能需要重新执行。","489":"11.3 替代专家必须满足契约兼容","490":"不能仅因为两个专家都属于“编程专家”就认为它们可以互换。","491":"替代成员需要满足：","492":"工作包输入输出契约；","493":"必要的专业能力；","494":"所需工具和权限；","495":"当前运行环境；","496":"质量验收要求；","497":"剩余预算与时间约束。","498":"如果替代专家的输出格式不同，需要通过经过验证的适配器进行转换，而不是直接将其结果交给下游。","499":"11.4 局部恢复不能绕过最终验收","500":"即使所有失败节点都已经重新运行，最终结果仍可能不合格。","501":"因此，团队恢复完成后，应根据受影响的产物和依赖关系执行必要的回归验证，并由 UQEAG 决定是否通过。","502":"十二、团队级质量评测：评价协作结果，而不是成员数量","503":"多专家系统最容易出现的错误之一，是把“所有成员都完成任务”当成“团队完成任务”。","504":"实际上，团队可能发生：","505":"子任务之间不兼容；","506":"关键要求无人负责；","507":"多个成员重复工作；","508":"产物整合失败；","509":"冲突被隐藏；","510":"最终结果缺少必要证据。","511":"因此，建议建立 ","512":"TeamEvaluationProfile","513":"。","514":"12.1 团队质量的六个维度","515":"维度","516":"评估内容","517":"目标完成度","518":"整体交付是否满足主任务要求","519":"协作正确性","520":"工作包、依赖、交接和产物版本是否正确","521":"专业质量","522":"各领域产物是否达到相应的验收标准","523":"协作效率","524":"相比单专家基线，是否减少时间或提高质量","525":"资源效率","526":"新增协调和并行执行的成本是否合理","527":"故障恢复能力","528":"成员失败、工具异常和任务变更后能否恢复","529":"其中，最终交付质量仍由 UQEAG 的验收契约决定。团队评测不能取代最终验收，也不能通过多个成员的平均分掩盖某个关键子任务的严重缺陷。","530":"12.2 团队评测应当与单专家基线比较","531":"对于适合比较的任务，建议在评测集上对照：","532":"单专家执行；","533":"多专家顺序交接；","534":"多专家并行执行；","535":"多专家加独立评审。","536":"比较质量、延迟、成本、失败率和恢复表现。","537":"如果多专家模式并没有稳定的质量或效率优势，就应考虑简化团队拓扑。","538":"12.3 评测团队协作是否真正减少了错误","539":"不能只统计专家数量、通信次数和子任务完成率。","540":"更重要的是：","541":"是否发现了单专家容易遗漏的问题；","542":"是否减少了重复劳动；","543":"是否降低了接口错误；","544":"是否缩短了关键路径；","545":"是否提升了最终产物质量；","546":"是否增加了新的错误传播路径。","547":"团队协作的价值应通过结果证明，而不是通过系统结构的复杂程度证明。","548":"十三、与现有架构的集成关系","549":"MEODT 必须与前面设计的系统模块形成稳定的职责边界。","550":"模块","551":"协作关系","552":"Router","553":"选择领域专家或初始处理路径","554":"GVAAG","555":"决定目标是否值得执行，以及组队的预期价值","556":"CEKCE / CIL","557":"提供可复用的专家能力、技能和工作流","558":"Planner / DAG","559":"规划子任务、依赖关系和执行顺序","560":"ReAct","561":"处理成员内部的动态执行与观察","562":"TERSO","563":"执行工具调用和控制副作用","564":"MTSRIC / ARCBG","565":"管理团队并发、资源配额和总预算","566":"ACMO / MEEG / CLEK","567":"提供上下文、记忆与知识检索","568":"UQEAG","569":"验收团队产物和整体交付结果","570":"LTAR","571":"持久化团队任务、检查点、暂停与恢复状态","572":"SOCDEA","573":"诊断协作失败、交接错误和无效重复工作","574":"HACCG","575":"处理用户确认、目标变更、暂停、取消和人工接管","576":"CGVCM","577":"管理团队协议、契约和依赖版本","578":"SELCIA","579":"管理经过验证的团队策略改进及受控发布","580":"需要特别明确：","581":"MEODT 负责组织专家协作，不负责自行决定所有专家的目标、权限、资源和验收标准。","582":"这些职责仍由相应的治理模块承担。","583":"十四、建议冻结的架构决策","584":"以下是建议纳入 EvoAgent 全量架构的 MEODT 治理基线。","585":"这些是建议纳入 EvoAgent 全量架构的多专家协作治理基线。正式实施时，还需要定义 ","586":"TeamRecord","587":"、","588":"TeamMember","589":"、","590":"WorkPackageContract","591":"、","592":"TeamMessageProtocol","593":"、","594":"ArtifactOwnershipPolicy","595":"、","596":"ConflictResolutionRecord","597":" 和 ","598":"TeamRecoveryManager","599":" 等接口与状态机。","600":"十五、第一版怎么落地？","601":"不建议一开始就实现可以无限增加专家、自由讨论和动态改写团队结构的系统。","602":"更合理的路线是先把协作契约和执行闭环跑通。","603":"第一版的核心验收标准应是：两个专家可以在明确契约下完成一次真实的交接；失败后可以恢复；最终产物能够独立验收；所有关键状态都能追踪。","604":"只要这条闭环稳定运行，动态组队和更复杂的团队优化才有可靠的基础。","605":"十六、下一专项：全局事件总线、运行可观测性与因果追踪","606":"多专家协作解决了多个专家如何共同完成任务的问题，但也让系统的运行链路变得更加复杂。","607":"当一个任务涉及 Router、多个专家、DAG、工具、记忆、质量验收和进化控制器时，如果最终结果失败，系统必须能够回答：","608":"用户的原始请求是什么？","609":"为什么选择了这个专家和这条执行路径？","610":"哪些决策改变了任务方向？","611":"哪个专家产生了问题，问题又如何传播到其他节点？","612":"哪些工具实际执行了操作？","613":"任务为什么暂停、恢复或重新规划？","614":"哪个版本的能力、模型和配置参与了执行？","615":"这次失败究竟来自执行、协作、评测还是治理？","616":"手机与主机断联期间发生了什么，恢复连接后如何还原完整过程？","617":"如果没有统一的事件与追踪体系，SOCDEA 很难进行可靠的根因诊断，UQEAG 也难以判断验收证据是否可信，CEKCE 更无法准确判断一项能力是否真的进步。","618":"因此，下一专项建议定义为：","619":"Global Event & Causal Observability，简称 GECO。","620":"重点研究：","621":"如何建立跨模块统一事件模型与事件总线；","622":"如何关联用户请求、目标、任务、DAG 节点、专家、工具和产物；","623":"如何区分事件、状态、日志、指标、追踪与因果关系；","624":"如何重建一次任务的完整执行时间线；","625":"如何在多专家并行、重试和跨设备执行中保持事件关联；","626":"如何在断网、崩溃和重复消息情况下保证事件可靠记录；","627":"如何利用事件数据支持 SOCDEA 的根因分析；","628":"如何向 UQEAG 提供可追溯的验收证据；","629":"如何评估 Router、专家、工作流和技能的真实运行表现；","630":"如何在个人电脑或微型 Linux 主机的有限资源下控制日志存储和追踪开销；","631":"如何管理日志脱敏、敏感信息访问和审计权限；","632":"如何利用历史事件回放复现故障，而不重复执行真实外部副作用。","633":"本专项的核心原则是：","634":"系统不仅要知道最终发生了什么，还要能够重建关键决策、实际执行、状态变化与结果之间的关系，并明确哪些因果结论已经得到验证、哪些仍然只是推测。","635":"这将为 EvoAgent 的任务恢复、质量评测、根因诊断、能力进化和多专家协作建立统一的运行事实基础。"},"fallbackMarkdown":"# EvoAgent 第五十一专项：多专家协作、动态组队与跨专家任务交接\n\n本轮研究 EvoAgent 从“拥有多个独立专家”，走向“多个专家能够协同完成复杂任务”的核心架构。\n\n此前已经设计了多专家系统、统一 Router、Plan、ReAct、DAG、能力资产 CEKCE、质量验收 UQEAG、目标价值评估 GVAAG、人机协作 HACCG，以及故障诊断、版本治理和任务恢复机制。\n\n但这些设计还留下一个关键问题：\n\n**当一个任务需要多个专家共同完成时，究竟由谁组织它们？它们如何分工、通信、处理冲突，并最终对整体结果负责？**\n\n例如，AI 漫剧制作任务可能需要编剧、分镜、视觉生成、配音、视频合成和质量评测等能力。如果每个专家只是独立接收一段指令，系统很容易出现：\n\n- 前一个专家输出的格式不符合后一个专家的要求；\n- 多个专家重复分析相同问题，浪费模型调用和计算资源；\n- 一个专家修改了方案，其他专家仍然使用旧版本；\n- 专家之间给出相互矛盾的结论，却没有明确的裁决机制；\n- 某个关键专家失败，导致整个任务无法继续；\n- 每个专家都认为自己完成了工作，但没有任何模块对最终产物负责；\n- 专家数量越多，通信成本越高，整体质量反而下降。\n\n因此，建议将本专项定义为：\n\n**Multi-Expert Orchestration &amp; Dynamic Teaming，简称 MEODT。**\n\n它负责多专家团队的组建、分工、协作协议、信息共享、冲突解决、动态调整、交接、故障恢复与团队级质量验收。\n\n本专项最重要的原则是：\n\n**不是所有复杂任务都需要多个专家。只有当专业分工、并行执行或独立审查所带来的收益，大于协调成本和新增风险时，才应该组建专家团队。**\n\n---\n\n# 一、第一性原理：专家数量不等于协作能力\n\n先区分三个概念。\n\n- **专家能力：** 某个专家擅长完成什么工作。\n- **任务编排：** 整个任务应该分解成哪些步骤、有哪些依赖关系。\n- **团队协作：** 多个专家如何共同执行这些步骤，交换必要信息，并对整体结果形成一致判断。\n\n这三者不能互相替代。\n\n一个编程专家可以调用 AST 分析、测试和静态检查等多个技能，但不一定需要组成多个独立专家。反过来，一个复杂的代码重构任务也可能需要代码分析专家、架构专家和独立审查专家协作。\n\n同样，DAG 可以描述任务节点之间的依赖关系，却不能单独解决专家之间的责任归属、通信冲突、共享上下文和协作失败问题。\n\n## 1.1 多专家协作的价值从哪里来？\n\n**专业互补**\n\n不同专家拥有不同的知识、工具、评测方法和领域能力，能够弥补单一专家的局限。\n\n---\n\n**并行执行**\n\n互不依赖的任务可以同时执行，降低整体等待时间。\n\n---\n\n**独立审查**\n\n由不同专家验证关键结果，降低执行者忽略自身错误的风险。\n\n---\n\n**故障隔离与替代**\n\n某个专家暂时不可用时，可以在契约允许的情况下切换到替代专家或备用能力。\n\n但协作也有代价：\n\n- 专家之间需要传递信息；\n- 不同专家可能采用不同的假设；\n- 输出格式和质量标准可能不一致；\n- 并行执行可能产生额外资源消耗；\n- 团队协调本身也可能失败。\n\n因此，团队是否值得组建，应该由 GVAAG 结合任务价值、成本、风险与成功概率评估，而不是由任务复杂度单独决定。\n\n## 1.2 建立协作收益判断\n\n可以用一个简化模型辅助判断：\n\n\\[\n\\Delta V_{\\text{team}}\n=\nB_{\\text{specialization}}\n+B_{\\text{parallelism}}\n+B_{\\text{verification}}\n-C_{\\text{coordination}}\n-C_{\\text{resources}}\n-R_{\\text{interaction}}\n\\]\n\n其中：\n\n- \\(B_{\\text{specialization}}\\)：专业互补带来的收益；\n- \\(B_{\\text{parallelism}}\\)：并行执行带来的收益；\n- \\(B_{\\text{verification}}\\)：独立审查带来的收益；\n- \\(C_{\\text{coordination}}\\)：协调、通信和交接成本；\n- \\(C_{\\text{resources}}\\)：新增模型调用、计算和外部服务成本；\n- \\(R_{\\text{interaction}}\\)：协作产生的冲突、错误传播和副作用风险。\n\n这不是精确的数学定律，而是一个决策框架。\n\n对于简单任务，一个专家通常就足够。对于需要多个专业领域、可以并行处理且结果需要独立审查的任务，多专家团队可能具有明显优势。\n\n**默认从最小团队开始，只在有证据表明需要时增加专家。**\n\n---\n\n# 二、总体架构：在任务编排之上增加团队协调层\n\n建议建立 `MEODT Orchestration Layer`，作为多专家团队的统一协调层。\n\n它不取代 Planner、DAG、ReAct 或领域专家，而是负责决定哪些专家参与任务、各自负责什么、如何交换信息，以及如何汇总和验收团队结果。\n\n### 用户目标与统一任务入口\n\n由 Router 识别领域，由 GVAAG 判断目标价值、授权和团队组建的必要性。\n\n### MEODT 团队协调器\n\n决定团队拓扑、专家角色、任务所有权、交接规则、共享信息与协作预算。\n\n### 专家 A\n\n领域知识、工具和专属策略。\n\n### 专家 B\n\n独立子任务与领域产物。\n\n### 专家 C\n\n补充专业能力或独立审查。\n\n### 协调与集成\n\n处理交接、依赖、冲突与结果汇总。\n\n通过任务契约、共享产物和结构化事件协作\n\n### 团队级质量验收与状态管理\n\nUQEAG 验收整体结果，LTAR 管理任务生命周期，SOCDEA 处理团队级失败诊断。\n\n## 2.1 协调器不等于一个必须存在的“总指挥模型”\n\nMEODT 的协调器可以由不同实现组成：\n\n- 一个规则与状态机驱动的协调服务；\n- 一个负责复杂任务分解的协调智能体；\n- 一个基于 DAG 的确定性编排器；\n- 或者由上述几种机制组合而成。\n\n简单任务可以完全使用确定性编排，不需要额外调用协调模型。\n\n复杂任务则可以由协调智能体提出方案，但最终的任务依赖、授权、预算和状态变更仍然需要由可验证的控制逻辑执行。\n\n这能够避免团队中出现一个新的万能智能体，导致所有决策再次集中到一个难以审计的模型里。\n\n---\n\n# 三、团队拓扑：不是所有协作都使用同一种模式\n\nMEODT 首先需要解决一个选择问题：不同类型的任务，应该采用什么样的专家协作结构？\n\n建议支持六种团队拓扑，并由协调器根据任务结构、依赖关系、风险和资源条件选择。\n\n## 3.1 六种协作模式\n\n### 模式 A：单专家执行\n\n领域专家\n\n交付结果\n\n适合目标明确、专业范围单一、没有明显并行或独立审查收益的任务。应作为默认模式。\n\n---\n\n### 模式 B：顺序交接\n\n专家 A：分析\n\n专家 B：实施\n\n专家 C：验收\n\n适合输出具有明确依赖关系的任务，例如分析需求、生成代码、独立测试。\n\n---\n\n### 模式 C：并行分工\n\n协调器：分派任务\n\n专家 A\n\n专家 B\n\n专家 C\n\n汇总与验收\n\n适合互相独立的子任务，例如并行研究多个技术方案或分别分析不同模块。\n\n---\n\n### 模式 D：主管—执行者\n\n主管智能体\n\n多个专业执行者\n\n主管检查与再分配\n\n适合目标复杂、任务结构可能动态变化、需要持续协调与资源重新分配的长期工作。\n\n---\n\n### 模式 E：独立评审与对抗检查\n\n执行专家：生成结果\n\n评审专家 A\n\n评审专家 B\n\n证据汇总与裁决\n\n适合高价值或高风险任务。评审者需要尽可能独立，不能只复述执行者的结论。\n\n---\n\n### 模式 F：动态混合团队\n\n动态任务 DAG 与协调器\n\n按需加入、退出、替换专家与评审者\n\n适合漫剧生产、大型代码工程和跨领域研究等任务，可随新证据调整分工，但必须有预算与变更门槛。\n\n这些模式不是互斥的。\n\n一个 AI 漫剧任务可以采用动态混合团队：先由编剧和分镜专家顺序交接，再让视觉与配音专家并行工作，最后由合成专家整合，并由独立质量专家进行验收。\n\n## 3.2 如何选择协作模式？\n\n建议由协调器按照以下顺序判断：\n\n1. 单个专家能否在合理成本内完成任务？\n2. 是否存在真正独立的子任务？\n3. 是否存在必须由不同专业能力承担的阶段？\n4. 是否需要独立评审来降低关键错误风险？\n5. 是否有足够的资源支持并行？\n6. 多专家带来的收益是否超过协调成本？\n7. 失败时是否能够安全恢复或替换专家？\n\n如果没有明确的协作收益，就使用单专家模式。\n\n如果只是需要调用多个工具，不应该为了体现多专家架构而强行拆成多个智能体。\n\n---\n\n# 四、专家角色模型：谁负责执行，谁负责协调，谁负责验收？\n\n在团队中，领域专家和团队角色不是同一回事。\n\n例如，编程专家可以在一个任务中负责实施，在另一个任务中负责审查。协调器也可以是一个独立的轻量服务，而不是一个领域专家。\n\n建议把团队成员定义为具有明确角色的 `TeamMember`。\n\n## 4.1 建议的团队角色\n\n| 角色 | 主要职责 |\n|--------|--------|\n| `COORDINATOR` | 组织团队、分配任务、跟踪依赖和处理交接 |\n| `SPECIALIST` | 提供领域知识与专业产物 |\n| `EXECUTOR` | 在授权范围内执行具体操作 |\n| `RESEARCHER` | 搜集信息、验证来源、提出候选方案 |\n| `REVIEWER` | 独立检查产物、假设和证据 |\n| `INTEGRATOR` | 合并不同专家的输出，解决格式与接口问题 |\n| `OBSERVER` | 观察进度、成本、风险与异常，不直接修改目标产物 |\n\n这些角色可以由不同的智能体实例承担，也可以由一个专家在不同阶段切换角色。\n\n但对高风险任务，应避免同一个执行实例同时负责实施、独立评审和最终批准，以降低自我验证的偏差。\n\n## 4.2 团队成员需要明确责任边界\n\n建议每个成员都具有：\n\n- `member_id`：团队内唯一标识；\n- `expert_id`：所属专家；\n- `role`：当前团队角色；\n- `owned_tasks`：负责的任务；\n- `input_contract`：接收信息的格式；\n- `output_contract`：交付产物的格式；\n- `allowed_resources`：允许访问的资源；\n- `budget_quota`：资源配额；\n- `completion_criteria`：完成条件；\n- `failure_policy`：失败时的处理策略；\n- `reporting_policy`：需要汇报哪些事件。\n\n这使得协调器可以准确判断某个成员是否完成任务，以及其结果能否进入下一个节点。\n\n## 4.3 责任不能因为多人协作而消失\n\n多专家系统容易出现一个问题：每个专家都完成了自己的局部任务，但整个项目没有人对最终结果负责。\n\n建议采用明确的责任模型：\n\n- 每个子任务有唯一的责任主体；\n- 每个共享产物有明确的所有者；\n- 每个团队有唯一的整体协调责任主体；\n- 最终交付必须经过 UQEAG 的团队级验收；\n- 涉及用户授权或重大副作用的操作，仍由独立治理规则决定是否需要用户批准。\n\n整体责任主体负责保证协作闭环，但不能代替实际的质量验收。\n\n---\n\n# 五、与 Planner、DAG、ReAct 的关系：不能把架构混成一团\n\n这是多专家架构必须明确的边界。\n\n| 组件 | 回答的问题 |\n|--------|--------|\n| GVAAG | 这项任务是否值得做？是否获得授权？ |\n| Router | 哪个专家或处理路径最适合？ |\n| MEODT | 是否需要多个专家？团队如何分工与协作？ |\n| Planner | 应该采取什么计划？ |\n| DAG | 任务之间有哪些依赖、并行和汇合关系？ |\n| ReAct | 当前执行步骤如何根据观察结果动态调整？ |\n| TERSO | 工具如何被安全、可靠地执行？ |\n| UQEAG | 任务产物是否达到验收标准？ |\n| LTAR | 任务状态如何持久化、暂停、恢复和终止？ |\n\n这里有一条重要原则：\n\n**团队协作不替代 DAG，DAG 也不替代团队协调。**\n\nDAG 描述任务节点及依赖；MEODT 管理专家如何承担这些节点、如何通信、何时交接，以及发生冲突时由谁处理。\n\n例如，一个 DAG 节点可以分配给编程专家执行，而另一个节点分配给审查专家验证。两个专家的交接和责任由 MEODT 管理，节点之间的执行依赖由 DAG 管理。\n\n对于动态任务，协调器可以请求修改 DAG，但必须经过明确的计划变更、预算检查和授权检查，不能直接在执行过程中任意增加任务。\n\n---\n\n# 六、团队协作协议：专家之间应该交换什么信息？\n\n这是决定多专家系统是否稳定的关键。\n\n如果专家之间只传递自然语言对话，系统会很难确定某个结论究竟是事实、假设、建议，还是已经验证的结果。\n\n例如，编程专家说：\n\n“这个重构方案应该没有问题。”\n\n对于后续专家来说，这句话缺少关键信息：它基于什么代码版本？运行过哪些测试？哪些行为尚未验证？是否存在已知风险？\n\n因此，建议建立统一的 `TeamMessageProtocol` 和 `WorkPackageContract`。\n\n## 6.1 任务交接不能只传递一段提示词\n\n每个子任务应通过结构化工作包进行交接。\n\n| 字段 | 作用 |\n|--------|--------|\n| `work_package_id` | 工作包唯一标识 |\n| `team_id` | 所属团队 |\n| `task_id` | 关联的主任务 |\n| `goal_ref` | 上级目标与验收契约 |\n| `assigned_member` | 当前责任成员 |\n| `input_artifacts` | 输入产物及版本 |\n| `required_outputs` | 必须交付的结果 |\n| `constraints` | 范围、预算、时间和禁止事项 |\n| `dependencies` | 前置工作与依赖 |\n| `completion_criteria` | 明确的完成条件 |\n| `evidence_requirements` | 必须提供的证据 |\n| `handoff_status` | 当前交接状态 |\n\n这样，下游专家不需要重新阅读全部历史对话，就能知道自己接收的工作是什么。\n\n## 6.2 统一团队消息类型\n\n建议至少定义以下消息类型：\n\n- `TASK_ASSIGNMENT`：分派任务；\n- `STATUS_UPDATE`：汇报进度；\n- `ARTIFACT_READY`：通知产物已经生成；\n- `HANDOFF_REQUEST`：请求交接；\n- `BLOCKER_REPORTED`：报告阻塞；\n- `EVIDENCE_SUBMITTED`：提交验证证据；\n- `CONFLICT_RAISED`：提出结论或产物冲突；\n- `REPLAN_REQUEST`：请求重新规划；\n- `BUDGET_WARNING`：资源消耗达到预警阈值；\n- `TASK_COMPLETED`：报告子任务完成；\n- `TASK_FAILED`：报告任务失败。\n\n消息应有唯一标识、来源、目标、关联任务、时间和版本信息。\n\n重要的状态变更必须持久化，不能只存在于某个模型的临时对话上下文中。\n\n## 6.3 消息与产物分离\n\n专家可以在消息中说明某个结果已经生成，但实际产物应保存在可引用、可版本化的存储中。\n\n例如，消息可以引用：\n\n- 代码差异；\n- 研究报告；\n- 分镜清单；\n- 视频文件；\n- 测试报告；\n- 验收证据。\n\n消息负责通知和解释，产物负责保存实际内容。\n\n这样可以减少重复传输大型文件，也能避免多个专家各自持有内容略有不同的副本。\n\n---\n\n# 七、共享上下文：团队应该共享多少信息？\n\n多专家协作并不意味着所有专家共享完整对话、全部记忆和全部工具输出。\n\n共享太少，会导致专家缺少必要背景；共享太多，则会增加成本、信息噪声、隐私暴露和上下文冲突。\n\n建议将团队上下文分成四层。\n\n### T0 · 团队公共上下文\n\n主目标、任务约束、验收契约、团队分工、当前版本、共同决策和关键风险。\n\n---\n\n### T1 · 任务相关上下文\n\n某个工作包的输入、必要历史、依赖产物、相关证据和局部决策。\n\n---\n\n### T2 · 专家私有上下文\n\n专家自己的领域推理、专属记忆、内部策略与不需要向团队传播的细节。\n\n---\n\n### T3 · 证据与产物存储\n\n完整日志、文件、测试报告、引用来源、版本化产物和必要的审计记录，按需检索。\n\n## 7.1 公共上下文只保留对协作有用的信息\n\n团队公共上下文不应该成为所有专家输出的拼接集合。\n\n它应优先包含：\n\n- 当前有效的目标和约束；\n- 每个成员的职责；\n- 已经确认的关键事实；\n- 已经批准的方案；\n- 尚未解决的冲突；\n- 关键产物的版本；\n- 当前风险和资源状态。\n\n冗长的推理过程、重复的工具日志和与当前任务无关的记忆，应保存在相应的私有上下文或证据存储中。\n\n## 7.2 上下文压缩必须保留协作关键状态\n\n如果 ACMO 对团队上下文进行压缩，必须保留：\n\n- 未完成工作；\n- 关键决策及其依据；\n- 产物版本；\n- 依赖关系；\n- 未解决的分歧；\n- 用户的有效约束；\n- 当前授权状态；\n- 预算与截止条件。\n\n不能只保留一段自然语言摘要，然后丢失哪些结论已经验证、哪些只是猜测。\n\n## 7.3 共享上下文不能自动扩大权限\n\n专家能够看到某个文件，不代表它有权修改该文件。\n\n专家收到其他成员的工具调用记录，也不代表它获得了执行相同操作的授权。\n\n因此，团队上下文和能力资产必须与独立的权限检查机制分离。\n\n---\n\n# 八、产物所有权与并发冲突：谁可以修改什么？\n\n这是多专家并行执行时非常容易出现的问题。\n\n例如，两个专家同时修改同一个代码模块；或者一个专家正在更新分镜，另一个专家仍然依据旧分镜生成素材。\n\n如果没有明确的产物所有权与版本协议，团队可能产生相互覆盖、重复工作和难以追溯的结果。\n\n建议建立 `ArtifactOwnershipPolicy`。\n\n## 8.1 默认采用单一写入者\n\n对于同一份共享产物，建议默认只有一个责任主体能够提交正式修改。\n\n其他专家可以：\n\n- 读取当前版本；\n- 提交修改建议；\n- 生成独立分支；\n- 在隔离环境中进行候选修改。\n\n但正式合并应经过明确的版本检查与集成流程。\n\n例如，两个代码专家可以分别生成不同的补丁，但不能无协调地同时覆盖同一份工作目录。\n\n## 8.2 使用版本校验防止陈旧输入\n\n每个工作包都应声明输入产物的版本。\n\n如果下游专家开始工作后，上游产物已经更新，系统应判断：\n\n- 新版本是否与原版本兼容；\n- 当前工作是否依赖已经变化的内容；\n- 是否需要重新运行相关步骤；\n- 原有输出是否仍然有效。\n\n不能简单地把最新产物覆盖到所有专家的输入中，却不检查依赖关系。\n\n## 8.3 集成专家不能替代质量验收\n\n集成专家负责合并产物、解决格式与接口冲突，并形成候选的最终结果。\n\n但它不应因为成功合并所有文件，就直接宣称整体任务合格。\n\n最终产物仍然需要经过 UQEAG 的团队级验收；高风险或关键任务还可以增加独立审查。\n\n---\n\n# 九、专家冲突：多个专家给出不同结论时怎么办？\n\n多专家协作不能假定所有专家都会达成一致。\n\n它们可能因为知识不同、输入版本不同、目标权重不同，或者评测方法不同而产生分歧。\n\n例如：\n\n- 架构专家建议拆分服务，成本专家认为当前项目不值得增加服务；\n- 编程专家认为代码修改完成，审查专家发现回归风险；\n- 视觉专家建议重新生成角色素材，视频工程专家认为可以通过后期处理解决；\n- 两个研究专家引用了不同时间的资料，得出相互矛盾的结论。\n\n如果系统仅采用多数投票，可能会选择一个错误的方案；如果总是听从主管智能体，也可能放大主管本身的判断偏差。\n\n建议建立 `ConflictResolutionEngine`。\n\n## 9.1 首先区分四种冲突\n\n| 冲突类型 | 示例 | 处理方法 |\n|--------|--------|--------|\n| 事实冲突 | 两个专家对同一事实给出不同结论 | 核对来源、时间和证据 |\n| 方案冲突 | 两种实现路径都可行 | 比较成本、风险、收益与约束 |\n| 产物冲突 | 两个专家修改了同一文件或数据 | 依据所有权、版本和集成规则解决 |\n| 目标冲突 | 某个专家的方案违反用户的原始约束 | 回到有效目标与授权，不以投票覆盖 |\n\n这四类冲突不能采用同一种解决方式。\n\n## 9.2 建议的冲突处理流程\n\n## 9.3 不要让多数投票替代证据\n\n三个专家重复同一个来源，并不等于有三份独立证据。\n\n同一个基础模型在三个不同角色提示下给出相同答案，也不意味着得到了真正独立的验证。\n\n对于事实性或高风险结论，应优先检查证据来源和验证方式的独立性，而不是简单统计专家数量。\n\n对于方案选择，则可以综合比较各自的预期收益、成本、风险和适用条件。\n\n## 9.4 重大冲突应允许升级到用户\n\n当存在多个合理方案，但它们在成本、产品方向或用户偏好上有实质性差异时，系统应通过 HACCG 向用户展示关键差异，而不是无限组织专家讨论。\n\n如果冲突涉及强制安全约束，协调器也不能通过团队投票改变规则。\n\n**专家可以对方案提出异议，但不能通过协商创造新的权限。**\n\n---\n\n# 十、动态组队：什么时候增加、替换或移除专家？\n\n静态团队容易理解，但复杂任务可能在执行过程中不断出现新问题。\n\n例如，编程专家最初判断只是局部代码修改，后来发现问题来自数据库事务设计，需要架构专家加入；又或者某个外部模型服务不可用，需要替换相关执行专家。\n\n因此，MEODT 需要支持动态组队，但必须避免团队规模不断膨胀。\n\n建议建立 `TeamReconfigurationPolicy`。\n\n## 10.1 允许动态调整的触发条件\n\n- 发现现有团队缺少必要的专业能力；\n- 某个专家反复无法完成任务；\n- 任务目标发生实质性变化；\n- 新证据改变了任务分解方式；\n- 当前团队资源不足；\n- 某个阶段需要独立审查；\n- 某个专家不再有未完成工作；\n- 继续保留某个成员的协调成本已经超过其预期收益。\n\n## 10.2 增加专家前必须回答三个问题\n\n1. 新专家是否拥有当前团队缺少的能力？\n2. 它是否能够利用已有产物和契约，而不需要重复整个任务？\n3. 增加它是否会产生足够的预期收益，抵消上下文、通信和执行成本？\n\n如果新专家只是重复现有专家已经完成的工作，而且没有独立验证或替代价值，就不应该加入。\n\n## 10.3 专家退出不能丢失责任\n\n当一个成员退出团队时，必须处理：\n\n- 未完成的工作包；\n- 尚未提交的产物；\n- 正在运行的工具；\n- 已占用的资源；\n- 需要交接的决策与证据；\n- 其他成员对它的依赖。\n\n协调器应将任务重新分配、保留为待办，或者明确终止，而不是直接删除成员记录。\n\n## 10.4 动态组队必须受预算约束\n\n建议为每个团队设置：\n\n- 最大并发成员数；\n- 最大模型调用量；\n- 总预算上限；\n- 每个成员的资源配额；\n- 最大重规划次数；\n- 最大冲突处理轮数；\n- 最大返工次数。\n\n具体数值应根据任务类型和设备能力配置，而不是在全局硬编码一个适用于所有场景的数字。\n\n对于个人电脑或微型 Linux 主机，还应考虑内存、GPU、并发模型调用和后台任务对前台交互的影响。\n\n---\n\n# 十一、专家失败与团队恢复：一个成员失败，不应该让整个任务失去进度\n\n多专家系统必须能够处理局部失败。\n\n例如，漫剧制作中的配音专家暂时无法访问外部服务，但分镜、视觉素材和故事脚本都已完成。如果整个任务因此重新开始，就会浪费大量资源。\n\n建议建立 `TeamRecoveryManager`，与 LTAR、TERSO、SOCDEA 和 UQEAG 协作。\n\n## 11.1 将失败分为五类\n\n| 失败类型 | 典型情况 | 默认处理 |\n|--------|--------|--------|\n| 成员执行失败 | 某专家输出格式错误 | 修复或有限重试 |\n| 能力不可用 | 所需工具或模型不可用 | 使用兼容替代能力或等待 |\n| 交接失败 | 输入产物缺失、版本不匹配 | 重新核验契约和依赖 |\n| 协作失败 | 冲突无法解决、责任不明确 | 暂停相关节点，升级协调 |\n| 团队级失败 | 关键目标无法达成、预算耗尽 | 诊断、调整范围、请求用户决策或终止 |\n\n这些失败需要不同的恢复策略，不能全部交给一个无限重试循环。\n\n## 11.2 从检查点恢复，而不是从头重做\n\n团队需要保存：\n\n- 已完成工作包；\n- 当前产物版本；\n- 已验证的证据；\n- 未完成的依赖；\n- 当前团队成员与角色；\n- 资源消耗；\n- 尚未解决的冲突；\n- 当前有效的目标、授权和预算。\n\n恢复时，协调器应判断哪些节点仍然有效，哪些需要重新执行。\n\n如果只是在替换配音专家，而脚本和画面素材没有变化，就不应该无条件重新生成所有视觉素材。\n\n如果上游分镜发生变化，则依赖它的素材生成和合成步骤可能需要重新执行。\n\n## 11.3 替代专家必须满足契约兼容\n\n不能仅因为两个专家都属于“编程专家”就认为它们可以互换。\n\n替代成员需要满足：\n\n- 工作包输入输出契约；\n- 必要的专业能力；\n- 所需工具和权限；\n- 当前运行环境；\n- 质量验收要求；\n- 剩余预算与时间约束。\n\n如果替代专家的输出格式不同，需要通过经过验证的适配器进行转换，而不是直接将其结果交给下游。\n\n## 11.4 局部恢复不能绕过最终验收\n\n即使所有失败节点都已经重新运行，最终结果仍可能不合格。\n\n因此，团队恢复完成后，应根据受影响的产物和依赖关系执行必要的回归验证，并由 UQEAG 决定是否通过。\n\n---\n\n# 十二、团队级质量评测：评价协作结果，而不是成员数量\n\n多专家系统最容易出现的错误之一，是把“所有成员都完成任务”当成“团队完成任务”。\n\n实际上，团队可能发生：\n\n- 子任务之间不兼容；\n- 关键要求无人负责；\n- 多个成员重复工作；\n- 产物整合失败；\n- 冲突被隐藏；\n- 最终结果缺少必要证据。\n\n因此，建议建立 `TeamEvaluationProfile`。\n\n## 12.1 团队质量的六个维度\n\n| 维度 | 评估内容 |\n|--------|--------|\n| 目标完成度 | 整体交付是否满足主任务要求 |\n| 协作正确性 | 工作包、依赖、交接和产物版本是否正确 |\n| 专业质量 | 各领域产物是否达到相应的验收标准 |\n| 协作效率 | 相比单专家基线，是否减少时间或提高质量 |\n| 资源效率 | 新增协调和并行执行的成本是否合理 |\n| 故障恢复能力 | 成员失败、工具异常和任务变更后能否恢复 |\n\n其中，最终交付质量仍由 UQEAG 的验收契约决定。团队评测不能取代最终验收，也不能通过多个成员的平均分掩盖某个关键子任务的严重缺陷。\n\n## 12.2 团队评测应当与单专家基线比较\n\n对于适合比较的任务，建议在评测集上对照：\n\n- 单专家执行；\n- 多专家顺序交接；\n- 多专家并行执行；\n- 多专家加独立评审。\n\n比较质量、延迟、成本、失败率和恢复表现。\n\n如果多专家模式并没有稳定的质量或效率优势，就应考虑简化团队拓扑。\n\n## 12.3 评测团队协作是否真正减少了错误\n\n不能只统计专家数量、通信次数和子任务完成率。\n\n更重要的是：\n\n- 是否发现了单专家容易遗漏的问题；\n- 是否减少了重复劳动；\n- 是否降低了接口错误；\n- 是否缩短了关键路径；\n- 是否提升了最终产物质量；\n- 是否增加了新的错误传播路径。\n\n团队协作的价值应通过结果证明，而不是通过系统结构的复杂程度证明。\n\n---\n\n# 十三、与现有架构的集成关系\n\nMEODT 必须与前面设计的系统模块形成稳定的职责边界。\n\n| 模块 | 协作关系 |\n|--------|--------|\n| Router | 选择领域专家或初始处理路径 |\n| GVAAG | 决定目标是否值得执行，以及组队的预期价值 |\n| CEKCE / CIL | 提供可复用的专家能力、技能和工作流 |\n| Planner / DAG | 规划子任务、依赖关系和执行顺序 |\n| ReAct | 处理成员内部的动态执行与观察 |\n| TERSO | 执行工具调用和控制副作用 |\n| MTSRIC / ARCBG | 管理团队并发、资源配额和总预算 |\n| ACMO / MEEG / CLEK | 提供上下文、记忆与知识检索 |\n| UQEAG | 验收团队产物和整体交付结果 |\n| LTAR | 持久化团队任务、检查点、暂停与恢复状态 |\n| SOCDEA | 诊断协作失败、交接错误和无效重复工作 |\n| HACCG | 处理用户确认、目标变更、暂停、取消和人工接管 |\n| CGVCM | 管理团队协议、契约和依赖版本 |\n| SELCIA | 管理经过验证的团队策略改进及受控发布 |\n\n需要特别明确：\n\n**MEODT 负责组织专家协作，不负责自行决定所有专家的目标、权限、资源和验收标准。**\n\n这些职责仍由相应的治理模块承担。\n\n---\n\n# 十四、建议冻结的架构决策\n\n以下是建议纳入 EvoAgent 全量架构的 MEODT 治理基线。\n\n这些是建议纳入 EvoAgent 全量架构的多专家协作治理基线。正式实施时，还需要定义 `TeamRecord`、`TeamMember`、`WorkPackageContract`、`TeamMessageProtocol`、`ArtifactOwnershipPolicy`、`ConflictResolutionRecord` 和 `TeamRecoveryManager` 等接口与状态机。\n\n# 十五、第一版怎么落地？\n\n不建议一开始就实现可以无限增加专家、自由讨论和动态改写团队结构的系统。\n\n更合理的路线是先把协作契约和执行闭环跑通。\n\n第一版的核心验收标准应是：两个专家可以在明确契约下完成一次真实的交接；失败后可以恢复；最终产物能够独立验收；所有关键状态都能追踪。\n\n只要这条闭环稳定运行，动态组队和更复杂的团队优化才有可靠的基础。\n\n---\n\n# 十六、下一专项：全局事件总线、运行可观测性与因果追踪\n\n多专家协作解决了多个专家如何共同完成任务的问题，但也让系统的运行链路变得更加复杂。\n\n当一个任务涉及 Router、多个专家、DAG、工具、记忆、质量验收和进化控制器时，如果最终结果失败，系统必须能够回答：\n\n- 用户的原始请求是什么？\n- 为什么选择了这个专家和这条执行路径？\n- 哪些决策改变了任务方向？\n- 哪个专家产生了问题，问题又如何传播到其他节点？\n- 哪些工具实际执行了操作？\n- 任务为什么暂停、恢复或重新规划？\n- 哪个版本的能力、模型和配置参与了执行？\n- 这次失败究竟来自执行、协作、评测还是治理？\n- 手机与主机断联期间发生了什么，恢复连接后如何还原完整过程？\n\n如果没有统一的事件与追踪体系，SOCDEA 很难进行可靠的根因诊断，UQEAG 也难以判断验收证据是否可信，CEKCE 更无法准确判断一项能力是否真的进步。\n\n因此，下一专项建议定义为：\n\n**Global Event &amp; Causal Observability，简称 GECO。**\n\n重点研究：\n\n1. 如何建立跨模块统一事件模型与事件总线；\n2. 如何关联用户请求、目标、任务、DAG 节点、专家、工具和产物；\n3. 如何区分事件、状态、日志、指标、追踪与因果关系；\n4. 如何重建一次任务的完整执行时间线；\n5. 如何在多专家并行、重试和跨设备执行中保持事件关联；\n6. 如何在断网、崩溃和重复消息情况下保证事件可靠记录；\n7. 如何利用事件数据支持 SOCDEA 的根因分析；\n8. 如何向 UQEAG 提供可追溯的验收证据；\n9. 如何评估 Router、专家、工作流和技能的真实运行表现；\n10. 如何在个人电脑或微型 Linux 主机的有限资源下控制日志存储和追踪开销；\n11. 如何管理日志脱敏、敏感信息访问和审计权限；\n12. 如何利用历史事件回放复现故障，而不重复执行真实外部副作用。\n\n本专项的核心原则是：\n\n**系统不仅要知道最终发生了什么，还要能够重建关键决策、实际执行、状态变化与结果之间的关系，并明确哪些因果结论已经得到验证、哪些仍然只是推测。**\n\n这将为 EvoAgent 的任务恢复、质量评测、根因诊断、能力进化和多专家协作建立统一的运行事实基础。","fallbackMarkdownVersion":1,"appData":{"opGenui":{"componentResults":{},"interactionSurface":"mainline","modelDataBindings":{}}}},"view_state":{},"model_slug":"gpt-6-thinking","turn_exchange_id":"4423ad7c-f566-4a42-9aa3-5b6fc1c09647","request_id":"cb3e6df6-6e5f-40d6-b532-36f86775f0ab","message_type":"next","finish_details":{"type":"stop","stop_tokens":[200002]},"is_complete":true,"citations":[],"content_references":[],"gizmo_id":"g-p-6ad449077a8c8191825a8ee19d54ef7a","search_result_groups":[],"cot_version":"v5","conversation_followup_suggestions_eligible":false,"working_turn_id":"4423ad7c-f566-4a42-9aa3-5b6fc1c09647","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":true,"parent_id":"e47d15e2-97a6-4d0d-92bd-4af0b892d818","logical_answer_prefix_activity":{"visibility":"hidden"},"model_switcher_deny":[]},"recipient":"all","channel":"final"}],"safe_urls":[],"blocked_urls":[],"page_info":{"start_cursor":"bbb216ed-c4fe-4f68-9a7b-5853330d6004","end_cursor":"c5eff1fa-a7db-47f9-9d02-b526a2c2726a","has_previous_page":true,"has_next_page":true}}