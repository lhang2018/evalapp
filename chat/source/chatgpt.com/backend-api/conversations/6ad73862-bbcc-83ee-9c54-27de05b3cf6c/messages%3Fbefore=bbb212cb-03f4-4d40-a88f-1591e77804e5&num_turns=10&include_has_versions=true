-41c7-9e61-4e40e9fda4bc","working_turn_id":"9aa935cb-de07-41c7-9e61-4e40e9fda4bc","model_slug":"gpt-6-thinking","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","parent_id":"c0fc409a-bd99-4188-bae5-0ab56a747a10","summary_type":"raw_cot","reasoning_start_time":1792507608.7830307,"conversation_followup_suggestions_eligible":false,"can_save":false,"reasoning_group_id":"b9643980-0677-4cf7-8ab4-8b12b537dd63","model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"1bae5afd-4e34-4556-8619-094cc361cae1","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792507880.64143,"update_time":1792507880.648051,"content":{"content_type":"reasoning_recap","content":"思考了 4m 31s"},"status":"finished_successfully","end_turn":false,"weight":1.0,"metadata":{"reasoning_status":"reasoning_ended","finished_duration_sec":271,"reasoning_start_time":1792507608.7830307,"reasoning_end_time":1792507880.5954137,"reasoning_recap_type":"hide_all","cot_version":"v5","reasoning_group_id":"b9643980-0677-4cf7-8ab4-8b12b537dd63","conversation_followup_suggestions_eligible":false,"request_id":"ac7abb14-2826-4d40-93a4-c7ce99a57492","message_type":"next","turn_exchange_id":"9aa935cb-de07-41c7-9e61-4e40e9fda4bc","working_turn_id":"9aa935cb-de07-41c7-9e61-4e40e9fda4bc","model_slug":"gpt-6-thinking","default_model_slug":"gpt-6-thinking","thinking_effort":"extended","can_save":false,"parent_id":"9156591e-033f-4578-9b83-fa6e4412e32f","hide_inline_actions":true,"model_switcher_deny":[]},"recipient":"all","channel":null},{"id":"a6d580f4-9484-4007-b054-20d85eb9ff4d","author":{"role":"assistant","name":null,"metadata":{}},"create_time":1792507625.624971,"update_time":1792507902.532256,"content":{"content_type":"text","parts":["# EvoAgent 第四十九专项：人机协作、用户控制权与可接管性\n\n本轮继续设计 EvoAgent 的人机协作体系，重点不是增加聊天界面或通知功能，而是解决一个更深层的架构问题：\n\n**当智能体能够长期运行、自主规划、调用工具、修改项目并持续进化时，如何让用户始终保有对目标、授权、资源和关键结果的控制权，同时又不必事事亲自监督？**\n\n此前已经设计了目标价值评估与自主性治理（GVAAG）。它负责判断系统应该做什么、是否值得做、允许自主到什么程度，以及什么时候应该停止。\n\n本专项 HACCG 则负责将这些规则落实到真实的人机交互中：什么时候通知用户、什么时候需要批准、如何处理用户改变主意、如何暂停或取消任务，以及如何在发生异常时把控制权交还给用户。\n\n## 一、第一性原理：用户不应该成为系统的实时调度器\n\n传统工具需要用户一步步操作。自主智能体则应该承担更多规划、执行和恢复工作。\n\n但这不意味着用户应该失去控制权。\n\n一个好的个人智能体应当做到：\n\n- **日常操作少打扰：** 不需要用户确认每一次内部计算和低风险步骤。\n- **关键决策可理解：** 用户能够知道系统正在追求什么目标、准备做什么，以及为什么。\n- **重要操作可控制：** 涉及重大副作用、权限变化或超出原授权范围的操作时，必须执行适当的确认流程。\n- **任务状态可接管：** 用户可以暂停、取消、调整目标，或接管未完成的工作。\n- **错误发生后可恢复：** 系统能够保存状态、解释失败，并提供明确的继续、修复或放弃选项。\n\n这里最重要的区别是：\n\n**减少用户操作次数，不等于减少用户控制权；提高自主性，也不等于把更多决策隐藏起来。**\n\n---\n\n# 二、总体架构：建立独立的人机控制平面\n\n建议将 HACCG 设计成横跨所有专家、任务和设备的统一控制层，而不是分别在编程专家、旅游专家和漫剧专家中实现各自独立的确认逻辑。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">用户交互入口</title>\n    <text color=\"secondary\" size=\"sm\">Android 主界面、通知、语音、任务详情、桌面控制台，以及后续扩展的其他入口。</text>\n  </box>\n  <box align=\"center\">\n    <icon name=\"arrow-down\" size=\"lg\" color=\"secondary\"/>\n  </box>\n  <box border radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">HACCG 人机控制平面</title>\n    <text color=\"secondary\" size=\"sm\">统一处理授权确认、目标变更、暂停取消、用户接管、进度展示和交互优先级。</text>\n  </box>\n  <grid columns={2} gap={2}>\n    <grid-item>\n      <box border radius=\"lg\" padding={2} gap={1}>\n        <title size=\"sm\">授权与确认管理器</title>\n        <text color=\"secondary\" size=\"xs\">批准范围、期限、预算、撤销与过期处理。</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box border radius=\"lg\" padding={2} gap={1}>\n        <title size=\"sm\">任务控制管理器</title>\n        <text color=\"secondary\" size=\"xs\">暂停、恢复、取消、目标修改与人工接管。</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box border radius=\"lg\" padding={2} gap={1}>\n        <title size=\"sm\">进度与决策呈现器</title>\n        <text color=\"secondary\" size=\"xs\">当前状态、已完成工作、风险、剩余成本与下一步。</text>\n      </box>\n    </grid-item>\n    <grid-item>\n      <box border radius=\"lg\" padding={2} gap={1}>\n        <title size=\"sm\">交互策略引擎</title>\n        <text color=\"secondary\" size=\"xs\">判断何时静默执行、何时通知、何时必须请求确认。</text>\n      </box>\n    </grid-item>\n  </grid>\n  <box align=\"center\">\n    <icon name=\"arrow-down\" size=\"lg\" color=\"secondary\"/>\n  </box>\n  <box background=\"surface-secondary\" radius=\"lg\" padding={3} gap={1}>\n    <title size=\"md\">统一任务与安全控制接口</title>\n    <text color=\"secondary\" size=\"sm\">与 GVAAG、LTAR、TERSO、ASGTB、MTSRIC、UQEAG 和 SELCIA 协同。</text>\n  </box>\n</box>\n\n这个控制平面需要满足两个架构要求。\n\n第一，所有设备上的用户操作都应经过统一的任务控制协议，不能因为 Android 和 Linux 主机各自实现了一套控制逻辑，就出现一端显示已取消、另一端仍继续执行的情况。\n\n第二，**交互层不能直接绕过任务、安全与授权机制修改底层状态**。用户点击“取消”后，HACCG 应向任务控制器发出正式的取消请求，由 LTAR、TERSO 等模块执行相应的安全停止和状态处理。\n\n---\n\n# 三、交互策略：哪些事情需要告诉用户？\n\n这是 HACCG 的第一个关键设计。\n\n如果系统把所有内部步骤都推送给用户，用户很快就会关闭通知；如果系统只在最终失败时才告知用户，又可能让用户失去干预机会。\n\n建议建立五类交互动作。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"I0 · 静默执行\",\"低风险、可逆、已授权且处于任务范围内的操作，只记录必要的运行事件。\"],\n    [\"I1 · 状态通知\",\"任务开始、阶段完成、长时间等待或重要进展时，提供简洁的状态更新，不要求用户回复。\"],\n    [\"I2 · 建议征询\",\"存在多个合理方案，但系统可以先完成低风险调查；向用户提供选择，必要时允许继续安全的独立工作。\"],\n    [\"I3 · 必须确认\",\"即将执行超出既有授权的操作，或涉及预先规定必须人工批准的重大副作用时，暂停相关操作并等待明确批准。\"],\n    [\"I4 · 安全阻断\",\"发现越权、授权失效或违反强制安全策略时，阻止相关操作；不能通过普通的用户确认按钮绕过安全边界。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"I4 · 安全阻断\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这些是交互策略等级，不是 TERSO 的操作风险等级，也不是 GVAAG 的自主性等级。\n\n同一项操作是否需要确认，应综合判断操作风险、用户授权、任务范围和当前状态。\n\n例如，编程专家在用户指定的项目中修改一个局部文件，可以属于静默执行；但将代码推送到公共仓库，即使技术上只是一条命令，也可能需要单独确认。\n\n## 3.1 不要让每个模块各自决定是否打扰用户\n\nRouter、Planner、专家和工具运行时都可能发现需要用户参与的情况。\n\n但它们不应各自直接弹出互不协调的确认窗口。\n\n建议由统一的 `InteractionPolicyEngine` 接收各模块的交互请求，进行合并、排序和去重。\n\n例如，某个代码任务连续发现三个问题：\n\n- 测试覆盖不足；\n- 项目依赖较旧；\n- 一个无关模块存在潜在技术债。\n\n系统可以把这些问题合并为一条有重点的进度更新，而不是连续发送三条通知。\n\n但如果其中一项操作确实需要在执行前获得批准，就不能因为合并通知而将它隐藏在普通的进度消息里。\n\n## 3.2 打扰策略不能覆盖必须确认的要求\n\n系统可以根据用户偏好减少普通通知、合并进度消息、降低低价值提醒频率。\n\n但它不能因为用户开启了“免打扰”，就自动批准本来需要人工批准的操作。\n\n免打扰影响的是通知方式和时机，而不是授权规则本身。\n\n---\n\n# 四、授权与确认：用户究竟批准了什么？\n\n这是整个人机控制体系中最需要精确设计的部分。\n\n假设系统向用户询问：\n\n“是否允许我继续？”\n\n这个问题本身就不合格，因为用户不知道“继续”具体意味着什么。\n\n系统可能只是继续运行测试，也可能准备修改文件、安装依赖、上传代码或部署服务。不同操作的影响完全不同。\n\n因此，建议建立独立的 `ApprovalRecord` 和 `AuthorizationScope`，将确认请求与实际授权范围分离管理。\n\n## 4.1 每次重要确认都要说明六件事\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"要做什么\",\"明确描述具体操作，不使用含糊的“继续”“优化一下”代替。\"],\n    [\"为什么做\",\"说明当前目标、问题证据和预期收益。\"],\n    [\"影响什么\",\"列出涉及的文件、项目、设备、外部服务或其他资源。\"],\n    [\"有什么风险\",\"说明可能的副作用、可逆性和失败后的恢复方式。\"],\n    [\"批准到什么程度\",\"明确单次操作、指定任务范围或有限期限内的授权。\"],\n    [\"不批准会怎样\",\"说明系统将暂停、采用安全替代方案，还是保留任务等待用户决定。\"]\n  ] as item}\n    <box gap={1}>\n      <title size=\"md\">{item[0]}</title>\n      <text color=\"secondary\" size=\"sm\">{item[1]}</text>\n    </box>\n    {#if item[0]!==\"不批准会怎样\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n确认界面不需要展示所有底层技术细节，但必须让用户理解决策的实际含义。\n\n## 4.2 授权应当具有明确边界\n\n建议一个授权记录至少包含：\n\n| 字段 | 作用 |\n|---|---|\n| `approval_id` | 确认记录标识 |\n| `subject` | 获得授权的智能体或任务 |\n| `action_scope` | 允许执行的操作类型 |\n| `resource_scope` | 允许访问或修改的资源范围 |\n| `task_scope` | 授权适用的目标和任务 |\n| `budget_limit` | 允许使用的预算上限 |\n| `valid_from` / `expires_at` | 授权生效和过期时间 |\n| `conditions` | 执行前必须满足的条件 |\n| `revocation_policy` | 如何撤销授权 |\n| `approval_evidence` | 用户批准的记录与范围摘要 |\n| `status` | 待批准、有效、已撤销、已过期或已使用等状态 |\n\n并不是所有授权都需要限制到一个单独的工具调用。\n\n用户可以提前批准某个项目在指定范围内运行测试、修复测试失败并执行回归验证。\n\n但这个授权不能自动扩展到其他项目、上传私人代码、部署到生产环境或修改全局安全策略。\n\n## 4.3 一次确认不等于永久授权\n\n建议区分三种授权模式：\n\n- **单次授权：** 只允许指定的一次操作。\n- **任务级授权：** 允许在某个目标和明确范围内执行一组操作。\n- **持续授权：** 在限定的任务类别、资源、预算与期限内允许反复执行。\n\n持续授权必须能够被检查、过期和撤销。\n\n如果任务目标、资源范围或风险发生实质性变化，系统需要重新判断原授权是否仍然适用，而不是简单地沿用以前的批准。\n\n## 4.4 确认不能成为绕过安全边界的万能按钮\n\n必须区分两种情况：\n\n- 用户有权决定的事项，例如项目修改方案、预算偏好和可选功能；\n- 受强制安全规则、访问权限或其他约束限制的事项。\n\n前者可以通过授权或确认处理；后者不能仅凭用户点击“我同意”就自动放行。\n\n同样，系统也不能通过拆分操作规避确认。例如，一次性上传整个项目需要确认，就不能把上传拆成一百个小文件后当作无需确认的普通操作。\n\n**确认的依据应当是实际影响与授权范围，而不是单条命令看起来有多简单。**\n\n---\n\n# 五、任务控制协议：暂停、恢复、取消和接管必须有明确语义\n\n在长期任务中，“停止”不是一个简单的布尔值。\n\n如果系统正在编译代码、生成视频、写入文件或调用远程 API，用户按下暂停或取消后，系统需要知道当前操作是否能够立即中断，以及已经发生的副作用如何处理。\n\n建议建立统一的 `TaskControlProtocol`。\n\n## 5.1 定义五种控制操作\n\n| 操作 | 含义 |\n|---|---|\n| `PAUSE` | 请求任务进入安全暂停状态，保留可恢复的进度 |\n| `RESUME` | 在重新检查状态、依赖与授权后继续任务 |\n| `CANCEL` | 请求终止任务，不再启动新的普通工作步骤 |\n| `CHANGE_GOAL` | 修改目标、范围或约束，触发影响分析与必要的重新规划 |\n| `TAKEOVER` | 将后续关键决策或具体操作交给用户，或切换到人工控制模式 |\n\n这些操作不能只改变 UI 上的任务状态。\n\n它们必须与 LTAR 的生命周期状态、DAG 执行器、TERSO 工具运行时以及必要的安全检查协同工作。\n\n## 5.2 暂停与取消的区别\n\n**暂停**意味着系统预计稍后继续。\n\n因此，暂停时需要：\n\n- 停止启动新的非必要步骤；\n- 处理中断请求与正在运行的子任务；\n- 保存可靠的检查点；\n- 记录未完成节点和外部操作状态；\n- 释放不再需要的资源；\n- 保留恢复所需的状态与依赖信息。\n\n**取消**意味着不再继续当前任务的正常执行路径。\n\n但取消不等于自动撤销已经发生的事情。\n\n例如：\n\n- 已修改的本地文件可能需要保留为未提交变更；\n- 已经发送的外部请求可能无法撤回；\n- 正在进行的远程任务可能只能请求取消，不能保证即时终止；\n- 已产生的费用不能仅凭取消任务而自动退回。\n\n因此，取消操作需要返回实际处理结果，而不是一律显示“已撤销全部操作”。\n\n## 5.3 建立正式的控制状态机\n\n<box border radius=\"xl\" padding={3} gap={2}>\n  {#each [\n    [\"RUNNING\",\"任务正在执行\"],\n    [\"PAUSE_REQUESTED\",\"暂停请求已接收，正在安全停止可中断操作\"],\n    [\"PAUSED\",\"已进入可恢复的暂停状态\"],\n    [\"CANCEL_REQUESTED\",\"取消请求已接收，正在处理在途操作\"],\n    [\"CANCELLED\",\"任务已终止，剩余副作用已核验或明确标记\"],\n    [\"RESUME_CHECK\",\"正在检查检查点、依赖、版本与授权\"],\n    [\"NEEDS_USER\",\"等待用户确认、补充信息或接管\"],\n    [\"COMPLETED\",\"任务已完成并达到规定的终态条件\"]\n  ] as item}\n    <row align=\"start\" gap={3}>\n      <box background=\"surface-secondary\" radius=\"md\" padding={2} minWidth=\"148px\">\n        <text size=\"xs\" weight=\"medium\">{item[0]}</text>\n      </box>\n      <box flex=\"1\">\n        <text size=\"sm\">{item[1]}</text>\n      </box>\n    </row>\n    {#if item[0]!==\"COMPLETED\"}\n      <divider color=\"subtle\"/>\n    {/if}\n  {/each}\n</box>\n\n这是一组建议的控制状态，而不是任务生命周期全部状态的替代品。执行失败、验收失败、等待外部依赖等情况，仍然需要由 LTAR 的完整状态机管理。\n\n还要注意，`PAUSE_REQUESTED` 和 `CANCEL_REQUESTED` 都不是最终状态。系统必须等待执行器报告实际停止情况，并核验关键副作用。\n\n## 5.4 控制请求需要幂等与顺序规则\n\n手机可能重复发送取消请求，设备也可能在网络断开后重传命令。\n\n因此，控制协议需要支持：\n\n- 唯一的 `control_request_id`；\n- 重复请求去重；\n- 任务版本或状态版本校验；\n- 控制命令的确认回执；\n- 过期命令拒绝执行；\n- 冲突请求的明确处理规则。\n\n例如，用户先点击暂停，随后又点击取消。系统应依据明确的状态转换规则处理，不应该因为消息到达顺序不同而意外恢复任务。\n\n---\n\n# 六、用户中途改变要求：不能简单地覆盖原始目标\n\n真实工作中，用户经常在任务执行期间改变主意。\n\n例如：\n\n- “先不用追求最高质量，控制一下成本。”\n- “不要改这个模块了，换一种实现方式。”\n- “原计划是生成一分钟的视频，现在缩短到三十秒。”\n- “暂停当前优化，我想先看一下已经完成的部分。”\n- “这个项目的代码不能上传到任何云服务。”\n\n这些变化对任务的影响并不相同。有些只改变偏好，有些需要重新规划，有些则必须立即阻止相关操作。\n\n建议建立 `GoalChangeManager`，负责解析变更、计算影响，并协调目标版本、任务计划、授权和验收契约。\n\n## 6.1 每次实质性变更都应生成新版本\n\n不建议直接覆盖原始目标。\n\n例如：\n\n- `goal_version = 1`：原始目标；\n- `goal_version = 2`：用户修改后的目标；\n- `plan_version = 3`：根据新目标重新生成的计划；\n- `contract_version = 2`：更新后的验收契约。\n\n这些版本不必同步递增，但应保留各自的变更记录及依赖关系。\n\n这样系统才能回答：原本计划做什么、用户何时修改了要求、哪些步骤已经完成、哪些步骤因新目标而失效。\n\n## 6.2 按变更影响决定如何处理\n\n建议将目标变更分为四类。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box gap={1}>\n    <title size=\"md\">C1 · 偏好调整</title>\n    <text color=\"secondary\" size=\"sm\">例如提高可读性优先级、减少普通通知。若不影响当前执行约束，可以在后续步骤中应用。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">C2 · 计划调整</title>\n    <text color=\"secondary\" size=\"sm\">例如更换实现方案、调整任务顺序。需要重新评估 DAG 依赖，并判断已完成工作是否仍然有效。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">C3 · 范围或授权调整</title>\n    <text color=\"secondary\" size=\"sm\">例如新增项目、增加外部操作、扩大资源访问范围。必须重新检查目标准入、权限和授权范围。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">C4 · 关键约束变化</title>\n    <text color=\"secondary\" size=\"sm\">例如禁止上传项目代码、停止某类外部操作。应立即阻止可能违反新约束的后续动作，并处理在途操作。</text>\n  </box>\n</box>\n\n## 6.3 新要求与旧任务冲突时，优先保护当前有效约束\n\n例如，用户要求“从现在开始，项目文件不得上传到云端”。\n\n系统不能等到整个任务重新规划完成后才应用这项要求。\n\n它应该先阻止尚未开始的相关上传操作，向在途执行器发送停止请求，核验哪些数据已经发出，然后再调整任务计划。\n\n与此同时，也不能假定所有在途请求都可以立即撤销。系统需要准确报告已停止、正在停止、无法撤回和状态未知的操作。\n\n## 6.4 变更后重新验收，不意味着所有工作都要重做\n\n如果用户只是调整报告的排版，已完成的事实核验可能仍然有效。\n\n如果用户更改了视频时长，某些镜头和配音素材可能还能复用，但时间轴与合成结果需要重新检查。\n\n如果用户更改了代码的核心行为要求，相关测试、代码和依赖它们的产物可能需要重新执行。\n\n因此，`GoalChangeManager` 应结合 DAG 依赖图和 UQEAG 证据有效性规则，只让受影响的部分失效，而不是无条件重做全部工作。\n\n---\n\n# 七、人工接管：让用户真正接管任务，而不是只能聊天指挥\n\n对于个人智能体，用户有时并不希望取消整个任务，只是希望亲自处理某个关键步骤。\n\n例如：\n\n- 系统已经完成代码修改，用户想亲自审查并决定是否合并；\n- 视频素材已生成，用户想手动调整时间轴；\n- 旅游方案已规划好，用户想自己确认最终预订；\n- 系统遇到无法自动处理的界面，用户想接手完成操作。\n\n建议建立 `HumanTakeoverSession`。\n\n## 7.1 接管需要明确交接什么\n\n至少应包括：\n\n- 当前目标及版本；\n- 已完成工作；\n- 未完成工作；\n- 当前状态与检查点；\n- 已产生的副作用；\n- 待处理问题；\n- 可操作资源；\n- 当前授权范围；\n- 接管期间禁止自动执行的操作；\n- 恢复智能体控制所需的条件。\n\n用户接管期间，系统不应继续修改同一资源，除非已经明确采用了允许并行协作的机制。\n\n例如，用户正在手动编辑一个文件时，智能体不能继续自动覆盖该文件的内容。\n\n## 7.2 人工接管后，智能体如何恢复？\n\n建议采用显式交接流程：\n\n1. 保存任务检查点；\n2. 标记资源的控制权；\n3. 将当前状态与未完成工作展示给用户；\n4. 用户完成人工操作；\n5. 系统读取实际变化并核验；\n6. 检查版本差异与依赖；\n7. 重新确认任务目标与授权仍然有效；\n8. 更新计划并恢复执行。\n\n对于用户手动修改过的文件，系统应先识别差异并保留用户修改，不能简单地用旧检查点覆盖当前状态。\n\n## 7.3 人工接管不应要求用户理解所有内部细节\n\n用户通常只需要知道：\n\n- 当前做到哪一步；\n- 哪个问题需要自己处理；\n- 哪些操作已经完成；\n- 接下来可以做什么；\n- 接管后智能体会不会继续自动操作。\n\n内部 DAG、日志和版本细节可以按需展开，但不能成为用户接管任务的必要前提。\n\n---\n\n# 八、进度展示：让用户知道进展，而不是被日志淹没\n\n对于个人设备优先的 EvoAgent，主要入口是 Android，但实际工作可能发生在手机本地、Windows 电脑或 Linux 主机上。\n\n用户需要一个统一的任务视图，了解所有设备正在做什么，而不是分别打开不同设备查看日志。\n\n建议建立 `TaskProgressView`，统一展示任务目标、状态、阶段进度、下一步、风险和资源使用情况。\n\n## 8.1 进度至少分成四层\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  <box gap={1}>\n    <title size=\"md\">第一层：一句话状态</title>\n    <text color=\"secondary\" size=\"sm\">例如：“代码修改已完成，正在运行回归测试。”适合手机通知与任务列表。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">第二层：阶段进度</title>\n    <text color=\"secondary\" size=\"sm\">展示已完成阶段、当前阶段、待处理阶段和阻塞原因。进度应来自真实状态，而不是模型猜测。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">第三层：关键决策</title>\n    <text color=\"secondary\" size=\"sm\">解释为何选择当前方案、为何更换工具、为何暂停或请求用户确认。</text>\n  </box>\n  <divider color=\"subtle\"/>\n  <box gap={1}>\n    <title size=\"md\">第四层：完整审计与运行轨迹</title>\n    <text color=\"secondary\" size=\"sm\">查看节点状态、工具调用、版本、错误证据、授权记录和验收结果。</text>\n  </box>\n</box>\n\n这四层应当共享同一份任务状态数据。不能让简洁的进度界面显示“已完成”，而底层任务状态仍处于等待或未验证状态。\n\n## 8.2 进度百分比必须有真实依据\n\n复杂任务中，“完成了 80%”经常只是主观估计。\n\n如果 DAG 有十个节点，也不能简单地认为完成八个节点就代表整个任务完成了 80%，因为最后的集成、验收和发布可能是最关键的工作。\n\n建议优先展示：\n\n- 已完成的阶段；\n- 剩余的必要阶段；\n- 正在等待的依赖；\n- 已知阻塞项；\n- 预算消耗；\n- 验收状态。\n\n如果确实需要百分比，应使用已定义的进度计算规则，并明确它是工作量估计还是实际完成比例。\n\n## 8.3 进度通知应当具有信息价值\n\n不必每次工具调用都通知用户。\n\n更适合通知的事件包括：\n\n- 关键阶段完成；\n- 预计成本或时间发生重大变化；\n- 出现需要用户决策的问题；\n- 长时间任务进入等待状态；\n- 任务已经达到验收标准；\n- 发生重要失败或安全阻断。\n\n对于频繁发生但没有新信息的事件，可以在本地保留完整记录，只向用户呈现摘要。\n\n---\n\n# 九、手机优先与多设备控制：断联后仍然知道谁在执行\n\n这是 EvoAgent 现有部署方向下必须落实的设计。\n\nAndroid 负责主要交互，Windows 电脑和 Linux 主机可能承担较重的执行工作。设备之间可能断联，任务也可能在后台继续运行。\n\n因此，控制权不能只保存在某个设备的内存里。\n\n## 9.1 建立统一的控制请求协议\n\n建议所有控制请求都包含：\n\n- `control_request_id`；\n- `task_id`；\n- `target_device_id`；\n- `control_action`；\n- `expected_task_version`；\n- `requested_by`；\n- `created_at`；\n- `expires_at`；\n- `authorization_ref`；\n- `request_status`。\n\n这样 Android 可以向 Linux 主机发送暂停请求，Linux 主机可以返回实际执行状态；即使请求重传，也能通过标识避免重复处理。\n\n## 9.2 区分命令已发送、已接收和已生效\n\n例如，手机显示用户已经取消任务，但网络恰好中断。\n\n这时只能说明手机已经发出取消请求，不能宣称远程任务已停止。\n\n建议区分以下状态：\n\n- 请求尚未发送；\n- 请求已发送；\n- 目标设备已接收；\n- 目标设备正在处理；\n- 目标设备确认已生效；\n- 请求超时或结果未知。\n\n如果设备离线，系统应明确展示控制请求仍在等待确认。\n\n对于涉及高风险操作的任务，失去控制连接后是否继续执行，应由事先定义的任务策略决定；不能统一假设所有任务都应继续，也不能假设所有任务都能安全立即停止。\n\n## 9.3 授权撤销必须有跨设备语义\n\n假设用户撤销了某个远程执行权限。\n\n系统需要将撤销事件持久化，并尽快传播到相关设备，同时检查是否仍有在途操作。\n\n在撤销尚未得到远程确认时，控制界面应显示实际状态，而不是把“已发出撤销请求”当作“所有设备都已停止使用权限”。\n\n对于无法联网的设备，可以在本地执行已经配置的安全限制，并在恢复连接后核验状态。\n\n## 9.4 离线操作恢复后需要对账\n\n设备重新连接后，应同步：\n\n- 控制请求及其处理结果；\n- 任务状态变更；\n- 授权变化；\n- 已执行的操作；\n- 未完成的操作；\n- 产物与检查点；\n- 尚未确认的外部副作用。\n\n如果手机显示任务已暂停，而主机记录任务已完成，系统不能简单地用最后到达的消息覆盖另一个状态。\n\n需要根据权威状态版本、事件顺序和实际执行证据进行对账，并在存在冲突时保留证据、暂停有风险的后续操作。\n\n---\n\n# 十、确认与授权界面的防误导设计\n\n用户控制权不只取决于系统是否提供按钮，还取决于用户是否理解按钮的含义。\n\n如果系统使用模糊措辞、隐藏副作用，或者让“批准”成为最醒目的默认选项，用户可能在没有真正理解的情况下授权。\n\n因此，HACCG 应建立统一的 `ApprovalUXPolicy`。\n\n## 10.1 确认界面必须满足四个条件\n\n1. **操作明确：** 让用户知道具体要执行什么。\n2. **影响可见：** 展示主要资源、外部影响、成本与风险。\n3. **选择对等：** 允许批准、拒绝、修改方案或稍后决定。\n4. **结果可追溯：** 批准后能够查看授权范围、执行结果和撤销方式。\n\n不应该用“为了完成任务，请点击继续”来隐藏本来需要用户判断的实质性选择。\n\n## 10.2 不同操作使用不同的确认粒度\n\n例如：\n\n- 普通低风险操作可以通过已有的任务级授权完成；\n- 新增外部服务、扩大资源访问范围，需要针对变化重新确认；\n- 高影响、不可逆操作，需要展示具体操作和后果；\n- 不允许的操作必须明确阻断，而不是提供一个看似可以覆盖安全规则的按钮。\n\n## 10.3 确认超时不能默认等于批准\n\n如果用户没有回复，系统应依据操作类型和既定策略决定如何处理。\n\n例如：\n\n- 普通可选优化：可以等待或跳过；\n- 必须确认的外部操作：保持阻塞；\n- 可能造成损害的持续执行：根据预先定义的安全策略暂停相关工作；\n- 用户尚未批准的权限扩展：不得自动生效。\n\n对于已过期的确认请求，即使用户随后点击了旧通知，也需要检查请求是否仍然有效。\n\n如果任务目标、资源范围或操作内容已经变化，原确认不能直接复用。\n\n---\n\n# 十一、用户反馈与长期偏好：学习交互习惯，但不能过度推断\n\nEvoAgent 需要逐渐理解用户希望怎样协作。\n\n例如，用户可能偏好：\n\n- 普通任务少通知；\n- 重要决策主动说明理由；\n- 代码任务尽量自主完成；\n- 修改关键文件前先展示差异；\n- 长期任务每天汇报一次进展。\n\n这些偏好有助于降低交互成本，但需要与授权和安全规则分离。\n\n## 11.1 将交互偏好分为三类\n\n| 类型 | 示例 | 处理方式 |\n|---|---|---|\n| 显式偏好 | “普通进度不用通知我” | 在适用范围内保存并执行 |\n| 情境性偏好 | 当前正在处理紧急任务，希望减少打扰 | 仅在当前情境内应用 |\n| 推断性偏好 | 用户多次忽略普通进度通知 | 作为候选偏好，不自动扩大权限 |\n\n系统不能因为用户长期没有回复通知，就推断用户已经授权所有相关操作。\n\n也不能因为用户过去允许某个项目自动运行，就认为所有未来项目都获得了同样授权。\n\n## 11.2 偏好更新应当可解释和可撤销\n\n建议将用户偏好记录为独立的 `InteractionPreference`，包含适用范围、来源、更新时间和置信依据。\n\n例如：\n\n“普通进度通知偏好：合并为阶段摘要；来源：用户明确要求；适用范围：所有普通任务；安全确认不受影响。”\n\n这样用户可以理解系统为什么采用某种交互方式，并在需要时修改。\n\n## 11.3 反馈不应直接修改安全策略\n\n用户可以要求系统少打扰、提高自主执行程度或改变进度报告频率。\n\n但这些偏好不能自动改变强制权限、数据隔离规则或必须执行的安全检查。\n\nHACCG 应当把交互偏好交给偏好与记忆系统管理，把授权变更交给独立的安全治理流程处理。\n\n---\n\n# 十二、评测体系：怎样判断人机协作真的变好了？\n\nHACCG 本身也需要独立评测。\n\n如果用户点击次数减少了，但误批准的操作增多，那么交互优化并不成功。\n\n建议从六个维度进行评测。\n\n| 维度 | 评测指标 |\n|---|---|\n| 交互效率 | 每个任务所需的用户操作次数、确认次数、无效打扰次数 |\n| 理解程度 | 用户是否正确理解目标、风险、授权范围与当前状态 |\n| 控制能力 | 暂停、取消、目标变更和接管是否按预期生效 |\n| 授权正确性 | 未授权操作率、过期确认误用率、范围外执行率 |\n| 恢复质量 | 断联后控制状态对账准确率、人工接管后的恢复成功率 |\n| 用户体验 | 用户满意度、关键问题解决时间、反复解释次数 |\n\n其中，授权正确性和关键控制可靠性属于不可随意抵消的保护指标。\n\n不能为了减少确认次数，而让原本需要确认的操作静默执行。\n\n## 12.1 建立专门的交互故障测试集\n\n建议测试以下场景：\n\n- 用户在任务执行期间改变目标；\n- 手机与主机断联时发出取消请求；\n- 旧的确认通知在任务变化后被点击；\n- 两个设备同时请求暂停与恢复；\n- 用户撤销授权，但远程操作已经开始；\n- 用户接管文件后，智能体试图继续修改；\n- 用户要求停止任务，但远程工具无法立即中断；\n- 长期任务等待确认期间，预算或授权到期；\n- 进度界面显示完成，但底层任务尚未验收；\n- 多个模块同时产生通知，需要合并或区分优先级。\n\n这些测试不只检查界面显示，还应验证任务状态、授权记录、在途操作和最终副作用。\n\n## 12.2 交互系统不能自己证明自己有效\n\n例如，HACCG 新版把确认界面改得更简洁，用户平均点击时间下降了。\n\n这并不能直接证明体验提高，因为用户也可能只是更快地点击了不理解的按钮。\n\n需要同时评估用户对操作内容的理解、授权准确性、任务完成质量和错误恢复情况。\n\n---\n\n# 十三、建议冻结的架构决策\n\n以下是建议纳入 EvoAgent 全量架构的 HACCG 治理基线。\n\n<box border radius=\"xl\" padding={3} gap={3}>\n  {#each [\n    [\"ADR-661\",\"建立统一人机控制平面\",\"所有专家与设备共享统一的任务控制、确认、进度和接管协议。\"],\n    [\"ADR-662\",\"统一交互动作分类\",\"区分静默执行、状态通知、建议征询、必须确认和安全阻断。\"],\n    [\"ADR-663\",\"交互策略不能覆盖安全要求\",\"免打扰和通知偏好不得自动批准本来需要确认的操作。\"],\n    [\"ADR-664\",\"重要确认必须明确操作影响\",\"说明行动、原因、资源范围、风险、授权范围与拒绝后的处理。\"],\n    [\"ADR-665\",\"授权必须具备明确范围\",\"记录任务、资源、操作、预算、期限、条件与撤销方式。\"],\n    [\"ADR-666\",\"区分单次、任务级与持续授权\",\"不同授权模式具有不同有效范围和重新确认要求。\"],\n    [\"ADR-667\",\"确认不能绕过强制安全策略\",\"用户批准不自动使越权或违反强制约束的操作合法。\"],\n    [\"ADR-668\",\"建立统一任务控制协议\",\"暂停、恢复、取消、目标修改和人工接管具有明确语义。\"],\n    [\"ADR-669\",\"控制请求必须幂等\",\"重复、延迟和离线重传的控制命令不得导致意外重复执行。\"],\n    [\"ADR-670\",\"取消必须核验实际结果\",\"区分取消请求已发送、已接收、正在处理和已生效。\"],\n    [\"ADR-671\",\"暂停必须保留可恢复状态\",\"安全处理在途操作、检查点、依赖、资源和副作用。\"],\n    [\"ADR-672\",\"目标变更必须版本化\",\"保留旧目标、变更记录、计划差异和受影响的验收条件。\"],\n    [\"ADR-673\",\"关键约束变更优先生效\",\"立即阻止可能违反新约束的后续操作，并核验在途操作。\"],\n    [\"ADR-674\",\"人工接管必须交接控制权\",\"明确当前资源的控制主体，避免用户与智能体同时修改同一对象。\"],\n    [\"ADR-675\",\"恢复执行必须重新验证状态\",\"检查目标版本、授权、依赖、产物与检查点兼容性。\"],\n    [\"ADR-676\",\"建立分层进度展示\",\"简洁状态、阶段进度、关键决策和完整审计信息使用统一数据来源。\"],\n    [\"ADR-677\",\"跨设备控制必须确认实际状态\",\"区分命令发送、接收、生效和结果未知，离线时不得伪报成功。\"],\n    [\"ADR-678\",\"交互偏好与授权分离\",\"用户的通知偏好不能被推断为更高的执行权限。\"],\n    [\"ADR-679\",\"确认请求过期后必须重新校验\",\"目标、范围、授权或风险变化时不得机械复用旧确认。\"],\n    [\"ADR-680\",\"人机协作接受独立评测\",\"同时评估交互效率、理解程度、授权正确性、接管能力与恢复质量。\"]\n  ] as item}\n    <box gap={1}>\n      <row align=\"center\" gap={2}>\n        <badge>{item[0]}</badge>\n        <title size=\"md\">{item[1]}</title>\n      </row>\n      <text color=\"secondary\" size=\"sm\">{item[2]}</text>\n    </box>\n    <divider color=\"subtle\"/>\n  {/each}\n</box>\n\n这些是建议纳入 EvoAgent 全量架构的人机协作治理基线。正式实施时，还需要定义 `ApprovalRecord`、`AuthorizationScope`、`TaskControlProtocol`、`GoalChangeManager`、`HumanTakeoverSession`、`TaskProgressView` 和跨设备控制状态机。\n\n---\n\n# 十四、下一专项：跨专家知识共享、能力资产与技能进化\n\n到目前为止，我们已经设计了目标决策、自主性治理、人机协作、质量验收和因果诊断。\n\n但多专家架构还有一个长期问题：\n\n**当不同专家在执行任务时不断积累经验、工具用法、工作流和解决方案，哪些知识应该共享，哪些应该隔离，哪些能够沉淀成可复用能力，又如何判断这些能力真的可靠？**\n\n例如：\n\n- 编程专家解决了一个 AST 代码重构问题，能否让其他编程任务复用？\n- 漫剧专家跑通了一套分镜、配音与视频合成流程，能否固化成稳定工作流？\n- 通用专家发现了一种有效的需求澄清方式，能否共享给旅游和编程专家？\n- 某个专家总结出一条经验，但它只在特定模型版本下有效，系统如何防止其他专家错误复用？\n- 两个专家分别形成了相似的能力，系统应该合并、保留独立版本，还是让它们竞争评测？\n- 某项技能长期没有使用，或者依赖的工具已经失效，系统如何识别并淘汰它？\n\n建议下一专项定义为：\n\n**Cross-Expert Knowledge & Capability Evolution，简称 CEKCE。**\n\n重点研究：\n\n1. 如何建立统一的能力注册表和技能依赖图；\n2. 如何区分事实知识、经验记忆、工具能力、工作流与可执行技能；\n3. 如何定义全局共享、领域共享、专家私有和任务临时知识的边界；\n4. 如何将成功任务转化为经过验证的可复用能力；\n5. 如何对技能进行版本管理、兼容性检查、评测和回滚；\n6. 如何防止错误经验在多个专家之间传播；\n7. 如何处理重复技能、冲突知识和过期能力；\n8. 如何让一个专家借鉴其他专家的能力，而不直接污染自己的核心策略；\n9. 如何判断一项技能应该升级、拆分、合并、冻结或淘汰；\n10. 如何建立能力发现、复用、验证与反馈闭环；\n11. 如何将 AST、代码分析、视频合成、浏览器操作等专业技术沉淀为可组合的能力包；\n12. 如何让技能资产在 Android、Windows 和 Linux 设备之间安全分发，并处理不同设备的依赖差异。\n\n本专项的核心原则是：\n\n**经验可以共享，但未经验证的经验不能直接成为全局规则；技能可以复用，但每次复用都必须满足适用条件、依赖要求和安全边界。**\n\n这会把 EvoAgent 从“拥有多个专家的智能体”，进一步推进为“能够积累、验证、组合、传播和淘汰能力的智能体系统”。\n\n"]},"status":"finished_successfully","end_turn":true,"weight":1.0,"metadata":{"is_merged_message":true,"source_message_ids":["1e07b296-3f8f-42fc-b0f8-fa53ecab0775","dc7be158-a2ad-4c5b-9d85-b67788c0cfaa","e651084f-9bf6-42b7-bc3f-e290125b344d","459c1422-a78b-4c24-8de5-e80b6283cbe4","dbc70b0b-b819-4f3d-8995-f030e79e0e4d","779d2959-8a7c-41b2-81a6-e23ab2aa82e7","3a28249e-4ba3-420f-8a8c-e018542f9fda"],"continuation_message_id":"3a28249e-4ba3-420f-8a8c-e018542f9fda","model_dil_v2":{"code":"function __dilSafe(evaluate,failureValue){try{return evaluate()}catch{return failureValue}}\n\nDIL.render(__dil.jsx(()=>{const __dilConstants=DIL.useConstants();const __dilModelDataBindings=DIL.useAppData((appData)=>appData.opGenui?.modelDataBindings??{});return __dil.jsx(__dil.Fragment,null,__dil.jsx(\"title\",{\"size\":\"xl\"},__dilConstants[\"0\"]),__dil.jsx(\"text\",null,__dilConstants[\"1\"]),__dil.jsx(\"text\",null,__dil.jsx(\"bold\",null,__dilConstants[\"2\"])),__dil.jsx(\"text\",null,__dilConstants[\"3\"]),__dil.jsx(\"text\",null,__dilConstants[\"4\"]),__dil.jsx(\"title\",{\"size\":\"lg\"},__dilConstants[\"5\"]),__dil.jsx(\"text\",null,__dilConstants[\"6\"]),__dil.jsx(\"text\",null,__dilConstants[\"7\"]),__dil.jsx